DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Numeric');

$mass   = random(5.00, 10.00, 1.03);
$length = random(0.5,  1.5,   0.01);

$A1 = Compute("2pi*sqrt($length/9.8)");
BEGIN_PGML
What is the period of a [`[$length]`]-[`\textrm{m}`]-long pendulum?

[_]{$A1}  [`\textrm{s}`] 

END_PGML
BEGIN_PGML_HINT
Recall the formula giving the period of a simple pendulum as a function of its length.
END_PGML_HINT

ENDDOCUMENT();
