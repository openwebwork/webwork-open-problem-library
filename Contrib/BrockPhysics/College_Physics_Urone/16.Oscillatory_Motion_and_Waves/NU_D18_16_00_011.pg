##DESCRIPTION
## frequency and period
##ENDDESCRIPTION

## DBsubject(Mechanics)
## DBchapter(Oscillations)
## DBsection(Period and Frequency in Oscillatons))
## Date(26 December 2017)
## Institution(Brock University)
## Author(Santo D'Agostino)
## TitleText('')
## AuthorText('')
## EditionText('2018')
## Section('16.2')
## Problem('11')
## KEYWORDS(frequency, period)

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'randomPerson.pl', 'PGcourse.pl');

Context('Numeric');

$a = random(2,6,1);
$T = 7/$a;
$f = 1/$T;

$p = randomPerson();

BEGIN_PGML
[$p] exercises [`[$a]`] times per week, at regular intervals.

a) Determine the period of [$p]'s exercise program.

    [_]{$T} [`\textrm{days}`]

b) Determine the frequency of [$p->their] exercise program.

    [_]{$f} times per day

END_PGML

ENDDOCUMENT();
