## Problem1('1')
## KEYWORDS(frequency, period)

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Numeric');

$period = random(50, 70, 0.1);
$A1     = 1 / ($period);

BEGIN_PGML
What is the period of  [`[$period]`] [`\textrm{Hz}`] electrical power?

[_]{$A1} [`\textrm{s}`]

END_PGML
BEGIN_PGML_HINT
Frequency is the inverse of period, and vice-versa.
END_PGML_HINT

ENDDOCUMENT();
