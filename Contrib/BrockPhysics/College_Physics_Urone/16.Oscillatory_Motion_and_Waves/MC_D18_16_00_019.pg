DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'parserRadioButtons.pl', 'PGcourse.pl');

Context('Numeric');

$rb = RadioButtons(
    [ [
        '\(\textrm{kg} \cdot \textrm{m}\).',
        '\(\textrm{N}\).',
        '\(\textrm{N}/\textrm{m}.\)',
        '\(\textrm{kg}/\textrm{m}.\)',
        '\(\textrm{N} \cdot \textrm{m}\).',
    ] ],
    2,
    labels => 'ABC'
);

BEGIN_PGML
Typical units for the stiffness constant of a spring are 

    [_]{$rb}

END_PGML

ENDDOCUMENT();
