##DESCRIPTION
## enter description
##ENDDESCRIPTION

## DBsubject(Mechanics)
## DBchapter(Oscillatory Motion and Waves)
## DBsection(Simple Harmonic Motion: A Special Periodic Motion)
## Date(December 2017)
## Institution(Brock University)
## Author(Brandon Lostracco)
## Edited (Connor Wilson, May 2, 2018)
## TitleText1('College Physics')
## AuthorText1('Urone et. al')
## EditionText1('2017')
## Section1('16.3')
## Problem1('4')
## KEYWORDS(frequency, period, harmonic, Hooke's)

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Numeric');

$mass = sprintf("%0.3f", random(0.2, 0.7, 0.1));
$T1   = sprintf("%0.2f", random(2,   5));
$T2   = $T1 + 0.01;
$A1   = 0.5 * ($T2 / $T1)**2 - $mass;
$A2   = $A1 / 0.5 * 100;

Context()->texStrings;
BEGIN_PGML
A [`[$mass]`] [`\textrm{kg}`] object attached to a spring initially oscillates with a period of [`[$T1]`] [`\textrm{s}`].

a) What increase in mass is required such that the new period is no greater than [`[$T2]`] [`\textrm{s}`]?

    [_]{$A1} [`\textrm{kg}`]

b) What is this increase in mass, expressed as a percentage of the initial mass?

    [_]{$A2} [`\textrm{%}`]

END_PGML

BEGIN_PGML_HINT
Be careful - the question is asking for the _difference_ in mass, not the total mass needed to cause this new period of oscillation.
END_PGML_HINT

Context()->normalStrings;

ANS(num_cmp("$A2"));

ENDDOCUMENT();
