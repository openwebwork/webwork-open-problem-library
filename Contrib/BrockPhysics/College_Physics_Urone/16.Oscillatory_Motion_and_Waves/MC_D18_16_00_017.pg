DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'parserRadioButtons.pl', 'PGcourse.pl');

$rb = RadioButtons(
    [ [
        'sometimes periodic, and sometimes not periodic, depending on the mass of the block.',
        'not periodic.',
        'periodic.',
        'sometimes periodic, and sometimes not periodic, depending on other parameters.',
        'sometimes periodic, and sometimes not periodic, depending on the stiffness constant of the spring.'
    ] ],
    2,
    labels => 'ABC'
);

BEGIN_PGML
Simple harmonic motion without damping is 

    [_]{$rb}
END_PGML

ENDDOCUMENT();
