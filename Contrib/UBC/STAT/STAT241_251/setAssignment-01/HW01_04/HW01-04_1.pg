#DESCRIPTION
##  Statistics: Introduction
##ENDDESCRIPTION

## DBsubject(Statistics)
## DBchapter(Exploratory data analysis/descriptive statistics)
## DBsection(Summary statistics)
## Date(08/15/2012)
## Institution(The University of British Columbia)
## Author(Djun Kim)
## Level(3)
## MO(1)
## KEYWORDS('statistics', 'multiple choice', 'variables')

# Edited by Peter Staab, Fitchburg State University
# switched to PGML, changed the graph to tikz and randomized as well as
# included alternate text.

DOCUMENT();

loadMacros(
    "PGstandard.pl",       "parserRadioButtons.pl",
    'StatisticalPlots.pl', "PGML.pl",
    "PGtikz.pl",           "PGcourse.pl",
);

$min    = random(5,  15, 0.1);
$q1     = random(20, 28, 0.1);
$median = random(30, 48, 0.1);
$q3     = random(50, 65, 0.1);
$max    = random(80, 95, 0.1);

$radio_a = RadioButtons([ $min, $q1, $median, $q3, $max ], 2, labels => 'ABC');

$radio_b = RadioButtons(
    [
        "The mean is larger in value than the median",
        "The mean is smaller in value than the median",
        "The mean is equal in value to the median",
        "There is insufficient information to make a comparison of the mean and median",
    ],
    "The mean is larger in value than the median",    # correct answer
    labels => 'ABC'                                   # can be a list
);

$plot = StatPlot(
    xmin            => -5,
    xmax            => 15,
    xvisible        => 0,
    ymin            => -5,
    ymax            => 95,
    ytick_delta     => 10,
    yminor          => 1,
    show_grid       => 0,
    rounded_corners => 1,
    aspect_ratio    => 0.25
);

$plot->add_boxplot(
    {
        min    => $min,
        q1     => $q1,
        median => $median,
        q3     => $q3,
        max    => $max
    },
    orientation => 'vertical',
    fill_color  => 'lightblue',
    whisker_cap => 1,
    box_width   => 5
);

$alttext = qq/alt='Box and whiskers plot for lifetime of lightbulbs.
    The plot runs vertically.  The bottom whisker is from $min
    to $q1.  The box is between $q1 and $q3. The middle line 
    is at $median and the top whisker runs from $q3 to $max'/;

BEGIN_PGML
The following diagram shows a boxplot for the lifetimes (in months) of a
sample of 30 lightbulbs.

>>[![$alttext]!]{$plot}{250} <<

*a)* What is the median lifetime? 

[_]{$radio_a}

*b)* Which of the following statements is correct?

[_]{$radio_b}
END_PGML

BEGIN_PGML_SOLUTION
The correct answers are:

Part a) [@ $radio_a->correct_ans() @]*

Part b) [@ $radio_b->correct_ans() @]*

END_PGML_SOLUTION
ENDDOCUMENT();
