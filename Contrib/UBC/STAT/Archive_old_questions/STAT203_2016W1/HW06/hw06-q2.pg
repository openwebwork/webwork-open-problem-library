## DESCRIPTION
## DBsubject('Statistics')
## DBchapter('Sample survey methods')
## DBsection('Concepts')
## Level(3)
## KEYWORDS('Sample surveys', 'bias', 'representative sample')
## ENDDESCRIPTION
## Tagged by Nelson Chen, May 18, 2016.

## Date('05/18/2012')
## Author('Lance R')
## Institution('University of BC')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'parserRadioButtons.pl', 'PGcourse.pl');

# Note: these are adapted from
# Library/ASU-topics/setStat/dueck8.pg

# Select 2 questions from the following 4:

@questions = (
    qq/A sample of 50 dentists from Vancouver is taken to
    estimate the median income of all Vancouver residents./,
    qq/A sample of professional basketball players is taken to
    estimate the mean height of all adult males./,
    qq/A simple random sample of voters is taken in order to
    determine the chances of a certain candidate winning an
    election./,
    qq/Using a sample of 50 patients from a local care unit
    for the long-term ill, researchers measured cholesterol
    level in an attempt to estimate the mean cholesterol level
    of all Canadian citizens./
);

@answers = (1, 1, 0, 1);

@shuffle = random_subset(2, 0 .. 3);

@radios = map {
    RadioButtons(
        [ 'Representative', 'Non-representative', 'Cannot be determined' ],
        $_, labels => 'ABC')
} @answers;

BEGIN_PGML

1. [$questions[$shuffle[0]]]

    This sampling scheme should produce a sample that is

    [_]{$radios[$shuffle[0]]}

2. [$questions[$shuffle[1]]]

    This sampling scheme should produce a sample that is

    [_]{$radios[$shuffle[1]]}


END_PGML

BEGIN_PGML_SOLUTION
Recall that for a representative random sample, every person in the population must have an equal probability of being selected in the sample. 

1. [$radios[$shuffle[0]]]
2. [$radios[$shuffle[1]]]
END_PGML_SOLUTION

ENDDOCUMENT(); 
