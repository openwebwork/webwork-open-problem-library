##DESCRIPTION
##  Problem that asks doing addition using base-5
##ENDDESCRIPTION

##KEYWORDS('base-5', 'sum')

## DBsubject('Arithmetic')
## DBchapter('Other Number Systems')
## DBsection('Base 5 Numbers')
## Date('8/30/2020')
## Author('Peter Staab')
## Institution('Fitchburg State University')
# updated 2023.08.20

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'contextBaseN.pl', 'PGcourse.pl');

Context('BaseN')->setBase(5);

do {
    $a1_10 = random(30, 124);
    $b1_10 = random(3,  4);
    $q1_10 = int($a1_10 / $b1_10);
    $r1_10 = $a1_10 % $b1_10;
} until $r1_10 != 0;

do {
    $a2_10 = random(126, 5**4 - 1);
    $b2_10 = random(6,   24);
    $q2_10 = int($a2_10 / $b2_10);
    $r2_10 = $a2_10 % $b2_10;
} until $r2_10 != 0;

Context('BaseN')->setBase(8);

do {
    $a3_10 = random(8**3 + 1, 8**4 - 1);
    $b3_10 = random(10,       50);
    $q3_10 = int($a3_10 / $b3_10);
    $r3_10 = $a3_10 % $b3_10;
} until $r3_10 != 0;

# Ensure that students can't use +,-, *, / to answer problem.
Context('LimitedBaseN')->setBase(5);

$a1 = Real($a1_10);
$b1 = Real($b1_10);
$r1 = Real($r1_10);
$q1 = Real($q1_10);

$a2 = Real($a2_10);
$b2 = Real($b2_10);
$r2 = Real($r2_10);
$q2 = Real($q2_10);

Context('LimitedBaseN')->setBase(8);

$a3 = Real($a3_10);
$b3 = Real($b3_10);
$r3 = Real($r3_10);
$q3 = Real($q3_10);

BEGIN_PGML

Each of the follow are division problems in base-5 and base-8.  Find the sum of each without converting to base-10.


a) [`[$a1]_5 \div [$b1]_5`]=[_]*{$q1} R [_]*{$r1}
b) [`[$a2]_5 \div [$b2]_5`]=[_]*{$q2} R [_]*{$r2}
c) [`[$a3]_8 \div [$b3]_8`]=[_]*{$q3} R [_]*{$r3}

END_PGML

BEGIN_PGML_HINT
First, it's helpful to have a multiplication table for base-5 and base-8.  Then perform long division using the table and remembering that all operations (including the subtraction within long division) needs to be done in the given base. 
END_PGML_HINT

BEGIN_PGML_SOLUTION
a) [`[$a1]_5 \div [$b1]_5`]=[$q1] R [$r1]
b) [`[$a2]_5 \div [$b2]_5`]=[$q2] R [$r2]
c) [`[$a3]_8 \div [$b3]_8`]=[$q3] R [$r3]
END_PGML_SOLUTION

ENDDOCUMENT();
