##DESCRIPTION
##  Problem that asks doing addition using base-8
##ENDDESCRIPTION

##KEYWORDS('teacher preparation', 'mental math', 'arithmetic')

## DBsubject('Arithmetic')
## DBchapter('Other Number Systems')
## DBsection('Base 8 Numbers')
## Date('8/30/2020')
## Author('Peter Staab')
## Institution('Fitchburg State University')
# updated 2023.08.20

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'contextBaseN.pl', 'PGcourse.pl');

Context('BaseN')->setBase(8);

# In this context Real converts a decimal to a base-8 number.
($a1, $b1) = (Real(random(8, 8**2 - 1)), Real(random(8, 8**3 - 1)));
$sum1 = $a1 + $b1;

($a2, $b2) = (Real(random(8, 8**3 - 1)), Real(random(8, 8**3 - 1)));
$sum2 = $a2 + $b2;

($a3, $b3) =
    (Real(random(8**2 + 2, 8**3 - 1)), Real(random(8**3 + 1, 8**4 - 1)));
$sum3 = $a3 + $b3;

# Don't allow students to enter arithmetic operations.
Context('LimitedBaseN')->setBase(8);
$ans1 = Real($sum1->value);
$ans2 = Real($sum2->value);
$ans3 = Real($sum3->value);

BEGIN_PGML

Each of the following are addition problems in base-8.  Find the solution of each without converting to base-10.

a) [`[$a1]_8+[$b1]_8`]=[________]{$ans1}[`_8`]

b) [`[$a2]_8+[$b2]_8`]=[________]{$ans2}[`_8`]

c) [`[$a3]_8+[$b3]_8`]=[________]{$ans3}[`_8`]

END_PGML

@sa1 = split(//, $a1);
@sb1 = split(//, $b1);
@sc1 = split(//, $a1 + $b1);
@sd1 =
    map { $_ == 0 ? '' : $_ }
    map { ($sc1[$_] - $sa1[$_] - $sb1[$_]) % 8 }
    (-1, -2, -3);    # rebundled values

@sa2 = split(//, $a2);
@sb2 = split(//, $b2);
@sc2 = split(//, $a2 + $b2);
@sd2 =
    map { $_ == 0 ? '' : $_ }
    map { ($sc2[$_] - $sa2[$_] - $sb2[$_]) % 8 }
    (-1, -2, -3, -4);    # rebundled values

@sa3 = split(//, $a3);
@sb3 = split(//, $b3);
@sc3 = split(//, $a3 + $b3);
@sd3 =
    map { $_ == 0 ? '' : $_ }
    map { ($sc3[$_] - $sa3[$_] - $sb3[$_]) % 8 }
    (-1, -2, -3, -4);    # rebundled values

BEGIN_PGML_SOLUTION
For each of these, we will use the column algorithm recalling that rebundling is needed for any quantity over 7. 

a) [# 
    [. .][. [$sd1[2]] .][. [$sd1[1]] .] [.[$sd1[0]].]* 
    [. .][. [$sa1[-3]] .][. [$sa1[-2]] .] [.[$sa1[-1]].]*
    [. [`+`] .][. [$sb1[-3]] .][. [$sb1[-2]] .] [.[$sb1[-1]].]*{rowbottom => 1}
       [. .][. [$sc1[-3]] .][. [$sc1[-2]] .] [.[$sc1[-1]].] 
    #]

b) [# 
    [. .][. [$sd2[3]] .][. [$sd2[2]] .][. [$sd2[1]] .] [.[$sd2[0]].]* 
    [. .][. .][. [$sa2[-3]] .][. [$sa2[-2]] .] [.[$sa2[-1]].]*
    [. [`+`] .][. .][. [$sb2[-3]] .][. [$sb2[-2]] .] [.[$sb2[-1]].]*{rowbottom => 1}
       [. .][. [$sc2[-4]] .][. [$sc2[-3]] .][. [$sc2[-2]] .] [.[$sc2[-1]].] 
    #]
    
c) [# 
    [. .][. [$sd3[3]] .][. [$sd3[2]] .][. [$sd3[1]] .] [.[$sd3[0]].]* 
    [. .][. [$s13[-4]] .][. [$sa3[-3]] .][. [$sa3[-2]] .] [.[$sa3[-1]].]*
    [. [`+`] .][. [$sb3[-4]] .][. [$sb3[-3]] .][. [$sb3[-2]] .] [.[$sb3[-1]].]*{rowbottom => 1}
       [. .][. [$sc3[-4]] .][. [$sc3[-3]] .][. [$sc3[-2]] .] [.[$sc3[-1]].] 
    #]

END_PGML_SOLUTION

ENDDOCUMENT();
