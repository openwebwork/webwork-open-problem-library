##DESCRIPTION
##  Add three positive integers using the lattice method
##ENDDESCRIPTION

##KEYWORDS('addition', 'lattice method')

## DBsubject('Algebra')
## DBchapter('Fundamentals')
## DBsection('Real Numbers')
## Date('07/01/2018')
## Author('Peter Staab')
## Institution('Fitchburg State University')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGtikz.pl', 'plots.pl', 'PGcourse.pl');

Context('Numeric');

$a = random(400, 700);
$b = random(500, 800);
$c = random(300, 700);

$sum = Compute($a + $b + $c);
Context('LimitedNumeric');

BEGIN_PGML
Use the lattice method to calculate [`[$a]+[$b]+[$c] = `] [____]{$sum}
END_PGML

@adig = split(//, $a);
@bdig = split(//, $b);
@cdig = split(//, $c);
@sdig = map { $adig[$_] + $bdig[$_] + $cdig[$_] } (0 .. 2);

$plot = Plot(
    xmin      => -1,
    xmax      => 2.5,
    ymin      => -1,
    ymax      => 3.5,
    xvisible  => 0,
    yvisible  => 0,
    show_grid => 0,
);

for my $i (0 .. 2) {
    $plot->add_label(
        [ 0.25 + 0.75 * $i, 3,    $adig[$i], fontsize => 'Large' ],
        [ 0.25 + 0.75 * $i, 2.25, $bdig[$i], fontsize => 'Large' ],
        [ 0.25 + 0.75 * $i, 1.5,  $cdig[$i], fontsize => 'Large' ]
    );
}

$plot->add_label(-0.25, 1.5, '+', fontsize => 'Large');
$plot->add_rectangle([ -0.1,  0.25 ], [ 2.1,   1.1 ], width => 1);
$plot->add_rectangle([ 1.375, 0.25 ], [ 0.625, 1.1 ], width => 1);

for my $i (0 .. 2) {
    $plot->add_dataset(
        [ -0.85 + $i * 0.75, -0.6 ], [ 0.625 + $i * 0.75, 1.1 ],
        linestyle => 'dashed',
        width     => 1
    );
}

for my $i (0 .. 2) {
    $plot->add_label(0.1 + $i * 0.75,
        0.8, $sdig[$i] < 10 ? '0' : substr($sdig[$i], 0, 1));
    $plot->add_label(
        0.4 + $i * 0.75,
        0.5,
        $sdig[$i] < 10 ? substr($sdig[$i], 0, 1) : substr($sdig[$i], 1, 1)
    );
}

@digits = split(//, $sum);
for my $i (0 .. 3) {
    $plot->add_label(-0.8 + 0.75 * $i, -0.1, $digits[$i]);
}

BEGIN_PGML_SOLUTION

First, write the numbers in the lattice and then add down the columns, writing both the tens and ones.

>>[!!]{$plot}{200}<<

Then add down the diagonals in the lattice to get the result of [$sum].

END_PGML_SOLUTION

ENDDOCUMENT();
