##DESCRIPTION
##  Find the quotient and remainder of a problem using long division.
##ENDDESCRIPTION

##KEYWORDS('long division')

## DBsubject('Elementary Education')
## DBchapter('Arithmetic')
## DBsection('Division')
## Author('Peter Staab')
## Institution('Fitchburg State University')
## Date('5/3/2020')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Numeric');

$a1    = random(100, 200);
$b1    = random(3,   9);
$c1    = $a1 * $b1;
$quot1 = Compute($a1);
$rem1  = Compute(0);

$a2    = random(100, 200);
$b2    = random(3,   9);
$c2    = $a2 * $b2 + random(1, $b2 - 1);
$quot2 = Compute($a2);
$rem2  = Compute($c2 % $b2);

BEGIN_PGML

1) Use long division on the problem [`[$c1]\div [$b1]`]:

	The whole part is [___]{$quot1}

	The remainder is [____]{$rem1}

2) Use long division on the problem [`[$c2] \div [$b2]`]:

	The whole part is [___]{$quot2}

	The remainder is [____]{$rem2}

END_PGML

sub long_division {
    my ($dividend, $divisor) = @_;

    my @digits     = split(//, $dividend);
    my $num_digits = scalar @digits;
    my $quotient   = int($dividend / $divisor);
    my @qdigits    = split(//, $quotient);

    # start with the quotient in the top row and the second row is the
    # dividend and divisor.
    my @rows = (
        [
            '',
            ({ data => '', bottom => 1 }) x
                (scalar(@digits) - scalar(@qdigits)),
            map { ({ data => $_, bottom => 1 }) } split(//, $quotient)
        ],
        [ "$divisor)", @digits ]
    );

    $step = 0;
    my $div = 0;
    do { $div .= $digits[$step]; ++$step; } until $div > $divisor;
    do {
        # step n dividend.
        my $q = int($div / $divisor);
        push(
            @rows,
            [
                ('') x ($step +1 -ceil(log10($divisor*$q))),
                map { ({ data => $_, bottom => 1 }) }
                    split(//, $divisor * $q)
            ]
        );
        my $diff = $div - $q * $divisor;
        push(
            @rows,
            [
                ('') x ($diff < 10 ? $step : $step - 1),
                split(//, $diff),
                $digits[$step] // ''
            ]
        );
        $div = $diff * 10 + $digits[$step];
        ++$step;
    } until ($step > scalar(@digits));

    return DataTable(~~@rows);

}



BEGIN_PGML_SOLUTION

1. [@ long_division($c1, $b1) @]*

    So the quotient is [$quot1] with remainder [$rem1].

2. [@ long_division($c2, $b2) @]*

    So the quotient is [$quot2] with remainder [$rem2].

[$tab3]*

END_PGML_SOLUTION
ENDDOCUMENT();
