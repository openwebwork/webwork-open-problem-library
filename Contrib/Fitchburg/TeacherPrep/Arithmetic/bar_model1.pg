# DESCRIPTION
# Determine the best model to represent an addition problem.
# ENDDESCRIPTION

## DBsubject('Elementary Education')
## DBchapter('Arithmetic')
## DBsection('Models')
## KEYWORDS('addition', 'models')
## Author('Peter Staab')
## Institution('Fitchburg State University')
## Date('5/3/2020')

DOCUMENT();
loadMacros(
    'PGstandard.pl',         'PGML.pl',
    'parserCheckboxList.pl', 'PGtikz.pl',
    'PGcourse.pl'
);
Context('Numeric');

$a = random(17, 29);
$b = $a + random(5, 15);

# Used to define the braces in the diagrams below:
$braces = qq!\tikzset{brace/.style={decorate,decoration={brace,amplitude=5}}}
\tikzset{bracelabel/.style={midway,#1=2pt+3pt}}!;

# $model1->tikzOptions('every node/.style={scale=2.5}');

$model1 = createTikZImage();
$model1->tikzLibraries('decorations.pathreplacing');
$model1->addToPreamble($braces);
$model1->BEGIN_TIKZ
\draw[very thick, red] (0,1.5) rectangle ({$b/5},2.5);
\draw[very thick, green] (0,0) rectangle ({$a/5},1);
\draw[brace](0,2.6) -- ({$b/5},2.6) node[bracelabel=above] {$b};
\draw[brace]({$a/5},-0.1) -- (0,-0.1) node[bracelabel=below] {$a};
\draw[brace]({$b/5+0.1},2.5) -- ({$b/5+0.1},0) node[bracelabel=right] {?};
END_TIKZ

$model2 = createTikZImage();
$model2->tikzLibraries('decorations.pathreplacing');
$model2->addToPreamble($braces);
$model2->BEGIN_TIKZ
\draw[very thick, red] (0,1.5) rectangle ({$b/5},2.5);
\draw[very thick, green] (0,0) rectangle ({$a/5},1);
\draw[brace](0,2.6) -- ({$b/5},2.6) node[bracelabel=above] {$b};
\draw[brace]({$a/5},-0.1) -- (0,-0.1) node[bracelabel=below] {$a};
\draw[brace]({$b/5},-0.1) -- ({$a/5},-0.1) node[bracelabel=below] {?};
END_TIKZ

$model3 = createTikZImage();
$model3->tikzLibraries('decorations.pathreplacing');
$model3->addToPreamble($braces);
$model3->BEGIN_TIKZ
\draw[very thick, red] ({$a/5},0) rectangle ({($a+$b)/5},1);
\draw[very thick, green] (0,0) rectangle ({$a/5},1);
\draw[brace]({$a/5},-0.1) -- (0,-0.1) node[bracelabel=below] {$a};
\draw[brace]({($a+$b)/5},-0.1) -- ({$a/5},-0.1) node[bracelabel=below] {$b};
\draw[brace](0,1.1) -- ({($a+$b)/5},1.1) node[bracelabel=above] {?};
END_TIKZ

$checks = CheckboxList([ 'A', 'B', 'C' ], [ 'A', 'C' ]);

$alt_text1 =
    "A bar model with two stacked bars.  The top bar has length $b "
    . "and the bottom is length $a.  There is a ? on the right spanning the "
    . "two bars.";

$alt_text2 =
    "A bar model with two stacked bars.  The top bar has length $b "
    . "and the bottom is length $a.  There is a ? along the bottom spanning "
    . "the end of the shorter to the end of the longer bar.";

$alt_text3 =
    "A bar model with two bars lengthwise next to each other.  They "
    . "are labeled along the bottom with the lengths $a and $b.  The top "
    . "spans both bars and is labelled with a ?.";

BEGIN_PGML

Consider the following bar models:

A) [![$alt_text1]!]{$model1}{300}

B) [![$alt_text2]!]{$model2}{300}

C) [![$alt_text3]!]{$model3}{400}

Which of the following bar models represents the addition problem [`[$a]+[$b]`]? Select all

[___]{$checks}


END_PGML

BEGIN_PGML_SOLUTION
In this case, both A and C are the answers.
END_PGML_SOLUTION
ENDDOCUMENT();
