###DESCRIPTION
##  Find the quotient and remainder of a problem using long division.
##ENDDESCRIPTION

##KEYWORDS('long division')

## DBsubject('Elementary Education')
## DBchapter('Arithmetic')
## DBsection('Multiplication')
## Author('Peter Staab')
## Institution('Fitchburg State University')
## Date('5/3/2020')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'plots.pl', 'PGcourse.pl');

Context('Numeric');

$a   = random(200, 400);
$b   = random(100, 200);
$ans = Compute($a * $b);

BEGIN_PGML

Use the lattice method to find [`[$a] \times [$b]`]: [____]{Compute($a*$b)}

END_PGML

@a1 = reverse(split(//, $a));
@b1 = reverse(split(//, $b));

# calculate the sums of the place values.
$prod[0] = $b1[0] * $a1[0] % 10;
$prod[1] =
    int($b1[0] * $a1[0] / 10) + ($a1[0] * $b1[1] % 10) + ($b1[0] * $a1[1] % 10);
$prod[2] =
    int($a1[0] * $b1[1] / 10) +
    int($a1[1] * $b1[0] / 10) +
    ($a1[0] * $b1[2] % 10) +
    ($a1[1] * $b1[1] % 10) +
    ($a1[2] * $b1[0] % 10);
$prod[3] =
    int($a1[0] * $b1[2] / 10) +
    int($a1[1] * $b1[1] / 10) +
    int($a1[2] * $b1[0] / 10) +
    ($a1[2] * $b1[1] % 10) +
    ($a1[1] * $b1[2] % 10);
$prod[4] =
    int($a1[2] * $b1[1] / 10) +
    int($a1[1] * $b1[2] / 10) +
    ($a1[2] * $b1[2] % 10);
$prod[5] = int($a1[2] * $b1[2] / 10);

$plot = Plot(
    xmin         => -2,
    xmax         =>  4.5,
    ymin         => -0.5,
    ymax         =>  4,
    aspect_ratio =>  1,
    xvisible     =>  0,
    yvisible     =>  0,
    show_grid    => 0
);

for (0 .. 2) {
    $plot->add_label(2 + 0.75 * $_, 3.5, $a1[ 2 - $_ ], fontsize => 'Large');
    $plot->add_label(4, 1.4 + 0.75 * $_, $b1[$_],       fontsize => 'Large');
}
for my $i (0 .. 2) {
    for my $j (0 .. 2) {
        $plot->add_rectangle(
            [ 1.5 + 0.75 * $i,       1 + 0.75 * $j ],
            [ 1.5 + 0.75 * ($i + 1), 1 + 0.75 * ($j + 1) ],
            width => 1
        );
        $n = $a1[ 2 - $i ] * $b1[$j];
        @m = reverse(split(//, $n));
        $plot->add_label(2 + 0.75 * $i,    1.25 + 0.75 * $j, $m[0]);
        $plot->add_label(1.75 + 0.75 * $i, 1.5 + 0.75 * $j,  $m[1] // '0');
    }
}

for my $i (0 .. 3) {
    $plot->add_dataset(
        [ -1.75 + 0.75 * $i, 0 ], [ 1.5 + 0.75 * $i, 3.25 ],
        linestyle => 'dashed',
        width     => 1,
        color     => 'gray'
    );
}

for my $i (0 .. 1) {
    $plot->add_dataset(
        [ 1.25 + 0.75 * $i, 0 ], [ 3.75, 3.25 - 0.75 * ($i + 1) ],
        linestyle => 'dashed',
        width     => 1,
        color     => 'gray'
    );
}

for my $i (0 .. 5) {
    @m = reverse(split(//, $prod[$i]));
    $plot->add_label(
        [ 2.8 - 0.75 * $i, 0.5, $m[0],       color => 'blue' ],
        [ 2.5 - 0.75 * $i, 0.8, $m[1] // '', color => 'blue' ]
    );
}

@p = split(//, $a * $b);
for my $i (0 .. 5) {
    $plot->add_label(3 - 0.75 * $i, 0, $p[ 5 - $i ], fontsize => 'Large');
}

BEGIN_PGML_SOLUTION
Create a grid with the two factors on the top and right edge of the lattice.  Multiply each of the digits and add the ones and tens of each digit product above and below the dashed lines. 

>>[!!]{$plot}{400}<<

Add down the diagonals, keep the ones digit in the same diagonal and any tens digit of the sum to the next diagonal.  Finally sum these numbers (in blue) to get the final result. 
END_PGML_SOLUTION
ENDDOCUMENT();
