##DESCRIPTION
##  Problem that asks about doing arithmetic mentally.
##ENDDESCRIPTION

##KEYWORDS('teacher preparation', 'mental math', 'arithmetic')

## DBsubject('Teacher Preparation')
## DBchapter('Basic Arithmetic')
## DBsection('Place Value')
## Date('8/30/2020')
## Author('Peter Staab')
## Institution('Fitchburg State University')

DOCUMENT();

loadMacros("PGstandard.pl", "PGML.pl", "parserPopUp.pl", 'PGcourse.pl');

Context("Numeric");

$vals = [
    10000 + random(10, 90),
    10000 - random(1,  50),
    10000 - random(51, 99),
    1000 + random(1,  50),
    1000 - random(1,  50),
    1000 - random(51, 99)
];

for my $i (0 .. 5) {
    $ans[$i] = DropDown([$vals], 5 - $i);
}

BEGIN_PGML

Order the following number from smallest to largest

[_]{$ans[0]} [`<`][_]{$ans[1]} [`<`][_]{$ans[2]} [`<`][_]{$ans[3]} 
[`<`][_]{$ans[4]} [`<`][_]{$ans[5]}

END_PGML

BEGIN_PGML_SOLUTION

For this, remember that the place value from right to left is
* ones
* tens
* hundreds,
* thousands, 
* ten thousands

and thus the result is

END_PGML_SOLUTION

ENDDOCUMENT();

