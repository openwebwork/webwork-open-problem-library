##DESCRIPTION
##  Problem that asks about doing arithmetic mentally.
##ENDDESCRIPTION

##KEYWORDS('teacher preparation', 'mental math', 'arithmetic')

## DBsubject('Teacher Preparation')
## DBchapter('Basic Arithmetic')
## DBsection('Mental Mathematics')
## Date('8/30/2020')
## Author('Peter Staab')
## Institution('Fitchburg State University')

DOCUMENT();

loadMacros("PGstandard.pl", "PGML.pl", "parserPopUp.pl", 'PGcourse.pl',);

Context("Numeric");

$arith_props = [
    "Select Property", "Additive Identity",
    "Associativity",   "Commutativity",
    "Compensation",    "Multiplicative Identity",
    "Reflexsive",      "Statement is not True"
];

($a1, $b1)      = random_subset(2, 250 .. 950);
($a2, $b2, $c2) = random_subset(3, 10 .. 99);
($a3, $b3, $c3) = random_subset(3, 10 .. 99);
($a4, $b4)      = random_subset(2, 10 .. 99);

@statements = (
    PGML('[`[$a1]+[$b1] = [$b1]+[$a1]`]'),
    PGML('[`[$a2]+([$b2]+[$c2]) = ([$a2]+[$b2]) + [$c2]`]'),
    PGML('[`[$a1] + 0 = [$a1]`]'),
    PGML('[`[$a4]-[$b4] = [$b4] - [$a4]`]'),
    PGML(
        '[`[$a3]\times([$b3]\times[$c3]) = ([$a3]\times[$b3]) \times [$c3]`]'
    )
);

@dropdowns =
    map { DropDown($arith_props, $_, placeholder => 'Select Property') } (
        "Commutativity",     "Associativity",
        "Additive Identity", "Statement is not True",
        "Associativity"
    );

$dd = DropDown($arith_props, 'Commutativity');

@order = random_subset(5, 0 .. 4);

$tab = LayoutTable(
    [
        [
            'a.', $statements[ $order[0] ],
            PGML('[_]{$dropdowns[$order[0]]}')
        ],
        [
            'b.', $statements[ $order[1] ],
            PGML('[_]{$dropdowns[$order[1]]}')
        ],
        [
            'c.', $statements[ $order[2] ],
            PGML('[_]{$dropdowns[$order[2]]}')
        ],
        [
            'd.', $statements[ $order[3] ],
            PGML('[_]{$dropdowns[$order[3]]}')
        ],
        [
            'e.', $statements[ $order[4] ],
            PGML('[_]{$dropdowns[$order[4]]}')
        ],
    ],
    padding => [ 0.5, 0.5 ],
    align   => 'lll'
);

BEGIN_PGML

For each of the following statements, select the arithmetic property or thinking strategy:

[$tab]*

END_PGML

@answers = (
    PGML(
        'The statement [`[$a1]+[$b1] = [$b1]+[$a1]`] is the additive commutative property.'
    ),
    PGML(
        'The statement [`[$a2]+([$b2]+[$c2]) = ([$a2]+[$b2]) + [$c2]`] is the additive associative property.'
    ),
    PGML(
        'The statement [`[$a1] + 0 = [$a1]`] is the additive identity property.'
    ),
    PGML('The statement [`[$a4]-[$b4] = [$b4] - [$a4]`] is not true.'),
    PGML(
        'The statement [`[$a3]\times([$b3]\times[$c3]) = ([$a3]\times[$b3]) \times [$c3]`] is the multiplicative associative property. '
    )
);

BEGIN_PGML_SOLUTION

a) [$answers[$order[0]]]*
b) [$answers[$order[1]]]*
c) [$answers[$order[2]]]*
d) [$answers[$order[3]]]*
e) [$answers[$order[4]]]*

END_PGML_SOLUTION

ENDDOCUMENT();
