##DESCRIPTION
##  Problem that asks about doing arithmetic mentally.
##ENDDESCRIPTION

##KEYWORDS('teacher preparation', 'mental math', 'arithmetic')

## DBsubject('Teacher Preparation')
## DBchapter('Basic Arithmetic')
## DBsection('Mental Mathematics')
## Date('8/30/2020')
## Author('Peter Staab')
## Institution('Fitchburg State University')

DOCUMENT();

loadMacros("PGstandard.pl", "PGML.pl", "parserPopUp.pl", 'PGcourse.pl');

# Show which answers are correct and which ones are incorrect
$showPartialCorrectAnswers = 0;

Context("Numeric");

do {
    @vals = random_subset(5, 0 .. 9);
} until ($vals[0] != 0);

@n = random_subset(5, 0 .. 4);

$options = [
    "Select Place Value", "Ten Thousands",
    "Thousands",          "Hundreds",
    "Tens",               "Ones"
];

@ans = (1 .. 5);

for my $i (0 .. 4) {
    $ans[$i] = PopUp($options, ${$options}[ 1 + $n[$i] ]);
}

BEGIN_PGML

Consider the number [`[$vals[0]][$vals[1]],[$vals[2]][$vals[3]][$vals[4]]`]

What is the place value of each number?

[#
    [.[$vals[$n[0]]].][.[_]{$ans[0]}.]*
    [.[$vals[$n[1]]].][.[_]{$ans[1]}.]*
    [.[$vals[$n[2]]].][.[_]{$ans[2]}.]*
    [.[$vals[$n[3]]].][.[_]{$ans[3]}.]*
    [.[$vals[$n[4]]].][.[_]{$ans[4]}.]*
#]

END_PGML

BEGIN_PGML_SOLUTION

For this, remember that the place value from right to left is
* ones
* tens
* hundreds,
* thousands,
* ten thousands

and thus the result is

* [`[$vals[4]]`] is the ones place.
* [`[$vals[3]]`] is the tens place.
* [`[$vals[2]]`] is the hundreds place.
* [`[$vals[1]]`] is the thousands place.
* [`[$vals[0]]`] is the ten thousands place.

END_PGML_SOLUTION

ENDDOCUMENT();

