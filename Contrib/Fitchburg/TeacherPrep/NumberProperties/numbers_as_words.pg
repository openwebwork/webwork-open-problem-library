##DESCRIPTION
##  Algebra problem: true or false for inequality
##ENDDESCRIPTION

##KEYWORDS('algebra', 'inequality', 'fraction')

## DBsubject('Algebra')
## DBchapter('Fundamentals')
## DBsection('Real Numbers')
## Date('6/3/2012')
## Author('Peter Staab')
## Institution('Fitchburg State University')

DOCUMENT();

loadMacros("PGstandard.pl", "PGML.pl", "PGcourse.pl");

Context("Numeric");

# convert a numerical integer to the english word version of the number.
# The range of numbers is from 1 to under 1 billion.

sub toWords {
    my $num = shift;

    my @under_twenty =
        qw/zero one two three four five six seven eight nine ten eleven twelve thirteen
        fourteen fifteen sixteen seventeen eighteen nineteen/;
    my @multiples_of_ten =
        qw/ten twenty thirty forty fifty sixty seventy eighty ninety/;
    my @powers_of_ten = qw/ten hundred thousand million/;

    if ($num < 20) {
        return $under_twenty[$num];
    } elsif ($num < 100) {
        my ($tens, $ones) = (int $num / 10, $num % 10);
        return $multiples_of_ten[ $tens - 1 ]
            . (($ones == 0) ? "" : "-" . $under_twenty[$ones]);
    } elsif ($num < 1000) {
        my ($hundreds, $remainder) = (int $num / 100, $num % 100);
        return
            toWords($hundreds) . " "
            . $powers_of_ten[1] . " "
            . (($remainder == 0) ? "" : toWords($remainder));
    } elsif ($num < 1000000) {
        my ($thousands, $remainder) = (int $num / 1000, $num % 1000);
        return
            toWords($thousands) . " "
            . $powers_of_ten[2] . " "
            . (($remainder == 0) ? "" : toWords($remainder));
    } else {
        my ($millions, $remainder) = (int $num / 1000000, $num % 1000000);
        return
            toWords($millions) . " "
            . $powers_of_ten[3] . " "
            . (($remainder == 0) ? "" : toWords($remainder));
    }
}

@a = (
    Compute(100 * random(7,  9) + random(11, 99)),
    Compute(100 * random(13, 19) + random(20, 99)),
    Compute(1000 * random(11, 55) + 10 * random(9, 99)),
    Compute(10000 * random(21, 99) + random(100, 9999))
);
@w = map { toWords($_) } @a;

BEGIN_PGML

For each of the following numbers as words, write down the number (do not use 
commas):

a) [$w[0]] = [_]{$a[0]}
b) [$w[1]] = [_]{$a[1]}
c) [$w[2]] = [_]{$a[2]}
d) [$w[3]] = [_]{$a[3]}

END_PGML

BEGIN_PGML_SOLUTION
a) [$a[0]]
b) [$a[1]]
c) [$a[2]]
d) [$a[3]]
END_PGML_SOLUTION

ENDDOCUMENT();
