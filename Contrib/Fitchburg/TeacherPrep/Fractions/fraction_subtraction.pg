##DESCRIPTION
##  Find the difference of fractions.
##ENDDESCRIPTION

##KEYWORDS('fraction', 'subtractions')

## DBsubject('Arithmetic')
## DBchapter('Fractions/rational numbers')
## DBsection('Addition/subtraction')
## Date('6/3/2012')
## Author('Peter Staab')
## Institution('Fitchburg State University')

# updated 2022.10.10

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'PGcourse.pl');

Context('LimitedFraction');
Context()->flags->set(requirePureFractions => 1);
Context()->flags->set(showMixedNumbers     => 0);

# subtract with same denominator

$den1  = random(5, 15);
$num1a = random(4, 13);
do {
    $num1b = random(3, 11);
} until $num1b < $num1a;

$frac1a = Fraction($num1a, $den1);
$frac1b = Fraction($num1b, $den1);

$ans1 = Fraction($num1a - $num1b, $den1);

# addition with denominators that are a multiple of another

$den2a = random(5, 9);
$k2    = random(2, 4);
$den2b = $k2 * $den2a;
do { $num2a = random(3, 8); } until gcd($num2a, $den2a) == 1;

do {
    $num2b = random(4, 11);
} until gcd($num2b, $den2b) == 1 && $den2b * $num2a - $den2a * $num2b > 0;

$frac2a = Fraction($num2a, $den2a);
$frac2b = Fraction($num2b, $den2b);
$ans2   = Compute($frac2a - $frac2b);

##  Fraction with GCF of denoms equal 1

do {
    $den3a = random(3, 20);
    $num3a = random(2, 15);
    $den3b = random(3, 20);
    $num3b = random(2, 15);
    } until gcd($den3a, $den3b) == 1
    && gcd($num3a, $den3a) == 1
    && gcd($num3b, $den3b) == 1
    && ($den3b * $num3a - $den3a * $num3b > 0);

$frac3a = Fraction($num3a, $den3a);
$frac3b = Fraction($num3b, $den3b);
$ans3   = Compute($frac3a - $frac3b);

## fractions will larger denominators, but GCF != 1

do {
    $den4a =
        2**random(0, 2) * 3**random(0, 2) * 5**random(0, 1) * 7**random(0, 1);
    $den4b =
        2**random(0, 2) * 3**random(0, 2) * 5**random(0, 1) * 7**random(0, 1);
} until gcd($den4a, $den4b) != 1;

do { $num4a = random(2, $den4a - 1); } until gcd($num4a, $den4a) == 1;

do {
    $num4b = random(2, $den4b - 1);
    $den4b =
        2**random(0, 2) * 3**random(0, 2) * 5**random(0, 1) * 7**random(0, 1);
} until gcd($num4b, $den4b) == 1 && $den4b * $num4a - $den4a * $num4b > 0;

$frac4a = Fraction($num4a, $den4a);
$frac4b = Fraction($num4b, $den4b);
$ans4   = Compute($frac4a - $frac4b);

BEGIN_PGML

Evaluate the following operations.  You should reduce all fractions and write
the answer as an improper fraction (not a mixed number):

a) [`` [$frac1a] -[$frac1b] = ``] [____]{$ans1}

b) [`` [$frac2a] -[$frac2b] = ``] [____]{$ans2}

c) [`` [$frac3a] -[$frac3b] = ``] [____]{$ans3}

d) [`` [$frac4a] -[$frac4b] = ``] [____]{$ans4}
END_PGML

BEGIN_PGML_SOLUTION
a) Since the denominators are the same, just substract the numerators.

    [``` [$frac1a] -[$frac1b] = [$ans1]```]

b) The denominators are not equal, so first find a common denomiator.  This is [$den2b].

    [```[$frac2a] - [$frac2b] = \frac{[$k2*$num2a]}{[$den2b]} - [$frac2b] = [$ans2]```]

c) The denominators are not equal, so first find a common denominator.  In this, case, we seek the lowest common mulitple or [@ lcm($den3a, $den3b) @]. 

    [```
    \begin{aligned}
    [$frac3a] - [$frac3b] & = \frac{[$num3a] \cdot [$den3b]}{[$den3a] \cdot [$den3b]}
    - \frac{[$num3b] \cdot [$den3a]}{[$den3b] \cdot [$den3a]} \\
    & = \frac{[$num3a*$den3b]}{[@lcm($den3a,$den3b)@]}
    - \frac{[$num3b*$den3a]}{[@lcm($den3a,$den3b)@]} = [$ans3]
    \end{aligned}
    ```]
d) The denominators are not equal, so first find a common denominator.  In this, case, we seek the lowest common mulitple or [@ lcm($den4a, $den4b) @]. 
    [```
    \begin{aligned}
    [$frac4a] - [$frac4b] & = \frac{[$num4a] \cdot [@ lcm($den4a,$den4b)/$den4a @]}{[$den4a] \cdot [@ lcm($den4a,$den4b)/$den4a @]}
    - \frac{[$num4b] \cdot [@ lcm($den4a,$den4b)/$den4b @]}{[$den4b] \cdot [@ lcm($den4a,$den4b)/$den4b @]} \\
    & = \frac{[@ $num4a*lcm($den4a,$den4b)/$den4a @]}{[@lcm($den4a,$den4b)@]}
    - \frac{[@ $num4b*lcm($den4a,$den4b)/$den4b @]}{[@lcm($den4a,$den4b)@]} = [$ans4]
    \end{aligned}
    ```]

END_PGML_SOLUTION
ENDDOCUMENT();
