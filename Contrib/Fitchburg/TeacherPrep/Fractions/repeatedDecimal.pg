##DESCRIPTION
##  Convert a repeated decimal to a rational number.
##ENDDESCRIPTION

##KEYWORDS('repeated decimal', 'fraction')

## DBsubject('Arithmetic')
## DBchapter('Decimals')
## DBsection('Converting between fractions and decimals')
## Author('Peter Staab')
## Institution('Fitchburg State University')
## Date('5/3/2020')
########################################################################

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl', 'contextFraction.pl');

Context('LimitedFraction');

$denom = 37;
$numer = random(1, $denom - 1);
$ans   = Fraction($numer, $denom);

$repeat = floor(1000 * $numer / $denom);

$str = "" . $repeat;
while (length($str) < 3) { $str = '0' . $str; }

BEGIN_PGML

Write [`0.\overline{[$str]}`] as a fraction in reduced form:

[`0.\overline{[$str]}`] = [__]{$ans}

END_PGML

BEGIN_PGML_SOLUTION
Let 
[``` x = 0.[$str]\overline{[$str]}```] and then multiply by 1000, since there are 3 repeating decimals:

[```
\begin{aligned}
1000 x & = [$str].\overline{[$str]} \\
- (x & = 0.[$str]\overline{[$str]}) \\ \hline
999x & = [$str]
\end{aligned}
```]
Therefore
[``` x = \frac{[$str]}{999} = [$ans] ```]
END_PGML_SOLUTION
ENDDOCUMENT();
