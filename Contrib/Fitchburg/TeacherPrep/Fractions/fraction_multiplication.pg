##DESCRIPTION
##  Find the product of fractions.
##ENDDESCRIPTION

##KEYWORDS('fraction', 'multiplication')

## DBsubject('Arithmetic')
## DBchapter('Fractions/rational numbers')
## DBsection('Multiplication')
## Date('6/3/2012')
## Author('Peter Staab')
## Institution('Fitchburg State University')

# updated 2022.10.10

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'PGcourse.pl');

Context('LimitedFraction');
Context()->flags->set(requirePureFractions => 1);
Context()->flags->set(showMixedNumbers     => 0);

# multiply with denoms with gcd = 1

$den1a = random(5, 10);
do {
    $num1a = random(1, 9);
} until gcd($num1a, $den1a) == 1 && $num1a < $den1a;

do {
    $den1b = random(5, 10);
} until gcd($den1b, $den1a) == 1;

do {
    $num1b = random(1, 9);
} until gcd($den1b, $num1b) == 1 && $num1b < $den1b;

$frac1a = Fraction($num1a, $den1a);
$frac1b = Fraction($num1b, $den1b);

$ans1 = Fraction($frac1a * $frac1b);

# multiply with denoms with gcd = 1 and improper

$den2a = random(5, 10);
do { $num2a = random(6, 20); }
    until gcd($num2a, $den2a) == 1 && $num2a > $den2a;

do { $den2b = random(5, 10); } until gcd($den2b, $den2a) == 1;

do { $num2b = random(5, 20); }
    until gcd($den2b, $num2b) == 1 && $num2b > $den2b;

$frac2a = Fraction($num2a, $den2a);
$frac2b = Fraction($num2b, $den2b);

$ans2 = Fraction($frac2a * $frac2b);

# multiplication with denominators that are a multiple of another

$den3a = random(3, 9);
$den3b = random(2, 4) * $den3a;
do { $num3a = random(3, 8); } until gcd($num3a, $den3a) == 1;

do { $num3b = random(4, 11); } until gcd($num3b, $den3b) == 1;

$frac3a = Fraction($num3a, $den3a);
$frac3b = Fraction($num3b, $den3b);
$ans3   = Compute($frac3a * $frac3b);

## fractions will larger denominators, but GCF != 1

do {
    $den4a =
        2**random(0, 2) * 3**random(0, 2) * 5**random(0, 1) * 7**random(0, 1);
    $den4b =
        2**random(0, 2) * 3**random(0, 2) * 5**random(0, 1) * 7**random(0, 1);
} until gcd($den4a, $den4b) != 1 && $den4a > 2 && $den4b > 2;

do {
    $num4a = random(2, $den4a - 1);
} until gcd($num4a, $den4a) == 1;

do {
    $num4b = random(2, $den4b - 1);
    $den4b =
        2**random(0, 2) * 3**random(0, 2) * 5**random(0, 1) * 7**random(0, 1);
} until gcd($num4b, $den4b) == 1 && $den4b * $num4a - $den4a * $num4b > 0;

$frac4a = Fraction($num4a, $den4a);
$frac4b = Fraction($num4b, $den4b);
$ans4   = Compute($frac4a * $frac4b);

BEGIN_PGML

Evaluate the following operations.  You should reduce all fractions and write
the answer as an improper fraction (not a mixed number):

a) [`` [$frac1a] \times[$frac1b] = ``] [____]{$ans1}

b) [`` [$frac2a] \times[$frac2b] = ``] [____]{$ans2}

c) [`` [$frac3a] \times[$frac3b] = ``] [____]{$ans3}

d) [`` [$frac4a] \times[$frac4b] = ``] [____]{$ans4}
END_PGML

sub primeFactorization {
    my $a       = shift;
    my $N       = $a;
    my $factors = {};
    for my $n (2 .. $N) {
        while ($a % $n == 0) {
            $factors->{$n} = defined($factors->{$n}) ? $factors->{$n} + 1 : 1;
            $a /= $n;
            # warn pretty_print $factors;
        }
    }
    return $factors;
}

sub pf_to_tex {
    my $factors = shift;
    @strs = ();
    for (num_sort(keys %$factors)) {
        push(@strs, "$_" . ($factors->{$_} == 1 ? '' : '^' . $factors->{$_}));
    }
    return join('\cdot ', @strs);
}

$pn1a = primeFactorization($num1a);
$pd1a = primeFactorization($den1a);
$pn1b = primeFactorization($num1b);
$pd1b = primeFactorization($den1b);

$pn2a = primeFactorization($num2a);
$pd2a = primeFactorization($den2a);
$pn2b = primeFactorization($num2b);
$pd2b = primeFactorization($den2b);

$pn3a = primeFactorization($num3a);
$pd3a = primeFactorization($den3a);
$pn3b = primeFactorization($num3b);
$pd3b = primeFactorization($den3b);

$pn4a = primeFactorization($num4a);
$pd4a = primeFactorization($den4a);
$pn4b = primeFactorization($num4b);
$pd4b = primeFactorization($den4b);

BEGIN_PGML_SOLUTION
For each of these, in general, we will write the prime factorization of each and reduce.  If one can see a common factor without doing this, that can also be done. 

a) [``` [$frac1a] \times[$frac1b] = \frac{[@ pf_to_tex($pn1a) @]}{[@ pf_to_tex($pd1a) @]}
    \times \frac{[@ pf_to_tex($pn1b) @]}{[@ pf_to_tex($pd1b) @]} = [$ans1]
    ```]

b) [``` [$frac2a] \times[$frac2b] = \frac{[@ pf_to_tex($pn2a) @]}{[@ pf_to_tex($pd2a) @]}
    \times \frac{[@ pf_to_tex($pn2b) @]}{[@ pf_to_tex($pd2b) @]} = [$ans2]
    ```]

c) [``` [$frac3a] \times[$frac3b] = \frac{[@ pf_to_tex($pn3a) @]}{[@ pf_to_tex($pd3a) @]}
    \times \frac{[@ pf_to_tex($pn3b) @]}{[@ pf_to_tex($pd3b) @]} = [$ans3]
    ```]

d) [``` [$frac4a] \times[$frac4b] = \frac{[@ pf_to_tex($pn4a) @]}{[@ pf_to_tex($pd4a) @]}
    \times \frac{[@ pf_to_tex($pn4b) @]}{[@ pf_to_tex($pd4b) @]} = [$ans4]
    ```]

END_PGML_SOLUTION

ENDDOCUMENT();
