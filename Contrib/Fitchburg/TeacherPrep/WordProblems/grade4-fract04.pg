# DESCRIPTION
# A simple grade 4 fraction word problem.
# ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Fractions')
## DBsection('Word problems')
## KEYWORDS('word problem','fraction','sandwich')
## Author('Peter Staab')
## Institution('Fitchburg State University')
## Date('04/05/2021')

DOCUMENT();
loadMacros(
    'PGstandard.pl',   'PGML.pl',
    'randomPerson.pl', 'contextFraction.pl',
    'PGcourse.pl'
);

Context('Fraction');

do {
    $x = list_random(3, 4,  5,  10);
    $y = list_random(5, 10, 20, 25);
} until ($x != $y);
$prod = $x * $y;

$person = randomPerson();

$f          = Compute("1-$x/$prod");
$fract_left = Compute("$x/$prod");
$ans        = Compute("1-$f");

BEGIN_PGML

[$person] made  [`[$prod]`] sandwiches for a children's party.  The children ate [`[$f]`] of the sandwiches.  How many sandwiches are left?

[________]{$x}

END_PGML

BEGIN_PGML_SOLUTION

The fraction of sandwiches left is [``1-[$f] = [$fract_left]``].

Then [``[$fract_left]``] of [`[$prod]`] is [`[$x]`].

END_PGML_SOLUTION

ENDDOCUMENT();
