# DESCRIPTION
# A simple grade 3 multiplication word problem.
# ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Addition')
## DBsection('Word problems')
## KEYWORDS('word problem', 'division')
## Author('Peter Staab')
## Institution('Fitchburg State University')
## Date('04/05/2021')

#updated 2023.03.17

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'randomPerson.pl', 'PGcourse.pl');

Context("Numeric");

$p = randomPerson();

do { $x1 = random(3, 9); $x2 = random(2, 5); } until ($x1 != $x2);

$prod = $x1 * $x2;

BEGIN_PGML

[$p] has  [$prod] sticks of gum.  If [$p->they] [@ $p->verb('give') @] each 
of [$p->their] [$x2] friends the same number of sticks of gum, how many sticks
of gum will each of [$p]'s friends have? [________]{$x1}


END_PGML

BEGIN_PGML_SOLUTION

The total number of pages is the number of the three page totals or
[`[$m1]+[$m2]+[$m3] = [$ans1]`]

END_PGML_SOLUTION

ENDDOCUMENT();
