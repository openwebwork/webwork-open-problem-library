# DESCRIPTION
# A simple grade 3 addition word problem.
# ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Addition')
## DBsection('Word problems')
## Author('Peter Staab')
## KEYWORDS('word problem','sum', 'difference', 'age')
## Institution('Fitchburg State University')
## Date('04/05/2021')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'randomPerson.pl', 'PGcourse.pl');

Context("Numeric");

$a1 = random(49, 72);
$a2 = random(25, 48);
$a3 = random(39, 61);

($last_name1, $last_name2, $last_name3) = randomLastName(n => 3);

BEGIN_PGML

Mrs. [$last_name1] is [$a1] years old, Mr. [$last_name2] is [$a2] years old and
Ms. [$last_name3] is [$a3] years old.

a) Their combined age is ? [_______]{Real($a1+$a2+$a3)}

b) How much old is Mrs. [$last_name1] than Mr. [$last_name2]? [_______]{Real($a1-$a2)}

END_PGML

BEGIN_PGML_SOLUTION

a) Their combined age is the sum or [@ $a1+$a2+$a3 @].

b)  the difference of the ages or [`[$a1]-[$a2]=`] [@ $a1-$a2 @]

END_PGML_SOLUTION

ENDDOCUMENT();
