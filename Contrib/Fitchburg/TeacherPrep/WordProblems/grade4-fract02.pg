# DESCRIPTION
# A simple grade 4 fraction word problem.
# ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Fractions')
## DBsection('Word problems')
## KEYWORDS('word problem','fraction','juice')
## Author('Peter Staab')
## Institution('Fitchburg State University')
## Date('04/05/2021')

DOCUMENT();
loadMacros(
    'PGstandard.pl',   'PGML.pl',
    'randomPerson.pl', 'contextFraction.pl',
    'PGcourse.pl'
);

Context('Fraction');

do {
    $denom = list_random(5, 7, 9);
    $a1    = random(1, 2);
    $a2    = random(2, 5);

    $f1  = Compute("$a1/$denom");
    $f2  = Compute("$a2/$denom");
    $ans = Compute($f1 + $f2);
} until ($a1 + $a2 < $denom);

@p = randomPerson(n => 2);

BEGIN_PGML
[$p[0]] drank [`[$f1]`] of a bottle of juice and [$p[1]] drank [`[$f2]`]
of it?  What fraction of the bottle did they drink altogether? [________]{$ans}

END_PGML

BEGIN_PGML_SOLUTION

This is the addition of fractions.  Since the denominators are the same, the result is the sum of the numerators over the common denominator or
[`[$ans]`]

END_PGML_SOLUTION

ENDDOCUMENT();
