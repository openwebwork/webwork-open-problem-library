# DESCRIPTION
# A mixed addition and subtraction word problem.
# ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Addition')
## DBsection('Word problems')
## KEYWORDS('word problem','chocolate','money', 'multiplication')
## Author('Peter Staab')
## Institution('Fitchburg State University')
## Date('04/05/2021')

#updated 2023.03.17

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'randomPerson.pl', 'PGcourse.pl');

# This is used so students must do the calculation and not allow operations.
Context('LimitedNumeric');

$barsPerBox = random(15, 50, 5);
$numBoxes   = random(3,  9);
$costPerBar = random(2,  4);
$ans        = Compute($barsPerBox * $numBoxes * $costPerBar);

$p = randomPerson();

BEGIN_PGML

There are [$barsPerBox] chocolate bars in each box.  [$p] bought [$numBoxes] boxes
of chocolate bars.  If each bar costs $[$costPerBar], how much total did [$p->they] pay
for all of the chocolate bars? $[__]{$ans}

END_PGML

BEGIN_PGML_SOLUTION
There are [`[$barsPerBox]\times [$numBoxes] = [@ $barsPerBox * $numBoxes@]`] total chocolate bars.

The total cost will then be [`[@ $barsPerBox * $numBoxes@] \times [$costPerBar] = [$ans]`]
END_PGML_SOLUTION

ENDDOCUMENT();
