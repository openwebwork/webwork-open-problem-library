# DESCRIPTION
# A simple grade 3 division word problem.
# ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Addition')
## DBsection('Word problems')
## KEYWORDS('word problem', 'goldfish','multiplication', 'division')
## Author('Peter Staab')
## Institution('Fitchburg State University')
## Date('04/05/2021')

#updated 2023.03.17

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'randomPerson.pl', 'PGcourse.pl');

Context("Numeric");

$p = randomPerson();

do { $x1 = random(3, 9); $x2 = random(2, 5); } until ($x1 != $x2);
$prod = $x1 * $x2;

BEGIN_PGML

[$p]'s fish store has [$prod] goldfish. The fish are in  [$x2] aquariums.
The same number of goldfish are in each aquarium.  How many goldfish are in each aquarium?

a) There are [________]{$prod} goldfish.

b) There are [________]{$x2} aquariums.

c) There are [________]{$x1} goldfish in each aquarium.


END_PGML

BEGIN_PGML_SOLUTION

a) The number of goldfish is [`[$prod]`]

b) The number of aquariums is [`[$x2]`]

c) The number of goldfish in each aquarium is [`[$prod] \div [$x2]=[$x1]`]

END_PGML_SOLUTION

ENDDOCUMENT();
