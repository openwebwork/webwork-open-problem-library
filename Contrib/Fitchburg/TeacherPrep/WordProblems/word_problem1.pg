# DESCRIPTION
# A mixed addition and subtraction word problem.
# ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Addition')
## DBsection('Word problems')
## KEYWORDS('word problem','books','difference')
## Author('Peter Staab')
## Institution('Fitchburg State University')
## Date('04/05/2021')

#updated 2023.03.17

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl',  'contextFraction.pl', 'PGcourse.pl');

# This is used so students must do the calculation and not allow operations.
Context('LimitedNumeric');

$checkedOut   = 10 * random(40, 70);
$pictureBooks = random(200, 400);
$chapterBooks = random(300, 500);
$total        = $checkedOut + $pictureBooks + $chapterBooks;
$ans          = Compute($chapterBooks);

BEGIN_PGML

There were [$total] chapter and picture books in a children's library.
[$checkedOut] of them were checked out.
[$pictureBooks] of the books left were picture books.
How many chapter books were left? [__]{$ans}

END_PGML

BEGIN_PGML_SOLUTION
The number of chapter books is the total number less the sum of those checked
out and the picture books.

There are [`[$checkedOut]+[$pictureBooks] = [@ $checkedOut+$pictureBooks @]`] picture books and those checked out, so
there are [`[$total] - [@ $checkedOut+$pictureBooks @] = [$ans]`] chapter books.
END_PGML_SOLUTION

ENDDOCUMENT();
