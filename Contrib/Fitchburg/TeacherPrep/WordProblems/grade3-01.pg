# DESCRIPTION
# A simple grade 3 addition word problem.
# ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Addition')
## DBsection('Word problems')
## KEYWORDS('word problem', 'addition', 'marbles')
## Author('Peter Staab')
## Institution('Fitchburg State University')
## Date('04/05/2021')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'randomPerson.pl', 'PGcourse.pl');

Context('Numeric');

@persons = randomPerson(n => 4);
$m1      = random(25,  75);
$m2      = random(15,  40);
$m3      = random(125, 175);
$m4      = random(50,  90);

BEGIN_PGML

a) [@ $persons[0] @] has [$m1] marbles and [@$persons[1] @] has [$m2] marbles.
How many marbles do they have altogether? [________]{Real($m1 + $m2)}

b) [@ $persons[2] @] has [$m3] stickers and [@ $persons[3] @] has [$m4] stickers.
How many marbles do they have altogether? [________]{$ans2 = Real($m3 + $m4)}

END_PGML

BEGIN_PGML_SOLUTION
a) In this case, add [$m1] and [$m2] for a total of [$m1+$m2] marbles. 
b) In this case, add [$m3] and [$m4] for a total of [$m3+$m4] marbles. 
END_PGML_SOLUTION

ENDDOCUMENT();
