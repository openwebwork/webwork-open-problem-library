# DESCRIPTION
# A simple grade 4 fraction word problem.
# ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Fractions')
## DBsection('Word problems')
## KEYWORDS('word problem','fraction','cake')
## Author('Peter Staab')
## Institution('Fitchburg State University')
## Date('04/05/2021')

#updated 2023.03.17

DOCUMENT();
loadMacros(
    'PGstandard.pl',   'PGML.pl',
    'randomPerson.pl', 'contextFraction.pl',
    'PGcourse.pl'
);

Context("Fraction");

$denom = random(4, 8);
$a1    = random(1, 2);
$a2    = random(2, 5);
$f1    = Compute("$a1/$denom");
$f2    = Compute("$a2/$denom");

@p   = randomPerson(n => 2);
$ans = Compute($f1 + $f2);

BEGIN_PGML

[$p[0]] ate [`[$f1]`] of a cake and [$p[1]] ate [`[$f2]`] of it?  What fraction of
the cake did they eat altogether? [________]{$ans}

END_PGML

BEGIN_PGML_SOLUTION
This is the addition of fractions.  Since the denominators are the same, the result is the sum of the numerators over the common denominator or
[`[$ans]`]

END_PGML_SOLUTION

ENDDOCUMENT();
