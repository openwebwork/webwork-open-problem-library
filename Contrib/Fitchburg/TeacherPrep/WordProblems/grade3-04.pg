# DESCRIPTION
# A grade 3 addition word problem with 4 digit addition.
# ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Addition')
## DBsection('Word problems')
## KEYWORDS('word problem','sum', 'difference')
## Author('Peter Staab')
## Institution('Fitchburg State University')
## Date('04/05/2021')

#updated 2023.03.17

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context("Numeric");

do { $s1 = random(1123, 1689); $s2 = random(1123, 1689); } while ($s2 < $s1);

@school_names =
    random_subset(2, 'South', 'East', 'North', 'West', 'Washington', 'Lincoln',
        'City');

BEGIN_PGML

[$school_names[0]] High School has [$s1] students and [$school_names[1]] High school has [$s2] students.

a) How many students do the two schools have altogether? [_______]{Real($s1+$s2)}

b) How many more students does [$school_names[1]] High School have than 
[$school_names[0]] High School? [_______]{Real($s2+$s1)}


END_PGML

BEGIN_PGML_SOLUTION

a) The total number of students is the sum or [@ Real($s1+$s2) @].

b) The difference of the two student populations or [@ Real($s2-$s1) @]

END_PGML_SOLUTION

ENDDOCUMENT();
