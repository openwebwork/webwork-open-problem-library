# DESCRIPTION
# A simple grade 3 addition word problem.
# ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Addition')
## DBsection('Word problems')
## KEYWORDS('word problem', 'money', 'sum')
## Author('Peter Staab')
## Institution('Fitchburg State University')
## Date('04/05/2021')

#updated 2023.03.17

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'randomPerson.pl', 'PGcourse.pl');

Context("Numeric");

@p  = randomPerson(n => 2);
$m1 = random(25, 75);
$m2 = 5 * random(1, 6);

$diff = random(40, 80);
$m3   = $m1 + $m2 + $diff;

BEGIN_PGML

[$p[0]] has saved [$m1] dollars.  [$p[0]->Their] grandmother
gave [$p[0]->them] [$m2] dollars for [$p[0]->their] birthday.

a) How much money does [$p[0]] have now? [__]{Real($m1+$m2)}

b) [$p[0]] and [$p[1]] have a total of  [$m3] dollars altogether.  How much does 
[$p[1]] have? [_____]{Real($diff)}

END_PGML

BEGIN_PGML_SOLUTION

a) This is a sum of [$m1] and [$m2] or [$m1+$m2].

b) This is a subtraction problem with [`[$m3]-[@ $m1+$m2 @]`] which is [$diff].

END_PGML_SOLUTION

ENDDOCUMENT();
