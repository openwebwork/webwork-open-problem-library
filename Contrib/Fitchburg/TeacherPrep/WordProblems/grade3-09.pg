# DESCRIPTION
# A simple grade 3 addition word problem.
# ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Addition')
## DBsection('Word problems')
## KEYWORDS('word problem','sum','marble','sticker')
## Author('Peter Staab')
## Institution('Fitchburg State University')
## Date('04/05/2021')

#updated 2023.03.17

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'randomPerson.pl', 'PGcourse.pl');

Context("Numeric");

@p = randomPerson(n => 4);

$m1 = random(25,  75);
$m2 = random(15,  40);
$m3 = random(125, 175);
$m4 = random(50,  90);

BEGIN_PGML

a) [$p[0]] has [$m1] marbles and [$p[1]] has [$m2] marbles.  
How many marbles do they have altogether?[________]{Real($m1+$m2)}

b) [$p[2]] has [$m3] stickers and [$p[3]] has [$m4] stickers.  
How many stickers do they have altogether? [________]{Real($m3+$m4)}



END_PGML

BEGIN_PGML_SOLUTION

a) This is the sum [`[$m1]+[$m2]=[@ $m1+$m2 @]`]

b) This is the sum [`[$m3]+[$m4]=[@ $m3+$m4 @]`]

END_PGML_SOLUTION

ENDDOCUMENT();
