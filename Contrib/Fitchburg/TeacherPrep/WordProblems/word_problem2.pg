# DESCRIPTION
# A mixed addition and subtraction word problem.
# ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Addition')
## DBsection('Word problems')
## KEYWORDS('word problem','sandwich','multiplication')
## Author('Peter Staab')
## Institution('Fitchburg State University')
## Date('04/05/2021')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'randomPerson.pl', 'PGcourse.pl');

Context('LimitedNumeric');

$sandwiches = 10 * random(21, 49);
$factor     = random(3, 5);
$ans        = Compute(($factor + 1) * $sandwiches);

$p     = randomPerson();
@types = random_subset(
    2,               'peanut butter and jelly',
    'egg salad',     'turkey', 'ham and cheese',
    'fluffernutter', 'chicken salad'
);

BEGIN_PGML
[$p] made [$sandwiches] [$types[0]] sandwiches.  [$p->They] made [$factor] times as many
[$types[1]] sandwiches as [$types[0]] sandwiches.
How many sandwiches did [$p->they] make? [__]{$ans}
END_PGML

BEGIN_PGML_SOLUTION
[$p->They] made [`[$factor] \times [$sandwiches]= [@ $factor*$sandwiches @]`]
[$types[1]] sandwiches.

[$p->They] made a total of [`[$sandwiches] + [@ $factor*$sandwiches @] = [$ans]`] sandwiches.

END_PGML_SOLUTION

ENDDOCUMENT();
