# DESCRIPTION
# An addition problem with 3 addends without regrouping.
# ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Addition')
## DBsection('Word problems')
## KEYWORDS('word problem', 'book', 'sum')
## Author('Peter Staab')
## Institution('Fitchburg State University')
## Date('04/05/2021')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'randomPerson.pl', 'PGcourse.pl');

Context("Numeric");

@p = randomPerson(n => 3);

$m1 = 300 + 10 * random(1, 3) + random(0, 3);
$m2 = 300 + 10 * random(1, 3) + random(0, 3);
$m3 = 300 + 10 * random(1, 3) + random(0, 3);

$ans1 = Real($m1 + $m2 + $m3);

BEGIN_PGML

[$p[0]] read [$m1] pages in a book.  [$p[1]] read [$m2] pages. [$p[2]] read [$m3] pages. How many pages did they read altogether?

[________]{$ans1}


END_PGML

BEGIN_PGML_SOLUTION
The total number of pages is the number of the three page totals or
[`[$m1]+[$m2]+[$m3] = [$ans1]`]

END_PGML_SOLUTION

ENDDOCUMENT();
