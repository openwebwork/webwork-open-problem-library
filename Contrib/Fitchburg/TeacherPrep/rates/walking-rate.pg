##DESCRIPTION
##  Algebra problem: true or false for inequality
##ENDDESCRIPTION

##KEYWORDS('algebra', 'inequality', 'fraction')

## DBsubject('Basic Math')
## DBchapter('Rates')
## DBsection('Rates')
## Date('11/11/2015')
## Author('Peter Staab')
## Institution('Fitchburg State University')

########################################################################

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'randomPerson.pl', 'PGcourse.pl');

Context("Numeric");

$p = randomPerson();
do {
    $time1 = random(5, 30, 5);
    $time2 = random(5, 30, 5);
} while ($time1 == $time2);

$rate1 = random(2, 5) * $time2;
$rate2 = Compute($rate1 * $time1 / $time2)->reduce;

BEGIN_PGML

[$p] took [$time1] minutes to walk to school at an average speed of 
[$rate1] meters/min.
[$p->Their] brother took [$time2] minutes to walk the same distance. 
Find [$p->their] brother's average speed.  
    [_]{$rate2} meters per minute
END_PGML

BEGIN_PGML_SOLUTION
Although other ways to do this, we can first find the total distance to school.

[```
[$time1] ~\text{minutes} \times [$rate1] \frac{\text{meters}}{\text{minute}} =
[@ $time1 * $rate1 @]~\text{meters} 
```]

And now the average is the total distance divided by the total time:
[```
\text{brother's speed} = \frac{[@ $time1 * $rate1 @] \text{~meters}}
{[$time2]~\text{minutes}} = [$rate2]  \frac{\text{meters}}{\text{minute}}
```]

END_PGML_SOLUTION

ENDDOCUMENT();
