##DESCRIPTION
##  Algebra problem: true or false for inequality
##ENDDESCRIPTION

##KEYWORDS('algebra', 'inequality', 'fraction')

## DBsubject('Basic Math')
## DBchapter('Rates')
## DBsection('Rates')
## Date('11/11/2015')
## Author('Peter Staab')
## Institution('Fitchburg State University')
# updated 2023.08.20

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'randomPerson.pl', 'PGcourse.pl');

Context("Numeric");

$speed    = random(3,  8,  0.5);
$time     = random(20, 80, 5);
$distance = $speed * $time * 60;

$p = randomPerson();

BEGIN_PGML
[$p] is running at a speed of [$speed] m/s.
How many minutes will [$p->they] take to run a distance 
of [$distance] m? [_]{$time}
END_PGML

BEGIN_PGML_SOLUTION
We start with the given information and then multiply by factors that equal 1 due to unit conversions:

[```
[$distance]~\text{m} \times 
\frac{1~\text{sec}}{[$speed]~\text{m}} \times
\frac{1~\text{min}}{60~\text{sec}} 
= [$time]~{\text{min}}
```]

END_PGML_SOLUTION

ENDDOCUMENT();
