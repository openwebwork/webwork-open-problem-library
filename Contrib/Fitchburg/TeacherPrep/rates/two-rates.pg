##DESCRIPTION
##  Algebra problem: true or false for inequality
##ENDDESCRIPTION

##KEYWORDS('algebra', 'inequality', 'fraction')

## DBsubject('Basic Math')
## DBchapter('Rates')
## DBsection('Rates')
## Date('11/11/2015')
## Author('Peter Staab')
## Institution('Fitchburg State University')
# updated 2023.08.20

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'PGcourse.pl');
Context('Fraction');

do {
    $n = random(2, 6);
    $m = random(2, 7);
} until $n != $m;

$weight_per_bag = random(40, 80, 10);
$total_weight   = ($m + $n) * $weight_per_bag * random(5, 20, 5);

$time = Compute($total_weight / ($weight_per_bag / $m + $weight_per_bag / $n));

BEGIN_PGML

It takes one corn mill [$m] minutes to grind a [$weight_per_bag]-pound bag of corn into cornmeal, while it takes a second mill [$n] minutes to grind a [$weight_per_bag]-pound bag of corn.  If both mills are working at the same time, how long would it take to grind [$total_weight] pounds of corn?  
    [_]{$time} minutes.
END_PGML
$avg_rate       = Fraction($weight_per_bag * ($m + $n), $m * $n);
$avg_rate_recip = Fraction("1/$avg_rate");
BEGIN_PGML_SOLUTION
First, find the combined rate of the two mills working together.  This is found
using 
[```
\frac{[$weight_per_bag]~\text{pound}}{[$m]~\text{min}} + 
\frac{[$weight_per_bag]~\text{pound}}{[$n]~\text{min}} =
[$weight_per_bag] \times \frac{[$m] + [$n]}{[$m]\times [$n]} 
\frac{~\text{pound}}{\text{min}} = 
[$avg_rate] \frac{~\text{pound}}{\text{min}}
```]
where common denominator of the fraction is used in this calculation. 

Use this to find
[```
[$total_weight]~\text{pounds} \times [$avg_rate_recip] \frac{\text{min}}{\text{pound}} = [$time]~\text{minutes}
```]
END_PGML_SOLUTION

ENDDOCUMENT();
