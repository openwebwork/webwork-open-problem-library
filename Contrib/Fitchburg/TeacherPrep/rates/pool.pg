##DESCRIPTION
##  Algebra problem: true or false for inequality
##ENDDESCRIPTION

##KEYWORDS('algebra', 'inequality', 'fraction')

## DBsubject('Basic Math')
## DBchapter('Rates')
## DBsection('Rates')
## Date('11/11/2015')
## Author('Peter Staab')
## Institution('Fitchburg State University')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context("Numeric");

$rate = random(8, 12);
$time = random(2, 4);
$vol  = Real($rate * $time * 60);

BEGIN_PGML
A pool is being filled by a hose that adds water at a rate of [$rate] liters/minute.  It takes [$time] hours to fill the pool.

How large is the pool in liters? [_]{$vol} liters.
END_PGML

BEGIN_PGML_SOLUTION
We start with the given information and then multiply by factors that equal 1 due to unit conversions:

[```
[$time]~\text{hours} \times
\frac{60~\text{minutes}}{1~\text{hour}} \times
\frac{[$rate]~\text{liters}}{\text{minute}}
= [$vol]~\text{liters}
```]

END_PGML_SOLUTION

ENDDOCUMENT();
