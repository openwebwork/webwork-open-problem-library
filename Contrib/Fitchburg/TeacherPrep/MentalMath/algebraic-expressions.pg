##DESCRIPTION
##  Which of the following mathematical statements are algebraic expressions.
##ENDDESCRIPTION

##KEYWORDS('algebra', 'expression')

## DBsubject('Algebra')
## DBchapter('Misc.')
## DBsection('Misc.')
## Date('10/2/2015')
## Author('Peter Staab')
## Institution('Fitchburg State University')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'parserCheckboxList.pl', 'PGcourse.pl');

Context('Numeric');
# Show which answers are correct and which ones are incorrect
$showPartialCorrectAnswers = 0;

$a1    = random(5, 25);
$b1    = random(5, 10);
$c1    = random(5, 10);
$d1    = random(5, 25);
$e1    = random(2, 5);
$expr1 = "\( $a1($b1+$c1) - \frac{$d1}{$e1} \)";

$a2    = random(5, 10);
$b2    = random(5, 10);
$expr2 = "\( $a2 + x\div $b2 \)";

$a3    = random(5, 25);
$expr3 = "\( a + $a3  \)";

$a4    = random(5, 10);
$b4    = random(5, 10);
$expr4 = "\( $a4 \pi + $b4 x^2 \)";

$a5    = random(5, 10);
$b5    = random(5, 10);
$c5    = random(5, 10);
$expr5 = "\( $a5 x + $b5 = $c5 \)";

$a6    = random(5, 10);
$b6    = random(5, 10);
$expr6 = "\( $a6 \div 0\)";

$a7    = random(5, 10);
$b7    = random(5, 10);
$expr7 = "\($b7 \cdot $a7^{x}\)";

# enter some questions and their answers

$checks = CheckboxList(
    [ [ $expr1, $expr2, $expr3, $expr4, $expr5, $expr6, $expr7 ] ],
    [ 0, 1, 2, 3 ],
    labels => "ABC"
);

BEGIN_PGML
Select all of the following that are algebraic expressions:

[__]{$checks}
END_PGML

BEGIN_PGML_HINT
Recall that algebraic expressions are combinations of numbers and variables that use the operations [`+,-,\cdot, \div`] and constant powers (not exponentials).
END_PGML_HINT

BEGIN_PGML_SOLUTION
Recall that algebraic expressions are combinations of numbers and variables that use the operations [`+,-,\cdot, \div`] and constant powers (not exponentials).

Of the list, the answers are [$checks].
END_PGML_SOLUTION
ENDDOCUMENT();
