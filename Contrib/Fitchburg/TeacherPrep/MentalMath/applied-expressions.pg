##DESCRIPTION
##  Write algebraic descriptions of applied statements.
##ENDDESCRIPTION

##KEYWORDS('algebra', 'expression')

## DBsubject('Algebra')
## DBchapter('Functions')
## DBsection('Interpretation and applications')
## Date('10/2/2015')
## Author('Peter Staab')
## Institution('Fitchburg State University')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Numeric');
Context()->variables->add(
    m => 'Real',
    s => 'Real',
    y => 'Real',
    p => 'Real',
    n => 'Real',
    w => 'Real',
);

$p = random(3,  10);
$h = random(5,  10);
$y = random(10, 20);
$d = random(1,  5);
$k = random(2,  4);
$m = random(50, 150, 25);

@ans = (
    Compute("m/12"),            Compute('4s'),
    Compute("5x+10y"),          Compute("16*$p p"),
    Compute("3n+3"),            Compute("w/$h"),
    Compute("y/5 - $y/5 + $d"), Compute("$k n - $m")
);

@statements = (
    PGML('The number of feet in [`m`] inches.'),
    PGML('The perimeter of a square of side [`s`] cm.'),
    PGML('The number of cents in [`x`] nickels and [`y`] dimes.'),
    PGML('The number of ounces in [`[$p] p`] pounds.'),
    PGML(
        q/The sum of three consecutive whole numbers the smallest of which is [`n`]./
    ),
    PGML(
        'The average speed of a train that travels [`w`] miles in [$h] hours.'),
    PGML(
        q/Ann is [$y] years younger than Bill.  Carmen is one-fifth as old as Ann.
Dana is [$d] years older than Carmen. If Bill is [`y`] years old,
what is Dana's age in terms of [`y`]?/
    ),
    PGML(
        q/Fred has [`n`] marbles.  June has [$m] fewer than [$k] times the number
of Fred's marbles.  How many marbles does June have in terms of [`n`]?/
    )
);

@order = random_subset(5, 0 .. $#statements);

BEGIN_PGML
Write indicated expressions.

a)  [$statements[$order[0]]]*
    [_]{$ans[$order[0]]}
b)  [$statements[$order[1]]]*
    [_]{$ans[$order[1]]}
c)  [$statements[$order[2]]]*
    [_]{$ans[$order[2]]}
d)  [$statements[$order[3]]]*
    [_]{$ans[$order[3]]}
e)  [$statements[$order[4]]]*
    [_]{$ans[$order[4]]}

END_PGML
@answers = (
    PGML(
        q/This is converting from inches to feet or dividing by 12.  The answer 
is [`[$ans[0]]`]/
    ),
    PGML(
        q/If the side of a square is [`s`], the perimeter in terms of this is
[`[$ans[1]]`]./
    ),
    PGML(
        q/To find the number of cents in [`x`] nickels and [`y`] dimes recall
that a nickel is 5 cents and a dime is 10 cents, so the result is [`[$ans[2]]`]/
    ),
    PGML(
        q/This converts from ounces to pounds, which is dividing by 16.  The answer
is [`[$ans[3]]`]./
    ),
    PGML(
        q/Algebraically three consecutive numbers is [`n, n+1, n+2`] is [`[$ans[4]]`]./
    ),
    PGML(q/If the train travels [`w`] files in [$h] hours, then just divide these to
get [``[$ans[5]]``]/),
    PGML(q!First, Bill is [`y`] years old.  If Ann is [$y] years younger, then her age
is [`y-16`]. Carmen then is [`(y-[$y])/5`] years old.  Dana is [`(y-[$y])/5+[$d]`]
years old.!),
    PGML(q/[`[$k]`] times the number of Fred's marbles is [`[$k]n`].  To find the 
number of June's marbles is to subtract [$m] marbles.  Therefore, she has [``[$ans[7]]``]
marbles./)
);

BEGIN_PGML_SOLUTION
a) [$answers[$order[0]]]*
b) [$answers[$order[1]]]*
c) [$answers[$order[2]]]*
d) [$answers[$order[3]]]*
e) [$answers[$order[4]]]*

END_PGML_SOLUTION

ENDDOCUMENT();
