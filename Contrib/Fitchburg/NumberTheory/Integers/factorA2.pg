# DESCRIPTION
# Find the prime factorization of a number.
# ENDDESCRIPTION

## DBsubject(Number theory)
## DBchapter(Divisibility)
## DBsection(Prime factorization)
## Date(September 5, 2016)
## Institution(Fitchburg State University)
## Author(Peter Staab)
## MO(1)

# update 2022.10.30


DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

# maximum number of factors for each prime.
$max_factors = {2 => 4,3 => 3,5 => 4, 7=> 1};

@factors = ();
$n = 1;
for $p (num_sort(keys %$max_factors)) {
	for $i (1..random(0,$max_factors->{$p})) {
		push(@factors,$p);
		$n *= $p;
	}
}
# include either 13 or 17 for the largest factor
push(@factors, random(0,1) == 0 ? 13 : 17);
$n *= $factors[$#factors];

BEGIN_PGML

For [`n = [$n]`], find the prime factorization.

Note: Enter your answer as a comma-separated list.  If the factorization is
[`2^2\cdot 3^3`], enter your answer as [`2,2,3,3,3`].

[____]{List(@factors)}

END_PGML

# pretty prints the factors
$str = '';
$base = $factors[0];
$pow = 1;
for $i (1..$#factors){
	if ($factors[$i] == $factors[$i-1]) {
		$pow++;
	} else {
		$str .= $pow == 1 ? "$base \cdot" : "$base^{$pow} \cdot";
		$base = $factors[$i];
		$pow = 1;
	}
}
$str .= $pow == 1 ? "$base" : "$base^{$pow}";


BEGIN_PGML_SOLUTION

[@ List(@factors) @]

[`n = [$n]`] has the prime factorization [`[$str]`]

END_PGML_SOLUTION

ENDDOCUMENT();
