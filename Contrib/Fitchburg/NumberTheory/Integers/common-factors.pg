## DESCRIPTION
## Find all common factors of two integers.
## ENDDESCRIPTION


## DBsubject(Number theory)
## DBchapter(Divisibility)
## DBsection(GCDs and LCMs)
## Date(10/31/2022)
## Institution(Fitchburg State University)
## Author(Peter Staab)
## Level(2)
## MO(1)
## KEYWORDS('integers', 'factors')


DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

$showPartialCorrectAnswers = 0;

@primes = (2, 3, 5, 7, 11, 13);

@common_factors = ();
for $i (2..20) {
	push(@common_factors, $i) if ($i < 7 || !isPrime($i));
}

$ans_factor = $common_factors[ random(0, $#common_factors) ];

@all_factors = ();
for $i (1..$ans_factor) {
	push(@all_factors, $i) if ($ans_factor % $i == 0);
}
do {
	$a = $ans_factor * $primes[ random(0, $#primes) ];
	$b = $ans_factor * $primes[ random(0, $#primes) ];
} until ($a != $b);

$ans = Compute(join(",", @all_factors));

BEGIN_PGML

List all of the positive common divisors of [$a] and [$b]: [___]{$ans}

Note: Enter your answers as a comma-separated list.

END_PGML

BEGIN_PGML_SOLUTION

The common divisors of [$a] and [$b] are: [$ans]

END_PGML_SOLUTION

ENDDOCUMENT();
