# WeBWorK problem written by Alex Jordan 
# Portland Community College
# ENDDESCRIPTION




##############################################

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "contextRestrictedDomains.pl",
  "PGML.pl",
  "PCCmacros.pl",
  
);

##############################################
TEXT(beginproblem());


Context("RestrictedDomains");
$index = random(0,4,1);
$var[0] = ('x','a','s','p','m')[$index];
$var[1] = ('y','b','t','q','n')[$index];
$var[2] = ('z','c','u','r','k')[$index];
Context()->variables->are($var[2]=>'Real');

$a = random(1,10,1);
$aN = -$a;
$b = non_zero_random(2,10,1);


$num = Formula("($var[2])/($var[2]-$a)^2")->reduce;
$den = Formula("($b $var[2])/($var[2]^2-$a**2)")->reduce;

$den1 = Formula("($b $var[2])/( ($var[2]+$a)($var[2]-[$a]) )")->reduce;

$com = Formula("($var[2]+$a)($var[2]-[$a])^2")->reduce;
$num2 = Formula("($var[2])/($var[2]-$a)^2*$com")->reduce;
$den2 = Formula("($b $var[2])/( ($var[2]+$a)($var[2]-[$a]) )*$com")->reduce;
$num3 = Formula("$var[2]*($var[2]+$a)")->reduce;
$den3 = Formula("($b $var[2])($var[2]-[$a])")->reduce;

$numAns = Formula("$var[2]+$a")->reduce;
$denAns = Formula("$b*($var[2]-$a)")->reduce;

$ans = Formula("$numAns/$denAns, $var[2] != 0 and $var[2] != $aN")->reduce;
$ans->{trueDomain} = Compute("$var[2] != 0 and $var[2] != $aN and $var[2] != -$aN");

##############################################

BEGIN_PGML

Simplify this expression, and if applicable, write the restricted domain.  [@KeyboardInstructions("The problem accepts many ways to format the answers here, but one way is like typing [|$var[2]^2 for $var[2]!=1 and $var[2]!=2|]* where [|!=|]* is how to type the [`\\neq`] symbol.")@]**

[``\frac{[$num]}{[$den]}=``] [__]{$ans}{width=>40}

END_PGML

##############################################

BEGIN_PGML_SOLUTION

To simply the complex fraction [`\frac{[$num]}{[$den]}`], we multiple the numerator and denominator with the common denominator of [`[$num]`] and [`[$den]`].

    [``
\begin{aligned}
  \frac{[$num]}{[$den]} &= \frac{[$num]}{[$den1]} \\
  &= \frac{[$num2]}{[$den2]} \\
  &= \frac{[$num3]}{[$den3]},[$var[2]]\ne[$aN] \\
  &=[$ans]
\end{aligned}
    ``]

Since the factors [`[$var[2]]`] and [`[$var[2]]+[$a]`] were canceled, the domain condition lost during the simplification is [`[$ans->{trueDomain}]`].

END_PGML_SOLUTION



ENDDOCUMENT();
