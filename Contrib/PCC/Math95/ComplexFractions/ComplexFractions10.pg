# WeBWorK problem written by Alex Jordan 
# Portland Community College
# ENDDESCRIPTION




##############################################

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGML.pl",
  "PCCmacros.pl",
  "contextRestrictedDomains.pl",
);

##############################################
TEXT(beginproblem());


Context("RestrictedDomains");
$index = random(0,4,1);
$var[0] = ('x','a','s','p','m')[$index];
$var[1] = ('y','b','t','q','n')[$index];
$var[2] = ('z','c','u','r','k')[$index];
Context()->variables->are($var[0]=>'Real',$var[1]=>'Real',$var[2]=>'Real');

$a = list_random(2,3,5,6,7,10);
$aN = -$a;
$b = random(2,10,1);
$c = random(2,10,1);
$a2N = -($a)**2;
while ($b*($c+1) == 2*($b+$a)) {$c = random(2,10,1);}

Context()->flags->set(reduceConstants=>0);
$num = Formula("$var[2]/($var[2]^2-$a**2)-1/($var[2]^2-$a**2)")->reduce;
$den = Formula("1/($var[2]+$a**2)")->reduce;

$com = Formula("($var[2]+$a)($var[2]-$a)($var[2]+$a**2)")->reduce;
$num1 = Formula("$var[2]/(($var[2]+$a)*($var[2]-[$a]))-1/(($var[2]+$a)*($var[2]-[$a]))")->reduce;
$den1 = $den;
$num2 = Formula("$var[2]/(($var[2]+$a)*($var[2]-[$a]))*$com-1/(($var[2]+$a)*($var[2]-[$a]))*$com")->reduce;
$den2 = Formula("($var[2]+$a)($var[2]-$a)")->reduce;
$num3 = Formula("$var[2]*($var[2]+($a)**2)-($var[2]+($a)**2)")->reduce;
$den3 = $den2;
$d = ($a)**2-1;
$num4 = Formula("$var[2]^2+$d*$var[2]-($a)**2")->reduce;
$den4 = $den3;

Context()->variables->are($var[0]=>'Real',$var[1]=>'Real',$var[2]=>'Real');
$ans = Formula("($var[2]-1)*($var[2]+$a**2)/(($var[2]+$a)($var[2]-$a)), $var[2] != -$a**2")->reduce;
$ans->{trueDomain} = Compute("$var[2] != -$a**2 and $var[2] != -$a and $var[2] != $a");


##############################################

BEGIN_PGML

Simplify this expression, and if applicable, write the restricted domain.  [@KeyboardInstructions("The problem accepts many ways to format the answers here, but one way is like typing [|$var[2]^2 for $var[2]!=1 and $var[2]!=2|]* where [|!=|]* is how to type the [`\\neq`] symbol.")@]**

[``\frac{[$num]}{[$den]}=``] [__]{$ans}{width=>40}

END_PGML

##############################################

BEGIN_PGML_SOLUTION

To simply the complex fraction [`\frac{[$num]}{[$den]}`], we multiple the numerator and denominator with the common denominator of [`[$num]`] and [`[$den]`], which is [`[$com]`].

    [``
\begin{aligned}
  \frac{[$num]}{[$den]} &= \frac{[$num1]}{[$den1]} \\
    &= \frac{([$num1])\cdot[$com]}{([$den1])\cdot[$com]} \\
    &= \frac{[$num2]}{[$den2]}, [$var[2]] \ne [$a2N] \\
    &= \frac{[$num3]}{[$den3]}, [$var[2]] \ne [$a2N]\\
    &= \frac{[$num4]}{[$den4]}, [$var[2]] \ne [$a2N] \\
    &= [$ans]
\end{aligned}
    ``]

Since [`[$var[2]]+[$a**2]`] was canceled, [`[$var[02]] \ne [$a2N]`] is a lost domain condition.

Although [`[$var[2]]-[$a]`] and [`[$var[2]]-[$aN]`] were also canceled, [`[$var[2]] \ne [$a]`] and [`[$var[2]] \ne [$aN]`] are not lost domain conditions because they are implied in the solution.

END_PGML_SOLUTION

ENDDOCUMENT();
