##DESCRIPTION
##  Algebra problem: Simplify expressions using properties of exponents
##ENDDESCRIPTION

##KEYWORDS('algebra', 'exponent', 'simplify exponents')

## DBsubject(Algebra)
## DBchapter(Properties of exponents, rational exponents and radicals)
## DBsection(Properties of exponents)
## Level(2)
## Author(K. Andrew Parker)
## Institution(CUNY City Tech)
## Language(en)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'contextLimitedPowers.pl',
    'PGcourse.pl');


Context("Numeric");

$var = list_random('a'..'d','m','n','p'..'s','w'..'z');
Context()->variables->are($var => Real);


# Force students to combine exponents within fractions
$fractionChecker = sub {
    my ($correct, $student, $ans) = @_;
    return 0 unless $correct == $student;
    Value->Error(
        "Please rewrite your answer without using negative exponents")
        unless $student->{tree}->class eq "BOP"
        && $student->{tree}{bop} =~ m!/!;
    my $cden = Formula($correct->{tree}{rop});
    my $sden = Formula($student->{tree}{rop});
    Value->Error("Your answer isn't completely simplified")
        unless $cden == $sden;
    return 1;
};

#  Setup


$pSmall = random(3, 9, 1);
do { $pLarge = random(5, 15, 1); } until ($pLarge > $pSmall + 1);

$nSmall = -1 * $pSmall;
$nLarge = -1 * $pLarge;

$pSum  = $pSmall + $pLarge;
$pDiff = $pLarge - $pSmall;
$nSum  = -($pSum);            # for solutions
$nDiff = -($pDiff);           # for solutions

@question = (
    Formula("$var^{$pSmall} * $var^{$pLarge}"),
    Formula("$var^{$pSmall} * $var^{$nLarge}"),
    Formula("$var^{$nSmall} * $var^{$pLarge}"),
    Formula("$var^{$nSmall} * $var^{$nLarge}")
);

Context()->operators->undefine("+", " +", "+ ");
Context()->operators->undefine("-", " -", "- ");
Context()->operators->undefine("*", " *", "* ");
Context()->{error}{msg}{"Can't use '+' in this context"} =
    "Addition is disabled for this problem. Compute the result for yourself and resubmit your answer.";
Context()->{error}{msg}{"Can't use '-' in this context"} =
    "Subtraction is disabled for this problem. Compute the result for yourself and resubmit your answer.";
Context()->{error}{msg}{"Can't use '*' in this context"} =
    "Multiplication is disabled for this problem. Compute the result for yourself and resubmit your answer.";
LimitedPowers::OnlyPositiveIntegers();
Context()->{error}{msg}{"Powers must be positive integer constants"} =
    "Please rewrite your answer without using negative exponents.";

@answer = (
    Formula("$var^{$pSum}"),
    Formula("1/($var^{$pDiff})"),
    Formula("$var^{$pDiff}")->with(test_at => [ [0] ]),
    Formula("1/($var^{$pSum})")
);

$cmp2 = $answer[2]->cmp->withPostFilter(sub {
        my $ans = shift;
        $ans->{ans_message} = "Your answer is not completely simplified."
            if $ans->{ans_message} eq
            "The domain of your function doesn't match that of the correct answer";
        return $ans;
    });

BEGIN_PGML

a) Simplify [` [$question[0]] `] and write your answer without using negative exponents.

    [_]{$answer[0]}

b) Simplify [` [$question[1]] `] and write your answer without using negative exponents.

    [_]{$answer[1]->cmp(checker => $fractionChecker)}

c) Simplify [` [$question[2]] `] and write your answer without using negative exponents.

    [_]{$cmp2}

d) Simplify [` [$question[3]] `] and write your answer without using negative exponents.

    [_]{$answer[3]->cmp(checker => $fractionChecker)}
END_PGML


BEGIN_PGML_HINT

Recall the property of exponents: [` B^m \cdot B^n = B^{(m+n)} `]

And recall that if you end up with a negative exponent, it can be rewritten: [` B^{-n} = \frac{1}{B^n} `]

END_PGML_HINT
BEGIN_PGML_SOLUTION

a) [`[$var]^{[$pSmall]} \cdot [$var]^{[$pLarge]} = [$var]^{([$pSmall]+[$pLarge])} = [$var]^{[$pSum]} `]

b) [`[$var]^{[$pSmall]} \cdot [$var]^{[$nLarge]} = [$var]^{([$pSmall]+([$nLarge]))} = [$var]^{[$nDiff]} = \frac{1}{[$var]^{[$pDiff]}} `]

c) [`[$var]^{[$nSmall]} \cdot [$var]^{[$pLarge]} = [$var]^{([$nSmall]+[$pLarge])} = [$var]^{[$pDiff]} `]

d) [`[$var]^{[$nSmall]} \cdot [$var]^{[$nLarge]} = [$var]^{([$nSmall]+([$nLarge]))} = [$var]^{[$nSum]} = \frac{1}{[$var]^{[$pSum]}} `]
END_PGML_SOLUTION

COMMENT("Funded by US DoE Title V: Opening Gateways grant.");

ENDDOCUMENT();        