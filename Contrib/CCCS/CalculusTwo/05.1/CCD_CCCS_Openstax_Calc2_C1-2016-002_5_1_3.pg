## DESCRIPTION
## Calculus Two, Sequences
## ENDDESCRIPTION

## DBsubject(Calculus - single variable)
## DBchapter(Infinite sequences and series)
## DBsection(Limits of Sequences)
## Date(09/10/2018)
## Institution(Community College of Denver, Colorado Community College System)
## Author(Brittni Lorton)
## KEYWORDS('calculus', 'sequences', 'find terms of a sequence')

DOCUMENT();

loadMacros("PGstandard.pl", "PGML.pl", "PGcourse.pl",);

Context('Numeric');

$k = non_zero_random(-10, 10);
$b = non_zero_random(-2,  2);

@a = ($b);
$a[$_] = $a[ $_ - 1 ] + ($_ + 1) * $k for (1 .. 6);

BEGIN_PGML

Find the next six terms of the following sequence.

[`a_n=a_{n-1}[@ $k > 0 ? '+' : '-' @] [@ abs($k) == 1 ? '' : abs($k) @] n, \quad a_1=[$b]`].

[`a_1=`][_]{$a[0]}

[`a_2=`][_]{$a[1]}

[`a_3=`][_]{$a[2]}

[`a_4=`][_]{$a[3]}

[`a_5=`][_]{$a[4]}

[`a_6=`][_]{$a[5]}

[`a_7=`][_]{$a[6]}
END_PGML

BEGIN_PGML_SOLUTION
This sequence is found term by term using the formula

[`a_1 = [$a[0]]`]

[`a_2 = a_1 [@ $k > 0 ? '+' : '-' @] [@ abs($k) == 1 ? '' : abs($k) @] (2) = 
[$a[0]] [@ $k > 0 ? '+' : '-' @] [@ abs($k) == 1 ? '' : abs($k) @] (2) = [$a[1]] `]

[`a_3 = a_2 [@ $k > 0 ? '+' : '-' @] [@ abs($k) == 1 ? '' : abs($k) @] (3) = 
[$a[1]] [@ $k > 0 ? '+' : '-' @] [@ abs($k) == 1 ? '' : abs($k) @] (3) = [$a[2]] `]

[`a_4 = a_3 [@ $k > 0 ? '+' : '-' @] [@ abs($k) == 1 ? '' : abs($k) @] (4) = 
[$a[2]] [@ $k > 0 ? '+' : '-' @] [@ abs($k) == 1 ? '' : abs($k) @] (4) = [$a[3]] `]

[`a_5 = a_4 [@ $k > 0 ? '+' : '-' @] [@ abs($k) == 1 ? '' : abs($k) @] (5) = 
[$a[3]] [@ $k > 0 ? '+' : '-' @] [@ abs($k) == 1 ? '' : abs($k) @] (5) = [$a[4]] `]

[`a_6 = a_5 [@ $k > 0 ? '+' : '-' @] [@ abs($k) == 1 ? '' : abs($k) @] (6) = 
[$a[4]] [@ $k > 0 ? '+' : '-' @] [@ abs($k) == 1 ? '' : abs($k) @] (6) = [$a[5]] `]

[`a_7 = a_6 [@ $k > 0 ? '+' : '-' @] [@ abs($k) == 1 ? '' : abs($k) @] (7) = 
[$a[5]] [@ $k > 0 ? '+' : '-' @] [@ abs($k) == 1 ? '' : abs($k) @] (7) = [$a[6]] `]



END_PGML_SOLUTION

ENDDOCUMENT();
