## DESCRIPTION
## Calculus Two, Sequences
## ENDDESCRIPTION

## DBsubject(Calculus - single variable)
## DBchapter(Infinite sequences and series)
## DBsection(Limit of a sequence)
## Date(09/16/2018)
## Institution(Community College of Denver, Colorado Community College System)
## Author(Brittni Lorton)
## KEYWORDS('calculus', 'sequences', 'limit of a sequence')

DOCUMENT();

loadMacros(
    "PGstandard.pl",      "PGML.pl",
    "contextFraction.pl", "contextLimitedRadical.pl",
    "PGcourse.pl"
);

Context('Numeric')->variables->are(n => "Real");

$a = list_random(2, 3, 5, 6, 7, 8);
$b = random(2, 6);
$c = random(1, 8);

Context("Fraction-NoDecimals");
$frac = Compute("$a/$b")->reduce;

Context("LimitedRadical");
$ans = Compute("sqrt($frac)");

###########################
#  Main text

BEGIN_PGML

Find the limit of the sequence [``\{a_n\} = \left\{\frac{\sqrt{[$a]n}}{\sqrt{[$b]n+[$c]}}\right\}``]. Enter as an exact value.


[``\lim_{n \to \infty} a_n=``][_]{$ans}{5}
END_PGML

BEGIN_PGML_SOLUTION
[```\begin{aligned}
\lim_{n \to \infty} \frac{\sqrt{[$a]n}}{\sqrt{[$b]n+[$c]}} & =
\lim_{n \to \infty} \sqrt{\frac{[$a]n}{[$b]n+[$c]}} \\
& = \sqrt{\lim_{n \to \infty} \frac{[$a]n}{[$b]n+[$c]} } \\
& = \sqrt{\frac{[$a]}{[$b]}} = \sqrt{[$frac]}.
\end{aligned}```]
END_PGML_SOLUTION

ENDDOCUMENT();
