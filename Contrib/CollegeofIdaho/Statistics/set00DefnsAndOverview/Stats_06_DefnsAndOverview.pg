## DESCRIPTION
## DBsubject(Statistics)
## DBchapter(Sample survey methods)
## DBsection(Concepts)
## Institution(The College of Idaho)
## Author(R Cruz, L Danielson, J Guild)
## Level(1)
## TitleText1('The Basic Practice of Statistics')
## AuthorText1('David Moore')
## EditionText1('5e')
## Section1('8')
## Problem1('')
## KEYWORDS('statistic', 'producing data', 'sample')

DOCUMENT();    # This should be the first executable line in the problem.

loadMacros(
    'PGstandard.pl',     'PGML.pl',
    'PGchoicemacros.pl', 'parserRadioButtons.pl',
    'PGcourse.pl'
);

Context('Numeric');

@questions = (
    'Simple Random Sampling',
    qq/A small college has 1000 undergraduates, each with 
              a unique student ID number. A random number generator creates 
              a list of 50 student ID numbers and the corresponding students
              then participate in a survey of student opinion on dining 
              hall food. The sampling technique employed here is/,
    qq/In order to take a sample of 1200 people from a population,
              I first divide the population into men and women, and then take a
              simple random sample of 500 men and a separate simple random
              sample of 700 women.  This is an example of a /
);

# add the options and the last one is the correct one.
@options = (
    [
        [
            'reduces bias resulting from the behavior of the interviewer. ',
            'reduces bias resulting from poorly worded questions.',
            'identifies confounding variables.',
            'offsets bias resulting from undercoverage and nonresponse.'
        ],
        'None of the above.'
    ],
    [ [
        'stratified random sampling.',
        'voluntary response sampling.',
        'convenience sampling.',
        'anecdotal evidence.',
        'simple random sampling.'
    ] ],
    [ [
        'a simple random sample.',
        'a multistage sample.',
        'convenience sampling.',
        'randomized comparative experiment.',
        'stratified random sample.'
    ] ]
);

@shuffle = random_subset(3, 0 .. 2);

@radios =
    map { RadioButtons($options[ $shuffle[$_] ], 4, labels => 'ABC') } (0 .. 2);

$showPartialCorrectAnswers = 0;

BEGIN_PGML
For each problem, select the best response.

a) [$questions[$shuffle[0]]]

    [_]{$radios[$shuffle[0]]}

b) [$questions[$shuffle[1]]]

    [_]{$radios[$shuffle[1]]}

c) [$questions[$shuffle[2]]]

    [_]{$radios[$shuffle[2]]}


END_PGML

#  Solutions

BEGIN_PGML_SOLUTION
The correct answers are 

a) [$radios[$shuffle[0]]]

b) [$radios[$shuffle[1]]]

c) [$radios[$shuffle[2]]]

END_PGML_SOLUTION

ENDDOCUMENT();       # This should be the last executable line in the problem.