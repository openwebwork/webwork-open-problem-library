## DESCRIPTION
## DBsubject(Statistics)
## DBchapter(Sample survey methods)
## DBsection(Concepts)
## Institution(The College of Idaho)
## Author(R Cruz, L Danielson, J Guild)
## Level(1)
## TitleText1('The Basic Practice of Statistics')
## AuthorText1('David Moore')
## EditionText1('5e')
## Section1('8')
## Problem1('')
## KEYWORDS('statistic', 'producing data', 'sample')

DOCUMENT();

loadMacros(
    'PGstandard.pl',     'PGML.pl',
    'PGchoicemacros.pl', 'parserRadioButtons.pl',
    'PGcourse.pl'
);

Context('Numeric');

$radio1 = RadioButtons(
    [ [
        'the 15 students interviewed.',
        "all students approached by the reporter.",
        "all students at universities with safety issues.",
        "all those students walking on campus late at night."
    ] ],
    0,
    labels => 'ABC'
);

$radio2 = RadioButtons(
    [ [
        'convenience sampling.',
        'a census.',
        'stratified random sampling.',
        'simple random sampling.'
    ] ],
    0,
    labels => 'ABC'
);

$radio3 = RadioButtons(
    [ [
        'probably biased.',
        'a probability sample of students with night classes.',
        'a stratified random sample of students feeling safe.',
        'a simple random sample of students feeling safe.'
    ] ],
    0,
    labels => 'ABC'
);

$showPartialCorrectAnswers = 0;

BEGIN_PGML
In order to assess the opinion of students at the Ohio State University on 
campus safety, a reporter for the student newspaper interviews [`15`] students 
he meets walking on the campus late at night who are willing to give their opinion.

a) The sample is

    [_]{$radio1}

b) The method of sampling used is

    [_]{$radio2}

c) The sample obtained is

    [_]{$radio3}

END_PGML

BEGIN_PGML_SOLUTION
The correct answers are 
  
a) [$radio1]

b) [$radio2]

c) [$radio3]
END_PGML_SOLUTION

ENDDOCUMENT();       # This should be the last executable line in the problem.