DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'parserRadioButtons.pl', 'PGcourse.pl');
Context('Numeric');
$radio1a = RadioButtons(
    [
        [
            'All students at the college.',
            'A group of students in the dining hall.',
            'A group of students randomly selected from all colleges across the country. ',
            'A group of students who are enrolled in a statistics course at the        college.'
        ],
        'None of the above.'
    ],
    0,
    labels => 'ABC'
);

$radio1b = RadioButtons(
    [
        [
            'A few students randomly selected from each major.',
            'All students at the college.',
            'All students enrolled in a statistics course at the college.',
            'Students who are majoring in mathematics.'
        ],
        'None of the above.'
    ],
    0,
    labels => 'ABC'
);

$radio2a = RadioButtons(
    [ [
        'all people who will vote on the sales tax increase on the date of the vote.',

        'the 2633 viewers who phoned in.',
        qq/all regular viewers of the television station who own a phone 
            and have participated in similar phone surveys in the past./,
        'the 1474 viewers who were opposed to the increase.'
    ] ],
    0,
    labels => 'ABC'
);

$radio2b = RadioButtons(
    [ [
        'the 2633 viewers who phoned in.',
        'the \(1474\) viewers were opposed to the increase.',
        qq/all regular viewers of the television station who own a
            phone and have participated in similar phone surveys in the
            past./,
        'all people who will vote on the sales tax increase on the data of the vote.'
    ] ],
    0,
    labels => 'ABC'
);

$radio2c = RadioButtons(
    [ [
        'probably biased.',
        'a stratified random sample.',
        qq/a sample in which each person in the population has the same 
    chance of being in the sample./,
        'a simple random sample.'
    ] ],
    0,
    labels => 'ABC'
);

$radio2d = RadioButtons(
    [ [
        'the 2633 viewers who phoned in.',
        'the 1474 viewers opposed to the increase.',
        'people who will vote on the sales tax increase on the date of the vote.',
        qq/all regular viewers of the television station who own a phone and participated in a similar phone survey in the past./
    ] ],
    0,
    labels => 'ABC'
);

$showPartialCorrectAnswers = 0;

BEGIN_PGML
*Scenario 1:* You are examining students' thoughts on their college curriculum. 

a) Which of the following would be an appropriate population of interest?

    [_]{$radio1a}

b) Which of the following would be an example of a representative sample?

    [_]{$radio1b}


*Scenario 2:* A television station is interested in predicting whether or not voters are in favor of an increase in the state sales tax. It asks its viewers to phone in and indicate whether they support or are opposed to an increase in the state sales tax in order to generate additional revenue for education. Of the [`2633`] viewers who phone in, [`1474`] ([`55.98`]%) are opposed to the increase.

a) The population of interest is

    [_]{$radio2a}


b) The sample is

    [_]{$radio2b}

c) In this scenario, the sample obtained is

    [_]{$radio2c}

d) The cases/observational units in this study are

    [_]{$radio2d}


END_PGML

BEGIN_PGML_SOLUTION

*Scenario 1:*

a) [$radio1a]

b) [$radio1b]

*Scenario 2:*

a) [$radio2a]

b) [$radio2b]

c) [$radio2c]

d) [$radio2d]

END_PGML_SOLUTION

ENDDOCUMENT();       # This should be the last executable line in the problem.