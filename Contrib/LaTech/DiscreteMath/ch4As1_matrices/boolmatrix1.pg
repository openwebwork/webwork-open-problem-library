## DESCRIPTION
## Generates two random 3x3 zero-one matrices and ask to compute their meet and join.
## ENDDESCRIPTION

## DBsubject(Discrete Math)
## DBchapter(Discete Structures)
## DBsection(Matrices)
## Date(06/03/2026)
## Institution(Louisiana Tech University)
## Author(Jason Terry)
## KEYWORDS('discrete math','matrix','boolean','meet','join','zero-one')


DOCUMENT();

## Load libraries
loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGML.pl",
"PGcourse.pl"
);

## Set the context for matrices
Context("Matrix");

## Create random 3x3 boolean matrices
$A = Matrix([
[random(0,1,1),random(0,1,1),random(0,1,1)],
[random(0,1,1),random(0,1,1),random(0,1,1)],
[random(0,1,1),random(0,1,1),random(0,1,1)]
]);

$B = Matrix([
[random(0,1,1),random(0,1,1),random(0,1,1)],
[random(0,1,1),random(0,1,1),random(0,1,1)],
[random(0,1,1),random(0,1,1),random(0,1,1)]
]);

## Create their meet and join
for my $i (1..3) {
  for my $j (1..3) {
    $temp1[$i][$j] = $A->element($i,$j)*$B->element($i,$j);
	$temp2[$i][$j] = min($A->element($i,$j)+$B->element($i,$j), 1);
  }
}

$meet = Matrix([
[$temp1[1][1],$temp1[1][2],$temp1[1][3]],
[$temp1[2][1],$temp1[2][2],$temp1[2][3]],
[$temp1[3][1],$temp1[3][2],$temp1[3][3]]
]);

$join = Matrix([
[$temp2[1][1],$temp2[1][2],$temp2[1][3]],
[$temp2[2][1],$temp2[2][2],$temp2[2][3]],
[$temp2[3][1],$temp2[3][2],$temp2[3][3]]
]);

## Display question
BEGIN_PGML

For the matrices [` A = [$A] `] and [` B = [$B] `], their meet is:

[`` A \wedge B ``] = [___]*{$meet}

And their join is:

[`` A \vee B ``] = [___]*{$join}

END_PGML

BEGIN_PGML_SOLUTION
Solutions: 

For the matrices [` A = [$A] `] and [` B = [$B] `], their meet is:

[`` A \wedge B = [$meet] ``]

And their join is:

[`` A \vee B  = [$join]  ``]

END_PGML_SOLUTION

ENDDOCUMENT();
