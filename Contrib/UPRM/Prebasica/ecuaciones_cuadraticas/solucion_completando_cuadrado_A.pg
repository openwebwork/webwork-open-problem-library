#  DESCRIPTION

#  Tipo: respuesta corta
#  Técnica de completar el cuadrado, pregunta por el valor
#  que hay que sumar o por los valores de a y b en (x-a)^2 = b.

#  Problema WeBWork escrito por Edwin Florez,
#  <edwin.florez (at) upr (dot) edu>

#  Adaptado desde el sistema quiz.uprm.edu de archivo
#  pedro_prebasica/ecuaciones_cuadraticas/solucion_completando_cuadrado.db

#  ENDDESCRIPTION

## DBsubject(Prebasica)
## DBchapter(Ecuaciones cuadraticas)
## DBsection(Completando el cuadrado)
## Level(1)
## KEYWORDS('ecuaciones','cuadraticas',"completar el cuadrado')
## Author(Edwin Florez)
## Institution(UPRM)
## Language(es)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'PGcourse.pl');

#  Setup

#Si se aplica el método reduce() al Contexto Formula, no usa estas reglas al
#aplicar las técnicas de reducción a expresiones.
#Context()->noreduce('(-x)-y','(-x)+y');
Context("Fraction");

#Creando las constantes
$a = 2 * non_zero_random(-15, 15);
$b = random(-9, 9);

if ($a > 0) {
    $simbolo = "+";
} else {
    $simbolo = "-";
}

$eq = Formula("x^2+$a x")->reduce();

$answer = Fraction(($a**2) / 4)->reduce();

$b_mas_answer = $b + $answer;

$square_root_answer = sqrt($answer);

#  Text

BEGIN_PGML
Considere la ecuación cuadrática
[```[$eq] = [$b] ```]

hallar un número entero que se sume a ambos lados de la ecuación para completar el cuadrado en la parte izquierda de ella. 

Contestación  = [_]{$answer} 

[@  helpLink('number')  @]*
END_PGML

BEGIN_PGML_SOLUTION
*Paso 1:* Para completar el cuadrado en el lado izquierdo de la ecuación, usamos a [`[$a]`], el coeficiente de [`x`], se divide por 2 y se eleva al cuadrado:
[```
  \left( \frac{[$a]}{2} \right)^2 = [$answer]
```]

*Paso 2:* Sumar [`[$aa2]`] a ambos lados de la ecuación para completar el cuadrado
[```
\begin{aligned}
  [@ $eq->TeX @]*+[$answer] &= [$b] +[$answer]\[```0.2cm]
  (x [$simbolo] [$square_root_answer])^2 &= [$b_mas_answer]
\end{aligned}
```]

Por lo tanto la respuesta es [`[$answer]`].
END_PGML_SOLUTION

ENDDOCUMENT();
