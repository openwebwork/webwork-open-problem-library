#  DESCRIPTION

#  Tipo: respuesta corta
#  Fracciones equivalentes

#  Problema WeBWork escrito por Edwin Florez,
#  <edwin.florez (at) upr (dot) edu>

#  Adaptado desde el sistema quiz.uprm.edu del archivo
#  pedro_prebasica/fracciones/fracciones_equivalentes.db

#  ENDDESCRIPTION

## DBsubject(Prebasica)
## DBchapter(Fracciones)
## DBsection(Equivalentes)
## Level(1)
## KEYWORDS('fracciones','equivalencia','equivalentes')
## Author(Edwin Florez)
## Institution(UPRM)
## Language(es)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'PGcourse.pl');

Context("Fraction");

$var = list_random('a' .. 'i', 'k' .. 'z');
$a   = random(6, 50);
$b   = random(5, 60);

#Aleatorizando la constante de proporcionalidad
$k = random(2, 8);

$c = $a * $k;
$d = $b * $k;

$fraccion1 = Fraction($a, $b);
$fraccion2 = Fraction($c, $d);

$prob = random(0, 1);
if ($prob == 0) {
    $answer   = Compute($c);
    $cadena   = "\frac{ $var }{ $d }";
    $sol_exp1 = "$a \cdot $d = $var  \cdot $b";
    $sol_exp2 = "$var = \frac{$a \cdot $d }{$b}";
} else {
    $answer   = Compute($d);
    $cadena   = "\frac{ $c }{ $var }";
    $sol_exp1 = "$a \cdot $d = $c  \cdot $var";
    $sol_exp2 = "$var = \frac{$c \cdot $b }{$a}";
}

#  Text

BEGIN_PGML
¿Cuál debe ser el valor de la variable [` [$var] `] para que las siguientes fracciones sean equivalentes?
[```
\frac{[$a]}{[$b]} = [$cadena]
```]

[` [$var] = `] [_]{$answer->cmp(studentsMustReduceFractions => 1)}{20}

[@  helpLink('number')  @]*
END_PGML

BEGIN_PGML_SOLUTION
Podemos encontrar el valor [` [$var] `] multiplicamos en cruz [` \frac{[$a]}{[$b]} = [$cadena] `] 
[```
 [$sol_exp1] \quad \Rightarrow  \quad [$sol_exp2],
```]
simplificamos y/o reducimos la fracción, por lo tanto [`[$var] = [$answer]`].
END_PGML_SOLUTION

ENDDOCUMENT();
