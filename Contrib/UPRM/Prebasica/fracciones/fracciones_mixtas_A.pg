#  DESCRIPTION

#  Tipo: respuesta corta
#  Fracciones mixtas: de mixta a impropia

#  Problema WeBWork escrito por Edwin Florez,
#  <edwin.florez (at) upr (dot) edu>

#  Adaptado desde el sistema quiz.uprm.edu del archivo
#  pedro_prebasica/fracciones/fracciones_mixtas.db

#  ENDDESCRIPTION

## DBsubject(Prebasica)
## DBchapter(Fracciones)
## DBsection(Mixtas)
## Level(1)
## KEYWORDS('fracciones','mixtas')
## Author(Edwin Florez)
## Institution(UPRM)
## Language(es)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'PGcourse.pl');

Context("Fraction");

$a  = random(6, 50);
$b  = random(1, 5);
$c  = random(6, 9);
$ac = $a * $c;

$nume = $a * $c + $b;
$deno = $c;

$answer = Fraction($nume, $deno);

#  Text

BEGIN_PGML
La siguiente es la fracción impropia asociado con el mixto [`[$a] \frac{[$b]}{[$c]} `]. La respuesta debe ser una fracción [` \frac{a}{b} `] en su mínima expresión.

Contestación: [_]{$answer->cmp(studentsMustReduceFractions => 1)}

[@  helpLink('number')  @]*
END_PGML

BEGIN_PGML_SOLUTION
*Paso 1:* [`[$a] \frac{[$b]}{[$c]} `] indica que tenemos [`[$a]`] partes enteras y [` \frac{[$b]}{[$c]} `] partes de una unidad. 

*Paso 2:* Una parte entera se puede expresar como [` \frac{[$c]}{[$c]} `], luego [`[$a]`] partes enteras en la forma [` \frac{[$ac]}{[$c]} `]. Por consiguiente,
[```
  [$a] \frac{[$b]}{[$c]} =  \frac{[$ac]}{[$c]}  +  \frac{[$b]}{[$c]} = \frac{[$nume]}{[$deno]}.
```]
Por lo tanto la solución es: [`[$answer]`]
END_PGML_SOLUTION

ENDDOCUMENT();
