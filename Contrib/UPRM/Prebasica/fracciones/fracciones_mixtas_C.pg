#  DESCRIPTION

#  Tipo: respuesta corta
#  Fracciones mixtas, convertir de mixta a impropia

#  Problema WeBWork escrito por Edwin Florez,
#  <edwin.florez (at) upr (dot) edu>

#  Adaptado desde el sistema quiz.uprm.edu del archivo
#  pedro_prebasica/fracciones/fracciones_mixtas.db

#  ENDDESCRIPTION

## DBsubject(Prebasica)
## DBchapter(Fracciones)
## DBsection(Mixtas)
## Level(1)
## KEYWORDS('fracciones','mixtas')
## Author(Edwin Florez)
## Institution(UPRM)
## Language(es)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'PGcourse.pl');

Context("Fraction");

$a  = random(6, 50);
$b  = random(1, 5);
$c  = random(6, 9);
$ac = $a * $c;

$nume = $a * $c + $b;
$deno = $c;

$answer = Fraction($nume, $deno);

#  Text

BEGIN_PGML
La fracción mixta [` [$a]\frac{[$b]}{[$c]} `] escrita como fracción impropia es:

*Nota:*
Escribir la fracción simplificada al máximo.

Contestación:
[_]{$answer->cmp(studentsMustReduceFractions => 1, requirePureFractions => 1)}

[@  helpLink('number')  @]*

END_PGML

BEGIN_PGML_SOLUTION
*Paso 1:* Re-escribir la fracción mixta como la suma de la parte entera y la parte fraccionaria:
[```
[$a] \frac{[$b]}{[$c]} = [$a] + \frac{[$b]}{[$c]}
```]

*Paso 2:* Sumar la parte entera y la parte fraccionaria:
[```
 [$a]  +  \frac{[$b]}{[$c]} = \frac{[$nume]}{[$deno]}.
```]
Por lo tanto la solución es: [`[$answer]`]
END_PGML_SOLUTION

ENDDOCUMENT();
