#  DESCRIPTION

#  Tipo: respuesta corta
#  Expandir la multiplicación de un binomio por un trinomio.

#  Problema WeBWork escrito por Edwin Florez,
#  <edwin.florez (at) upr (dot) edu>

#  Adaptado desde el sistema quiz.uprm.edu del archivo
#  pedro_prebasica/producto_binario/producto_trinomio_por_binomio.db

#  ENDDESCRIPTION

## DBsubject(Algebra)
## DBchapter(Factoring)
## DBsection(Factoring: common factors)
## Institution(UPRM)
## Author(Edwin Florez)
## Level(1)
## Language(es)
## KEYWORDS('polinomios','productos','notables')

DOCUMENT();

loadMacros(
    'PGstandard.pl',               'PGML.pl',
    'contextLimitedPolynomial.pl', 'PGcourse.pl'
);

Context('Numeric');

#Creando el binomio, D x + E
$D = non_zero_random(-15, 15);
$E = non_zero_random(-15, 15);

#Creando el trinomio, A x^2 + B x + C
$A = non_zero_random(-15, 15);
$B = non_zero_random(-15, 15);
$C = non_zero_random(-15, 15);

#Calculando los coeficientes del producto
$a = $A * $D;
$b = $A * $E + $B * $D;
$c = $B * $E + $C * $D;
$d = $C * $E;

#productos usados en la solución
$AD = $A * $D;
$AE = $A * $E;
$BD = $B * $D;
$BE = $B * $E;
$CD = $C * $D;
$CE = $C * $E;

#aleatorizando el orden del producto
if (random(0, 1) == 0) {
    $factor1 = Formula("$A x^2 + $B x + $C")->reduce;
    $factor2 = Formula("$D x + $E")->reduce;
} else {
    $factor2 = Formula("$A x^2 + $B x + $C")->reduce;
    $factor1 = Formula("$D x + $E")->reduce;
}

#Si se aplica el método reduce() al Contexto Formula, no usa estas reglas al
#aplicar las técnicas de reducción a expresiones.
Context()->noreduce('(-x)-y', '(-x)+y');

#Se restringe sólo a polinomios, i.e., sumas de múltiplos de potencias de x
#Context("LimitedPolynomial");

#Limita también a sólo un monomio de cada grado
#Context("LimitedPolynomial")->flags->set(singlePowers=>1);

#Adicionalmente, no permite operaciones entre coeficientes
Context("LimitedPolynomial-Strict");

$answer = Formula("$a x^3 + $b x^2 + $c x + $d")->reduce;

BEGIN_PGML
Encuentre el producto de 
[```
([$factor1])([$factor2])
```]
Escribir el resultado en forma [` ax^3+bx^2+cx + d `]. 

Resultado: [_]{$answer}{20}

[@  helpLink('formulas')  @]*
END_PGML

#Context("Numeric");

#  Answers

ANS($answer->cmp());

BEGIN_PGML_SOLUTION
*Paso 1:* Aplicar propiedad distributiva, multiplicando cada término del primer factor con cada uno del segundo factor.
[```
 ([$factor1])([$factor2]) = ([$A] x^2)([$D] x) + ([$A] x^2)([$E]) + ([$B] x)([$D] x) + ([$B] x)([$E]) + ([$C])([$D] x) + ([$C])([$E])
```]

*Paso 2:* Agrupar términos semejantes y sumar y/o restar sus coeficientes. 
[```
 = ([$AD]) x^3 + ([$AE] + [$BD]) x^2 + ([$BE] + [$CD]) x + ([$CE])
```]
Por lo tanto la solución es: [` [$answer] `].
END_PGML_SOLUTION

ENDDOCUMENT();
