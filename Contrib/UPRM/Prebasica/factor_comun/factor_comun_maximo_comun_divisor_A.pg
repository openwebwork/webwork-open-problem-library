#  DESCRIPTION

#  Tipo: respuesta corta
#  Factorizacion: encontrar el factor común dado una lista de tres términos
#  tipo: ax^n

#  Problema WeBWork escrito por Edwin Florez,
#  <edwin.florez (at) upr (dot) edu>

#  Adaptado desde el sistema quiz.uprm.edu del archivo
#  pedro_prebasica/factor_comun/factor_comun_maximo_comun_divisor.db

#  ENDDESCRIPTION

## DBsubject(Prebasica)
## DBchapter(Factorizacion)
## DBsection(Factor común)
## Level(1)
## KEYWORDS('factorizacion','factor comun')
## Author(Edwin Florez)
## Institution(UPRM)
## Language(es)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context("Numeric");

#las constantes de los términos: a x^n1,  b x^n2,  c x^n3
$k = list_random(1, 2, 3, 5, 7);
$a = $k * non_zero_random(-20, 20);
$b = $k * non_zero_random(-20, 20);
$c = $k * non_zero_random(-20, 20);

$n1 = random(2, 20);
$n2 = random(2, 20);
$n3 = random(2, 20);

#eligiendo la variable
$var1 = list_random(
    'a', 'b', 'm', 'n', 'x', 'y', 'z', 'w',
    'p', 'q', 'r', 's', 't', 'u', 'v'
);

#adicionando las variables al contexto
Context()->variables->are($var1 => "Real", uc($var1) => "Real");

#Si se aplica el método reduce() en los objetos del "Contexto" declarado.
#No usar estas reglas al aplicar las técnicas de reducción a expresiones.
#Context()->noreduce('y-x','-(x+y)');

$t1 = Compute("$a$var1**($n1)")->reduce;
$t2 = Compute("$b$var1**($n2)")->reduce;
$t3 = Compute("$c$var1**($n3)")->reduce;

$fcc = gcd(gcd($a, $b), $c);
$mns = min($n1, $n2, $n3);

$answer = Formula("$fcc $var1**($mns)")->reduce;

#  Text

BEGIN_PGML
El máximo común divisor (MCD) de
[```
[$t1],\quad [$t2],\quad [$t3]
```]
es:

Contestación: [_]{$answer}

[@  helpLink('formulas')  @]*
END_PGML

#Context("Numeric");

#  Answers

ANS($answer->cmp());

BEGIN_PGML_SOLUTION
*Paso 1:* Encontrar el MCD de los coeficientes numéricos:
[```
  \text{MCD}([$a],[$b],[$c]) = [$fcc]
```]

*Paso 2:* Encontrar el MCD de la variable:
[```
  \text{MCD}_[$var1]([$var1]^{[$n1]},[$var1]^{[$n2]},[$var1]^{[$n3]}) = [$var1]^{[$mns]} 
```]

*Paso 3:* Multiplicar lo obtenido en el paso 1 y 2:
[```
\text{MCD} =  [$answer]
```]

Por lo tanto la respuesta es: [`[$answer]`]
END_PGML_SOLUTION

ENDDOCUMENT();
