#  DESCRIPTION

#  Tipo: respuesta corta
#  Identificar el cambio porcentual

#  Problema WeBWork escrito por Edwin Florez,
#  <edwin.florez (at) upr (dot) edu>

#  Adaptado desde el sistema quiz.uprm.edu de archivo
#  pedro_prebasica/porcentaje_aumento_decremento/porcentaje_cambios_porcentual.db

#  ENDDESCRIPTION

## DBsubject(Arithmetic)
## DBchapter(Percents)
## DBsection(Applications)
## Institution(UPRM)
## Author(Edwin Florez)
## Level(1)
## Language(es)
## KEYWORDS('porcientos','porcentaje','cambio')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context("Numeric");

#Eligiendo el porcentaje
$p = non_zero_random(-200, 200);

#Eligiendo el valor inicial y calculando el final con el respectivo porciento
$valor_inicial = random(20, 1000, 5);
$valor_final   = $valor_inicial + $valor_inicial * $p / 100;

if ($p > 0) {
    $texto = "un aumento de $p%";
    $valor = "positivo";
} else {
    $tmp   = abs($p);
    $texto = "una disminución de $tmp%";
    $valor = "negativo";
}

$answer = Compute("$p");

#  Text

BEGIN_PGML
Calcular el cambio porcentual si el valor inicial es de [`[$valor_inicial]`] y el valor final es de [`[$valor_final]`]. 

*Nota:* Escriba solo el valor positivo para indicar un aumento o el valor negativo para indicar una disminución, no escriba el símbolo de porcentaje.

Contestación: [_]{$answer}{10}

END_PGML

#  Answers

ANS($answer->cmp());

BEGIN_PGML_SOLUTION
*Paso 1:* Si llamamos [`v_i`] al valor inicial y [`v_f`] al valor final, y [`C`] al cambio porcentual, entonces:
[```
C = \frac{v_f - v_i}{v_i}\cdot 100
```]

*Paso 2:* Ahora, sustituyendo los datos de nuestro problema tenemos que:
[```
\begin{aligned}
 C&= \frac{v_f - v_i}{v_i}\cdot 100 \\
    &= \frac{[$valor_final] - [$valor_inicial]}{[$valor_inicial]}\cdot 100 \\
    &= [$p]
\end{aligned}
```]
por ser un valor [$valor], el cambio fue *[$texto]****.
END_PGML_SOLUTION

ENDDOCUMENT();
