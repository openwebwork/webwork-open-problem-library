#  DESCRIPTION

#  Tipo: respuesta corta
#  Convertir un porciento en fracción

#  Problema WeBWork escrito por Edwin Florez,
#  <edwin.florez (at) upr (dot) edu>

#  Adaptado desde el sistema quiz.uprm.edu del archivo
#  pedro_prebasica/porcientos/convertir_porciento_a_fraccion.db

#  ENDDESCRIPTION

## DBsubject(Arithmetic)
## DBchapter(Percents)
## DBsection(Conversion between decimals and percents)
## Institution(UPRM)
## Author(Edwin Florez)
## Level(1)
## Language(es)
## KEYWORDS('porcientos','porcentajes','conversion')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'PGcourse.pl');

Context("Fraction");

$a      = random(1, 99);
$answer = Fraction($a, 100);

BEGIN_PGML
Represente [`[$a]`]% en su fracción equivalente y simplifique el resultado.

Contestación: [_]{$answer->cmp(studentsMustReduceFractions=>1)}{20}

[@  helpLink('number')  @]*
END_PGML

BEGIN_PGML_SOLUTION
Representar [`[$a]`]% en notación fraccionaria:
[```
[$a]% = [$a] \text{ sobre } 100 = \frac{[$a]}{100}
```]
la fracción simplificada al máximo es [`[$answer]`].
END_PGML_SOLUTION

ENDDOCUMENT();
