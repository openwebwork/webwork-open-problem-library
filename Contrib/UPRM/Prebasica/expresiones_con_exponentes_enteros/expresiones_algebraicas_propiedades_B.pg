#  DESCRIPTION

#  Tipo: respuesta corta
#  Aplicar propiedad (a^n)^m = a^(n*m)

#  Problema WeBWork escrito por Edwin Florez,
#  <edwin.florez (at) upr (dot) edu>

#  Adaptado desde el sistema quiz.uprm.edu del archivo
#  pedro_prebasica/expresiones_con_exponentes_enteros/expresiones_algebraicas_propiedades.db

#  ENDDESCRIPTION

## DBsubject(Prebasica)
## DBchapter(Expresiones algebraicas)
## DBsection(Propiedades de los exponentes)
## Level(1)
## KEYWORDS('exponentes','enteros','propiedades')
## Author(Edwin Florez)
## Institution(UPRM)
## Language(es)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

#Si se aplica el método reduce() al Contexto Formula, no usa estas reglas al
#aplicar las técnicas de reducción a expresiones.
#Context()->noreduce('(-x)-y','(-x)+y');

$a   = non_zero_random(-9, 9);
$var = list_random("m", "n", "p", "q", "r", "y", "z", "k", "a", "b");

Context()->variables->add($var => 'Real');
$n = random(2, 6);
$m = random(2, 6);

$exp = Compute("($a $var^$n)^$m");

$answer = Compute("($a)^$m $var^($n*$m)")->reduce;

BEGIN_PGML
Simplifique al máximo la siguiente expresión
[```[$exp]```]

Contestación: [_]{$answer}

[@  helpLink('formula')  @]*
END_PGML

BEGIN_PGML_SOLUTION
*Paso 1:* Utilizando la propiedad [` (ab)^c = a^cb^c `], se obtiene
[```
[$exp] = [$a]^[$n] ([$var]^[$n])^[$m].
```]
*Paso 2:* Utilizando la propiedad [` (a^b)^c = a^{bc} `], se obtiene:
[```
 [$exp] = [$a]^[$n] ([$var]^[$n])^[$m] = [$answer].
```]
Por lo tanto la respuesta es: [`[$answer]`].
END_PGML_SOLUTION

ENDDOCUMENT();
