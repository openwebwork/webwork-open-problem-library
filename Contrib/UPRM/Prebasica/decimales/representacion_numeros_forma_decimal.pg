#  DESCRIPTION

#  Tipo: respuesta corta
#  Escribiendo un número decimal en potencial de 10.

#  Problema WebWork escrito por Edwin Florez,
#  <edwin.florez (at) upr (dot) edu>

#  Adaptado desde el sistema quiz.uprm.edu del archivo
#  pedro_prebasica/decimales/representacion_numeros_forma_decimal.db

#  ENDDESCRIPTION

## DBsubject(Arithmetic)
## DBchapter(Decimals)
## DBsection(Interpreting decimals)
## Institution(UPRM)
## Author(Edwin Florez)
## Level(1)
## Language(es)
## KEYWORDS('decimales','representar','base')

DOCUMENT();

loadMacros(
    'PGstandard.pl',     'PGML.pl',
    'PGchoicemacros.pl', 'contextFraction.pl',
    'PGcourse.pl'
);

Context("Numeric");
$a0 = random(1, 9);
$a1 = random(1, 9);
$a2 = random(1, 9);
$a3 = random(1, 9);
$a4 = random(1, 9);

@potencias = (10000, 1000, 100, 10);
$index     = random(0, 3, 1);

$real =
    $a4 * (10000 / $potencias[$index]) +
    $a3 * (1000 / $potencias[$index]) +
    $a2 * (100 / $potencias[$index]) +
    $a1 * (10 / $potencias[$index]) +
    $a0 * (1 / $potencias[$index]);

$tmp_p0 = 1 / $potencias[$index];
$tmp_p1 = 10 / $potencias[$index];
$tmp_p2 = 100 / $potencias[$index];
$tmp_p3 = 1000 / $potencias[$index];
$tmp_p4 = 10000 / $potencias[$index];

Context("Fraction");
$p0 = Fraction("$tmp_p0");
$p1 = Fraction("$tmp_p1");
$p2 = Fraction("$tmp_p2");
$p3 = Fraction("$tmp_p3");
$p4 = Fraction("$tmp_p4");

$answer = Compute(
    "$a4*$tmp_p4 + $a3*$tmp_p3 + $a2*$tmp_p2 + $a1*$tmp_p1 + $a0*$tmp_p0");

BEGIN_PGML
Escriba el número [`[$real]`] como una suma de múltiplos de potencias de 10. 
  
Contestación: [_]{$answer} 

[@  helpLink('numbers')  @]*
END_PGML

BEGIN_PGML_SOLUTION
*Paso 1:* Identificar la representación de cada dígito del número [`[$real]`]

[$a4] representa [`[$p4]`]'s 
  
[$a3] representa [`[$p3]`]'s
  
[$a2] representa [`[$p2]`]'s
  
[$a1] representa [`[$p1]`]'s 
  
[$a0] representa [`[$p0]`]'s

*Paso 2:* Escribir la suma, entonces
[```
[$real] = [$a4] \cdot [$p4] + [$a3] \cdot [$p3] + [$a2] \cdot [$p2] + [$a1] \cdot [$p1]+[$a0] \cdot [$p0];
```]
END_PGML_SOLUTION

ENDDOCUMENT();
