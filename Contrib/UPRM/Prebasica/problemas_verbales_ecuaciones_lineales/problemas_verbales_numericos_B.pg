## DBsubject(Algebra)
## DBchapter(Linear equations and functions)
## DBsection(Applications and models)
## Level(1)
## KEYWORDS('ecuaciones','lineal','aplicacion')
## Author(Edwin Florez)
## Institution(UPRM)
## Language(es)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Numeric');

#construyendo 3 enteros impares consecutivos
$entero = random(3, 50);
$impar1 = 2 * $entero + 1;
$impar2 = 2 * $entero + 3;
$impar3 = 2 * $entero + 5;

$suma = $impar1 + $impar2 + $impar3;

@pregunta = ("menor", "del medio", "mayor");
$index    = random(0, 2);
$answer =
    $index == 0   ? Compute($impar1)
    : $index == 1 ? Compute($impar2)
    :               Compute($impar3);

BEGIN_PGML
Si la suma de tres números enteros impares consecutivos es [$suma], encontrar el número impar [$pregunta[$index]].

Impar [$pregunta[$index]] = [_]{$answer}{20}

[@  helpLink('number')  @]*
END_PGML

BEGIN_PGML_SOLUTION
*Paso 1:* Ordenar la información del problema en una tabla 


[# 
    [. Data .]
    [. Ecuación .]{headerrow=>1}*
    [.Suma de tres números enteros es [$suma] .]
    [. [` \text{primer número} + \text{segundo número} + \text{tercer número} = [$suma] `]  .]*
    [.Son números enteros impares consecutivos .]
    [. [` \text{primer número} = 2\cdot\text{entero}+1 `]  .]*
    [.  .]
    [.[` \text{segundo número} = 2\cdot\text{entero}+3 `]  .]*
    [.  .]
    [.[` \text{tercer número} = 2\cdot\text{entero}+5 `]  .]*
#]{horizontalrules => 1, texalignment => '|c|c|', padding=> 0.3}

*Paso 2:* Sea [`n`] un número entero.

*Paso 3:* Llevar a cabo la sustitución necesaria con las igualdades en el Paso 1 para obtener una ecuación lineal:

[# 
    [. Ecuación .]
    [. Sustitución .]{headerrow=>1}*
    [.[`  \text{primer número} = 2\cdot\text{entero}+1 `] .]
    [.[`  \text{primer número} = 2\cdot n+1 = 2n+1 `] .]*
    [.[`  \text{segundo número} = 2\cdot\text{entero}+3 `] .]
    [.[`  \text{segundo número} = 2\cdot n+3 =2n+3`] .]*
    [.[`  \text{tercer número} = 2\cdot\text{entero}+5 `] .]
    [.[`  \text{tercer número} = 2\cdot n+5 =2n+5`] .]*
    [.[`  \text{primer número} + \text{segundo número} + \text{tercer número} = [$suma] `] .]
    [.[`  (2n+1) + (2n+3) + (2n+5)= [$suma]`] .]*
#]{horizontalrules => 1, texalignment => '|c|c|', padding=> 0.3}

*Paso 4:* Resolver la ecuación lineal para obtener el valor de [`n`]:
[```
 (2n+1) + (2n+3) + (2n+5)= [$suma] \quad \text{entonces}\quad  n = [$entero].
```]

*Paso 5:*
Usar el valor de [`n`] para obtener la información que buscamos en el problema verbal:
[```
\begin{aligned}
 \text{Primer entero impar: }     & 2n + 1 = [$impar1], \\
 \text{Segundo entero impar: } & 2n + 3 = [$impar2], \\
 \text{Tercer entero impar: }     & 2n + 5 = [$impar3] .
\end{aligned} 
```]

Por lo tanto el entero impar [$pregunta[$index]] es [`[$answer]`].
END_PGML_SOLUTION

ENDDOCUMENT();
