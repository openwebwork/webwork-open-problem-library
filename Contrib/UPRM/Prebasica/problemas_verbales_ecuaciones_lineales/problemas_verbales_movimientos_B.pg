## DBsubject(Algebra)
## DBchapter(Linear equations and functions)
## DBsection(Applications and models)
## Level(1)
## KEYWORDS('ecuaciones','lineal','aplicacion','movimiento')
## Author(Edwin Florez)
## Institution(UPRM)
## Language(es)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'PGcourse.pl');

#Eligiendo 2 tiempos diferentes aleatorios
($tiempo1, $tiempo2) = random_subset(2, 2 .. 18);
$diffe = random(2, 20);

Context("Fraction");
$t1d = $tiempo1 * $diffe;

if ($tiempo2 > $tiempo1) {
    $t2_menos_t1 = $tiempo2 - $tiempo1;
    $key         = "mas";
    $simbolo     = "+";
    $velo_carro2 = Fraction($t1d, $t2_menos_t1);
    $velo_carro1 = $velo_carro2 + $diffe;
} else {
    $t2_menos_t1 = $tiempo1 - $tiempo2;
    $key         = "menos";
    $simbolo     = "-";
    $velo_carro2 = Fraction($t1d, $t2_menos_t1);
    $velo_carro1 = $velo_carro2 - $diffe;
}

$dist1 = $velo_carro1 * $tiempo1;
$dist2 = $velo_carro2 * $tiempo2;

@pregunta = ("A", "B");
$index    = random(0, 1);

$answer = $index == 0 ? Compute($velo_carro1) : Compute($velo_carro2);

BEGIN_PGML
Dos carros recorren la misma distancia. Si la velocidad del carro A es [$diffe] unidades [$key] que la velocidad del carro B y el carro A tardó [$tiempo1] minutos y el carro B duró [$tiempo2] minutos, calcular la velocidad del carro [$pregunta[$index]].

*Nota:* (SÓLO ESCRIBIR EL NÚMERO, SIN UNIDADES) 

Velocidad carro [$pregunta[$index]] = [_]{$answer}{20}

[@  helpLink('number')  @]*
END_PGML

BEGIN_PGML_SOLUTION
*Paso 1:* Ordenar la información del problema en una tabla recordando que 
[``` 
  \text{distancia} = \text{velocidad}\cdot \text{tiempo} 
```]

[# 
    [. Data .]
    [. Ecuación .]{headerrow=>1}*
    [.Dos carros recorren la misma distancia .]
    [. [` (\text{velocidad carro A})\cdot(\text{tiempo de A}) = (\text{velocidad carro B})\cdot(\text{tiempo de B}) `]  .]*
    [.Carro A duró [$tiempo1] minutos .]
    [. [` \text{tiempo de A} = [$tiempo1] `]  .]*
    [.Carro B duró [$tiempo2] minutos .]
    [. [` \text{tiempo de B} = [$tiempo2] `]  .]*
    [.velocidad carro A es [$diffe] [$key] que velocidad carro B .]
    [. [` \text{velocidad carro A}  = \text{velocidad carro B} [$simbolo] [$diffe] `]  .]*
#]{horizontalrules => 1, texalignment => '|c|c|', padding=> 0.3}

*Paso 2:* Sea [`v`] la velocidad del carro [$pregunta[$index]].

*Paso 3:* Llevar a cabo la sustitución necesaria con las igualdades en el Paso 1 para obtener una ecuación lineal:

[# 
    [. Ecuación .]
    [. Sustitución .]{headerrow=>1}*
    [.[` \text{velocidad carro A}  = \text{velocidad carro B} [$simbolo] [$diffe] `] .]
    [.[` \text{velocidad carro A}  = v [$simbolo] [$diffe] `] .]*
    [.[`  (\text{velocidad carro A})\cdot(\text{tiempo de A}) =  (\text{velocidad carro B})\cdot(\text{tiempo de B}) `] .]
    [. [` (v [$simbolo] [$diffe])\cdot [$tiempo1] = v\cdot [$tiempo2] `]  .]*
    [.[`  [$tiempo1](v [$simbolo] [$diffe]) = [$tiempo2] v `] .]*
#]{horizontalrules => 1, texalignment => '|c|c|', padding=> 0.3}

*Paso 4:* Resolver la ecuación lineal para obtener el valor de [`v`]:
[```
  [$tiempo1](v [$simbolo] [$diffe]) = [$tiempo2] v\quad \text{entonces}\quad  v = [$answer].
```]
*Paso 5:*
Usar el valor de [`v`] para obtener la información que buscamos en el problema verbal:
[```
\begin{aligned}
 \text{Velocidad carro A: } & v [$simbolo] [$diffe] = [$velo_carro1] \\
 \text{Velocidad carro B: } & v = [$velo_carro2]  \\
 \text{Distancia recorrida por los dos: } & [$velo_carro1]\cdot [$tiempo1] = [$velo_carro2]\cdot [$tiempo2] = [$dist1].
\end{aligned} 
```]

Por lo tanto la velocidad del carro [$pregunta[$index]] es [`[$answer]`].
END_PGML_SOLUTION

ENDDOCUMENT();
