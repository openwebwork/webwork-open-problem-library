## DBsubject(Algebra)
## DBchapter(Linear equations and functions)
## DBsection(Applications and models)
## Level(1)
## KEYWORDS('ecuaciones','lineal','aplicacion')
## Author(Edwin Florez)
## Institution(UPRM)
## Language(es)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Numeric');

$l = random(11, 99);
$p = 3 * $l;

$answer = Compute($l);

BEGIN_PGML
Si el perímetro de un triángulo equilátero es [$p] cm, calcular la dimensión del lado del triángulo. (Escribir sólo el número, SIN incluir las unidades cm)

Lado = [_]{$answer}{20}

[@  helpLink('number')  @]*
END_PGML

BEGIN_PGML_SOLUTION
*Paso 1:* Ordenar la información del problema en una tabla:

[# 
    [. Data .]
    [. Ecuación .]{headerrow=>1}*
    [.El perímetro de un triángulo equilátero es [$p] .]
    [.[`\text{lado} + \text{lado} + \text{lado}  = [$p]`] .]*
    [.[`3\cdot \text{lado}=[$p]`] .]*
#]{horizontalrules => 1, texalignment => '|c|c|', padding=> 0.3}

*Paso 2:* Sea [`l`] el lado del triángulo equilátero.

*Paso 3:* Llevar a cabo la sustitución necesaria con las igualdades en el Paso 1 para obtener una ecuación lineal:

[# 
    [. Ecuación .]
    [. Sustitución .]{headerrow=>1}*
    [.[`3\cdot\text{lado}`] = [$p] .]
    [.[`3\cdot l = [$p]`] .]*
    [.  .]
    [.[` 3 l = [$p]`] .]*
#]{horizontalrules => 1, texalignment => '|c|c|', padding=> 0.3}

*Paso 4:* Resolver la ecuación lineal para obtener el valor de [`l`]:
[```
3l  = [$p] \quad \text{entonces}\quad  l = [$answer]
```]
*Paso 5:*
Usar el valor de [`l`] para obtener la información del problema verbal:
[```
 \text{Lado: } l=[$l] 
```]

por lo tanto el lado del triángulo es [` [$answer] `] cm.
END_PGML_SOLUTION

ENDDOCUMENT();
