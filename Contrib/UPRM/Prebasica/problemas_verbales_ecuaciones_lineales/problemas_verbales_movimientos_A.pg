#  DESCRIPTION

#  Tipo: respuesta corta
#  Porcientos: problemas lineales de aplicación (movimientos)

#  Problema WeBWork escrito por Edwin Florez,
#  <edwin.florez (at) upr (dot) edu>

#  Adaptado desde el sistema quiz.uprm.edu del archivo
#  pedro_prebasica/problemas_verbales_ecuaciones_lineales/problemas_verbales_movimientos.db

#  ENDDESCRIPTION

## DBsubject(Algebra)
## DBchapter(Linear equations and functions)
## DBsection(Applications and models)
## Level(1)
## KEYWORDS('ecuaciones','lineal','aplicacion','movimiento')
## Author(Edwin Florez)
## Institution(UPRM)
## Language(es)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'PGcourse.pl');

Context("Fraction");

@nombre = (
    "Jacinto", "Isabel",   "Laura",   "Diego", "Ingrid",  "Cydmary",
    "Jesús",   "Glorimar", "Alberto", "Lisha", "Gloriel", "Ramón",
    "Aidy",    "Aldo",     "Hector",  "Eloy"
);

$index = random(0, 15);

@sitio = (
    "de Walgreens",
    "del Mall de Mayaguez",
    "de Sam's",
    "del Town Center",
    "del Parque de los Próceres",
    "del correo en Mayagüez",
    "del Hospital Perea",
    "de la UPR de Mayagüez"
);

$index2 = random(0, 7);

$velo         = random(3, 15);
$dist_inicial = random(2, 9);
$dist_final   = random(3, 20);

$dist = $dist_final - $dist_inicial;

$tiempo = Fraction($dist, $velo);

$answer = Compute($tiempo);

BEGIN_PGML
El carro de [$nombre[$index]] se encuentra a [$dist_inicial] millas [$sitio[$index2]] y comienza a alejarse de dicho lugar a una velocidad de [$velo] millas por hora. Luego, por medio del GPS, se da cuenta que se encuentra a [$dist_final] millas del punto de partida. Determinar la cantidad de horas que manejó [$nombre[$index]] desde el punto de partida hasta ese momento.

*Nota:* (SÓLO ESCRIBIR EL NÚMERO, y considerar la velocidad CONSTANTE) 

Tiempo manejado = [_]{$answer}{20}

[@  helpLink('number')  @]*
END_PGML

BEGIN_PGML_SOLUTION
*Paso 1:* Ordenar la información del problema en una tabla:

[# 
    [. Data .]
    [. Ecuación .]{headerrow=>1}*
    [.Fórmula de distancia .]
    [. [` \text{distancia} = \text{velocidad} \cdot \text{tiempo}`]  .]*
    [.Distancia recorrida .]
    [. [` \text{distancia} = [$dist_final] - [$dist_inicial] = [$dist]`]  .]*
    [.Velocidad de [$velo] millas por hora .]
    [. [` \text{velocidad} = [$velo]`]  .]*
#]{horizontalrules => 1, texalignment => '|c|c|', padding=> 0.3}

*Paso 2:* Sea [`t`] el tiempo que [$nombre[$index]].

*Paso 3:* Llevar a cabo la sustitución necesaria con las igualdades en el Paso 1 para obtener una ecuación lineal:

[# 
    [. Ecuación .]
    [. Sustitución .]{headerrow=>1}*
    [.[` \text{distancia} = \text{velocidad} \cdot \text{tiempo} `] .]
    [.[` [$dist] = [$velo]\cdot t `] .]*
    [.[` [$dist] = [$velo] t`] .]
    [.  .]*
#]{horizontalrules => 1, texalignment => '|c|c|', padding=> 0.3}

*Paso 4:* Resolver la ecuación lineal para obtener el valor de [`t`]:

[```
[$dist] = [$velo] t \quad \text{entonces}\quad  t = [$answer].
```]
Por lo tanto [$nombre[$index]] manejó [`[$answer]`] hora(s).
END_PGML_SOLUTION

ENDDOCUMENT();
