## DBsubject(Algebra)
## DBchapter(Linear equations and functions)
## DBsection(Applications and models)
## Level(1)
## KEYWORDS('ecuaciones','lineal','aplicacion')
## Author(Edwin Florez)
## Institution(UPRM)
## Language(es)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Numeric');

@mult   = ("dos", "tres", "cuatro", "cinco");
$index1 = random(0, 3);

@pregunta = ("ancho", "largo");
$index2   = random(0, 1);

$a     = random(2, 30);
$k     = ($index1 + 2);
$dos_k = 2 * $k;
$l     = $k * $a;
$p     = 2 * ($a + $l);

if ($index2 == 0) {
    $answer = Compute($a);
} else {
    $answer = Compute($l);
}

#  Text

BEGIN_PGML
Un terreno tiene una forma rectangular. Si el largo del terreno es [$mult[$index1]] veces más que su ancho y el perímetro del terreno es [$p] m, calcule el [$pregunta[$index2]] del terreno. (Escribir sólo el número, SIN incluir las unidades m)

El [$pregunta[$index2]] es = [_]{$answer}{20}

[@  helpLink('number')  @]*
END_PGML

BEGIN_PGML_SOLUTION
*Paso 1:* Ordenar la información del problema en una tabla:
[#
    [. Data .]
    [. Ecuación .]{headerrow=>1}*
    [.El perímetro de un terreno rectangular es [$p] .]
    [.[`2\cdot\text{ancho} + 2\cdot\text{largo} = [$p]`] .]*
    [.El largo es [$mult[$index1]] veces más que su ancho .]
    [.[`\text{largo} = [$k]\cdot\text{ancho}`] .]*
#]{horizontalrules => 1, texalignment => '|c|c|', padding=> 0.3}

*Paso 2:* Sea [`a`] el ancho del terreno.

*Paso 3:* Llevar a cabo la sustitución necesaria con las igualdades en el Paso 1 para obtener una ecuación lineal:

[# 
[. Ecuación .]
[. Sustitución .]{headerrow=>1}*
[.[`\text{largo} = [$k]\cdot\text{ancho}`] .]
[.[`\text{largo} = [$k] a`] .]*
[.[`2\cdot\text{ancho} + 2\cdot\text{largo} = [$p]`] .]
[.[` 2 a + 2([$k] a) = [$p]`] .]*
[.[` 2 a +  [$dos_k] a  = [$p]`] .]*
#]{horizontalrules => 1, texalignment => '|c|c|', padding=> 0.3}

*Paso 4:* Resolver la ecuación lineal para obtener el valor de [`a`]:
[```
2 a +  [$dos_k] a  = [$p] \quad \text{entonces}\quad  a = [$answer]
```]
*Paso 5:*
Usar el valor de [`a`] para obtener la información del problema verbal:
[```
\begin{aligned}
 \text{Ancho: } & a=[$a] \\
 \text{Largo: }  & l = [$k] a= [$l]
\end{aligned}
```]

por lo tanto el [$pregunta[$index2]] del terreno es [` [$answer] `] m.
END_PGML_SOLUTION

ENDDOCUMENT();
