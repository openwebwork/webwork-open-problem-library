## DBsubject(Algebra)
## DBchapter(Linear equations and functions)
## DBsection(Applications and models)
## Level(1)
## KEYWORDS('ecuaciones','lineal','aplicacion')
## Author(Edwin Florez)
## Institution(UPRM)
## Language(es)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Numeric');

#construyendo 2 enteros pares consecutivos
$entero = random(3, 50);
$par1   = 2 * $entero;
$par2   = 2 * $entero + 2;

$suma = $par1 + $par2;

@pregunta = ("menor", "mayor");
$index    = random(0, 1);

$answer = $index == 0 ? Compute($par1) : Compute($par2);

BEGIN_PGML
Si la suma de dos números enteros pares consecutivos es [$suma], encontrar el número par [$pregunta[$index]].

Par [$pregunta[$index]] = [@ ans_rule(20) @]* [@  helpLink('number')  @]*
END_PGML

BEGIN_PGML_SOLUTION
*Paso 1:* Ordenar la información del problema en una tabla

[# 
    [. Data .]
    [. Ecuación .]{headerrow=>1}*
    [.Suma de dos números enteros es [$suma] .]
    [. [` \text{primer número} + \text{segundo número}  = [$suma] `]  .]*
    [.Son números enteros pares consecutivos .]
    [. [` \text{primer número} = 2\cdot\text{entero} `]  .]*
    [.  .]
    [.[` \text{segundo número} = 2\cdot\text{entero}+2 `]  .]*
#]{horizontalrules => 1, texalignment => '|c|c|', padding=> 0.3}

*Paso 2:* Sea [`n`] un número entero.

*Paso 3:* Llevar a cabo la sustitución necesaria con las igualdades en el Paso 1 para obtener una ecuación lineal:

[# 
    [. Ecuación .]
    [. Sustitución .]{headerrow=>1}*
    [.[`  \text{primer número} = 2\cdot\text{entero} `] .]
    [.[`  \text{primer número} = 2\cdot n = 2n `] .]*
    [.[`  \text{segundo número} = 2\cdot\text{entero}+2 `] .]
    [.[`  \text{segundo número} = 2\cdot n+2 =2n+2`] .]*
    [.[`  \text{primer número} + \text{segundo número} = [$suma] `] .]
    [.[`  2n + (2n+2) = [$suma]`] .]*
#]{horizontalrules => 1, texalignment => '|c|c|', padding=> 0.3}

*Paso 4:* Resolver la ecuación lineal para obtener el valor de [`n`]:
[```
 2n + (2n+2) = [$suma] \quad \text{entonces}\quad  n = [$entero].
```]
*Paso 5:*
Usar el valor de [`n`] para obtener la información que buscamos en el problema verbal:
[```
\begin{aligned}
 \text{Primer entero par: }     & 2n  = [$par1], \\
 \text{Segundo entero par: } & 2n + 2 = [$par2],
\end{aligned}
```]

Por lo tanto el entero par [$pregunta[$index]] es [`[$answer]`].
END_PGML_SOLUTION

ENDDOCUMENT();
