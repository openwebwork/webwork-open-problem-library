## DBsubject(Algebra)
## DBchapter(Linear equations and functions)
## DBsection(Applications and models)
## Institution(UPRM)
## Author(Edwin Florez)
## Level(1)
## Language(es)
## KEYWORDS('ecuaciones','lineal','aplicacion')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'PGcourse.pl');

Context("Fraction");

$k1     = non_zero_random(-20, 20);
$k2     = non_zero_random(-20, 20);
$abs_k1 = abs($k1);
$abs_k2 = abs($k2);

@factor = ("doble", "triple");
$index  = random(0, 1);
if ($index == 0) {
    $f = 2;
} else {
    $f = 3;
}

if ($k1 > 0) {
    $desplaza1 = "aumentado";
    $simbolo1  = "+";
} else {
    $desplaza1 = "disminuido";
    $simbolo1  = "-";
}

if ($k2 > 0) {
    $desplaza2 = "más";
    $simbolo2  = "+";
    $nf        = $f;
} else {
    $desplaza2 = "menos";
    $simbolo2  = "-";
    $nf        = -$f;
}

$k1_menos_abs_k2 = $k1 - $abs_k2;
$nf_menos_1      = $nf - 1;

$answer = Fraction($k1_menos_abs_k2, $nf_menos_1);

BEGIN_PGML
Si un número [$desplaza1] en [$abs_k1] es igual a [$abs_k2] [$desplaza2] el [$factor[$index]] de dicho número, determinar el número.

Número = [_]{$answer}{20}

[@  helpLink('number')  @]*
END_PGML

BEGIN_PGML_SOLUTION
*Paso 1:* Ordenar la información del problema en una tabla 

[# 
[. Data .]
[. Ecuación .]{headerrow=>1}*
[.Un número [$desplaza1] en [$abs_k1] es igual a [$abs_k2] [$desplaza2] el [$factor[$index]] de dicho número .]
[. [` \text{número} [$simbolo1] [$abs_k1] = [$abs_k2] [$simbolo2] [$f]\cdot \text{número}  `]  .]*
#]{horizontalrules => 1, texalignment => '|c|c|', padding=> 0.3}


*Paso 2:* Sea [`n`] un número entero.

*Paso 3:* Llevar a cabo la sustitución necesaria con las igualdades en el Paso 1 para obtener una ecuación lineal:

[# 
    [. Ecuación .]
    [. Sustitución .]{headerrow=>1}*
    [.[`  \text{número} [$simbolo1] [$abs_k1] = [$abs_k2] [$simbolo2] [$f]\cdot \text{número} `] .]
    [.[`  n [$simbolo1] [$abs_k1] = [$abs_k2] [$simbolo2] [$f] \cdot n `] .]*
    [.[` n [$simbolo1] [$abs_k1] = [$abs_k2] [$simbolo2] [$f] n `] .]
    [.  .]*
#]{horizontalrules => 1, texalignment => '|c|c|', padding=> 0.3}


*Paso 4:* Resolver la ecuación lineal para obtener el valor de [`n`]:
[```
 n [$simbolo1] [$abs_k1] = [$abs_k2] [$simbolo2] [$f] n \quad \text{entonces}\quad  n = [$answer].
```]

Por lo tanto el número es [`[$answer]`], o cualquier resultado equivalente.
END_PGML_SOLUTION

ENDDOCUMENT();
