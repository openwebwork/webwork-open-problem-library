## DBsubject(Algebra)
## DBchapter(Linear equations and functions)
## DBsection(Applications and models)
## Level(1)
## KEYWORDS('ecuaciones','lineal','aplicacion')
## Author(Edwin Florez)
## Institution(UPRM)
## Language(es)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Numeric');

@mult   = ("dos", "tres", "cuatro", "cinco");
$index1 = random(0, 3);

@pregunta = ("de los lados congruentes", "del lado no congruente");
$index2   = random(0, 1);

$b = random(2, 30);
$k = ($index1 + 2);
$a = $k * $b;
$p = 2 * $a + $b;

$dos_k = 2 * $k;

if ($index2 == 0) {
    $answer = Compute($a);
} else {
    $answer = Compute($b);
}

#  Text

BEGIN_PGML
La medida del lado congruente de un triángulo isósceles es [$mult[$index1]] veces la medida del lado no congruente. Si el perímetro del triángulo isósceles es [$p] cm, determine la medida [$pregunta[$index2]] del triángulo. (Escribir sólo el número, SIN incluir las unidades cm)

Contestación = [_]{$answer}{20}

[@  helpLink('number')  @]*
END_PGML

BEGIN_PGML_SOLUTION
*Paso 1:* Ordenar la información del problema en una tabla:

[# 
    [. Data .]
    [. Ecuación .]{headerrow=>1}*
    [.El perímetro de un triángulo isóseceles es [$p] .]
    [.[`2\cdot\text{lado congruente} + \text{lado diferente} = [$p]`] .]*
    [.Lado congruente es [$mult[$index1]] veces la medida del lado no congruente .]
    [.[`\text{lado congruente} = [$k]\cdot\text{lado diferente}`] .]*
#]{horizontalrules => 1, texalignment => '|c|c|', padding=> 0.3}

*Paso 2:* Sea [`l`] la medida del lado diferente.

*Paso 3:* Llevar a cabo la sustitución necesaria con las igualdades en el Paso 1 para obtener una ecuación lineal:

[# 
    [. Ecuación .]
    [. Sustitución .]{headerrow=>1}*
    [.[`\text{lado congruente} = [$k]\cdot\text{lado diferente}`] .]
    [.[`\text{lado congruente} = [$k] l`] .]*
    [.[`2\cdot\text{lado congruente} + \text{lado diferente} = [$p]`] .]
    [.[` l + 2([$k] l) = [$p]`] .]*
    [.[` l +  [$dos_k] l  = [$p]`] .]*
#]{horizontalrules => 1, texalignment => '|c|c|', padding=> 0.3}


*Paso 4:* Resolver la ecuación lineal para obtener el valor de [`l`]:
[```
l +  [$dos_k] l  = [$p] \quad \text{entonces}\quad  l = [$answer]
```]

*Paso 5:*
Usar el valor de [`l`] para obtener la información del problema verbal:
[```
\begin{aligned}
 \text{Lado diferente: } & l=[$b] \\
 \text{Lado congruente: }  & [$k] l =  [$a]
\end{aligned}
```]

por lo tanto la medida [$pregunta[$index2]] del triángulo es [` [$answer] `] m.
END_PGML_SOLUTION

ENDDOCUMENT();
