## DBsubject(Algebra)
## DBchapter(Linear equations and functions)
## DBsection(Applications and models)
## Level(1)
## KEYWORDS('ecuaciones','lineal','aplicacion')
## Author(Edwin Florez)
## Institution(UPRM)
## Language(es)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Numeric');

$k = random(4,  25);
$l = random(30, 100);

$a = $l - $k;

$p = 2 * $l + 2 * ($l - $k);

@pregunta = ("ancho", "largo");
$index    = random(0, 1);

if ($index == 0) {
    $answer = Compute($a);
} else {
    $answer = Compute($l);
}

BEGIN_PGML
El ancho de un rectángulo es [$k] cm más pequeño que su largo, si su perímetro es [$p] cm, calcule el [$pregunta[$index]] del rectángulo. (Escribir sólo el número, SIN incluir las unidades cm)

El [$pregunta[$index]] es = [_]{$answer}{20}

[@  helpLink('number')  @]*
END_PGML

BEGIN_PGML_SOLUTION
*Paso 1:* Ordenar la información del problema en una tabla:

[# 
[. Data .]
[. Ecuación .]{headerrow=>1}*
[.El perímetro de un rectángulo es [$p] .]
[.[`2\cdot\text{ancho} + 2\cdot\text{largo} = [$p]`] .]*
[.El ancho es [$k] más pequeño que el largo .]
[.[`\text{ancho} = \text{largo} - [$k]`] .]*
#]{horizontalrules => 1, texalignment => '|c|c|', padding=> 0.3}

*Paso 2:* Sea [`l`] el largo del rectángulo.

*Paso 3:* Llevar a cabo la sustitución necesaria con las igualdades en el Paso 1 para obtener una ecuación lineal:

[# 
[. Ecuación .]
[. Sustitución .]{headerrow=>1}*
[.[`\text{ancho} = \text{largo} - [$k]`] .]
[.[`\text{ancho} = l - [$k]`] .]*
[.[`2\cdot \text{ancho} + 2\cdot \text{largo} = 52`] .]
[.[`2\cdot l + 2\cdot (l - [$k])=[$p]`] .]*
[.[`2l + 2(l-[$k]) = [$p]`] .]*
#]{horizontalrules => 1, texalignment => '|c|c|', padding=> 0.3}


*Paso 4:* Resolver la ecuación lineal para obtener el valor de [`l`]:
[```
2 l +  2(l-[$k])  = [$p] \quad \text{entonces}\quad  l = [$l]
```]
*Paso 5:*
Usar el valor de [`l`] para obtener la información del problema verbal:
[```
\begin{aligned}
 \text{Ancho: }  &  l -[$k] = [$a] \\
 \text{Largo: }   &  l = [$l]
\end{aligned}
```]

por lo tanto el [$pregunta[$index]] del rectángulo es [` [$answer] `] cm.
END_PGML_SOLUTION

ENDDOCUMENT();
