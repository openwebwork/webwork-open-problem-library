## DBsubject(Algebra)
## DBchapter(Linear equations and functions)
## DBsection(Applications and models)
## Level(1)
## KEYWORDS('ecuaciones','lineal','aplicacion','economia')
## Author(Edwin Florez)
## Institution(UPRM)
## Language(es)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');
Context('Numeric');

$precio_carne = random(1,  2, 0.01);
$n_carne      = random(40, 99);

$precio_pollo = random(1,  2, 0.01);
$n_pollo      = random(40, 99);

$total_vendidos = $n_carne + $n_pollo;

$total_dinero = $n_carne * $precio_carne + $n_pollo * $precio_pollo;

@pregunta = ("pollo", "carne");
$index    = random(0, 1);

if ($index == 0) {
    $text_preg = "pollo";
    $answer    = Compute($n_pollo);
} else {
    $text_preg = "carne";
    $answer    = Compute($n_carne);
}

#  Text

BEGIN_PGML
La panadería Ricomini vende pastelillos de carne a $[$precio_carne] la unidad y pastelillos de pollo a $[$precio_pollo] la unidad. Si al final del día se obtuvo $[$total_dinero] por vender [$total_vendidos] pastelillos, determinar  la cantidad de pastelillos de [$pregunta[$index]] que se vendió en el día. 

*Nota:* Los precios ya incluyen el Impuesto de Ventas

Cantidad de pastelillos de  [$pregunta[$index]]  = [@ ans_rule(20) @]* [@  helpLink('number')  @]*
END_PGML

#Context("Numeric");

#  Answers

ANS($answer->cmp());

BEGIN_PGML_SOLUTION
*Paso 1:* Ordenar la información del problema en una tabla:

[#
    [.Data.][.Ecuación.]{headerrow=>1}*
    [.[`[$precio_carne] \cdot \text{carne} + [$precio_pollo] \cdot \text{pollo} = [$total_dinero] `].]
    [. .]*
    [.Se vendieron [$total_vendidos] pastelillos en tota .]
    [.[` \text{pollo} = [$total_vendidos] - \text{carne}`].]
#]{horizontalrules => 1, texalignment => '|c|c|'}}


*Paso 2:* Sea [`c`] la cantidad de pastelillos de carne que se venden al día.

*Paso 3:* Llevar a cabo la sustitución necesaria con las igualdades en el Paso 1 para obtener una ecuación lineal:

[#
    [.Ecuación.][.Sustitución.]{headerrow=>1}*
    [.[`\text{pollo} = [$total_vendidos] - \text{carne}`].]
    [.[`\text{pollo} = [$total_vendidos] - c`] .]*
    [. [`[$precio_carne]\cdot\text{carne} + [$precio_pollo]\cdot\text{pollo}=[$total_dinero] `].]
    [.[`[$precio_carne] c + [$precio_pollo]([$total_vendidos] - c)=[$total_dinero]`].]
#]{horizontalrules => 1, texalignment => '|c|c|'}

*Paso 4:* Resolver la ecuación lineal para obtener el valor de [`c`]:
[```
[$precio_carne] c + [$precio_pollo]([$total_vendidos] - c) = [$total_dinero] \quad \text{entonces}\quad  c = [$answer]
```]
*Paso 5:*
Usar el valor de [`c`] para obtener la información que buscamos del problema verbal:
[```
 \begin{aligned}
   \text{Carne: } & c=[$n_carne] \\
   \text{Pollo: }   & [$total_vendidos] - c =[$n_pollo]
 \end{aligned}
```]

por lo tanto se vendieron [` [$answer] `] pastelillos de [$pregunta[$index]].
END_PGML_SOLUTION

ENDDOCUMENT();
