## DBsubject(Algebra)
## DBchapter(Linear equations and functions)
## DBsection(Applications and models)
## Level(1)
## KEYWORDS('ecuaciones','lineal','aplicacion')
## Author(Edwin Florez)
## Institution(UPRM)
## Language(es)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Numeric');

#construyendo 2 enteros consecutivos
$entero1 = random(3, 50);
$entero2 = $entero1 + 1;

$suma = $entero1 + $entero2;

@pregunta = ("menor", "mayor");
$index    = random(0, 1);

$answer = $index == 0 ? Compute($entero1) : Compute($entero2);

BEGIN_PGML
Si la suma de dos números enteros consecutivos es [$suma], encontrar el número [$pregunta[$index]].

Entero [$pregunta[$index]] = [_]{$answer}{20}

[@  helpLink('number')  @]*
END_PGML

BEGIN_PGML_SOLUTION
*Paso 1:* Ordenar la información del problema en una tabla

[# 
    [. Data .]
    [. Ecuación .]{headerrow=>1}*
    [.Suma de dos números enteros es [$suma] .]
    [. [` \text{primer número} + \text{segundo número}  = [$suma] `]  .]*
    [.Son números enteros consecutivos .]
    [. [` \text{segundo número} = \text{primer número}+1 `]  .]*
#]{horizontalrules => 1, texalignment => '|c|c|', padding=> 0.3}

*Paso 2:* Sea [`x`] el primer entero.

*Paso 3:* Llevar a cabo la sustitución necesaria con las igualdades en el Paso 1 para obtener una ecuación lineal:

[# 
    [. Ecuación .]
    [. Sustitución .]{headerrow=>1}*
    [.[`  \text{segundo número} = \text{primer número}+1 `] .]
    [.[`  \text{segundo número} = x+1  `] .]*
    [.[`  \text{primer número} + \text{segundo número} = [$suma] `] .]
    [.[`  x + (x+1) = [$suma] `] .]*
#]{horizontalrules => 1, texalignment => '|c|c|', padding=> 0.3}

*Paso 4:* Resolver la ecuación lineal para obtener el valor de [`x`]:
[```
 x + (x+1) = [$suma] \quad \text{entonces}\quad  x = [$entero1].
```]
*Paso 5:*
Usar el valor de [`x`] para obtener la información que buscamos en el problema verbal:
[```
\begin{aligned}
 \text{Primer entero: }     & x = [$entero1], \\
 \text{Segundo entero: } & x + 1 = [$entero2],
\end{aligned} 
```]

Por lo tanto el entero [$pregunta[$index]] es [`[$answer]`].
END_PGML_SOLUTION

ENDDOCUMENT();
