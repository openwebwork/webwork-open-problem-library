#  DESCRIPTION

#  Tipo: respuesta corta
#  Problema que pregunta por la coordenadas
#  de un punto en el plano cartesiano dada
#  su representacion gráfica.

#  Problema WebWork escrito por Edwin Florez,
#  <edwin.florez (at) upr (dot) edu>

#  Adaptado desde el sistema quiz.uprm.edu del archivo
#  pedro_prebasica/coordenadas_cartesianas/Hallar_Coordenadas_de_un_Punto.db

#  ENDDESCRIPTION

## DBsubject(Algebra)
## DBchapter(Cartesian coordinate system)
## DBsection(Plotting points)
## Institution(UPRM)
## Author(Edwin Florez)
## Level(1)
## Language(es)
## KEYWORDS('grafica', 'puntos','plano','coordenadas')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'plots.pl', 'PGcourse.pl');

Context("Point");
$a = random(-9, 9);
$b = random(-9, 9);
$p = Point($a, $b);

@direccion = (
    "unidad(es) a la derecha del",
    "unidad(es) a la izquierda del",
    "unidad(es) arriba del",
    "unidad(es) debajo del",
    "sobre el eje"
);

if ($a == 0 || $b == 0) {
    $indexX = 4;
    $indexY = 4;
} elsif ($a * $b > 0) {
    if ($a > 0) {
        $indexX = 0;
        $indexY = 2;
    } else {
        $indexX = 1;
        $indexY = 3;
    }
} else {
    if ($a > 0) {
        $indexX = 0;
        $indexY = 3;
    } else {
        $indexX = 1;
        $indexY = 2;
    }
}

$plot = Plot(
    xmin => -10,
    xmax =>  10,
    ymin => -10,
    ymax => 10
);

$plot->add_point($a, $b, color => 'blue');
$plot->add_label($a, $b, '(a,b)', v_align => 'bottom');

BEGIN_PGML
>> [!!]{$plot}{300} <<

>>(Click en la gráfica para agrandar)<<

¿Cuáles son las coordenadas del punto [`(a,b)`] mostrado en la gráfica anterior?

[`(a,b)=`]  [_]{$p}

[@  helpLink('points')  @]*
END_PGML

BEGIN_PGML_SOLUTION
*Identificar la ubicación del punto*:

El punto se encuentra [`[@ abs($a) @]*`] [$direccion[$indexX]] eje [`y`] y [`[@ abs($b) @]*`] [$direccion[$indexY]] eje [`x`].

Por lo tanto las coordenadas del punto son: [`[$p]`]. 
END_PGML_SOLUTION

ENDDOCUMENT();
