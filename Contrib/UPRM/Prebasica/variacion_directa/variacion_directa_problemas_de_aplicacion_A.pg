## DBsubject(Algebra)
## DBchapter(Variation and power functions)
## DBsection(Direct variation)
## Institution(UPRM)
## Author(Edwin Florez)
## Level(1)
## Language(es)
## KEYWORDS('relaciones','variacion','directa','aplicaciones')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Numeric');

@frase = (
    "varía directamente con el",
    "es directamente proporcional al",
    "es proporcional al"
);
$index1 = random(0, 2);

@movil  = ("un automovil", "una motocicleta");
$index2 = random(0, 1);

#creando la relación a=kb
$k = random(2, 15);

$f   = Formula("$k x");
$b1  = random(1, 9);
$fb1 = $f->eval(x => $b1);

$b2  = random(5, 50);
$fb2 = $f->eval(x => $b2);

$prob = random(0, 1);
if ($prob == 0) {
    $pregunta = "cuál es la distancia recorrida en $b2 horas";
    $answer   = Compute($fb2);
    $sustituir =
        "d = $k t \quad \Rightarrow \quad d = $k\cdot $b2 \quad \Rightarrow \quad d = $fb2.";
} else {
    $pregunta = "cuántas horas duró en recorrer $fb2 kilómetros";
    $answer   = Compute($b2);
    $sustituir =
        "d = $k t \quad \Rightarrow \quad $fb2 = $k t \quad \Rightarrow \quad t = $b2.";
}

BEGIN_PGML
La distancia que recorre [$movil[$index2]] [$frase[$index1]] tiempo que realiza el recorrido. Si recorre una distancia de [$fb1] kilómetros en [$b1] hora(s), entonces [$pregunta].

(ESCRIBIR sólo el número) 

Contestación: = [_]{$answer}{20}

[@  helpLink('number')  @]*
END_PGML

BEGIN_PGML_SOLUTION
*Paso 1:* Traducir el enunciado a una fórmula de variación directa

>>
La distancia [$frase[$index1]] tiempo  [`\quad \Rightarrow \quad \text{distancia} = k\cdot  \text{tiempo} `]
<<

donde [` k `] es la constante de proporcionalidad. 

*Paso 2:* Sustituir valores conocidos para encontrar [` k `]. Como la distancia es [$fb1] kilómetros y el tiempo son [$b1] horas, entonces
[```
  [$fb1] = k\cdot [$b1] \quad \Rightarrow \quad k = \frac{[$fb1]}{[$b1]} = [$k]
```]

*Paso 3:* Sustituir el valor de [` k `] y escribir la fórmula
[```
 \text{distancia} = [$k]\cdot\text{tiempo} \quad \text{o} \quad d = [$k] t.
```]

*Paso 4:* Queremos saber [$pregunta], entonces sustituyendo en la ecuación anterior
[```
[$sustituir]
```] 
Por lo tanto la solución es [$answer]. 
END_PGML_SOLUTION

ENDDOCUMENT();
