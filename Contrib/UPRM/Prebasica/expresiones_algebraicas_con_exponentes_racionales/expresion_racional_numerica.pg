#  DESCRIPTION

#  Tipo: respuesta corta
#  Aplicar propiedades de los radicales
#  para encontrar el valor de la variable en
#  los exponentes. Ejp. \sqrt[m]{g^rg^s} = g^n, n=?

#  Problema WeBWork escrito por Edwin Florez,
#  <edwin.florez (at) upr (dot) edu>

#  Adaptado desde el sistema quiz.uprm.edu del archivo
#  pedro_prebasica/expresiones_algebraicas_con_exponentes_racionales/expresion_racional_numerica.db

#  Última actualización: Edwin F. 08/01/2014

#  ENDDESCRIPTION

## DBsubject(Prebasica)
## DBchapter(Radicales)
## DBsection(Propiedades)
## Level(1)
## KEYWORDS('radicales','propiedades')

## DBCCSS('')
## TitleText1('')
## EditionText1('')
## AuthorText1('')
## Section1('')
## Problem1('')

## Author(Edwin Florez)
## Institution(UPRM)
## Language(es)

DOCUMENT();

loadMacros(
    'PGstandard.pl',       'PGML.pl',
     'contextFraction.pl',
    'PGcourse.pl'
);


#las componentes de la exp \sqrt[m]{g^rg^s} = g^n

$m = random(3, 8);
$r = random(2, 9);
$s = random(2, 9);

$rms = $r + $s;

$exp = "\sqrt[$m]{ g^{$r}g^{$s} }";

Context("Fraction");

$answer = Fraction($rms, $m);

#  Text

BEGIN_PGML
Considere la siguiente expresión
[```
 [$exp] = g^n
```]
Calcule el valor de [`n`].

[`n=`] [_]{$answer->cmp(studentsMustReduceFractions => 1)} 

[@  helpLink('number')  @]*
END_PGML

BEGIN_PGML_SOLUTION
*Paso 1:* Utilizar la propiedad [` a^p a^q = a^{p+q} `]
[```
 [$exp] = \sqrt[[$m]]{g^{[$r]+[$s]}} = \sqrt[[$m]]{g^{[$rms]}}
```]

*Paso 2:* Utilizar la propiedad [` \sqrt[[$m]]{a} = a^{\frac{1}{[$m]}} `]
[```
 \sqrt[[$m]]{g^{[$rms]}} = \left( g^{[$rms]} \right)^{\frac{1}{[$m]}}
```]

*Paso 3:* Utilizar la propiedad [` \left( a^p \right)^q = a^{pq}  `] y simplificar la fracción si es el caso
[```
 \left( g^{[$rms]} \right)^{\frac{1}{[$m]}} = g^{\frac{[$rms]}{[$m]}},
```]

por lo tanto la solución es [` [$answer] `].
END_PGML_SOLUTION

ENDDOCUMENT();
