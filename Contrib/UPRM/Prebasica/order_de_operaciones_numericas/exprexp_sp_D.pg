#  DESCRIPTION

#  Tipo: respuesta corta
#  Orden de operaciones: dada una exp tipo a+b/c^n + d*e^m, encontrar el resultado.  

#  Problema WebWork escrito por Edwin Florez, 
#  <edwin.florez (at) upr (dot) edu>

#  Adaptado desde el sistema quiz.uprm.edu del archivo
#  pedro_prebasica/order_de_operaciones_numericas/exprexp_sp.db

#  ENDDESCRIPTION

## DBsubject(Algebra)
## DBchapter(Algebra of real numbers and simplifying expressions)
## DBsection(Evaluating expressions)
## Level(1)
## KEYWORDS('operaciones', 'numeros', 'orden')
## Author(Edwin Florez)
## Institution(UPRM)
## Language(es)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'contextLimitedNumeric.pl', 'PGcourse.pl');

Context('Numeric');

#construyendo la exp. tipo a+b/c^n + d*e^m
$a = random(-20,20);
$n = random(2,4);
$c =list_random(2,3,5,7);

$b = ($c**$n)*list_random(2,3,5)*list_random(2,3,5);
if ( random(0,1) == 1 ){
  $b = -$b;
}

$d = non_zero_random(-15,15);
$e = random(2,5);
$m = random(2,4);

$r = $a + $b/($c**$n) + $d*($e**$m);

#usado al presentar la solución
$potencia1 = $c**$n;
$potencia2 = $e**$m;
$division = $b/$potencia1;
$multiplicacion = $d*$potencia2;
$suma_resta = $a + $division + $multiplicacion;


Context("LimitedNumeric");

$answer = Compute($r);

BEGIN_PGML
[```
[$a] + [$b] \div [$c]^{[$n]} + [$d]\cdot [$e]^{[$m]}
```]
Efectúe las operaciones indicadas y obtenga el resultado para la expresión que se muestra arriba.

Contestación: [_]{$answer}{10}

[@  helpLink('number')  @]*
END_PGML


BEGIN_PGML_SOLUTION
*Paso 1:* Realizar las potencias:
[```
[$a] + [$b] \div [$c]^{[$n]} + [$d]\cdot [$e]^{[$m]} = [$a] + [$b] \div [$potencia1] + [$d]\cdot [$potencia2]
```]

*Paso 2:* Realizar la división y multiplicación: 
[```
[$a] + [$b] \div [$potencia1] + [$d]\cdot [$potencia2] = [$a] + [$division] + [$multiplicacion]
```]

*Paso 3:* Realizar las sumas y/o restas:
[```
[$a] + [$division] + [$multiplicacion] = [$suma_resta]
```]

La solución es: [` [$answer] `].
END_PGML_SOLUTION

ENDDOCUMENT();