#  DESCRIPTION

#  Tipo: Seleccionar la correcta
#   Orden de operaciones: dada una exp tipo a^n+b*c, encontrar el resultado.

#  Problema WebWork escrito por Edwin Florez,
#  <edwin.florez (at) upr (dot) edu>

#  Adaptado desde el sistema quiz.uprm.edu del archivo
#  pedro_prebasica/order_de_operaciones_numericas/exprexp_sp.db

#  ENDDESCRIPTION

## DBsubject(Algebra)
## DBchapter(Algebra of real numbers and simplifying expressions)
## DBsection(Evaluating expressions)
## Level(1)
## KEYWORDS('operaciones', 'numeros', 'orden')
## Author(Edwin Florez)
## Institution(UPRM)
## Language(es)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'parserRadioButtons.pl', 'PGcourse.pl');

Context('Numeric');

#construyendo la exp. tipo a^n + b * c
$a = random(1, 5);
$n = random(2, 4);
$b = non_zero_random(-9, 9);
$c = random(2, 9);

@r = (
    $a**$n + $b * $c,
    ($a + $b * $c)**$n,
    ($a**$n + $b) * $c,
    (($a + $b)**$n) * $c,
    $a * $n + $b * $c
);

#usado al presentar la solución
$potencia       = $a**$n;
$multiplicacion = $b * $c;
$suma_resta     = $potencia + $multiplicacion;

$operacion = $b > 0 ? 'suma' : 'resta';

$radio = RadioButtons([ [@r], "Ninguna de las otras" ], 0, labels => "ABC");

BEGIN_PGML
[```
[$a]^{[$n]} + [$b] \cdot [$c]
```]
Efectúe las operaciones indicadas y obtenga el resultado para la expresión que se muestra arriba.

[_]{$radio}
END_PGML

BEGIN_PGML_SOLUTION
*Paso 1:* Realizar la potencia:
[```
[$a]^{[$n]} + [$b] \cdot [$c] = [$potencia] + [$b]\cdot [$c]
```]

*Paso 2:* Realizar la multiplicación: 
[```
[$potencia] + [$b]\cdot [$c]= [$potencia] + [$multiplicacion]
```]

*Paso 3:* Realizar la [$operacion]:
[```
[$potencia]+[$multiplicacion] = [$suma_resta]
```]

La solución es: [` [$suma_resta] `].
END_PGML_SOLUTION

ENDDOCUMENT();
