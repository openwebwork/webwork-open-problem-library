#  DESCRIPTION

#  Tipo: respuesta corta
#  Orden de operaciones: dada una exp tipo a \pm (b*c)^n, encontrar el resultado.

#  Problema WebWork escrito por Edwin Florez,
#  <edwin.florez (at) upr (dot) edu>

#  Adaptado desde el sistema quiz.uprm.edu del archivo
#  pedro_prebasica/order_de_operaciones_numericas/operaciones_con_una_potencia.db

#  ENDDESCRIPTION

## DBsubject(Algebra)
## DBchapter(Algebra of real numbers and simplifying expressions)
## DBsection(Evaluating expressions)
## Level(1)
## KEYWORDS('operaciones', 'numeros', 'orden')
## Author(Edwin Florez)
## Institution(UPRM)
## Language(es)

DOCUMENT();

loadMacros(
    'PGstandard.pl',            'PGML.pl',
    'contextLimitedNumeric.pl', 'PGcourse.pl'
);

Context('Numeric');

#construyendo la exp. tipo a \pm (b * c)^n

$sig = random(0, 1) == 0 ? '+' : '-';

$a = non_zero_random(-50, 50);
$b = non_zero_random(-5,  5);
$c = non_zero_random( 2,  9);
$n = abs($b * $c) > 10 ? 2 : random(2, 4);
$r = Compute("$a $sig ($b*$c)**$n");

#usado al presentar la solución
$producto   = $b * $c;
$potencia   = $producto**$n;
$suma_resta = Compute("$a $sig $potencia");

Context("LimitedNumeric");

$answer = Compute($r);

BEGIN_PGML
[```
[$a] [$sig] ([$b]\times [$c])^{[$n]}
```]
Efectúe las operaciones indicadas y obtenga el resultado para la expresión que se muestra arriba.

Contestación: [_]{$answer}{10}

[@  helpLink('number')  @]*
END_PGML

BEGIN_PGML_SOLUTION
*Paso 1:* Resolver los paréntesis haciendo la multiplicación:
[```
 [$a] [$sig] ([$b]\times [$c])^{[$n]} = [$a] [$sig] ([$producto])^{[$n]}
```]

*Paso 2:* Realizar la potencia: 
[```
[$a] [$sig] ([$producto])^{[$n]} = [$a] [$sig] [$potencia]
```]

*Paso 3:* Realizar la suma o resta:
[```
[$a] [$sig] [$potencia] = [$suma_resta]
```]

La solución es: [` [$answer] `].
END_PGML_SOLUTION

ENDDOCUMENT();
