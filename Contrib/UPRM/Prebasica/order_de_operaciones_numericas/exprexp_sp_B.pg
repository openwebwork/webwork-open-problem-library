#  DESCRIPTION

#  Tipo: respuesta corta
#   Orden de operaciones: dada una exp tipo a+b/c^n, encontrar el resultado.

#  Problema WebWork escrito por Edwin Florez,
#  <edwin.florez (at) upr (dot) edu>

#  Adaptado desde el sistema quiz.uprm.edu del archivo
#  pedro_prebasica/order_de_operaciones_numericas/exprexp_sp.db

#  ENDDESCRIPTION

## DBsubject(Algebra)
## DBchapter(Algebra of real numbers and simplifying expressions)
## DBsection(Evaluating expressions)
## Level(1)
## KEYWORDS('operaciones', 'numeros', 'orden')
## Author(Edwin Florez)
## Institution(UPRM)
## Language(es)

DOCUMENT();

loadMacros(
    'PGstandard.pl',            'PGML.pl',
    'contextLimitedNumeric.pl', 'PGcourse.pl'
);

Context('Numeric');

#construyendo la exp. tipo a + b / c^n
$a = random(1, 20);
$c = list_random(2, 3, 5);
$n = random(2, 4);

$b = ($c**$n) * list_random(2, 3, 5) * list_random(2, 3, 5);
if (random(0, 1) == 1) {
    $b = -$b;
}

$r = $a + $b / ($c**$n);

#usado al presentar la solución
$potencia   = $c**$n;
$division   = $b / $potencia;
$suma_resta = $a + $division;

$operacion = $b > 0 ? 'suma' : 'resta';

Context("LimitedNumeric");

$answer = Compute($r);

BEGIN_PGML
[```
[$a] + [$b] \div [$c]^{[$n]}
```]
Efectúe las operaciones indicadas y obtenga el resultado para la expresión que se muestra arriba.

Contestación: [_]{$answer}{10}

[@  helpLink('number')  @]*
END_PGML

BEGIN_PGML_SOLUTION
*Paso 1:* Realizar la potencia:
[```
[$a] + [$b] \div [$c]^{[$n]} = [$a]+[$b]\div [$potencia]
```]

*Paso 2:* Realizar la división: 
[```
[$a]+[$b]\div [$potencia] = [$a]+[$division]
```]

*Paso 3:* Realizar la [$operacion]:
[```
[$a]+[$division] = [$suma_resta]
```]

La solución es: [` [$answer] `].
END_PGML_SOLUTION

ENDDOCUMENT();
