## DBsubject(Algebra)
## DBchapter(Variation and power functions)
## DBsection(Inverse variation)
## Institution(UPRM)
## Author(Edwin Florez)
## Level(1)
## Language(es)
## KEYWORDS('relaciones','variacion','inversa','aplicaciones')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Numeric');
#creando la relación a=k/b
@primos = (2, 3, 5);

@factors_k = ();
$k         = 1;

#Eligiendo a k como una multiplicación de 5 primos de la lista de primos.
for my $i (0 .. 4) {
    $r             = random(0, $#primos);
    @factors_k[$i] = $primos[$r];
    $k             = $k * $primos[$r];
}

#Eligiendo de los 5 factores de k (mínimo 3, máximo 4) cuantos serán para a y el resto para b
$num_fact_a = random(1, 3);

$a = 1;
foreach my $i (0 .. $num_fact_a) {
    $a = $a * $factors_k[$i];
}

$b = 1;
foreach my $i ($num_fact_a + 1 .. $#factors_k) {
    $b = $b * $factors_k[$i];
}

#Eligiendo otra partición diferente de k y asignandola a a1 y b1.
do {
    $num_fact_a1 = random(1, 3);
} until ($num_fact_a1 != $num_fact_a);

$a1 = 1;
foreach my $i (0 .. $num_fact_a1) {
    $a1 = $a1 * $factors_k[$i];
}

$b1 = 1;
foreach my $i ($num_fact_a1 + 1 .. $#factors_k) {
    $b1 = $b1 * $factors_k[$i];
}

$prob = random(0, 1);
if ($prob == 0) {
    $pregunta =
        "¿Cuántos trabajadores se necesitan para terminar el proyecto en $a1 días?";
    $answer = Compute($b1);
    $sustituir =
        "t = \frac{$k}{n} \quad \Rightarrow \quad $a1 = \frac{$k}{n} \quad \Rightarrow \quad n = $b1.";
} else {
    $pregunta =
        "¿Cuántos días se necesitan para terminar el proyecto utilizando $b1 trabajadores?";
    $answer = Compute($a1);
    $sustituir =
        "t = \frac{$k}{n} \quad \Rightarrow \quad t = \frac{$k}{$b1} \quad \Rightarrow \quad t = $a1.";
}

#  Text

BEGIN_PGML
El tiempo para completar un proyecto es inversamente proporcional al número de personas que está haciendo el proyecto. El proyecto puede ser completado por [$b] trabajadores en [$a] días. [$pregunta]

(Escribir SOLO el número) 

Contestación: = [_]{$answer}{20}

[@  helpLink('number')  @]*
END_PGML

BEGIN_PGML_SOLUTION
*Paso 1:* Traducir el enunciado a una fórmula de variación inversa
>>

Tiempo inversamente proporcional al número de trabajadores  [``\quad \Rightarrow \quad \text{tiempo} = \frac{k}{\text{número de trabajadores}}``]

donde [` k `] es la constante de proporcionalidad.

*Paso 2:* Sustituir valores conocidos para encontrar [` k `].

[```
  [$a] = \frac{k}{[$b]} \quad \Rightarrow \quad k = [$a]\cdot[$b] = [$k]
```]

*Paso 3:* Sustituir el valor de [` k `] y escribir la fórmula
[```
\text{tiempo} = \frac{[$k]}{\text{número de trabajadores}} \quad \text{o} \quad t = \frac{[$k]}{n}
```]

*Paso 4:* Identificar variables conocidas y sustituir los valores en la fórmula
[```
[$sustituir]
```] 
Por lo tanto la solución es [$answer]. 
END_PGML_SOLUTION

ENDDOCUMENT();
