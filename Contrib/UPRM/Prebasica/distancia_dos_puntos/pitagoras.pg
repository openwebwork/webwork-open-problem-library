#  DESCRIPTION

#  Tipo: respuesta corta
#  Dado dos lados de un triángulo rectángulo encontrar el otro
#  por medio del Teorema de Pitágoras.

#  Problema WebWork escrito por Edwin Florez,
#  <edwin.florez (at) upr (dot) edu>

#  Adaptado desde el sistema quiz.uprm.edu del archivo
#  pedro_prebasica/distancia_dos_puntos/pitagoras.db

#  ENDDESCRIPTION

## DBsubject(Algebra)
## DBchapter(Cartesian coordinate system)
## DBsection(Midpoint and distance formulas)
## Institution(UPRM)
## Author(Edwin Florez)
## Level(1)
## Language(es)
## KEYWORDS('triangulo','teorema de pitagoras')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

# Show which answers are correct and which ones are incorrect
$showPartialCorrectAnswers = 0;

Context("Point");
$a  = random(1, 15);
$b  = random(1, 20);
$pc = $a**2 + $b**2;

$c = Compute("sqrt($pc)");

$imageNumber = random(1, 3);

@tipo = (
    "\(a = $a\) y \(b = $b\)",
    "\(a = $a\) y \(c = \sqrt{$pc}\)",
    "\(b = $b\) y \(c = \sqrt{$pc}\)"
);
$index = random(0, 2);

if ($index == 0) {
    $answer  = Compute("$c");
    $textSol = "c";
} elsif ($index == 1) {
    $answer  = Compute("$b");
    $textSol = "b";
} else {
    $answer  = Compute("$a");
    $textSol = "a";
}

$filename = "tri1$imageNumber.png";

BEGIN_PGML

*Quizás falta definir si usamos ternas pitagóricas o no.*

>>[!!]{"$filename"}{150}<<

Según el triángulo rectángulo anterior, si [$tipo[$index]]* entonces
  
[`[$textSol] =`] [_]{$answer->cmp(tolType => 'absolute', tolerance => .001)}

[@  helpLink('number')  @]*
END_PGML

BEGIN_PGML_SOLUTION
La solución: [`[$answer]`]
END_PGML_SOLUTION

ENDDOCUMENT();
