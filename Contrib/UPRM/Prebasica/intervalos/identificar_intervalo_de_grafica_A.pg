#  DESCRIPTION

#  Tipo: respuesta corta
#  Dada la representación gráfica de una parte de la línea recta,
#  escribirla en forma de intervalo.

#  Problema WebWork escrito por Edwin Florez,
#  <edwin.florez (at) upr (dot) edu>

#  Adaptado desde el sistema quiz.uprm.edu del archivo
#  pedro_prebasica/intervalos/identificar_intervalo_de_grafica.db

#  ENDDESCRIPTION

## DBsubject(Algebra)
## DBchapter(Algebra of real numbers and simplifying expressions)
## DBsection(Inequalities and intervals)
## Institution(UPRM)
## Author(Edwin Florez)
## Level(1)
## Language(es)
## KEYWORDS('desigualdades','intervalo','grafica')

DOCUMENT();

loadMacros(
    'PGstandard.pl', 'PGML.pl',
    'plots.pl',      'contextInequalities.pl',
    'PGcourse.pl'
);

Context("Inequalities");
Context()->flags->set(formatStudentAnswer => 'parsed');

$plot = Plot(
    xmin         => -10,
    xmax         =>  10,
    xtick_delta  =>  1,
    xminor       =>  1,
    ymin         => -1.5,
    ymax         =>  1.5,
    xvisible     =>  1,
    yvisible     =>  0,
    show_grid    =>  0,
    aspect_ratio => 1
);

#la desigualdad
$a = non_zero_random(-5, 5, .5);

#Eligiendo (a,inf) o [a,inf) o (-inf,a) o (-inf,a]
$prob = random(0, 3);
if ($prob == 0) {
    $answer = Compute("($a,inf)");
    #Dibujando el intervalo (a,inf)
    $plot->add_dataset(
        [ $a, 0 ], [ 10, 0 ],
        start_mark => 'open_circle',
        end_mark   => 'arrow',
        arrow_size => 4,
        color      => 'blue',
        width      => 3
    );
    $xlabel    = $a + 2;
    $tipo      = "abierto";
    $accion    = "excluimos";
    $direccion = "infinito positivo";
    $sol_text  = "($a,\infty)";
} elsif ($prob == 1) {
    $answer = Compute("[$a,inf)");
    #Dibujando el intervalo [a,inf)
    $plot->add_dataset(
        [ $a, 0 ], [ 10, 0 ],
        start_mark => 'circle',
        end_mark   => 'arrow',
        arrow_size => 4,
        color      => 'blue',
        width      => 3
    );
    $plot->add_dataset([ $a, 0 ], [ 10, 0 ], color => 'blue', width => 3);
    $xlabel    = $a + 2;
    $tipo      = "cerrado";
    $accion    = "incluimos";
    $direccion = "infinito positivo";
    $sol_text  = "[$a,\infty)";
} elsif ($prob == 2) {
    $answer = Compute("(-inf,$a)");
    #Dibujando el intervalo (-inf,a)
    $plot->add_dataset(
        [ $a, 0 ], [ -10, 0 ],
        start_mark => 'open_circle',
        end_mark   => 'arrow',
        arrow_size => 4,
        color      => 'blue',
        width      => 3
    );
    $xlabel    = $a - 2;
    $tipo      = "abierto";
    $accion    = "excluimos";
    $direccion = "negativo infinito";
    $sol_text  = "(-\infty,$a)";
} else {
    $answer = Compute("(-inf,$a]");
    #Dibujando el intervalo (-inf,a]
    $plot->add_dataset(
        [ $a, 0 ], [ -10, 0 ],
        start_mark => 'circle',
        end_mark   => 'arrow',
        arrow_size => 4,
        color      => 'blue',
        width      => 3
    );
    $xlabel    = $a - 2;
    $tipo      = "cerrado";
    $accion    = "incluimos";
    $direccion = "negativo infinito";
    $sol_text  = "(-\infty,$a]";
}

BEGIN_PGML
Escriba en notación de *intervalo* el conjunto azul que se representa en la siguiente figura. 

>>[!!]{$plot}{600}<<

[_]{$answer}{10}

[@  helpLink('inequalities')  @]*
END_PGML

#$showHint = 3;
#BEGIN_HINT
#From the picture find the fixed endpoint.  If the arrow goes to the right then x
#can be larger.  If the arrow goes to the left, then x can be smaller.
#END_HINT

#$showHint = 5;
#BEGIN_HINT
#Look at the endpoint.  If it is a solid point, then the endpoint should be
#included and you will need either \( \le \) or \( \ge \).  If it is an open point, then
#the endpoint should not be included and you will need either \( < \) or \( > \).
#END_HINT

BEGIN_PGML_SOLUTION
Identificar el tipo de intervalo. El punto azul en la recta se encuentra *[$tipo]****, significa que *[$accion]**** el punto. También el conjunto azul se extiende hasta *[$direction]****, por lo tanto el intervalo es:
[```
[$sol_text]
```]
END_PGML_SOLUTION

ENDDOCUMENT();
