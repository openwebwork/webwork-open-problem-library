#  DESCRIPTION

#  Tipo: respuesta corta
#  Problema que pregunta si una situacion real
#  satisface una relacion lineal

#  Problema WebWork escrito por Edwin Florez,
#  <edwin.florez (at) upr (dot) edu>

#  Adaptado desde el sistema quiz.uprm.edu del archivo
#  pedro_prebasica/ecuaciones_lineales_2_variables_parte_1/relacion_lineal.db

#  ENDDESCRIPTION

## DBsubject(Prebasica)
## DBchapter(Ecuaciones lineales)
## DBsection(Aplicaciones)
## Level(1)
## KEYWORDS('lineal','aplicaciones','relacion')
## Author(Edwin Florez)
## Institution(UPRM)
## Language(es)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl',  'PGcourse.pl');

Context("Numeric");

@nombre = (
    "Juan",  "Cidmary", "Ramon", "Ashley", "Daniel", "Glorimar",
    "Jason", "Nilsa",   "Jesus", "Karen"
);
@banco = (
    "Banco Popular", "Banco Santander",
    "Scotiabank",    "FirstBank",
    "CitiBank"
);

$randIndexNombre = random(0, 9);
$randIndexBanco  = random(0, 4);

$depositoInicial    = random(5,   15,  1);
$tasaInteresMensual = random(.02, 0.3, 0.1);
$meses              = random(2,   7,   1);
$interes            = $tasaInteresMensual * $depositoInicial;
$relacion           = Formula("$depositoInicial + $interes*x");
$answer             = $relacion->eval(x => $meses);

BEGIN_PGML
[$nombre[$randIndexNombre]] inicia una cuenta en el [$banco[$randIndexBanco]] con [$depositoInicial] dólares y gana [$interes] dólares mensuales de intereses. Encuentre la cantidad de dinero en la cuenta que tendrá [$nombre[$randIndexNombre]] al transcurrir [$meses] meses. (*NO escribir el símbolo de dólares $*)

Respuesta: [_]{$answer}
END_PGML

BEGIN_PGML_SOLUTION

*Paso 1:* Entender el problema. 

[`\phantom{eee}`] i. [`x =`] los meses del dinero trabajado en el banco, [`y =`] los dólares en la cuenta. 

[`\phantom{eee}`] ii. [$nombre[$randIndexNombre]] inicia con [$depositoInicial] dólares, es decir [`x=0`] y [`y=[$depositoInicial]`].

[`\phantom{eee}`] iii. Cuando [`x`] aumenta en 1, [`y`] aumenta en [$interes].

*Paso 2:*  Realizar una tabla.

>>
[@ begintable(9) .
row( " \(x = \)  meses trabajados", 0,1,2,3,4,5,6,7 ) . 
row( " \(y = \) dólares en la cuenta", $relacion->eval(x=>0),$relacion->eval(x=>1),$relacion->eval(x=>2),$relacion->eval(x=>3),$relacion->eval(x=>4),$relacion->eval(x=>5),$relacion->eval(x=>6),$relacion->eval(x=>7) ) . 
endtable(); @]*
<<
  
Por lo tanto la cantidad de dinero en el banco al transcurrir [$meses] meses es [$answer] dólares. 
END_PGML_SOLUTION

ENDDOCUMENT();
