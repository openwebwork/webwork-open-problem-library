#  DESCRIPTION

#  Tipo: respuesta corta
#  Problema en contexto que pide calcular una de las variables
#  en m=dy/dx.

#  Problema WebWork escrito por Edwin Florez,
#  <edwin.florez (at) upr (dot) edu>

#  Adaptado desde el sistema quiz.uprm.edu del archivo
#  pedro_prebasica/ecuaciones_lineales_2_variables_parte_1/razon_de_cambio_y_pendiente.db

#  ENDDESCRIPTION

## DBsubject(Prebasica)
## DBchapter(Ecuaciones lineales)
## DBsection(Problemas verbales)
## Level(1)
## KEYWORDS('lineal','pendiente','cambios')
## Author(Edwin Florez)
## Institution(UPRM)
## Language(es)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'PGcourse.pl');


Context("Numeric");
@directionX = ("positiva",   "negativa");
@directionY = ("ascendemos", "descendemos");

$indexDirectionX = random(0, 1, 1);
$indexDirectionY = random(0, 1, 1);

$dx = random(1, 9);
$dy = random(1, 36);

Context("Fraction");
if (($indexDirectionX == 0 && $indexDirectionY == 0)
    || ($indexDirectionX == 1 && $indexDirectionY == 1))
{
    $answer = Compute("$dy/$dx");
    $rdx    = $dx;
    $rdy    = $dy;
} else {
    $answer = Compute("- $dy/$dx");
    if ($indexDirectionX == 1) {
        $rdx = -$dx;
        $rdy = $dy;
    } else {
        $rdy = -$dy;
        $rdx = $dx;
    }
}

BEGIN_PGML
Si caminamos [$dx] pies en la dirección [$directionX[$indexDirectionX]] del eje [`x`] a partir de una recta [`l`] y [$directionY[$indexDirectionY]] [$dy] pies en dirección del eje [`y`] hasta la misma recta, encuentre la pendiente de la recta [`l`]. Digite su respuesta en forma reducida. 

[` m = `] [_]{$answer->cmp(studentsMustReduceFractions => 1)} 

[@  helpLink('numbers')  @]*
END_PGML

BEGIN_PGML_SOLUTION
*Paso 1*: Aplicar definición de pendiente: Si [`m`] es la pendiente, sabemos que:
[``` 
  m=\frac{\mbox{cambio en } y}{\mbox{cambio en } x}.
```]
Como caminamos [$dx] pies en la dirección [$directionX[$indexDirectionX]] de [`x`], entonces _cambio en [`x=[$rdx]`]_.

*Paso 2*: Como [$directionY[$indexDirectionY]] [$dy] pies, entonces _cambio en [`y= [$rdy]`]_. Por consiguiente 
[```
 m = [$answer].
```]
END_PGML_SOLUTION

ENDDOCUMENT();
