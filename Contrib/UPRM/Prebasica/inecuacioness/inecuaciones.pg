#  DESCRIPTION

#  Tipo: falso/cierto
#  Comparar dos reales

#  Problema WebWork escrito por Edwin Florez,
#  <edwin.florez (at) upr (dot) edu>

#  Adaptado desde el sistema quiz.uprm.edu del archivo
#  pedro_prebasica/inecuacioness/inecuaciones.db

#  ENDDESCRIPTION

## DBsubject(Prebasica)
## DBchapter(Inecuaciones)
## DBsection(Comparacion)
## Level(1)
## KEYWORDS('inecuaciones','comparar')
## Author(Edwin Florez)
## Institution(UPRM)
## Language(es)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'parserPopUp.pl', 'PGcourse.pl');

Context("Numeric");

$a = random(-30, 30, 0.01);
$b = random(-30, 30, 0.01);

@arrayRelacion = (">", "<", "=", "\geq", "\leq");
$index         = random(0, 4);

if ($index == 0) {    #se elige que a > b
    if ($a > $b) {    #calculando el valor de verdad
        $answer  = 'cierta';
        $answer2 = "a la derecha de";
    } elsif ($a < $b) {
        $answer  = 'falsa';
        $answer2 = "a la izquierda de";
    } else {
        $answer  = 'falsa';
        $answer2 = "en la misma posición que";
    }
} elsif ($index == 1) {    #se elige que a < b
    if ($a < $b) {         #calculando el valor de verdad
        $answer  = 'cierta';
        $answer2 = "a la izquierda de";
    } elsif ($a > $b) {
        $answer  = 'falsa';
        $answer2 = "a la derecha de";
    } else {
        $answer  = 'falsa';
        $answer2 = "en la misma posición que";
    }
} elsif ($index == 2) {    #se elige que a = b
    if ($a == $b) {        #calculando el valor de verdad
        $answer  = 'cierta';
        $answer2 = "en la misma posición que";
    } elsif ($a > $b) {
        $answer  = 'falsa';
        $answer2 = "a la derecha de";
    } else {
        $answer  = 'falsa';
        $answer2 = "a la izquierda de";
    }
} elsif ($index == 3) {    #se elige que a >= b
    if ($a == $b) {        #calculando el valor de verdad
        $answer  = 'cierta';
        $answer2 = "en la misma posición que";
    } elsif ($a > $b) {
        $answer  = 'cierta';
        $answer2 = "a la derecha de";
    } else {
        $answer  = 'falsa';
        $answer2 = "a la izquierda de";
    }
} else {    #se elige que a <= b
    if ($a == $b) {    #calculando el valor de verdad
        $answer  = 'cierta';
        $answer2 = "en la misma posición que";
    } elsif ($a < $b) {
        $answer  = 'cierta';
        $answer2 = "a la izquierda de";
    } else {
        $answer  = 'falsa';
        $answer2 = "a la derecha de";
    }
}

$dd = DropDown([ 'cierta', 'falsa' ], $answer);

BEGIN_PGML
Determine si la siguiente proposición es cierta o falsa. 

Sea [`a=[$a]`] y [`b=[$b]`], entonces [` a [$arrayRelacion[$index]] b `].

[_]{$dd}
END_PGML

BEGIN_PGML_SOLUTION
Se tiene que [$a] se encuentra [$answer2] [$b] en la recta numérica, entonces la respuesta es [$answer]. 
END_PGML_SOLUTION

ENDDOCUMENT();
