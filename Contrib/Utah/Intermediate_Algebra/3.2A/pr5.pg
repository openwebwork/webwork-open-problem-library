## This problem is a modification of the following problem
## Library/FortLewis/Basic-skills-pretest/Skill-Assessment-09.pg
## Modifications were made by M. Osman

# DESCRIPTION
# Use product rule for expoents
# ENDDESCRIPTION

## ORIGINAL PROBLEM DESCRIPTION:
## DBsubject(Algebra)
## DBchapter(Properties of exponents, rational exponents and radicals)
## DBsection(Properties of exponents)
## KEYWORDS('exponentials', 'sum')
## Level(1)
## MO(1)
DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context("Numeric");

($a, $b) = random_subset(2, 3 .. 6);

$answer = Real("$a + $b");

BEGIN_PGML

[` x^{[$a]} \cdot x^{[$b]} = x^{n} `] for [` n = `] [_]{$answer}

END_PGML

BEGIN_PGML_SOLUTION
Recall the property 
[``` x^a \cdot x^b = x^{a+b}```]

Therefore, [`` x^{[$a]} \cdot x^{[$b]} = x^{[$answer]}``]
END_PGML_SOLUTION

ENDDOCUMENT();
