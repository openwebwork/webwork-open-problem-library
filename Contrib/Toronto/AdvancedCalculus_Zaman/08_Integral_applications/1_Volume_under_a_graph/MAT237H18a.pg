## DESCRIPTION
## Multiple choice template
## ENDDESCRIPTION


## DBsubject(Calculus)
## DBchapter(Integration)
## DBsection(Partitions)
## Date('')
## Institution('')
## Author('')
## MO(1)
## KEYWORDS('multiple choice', 'template')


###########################
#  Initialization

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserRadioButtons.pl",
  "PGML.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup

Context("Numeric");


$radio1 = RadioButtons(
  ["add answers","other incorrect answers"],
  "add answers", # correct answer
);

$radio2 = RadioButtons(
  ["add answers","other incorrect answers"],
  "add answers", # correct answer
);

###########################
#  Main text

BEGIN_TEXT
Let \(T =\) {\((x, y) \in \mathbb{R}^2 : 0 \leq y \leq −x^2 + 6x\)}
$BR
$BR
$BR
END_TEXT

Context()->texStrings;
BEGIN_TEXT
Select the expression(s) that give(s) \(T\) as a 2-dimensional integral.
$BR
$BR
\{ $radio1->buttons() \}

$BR
$BR

Select the expression(s) that give(s) \(T\) as a 1-dimensional integral.

$BR
$BR

\{ $radio2->buttons() \}
END_TEXT

############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio1->cmp() );
ANS( $radio2->cmp() );

############################
#  Solution

BEGIN_PGML_SOLUTION
The correct answer is [$radio1->correct_ans()].
The correct answer is [$radio2->correct_ans()].
END_PGML_SOLUTION

COMMENT('MathObject version. Uses PGML.');

ENDDOCUMENT();