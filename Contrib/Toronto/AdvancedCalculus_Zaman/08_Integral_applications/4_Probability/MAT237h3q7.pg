## DESCRIPTION
## Multiple choice template
## ENDDESCRIPTION

## KEYWORDS('multiple choice', 'template')

## DBsubject('WeBWorK')
## DBchapter(WeBWorK tutorial)
## DBsection(Fort Lewis tutorial 2011)
## Date('01/30/2011')
## Author('Paul Pearson')
## Institution('Fort Lewis College')
## TitleText1('')
## EditionText1('')
## AuthorText1('')
## Section1('')
## Problem1('')


###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup



$mc = new_checkbox_multiple_choice();

$mc -> qa (
"Assume the probability density function \(\phi\) is arbitrary. Select the events that occur with probability zero.", 
"The vector lies outside the square", "The vector lies on the edge of the square", "The vector is the zero vector","The vector lies along the horizontal axis", "The vector lies along the unit circle$BR",               
);


$mc->extra("The vector lies inside the square","The vector points upward but not directly up","The vector has magnitude between 1 and 2","The vector has two rational components","The vector has one rational component");

###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
\let (\( \Omega, \sum, \mathbb{P}\) ) be a continuous probability sapce in \(\mathbb{R}^2\) for selecting a vector inside the square \(\Omega = [-7,7]^2\).
$BR
$BR
\{ $mc -> print_q() \}
\{ $mc -> print_a() \}
END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc->correct_ans() ) );


############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $mc->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT(); 