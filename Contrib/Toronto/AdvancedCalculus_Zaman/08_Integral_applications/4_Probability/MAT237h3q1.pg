DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "PGgraders.pl",
  "PGcourse.pl"
);


TEXT(beginproblem());

##############################################
#  Setup

# Create and use pop up lists 
$tf = new_select_list();
$tf->rf_print_q(~~&pop_up_list_print_q);

# Specify choices presented to students
$tf->ra_pop_up_list( 
[ 
No_answer => "?", 
"True"=>"True", 
"False"=>"False"
] );

# Questions and answers
$tf -> qa ( 
" \(\sum\) is the set of all subsets of \(\Omega\).$BR","False",

"\( \mathbb{P}(A) = \int_A \phi dV\) for every subset \(A \subseteq \Omega \)$BR","False",

"If \(A \subseteq \Omega\) and A has zero Jordan measure, then A is an event in \(\sum\). $BR","True",

"\( 0 \leq \mathbb{P}(A) \leq 1\) for all events A \( \in \sum\). $BR","False",

"\( 0 \leq \phi(x) \leq 1\) for all \( x \in \Omega\). $BR","False",

"\( \mathbb{P}(A \cup B) = \mathbb{P}(A) + \mathbb{P}(B)\) for every A, B \(\in \sum\). $BR","False",
);

# How many questions to use
$tf->choose(6);


##############################################
#  Main text

BEGIN_TEXT
Let (\( \Omega, \sum, \mathbb{P}\) )be a continuous probability space in \(\mathbb{R}^n\) with probability density function \(\phi\). Which of the
following are true or false?
$BR
\{ $tf->print_q() \}
END_TEXT

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;


ANS(str_cmp($tf->ra_correct_ans));

ENDDOCUMENT();
