###########################
#  Initialization

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserRadioButtons.pl",
  "PGML.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup

Context("Numeric");


$radio1 = RadioButtons(
  ["\( \frac{1}{N^n} \sum_{i \in I_n} M_i\)","other incorrect answers"],
  "\( \frac{1}{N^n} \sum_{i \in I_n} M_i\)", # correct answer
);

$radio2 = RadioButtons(
  ["\( \frac{1}{N^n} \sum_{i \in I_n} m_i\)","other incorrect answers"],
  "\( \frac{1}{N^n} \sum_{i \in I_n} m_i\)", # correct answer
);

###########################
#  Main text

BEGIN_TEXT
Here you derive the average value of a function f using regular partitions, upper sums, and lower sums. \(\\\)
\(\bullet\) Let \(R = [a_1, b_1] \times· · · \times [a_n, b_n]\) be a rectangle in \(\mathbb{R}^n\) and let \(f\) be an integrable real-valued function. \(\\\)
\(\bullet\) For \(N \in \mathbb{N}^+\), let \(P_N\) be a regular partition of \(R\) into \(N^n\) subrectangles constructed from a regular partition of each subinterval \([a_j , b_j ]\) into \(N\) subintervals for \(1 \leq j \leq n\). \(\\\)
\(\bullet\) Let {\(R_i\)} \(i \in I_N\) be the subrectangles of \(P_N\), so each subrectangle has volume \(\frac{\textit{vol}(R)}{N^n}\). $BR
$BR
$BR
END_TEXT

Context()->texStrings;
BEGIN_TEXT
Select the formula that is a discrete over-estimate for the average value of \(f\) on R.
$BR
$BR
\{ $radio1->buttons() \}

$BR
$BR

Select the formula that is a discrete under-estimate for the average value of \(f\) on R.

$BR
$BR
\{ $radio2->buttons() \}
END_TEXT

############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio1->cmp() );
ANS( $radio2->cmp() );

############################
#  Solution

BEGIN_PGML_SOLUTION
The correct answer is [$radio1->correct_ans()].
The correct answer is [$radio2->correct_ans()].
END_PGML_SOLUTION

COMMENT('MathObject version. Uses PGML.');

ENDDOCUMENT();

