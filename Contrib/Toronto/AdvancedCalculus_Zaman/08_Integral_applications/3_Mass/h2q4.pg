## DESCRIPTION
## Multiple choice template
## ENDDESCRIPTION

## KEYWORDS('multiple choice', 'template')

## DBsubject('WeBWorK')
## DBchapter(WeBWorK tutorial)
## DBsection(Fort Lewis tutorial 2011)
## Date('01/30/2011')
## Author('Paul Pearson')
## Institution('Fort Lewis College')
## TitleText1('')
## EditionText1('')
## AuthorText1('')
## Section1('')
## Problem1('')


###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup

$mc = new_checkbox_multiple_choice();

$mc -> qa (
"The solid A weighs more than solid B.", 
"\(\int_A \delta_A dV > \int_B \delta_B dV\) $BR",               
);

$mc->extra("other answers");

$mc2 = new_checkbox_multiple_choice();

$mc2 -> qa (
"The volume of A is equal to the volume of B.", 
"\(\int_A 1 dV = \int_B 1 dV\) $BR",               
);

$mc2->extra("other answers");


$mc3 = new_checkbox_multiple_choice();

$mc3 -> qa (
"The average density of A exceeds the average density of B", 
"\( \frac{\int_A \delta dV}{\int_A 1dV} > \frac{\int_B \delta dV}{\int_B 1dV}\)  $BR",               
);

$mc3->extra("other answers");

$mc4 = new_checkbox_multiple_choice();

$mc4 -> qa (
" \(\exists k \subseteq (0, \infty)\) s.t.\(  \forall x \in B,  \delta B (x) = k \)", 
"The object B has uniform density $BR",              
);

$mc4->extra("other answers");

$mc5 = new_checkbox_multiple_choice();

$mc5 -> qa (
" \( \forall x \in A, \delta (x) = lim_{\varepsilon \to 0^+} \frac{1}{vol(A \cap B_{\varepsilon}(x))} \int_{A \cap B_{\varepsilon}(x)} \delta dV\)", 
"The mass density of A at a point is equal to the limit of average density of shrinking solid balls centered at the point. $BR",              
);

$mc5->extra("other answers");

###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
Let \(A \subseteq \mathbb{R}^3\) and \(B \subseteq \mathbb{R}^3\) be solids with mass densities \( \delta A : A \to [0, \infty) \) and \(\delta B : B \to [0, \infty) \)respectively.
For each part below, select the option that is the translation of the informal sentence into a formal mathematical statement, or vice versa.

$BR
$BR
\{ $mc -> print_q() \}
\{ $mc -> print_a() \}
$BR
\{ $mc2 -> print_q() \}
\{ $mc2 -> print_a() \}
$BR
\{ $mc3 -> print_q() \}
\{ $mc3 -> print_a() \}
$BR
\{ $mc4 -> print_q() \}
\{ $mc4 -> print_a() \}
$BR
\{ $mc5 -> print_q() \}
\{ $mc5 -> print_a() \}
END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );
ANS( checkbox_cmp( $mc3->correct_ans() ) );
ANS( checkbox_cmp( $mc4->correct_ans() ) );
ANS( checkbox_cmp( $mc5->correct_ans() ) );

############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $mc->correct_ans() \}
The correct answer is \{ $mc2->correct_ans() \}
The correct answer is \{ $mc3->correct_ans() \}
The correct answer is \{ $mc4->correct_ans() \}
The correct answer is \{ $mc5->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT();
