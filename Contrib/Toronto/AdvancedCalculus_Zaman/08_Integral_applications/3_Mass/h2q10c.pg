DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "PGgraders.pl",
  "PGcourse.pl"
);


TEXT(beginproblem());

##############################################
#  Setup

# Create and use pop up lists 
$tf = new_select_list();
$tf->rf_print_q(~~&pop_up_list_print_q);

# Specify choices presented to students
$tf->ra_pop_up_list( 
[ 
No_answer => "?", 
"True"=>"True", 
"False"=>"False"
] );

# Questions and answers
$tf -> qa ( 
" If \( \frac{\partial \delta}{\partial y} > 0\) on \(C\), then the mass of \(N\) exceeds the mass of \(S\). $BR","True",

"If \( \frac{\partial \delta}{\partial x} > 0\) on \(C\), then the mass of \(E\) exceeds the mass of \(W\) .$BR","False",

"If the mass of z\(N\) is greater than the mass of \(S\), then \( \frac{\partial \delta}{\partial y} > 0 \) on \(C\). $BR","False",

"If the mass of \(N\) is greater than the mass of \(S\), then the volume of \(N\) exceeds the volume of \(S\).$BR","False",

"f the mass of \(N\) is greater than the mass of \(S\), then the centroid of \(C\) lies above the y-axis. $BR","False",

"If the mass of \(N\) is greater than the mass of \(S\), then \(\overline{y} > 0\).$BR","False",

"If the mass of \(N\) equals the mass of \(S\), then \(\overline{y} = 0\).$BR","False",

"If the mass of \(E\) is greater than the mass of \(W\) , then \(\overline{x} > 2\) $BR","False",
);

# How many questions to use
$tf->choose(8);


##############################################
#  Main text

BEGIN_TEXT
Let \(C =\) {\((x, y) \in \mathbb{R}^2 : x^2 + y^2 \leq 9\)} be a slice of cheese with a \(C^1\) variable density \( \delta : C \to [0, \infty)\). Let
\((x, y)\) be the centre of mass of \(C\). Define the subsets $BR
\(N = \){\((x, y) \in \mathbb{R}^2 : x^2 + y^2 \leq 9, y \geq 0\)}. $BR
\(E =\) {\((x, y) \in \mathbb{R}^2 : x^2 + y^2 \leq 9, x \geq 2\)}. $BR
\(S =\) {\((x, y) \in \mathbb{R}^2 : x^2 + y^2 \leq 9, y \leq 0\)}. $BR
\(W = \){\((x, y) \in \mathbb{R}^2 : x^2 + y^2 \leq 9, x \leq 2\)} $BR
Notice \(E\) and \(W\) are not symmetric about the vertical axis. Decide which statements are true or false.$BR
Hint: Do not try to argue everything mathematically. Use your physical intuition.
$BR
\{ $tf->print_q() \}
END_TEXT

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;


ANS(str_cmp($tf->ra_correct_ans));

ENDDOCUMENT();