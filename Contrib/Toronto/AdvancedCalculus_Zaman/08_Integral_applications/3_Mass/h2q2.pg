###########################
#  Initialization

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserRadioButtons.pl",
  "PGML.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup

Context("Numeric");

$radio1 = RadioButtons(
  ["Owl","Eeyore", "Tigger", "Piglet", "Roo"],
  "Tigger", # correct answer
);

###########################
#  Main text

BEGIN_TEXT
Language describing mass density is quite subtle and can quickly go wrong. Eeyore, Owl, Piglet, Roo, and Tigger are discussing the mass density function \(\delta : S \to  [0, \infty) \) at a point \(x \in S\). $BR $BR
Eeyore says “The value \(\delta (x)\) is equal to the density of \(S\) at the point \(x\).” $BR  $BR
Owl says “The value \(\delta (x)\) is approximately the density of \(S\) at the point \(x\).”  $BR   $BR
Piglet says “The value \(\delta (x)\) is equal to the average density of \(S\) at the point \(x\).”  $BR   $BR
Roo says “The value \(\delta (x)\) is approximately the average density of \(S\) at the point \(x\).”   $BR   $BR
Tigger says “None of these claims are remotely accurate!”   $BR  $BR
Who is the closest to the truth? $BR  $BR $BR
END_TEXT

BEGIN_PGML
[@ $radio1->buttons() @]*
END_PGML

############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio1->cmp() );


############################
#  Solution

BEGIN_PGML_SOLUTION
The correct answer is [$radio1->correct_ans()].
END_PGML_SOLUTION

COMMENT('MathObject version. Uses PGML.');

ENDDOCUMENT();