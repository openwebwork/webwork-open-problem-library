## DESCRIPTION
## Multiple choice template
## ENDDESCRIPTION

## KEYWORDS('multiple choice', 'template')

## DBsubject('WeBWorK')
## DBchapter(WeBWorK tutorial)
## DBsection(Fort Lewis tutorial 2011)
## Date('01/30/2011')
## Author('Paul Pearson')
## Institution('Fort Lewis College')
## TitleText1('')
## EditionText1('')
## AuthorText1('')
## Section1('')
## Problem1('')


###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup

$mc = new_checkbox_multiple_choice();

$mc -> qa (
"Select examples of objects \(S\) where the mass density \(\delta\) is uniform.", 
"glass $BR",               
);

$mc->extra("The Earth's atmosphere","an apple","no object in the known universe","other answers");

$mc2 = new_checkbox_multiple_choice();

$mc2 -> qa (
"Select examples of objects \(S\) where the mass density \(\delta\) is continuous.", 
"The Earth's atmosphere", "glass $BR",               
);

$mc2->extra("an apple","no object in the known universe","other answers");


$mc3 = new_checkbox_multiple_choice();

$mc3 -> qa (
"Select examples of objects \(S\) where the mass density \(\delta\) is continuous on \(S\) aside from a set of zero volume.", 
"an apple $BR",               
);

$mc3->extra("glass", "The Earth's atmosphere","no object in the known universe","other answers");

$mc4 = new_checkbox_multiple_choice();

$mc4 -> qa (
"List examples of objects \(S\) where the mass density \(\delta\) is not continuous anywhere on \(S\).", 
"no object in the known universe $BR",              
);

$mc4->extra("glass","The Earth's atmosphere", "an apple","other answers");

###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
Here you will list physical examples of objects S \(\subseteq \mathbb{R}^3\) with a mass density function \(\delta : S → [0, \infty)\) that satisfies the given property. These examples will help you interpret these mathematical properties from
a physical viewpoint.

$BR
$BR
\{ $mc -> print_q() \}
\{ $mc -> print_a() \}
$BR
\{ $mc2 -> print_q() \}
\{ $mc2 -> print_a() \}
$BR
\{ $mc3 -> print_q() \}
\{ $mc3 -> print_a() \}
$BR
\{ $mc4 -> print_q() \}
\{ $mc4 -> print_a() \}
END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );
ANS( checkbox_cmp( $mc3->correct_ans() ) );
ANS( checkbox_cmp( $mc4->correct_ans() ) );


############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $mc->correct_ans() \}
The correct answer is \{ $mc2->correct_ans() \}
The correct answer is \{ $mc3->correct_ans() \}
The correct answer is \{ $mc4->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT();
