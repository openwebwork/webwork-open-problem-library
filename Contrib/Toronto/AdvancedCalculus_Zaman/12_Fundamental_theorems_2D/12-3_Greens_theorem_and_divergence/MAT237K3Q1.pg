##DESCRIPTION
## MAT237 K3 Q1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','fundamental theorems','green’s theorem','divergence',)

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Green’s theorem and divergence')
## Institution('University of Toronto')
## Section1('K3')
## Problem1('1')



###########################
#  Initialization

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserRadioButtons.pl",
  "PGML.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup

Context("Numeric");
#K3 Q1.1
$radio1 = RadioButtons(
 ["A","B","C","D"],
  "C", # correct answer
  last => ["A","B","C","D"], # can be a list
);

##K3 Q1.2
$radio2 = RadioButtons(
 ["A","B","C","D"],
  "A", # correct answer
  last => ["A","B","C","D"], # can be a list
);


###########################
#  Main text

BEGIN_TEXT
The vectors \( A,B,C,D \) below are unit vectors which are normal or tangent to the oriented curve \( \gamma \). $BR 
\{ image( "k3-normals.png", width=>250, height=>250 ) \}
$BR
1. If \( \gamma\) is oriented so that \( B \) is its unit tangent vector  then which vector is its unit normal?
END_TEXT

BEGIN_PGML
[@ $radio1->buttons() @]*
END_PGML

BEGIN_TEXT
$BR
2. If \( \gamma\) is oriented so that \( D \) is its unit tangent vector  then which vector is its unit normal?
END_TEXT

BEGIN_PGML
[@ $radio2->buttons() @]*
END_PGML

############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio1->cmp() );
ANS( $radio2->cmp() );



############################
#  Solution

BEGIN_PGML_SOLUTION
1. The correct answer is [$radio1->correct_ans()]. 

2. The correct answer is [$radio2->correct_ans()].



END_PGML_SOLUTION

COMMENT('MathObject version. Uses PGML.');

ENDDOCUMENT();