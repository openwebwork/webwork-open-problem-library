###########################
#  Initialization

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserRadioButtons.pl",
  "PGML.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup

Context("Numeric");
##K3 Q2.1
$radio1 = RadioButtons(
  ["Outward", "Inward", "Not enough information to decide"],
  "Outward", # correct answer
  last => ["Outward", "Inward", "Not enough information to decide"], # can be a list
);

##K3 Q2.2
$radio2 = RadioButtons(
  ["Outward", "Inward", "Not enough information to decide"],
  "Inward", # correct answer
  last => ["Outward", "Inward", "Not enough information to decide"],, # can be a list
);

##K3 Q2.3
$radio3 = RadioButtons(
  ["Outward", "Inward", "Not enough information to decide"],
  "Inward", # correct answer
  last => ["Outward", "Inward", "Not enough information to decide"],, # can be a list
);

##K3 Q2.4
$radio4 = RadioButtons(
  ["Outward", "Inward", "Not enough information to decide"],
  "Outward", # correct answer
  last => ["Outward", "Inward", "Not enough information to decide"],, # can be a list
);

##K3 Q2.5
$radio5 = RadioButtons(
  ["Outward", "Inward", "Not enough information to decide"],
  "Inward", # correct answer
  last => ["Outward", "Inward", "Not enough information to decide"],, # can be a list
);

##K3 Q2.6
$radio6 = RadioButtons(
  ["Outward", "Inward", "Not enough information to decide"],
  "Outward", # correct answer
  last => ["Outward", "Inward", "Not enough information to decide"],, # can be a list
);

###########################
#  Main text

BEGIN_TEXT
Let  \( F:  \mathbb{R}^2 \to \mathbb{R}^2 \) be a \( C^1 \) vector field and let  \( R \subseteq \mathbb{R}^2 \) be a regular region whose boundary \( C = \partial R \) is a positively oriented piecewise curve. Each expression either equals the outward flux of \( F \) through \( C \), or the inward flux of \( F \) through \( C \), or there is not enough information to decide. Identify each of them. $BR $BR


1. \[ \oint_C (F \cdot n) ds \]
END_TEXT

BEGIN_PGML
[@ $radio1->buttons() @]*
END_PGML

BEGIN_TEXT
2. \[ -\oint_C (F \cdot n) ds \]
END_TEXT

BEGIN_PGML
[@ $radio2->buttons() @]*
END_PGML

BEGIN_TEXT
3. \[ \oint_{-C} (F \cdot n) ds \]
END_TEXT

BEGIN_PGML
[@ $radio3->buttons() @]*
END_PGML

BEGIN_TEXT
4. \[  \iint_R \text{div}(F) dA \]
END_TEXT

BEGIN_PGML
[@ $radio4->buttons() @]*
END_PGML

BEGIN_TEXT
5. \[  -\iint_R \text{div}(F) dA \]
END_TEXT

BEGIN_PGML
[@ $radio5->buttons() @]*
END_PGML

BEGIN_TEXT
6. \[ -\oint_{-C} (F \cdot n) ds \]
END_TEXT

BEGIN_PGML
[@ $radio6->buttons() @]*
END_PGML

############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio1->cmp() );
ANS( $radio2->cmp() );
ANS( $radio3->cmp() );
ANS( $radio4->cmp() );
ANS( $radio5->cmp() );
ANS( $radio6->cmp() );


