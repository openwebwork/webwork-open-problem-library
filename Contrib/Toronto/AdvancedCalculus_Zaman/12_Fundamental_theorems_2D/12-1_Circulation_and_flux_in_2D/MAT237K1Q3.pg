###########################
#  Initialization

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserRadioButtons.pl",
  "PGML.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup

Context("Numeric");
##K1 Q3.1
$radio1 = RadioButtons(
  ["Positive","Negative","Zero"],
  "Positive", # correct answer
  last => ["Positive","Negative","Zero"], # can be a list
);

##K1 Q3.1
$radio2 = RadioButtons(
 ["Positive","Negative","Zero"],
  "Negative", # correct answer
  last => ["Positive","Negative","Zero"], # can be a list # can be a list
);

##K1 Q3.1
$radio3 = RadioButtons(
  ["Positive","Negative","Zero"],
  "Zero", # correct answer
  last => ["Positive","Negative","Zero"], # can be a list
);

##K1 Q3.1
$radio4 = RadioButtons(
  ["Positive","Negative","Zero"],
  "Negative", # correct answer
  last => ["Positive","Negative","Zero"], # can be a list
);

##K1 Q3.3
$radio5 = RadioButtons(
  ["Positive","Negative","Zero"],
  "Positive", # correct answer
  last => ["Positive","Negative","Zero"], # can be a list
);


###########################
#  Main text

BEGIN_TEXT
Consider the \( \mathbb{R}^2 \) vector field \( F(x,y) = (x^2 + y^2 - 10, xy). \) $BR $BR
\{ image( "k1-curl-3.png", width=>400, height=>400) \} 

$BR $BR
1. Without calculating, what is the sign of the curl at each point? Remember curl is circulation density.
 $BR

a) \( (-2,-2) \)
END_TEXT

BEGIN_PGML
[@ $radio1->buttons() @]*
END_PGML

BEGIN_TEXT
$BR
b) \( (-2,3) \)
END_TEXT

BEGIN_PGML
[@ $radio2->buttons() @]*
END_PGML

BEGIN_TEXT
$BR
c)  \( (4,0) \)
END_TEXT

BEGIN_PGML
[@ $radio3->buttons() @]*
END_PGML

BEGIN_TEXT
$BR
d) \( (0,5) \) 
END_TEXT

BEGIN_PGML
[@ $radio4->buttons() @]*
END_PGML

BEGIN_TEXT
$BR
2. Is the work done by \( F \) along the straight line from \( (3,-2) \) to \( (3,-4) \) positive negative, or zero? No calculating.
END_TEXT

BEGIN_PGML
[@ $radio5->buttons() @]*
END_PGML


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio1->cmp() );
ANS( $radio2->cmp() );
ANS( $radio3->cmp() );
ANS( $radio4->cmp() );
ANS( $radio5->cmp() );

