## MAT237 K1 Q7
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','fundamental theorems','circulation','flux')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Conservative vector fields')
## Institution('University of Toronto')
## Section1('K1')
## Problem1('7')

###########################
#  Initialization

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserRadioButtons.pl",
  "PGML.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup

Context("Numeric");
##K1 Q7.1
$radio1 = RadioButtons(
  ["Irrotational", "Sourceless", "Both", "Neither"],
  "Both", # correct answer
  last => ["Irrotational", "Sourceless", "Both", "Neither"], # can be a list
);

##K1 Q7.2
$radio2 = RadioButtons(
  ["Irrotational", "Sourceless", "Both", "Neither"],
  "Irrotational", # correct answer
  last => ["Irrotational", "Sourceless", "Both", "Neither"], # can be a list
);

##K3 Q7.3
$radio3 = RadioButtons(
  ["Irrotational", "Sourceless", "Both", "Neither"],
  "Sourceless", # correct answer
  last => ["Irrotational", "Sourceless", "Both", "Neither"], # can be a list
);

##K1 Q7.4
$radio4 = RadioButtons(
  ["Irrotational", "Sourceless", "Both", "Neither"],
  "Both", # correct answer
  last => ["Irrotational", "Sourceless", "Both", "Neither"], # can be a list
);

##K1 Q7.5
$radio5 = RadioButtons(
  ["Irrotational", "Sourceless", "Both", "Neither"],
  "Irrotational", # correct answer
  last => ["Irrotational", "Sourceless", "Both", "Neither"], # can be a list
);

##K1 Q7.6
$radio6 = RadioButtons(
  ["Irrotational", "Sourceless", "Both", "Neither"],
  "Sourceless", # correct answer
  last => ["Irrotational", "Sourceless", "Both", "Neither"], # can be a list
);

##K1 Q7.7
$radio7 = RadioButtons(
  ["Irrotational", "Sourceless", "Both", "Neither"],
  "Both", # correct answer
  last => ["Irrotational", "Sourceless", "Both", "Neither"], # can be a list
);

##K1 Q7.8
$radio8 = RadioButtons(
  ["Irrotational", "Sourceless", "Both", "Neither"],
  "Neither", # correct answer
  last => ["Irrotational", "Sourceless", "Both", "Neither"], # can be a list
);


###########################
#  Main text

BEGIN_TEXT
Identify which vector fields in \(  \mathbb{R}^2 \) are irrotational, sourceless, both, or neither. Do not guess an equation.
$BR $BR


1. \{ image( "k1-vec-field-11.png", width=>250, height=>250 ) \}
END_TEXT

BEGIN_PGML
[@ $radio1->buttons() @]*
END_PGML

BEGIN_TEXT
2. \{ image( "k1-vec-field-xy.png", width=>250, height=>250 ) \}
END_TEXT

BEGIN_PGML
[@ $radio2->buttons() @]*
END_PGML

BEGIN_TEXT
3. \{ image( "k1-vec-field-negative-yx.png", width=>250, height=>250 ) \}
END_TEXT

BEGIN_PGML
[@ $radio3->buttons() @]*
END_PGML

BEGIN_TEXT
4. \{ image( "k1-vec-field-x-negative-y.png", width=>250, height=>250 ) \}
END_TEXT

BEGIN_PGML
[@ $radio4->buttons() @]*
END_PGML

BEGIN_TEXT
5. \{ image( "k1-vec-field-x0.png", width=>250, height=>250 ) \}
END_TEXT

BEGIN_PGML
[@ $radio5->buttons() @]*
END_PGML

BEGIN_TEXT
6. \{ image( "k1-vec-field-y0.png", width=>250, height=>250 ) \}
END_TEXT

BEGIN_PGML
[@ $radio6->buttons() @]*
END_PGML

BEGIN_TEXT
7. \{ image( "k1-vec-field-yx.png", width=>250, height=>250 ) \}
END_TEXT

BEGIN_PGML
[@ $radio7->buttons() @]*
END_PGML

BEGIN_TEXT
8. \{ image( "k1-vec-field-x_y0.png", width=>250, height=>250 ) \}
END_TEXT

BEGIN_PGML
[@ $radio8->buttons() @]*
END_PGML

############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio1->cmp() );
ANS( $radio2->cmp() );
ANS( $radio3->cmp() );
ANS( $radio4->cmp() );
ANS( $radio5->cmp() );
ANS( $radio6->cmp() );
ANS( $radio7->cmp() );
ANS( $radio8->cmp() );


############################
#  Solution



COMMENT('MathObject version. Uses PGML.');

ENDDOCUMENT();