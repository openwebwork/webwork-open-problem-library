###########################
#  Initialization

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserRadioButtons.pl",
  "PGML.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup

Context("Numeric");
##K1 Q6.1
$radio1 = RadioButtons(
  ["Positive","Negative","Zero"],
  "Positive", # correct answer
  last => ["Positive","Negative","Zero"], # can be a list
);

##K1 Q6.1
$radio2 = RadioButtons(
 ["Positive","Negative","Zero"],
  "Negative", # correct answer
  last => ["Positive","Negative","Zero"], # can be a list # can be a list
);

##K1 Q6.1
$radio3 = RadioButtons(
  ["Positive","Negative","Zero"],
  "Positive", # correct answer
  last => ["Positive","Negative","Zero"], # can be a list
);

##K1 Q6.2
$radio4 = RadioButtons(
  ["Source","Sink","Neither"],
  "Source", # correct answer
  last => ["Source","Sink","Neither"], # can be a list
);




###########################
#  Main text

BEGIN_TEXT
Consider the \( \mathbb{R}^2 \) vector field \( F(x,y) = ( x^2 - y^2 - 4, xy)\). $BR $BR
\{ image( "k1-div-3.png", width=>400, height=>400) \} 

$BR $BR
1. Without calculating, what is the sign of the flux across each given closed curve?
 $BR

a) \( C_1 \) is the counterclockwise oriented circle of radius 2 centered at \( (2,0) \).
END_TEXT

BEGIN_PGML
[@ $radio1->buttons() @]*
END_PGML

BEGIN_TEXT
$BR
b) \( C_2 \) is the counterclockwise oriented circle of radius 2 centered at \( (-2,0) \).
END_TEXT

BEGIN_PGML
[@ $radio2->buttons() @]*
END_PGML

BEGIN_TEXT
$BR
c)  \( C_3 \) is the counterclockwise oriented square with vertices \( (1,1), (1,3), (3,3), (3,1) \).
END_TEXT

BEGIN_PGML
[@ $radio3->buttons() @]*
END_PGML

BEGIN_TEXT
$BR
2. Determine whether \( (2,2) \) is a source, a sink, or neither.
END_TEXT

BEGIN_PGML
[@ $radio4->buttons() @]*
END_PGML


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio1->cmp() );
ANS( $radio2->cmp() );
ANS( $radio3->cmp() );
ANS( $radio4->cmp() );


############################
#  Solution



COMMENT('MathObject version. Uses PGML.');

ENDDOCUMENT();