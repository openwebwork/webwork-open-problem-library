##DESCRIPTION
## MAT237 K1 Q1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','fundamental theorems','circulation','flux')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Conservative vector fields')
## Institution('University of Toronto')
## Section1('K1')
## Problem1('1')

###########################
#  Initialization

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserRadioButtons.pl",
  "PGML.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup

Context("Numeric");
##K1 Q1.1
$radio1 = RadioButtons(
  ["Irrotational", "Sourceless", "Both", "Neither"],
  "Irrotational", # correct answer
  last => ["Irrotational", "Sourceless", "Both", "Neither"], # can be a list
);

##K1 Q1.2
$radio2 = RadioButtons(
  ["Irrotational", "Sourceless", "Both", "Neither"],
  "Sourceless", # correct answer
  last => ["Irrotational", "Sourceless", "Both", "Neither"], # can be a list
);

##K3 Q1.3
$radio3 = RadioButtons(
  ["Irrotational", "Sourceless", "Both", "Neither"],
  "Both", # correct answer
  last => ["Irrotational", "Sourceless", "Both", "Neither"], # can be a list
);

##K1 Q1.4
$radio4 = RadioButtons(
  ["Irrotational", "Sourceless", "Both", "Neither"],
  "Irrotational", # correct answer
  last => ["Irrotational", "Sourceless", "Both", "Neither"], # can be a list
);

##K1 Q1.5
$radio5 = RadioButtons(
  ["Irrotational", "Sourceless", "Both", "Neither"],
  "Sourceless", # correct answer
  last => ["Irrotational", "Sourceless", "Both", "Neither"], # can be a list
);

##K1 Q1.6
$radio6 = RadioButtons(
  ["Irrotational", "Sourceless", "Both", "Neither"],
  "Both", # correct answer
  last => ["Irrotational", "Sourceless", "Both", "Neither"], # can be a list
);

##K1 Q1.7
$radio7 = RadioButtons(
  ["Irrotational", "Sourceless", "Both", "Neither"],
  "Both", # correct answer
  last => ["Irrotational", "Sourceless", "Both", "Neither"], # can be a list
);

##K1 Q1.8
$radio8 = RadioButtons(
  ["Irrotational", "Sourceless", "Both", "Neither"],
  "Neither", # correct answer
  last => ["Irrotational", "Sourceless", "Both", "Neither"], # can be a list
);


###########################
#  Main text

BEGIN_TEXT
A vector field \( F \) in \(  \mathbb{R}^2 \) is \( \textbf{irrotational} \) (or curl-free) if \( \text{curl}(F ) = 0 \) everywhere on its domain.
A vector field  \( F \) in \(  \mathbb{R}^2 \) is \( \textbf{sourceless} \) (or divergence-free) if \( \text{div}(F ) = 0 \) everywhere on its domain.
Identify which of the following vector fields in \(  \mathbb{R}^2 \) are irrotational, sourceless, both, or neither. $BR $BR


1. \( F_1(x, y) = (x, 0) \)
END_TEXT

BEGIN_PGML
[@ $radio1->buttons() @]*
END_PGML

BEGIN_TEXT
2. \( F_2(x, y) = (y, 0) \)
END_TEXT

BEGIN_PGML
[@ $radio2->buttons() @]*
END_PGML

BEGIN_TEXT
3. \( F_3(x, y) = (x, -y) \)
END_TEXT

BEGIN_PGML
[@ $radio3->buttons() @]*
END_PGML

BEGIN_TEXT
4. \( F_4(x, y) = (x, y) \)
END_TEXT

BEGIN_PGML
[@ $radio4->buttons() @]*
END_PGML

BEGIN_TEXT
5. \( F_5(x, y) = (-y, x) \)
END_TEXT

BEGIN_PGML
[@ $radio5->buttons() @]*
END_PGML

BEGIN_TEXT
6. \( F_6(x, y) = (y, x) \)
END_TEXT

BEGIN_PGML
[@ $radio6->buttons() @]*
END_PGML

BEGIN_TEXT
7. \( F_7(x, y) = (1, 1) \)
END_TEXT

BEGIN_PGML
[@ $radio7->buttons() @]*
END_PGML

BEGIN_TEXT
8. \( F_8(x, y) = (x+y, 0) \)
END_TEXT

BEGIN_PGML
[@ $radio8->buttons() @]*
END_PGML

############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio1->cmp() );
ANS( $radio2->cmp() );
ANS( $radio3->cmp() );
ANS( $radio4->cmp() );
ANS( $radio5->cmp() );
ANS( $radio6->cmp() );
ANS( $radio7->cmp() );
ANS( $radio8->cmp() );


############################
#  Solution

BEGIN_PGML_SOLUTION
The correct answer is [$radio1->correct_ans()]. 

The correct answer is [$radio2->correct_ans()].

The correct answer is [$radio3->correct_ans()]. 

The correct answer is [$radio4->correct_ans()]. 

The correct answer is [$radio5->correct_ans()]. 

The correct answer is [$radio6->correct_ans()]. 

The correct answer is [$radio7->correct_ans()]. 

The correct answer is [$radio8->correct_ans()]. 
END_PGML_SOLUTION

COMMENT('MathObject version. Uses PGML.');

ENDDOCUMENT();