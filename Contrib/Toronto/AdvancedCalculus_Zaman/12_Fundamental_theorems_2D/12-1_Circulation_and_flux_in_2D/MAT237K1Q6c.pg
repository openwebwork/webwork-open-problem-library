Context("Numeric");

$q1 = Compute("16"); #K1 Q6.3




##############################################################
#
#  Text
#
#

Context()->texStrings;
BEGIN_TEXT
Consider the \( \mathbb{R}^2 \) vector field \( F(x,y) = ( x^2 - y^2 - 4, xy). \) $BR $BR
\{ image( "k1-div-3.png", width=>400, height=>400) \} 

$BR $BR
Let \( R = \lbrace x^2 + y^2 \leq 4, x \geq 0\rbrace \) be the solid right half semicircle of radius 2.  Let \( C = \partial R \) be the counterclockwise oriented boundary. Thus, \( C \) is a closed curve.  Calculate the flux of \( F \) across \( C \).

$BR
\{$q1->ans_rule\}

END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

ANS($q1->with(tolerance=>.015)->cmp);


# default tolerance is .01 or one percent.


ENDDOCUMENT();