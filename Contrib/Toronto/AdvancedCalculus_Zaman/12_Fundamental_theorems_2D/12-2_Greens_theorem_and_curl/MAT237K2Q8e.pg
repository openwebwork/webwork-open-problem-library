$showPartialCorrectAnswers = 1;

##############################################################
#
#  Setup
#
#
Context("Numeric");

$q1 = Compute("3pi/8"); #K2 Q8.5



##############################################################
#
#  Text
#
#

Context()->texStrings;
BEGIN_TEXT
Find the area of the region bounded by the hypocycloid \( \gamma(t) = ( \cos^3 t, \sin^3 t) \) for \( 0 \leq t \leq 2\pi \). You may give an exact answer or round to two decimal places.  $BR

\{$q1->ans_rule\}




END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

ANS($q1->with(tolerance=>.01)->cmp);


# default tolerance is .01 or one percent.


ENDDOCUMENT();        