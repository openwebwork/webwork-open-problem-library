# Print problem number and point value (weight) for the problem
TEXT(beginproblem());

# Show which answers are correct and which ones are incorrect
$showPartialCorrectAnswers = 1;

##############################################################
#
#  Setup
#
#
Context("Numeric");

$q1 = Compute("2-((pi^2)/2)"); #K2 Q8.3



##############################################################
#
#  Text
#
#

Context()->texStrings;
BEGIN_TEXT
Use Green's theorem to determine the work done by \( F(x,y) = (x-y,y) \) to push a particle  along the curve \( y=\sin(x) \) from \( (\pi,0) \) to \( (0,0)\). \(\textit{Hint:}\) Move the curve to the \(x\)-axis.
 You may give an exact answer or round to two decimal places.  $BR

\{$q1->ans_rule\}




END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

ANS($q1->with(tolerance=>.01)->cmp);


# default tolerance is .01 or one percent.


ENDDOCUMENT();