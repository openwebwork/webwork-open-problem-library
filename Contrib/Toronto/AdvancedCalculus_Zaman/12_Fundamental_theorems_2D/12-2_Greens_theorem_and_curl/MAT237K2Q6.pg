##DESCRIPTION
## MAT237 K2 Q6
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','fundamental theorems','green’s theorem','curl',)

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Green’s theorem and curl')
## Institution('University of Toronto')
## Section1('K2')
## Problem1('6')



###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup


## Question K2 Q6.1
$mc1 = new_checkbox_multiple_choice();
$mc1 -> qa (
"Which of the 4 pieces \( R_1,R_2,R_3,R_4 \) are \( x\)-simple?", 
"\( R_1\)",
"\( R_2 \)",
"\( R_3 \)",
"\( R_4 \)"
);
$mc1->makeLast("\( R_1\)",
"\( R_2 \)",
"\( R_3 \)",
"\( R_4 \)"
);

## Question K2 Q6.2
$mc2 = new_checkbox_multiple_choice();
$mc2 -> qa (
"Which of the 4 pieces \( R_1,R_2,R_3,R_4 \) are \( y\)-simple?", 
"\( R_1\)",
"\( R_2 \)",
"\( R_3 \)"
);
$mc2->makeLast("\( R_1\)",
"\( R_2 \)",
"\( R_3 \)",
"\( R_4 \)"
);

###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
The  proof of Green's theorem in your readings was incomplete so, alas, your heart must be broken. It only proves the case  for regions which are \( \textbf{both } x\)-simple and \(y\)-simple. The remaining ideas are illustrated in this example with your heart \(R \subseteq \mathbb{R}^2 \) which has been broken into 4 pieces. Putting together the pieces will complete both your heart and the remaining ideas behind the proof.
$BR
\{ image( "k2-heart.jpg", width=>250, height=>250) \}
$BR
\{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}
$BR
\{ $mc2 -> print_q() \}
\{ $mc2 -> print_a() \}
END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );



############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answers are \{ $mc1->correct_ans() \} $BR
The correct answers are \{ $mc2->correct_ans() \} $BR

END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT();    