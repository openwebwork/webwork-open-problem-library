DOCUMENT();      

loadMacros(
   "PGstandard.pl",     # Standard macros for PG language
   "MathObjects.pl",
   #"source.pl",        # allows code to be displayed on certain sites.
   #"PGcourse.pl",      # Customization file for the course
);

# Print problem number and point value (weight) for the problem
TEXT(beginproblem());

# Show which answers are correct and which ones are incorrect
$showPartialCorrectAnswers = 1;

##############################################################
#
#  Setup
#
#
Context("Numeric");

$q1 = Compute("1/6"); #K2 Q8.1



##############################################################
#
#  Text
#
#

Context()->texStrings;
BEGIN_TEXT
Let \( R \) be the region bounded by \( y=x \) and \( y=x^2 \) and  positively orient its boundary \( C = \partial R \). Calculate \[ \oint_C (y+e^x) dx + (2x^2+ \cos y) dy. \] You may give an exact answer or round to two decimal places.  $BR

\{$q1->ans_rule\}




END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

ANS($q1->with(tolerance=>.04)->cmp);


# default tolerance is .01 or one percent.


ENDDOCUMENT();        