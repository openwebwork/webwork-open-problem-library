##DESCRIPTION
## MAT237 K2 Q1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','fundamental theorems','green’s theorem','curl',)

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Green’s theorem and curl')
## Institution('University of Toronto')
## Section1('K2')
## Problem1('1')


###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup


## Question K2 Q1
$mc1 = new_checkbox_multiple_choice();
$mc1 -> qa (
"Which of the following are regular regions in \( \mathbb{R}^2 \)?", 
"\( \lbrace (x, y) \in \mathbb{R}^2 : x^2 + y^2 \leq 2 \rbrace \)", 
"\( \lbrace (x, y) \in \mathbb{R}^2 : 1 \leq x^2 + y^2 \leq 2 \rbrace \)", 
"\( [-1,1]^2 \cup [2,4]^2 \)",
"\( [-1,1]^2 \cup \overline{B_1(2,0)} \)",
);
$mc1->makeLast("\( \lbrace (x, y) \in \mathbb{R}^2 : x^2 + y^2 \leq 2 \rbrace \)", 
"\( \lbrace (x, y) \in \mathbb{R}^2 : x^2 + y^2 < 2 \rbrace \)", 
"\( \lbrace (x, y) \in \mathbb{R}^2 : 1 \leq x^2 + y^2 \leq 2 \rbrace \)", 
"\( \mathbb{R}^2 \)",
"\( [-1,1]^2 \cup [2,4]^2 \)",
"\( [-1,1]^2 \cup \lbrace (2,0) \rbrace \)",
"\( [-1,1]^2 \cup \lbrace (x,0): 1 \leq x \leq 2 \rbrace \)",
"\( [-1,1]^2 \cup \overline{B_1(2,0)} \)"
);

###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT

\{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}
END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );



############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answers are \{ $mc1->correct_ans() \} $BR

END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT();   