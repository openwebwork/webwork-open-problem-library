## DESCRIPTION
## Higher order derivatives
## ENDDESCRIPTION

## DBsubject('Calculus - multivariable')
## DBchapter('Differentiation of multivariable functions')
## DBsection('Higher order derivatives')

################################################################

DOCUMENT();

loadMacros("PGstandard.pl", "PGchoicemacros.pl", "PGML.pl");

TEXT(beginproblem());

################################################################
#
#  Setup

$mc = new_checkbox_multiple_choice();
$mc -> qa("Which statements are true?",
"If \( f \) is \( C^5 \) then \( \partial^{(2,1,2)} f = \dfrac{\partial^5f}{\partial x\partial z^2 \partial x \partial y} \).",
"If \( \phi \) is \( C^k \) then \( \partial^{\alpha} \phi \) is defined for any multi-index \( \alpha \in \mathbb{N}^n \) up to order \( k \).",
"If \( \phi : \mathbb{R}^n \to \mathbb{R} \) is \( C^2 \) and \( a \in \mathbb{R}^n \) then the Hessian \( H\phi(a) = \begin{bmatrix} \partial_i\partial_j \phi (a) \end{bmatrix}_{i,j} \) at \( a \) is an \( n \times n \) symmetric matrix of real numbers.",
"All multivariable polynomials are smooth.");

$mc -> makeLast(
"If \( f \) is \( C^5 \) then \( \partial^{(2,1,2)} f = \dfrac{\partial^5f}{\partial x\partial z^2 \partial x \partial y} \).",
"If \( f \) is \( C^5 \) then \( \partial^{(2,2,1)} f = \partial^{(1,2,2)}f \).",
"If \( f \) is \( C^7 \) then \( \partial^{(4,3)} f \) is a partial derivative of order \( 7 \).",
"If \( \phi \) is \( C^k \) then \( \partial^{\alpha} \phi \) is defined for any multi-index \( \alpha \in \mathbb{N}^n \) up to order \( k \).",
"If \( \phi : \mathbb{R}^n \to \mathbb{R} \) is \( C^2 \) and \( a \in \mathbb{R}^n \) then the Hessian \( H\phi(a) = \begin{bmatrix} \partial_i\partial_j \phi (a) \end{bmatrix}_{i,j} \) at \( a \) is an \( n \times n \) symmetric matrix of real numbers.",
"All multivariable polynomials are smooth.");

################################################################
#
#  Text

BEGIN_PGML


Let [` f: \mathbb{R}^3 \to \mathbb{R} `] and let [` \phi : \mathbb{R}^n \to \mathbb{R} `]. [@$mc -> print_q()@]*

[@$mc -> print_a()@]*
END_PGML

################################################################
#
#  Answers

$showPartialCorrectAnswers = 0;
ANS( checkbox_cmp($mc->correct_ans()) );

ENDDOCUMENT();