##DESCRIPTION
## Mean value theorem problem, MAT237 F1 worksheet 3.1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'mean value theorem')

## DBsubject('Multivariable Calculus')
## DBchapter('Approximations')
## DBsection('Mean value theorem')
## Date('25/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('F1')
## Problem1('3.1')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
);

TEXT(beginproblem());

Context("Numeric");
#  Setup

$width  = 850;
$height = 110;
$lsize = [$width,$height];  # the size of the Live3D images
$ltsize = 220;       # tex size of the Live3D images

$popup = PopUp(
  ["?","Line 3: MVT cannot be applied on Fi's","Line 3: MVT doesn't guarantee there is a c for all Fi's","Line 4: We cannot conclude the Jacobian form from the gradients"],
  "Line 3: MVT doesn't guarantee there is a c for all Fi's",
);

Context()->texStrings;
BEGIN_TEXT
Here is a guess in a FALSE claim in vector-valued MCT and a sketch of a WRONG proof of this FALSE claim.
$BCENTER
\{image("f1-3.1-wrong-proof.jpg",width=>$width,height=>$height,tex_size=>$ltsize)\}
$ECENTER
Identify the fatal mistake in this proof.
$BR
\{ $popup->menu() \}
END_TEXT
Context()->normalStrings;

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $popup->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();