## DESCRIPTION
## Mean value theorem
## ENDDESCRIPTION

## DBsubject('Calculus - multivariable')
## DBchapter('Differentiation of multivariable functions')
## DBsection('Mean value theorem')

################################################################

DOCUMENT();

loadMacros(
   "PGstandard.pl",     # Standard macros for PG language
   "PGcourse.pl",       # Customization file for the course
   "PGchoicemacros.pl",
   "PGgraders.pl",
   "answerHints.pl",
   #"source.pl",        # Allows code to be displayed on certain sites
);

TEXT(beginproblem());

$showPartialCorrectAnswers = 0;

################################################################
#
#  Setup

$tf = new_select_list();
$tf -> rf_print_q(~~&pop_up_list_print_q);
$tf -> ra_pop_up_list( [ No_answer => "?", "T"=>"True", "F"=>"False"] );
$tf -> qa(
"There exists a \( c \in U \) such that \( f(b)-f(a) = \nabla f(c) \cdot (b-a) \).", "F",
"If \( U \) contains the line segment \( L \) between \( a \) and \( b \) then \( \exists c \in L \) such that \( f(b)-f(a) = \nabla f(c) \cdot (b-a) \).", "T",
"If \( U \) contains the line segment \( L \) between \( a \) and \( b \) then \( \exists c \in L \) such that \( f(b) = f(a)+Df(c)(b-a) \).", "T",
"If \( U \) contains the line segment \( L \) between \( a \) and \( b \) then \( \exists c \in L \) such that \( F(b)-F(a) = DF(c)(b-a) \).", "F",
);

$tf -> choose(4);

################################################################
#
#  Text

BEGIN_TEXT
$BR
Fix \( U \subseteq \mathbb{R}^n \) open. Let \( a, b \in U \). Let \( f: U \to \mathbb{R} \) and \(F: U \to \mathbb{R}^m \) be differentiable. Which of the following are true or false?
$BR
\{ $tf->print_q() \}
END_TEXT

$showHint = 1;
BEGIN_HINT
Carefully examine the statement of the mean value theorem. Remember the Jacobian of a real-valued function is the transpose of its gradient.
END_HINT

################################################################
#
#  Answers

install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4];
$ENV{'grader_scores'} = [0.25,0.5,0.75,1];
$ENV{'grader_message'} = "You can earn 25% partial credit for 1 correct answer, 50% partial credit for 2 correct answers, and 75% partial credit for 3 correct answers.";

$showPartialCorrectAnswers = 0;
ANS(str_cmp($tf->ra_correct_ans));

ENDDOCUMENT();