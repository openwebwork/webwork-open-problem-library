##DESCRIPTION
## Second order derivatives problem, MAT237 F1 worksheet Q6
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'second order derivatives’)

## DBsubject('Multivariable Calculus')
## DBchapter('Approximations')
## DBsection('Second order derivatives and the Hessian')
## Date('22/6/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('F1')
## Problem1('6')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
"PGgraders.pl",
"LiveGraphics3D.pl",
"unionLists.pl",
);

TEXT(beginproblem());

Context("Numeric");

$width  = 500;
$height = 250;
$lsize = [$width,$height];  # the size of the Live3D images
$ltsize = 220;       # tex size of the Live3D images

$popup1 = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Zero",
);

$popup2 = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Zero",
);

$popup3 = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Zero",
);

$popup4 = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Zero",
);

$popup5 = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Positive",
);

$popup6 = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Negative",
);

$popup7 = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Positive",
);

$popup8 = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Positive",
);

Context()->texStrings;
BEGIN_TEXT
Below are gradient vector fields of \( f:\mathbb{R}^2\to\mathbb{R} \) (on the left) and \( g: \mathbb{R}^2\to\mathbb{R} \) (on the right). Both functions are \(C^2\).
$BCENTER
\{image("f1-vector-fields.jpg",width=>$width,height=>$height,tex_size=>$ltsize)\}
$ECENTER
If possible, determine whether these derivatives at the origin \((0,0)\) are positive, negative, or zero.

\{ BeginList('OL', type=>'A') \}

$ITEM \( f_x(0,0) \)
\{ $popup1->menu() \}

$ITEMSEP
$ITEM \( f_y(0,0) \)
\{ $popup2->menu() \}

$ITEMSEP
$ITEM \( g_x(0,0) \)
\{ $popup3->menu() \}

$ITEMSEP
$ITEM \( g_y(0,0) \)
\{ $popup4->menu() \}

$ITEMSEP
$ITEM \( f_{xx}(0,0) \)
\{ $popup5->menu() \}

$ITEMSEP
$ITEM \( f_{yy}(0,0) \)
\{ $popup6->menu() \}

$ITEMSEP
$ITEM \( g_{xx}(0,0) \)
\{ $popup7->menu() \}

$ITEMSEP
$ITEM \( g_{yy}(0,0) \)
\{ $popup8->menu() \}

\{ EndList('OL') \}

END_TEXT

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4,5,6,7];
$ENV{'grader_scores'} = [0.14,0.28,0.51,0.65,0.78,0.86,1];
$ENV{'grader_message'} = "You can earn partial credits.";

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );
ANS( $popup4->cmp() );
ANS( $popup5->cmp() );
ANS( $popup6->cmp() );
ANS( $popup7->cmp() );
ANS( $popup8->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup1->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();