##DESCRIPTION
## Second order derivatives problem, MAT237 F1 worksheet Q6
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'second order derivatives’)

## DBsubject('Multivariable Calculus')
## DBchapter('Approximations')
## DBsection('Second order derivatives and the Hessian')
## Date('22/6/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('F1')
## Problem1('6')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
"PGgraders.pl",
"LiveGraphics3D.pl",
"unionLists.pl",
);

TEXT(beginproblem());

Context("Numeric");

$width  = 250;
$height = 250;
$lsize = [$width,$height];  # the size of the Live3D images
$ltsize = 220;       # tex size of the Live3D images

# 6.1
$popup1 = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Negative",
);
# 6.2a
$popup2 = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Positive",
);
# 6.2b
$popup3 = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Negative",
);
# 6.3a
$popup4 = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Positive",
);
# 6.3b
$popup5 = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Positive",
);
# 6.3c
$popup6 = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Negative",
);
# 6.3d
$popup7 = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Negative",
);

Context()->texStrings;
BEGIN_TEXT
Below is a contour plot of the function \( f:\mathbb{R}^2\to\mathbb{R} \) and a point \( a\in\mathbb{R}^2 \).
$BCENTER
\{image("f1-contour.jpg",width=>$width,height=>$height,tex_size=>$ltsize)\}
$ECENTER
If possible, determine whether the following quantities are positive, negative, or zero.

\{ BeginList('OL', type=>'A') \}

$ITEM \( f(a) \)
\{ $popup1->menu() \}

$ITEMSEP
$ITEM \( \frac{\partial f}{\partial x}(a) \)
\{ $popup2->menu() \}

$ITEMSEP
$ITEM \( \frac{\partial f}{\partial y}(a) \)
\{ $popup3->menu() \}

$ITEMSEP
$ITEM \( \frac{\partial^2 f}{\partial x^2}(a) \)
\{ $popup4->menu() \}

$ITEMSEP
$ITEM \( \frac{\partial^2 f}{\partial y^2}(a) \)
\{ $popup5->menu() \}

$ITEMSEP
$ITEM \( \frac{\partial^2 f}{\partial x\partial y}(a) \)
\{ $popup6->menu() \}

$ITEMSEP
$ITEM \( \frac{\partial^2 f}{\partial y\partial x}(a) \)
\{ $popup7->menu() \}

\{ EndList('OL') \}

END_TEXT

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4,5,6,7];
$ENV{'grader_scores'} = [0.14,0.28,0.51,0.65,0.78,0.86,1];
$ENV{'grader_message'} = "You can earn partial credits.";

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );
ANS( $popup4->cmp() );
ANS( $popup5->cmp() );
ANS( $popup6->cmp() );
ANS( $popup7->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup1->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();