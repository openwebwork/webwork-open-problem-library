DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
"PGgraders.pl",
"LiveGraphics3D.pl",
"unionLists.pl",
);

TEXT(beginproblem());

Context("Numeric");

Context()->texStrings;
BEGIN_TEXT
Define 
\( f(x)=\begin{cases}
			\frac{xy(x^2-y^2)}{x^2+y^2}, & (x,y)\neq0\\
            0, & (x,y)=0
		 \end{cases}\)
Compute the following quantities from the definition. How do these computations relate to Clairaut's theorem?
\{ BeginList('OL', type=>'A') \}

$ITEM \( \partial_1 f(0,0) \) \{ ans_rule(3) \}

$ITEMSEP 
$ITEM \( \partial_2 f(0,0) \) \{ ans_rule(3) \}

$ITEMSEP 
$ITEM \( \partial_2\partial_1 f(0,0) \) \{ ans_rule(3) \}

$ITEMSEP 
$ITEM \( \partial_1\partial_2 f(0,0) \) \{ ans_rule(3) \}

\{ EndList('OL') \}
END_TEXT

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4];
$ENV{'grader_scores'} = [0.25,0.5,0.75,1];
$ENV{'grader_message'} = "You can earn partial credits.";

ANS( num_cmp(0) );
ANS( num_cmp(0) );
ANS( num_cmp(1) );
ANS( num_cmp(0) );

Context()->texStrings;
BEGIN_SOLUTION
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();