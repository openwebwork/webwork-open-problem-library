##DESCRIPTION
## Second order derivatives problem, MAT237 F1 worksheet Q8
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'second order derivatives’)

## DBsubject('Multivariable Calculus')
## DBchapter('Approximations')
## DBsection('Second order derivatives and the Hessian')
## Date('25/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('F1')
## Problem1('8')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
"PGgraders.pl",
"LiveGraphics3D.pl",
"unionLists.pl",
);

TEXT(beginproblem());

Context("Numeric");

$width  = 700;
$height = 250;
$lsize = [$width,$height];  # the size of the Live3D images
$ltsize = 220;       # tex size of the Live3D images

# 8.1a
$popup1a = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Negative",
);
# 8.1b
$popup1b = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Zero",
);
# 8.2a
$popup2a = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Zero",
);
# 8.2b
$popup2b = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Zero",
);
# 8.2c
$popup2c = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Positive",
);
# 8.2d
$popup2d = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Zero",
);
# 8.3a
$popup3a = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Zero",
);
# 8.3b
$popup3b = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Positive",
);
# 8.3c
$popup3c = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Zero",
);
# 8.3d
$popup3d = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Zero",
);
# 8.4a
$popup4a = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Zero",
);
# 8.4b
$popup4b = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Zero",
);
# 8.4c
$popup4c = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Positive",
);
# 8.4d
$popup4d = PopUp(
  ["?","Positive","Negative","Zero","Cannot Determine"],
  "Positive",
);

Context()->texStrings;
BEGIN_TEXT
Below is a plot of a vibrating string \( h:\mathbb{R}^2\to\mathbb{R} \) given by the \(C^2\) function \( h(x,t) \) for several times \(t\).
$BCENTER
\{image("f1-string.jpg",width=>$width,height=>$height,tex_size=>$ltsize)\}
$ECENTER
Determine whether each value is positive, negative, or zero.

\{ BeginList('OL', type=>'A') \}

$ITEM \( h(0.5,5) \)
\{ $popup1a->menu() \}

$ITEMSEP
$ITEM \( h(1,3) \)
\{ $popup1b->menu() \}

\{ EndList('OL') \}
$BR
Determine whether each first order partial is positive, negative, or zero.

\{ BeginList('OL', type=>'A') \}

$ITEM \( \frac{\partial h}{\partial x}(0.5,5) \)
\{ $popup2a->menu() \}

$ITEMSEP
$ITEM \( \frac{\partial h}{\partial t}(0.5,5) \)
\{ $popup2b->menu() \}

$ITEMSEP
$ITEM \( \frac{\partial h}{\partial x}(1,3) \)
\{ $popup2c->menu() \}

$ITEMSEP
$ITEM \( \frac{\partial h}{\partial t}(1,3) \)
\{ $popup2d->menu() \}

\{ EndList('OL') \}
$BR
Determine whether each pure second order partial is positive, negative, or zero.

\{ BeginList('OL', type=>'A') \}

$ITEM \( \frac{\partial^2 h}{\partial x^2}(0.5,5) \)
\{ $popup3a->menu() \}

$ITEMSEP
$ITEM \( \frac{\partial^2 h}{\partial t^2}(0.5,5) \)
\{ $popup3b->menu() \}

$ITEMSEP
$ITEM \( \frac{\partial^2 h}{\partial x^2}(1,3) \)
\{ $popup3c->menu() \}

$ITEMSEP
$ITEM \( \frac{\partial^2 h}{\partial t^2}(1,3) \)
\{ $popup3d->menu() \}

\{ EndList('OL') \}

Determine whether each mixed second order partial is positive, negative, or zero.

\{ BeginList('OL', type=>'A') \}

$ITEM \( \frac{\partial^2 h}{\partial x\partial t}(0.5,5) \)
\{ $popup4a->menu() \}

$ITEMSEP
$ITEM \( \frac{\partial^2 h}{\partial t\partial x}(0.5,5) \)
\{ $popup4b->menu() \}

$ITEMSEP
$ITEM \( \frac{\partial^2 h}{\partial x\partial t}(1,3) \)
\{ $popup4c->menu() \}

$ITEMSEP
$ITEM \( \frac{\partial^2 h}{\partial t\partial x}(1,3) \)
\{ $popup4d->menu() \}

\{ EndList('OL') \}
END_TEXT

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [2,4,6,8,10,12,14];
$ENV{'grader_scores'} = [0.14,0.28,0.51,0.65,0.78,0.86,1];
$ENV{'grader_message'} = "You can earn partial credits.";

ANS( $popup1a->cmp() );
ANS( $popup1b->cmp() );
ANS( $popup2a->cmp() );
ANS( $popup2b->cmp() );
ANS( $popup2c->cmp() );
ANS( $popup2d->cmp() );
ANS( $popup3a->cmp() );
ANS( $popup3b->cmp() );
ANS( $popup3c->cmp() );
ANS( $popup3d->cmp() );
ANS( $popup4a->cmp() );
ANS( $popup4b->cmp() );
ANS( $popup4c->cmp() );
ANS( $popup4d->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup1a->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();