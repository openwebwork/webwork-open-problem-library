##DESCRIPTION
## Classification of critical points problem, MAT237 F4 worksheet Q6.2
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'Approximations’, 'Critical points')

## DBsubject('Multivariable Calculus')
## DBchapter('Approximation')
## DBsection('Classification of critical points')
## Date('31/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('F4')
## Problem1('6.2')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
"unionLists.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

Context("Numeric");
# 6.2a
$popup1 = PopUp(
  ["?","f has a saddle point at a", "f has either a local min or local max at a", "the second derivative test is inconclusive"],
  "f has either a local min or local max at a",
);
# 6.2b
$popup2 = PopUp(
  ["?","f has a saddle point at a", "f has either a local min or local max at a", "the second derivative test is inconclusive"],
  "f has either a local min or local max at a",
);
# 6.2c
$popup3 = PopUp(
  ["?","f has a saddle point at a", "f has either a local min or local max at a", "the second derivative test is inconclusive"],
  "the second derivative test is inconclusive",
);

Context()->texStrings;
BEGIN_TEXT
Use the second derivative test to write the corresponding conclusion.
$BR
$BR
Corollary: Let \(f\) be real-valued and \(C^3\) on an open ball of the critical point \( a\in\mathbb{R}^2 \) so \( \nabla f(a)=0 \).
$BR
\{ BeginList('OL', type=>'A') \}

$ITEM If \( \det Hf(a)>0 \), then 
\{ $popup1->menu() \}

$ITEMSEP
$ITEM If \( \det Hf(a)<0 \), then
\{ $popup2->menu() \}

$ITEMSEP
$ITEM If \( \det Hf(a)=0 \), then
\{ $popup3->menu() \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3];
$ENV{'grader_scores'} = [0.33,0.67,1];
$ENV{'grader_message'} = "You can earn partial credits.";

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();