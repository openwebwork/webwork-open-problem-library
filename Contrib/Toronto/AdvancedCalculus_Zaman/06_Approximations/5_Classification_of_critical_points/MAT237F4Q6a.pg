########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
);

TEXT(beginproblem());

Context("Numeric");

$popup = PopUp(
  ["?","Local Minimum","Local Maximum", "Saddle Point", "Inconclusive"],
  "Inconclusive",
);

Context()->texStrings;
BEGIN_TEXT
Suppose \( g:\mathbb{R}^3\to\mathbb{R} \) is \(C^3\) and has critical point \((2,3,7)\). If possible, classify this critical point given that
$BR
$BR
$BCENTER
\(\begin{bmatrix}
-524 & -87 & 263\\
-87 & -20 & 27\\
263 & 27 & -182
\end{bmatrix}\)
$ECENTER
$BR
$BR
Second derivative test result: \{ $popup->menu() \}
END_TEXT
Context()->normalStrings;

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $popup->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();