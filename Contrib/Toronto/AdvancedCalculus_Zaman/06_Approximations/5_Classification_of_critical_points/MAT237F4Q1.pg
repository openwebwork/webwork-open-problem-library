##DESCRIPTION
## Classification of critical points problem, MAT237 F4 worksheet Q1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'derivateives’, 'differentiability')

## DBsubject('Multivariable Calculus')
## DBchapter('Approximation')
## DBsection('Classification of critical points')
## Date('31/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('F4')
## Problem1('1')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
"unionLists.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

Context("Numeric");
# 1.1
$popup1 = PopUp(
  ["?","True","False"],
  "False",
);
# 1.2
$popup2 = PopUp(
  ["?","True","False"],
  "True",
);
# 1.3
$popup3 = PopUp(
  ["?","True","False"],
  "False",
);

Context()->texStrings;
BEGIN_TEXT
Let \(f\) be a real-valued function. Assume \(f\) is \(C^3\) on an open ball of the critical point \( a\in\mathbb{R}^n \) so \( \nabla f(a)=0 \). Which statements are true or false?
$BR
$BR
\{ BeginList('OL', type=>'A') \}

$ITEM If \( Hf(a) \) has a zero eigenvalue, then you cannot classify \(a\) by the second derivative test. 
\{ $popup1->menu() \}

$ITEMSEP
$ITEM If \( Hf(a) \) has a zero eigenvalue and the rest of its eigenvalues are non-negative, then you cannot classify the critical point \(a\) by the second derivative test. 
\{ $popup2->menu() \}

$ITEMSEP
$ITEM If \( Hf(a) \) has a zero eigenvalue and the rest of its eigenvalues are non-negative, then the critical point \(a\) may be something other than a local maximum, a local minimum, or a saddle point.
\{ $popup3->menu() \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3];
$ENV{'grader_scores'} = [0.33,0.67,1];
$ENV{'grader_message'} = "You can earn partial credits.";

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup1->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();