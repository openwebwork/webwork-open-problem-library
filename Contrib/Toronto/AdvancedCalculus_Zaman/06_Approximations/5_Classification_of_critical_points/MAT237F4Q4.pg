##DESCRIPTION
## Classification of critical points problem, MAT237 F4 worksheet Q4
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'Approximations’, 'Critical points')

## DBsubject('Multivariable Calculus')
## DBchapter('Approximation')
## DBsection('Classification of critical points')
## Date('31/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('F4')
## Problem1('4')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
"unionLists.pl",
  "PGchoicemacros.pl",
  "unionTables.pl",
  "LiveGraphics3D.pl",
  "PGgraders.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());

$refreshCachedImages=1;

###################################################
#  Setup

$width  = 200;
$height = 200;
$lsize = [$width,$height];  # the size of the Live3D images
$ltsize = 220;       # tex size of the Live3D images


@graphs = (
image("f4-graph-1.jpg",width=>$width,height=>$height,tex_size=>$ltsize), 
image("f4-graph-2.jpg",width=>$width,height=>$height,tex_size=>$ltsize),
image("f4-graph-3.jpg",width=>$width,height=>$height,tex_size=>$ltsize), 
image("f4-graph-4.jpg",width=>$width,height=>$height,tex_size=>$ltsize), 
);

Context()->texStrings;
BEGIN_TEXT
Each graph below is the graph of the quadratic form for a \(C^3\) real-valued function \( \mathbb{R}^2\to\mathbb{R} \) at one of its critical points \( a,b,c,d\in\mathbb{R}^2 \). Can you apply the second derivative test to classify the critical point for each graph?
\{
BeginTable().

AlignedRow([ 
 $graphs[0], 
 $graphs[1], 
 $graphs[2], 
 $graphs[3] 
]).

TableSpace(5,0).

AlignedRow([ 
 "1. ".pop_up_list(["Choose","Yes","No"]),
 "2. ".pop_up_list(["Choose","Yes","No"]),
 "3. ".pop_up_list(["Choose","Yes","No"]),
 "4. ".pop_up_list(["Choose","Yes","No"])
]).

EndTable();
\}
END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4];
$ENV{'grader_scores'} = [0.25,0.5,0.75,1];
$ENV{'grader_message'} = "You can earn partial credits.";

ANS( str_cmp(Yes) );
ANS( str_cmp(Yes) );
ANS( str_cmp(Yes) );
ANS( str_cmp(No) );

Context()->texStrings;
BEGIN_SOLUTION
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();