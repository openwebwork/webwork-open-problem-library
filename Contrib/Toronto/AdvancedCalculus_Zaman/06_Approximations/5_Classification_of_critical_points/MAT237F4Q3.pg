##DESCRIPTION
## Classification of critical points problem, MAT237 F4 worksheet Q3
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'Approximations’, 'Critical points')

## DBsubject('Multivariable Calculus')
## DBchapter('Approximation')
## DBsection('Classification of critical points')
## Date('31/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('F4')
## Problem1('3')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
"unionLists.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

Context("Numeric");
# 3a
$popup1 = PopUp(
  ["?","All eigenvalues are nonnegative", "All eigenvalues are nonpositive","All eigenvalues are positive", "There is at least one negative and one positive eigenvalue", "All eigenvalues are negative"],
  "All eigenvalues are positive",
);
# 3b
$popup2 = PopUp(
  ["?","All eigenvalues are nonnegative", "All eigenvalues are nonpositive","All eigenvalues are positive", "There is at least one negative and one positive eigenvalue", "All eigenvalues are negative"],
  "All eigenvalues are nonnegative",
);
# 3c
$popup3 = PopUp(
  ["?","All eigenvalues are nonnegative", "All eigenvalues are nonpositive","All eigenvalues are positive", "There is at least one negative and one positive eigenvalue", "All eigenvalues are negative"],
  "All eigenvalues are negative",
);
# 3d
$popup4 = PopUp(
  ["?","All eigenvalues are nonnegative", "All eigenvalues are nonpositive","All eigenvalues are positive", "There is at least one negative and one positive eigenvalue", "All eigenvalues are negative"],
  "All eigenvalues are nonpositive",
);
# 3e
$popup5 = PopUp(
  ["?","All eigenvalues are nonnegative", "All eigenvalues are nonpositive","All eigenvalues are positive", "There is at least one negative and one positive eigenvalue", "All eigenvalues are negative"],
  "There is at least one negative and one positive eigenvalue",
);

Context()->texStrings;
BEGIN_TEXT
Complete the theorem below:
$BR
$BR
Let \( q:\mathbb{R}^n\to\mathbb{R} \) be a quadratic form with associated symmetric matrix \(A\). Then
$BR
\{ BeginList('OL', type=>'A') \}

$ITEM \(q\) has a unique global minimum at the origin if 
\{ $popup1->menu() \}

$ITEMSEP
$ITEM \(q\) has a global minimum at the origin if 
\{ $popup2->menu() \}

$ITEMSEP
$ITEM \(q\) has a unique global maximum at the origin if 
\{ $popup3->menu() \}

$ITEMSEP
$ITEM \(q\) has a global maximum at the origin if 
\{ $popup4->menu() \}

$ITEMSEP
$ITEM \(q\) does not have a global extremum at the origin if 
\{ $popup5->menu() \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4,5];
$ENV{'grader_scores'} = [0.2,0.4,0.6,0.8,1];
$ENV{'grader_message'} = "You can earn partial credits.";

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );
ANS( $popup4->cmp() );
ANS( $popup5->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup1->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();