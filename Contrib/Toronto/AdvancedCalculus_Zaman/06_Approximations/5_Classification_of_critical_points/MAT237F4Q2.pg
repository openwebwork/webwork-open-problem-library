DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserPopUp.pl",
  "unionLists.pl",
  "PGchoicemacros.pl",
  "unionTables.pl",
  "LiveGraphics3D.pl",
  "PGgraders.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());

Context("Numeric");
$width  = 200;
$height = 200;
$lsize = [$width,$height];  # the size of the Live3D images
$ltsize = 220;       # tex size of the Live3D images

@graph = (
image("f4-graph-1.jpg",width=>$width,height=>$height,tex_size=>$ltsize), 
image("f4-graph-2.jpg",width=>$width,height=>$height,tex_size=>$ltsize), 
image("f4-graph-3.jpg",width=>$width,height=>$height,tex_size=>$ltsize),
image("f4-graph-4.jpg",width=>$width,height=>$height,tex_size=>$ltsize), 
);

Context()->texStrings;
BEGIN_TEXT
Each quadratic form \( q:\mathbb{R}^2\to\mathbb{R} \) has an associated \(2\times 2\) symmetric matrix \(A\). Use the graph of \(q\) to determine how many eigenvalues of \(A\) are positive, negative, or zero. Enter 0 if there is no such eigenvalue. 
$BR
$BR
\{ image( "f4-graph-1.jpg", width=>200, height=>180, tex_size=>300, extra_html_tags=>'alt="curve"' ) \}
Positive:\{ ans_rule(1) \}Negative:\{ ans_rule(1) \}Zero\{ ans_rule(1) \}
$BR
\{ image( "f4-graph-2.jpg", width=>200, height=>180, tex_size=>300, extra_html_tags=>'alt="curve"' ) \}
Positive:\{ ans_rule(1) \}Negative:\{ ans_rule(1) \}Zero\{ ans_rule(1) \}
$BR
\{ image( "f4-graph-3.jpg", width=>200, height=>180, tex_size=>300, extra_html_tags=>'alt="curve"' ) \}
Positive:\{ ans_rule(1) \}Negative:\{ ans_rule(1) \}Zero\{ ans_rule(1) \}
$BR
\{ image( "f4-graph-4.jpg", width=>200, height=>180, tex_size=>300, extra_html_tags=>'alt="curve"' ) \}

Positive:\{ ans_rule(1) \}Negative:\{ ans_rule(1) \}Zero\{ ans_rule(1) \}


END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [3,6,9,12];
$ENV{'grader_scores'} = [0.25,0.5,0.75,1];
$ENV{'grader_message'} = "You can earn partial credits.";

# 2.1
ANS( num_cmp(1) );
ANS( num_cmp(1) );
ANS( num_cmp(0) );
# 2.2
ANS( num_cmp(2) );
ANS( num_cmp(0) );
ANS( num_cmp(0) );
# 2.3
ANS( num_cmp(0) );
ANS( num_cmp(2) );
ANS( num_cmp(0) );
# 2.4
ANS( num_cmp(1) );
ANS( num_cmp(0) );
ANS( num_cmp(1) );

Context()->texStrings;
BEGIN_SOLUTION
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();