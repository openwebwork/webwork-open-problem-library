## AuthorText1('')
## Section1('F4')
## Problem1('10.1')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
"unionLists.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

Context("Numeric");
# 10.1a
$popup1 = PopUp(
  ["?","Local Minimum","Local Maximum", "Saddle Point", "Inconclusive"],
  "Local Minimum",
);
# 10.1b
$popup2 = PopUp(
  ["?","Local Minimum","Local Maximum", "Saddle Point", "Inconclusive"],
  "Inconclusive",
);
# 10.1c
$popup3 = PopUp(
  ["?","Local Minimum","Local Maximum", "Saddle Point", "Inconclusive"],
  "Saddle Point",
);

Context()->texStrings;
BEGIN_TEXT
Let \( f:\mathbb{R}^3\to\mathbb{R} \) be \(C^3\). You find it has exactly three critical points \( a,b,c\in\mathbb{R}^3 \) and compute the Hessian matrices at each point to be
$BR
$BR
$BCENTER
\(Hf(a)=\begin{bmatrix}
-524 & -87 & 263\\
-87 & -20 & 27\\
263 & 27 & -182
\end{bmatrix},\qquad
Hf(b)=\begin{bmatrix}
-524 & -87 & 263\\
-87 & -20 & 27\\
263 & 27 & -182
\end{bmatrix},\qquad
Hf(c)=\begin{bmatrix}
-524 & -87 & 263\\
-87 & -20 & 27\\
263 & 27 & -182
\end{bmatrix}\)
$ECENTER
$BR
$BR
$BR
\{ BeginList('OL', type=>'A') \}

$ITEM \(a:\)\{ $popup1->menu() \}

$ITEM \(b:\)\{ $popup2->menu() \}

$ITEM \(c:\)\{ $popup3->menu() \}

END_TEXT
Context()->normalStrings;

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();