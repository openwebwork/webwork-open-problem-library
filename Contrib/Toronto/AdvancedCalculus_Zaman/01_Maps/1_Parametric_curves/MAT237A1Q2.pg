##DESCRIPTION
##  Curves basics problem, MAT237 A1 worksheet 2.4-2.7
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'curve', 'speed', 'velocity)

## DBsubject('Multivariable Calculus')
## DBchapter('Fundamentals')
## DBsection('Curves')
## Date('22/6/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('A1')
## Problem1('2')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
);

TEXT(beginproblem());

#
#  Create a matching list and use popups
#
$ml = new_match_list();
$ml->rf_print_q(~~&pop_up_list_print_q);
$ml->ra_pop_up_list([
"No answer" => "?",
"A" => "A", "B" => "B", "C" => "C", 
"D" => "D", "none of the above" => "E", 
]);

#
#  Add correct questions and answers
#
$ml->qa(
"Distance between the duck's position after 1 sec and 2 sec", "\(|| \gamma(2)-\gamma(1) || \)",
"Displacement of the duck after 1 sec and 2 sec", "\( \gamma(2)-\gamma(1) \)",
"Instantaaneous velocity of the duck at time 2", "\( \lim_{h\to 0}\frac{\gamma(2+h)-\gamma(2)}{h}\)",
"Instantaaneous speed of the duck at time 2", "\( \lim_{h\to 0}\frac{||\gamma(2+h)-\gamma(2)||}{|h|}\)",
);
$ml->choose(4);
  
$ml->makeLast("None of the above");

Context()->texStrings;
BEGIN_TEXT
$BR
Belal wants to study how whirlpools work. He takes his rubber duck to a swimming pool with a slow-movig whirlpool. He places the duck to the edge of the whirlpool and, using his drone, he tracks its movemet. It takes 2 minutes until the rubber duck reaches the cetre.
$PAR
$BCENTER
\{ image( "a1-duck.jpg", width=>200, height=>180, tex_size=>300, extra_html_tags=>'alt="curve"' ) \}
$ECENTER
Afterwards, he downloads the video data to obtain a function \( \gamma(t) \) which is the position of the duck \(t\) seconds after he placed it int he whirpool. All distances are measured in metres.
Match each question with its answer.
\{ ColumnMatchTable($ml, valign=>'TOP') \}
END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4];
$ENV{'grader_scores'} = [0.25,0.5,0.75,1];
$ENV{'grader_message'} = "You can earn " .
"partial credits for each correct answer";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( str_cmp( $ml->ra_correct_ans ) );

@correct = @{$ml->ra_correct_ans()};
$answerstring = join(", ", @correct);
Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answers are $answerstring
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();