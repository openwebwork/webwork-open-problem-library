##DESCRIPTION
## Vector field problem, MAT237 A3 worksheet Q3
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'vector fields', 'transformations’)

## DBsubject('Multivariable Calculus')
## DBchapter('Fundamentals')
## DBsection('Vector fields and transformations')
## Date('9/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('A3')
## Problem1('3')

########################################################################

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "unionTables.pl",
  "LiveGraphics3D.pl",
  "PGgraders.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());

$refreshCachedImages=1;

###################################################
#  Setup

$width  = 200;
$height = 200;
$lsize = [$width,$height];  # the size of the Live3D images
$ltsize = 220;       # tex size of the Live3D images


@vf = (
image("a3-vector-field-1.png",width=>$width,height=>$height,tex_size=>$ltsize), 
image("a3-vector-field-2.png",width=>$width,height=>$height,tex_size=>$ltsize), 
image("a3-vector-field-3.png",width=>$width,height=>$height,tex_size=>$ltsize),
image("a3-vector-field-4.png",width=>$width,height=>$height,tex_size=>$ltsize), 
image("a3-vector-field-5.png",width=>$width,height=>$height,tex_size=>$ltsize), 
);


###############################################
#  Main text

BEGIN_TEXT
Match the picture of the vector field to its algebraic definition.
$BR
$BR
$BCENTER
\(A(x,y)=(x,0)\qquad B(x,y)=(0,-y)\qquad C(x,y)=(3,0)\qquad D(x,y)=(x,y)\qquad E(x,y)=(y,-x)\)
$BR
$BR
\{
BeginTable().

AlignedRow([ 
 $vf[0], 
 $vf[1], 
 $vf[2], 
 $vf[3],
 $vf[4]
]).

TableSpace(6,0).

AlignedRow([ 
 "1. ".pop_up_list(["Choose","A","B","C","D","E"]),
 "2. ".pop_up_list(["Choose","A","B","C","D","E"]),
 "3. ".pop_up_list(["Choose","A","B","C","D","E"]),
 "4. ".pop_up_list(["Choose","A","B","C","D","E"]),
 "5. ".pop_up_list(["Choose","A","B","C","D","E"])
]).

TableSpace(26,5).

TableSpace(6,0).

EndTable();
\}
$BR
(Click on a graph to enlarge it.)
$ECENTER
END_TEXT


##########################################
#  Answer evaluation

install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4,5];
$ENV{'grader_scores'} = [0.2,0.4,0.6,0.8,1];
$ENV{'grader_message'} = "You can earn partial credits";

$showPartialCorrectAnswers = 0;

ANS(str_cmp("A"), str_cmp("D"), str_cmp("C"), str_cmp("B"), str_cmp("E"));

COMMENT("Uses static graphs");

ENDDOCUMENT();
