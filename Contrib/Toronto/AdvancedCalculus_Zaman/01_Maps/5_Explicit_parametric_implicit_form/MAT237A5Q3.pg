##DESCRIPTION
## Manifold form problem, MAT237 A5 worksheet Q3
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'manifolds')

## DBsubject('Multivariable Calculus')
## DBchapter('Fundamentals')
## DBsection('Manifolds and projections')
## Date('9/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('A5')
## Problem1('3')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

Context("Numeric");
# 3.1
$popup1 = PopUp(
  ["?","Yes, this parametrizes S","No, this does not parametrize S"],
  "No, this does not parametrize S",
);
# 3.2
$popup2 = PopUp(
  ["?","Yes, this parametrizes S","No, this does not parametrize S"],
  "No, this does not parametrize S",
);
# 3.3
$popup3 = PopUp(
  ["?","Yes, this parametrizes S","No, this does not parametrize S"],
  "Yes, this parametrizes S",
);
# 3.4
$popup4 = PopUp(
  ["?","Yes, this parametrizes S","No, this does not parametrize S"],
  "Yes, this parametrizes S",
);
# 3.5
$popup5 = PopUp(
  ["?","Yes, this parametrizes S","No, this does not parametrize S"],
  "Yes, this parametrizes S",
);
# 3.6
$popup6 = PopUp(
  ["?","Yes, this parametrizes S","No, this does not parametrize S"],
  "Yes, this parametrizes S",
);

Context()->texStrings;
BEGIN_TEXT
Let \(S\subseteq\mathbb{R}^3\) be the upper hemisphere of radius 3 centred at the origin, so 
$BCENTER
\(S = \lbrace(x,y,z)\in\mathbb{R}^3: x^2+y^2+z^2=9, z\geq 0\rbrace\)
$ECENTER
Which of the following maps parametrize \(S\)?
$BR
$BR
\{ $popup1->menu() \} 
\( g_1: \mathbb{R}^2\to\mathbb{R}^3\mbox{ given by } g_1(x,y)=(x,y,\sqrt{9-x^2-y^2}) \)
$BR
\{ $popup2->menu() \}
\( g_2: [0,3]\times[0,2\pi]\times[0,\frac{\pi}{2}]\to\mathbb{R}^3\mbox{ given by } g_2(\rho, \theta, \phi)=(\rho\cos\theta\sin\phi, \rho\sin\theta\sin\phi, \rho\cos\phi) \)
$BR
\{ $popup3->menu() \}
\( g_3: [0,2\pi)\times[0,\frac{\pi}{2}]\to\mathbb{R}^3\mbox{ given by } g_3(\theta,\phi)=(3\cos\theta\sin\phi, 3\sin\theta\sin\phi, 3\cos\phi) \)
$BR
\{ $popup4->menu() \}
\( g_4: [0,4\pi]\times[0,\frac{\pi}{2}]\to\mathbb{R}^3\mbox{ given by } g_4(\theta,\phi)=(3\cos\theta\sin\phi, 3\sin\theta\sin\phi, 3\cos\phi) \)
$BR
\{ $popup5->menu() \}
\( g_5: [0,3]\times[0,2\pi]\to\mathbb{R}^3\mbox{ given by } g_5(r,\theta)=(r\cos\theta, r\sin\theta, \sqrt{9-r^2}) \)
$BR
\{ $popup6->menu() \}
\( g_6: [0,2\pi]\times[0,3]\to\mathbb{R}^3\mbox{ given by } g_6(\theta, z)=(\sqrt{9-z^2}\cos\theta, \sqrt{9-z^2}\sin\theta, z) \)
END_TEXT
Context()->normalStrings;

install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4,5,6];
$ENV{'grader_scores'} = [0.16,0.33,0.51,0.67,0.83,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#install_problem_grader(~~&std_problem_grader);

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );
ANS( $popup4->cmp() );
ANS( $popup5->cmp() );
ANS( $popup6->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup1->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();