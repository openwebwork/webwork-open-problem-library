##DESCRIPTION
## Manifold form problem, MAT237 A5 worksheet Q1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'manifolds')

## DBsubject('Multivariable Calculus')
## DBchapter('Fundamentals')
## DBsection('Manifolds and projections')
## Date('9/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('A5')
## Problem1('1')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

Context("Numeric");
# 1.1
$popup1 = PopUp(
  ["?","Parametric form","Explicit form","Implicit form","None of them"],
  "Parametric form",
);
# 1.2
$popup2 = PopUp(
  ["?","Parametric form","Explicit form","Implicit form","None of them"],
  "Implicit form",
);
# 1.3
$popup3 = PopUp(
  ["?","Parametric form","Explicit form","Implicit form","None of them"],
  "Explicit form",
);
# 1.4
$popup4 = PopUp(
  ["?","Parametric form","Explicit form","Implicit form","None of them"],
  "None of them",
);

Context()->texStrings;
BEGIN_TEXT
Define the following functions:
$BR
\( \qquad f: \lbrace(x,z)\in\mathbb{R}^2: x^2+z^2\leq 1\rbrace \to\mathbb{R}\) by \(f(x,z)=\sqrt{1-x^2-z^2}\)
$BR
\( \qquad g: \lbrace(s,t)\in\mathbb{R}^2: s^2+t^2\leq 1\rbrace \to\mathbb{R}^3\) by \(g(x,z)=(s, \sqrt{1-s^2-t^2}, t)\)
$BR
\( \qquad h: \mathbb{R}^3\to\mathbb{R}\) by \(h(x,y,z)=x^2+y^2+z^2\)
$BR
$BR
Identify whether the set is written in parametric form, explicit form, implicit form or none of them.
$BR
$BR
\(A=img(g)\)\{ $popup1->menu() \} 
$BR
\(B=h^{-1}(\lbrace 1\rbrace)\)\{ $popup2->menu() \}
$BR
\(C=\lbrace(x,y,z)\in\mathbb{R}^3: y=f(x,z)\rbrace\)\{ $popup3->menu() \}
$BR
\(D=\lbrace(x,y,z)\in\mathbb{R}^3: y=\pm f(x,z)\rbrace\)\{ $popup4->menu() \}
END_TEXT
Context()->normalStrings;

install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4];
$ENV{'grader_scores'} = [0.25,0.5,0.75,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#install_problem_grader(~~&std_problem_grader);

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );
ANS( $popup4->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup1->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();