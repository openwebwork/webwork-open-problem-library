##DESCRIPTION
## Manifold form problem, MAT237 A5 worksheet Q5
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'manifolds')

## DBsubject('Multivariable Calculus')
## DBchapter('Fundamentals')
## DBsection('Manifolds and projections')
## Date('9/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('A5')
## Problem1('5')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

Context("Numeric");
# 5.1
$popup1 = PopUp(
  ["?","True","False"],
  "True",
);
# 5.2
$popup2 = PopUp(
  ["?","True","False"],
  "True",
);
# 5.3
$popup3 = PopUp(
  ["?","True","False"],
  "False",
);

Context()->texStrings;
BEGIN_TEXT
Let \(S\subseteq\mathbb{R}^3\) be the sphere of radius 3 centred at the origin. Determine if the statement is true or false.
$BR
$BR
\{ $popup1->menu() \} The set \(S\) can be written in implicit form.
$BR
\{ $popup2->menu() \} The set \(S\) can be written in parametric form.
$BR
\{ $popup3->menu() \} The set \(S\) can be written in explicit form.
END_TEXT
Context()->normalStrings;

install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3];
$ENV{'grader_scores'} = [0.33,0.67,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#install_problem_grader(~~&std_problem_grader);

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup1->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();