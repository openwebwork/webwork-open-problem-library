##DESCRIPTION
## Manifold form problem, MAT237 A5 worksheet Q2
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'manifolds')

## DBsubject('Multivariable Calculus')
## DBchapter('Fundamentals')
## DBsection('Manifolds and projections')
## Date('9/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('A5')
## Problem1('2')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

Context("Numeric");
# 2.1
$popup1 = PopUp(
  ["?","Parametric form","Explicit form","Implicit form","None of them"],
  "Implicit form",
);
# 2.2
$popup2 = PopUp(
  ["?","Parametric form","Explicit form","Implicit form","None of them"],
  "Parametric form",
);
# 2.3
$popup3 = PopUp(
  ["?","Parametric form","Explicit form","Implicit form","None of them"],
  "Explicit form",
);
# 2.4
$popup4 = PopUp(
  ["?","Parametric form","Explicit form","Implicit form","None of them"],
  "None of them",
);

Context()->texStrings;
BEGIN_TEXT
Determine whether each set is written in parametric form, explicit form, implicit form or none of them.
$BR
$BR
\(A=\lbrace(x,y,z)\in\mathbb{R}^3: xyz=237\rbrace\)\{ $popup1->menu() \} 
$BR
\(B=\left\lbrace\left(\frac{237}{yz}, y, z\right): (y,z)\in\mathbb{R}^2, yz\neq 0\right\rbrace\)\{ $popup2->menu() \}
$BR
\(C=\left\lbrace(x,y,z)\in\mathbb{R}^3: x=\frac{237}{yz}\right\rbrace\)\{ $popup3->menu() \}
$BR
\(D=\left\lbrace(x,y,z)\in\mathbb{R}^3: x=\frac{237}{yz} \mbox{ or } y=\frac{237}{xz} \mbox{ or } z=\frac{237}{xy}\right\rbrace\)\{ $popup4->menu() \}
END_TEXT
Context()->normalStrings;

install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4];
$ENV{'grader_scores'} = [0.25,0.5,0.75,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#install_problem_grader(~~&std_problem_grader);

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );
ANS( $popup4->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup1->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();