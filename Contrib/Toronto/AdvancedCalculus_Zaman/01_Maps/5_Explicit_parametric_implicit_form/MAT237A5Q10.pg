##DESCRIPTION
## Manifold form problem, MAT237 A5 worksheet 10.3
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'manifolds')

## DBsubject('Multivariable Calculus')
## DBchapter('Fundamentals')
## DBsection('Manifolds and projections')
## Date('9/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('A5')
## Problem1('7')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

Context("Numeric");
# 10.3a
$popup1 = PopUp(
  ["?","True","False"],
  "True",
);
# 10.3b
$popup2 = PopUp(
  ["?","True","False"],
  "False",
);
# 10.3c
$popup3 = PopUp(
  ["?","True","False"],
  "True",
);
# 10.3d
$popup4 = PopUp(
  ["?","True","False"],
  "False",
);

Context()->texStrings;
BEGIN_TEXT
Which statements are true or false?
$BR
$BR
(a)\{ $popup1->menu() \} If a set \(S\) can be written in explicit form, then \(S\) can be written in implicit form.
$BR
(b)\{ $popup2->menu() \} If a set \(S\) can be written in implicit form, then \(S\) can be written in explicit form.
$BR
(c)\{ $popup3->menu() \} If a set \(S\) can be written in explicit form, then \(S\) can be parametric in implicit form.
$BR
(d)\{ $popup4->menu() \} If a set \(S\) can be written in parametric form, then \(S\) can be written in explicit form.
END_TEXT

Context()->normalStrings;

install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4];
$ENV{'grader_scores'} = [0.25,0.5,0.75,1];
$ENV{'grader_message'} = "You can earn partial credits.";

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );
ANS( $popup4->cmp() );

#install_problem_grader(~~&std_problem_grader);

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup2->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();