##DESCRIPTION
## Manifold form problem, MAT237 A5 worksheet Q6
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'manifolds')

## DBsubject('Multivariable Calculus')
## DBchapter('Fundamentals')
## DBsection('Manifolds and projections')
## Date('9/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('A5')
## Problem1('6')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

Context("Numeric");
# 6.1
$popup1 = PopUp(
  ["?","True","False"],
  "True",
);
# 6.2
$popup2 = PopUp(
  ["?","True","False"],
  "True",
);

Context()->texStrings;
BEGIN_TEXT
Let \( f:\mathbb{R}^2\to\mathbb{R} \) be any continuous map. Determine which of the following statements are true or false.
$BR
$BR
\{ $popup1->menu() \} The set \(S=\lbrace(x,y,z)\in\mathbb{R}^3: z=f(x,y)\rbrace\) in explicit form can also be written in parametric form.
$BR
\{ $popup2->menu() \} The set \(S=\lbrace(x,y,z)\in\mathbb{R}^3: z=f(x,y)\rbrace\) in explicit form can also be written in implicit form.
END_TEXT
Context()->normalStrings;

install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2];
$ENV{'grader_scores'} = [0.5,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#install_problem_grader(~~&std_problem_grader);

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup1->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();