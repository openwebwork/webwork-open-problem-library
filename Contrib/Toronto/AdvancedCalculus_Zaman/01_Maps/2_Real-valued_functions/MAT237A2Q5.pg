##DESCRIPTION
##  Contour plot basics problem, MAT237 A2 worksheet 5.1-5.2
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'contour plot', 'real-valued functions’)

## DBsubject('Multivariable Calculus')
## DBchapter('Fundamentals')
## DBsection('Real-valued functions')
## Date('9/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('A2')
## Problem1('5.1-5.2')

########################################################################

DOCUMENT();	

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "PGgraphmacros.pl",
  "MathObjects.pl",
  "weightedGrader.pl",
  "PGcourse.pl",
  "parserPopUp.pl",
);

TEXT(beginproblem());

#######################################

Context("Numeric");

$popup = PopUp(
  ["?","A","B","C","D","E"],
  "E",
);

################################################

Context()->texStrings;
BEGIN_TEXT
A topographic map of the island of Hawaii is below. The contour plot values are measured in feet.
$PAR
$BCENTER
\{ image( "a2-hawaii.png", width=>250, height=>300, tex_size=>300, extra_html_tags=>'alt="hawaii"' ) \}
$ECENTER
Let \(h: \mathbb{R}^2\to\mathbb{R}\) be a function describing the height of the island at a point.
$BR
$BR
(a) On which level set of \(h\) does the point \(A\) belong? \{ans_rule(10)\} 
END_TEXT
ANS(num_cmp(1000));
BEGIN_TEXT
$BR
$BR
(b) Among the points \(A,B,C,D,E\), which point is the 3rd highest?\{ $popup->menu() \}
END_TEXT
Context()->normalStrings;

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $popup->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();