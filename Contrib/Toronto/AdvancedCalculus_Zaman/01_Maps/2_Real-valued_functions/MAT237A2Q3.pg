##DESCRIPTION
##  Contour plot basics problem, MAT237 A2 worksheet Q3
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'contour plot', 'real-valued functions’)

## DBsubject('Multivariable Calculus')
## DBchapter('Fundamentals')
## DBsection('Real-valued functions')
## Date('9/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('A2')
## Problem1('3')

########################################################################

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "unionTables.pl",
  "LiveGraphics3D.pl",
  "PGgraders.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());

$refreshCachedImages=1;

###################################################
#  Setup

$width  = 200;
$height = 200;
$lsize = [$width,$height];  # the size of the Live3D images
$ltsize = 220;       # tex size of the Live3D images


@surfaces = (
image("a2-surface1.png",width=>$width,height=>$height,tex_size=>$ltsize), 
image("a2-surface2.png",width=>$width,height=>$height,tex_size=>$ltsize),
image("a2-surface3.png",width=>$width,height=>$height,tex_size=>$ltsize), 
image("a2-surface4.png",width=>$width,height=>$height,tex_size=>$ltsize), 
);

@contours = (
image("a2-contour4.png",width=>$width,height=>$height,tex_size=>$ltsize),
image("a2-contour3.png",width=>$width,height=>$height,tex_size=>$ltsize),
image("a2-contour1.png",width=>$width,height=>$height,tex_size=>$ltsize),
image("a2-contour2.png",width=>$width,height=>$height,tex_size=>$ltsize),
);

@perm = shuffle(4);
@inv = invert(@perm);


###############################################
#  Main text

BEGIN_TEXT
A contour plot for a function \( f: \mathbb{R}^2\to\mathbb{R} \) is a finite collection of level sets plotted on a single plane. Match the contour plot to the graph of the function.
$BR
$BR
$BCENTER
\{
BeginTable().

AlignedRow([ 
 $surfaces[0], 
 $surfaces[1], 
 $surfaces[2], 
 $surfaces[3] 
]).

TableSpace(5,0).

AlignedRow([ 
 "1. ".pop_up_list(["Choose","A","B","C","D"]),
 "2. ".pop_up_list(["Choose","A","B","C","D"]),
 "3. ".pop_up_list(["Choose","A","B","C","D"]),
 "4. ".pop_up_list(["Choose","A","B","C","D"])
]).

TableSpace(26,5).

AlignedRow([
$contours[$perm[0]],
$contours[$perm[1]],
$contours[$perm[2]],
$contours[$perm[3]]
]).

TableSpace(5,0).

AlignedRow(["A","B","C","D"]).

EndTable();
\}
$BR
(Click on a graph to enlarge it.)
$ECENTER
END_TEXT


##########################################
#  Answer evaluation

install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [2,4];
$ENV{'grader_scores'} = [0.5,1];
$ENV{'grader_message'} = "You can earn " .
"50% partial credit for 2 - 3 correct answers.";

$showPartialCorrectAnswers = 0;

ANS(str_cmp([@ALPHABET[@inv]]));

COMMENT("Uses static graphs");

ENDDOCUMENT();
