## B1 Worksheet 1.1
##ENDDESCRIPTION

##KEYWORDS('topology', 'multivariable calculus', 'interior', 'boundary', 'limit')

## DBsubject('Multivariable Calculus')
## DBchapter('Topology')
## DBsection('Interior, Boudary and Closure')
## Date('22/6/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('B1')
## Problem1('1.1')


########################################################################

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());

# point a
$mc1 = new_checkbox_multiple_choice();

$mc1 -> qa (
"The point \(a\) is a ...", 
"interior point",
"limit point",
);

$mc1 -> makeLast(
"interior point","boundary point","limit point",
);

# point b
$mc2 = new_checkbox_multiple_choice();

$mc2 -> qa (
"The point \(b\) is a ...", 
"boundary point",
"limit point",                
);

$mc2 -> makeLast(
"interior point","boundary point","limit point",
);

# point c
$mc3 = new_checkbox_multiple_choice();

$mc3 -> qa (
"The point \(c\) is a ...", 
"boundary point",
"limit point",                
);

$mc3 -> makeLast(
"interior point","boundary point","limit point",
);

# point d
$mc4 = new_checkbox_multiple_choice();

$mc4 -> qa (
"The point \(d\) is a ...", 
"boundary point",         
);

$mc4 -> makeLast(
"interior point","boundary point","limit point",
);

Context()->texStrings;
BEGIN_TEXT
$BR
Consider the following set \( S\subseteq\mathbb{R}^2 \) and labelled points \( a,b,c,d \). Note \( a,b,d\in S \) but \( c\notin S \)
$PAR
$BCENTER
\{ image( "b1-donuts.jpg", width=>200, height=>180, tex_size=>300, extra_html_tags=>'alt="donuts"' ) \}
$ECENTER
For each labelled point, identify whether it is an interior point, a boundary point, or a limit point of \(S\).

$BR
$BR
\{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}
$BR
\{ $mc2 -> print_q() \}
\{ $mc2 -> print_a() \}
$BR
\{ $mc3 -> print_q() \}
\{ $mc3 -> print_a() \}
$BR
\{ $mc4 -> print_q() \}
\{ $mc4 -> print_a() \}
END_TEXT


Context()->normalStrings;

############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );
ANS( checkbox_cmp( $mc3->correct_ans() ) );
ANS( checkbox_cmp( $mc4->correct_ans() ) );


############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $mc1->correct_ans() \} $BR
The correct answers are \{ $mc2->correct_ans() \} $BR
The correct answers are \{ $mc3->correct_ans() \} $BR
The correct answers are \{ $mc4->correct_ans() \} $BR
END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT();    
