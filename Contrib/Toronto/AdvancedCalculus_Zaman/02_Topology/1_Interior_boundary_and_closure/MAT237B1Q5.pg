DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
);

TEXT(beginproblem());
Context("Numeric");

$popup = PopUp(
  ["?","Line 1: picked the wrong epsilon",
  "Line 1: epsilon is not arbitrary",
  "Line 2: picked the wrong a and b",
  "Line 4: does not follow from line 3"],
  "Line 1: epsilon is not arbitrary",
);

Context()->texStrings;
BEGIN_TEXT
Below is an inorrect proof that \((2, -1)\) is a boundary pooint of \(S\).
$PAR
$BCENTER
\{ image( "b1-proof.jpg", width=>850, height=>130, tex_size=>300, extra_html_tags=>'alt="curve"' ) \}
$ECENTER
$BR
One line has a critical flaw. Identify the line and explain what is wrong with the proof.
\{ $popup->menu() \}


END_TEXT
Context()->normalStrings;

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $popup->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();