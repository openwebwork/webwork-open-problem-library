##DESCRIPTION
##  Topology concepts, MAT237 B1 worksheet Q4
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'topology')

## DBsubject('Multivariable Calculus')
## DBchapter('Topology')
## DBsection('Interior, boundary, and closure')
## Date('22/6/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('B1')
## Problem1('4')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

Context("Numeric");

# Create and use pop up lists 
$tf = new_select_list();
$tf->rf_print_q(~~&pop_up_list_print_q);

# Choices presented to students
$tf->ra_pop_up_list( [ 
"No answer" => "?", 
"True"  => "True", 
"False" => "False",
"Cannot determine" => "Cannot determine",
]);

# Questions and answers
$tf -> qa ( 
"If \(p\) is not an interior point of \(A\) then \(p\) does not belong to \(A\).",
"False",
"If \(p\) is a boundary point of \(A\) then \(p\) is in the closure of \(A\).",
"True",
"If \(p\) is a limit point of \(A\) but not an interior point, then \(p\) is a boundary point of \(A\).",
"True",
"If \(p\) belongs to \(A\) then \(p\) is a limit point of \(A\).",
"False"
);

# How many questions to use
$tf->choose(4);

Context()->texStrings;
BEGIN_TEXT
Are the following statements true or false? 
$BR
\{ $tf -> print_q() \}
END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4];
$ENV{'grader_scores'} = [0.25,0.5,0.75,1];
$ENV{'grader_message'} = "You can earn partial credits for each correct answer" ;

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( str_cmp( $tf->ra_correct_ans() ) );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:${PAR}
You could put an explanation here.
END_SOLUTION
Context()->normalStrings;

COMMENT("MathObject version.");

ENDDOCUMENT();