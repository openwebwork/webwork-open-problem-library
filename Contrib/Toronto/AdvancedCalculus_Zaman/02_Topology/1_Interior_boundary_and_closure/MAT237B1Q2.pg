DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
);

TEXT(beginproblem());

# B1 2.1
$mc1 = new_checkbox_multiple_choice();

$mc1 -> qa (
"The point \(a\) is a boundary point of \(A\). Which value(s) of \(\epsilon\) prove this claim?", 
"\( \epsilon=0.4 \)", "\( \epsilon=0.6 \)", "\( \epsilon=0.8 \)", "\( \epsilon=1.0 \)",
);

$mc1 -> makeLast("\( \epsilon=0.4 \)", "\( \epsilon=0.6 \)", "\( \epsilon=0.8 \)", "\( \epsilon=1.0 \)");

# B1 2.2
$mc2 = new_checkbox_multiple_choice();

$mc2 -> qa (
"The point \(b\) is not a boundary point of \(A\). Which value(s) of \(\epsilon\) prove this claim?", 
"\( \epsilon=0.4 \)",          
);

$mc2 -> makeLast("\( \epsilon=0.4 \)", "\( \epsilon=0.6 \)", "\( \epsilon=0.8 \)", "\( \epsilon=1.0 \)");

# B1 2.3
$mc3 = new_checkbox_multiple_choice();

$mc3 -> qa (
"The point \(c\) is an interior point of \(A\). Which value(s) of \(\epsilon\) prove this claim?", 
"\( \epsilon=0.4 \)",          
);

$mc3 -> makeLast("\( \epsilon=0.4 \)", "\( \epsilon=0.6 \)", "\( \epsilon=0.8 \)", "\( \epsilon=1.0 \)");

# B1 2.4
$mc4 = new_checkbox_multiple_choice();

$mc4 -> qa (
"The point \(a\) is not an interior point of \(A\). Which value(s) of \(\epsilon\) prove this claim?", 
"\( \epsilon=0.4 \)", "\( \epsilon=0.6 \)", "\( \epsilon=0.8 \)", "\( \epsilon=1.0 \)",       
);

$mc4 -> makeLast("\( \epsilon=0.4 \)", "\( \epsilon=0.6 \)", "\( \epsilon=0.8 \)", "\( \epsilon=1.0 \)");

# B1 2.5
$mc5 = new_checkbox_multiple_choice();

$mc5 -> qa (
"The point \(a\) is a limit point of \(A\). Which value(s) of \(\epsilon\) prove this claim?", 
"\( \epsilon=0.4 \)", "\( \epsilon=0.6 \)", "\( \epsilon=0.8 \)", "\( \epsilon=1.0 \)",          
);

$mc5 -> makeLast("\( \epsilon=0.4 \)", "\( \epsilon=0.6 \)", "\( \epsilon=0.8 \)", "\( \epsilon=1.0 \)");

# B1 2.6
$mc6 = new_checkbox_multiple_choice();

$mc6 -> qa (
"The point \(b\) is not a limit point of \(A\). Which value(s) of \(\epsilon\) prove this claim?", 
"\( \epsilon=0.4 \)",          
);

$mc6 -> makeLast("\( \epsilon=0.4 \)", "\( \epsilon=0.6 \)", "\( \epsilon=0.8 \)", "\( \epsilon=1.0 \)");

Context()->texStrings;
BEGIN_TEXT
Each illustration draws an \(\epsilon\)-ball around each points with different values of \(\epsilon\).
$BR
$BR
\{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}
$BR
\{ $mc2 -> print_q() \}
\{ $mc2 -> print_a() \}
$BR
\{ $mc3 -> print_q() \}
\{ $mc3 -> print_a() \}
$BR
\{ $mc4 -> print_q() \}
\{ $mc4 -> print_a() \}
$BR
\{ $mc5 -> print_q() \}
\{ $mc5 -> print_a() \}
$BR
\{ $mc6 -> print_q() \}
\{ $mc6 -> print_a() \}

END_TEXT
Context()->normalStrings;

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );
ANS( checkbox_cmp( $mc3->correct_ans() ) );
ANS( checkbox_cmp( $mc4->correct_ans() ) );
ANS( checkbox_cmp( $mc5->correct_ans() ) );
ANS( checkbox_cmp( $mc6->correct_ans() ) );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $mc1->correct_ans() \}
The correct answer is \{ $mc2->correct_ans() \}
The correct answer is \{ $mc3->correct_ans() \}
The correct answer is \{ $mc4->correct_ans() \}
The correct answer is \{ $mc5->correct_ans() \}
The correct answer is \{ $mc6->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();