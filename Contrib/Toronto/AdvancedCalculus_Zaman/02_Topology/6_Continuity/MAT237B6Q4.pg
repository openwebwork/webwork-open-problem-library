##DESCRIPTION
##  Continuity problem, MAT237 B6 worksheet Q4
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'continuity', 'topology')

## DBsubject('Multivariable Calculus')
## DBchapter('Topology')
## DBsection('Continuity')
## Date('2/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('B6')
## Problem1('4')

########################################################################

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup


## Question B6 4.1
$mc1 = new_checkbox_multiple_choice();

$mc1 -> qa (
"If \(a\) is a limit point of \(A\), which of these statements are equivalent to \(f\) is continuous at \(a\)?",
"\((a)\)", "\((c)\)", "\((d)\)", "\((f)\)",                
);

$mc1->makeLast("\((a)\)", "\((b)\)", "\((c)\)", "\((d)\)", "\((e)\)", "\((f)\)");

## Question B6 4.2
$mc2 = new_checkbox_multiple_choice();

$mc2 -> qa (
"If \(a\) is an isolated point of \(A\), which of these statements are equivalent to \(f\) is continuous at \(a\)?",
"\((c)\)", "\((d)\)", "\((f)\)",                
);

$mc2->makeLast("\((a)\)", "\((b)\)", "\((c)\)", "\((d)\)", "\((e)\)", "\((f)\)");

###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
Let \(f: A\to\mathbb{R}^m\) where \(A\subseteq\mathbb{R}^n\). Fix \(a\in A\). The definition of continuity has more subtleties than you might expect. Consider the following 6 statements: 
$BR
(a) \(\lim_{x\to a} f(x)=f(a)\)
$BR
(b) \(\forall\epsilon>0, \exists\delta>0\) such that \(\forall x\in\mathbb{R}^n, ||x-a||<\delta \implies ||f(x)-f(a)||<\epsilon \)
$BR
(c) \(\forall\epsilon>0, \exists\delta>0\) such that \(\forall x\in A, ||x-a||<\delta \implies ||f(x)-f(a)||<\epsilon \)
$BR
(d) \(\forall\epsilon>0, \exists\delta>0\) such that \(\forall x\in A, 0<||x-a||<\delta \implies ||f(x)-f(a)||<\epsilon \)
$BR
(e) \(\forall\epsilon>0, \exists\delta>0\) such that \(f(B_\delta(a))\subseteq B_\epsilon(f(a)) \)
$BR
(f) \(\forall\epsilon>0, \exists\delta>0\) such that \(f(A\cap B_\delta(a))\subseteq B_\epsilon(f(a)) \)
$BR
$BR
\{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}
$BR
\{ $mc2 -> print_q() \}
\{ $mc2 -> print_a() \}
END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );

############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $mc1->correct_ans() \} $BR
The correct answers are \{ $mc2->correct_ans() \} $BR
END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT();   