DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

Context("Numeric");
# 2.1
$popup1 = PopUp(
  ["?","True","False"],
  "False",
);
# 2.2
$popup2 = PopUp(
  ["?","True","False"],
  "False",
);
# 2.3
$popup3 = PopUp(
  ["?","True","False"],
  "True",
);
# 2.4
$popup4 = PopUp(
  ["?","True","False"],
  "False",
);
# 2.5
$popup5 = PopUp(
  ["?","True","False"],
  "True",
);
# 2.6
$popup6 = PopUp(
  ["?","True","False"],
  "False",
);

Context()->texStrings;
BEGIN_TEXT
Assume \( f: \mathbb{R}^n\to\mathbb{R}^m \) is continuous. Which of these statements are true or false?
$BR
$BR
(a)\{ $popup1->menu() \} If \( A\subseteq\mathbb{R}^n \) is open then the image of \(A\) under \(f\) is open.
$BR
(b)\{ $popup2->menu() \} If \( A\subseteq\mathbb{R}^n \) is closed then the image of \(A\) under \(f\) is closed.
$BR
(c)\{ $popup3->menu() \} For every \( r>0 \) and \( y\in\mathbb{R}^m \), the set \( f^{-1}(B_r(y)) \) is open.
$BR
(d)\{ $popup4->menu() \} If \( A\subseteq\mathbb{R}^n \) is open and bounded then \( f(A) \) must be open.
$BR
(e)\{ $popup5->menu() \} If \( A\subseteq\mathbb{R}^n \) is closed and bounded then \( f(A) \) must be closed.
$BR
(f)\{ $popup6->menu() \} The preimages of compact sets under \(f\) must be compact.
END_TEXT

Context()->normalStrings;

install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4,5,6];
$ENV{'grader_scores'} = [0.16,0.33,0.51,0.67,0.83,1];
$ENV{'grader_message'} = "You can earn partial credits.";

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );
ANS( $popup4->cmp() );
ANS( $popup5->cmp() );
ANS( $popup6->cmp() );

#install_problem_grader(~~&std_problem_grader);

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup2->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();