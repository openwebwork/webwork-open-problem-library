##DESCRIPTION
## Differentials and the Jacobian problem, MAT237 C5 worksheet 1.1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'directional derivatives')

## DBsubject('Multivariable Calculus')
## DBchapter('Derivatives')
## DBsection('Differentials and the Jacobian')
## Date('20/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('C5')
## Problem1('1.1')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
"parserPopUp.pl",
"unionLists.pl",
);

TEXT(beginproblem());
# (a)
$popup1 = PopUp(
  ["?",, "m x n matrix", "Scalar", "Linear map", "m x 1 column vector"],
  "Linear map",
);
# (b)
$popup2 = PopUp(
  ["?",, "m x n matrix", "Scalar", "Linear map", "m x 1 column vector"],
  "m x 1 column vector",
);
# (c)
$popup3 = PopUp(
  ["?",, "m x n matrix", "Scalar", "Linear map", "m x 1 column vector"],
  "m x n matrix",
);
# (d)
$popup4 = PopUp(
  ["?",, "m x n matrix", "Scalar", "Linear map", "m x 1 column vector"],
  "m x 1 column vector",
);
# (e)
$popup5 = PopUp(
  ["?",, "m x n matrix", "Scalar", "Linear map", "m x 1 column vector"],
  "Linear map",
);
# (f)
$popup6 = PopUp(
  ["?",, "m x n matrix", "Scalar", "Linear map", "m x 1 column vector"],
  "m x n matrix",
);
# (g)
$popup7 = PopUp(
  ["?",, "m x n matrix", "Scalar", "Linear map", "m x 1 column vector"],
  "Scalar",
);
# (h)
$popup8 = PopUp(
  ["?",, "m x n matrix", "Scalar", "Linear map", "m x 1 column vector"],
  "m x n matrix",
);

Context()->texStrings;
BEGIN_TEXT
Let \( A\subseteq\mathbb{R}^n \). Let \(a\) be an interior point of \(A\). Let \( F: A\to\mathbb{R}^m \) be differentiable at \(a\). Fix \(v\in\mathbb{R}^n\). 
$BR
$BR
For each quantity, identify the type of mathematical object that it is.
\{ BeginList('OL', type=>'A') \}

$ITEM \( dF_a \)
\{ $popup1->menu() \}

$ITEMSEP
$ITEM \( dF_a(v) \)
\{ $popup2->menu() \}

$ITEMSEP
$ITEM \( DF(a) \)
\{ $popup3->menu() \}

$ITEMSEP
$ITEM \( DF(a)v \)
\{ $popup4->menu() \}

$ITEMSEP
$ITEM \( (dF_a^1,\ldots,dF_a^m) \)
\{ $popup5->menu() \}

$ITEMSEP
$ITEM \( [\partial_1 F(a)\cdots \partial_n F(a)] \)
\{ $popup6->menu() \}

$ITEMSEP
$ITEM \( \partial_j F^i(a) \) with fixed \( i\in\lbrace1,\ldots,m\rbrace, j\in\lbrace1,\ldots,n\rbrace \)
\{ $popup7->menu() \}

$ITEMSEP
$ITEM \( \left[\partial_j F^i(a)\right]_{i,j} \)
\{ $popup8->menu() \}

\{ EndList('OL') \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4,5,6,7,8];
$ENV{'grader_scores'} = [0.125,0.25,0.375,0.5,0.625,0.75,0.875,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );
ANS( $popup4->cmp() );
ANS( $popup5->cmp() );
ANS( $popup6->cmp() );
ANS( $popup7->cmp() );
ANS( $popup8->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup1->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();