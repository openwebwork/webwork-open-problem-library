##DESCRIPTION
##  Continuity problem, MAT237 B6 worksheet Q1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'continuity', 'topology')

## DBsubject('Multivariable Calculus')
## DBchapter('Topology')
## DBsection('Continuity')
## Date('2/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('B6')
## Problem1('1')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

Context("Numeric");

# Create and use pop up lists 
$tf = new_select_list();
$tf->rf_print_q(~~&pop_up_list_print_q);

# Choices presented to students
$tf->ra_pop_up_list( [ 
"No answer" => "?", 
"True"  => "True", 
"False" => "False",
]);

# Questions and answers
$tf -> qa ( 
"If \(f\) is continuous at \(a\) then \(\lim_{x\to a}f(x)=f(a)\).",
"False",
"If \(f\) is discontinuous at \(a\) then \(a\) is either a removable, infinite, or jump discontinuity.",
"False",
"If there exists \(m\times n\) matrix \(M\) such that \(f(x)=Mx\) for all \(x\in\mathbb{R}^n\), then \(f\) is continuous everywhere.",
"True",
"If \(f(x)=(f_1(x), \cdots, f_m(x))\) where each of \(f_1(x), \cdots, f_m\) is a polynomial, then \(f\) is continuous everywhere.",
"True",
);

# How many questions to use
$tf->choose(4);

Context()->texStrings;
BEGIN_TEXT
Let \(A\subseteq\mathbb{R}^n\) be a set. Let \(f: A\to\mathbb{R}^m\). Fix \(a\in A\). Which of the following statements are true or false?
$BR
\{ $tf -> print_q() \}
END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4];
$ENV{'grader_scores'} = [0.25,0.5,0.75,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( str_cmp( $tf->ra_correct_ans() ) );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:${PAR}
You could put an explanation here.
END_SOLUTION
Context()->normalStrings;

COMMENT("MathObject version.");

ENDDOCUMENT();