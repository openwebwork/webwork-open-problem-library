##DESCRIPTION
##  Topology problem, MAT237 B3 worksheet Q2
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'Open and Closed', 'topology')

## DBsubject('Multivariable Calculus')
## DBchapter('Topology')
## DBsection('Open sets and closed sets')
## Date('2/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('B3')
## Problem1('2')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
);

TEXT(beginproblem());

#
#  Create a matching list and use popups
#
$ml = new_match_list();
$ml->rf_print_q(~~&pop_up_list_print_q);
$ml->ra_pop_up_list([
"No answer" => "?",
"Open" => "Open", "Closed" => "Closed", "Both" => "Both", 
"Neither" => "Neither",
]);

#
#  Add correct questions and answers
#
$ml->qa(
"\( \{(x,y)\in\mathbb{R}^2: x<0\} \)", "Open",
"\( \emptyset \)", "Both",
"\( \mathbb{R}^n \)", "Both",
"\( B_1((1,0))\cap B_1((-1,0)) \)", "Open",
"\( \{(x,y,z)\in\mathbb{R}^3: 4\leq x^2+y^2+z^2 \leq 9\} \)", "Closed",
"\( \mathbb{Z}\times\mathbb{R} \)", "Closed",
"\( \{(x,y)\in\mathbb{R}^2: 0<x<2, 3\leq y \leq 5\} \)", "Neither",
"\( [0,1]^n=[0,1]\times\cdots\times[0,1] \)", "Closed",
);
$ml->choose(8);

$ml->makeLast("Open", "Closed", "Both", "Neither");

Context()->texStrings;
BEGIN_TEXT
Which of the following sets are open, which are closed, and which are neither?
\{ ColumnMatchTable($ml, valign=>'TOP') \}
END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4,5,6,7,8];
$ENV{'grader_scores'} = [0.125,0.25,0.375,0.5,0.625,0.75,0.875,1];
$ENV{'grader_message'} = "You can earn partial credits";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( str_cmp( $ml->ra_correct_ans ) );

@correct = @{$ml->ra_correct_ans()};
$answerstring = join(", ", @correct);
Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answers are $answerstring
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();