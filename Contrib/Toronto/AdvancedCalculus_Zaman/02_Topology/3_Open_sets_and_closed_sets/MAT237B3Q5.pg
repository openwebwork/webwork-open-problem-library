##DESCRIPTION
##  Topology problem, MAT237 B3 worksheet Q5
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'open and closed', 'topology')

## DBsubject('Multivariable Calculus')
## DBchapter('Topology')
## DBsection('Open sets and closed sets')
## Date('2/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('B3')
## Problem1('5')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
);

TEXT(beginproblem());

#
#  Create a matching list and use popups
#
$ml = new_match_list();
$ml->rf_print_q(~~&pop_up_list_print_q);
$ml->ra_pop_up_list([
"No answer" => "?",
"A is open" => "A is open", "A is closed" => "A is closed", 
"Neither" => "Neither",
]);

#
#  Add correct questions and answers
#
$ml->qa(
"\( A=A^\circ \)", "A is open",
"\( \partial A\subseteq A \)", "A is closed",
"\( A^*\subseteq A \)", "A is closed",
"\( A^c \) is not open", "Neither",
"\( A^c \) is closed", "A is open",
"\( \partial A=\partial(A^c) \)", "Neither",
"\( \overline{A}=A \)", "A is closed",
"\( \overline{\overline{A}}=\overline{A} \)", "Neither",
"\( A\cap\partial A = \emptyset \)", "A is open",
"\( \partial A=\overline{A}\backslash A^\circ \)", "Neither",
"Every point of \(A\) is an interior point of \(A\)", "A is open",
"Every point of \(A\) is a limit point of \(A\)", "Neither",
);
$ml->choose(12);

$ml->makeLast("A is open", "A is closed", "Neither");

Context()->texStrings;
BEGIN_TEXT
Let \(A\subseteq\mathbb{R}^n\). Some of the following statements are equivalent to "\(A\) is open" or "\(A\) is closed" or neither. Decide which statements are equivalent to which property.
\{ ColumnMatchTable($ml, valign=>'TOP') \}
END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4,5,6,7,8];
$ENV{'grader_scores'} = [0.125,0.25,0.375,0.5,0.625,0.75,0.875,1];
$ENV{'grader_message'} = "You can earn partial credits";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( str_cmp( $ml->ra_correct_ans ) );

@correct = @{$ml->ra_correct_ans()};
$answerstring = join(", ", @correct);
Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answers are $answerstring
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();