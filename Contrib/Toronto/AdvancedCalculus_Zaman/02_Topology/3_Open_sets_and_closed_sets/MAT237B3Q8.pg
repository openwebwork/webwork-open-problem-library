DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
"PGgraders.pl",
"unionLists.pl",
);

TEXT(beginproblem());

Context("Numeric");
# 8.1
$popup1 = PopUp(
  ["?","By the definition of the closure","By the definition of a limit point","Either x(k) is in A or it must be a limit point of A"],
  "By the definition of a limit point",
);
# 8.2
$popup2 = PopUp(
  ["?","By the definition of the closure","By the definition of a limit point","Either x(k) is in A or it must be a limit point of A"],
  "Either x(k) is in A or it must be a limit point of A",
);
# 8.3
$popup3 = PopUp(
  ["?","By the definition of the closure","By the definition of a limit point","Either x(k) is in A or it must be a limit point of A"],
  "By the definition of the closure",
);

Context()->texStrings;
BEGIN_TEXT
Recall the lemma: The closure of a set \(A\) is closed. 
$BR
$BR
Here is an essentially correct proof. Some details are missing which you will fill in.
$BCENTER
\{ image( "b3-proof.jpg", width=>800, height=>400, tex_size=>300, extra_html_tags=>'alt="curve"' ) \}
$ECENTER
\{ BeginList('OL', type=>'A') \}

$ITEM Why does line 2 follow from line 1? 
\{ $popup1->menu() \}

$ITEMSEP
$ITEM Add a bit more justification to line 3. Namely, why do these \( y(k) \) exist?
\{ $popup2->menu() \}

$ITEMSEP
$ITEM Why does the claim in line 4 imply the lemma?
\{ $popup3->menu() \}

\{ EndList('OL') \}
END_TEXT
Context()->normalStrings;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3];
$ENV{'grader_scores'} = [0.3,0.6,1];
$ENV{'grader_message'} = "You can earn partial credits.";

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();