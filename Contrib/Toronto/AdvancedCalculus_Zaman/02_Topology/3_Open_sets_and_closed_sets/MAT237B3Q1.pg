##DESCRIPTION
##  Curves basics problem, MAT237 B3 worksheet Q1.1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'Open and Closed', 'topology')

## DBsubject('Multivariable Calculus')
## DBchapter('Topology')
## DBsection('Open sets and closed sets')
## Date('27/6/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('B3')
## Problem1('1.1')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
);

TEXT(beginproblem());

#
#  Create a matching list and use popups
#
$ml = new_match_list();
$ml->rf_print_q(~~&pop_up_list_print_q);
$ml->ra_pop_up_list([
"No answer" => "?",
"Open" => "Open", "Closed" => "Closed", "Neither" => "Neither", 
]);

#
#  Add correct questions and answers
#
$ml->qa(
"Question a?", "Open",
"Question b?", "Closed",
"Question c?", "Neither",
"Question d?", "Neither",
);
$ml->choose(4);
  
$ml->makeLast("Open", "Closed", "Neither");

Context()->texStrings;
BEGIN_TEXT
Which of these 4 set are open, which are closed, and which are neither?
\{ ColumnMatchTable($ml, valign=>'TOP') \}
END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [2,4];
$ENV{'grader_scores'} = [0.5,1];
$ENV{'grader_message'} = "You can earn partial credits";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( str_cmp( $ml->ra_correct_ans ) );

@correct = @{$ml->ra_correct_ans()};
$answerstring = join(", ", @correct);
Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answers are $answerstring
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();