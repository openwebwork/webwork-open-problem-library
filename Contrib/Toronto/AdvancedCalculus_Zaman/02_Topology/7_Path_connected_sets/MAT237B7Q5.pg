##DESCRIPTION
## Manifold form problem, MAT237 B7 worksheet 5.1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'topology')

## DBsubject('Multivariable Calculus')
## DBchapter('Topology')
## DBsection('Continuity')
## Date('10/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('B7')
## Problem1('5.1')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

Context("Numeric");

# Create and use pop up lists 
$tf = new_select_list();
$tf->rf_print_q(~~&pop_up_list_print_q);

# Choices presented to students
$tf->ra_pop_up_list( [ 
"No answer" => "?", 
"Path-connected" => "Path-connected", 
"Not path-connected" => "Not path-connected", 
]);

# Questions and answers
$tf -> qa ( 
"\( \mathbb{R}^n\backslash\lbrace 0 \rbrace, n\geq 2\)", "Path-connected",
"\( [0,1]^2\cup [2,3]^2 \)", "Not path-connected",
"\( \mathbb{R}\backslash\lbrace 0 \rbrace \)", "Not path-connected",
"\( \lbrace(x,x^2): 9<x<137\rbrace \)", "Path-connected",
"\( \lbrace(x,y,z)\in\mathbb{R}^3: x\neq 0\rbrace \)", "Not path-connected",
);

# How many questions to use
$tf->choose(5);

Context()->texStrings;
BEGIN_TEXT
Which of the following sets are path-connected?
$BR
\{ $tf -> print_q() \}
END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4,5];
$ENV{'grader_scores'} = [0.2,0.4,0.6,0.8,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( str_cmp( $tf->ra_correct_ans() ) );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:${PAR}
You could put an explanation here.
END_SOLUTION
Context()->normalStrings;

COMMENT("MathObject version.");

ENDDOCUMENT();