##DESCRIPTION
##  Curves basics problem, MAT237 B8 worksheet Q2
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'topology', 'extreme value theorem', 'global maximum’, 'global minimum)

## DBsubject('Multivariable Calculus')
## DBchapter('Topology')
## DBsection('Extreme value theorem')
## Date('10/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('B8')
## Problem1('2')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

Context("Numeric");

# Create and use pop up lists 
$tf = new_select_list();
$tf->rf_print_q(~~&pop_up_list_print_q);

# Choices presented to students
$tf->ra_pop_up_list( [ 
"No answer" => "?", 
"EVT applies"  => "EVT applies", 
"EVT does not apply" => "EVT does not apply",
]);

# Questions and answers
$tf -> qa ( 
"\( f(x,y,z) = x+yz + \dfrac{1}{1-x^2-y^2-z^2}\mbox{ on }A = B_1(0)\)",
"EVT does not apply",
"\( g(x,y) = xy^2 + xy + x\mbox{ on }A = \lbrace(x,y) \in \mathbb{R}^2 : x^2-y^2 \leq 1\rbrace \)",
"EVT does not apply",
"\( h(x,y) = e^{-x^2-y^2}\mbox{ on }A = \mathbb{R}^2 \)",
"EVT does not apply",
);

# How many questions to use
$tf->choose(3);

Context()->texStrings;
BEGIN_TEXT
Determine whether EVT applies to each of the following optimization scenarios.
$BR
\{ $tf -> print_q() \}
END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3];
$ENV{'grader_scores'} = [0.33,0.67,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( str_cmp( $tf->ra_correct_ans() ) );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:${PAR}
You could put an explanation here.
END_SOLUTION
Context()->normalStrings;

COMMENT("MathObject version.");

ENDDOCUMENT();