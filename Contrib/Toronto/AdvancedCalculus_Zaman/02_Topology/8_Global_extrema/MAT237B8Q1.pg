##DESCRIPTION
##  Curves basics problem, MAT237 B8 worksheet Q1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'topology', 'extreme value theorem', 'global maximum’, 'global minimum)

## DBsubject('Multivariable Calculus')
## DBchapter('Fundamentals')
## DBsection('Curves')
## Date('10/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('B8')
## Problem1('1')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
);

TEXT(beginproblem());

#
#  Create a matching list and use popups
#
$ml = new_match_list();
$ml->rf_print_q(~~&pop_up_list_print_q);
$ml->ra_pop_up_list([
"No answer" => "?",
"A" => "A", 
"B" => "B", 
"C" => "C", 
"D" => "D", 
]);

#
#  Add correct questions and answers
#
$ml->qa(
"\( A=\overline{B_1(0)} \) in \(\mathbb{R}^n \)", "\(f\) always has both maximum and minimum on \(A\)",
"\( A=\lbrace(x,y)\in\mathbb{R}^2: x^2-y^2\leq 1\rbrace \)", "Cannot make conclusion",
"\( A=B_1(0)\backslash\lbrace 0\rbrace \) in \(\mathbb{R}^n\)", "Cannot make conclusion",
);
$ml->choose(3);

#
#  Add extra incorrect answers
#
$ml->extra(
"\(f\) only has maximum on \(A\)", 
"\(f\) only has minimum on \(A\)", 
);
$ml->choose_extra(2);
  
$ml->makeLast("\(f\) always has both maximum and minimum on \(A\)",
"\(f\) only has maximum on \(A\)", 
"\(f\) only has minimum on \(A\)",
"Cannot make conclusion");
Context()->texStrings;
BEGIN_TEXT
Let \( A\subseteq\mathbb{R}^n \) and \( f: A\to\mathbb{R} \) be continuous. For each set \(A\), does \(f\) always have a maximum and minimum on \(A\)?
\{ ColumnMatchTable($ml, valign=>'TOP') \}
END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3];
$ENV{'grader_scores'} = [0.33,0.67,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( str_cmp( $ml->ra_correct_ans ) );

@correct = @{$ml->ra_correct_ans()};
$answerstring = join(", ", @correct);
Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answers are $answerstring
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();