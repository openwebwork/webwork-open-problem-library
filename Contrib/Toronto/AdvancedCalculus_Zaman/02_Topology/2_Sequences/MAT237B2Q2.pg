##DESCRIPTION
##  Curves basics problem, MAT237 B2 worksheet Q2
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'sequences', 'topology')

## DBsubject('Multivariable Calculus')
## DBchapter('Topology')
## DBsection('Sequences')
## Date('27/6/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('B2')
## Problem1('2')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

Context("Numeric");

# Create and use pop up lists 
$tf = new_select_list();
$tf->rf_print_q(~~&pop_up_list_print_q);

# Choices presented to students
$tf->ra_pop_up_list( [ 
"No answer" => "?", 
"Equivalent"  => "Equivalent", 
"Not Equivalent" => "Not Equivalent",
]);

# Questions and answers
$tf -> qa ( 
"\( \forall\epsilon>0, \exists K\in\mathbb{N} \) s.t. \(k\geq K\implies x(k)\in B_\epsilon(p) \)",
"Equivalent",
"\( \forall\epsilon>0, \exists K\in\mathbb{N} \) s.t. \( \{ x(k) \}_{k=1}^K \cap B_\epsilon(p)=\emptyset \)",
"Not Equivalent",
"\( \forall\epsilon>0, \exists K\in\mathbb{R} \) s.t. \( \{ x(k) \}_{k=K}^\infty\subseteq B_\epsilon(p) \)",
"Equivalent",
"\( \forall\epsilon>0, B_\epsilon(p) \) contains all the elements of the sequence. \( \{ x(k) \}_{k=1}^\infty \) except finitly many",
"Equivalent",
"Every open ball containing \(p\) contains all but finitely many points of the sequence \( \{ x(k) \}_{k=1}^\infty \)",
"Equivalent",
);

# How many questions to use
$tf->choose(5);

Context()->texStrings;
BEGIN_TEXT
Recall this equivalent viewpoint of a convergent sequence:
$BR
A sequence {\(x(k)\)} in \(\mathbb{R}^n\) converges to \(p\) if every open ball centered at \(p\) contains all but finitely many points if the sequence {\(x(k)\)}.
$BR
Let {\(x(k)\)} be a sequence in \(\mathbb{R}^n\). Let \(p\in\mathbb{R}^n\). Which statements are equivalent to "\(x(k)\to p\)"?
$BR
\{ $tf -> print_q() \}
END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4,5];
$ENV{'grader_scores'} = [0.2,0.4,0.6,0.8,1];
$ENV{'grader_message'} = "You can earn partial credits";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( str_cmp( $tf->ra_correct_ans() ) );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:${PAR}
You could put an explanation here.
END_SOLUTION
Context()->normalStrings;

COMMENT("MathObject version.");

ENDDOCUMENT();