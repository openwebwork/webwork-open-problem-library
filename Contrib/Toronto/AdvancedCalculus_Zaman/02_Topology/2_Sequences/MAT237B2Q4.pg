DOCUMENT();  

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"unionLists.pl",
);

TEXT(beginproblem());
# (a)
$mc1 = new_checkbox_multiple_choice();

$mc1 -> qa (
"a", 
"Line 1", "Line 2", "Line 3", "Line 4",         
);

$mc1 -> makeLast("Line 1", "Line 2", "Line 3", "Line 4", "Line 5", "Line 6",);
# (b)
$mc2 = new_checkbox_multiple_choice();

$mc2 -> qa (
"b", 
"Line 5", "Line 6",   
);

$mc2 -> makeLast("Line 1", "Line 2", "Line 3", "Line 4", "Line 5", "Line 6",);

Context()->texStrings;
BEGIN_TEXT
The \(\Leftarrow\) proof of Lemma 2.3.14 is probably confusing to read at first. Here is an informal yet concise summary:

\{ BeginList('OL', type=>'a') \}

$ITEM If each sequence \( x_i(k) \) is in \(\mathbb{R}\) converges then each coordinate is eventually close to its limit \(a_i\).

$ITEMSEP
$ITEM Since the distance between two points in \(\mathbb{R}^n\) is at most \(n\) times the maximum distance between the coordinates, the sequence \(x(k)\) in \(\mathbb{R}^n\) must be eventually close to its limit \( a=(a_1,\ldots,a_n) \).

\{ EndList('OL') \}
$PAR
$BCENTER
\{ image( "b2-proof.jpg", width=>800, height=>400, tex_size=>300, extra_html_tags=>'alt="curve"' ) \}
$ECENTER
$BR
\{ $mc1 -> print_q() \}
$BR
\{ $mc1 -> print_a() \}
$BR
\{ $mc2 -> print_q() \}
$BR
\{ $mc2 -> print_a() \}
END_TEXT
Context()->normalStrings;

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();