##DESCRIPTION
##  Compactness problem, MAT237 B4 worksheet Q1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'compactness', 'topology')

## DBsubject('Multivariable Calculus')
## DBchapter('Topology')
## DBsection('Open sets and closed sets')
## Date('2/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('B4')
## Problem1('1')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

Context("Numeric");

# Create and use pop up lists 
$tf = new_select_list();
$tf->rf_print_q(~~&pop_up_list_print_q);

# Choices presented to students
$tf->ra_pop_up_list( [ 
"No answer" => "?", 
"Compact"  => "Compact", 
"Not Compact" => "Not Compact",
]);

# Questions and answers
$tf -> qa ( 
"\( \{(x,y)\in\mathbb{R}^2: x^2+y^2\leq 1\} \)",
"Compact",
"\( \{(x,y)\in\mathbb{R}^2: x^2-y^2\leq 1\} \)",
"Not Compact",
"\( B_2(0)\) ",
"Not Compact",
"\( \overline{B_2(0)}\backslash B_1(0) \)",
"Compact",
"\( \{\frac{1}{n}: n\in\mathbb{N}^+\} \)",
"Not Compact",
"\( \{a\} \) for a fixed \( a\in\mathbb{R}^n \)",
"Compact",
);

# How many questions to use
$tf->choose(6);

Context()->texStrings;
BEGIN_TEXT
Which of the following sets are compact?
$BR
\{ $tf -> print_q() \}
END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [2,4,6];
$ENV{'grader_scores'} = [0.3,0.6,1];
$ENV{'grader_message'} = "You can earn " .
"30% partial credit for 2 - 3 correct answers, and " .
"60% partial credit for 4 - 5 correct answers.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( str_cmp( $tf->ra_correct_ans() ) );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:${PAR}
You could put an explanation here.
END_SOLUTION
Context()->normalStrings;

COMMENT("MathObject version.");

ENDDOCUMENT();