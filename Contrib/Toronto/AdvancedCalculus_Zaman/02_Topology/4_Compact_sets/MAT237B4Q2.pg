##DESCRIPTION
##  Compactness problem, MAT237 B4 worksheet Q2
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'compactness', 'topology')

## DBsubject('Multivariable Calculus')
## DBchapter('Topology')
## DBsection('Open sets and closed sets')
## Date('2/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('B4')
## Problem1('2')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

Context("Numeric");

# Create and use pop up lists 
$tf = new_select_list();
$tf->rf_print_q(~~&pop_up_list_print_q);

# Choices presented to students
$tf->ra_pop_up_list( [ 
"No answer" => "?", 
"Equivalent"  => "Equivalent", 
"Not Equivalent" => "Not Equivalent",
]);

# Questions and answers
$tf -> qa ( 
"\(S\) contains all its limit points.",
"Not Equivalent",
"There exists \( r>0 \) such that \( S\subseteq\{x\in\mathbb{R}^n: ||x||\leq r\} \).",
"Not Equivalent",
"Any subset of \(S\) has a limit point.",
"Not Equivalent",
"Any sequence in \(S\) converges with its limit lying in \(S\).",
"Not Equivalent",
"Any sequence in \(S\) has a convergent subsequence with its limit lying in \(S\).",
"Equivalent",
"\(S\) is bounded and closed.",
"Equivalent",
"\(S\) is bounded and not open.",
"Not Equivalent",
"\(S^c\) is unbounded and open.",
"Not Equivalent",
);

# How many questions to use
$tf->choose(8);

Context()->texStrings;
BEGIN_TEXT
Which statements are equivalent to "\(S\) is a compact set"?
$BR
\{ $tf -> print_q() \}
END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4,5,6,7,8];
$ENV{'grader_scores'} = [0.125,0.25,0.375,0.5,0.625,0.75,0.825,1];
$ENV{'grader_message'} = "You can earn partial credits";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( str_cmp( $tf->ra_correct_ans() ) );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:${PAR}
You could put an explanation here.
END_SOLUTION
Context()->normalStrings;

COMMENT("MathObject version.");

ENDDOCUMENT();