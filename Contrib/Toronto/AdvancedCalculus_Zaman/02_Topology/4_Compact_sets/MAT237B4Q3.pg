##DESCRIPTION
##  Compactness problem, MAT237 B4 worksheet Q3
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'compactness', 'topology')

## DBsubject('Multivariable Calculus')
## DBchapter('Topology')
## DBsection('Open sets and closed sets')
## Date('2/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('B4')
## Problem1('3')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

Context("Numeric");

# Create and use pop up lists 
$tf = new_select_list();
$tf->rf_print_q(~~&pop_up_list_print_q);

# Choices presented to students
$tf->ra_pop_up_list( [ 
"No answer" => "?", 
"True"  => "True", 
"False" => "false",
]);

# Questions and answers
$tf -> qa ( 
"Every subset \(A\) of a compact set \(B\) is closed.",
"False",
"Every subset \(A\) of a compact set \(B\) is bounded.",
"True",
"Every bounded subset \(A\) of a closed set \(B\) is compact.",
"False",
"If \(A\) is closed and \(B\) is not comapct then \(A\cap B\) is not compact.",
"False",
"If \(A\) and \(B\) are bounded then \(A\cup B\) is bounded.",
"True",
"If \(S\) is compact then \(\overline{S}\) is compact.",
"True",
"If \(S\) is compact (in \(\mathbb{R}^n\) then \(S\times[0,1]\) is compact (in \(\mathbb{R}^{n+1}).",
"True",
);

# How many questions to use
$tf->choose(7);

Context()->texStrings;
BEGIN_TEXT
Which statements are true or false?
$BR
\{ $tf -> print_q() \}
END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4,5,6,7];
$ENV{'grader_scores'} = [0.14,0.28,0.43,0.57,0.71,0.86,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( str_cmp( $tf->ra_correct_ans() ) );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:${PAR}
You could put an explanation here.
END_SOLUTION
Context()->normalStrings;

COMMENT("MathObject version.");

ENDDOCUMENT();