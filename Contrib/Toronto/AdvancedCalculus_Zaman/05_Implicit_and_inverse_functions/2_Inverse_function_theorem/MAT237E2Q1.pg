## DESCRIPTION
## Inverse function theorem
## ENDDESCRIPTION

## DBsubject('Calculus - multivariable')
## DBchapter('Differentiation of multivariable functions')
## DBsection('Inverse function theorem')

########################################################################

DOCUMENT();

loadMacros(
   "PGstandard.pl",     # Standard macros for PG language
   "PGchoicemacros.pl"
);

TEXT(beginproblem());

$showPartialCorrectAnswers = 0;

##############################################################
#
#  Setup

$mc = new_checkbox_multiple_choice();
$mc -> qa("Let \( L: \mathbb{R}^n \to \mathbb{R}^n \) be the linear map given by \( L(x) = Ax \). In which cases is \( L \) invertible?", "\begin{bmatrix}1 & 2 & 3\\0 & 4 & 5\\0 & 0 & 6\end{bmatrix}", "\( L \) is a surjective map", "\( L \) is an injective map");
$mc -> makeLast("\begin{bmatrix}1 & 3\\2 & 6\end{bmatrix}", "\begin{bmatrix}1 & 0 & 1 & 0\\1 & 2 & 3 & 4\\-2 & 0 & -2 & 0\\5 & 6 & 7 & 8\end{bmatrix}", "\begin{bmatrix}1 & 2 & 3\\0 & 4 & 5\\0 & 0 & 6\end{bmatrix}", "A has eigenvalues \( −237,0,237 \)", "\( L \) is a surjective map", "\( L \) is an injective map");

##############################################################
#
#  Text

BEGIN_TEXT
$BR
\{ $mc -> print_q() \}
$BR
\{ $mc -> print_a() \}
END_TEXT

$showHints = 1;
BEGIN_HINT
You do not need to calculate any determinants.
END_HINT

##############################################################
#
#  Answers

install_problem_grader(~~&std_problem_grader);
ANS( checkbox_cmp( $mc->correct_ans() ) );

ENDDOCUMENT();