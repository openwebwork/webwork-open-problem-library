## DESCRIPTION
## Smooth manifolds and implicit form
## ENDDESCRIPTION

## DBsubject('Calculus - multivariable')
## DBchapter('Differentiation of multivariable functions')
## DBsection('Smooth manifolds and implicit form')

DOCUMENT();

loadMacros("PGstandard.pl", "PGchoicemacros.pl");

TEXT(beginproblem());

$mc = new_checkbox_multiple_choice();
$mc -> qa(
"Which statements are true?", "Every set written in explicit form can also be written in implicit form.", "Every set written in explicit form using a \(C^1\) function is a smooth manifold."
);
$mc -> makeLast(
"Every set written in explicit form can also be written in implicit form.", "Every set written in implicit form can also be written in explicit form.", "Every set written in explicit form using a \(C^1\) function is a smooth manifold.", "Every set written in implicit form using a \(C^1\) function is a smooth manifold."
);

BEGIN_TEXT
$BR
\{ $mc -> print_q() \}
$BR
\{ $mc -> print_a() \}
END_TEXT

ANS( checkbox_cmp( $mc->correct_ans() ) );

$showPartialCorrectAnswers = 0;
BEGIN_SOLUTION
$BR
A. True.
$BR
B. False. The unit circle is a counterexample.
$BR
C. True.
$BR
D. False. You need another condition for your map.
END_SOLUTION

ENDDOCUMENT();