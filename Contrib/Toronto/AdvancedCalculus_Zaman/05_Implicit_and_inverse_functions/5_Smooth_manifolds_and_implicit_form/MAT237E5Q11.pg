## DESCRIPTION
## Smooth manifolds and implicit form
## ENDDESCRIPTION

## DBsubject('Calculus - multivariable')
## DBchapter('Differentiation of multivariable functions')
## DBsection('Smooth manifolds and implicit form')

DOCUMENT();

loadMacros("PGstandard.pl", "PGchoicemacros.pl", "PGML.pl");

TEXT(beginproblem());

$mc = new_checkbox_multiple_choice();
$mc -> qa(
"Fix \( p \in S \) and \( v \in \mathbb{R}^n \). Which statements are true?", "If \( \nabla f(p) \neq 0 \), then the set of tangent vectors of \( S \) at \( p \) form an \( (n-1) \)-dimensional subspace of \( \mathbb{R}^n \).", "If \( v \) is a tangent vector of \( S \) at \( p \), then \( \nabla f(p) \cdot v = 0 \)."
);
$mc -> makeLast(
"The set \( \{ x \in \mathbb{R}^n: \nabla f(p) \cdot (x-p) = 0\} \) is the tangent plane of \( S \) at \( p \).", "If \( \nabla f(p) \neq 0 \), then the set of tangent vectors of \( S \) at \( p \) form an \( (n-1) \)-dimensional subspace of \( \mathbb{R}^n \).", "If \( v \) is a tangent vector of \( S \) at \( p \), then \( \nabla f(p) \cdot v = 0 \).", "If \( \nabla f(p) \cdot v = 0 \), then \( v \) is a tangent vector of \( S \) at \( p \)."
);

BEGIN_PGML


Let [` f: \mathbb{R}^n \to \mathbb{R} `] be [` C^1 `]. Assume [` S = \{ x \in \mathbb{R}^n: f(x) = 0 \} `] is non-empty.

[@ $mc -> print_q() @]*

[@ $mc -> print_a() @]*
END_PGML

ANS( checkbox_cmp( $mc->correct_ans() ) );

$showPartialCorrectAnswers = 0;
BEGIN_SOLUTION
$BR
A. False.
$BR
B. True.
$BR
C. True. What happens if \( \nabla f(p) = 0 \)?
$BR
D. False.
END_SOLUTION

ENDDOCUMENT();