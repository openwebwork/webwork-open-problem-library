## DESCRIPTION
## Smooth manifolds and implicit form
## ENDDESCRIPTION

## DBsubject('Calculus - multivariable')
## DBchapter('Differentiation of multivariable functions')
## DBsection('Smooth manifolds and implicit form')

DOCUMENT();

loadMacros("PGstandard.pl", "PGchoicemacros.pl");

TEXT(beginproblem());

$showPartialCorrectAnswers = 0;

$mc = new_checkbox_multiple_choice();
$mc -> qa(
"If possible, use Theorem A (or Corollary A) to determine which sets are smooth manifolds, and select them below.", "\( S \) is the zero level set of the function \( F(x,y) = x^2 + 2xy + xy^3+1 \).", "\( S \) is the zero level set of the function \( H(x,y,z) = x^2 + 4xyz + xy^5+1 \).", "\( S \) is the explicit surface defined by \( z=\cos(x)\sin(y) \)."
);
$mc -> makeLast(
"\( S \) is the zero level set of the function \( F(x,y) = x^2 + 2xy + xy^3+1 \).", "\( S \) is the zero level set of the function \( G(x,y,z) = x^2 + y^2 - z^2 \).", "\( S \) is the zero level set of the function \( H(x,y,z) = x^2 + 4xyz + xy^5+1 \).", "\( S \) is the explicit surface defined by \( z=\cos(x)\sin(y) \)."
);

BEGIN_TEXT
$BR
\{$mc -> print_q()\}
$BR
\{$mc -> print_a()\}
END_TEXT

ANS( checkbox_cmp($mc->correct_ans()) );

ENDDOCUMENT();