## DESCRIPTION
## Smooth manifolds and implicit form
## ENDDESCRIPTION

## DBsubject('Calculus - multivariable')
## DBchapter('Differentiation of multivariable functions')
## DBsection('Smooth manifolds and implicit form')

DOCUMENT();

loadMacros("PGstandard.pl", "PGchoicemacros.pl");

TEXT(beginproblem());

$showPartialCorrectAnswers = 0;

$mc = new_checkbox_multiple_choice();
$mc -> qa(
"An \( m\times n \) matrix \(A\) has $BBOLD full rank $EBOLD if \( \mathrm{rank} \; A = \min\{m,n\} \). Which of the following matrices are full rank?", "\( \begin{bmatrix} 1 & 0 \\ 0 & 1 \end{bmatrix} \)", "\( \begin{bmatrix} 1 & 0 & 1 & 0 \\ 0 & 1 & -1 & 0 \end{bmatrix} \)", "\( \begin{bmatrix} 1 & 1 & 0 & 0 \\ 0 & -1 & 1 & 0 \end{bmatrix} \)", "\( \begin{bmatrix} 1 & 0 & 3 \end{bmatrix} \)", "\( \begin{bmatrix} 1 & 2 \\ 3 & 4 \\ 5 & 6 \\ 7 & 8 \end{bmatrix} \)"
);
$mc -> makeLast(
"\( \begin{bmatrix} 1 & 0 \\ 0 & 1 \end{bmatrix} \)", "\( \begin{bmatrix} 1 & 0 \\ -1 & 0 \end{bmatrix} \)", "\( \begin{bmatrix} 1 & 0 & 1 & 0 \\ 0 & 1 & -1 & 0 \end{bmatrix} \)", "\( \begin{bmatrix} 1 & 1 & 0 & 0 \\ 0 & -1 & 1 & 0 \end{bmatrix} \)", "\( \begin{bmatrix} 1 & 0 & 3 \end{bmatrix} \)", "\( \begin{bmatrix} 1 & 2 \\ 3 & 4 \\ 5 & 6 \\ 7 & 8 \end{bmatrix} \)"
);

BEGIN_TEXT
$BR
\{ $mc -> print_q() \}
$BR
\{ $mc -> print_a() \}
END_TEXT

ANS( checkbox_cmp( $mc->correct_ans() ) );

ENDDOCUMENT();