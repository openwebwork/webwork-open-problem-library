## DESCRIPTION
## Diffeomorphisms
## ENDDESCRIPTION

## DBsubject('Calculus - multivariable')
## DBchapter('Differentiation of multivariable functions')
## DBsection('Diffeomorphisms')

DOCUMENT();

loadMacros("PGstandard.pl", "PGchoicemacros.pl");

TEXT(beginproblem());

$mc = new_checkbox_multiple_choice();
$mc -> qa("Which statements below are necessarily false?", "\( F([0,1]) = (137,237) \)", "\( F((137,237)) = [0,1] \)", "\( G(\{ (x,y) \in \mathbb{R}^2 : y \neq 0 \}) = \{ (x,y) \in \mathbb{R}^2 : x^2 + y^2 < 1\} \)", "\( H([0,1]^3) =  \{ (x,y,z) \in \mathbb{R}^3 : x \geq 0, y \geq 0, z \geq 0\} \)");
$mc -> makeLast("\( F([0,1]) = (137,237) \)", "\( F((137,237)) = [0,1] \)", "\( G(\{ (x,y) \in \mathbb{R}^2 : y \neq 0 \}) = \{ (x,y) \in \mathbb{R}^2 : x^2 + y^2 < 1\} \)", "\( H([0,1]^3) =  \{ (x,y,z) \in \mathbb{R}^3 : x \geq 0, y \geq 0, z \geq 0\} \)");

BEGIN_TEXT
Diffeomorphisms are fantastic since they preserve the properties of many sets. Let
$PAR
$BCENTER
\( F : \mathbb{R} \to \mathbb{R}, \qquad G : \mathbb{R}^2 \to \mathbb{R}^2, \qquad H : \mathbb{R}^3 \to \mathbb{R}^3 \)
$ECENTER
be diffeomorphisms.
$PAR
\{ $mc -> print_q() \}
$BR
\{ $mc -> print_a() \}
END_TEXT

$showPartialCorrectAnswers = 0;
ANS( checkbox_cmp( $mc->correct_ans()) );

ENDDOCUMENT();