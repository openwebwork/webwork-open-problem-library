## DESCRIPTION
## Diffeomorphisms
## ENDDESCRIPTION

## DBsubject('Calculus - multivariable')
## DBchapter('Differentiation of multivariable functions')
## DBsection('Diffeomorphisms')

################################################################

DOCUMENT();

loadMacros(
   "PGstandard.pl",     # Standard macros for PG language
   "PGchoicemacros.pl"
);

TEXT(beginproblem());

################################################################
#
#  Setup

$mc1 = new_checkbox_multiple_choice();
$mc1 -> qa("1. Which of \( F,G,H \) appear to be a diffeomorphism?", "None of the above");
$mc1 -> makeLast("\( F \)", "\( G \)", "\( H \)", "None of the above");

$mc2 = new_checkbox_multiple_choice();
$mc2 -> qa("2. Which of \( F,G,H \) appear to be a local diffeomorphism at \( 0 \)?", "\( F \)");
$mc2 -> makeLast("\( F \)", "\( G \)", "\( H \)", "None of the above");

$mc3 = new_checkbox_multiple_choice();
$mc3 -> qa("3. Which of \( F,G,H \) appear to be a local diffeomorphism at \( 1 \)?", "\( F \)", "\( G \)", "\( H \)");
$mc3 -> makeLast("\( F \)", "\( G \)", "\( H \)", "None of the above");

################################################################
#
#  Text

BEGIN_TEXT
$BR
Consider the three functions \( F,G,H \).
$PAR
$BCENTER
\{ image("e1-local-diffeos.png", width=>800) \}
$ECENTER
$BR
\{ $mc1 -> print_q() \}
$BR
\{ $mc1 -> print_a() \}
$BR
\{ $mc2 -> print_q() \}
$BR
\{ $mc2 -> print_a() \}
$BR
\{ $mc3 -> print_q() \}
$BR
\{ $mc3 -> print_a() \}
END_TEXT

################################################################
#
#  Answers

ANS( checkbox_cmp( $mc1->correct_ans()) );
ANS( checkbox_cmp( $mc2->correct_ans()) );
ANS( checkbox_cmp( $mc3->correct_ans()) );

BEGIN_SOLUTION
1. None. \( F \) and \( G \) are not invertible and \( H \) is invertible but not \( C^1 \).
$BR
2. Only \( F \) is a local diffeomorphism at \( 0 \).
$BR
3. All three are local diffeomorphisms at \( 1 \).
END_SOLUTION

ENDDOCUMENT();