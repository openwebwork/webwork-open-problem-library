## DESCRIPTION
## Diffeomorphisms
## ENDDESCRIPTION

## DBsubject('Calculus - multivariable')
## DBchapter('Differentiation of multivariable functions')
## DBsection('Diffeomorphisms')

################################################################

DOCUMENT();

loadMacros("PGstandard.pl", "PGchoicemacros.pl", "parserPopUp.pl", "parserRadioButtons.pl");

TEXT(beginproblem());

################################################################
#
#  Setup

$mc1 = new_checkbox_multiple_choice();
$mc1 -> qa("Which of these maps is a diffeomorphism?", "\( F|_U \)", "\( F|_V \)");
$mc1 -> makeLast("\( F|_U \)", "\( F|_V \)", "\( F|_W \)");

$mc2 = PopUp(["?", "Yes", "No"], "Yes");

$mc3 = RadioButtons(["\( (0,\infty) \)", "\( [0,\infty) \)", "\( (0.5,\infty) \)", "\( (-\infty, \infty) \)"], "\( (0,\infty) \)");

################################################################
#
#  Text

BEGIN_TEXT
$BR
Define \( F: \mathbb{R} \to \mathbb{R} \) by \( F(x) = x^2 \). Consider three different open sets \( U,V,W \subseteq \mathbb{R} \).
$PAR
$BCENTER
\( U = (0.4,0.6) \) \{ image("e1-u-small.png", width=>300) \}
$BR$BR
\( V = (0,1) \) \{ image("e1-u-medium.png", width=>300) \}
$BR$BR
\( W = (−0.5,1.5) \) \{ image("e1-u-large.png", width=>300) \}
$ECENTER
$PAR
All of these sets contain the point \( a = 0.5 \). Use the above \{ htmlLink("https://www.desmos.com/calculator/39guklm24p", "Desmos figures") \} for each part below.
$PAR
1. Consider the maps
$BCENTER
\( F|_U: U \to F(U) \hspace{1cm} F|_V: V \to F(V) \hspace{1cm} F|_W: W \to F(W) \).
$ECENTER
$PAR
\{ $mc1 -> print_q() \}
$BR
\{ $mc1 -> print_a() \}
$PAR
2. Is \( F \) a local diffeomorphism at \( a = 0.5 \)? \{ $mc2->menu() \}
$PAR
3. State the largest open set \( S \subseteq \mathbb{R} \) such that \( a \in S \) and \( F|_S: S \to F(S) \) is a diffeomorphism.
$PAR
\{ $mc3->buttons() \}
END_TEXT

################################################################
#
#  Answers

ANS( checkbox_cmp( $mc1->correct_ans()) );
ANS( $mc2->cmp() );
ANS( $mc3->cmp() );

ENDDOCUMENT();