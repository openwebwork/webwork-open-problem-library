## DESCRIPTION
## Lagrange multipliers
## ENDDESCRIPTION

## DBsubject('Calculus - multivariable')
## DBchapter('Differentiation of multivariable functions')
## DBsection('Lagrange multipliers')

################################################################

DOCUMENT();

loadMacros("PGstandard.pl", "PGchoicemacros.pl", "PGML.pl");

TEXT(beginproblem());

$showPartialCorrectAnswers = 0;

################################################################
#
#  Setup

$mc_1 = new_checkbox_multiple_choice();
$mc_1 -> qa("Which of \( a,b,c,d \in S \) appear to be local extrema of \(f\)?", "None");
$mc_1 -> makeLast("\(a\)", "\(b\)", "\(c\)", "\(d\)", "None");

$mc_2 = new_checkbox_multiple_choice();
$mc_2 -> qa("Which of \( a,b,c,d \in S \) appear to be critical points of \(f\)?", "None");
$mc_2 -> makeLast("\(a\)", "\(b\)", "\(c\)", "\(d\)", "None");

$mc_3 = new_checkbox_multiple_choice();
$mc_3 -> qa("Which of \( a,b,c,d \in S \) appear to be local extrema of \(f\) on \(S\)?", "\(a\)", "\(c\)");
$mc_3 -> makeLast("\(a\)", "\(b\)", "\(c\)", "\(d\)", "None");

$mc_4 = new_checkbox_multiple_choice();
$mc_4 -> qa("Which of \( a,b,c,d \in S \) would be solutions to the Lagrange multipliers system for optimizing \(f\) on \(S\)?", "\(a\)", "\(b\)", "\(c\)");
$mc_4 -> makeLast("\(a\)", "\(b\)", "\(c\)", "\(d\)", "None");

################################################################
#
#  Text

BEGIN_PGML


Define [` f(x,y) = -xy+y `] and [` g(x,y)= x^2/4 + (y-1)^2 `]. Define the set

>>[` S = \{ (x,y) \in \mathbb{R}^2 : g(x,y)=1\} `].<<

The graph of [` z=f(x,y) `] and the graph of [` z = f|_S(x,y) `] are shown below.

>>[@ image("e6-local-extrema-subset.png", width=>650) @]*<<

View this [@ htmlLink("https://www.math3d.org/k0AQJH9yo", "Math3D demo") @]* to better see the points on the graph corresponding to [` a,b,c,d \in S `].

[@$mc_1 -> print_q()@]*
[@$mc_1 -> print_a()@]*

[@$mc_2 -> print_q()@]*
[@$mc_2 -> print_a()@]*

[@$mc_3 -> print_q()@]*
[@$mc_3 -> print_a()@]*

[@$mc_4 -> print_q()@]*
[@$mc_4 -> print_a()@]*
END_PGML

################################################################
#
#  Answers

ANS( checkbox_cmp($mc_1->correct_ans()) );
ANS( checkbox_cmp($mc_2->correct_ans()) );
ANS( checkbox_cmp($mc_3->correct_ans()) );
ANS( checkbox_cmp($mc_4->correct_ans()) );

ENDDOCUMENT();