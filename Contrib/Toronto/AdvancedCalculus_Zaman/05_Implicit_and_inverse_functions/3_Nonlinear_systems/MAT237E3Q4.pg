## DESCRIPTION
## Nonlinear systems
## ENDDESCRIPTION

## DBsubject('Calculus - multivariable')
## DBchapter('Differentiation of multivariable functions')
## DBsection('Nonlinear systems')

################################################################

DOCUMENT();

loadMacros("PGstandard.pl", "PGchoicemacros.pl");

TEXT(beginproblem());

$showPartialCorrectAnswers = 0;

################################################################
#
#  Setup

$mc1 = new_checkbox_multiple_choice();
$mc1 -> qa("At which points does the equation locally define \(y\) as a \(C^1\) function of x?", "C", "E");
$mc1 -> makeLast("A", "B", "C", "D", "E", "None of the above");

$mc2 = new_checkbox_multiple_choice();
$mc2 -> qa("At which points does the equation locally define \(x\) as a \(C^1\) function of y?", "B", "E");
$mc2 -> makeLast("A", "B", "C", "D", "E", "None of the above");

################################################################
#
#  Text

BEGIN_TEXT
$BR
Below is a plot of a curve in \( \mathbb{R}^2 \) defined by \( F(x,y) = 0 \). Five points \( A,B,C,D,E \) are listed on the curve.
$PAR
$BCENTER
\{ image("e3-curve-points.jpg", width=>400) \}
$ECENTER
$PAR
\{ $mc1 -> print_q() \}
$BR
\{ $mc1 -> print_a() \}
$PAR
\{ $mc2 -> print_q() \}
$BR
\{ $mc2 -> print_a() \}
END_TEXT

##############################################################
#
#  Answers

ANS( checkbox_cmp( $mc1->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );

ENDDOCUMENT();