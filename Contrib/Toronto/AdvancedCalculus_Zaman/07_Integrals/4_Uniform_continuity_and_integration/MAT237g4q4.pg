## KEYWORDS('Uniform continuity')

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "PGgraders.pl",
  "PGcourse.pl"
);


TEXT(beginproblem());

##############################################
#  Setup

# Create and use pop up lists 
$tf = new_select_list();
$tf->rf_print_q(~~&pop_up_list_print_q);

# Specify choices presented to students
$tf->ra_pop_up_list( 
[ 
No_answer => "?", 
"Equivalent"=>"Equivalent", 
"Different"=>"Different"
] );

# Questions and answers
$tf -> qa ( 
" \(\displaystyle \forall \varepsilon >0, \exists \delta >0\) s.t. \(\displaystyle \forall x,y, \in D, ||x-y|| < \delta \implies ||f(x) - f(y)|| < \varepsilon\) $BR","True",

"\(\displaystyle \forall a \in D, \forall \varepsilon > 0 , \exists \delta > 0 \) s.t. \(\displaystyle \forall x \in D, ||x - a|| < \delta \implies ||f(x) - f(a)|| < \varepsilon\) $BR","False",

"\(\displaystyle \forall \varepsilon > 0, \forall a \in D, \exists \delta > 0 \) s.t. \(\displaystyle \forall x \in D, ||x - a|| < \delta \implies ||f(x) - f(a)|| < \varepsilon\) $BR","False",

"\( \displaystyle \forall \varepsilon>0, \exists \delta > 0\) s.t. \(\displaystyle \forall a \in D, || x- a|| < \delta \implies || f(x) - f(a)|| < \varepsilon\) $BR","True",

"\( \displaystyle \forall \varepsilon \in D, \exists \delta > 0\) s.t. \(\displaystyle \forall x \in D, \forall a \in D, ||x - a || < \delta \implies ||f(x) - f(a)|| < \varepsilon \)$BR","True",

"\( \displaystyle \forall a \in D, \forall \varepsilon > 0 , \exists \delta > 0\) s.t. \( \displaystyle f(B_{\delta}(a) \cap D) \subseteq B_{\varepsilon}(f(a))\)$BR","False",

"\( \displaystyle \forall \varepsilon > 0, \exists \delta > 0\) s.t. \(\displaystyle \forall a \in D, f(B_{\varepsilon}(a) \cap D) \subseteq B_{\varepsilon}(f(a))\)$BR","True",
);

# How many questions to use
$tf->choose(7);


##############################################
#  Main text

BEGIN_TEXT
Let \(f : D \to \mathbb{R}^m\) and \(D \subseteq \mathbb{R}^n\). Which of these are equivalent to " \(f\) is uniformly continuous on \(D\)"?
$BR
\{ $tf->print_q() \}
END_TEXT

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;


ANS(str_cmp($tf->ra_correct_ans));

ENDDOCUMENT();