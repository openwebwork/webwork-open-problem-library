## DESCRIPTION
## Determining uniform continuity of a function on an interval.  
## ENDDESCRIPTION


## DBsubject(Calculus - multivariable)
## DBchapter(Integration of multivariable functions)
## DBsection(Uniform continuity)
## Date()
## Institution()
## Author()
## MLT()
## MLTleader()
## Level()
## TitleText1('')
## AuthorText1('')
## EditionText1('')
## Section1('')
## Problem1('')
## TitleText2('')
## AuthorText2('')
## EditionText2('')
## Section2('')
## Problem2('')
## KEYWORDS('Uniform continuity')

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "PGgraders.pl",
  "PGcourse.pl"
);


TEXT(beginproblem());

##############################################
#  Setup

# Create and use pop up lists 
$tf = new_select_list();
$tf->rf_print_q(~~&pop_up_list_print_q);

# Specify choices presented to students
$tf->ra_pop_up_list( 
[ 
No_answer => "?", 
"True"=>"True", 
"False"=>"False"
] );

# Questions and answers
$tf -> qa ( 
" \(\displaystyle f(x) = x^2 \) is uniformly continuous on \( S = [0,1]\) $BR","True",

"\( \displaystyle f(x) = x^2 \) is uniformly continuous on \( S = \mathbb{R} \)$BR","False",
"\( \displaystyle g(x) = \frac{1}{||x||} \) is uniformly continuous on \( S = \{ x \in \mathbb{R}^n: 0 <||x|| \leq 3\} \)$BR","False",
"\( \displaystyle g(x) = \frac{1}{||x||} \) is uniformly continuous on \( S = \{ x \in \mathbb{R}^n: 1 \leq ||x|| \leq 3\} \)$BR","True",
"\( \displaystyle g(x) = \frac{1}{||x||} \) is uniformly continuous on \( S = \{ x \in \mathbb{R}^n: 1 < ||x|| \leq 3\}\)$BR","True",
);

# How many questions to use
$tf->choose(5);


##############################################
#  Main text

BEGIN_TEXT
Determine whether the following functions are uniformly continuous on the given intervals.
$BR
\{ $tf->print_q() \}
END_TEXT

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;


ANS(str_cmp($tf->ra_correct_ans));

ENDDOCUMENT();