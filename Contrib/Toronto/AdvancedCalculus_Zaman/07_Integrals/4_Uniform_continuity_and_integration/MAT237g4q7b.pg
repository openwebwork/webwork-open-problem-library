## Section1('1.1')
## Problem1('22')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"PGchoicemacros.pl",
"PGcourse.pl",
);

TEXT(beginproblem());
##############################################################
#
#  Setup
#
#
$mc = new_checkbox_multiple_choice();
$mc -> qa (
"This proof has false claims on two lines. Identify these two lines.",              
"Line 6$BR",
"Line 8$BR",                
);
$mc -> extra(
"Line 1$BR",
"Line 2$BR",                
"Line 3$BR",
"Line 4$BR",
"Line 5$BR",                
"Line 7$BR",               
"Line 9$BR"
);
$mc -> makeLast("Line 1$BR",
"Line 2$BR",                
"Line 3$BR",
"Line 4$BR",
"Line 5$BR",                
"Line 6$BR",
"Line 7$BR",
"Line 8$BR",                
"Line 9$BR",);

##############################################################
#
#  Text
#
#

BEGIN_TEXT
It can be helpful to re-prove theorems in special cases to better understand them. $BR
$BR
Consider the following theorem:$BR
Let \(f:[a,b] \to \mathbb{R}\). If \(f\) is continuous on \([a,b]\), then \(f\) is integrable on \([a,b]\).
$BR
$BR
Here is a WRONG proof of the theorem.
$BR
$BR
\{ image( "g4-q7.png", width=>1000, height=>750) \}
$BR
$BR
\{ $mc -> print_q() \}
$BR
\{ $mc -> print_a() \}

END_TEXT

##############################################################
#
#  Answers
#
#

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc->correct_ans() ) );

ENDDOCUMENT();     
