## KEYWORDS('Uniform continuity')

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "PGgraders.pl",
  "PGcourse.pl"
);


TEXT(beginproblem());

##############################################
#  Setup

# Create and use pop up lists 
$tf = new_select_list();
$tf->rf_print_q(~~&pop_up_list_print_q);

# Specify choices presented to students
$tf->ra_pop_up_list( 
[ 
No_answer => "?", 
"True"=>"True", 
"False"=>"False",
"Nonesense"=>"Nonesense" 
] );

# Questions and answers
$tf -> qa ( 
" If \(f\) is uniformly continuous at \(a\), then \(f\) is continuous at \(a\). $BR","Nonesense",

"If \(f\) is continuous on \(A\), then \(f\) is uniformly continuous on \(A\). $BR","False",

"If \(f\) is uniformly continuous on \(A\), then \(f\) is continuous on \(A\). $BR","True",

"If \(f\) is uniformly continuous on \(A\), then \(f\) is uniformly continuous on any subset of \(A\).$BR","True",

"If \(f\) is differentiable on \(A\), then \(f\) is continuous on \(A\).$BR","True",

"If \(f\) is differentiable on \(A\), then \(f\) is uniformly continuous on \(A\).$BR","False",
);

# How many questions to use
$tf->choose(6);


##############################################
#  Main text

BEGIN_TEXT
Let \(A \subseteq \mathbb{R}^n\) and \(a \in A \). Let \(f\) be an \(\mathbb{R}^m\)-valued function on \(A\). Which statements are true or false or nonsense?
$BR
\{ $tf->print_q() \}
END_TEXT

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;


ANS(str_cmp($tf->ra_correct_ans));

ENDDOCUMENT();

