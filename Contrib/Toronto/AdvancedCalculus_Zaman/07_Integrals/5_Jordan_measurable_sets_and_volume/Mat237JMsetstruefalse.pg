DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "PGgraders.pl",
  "PGcourse.pl"
);


TEXT(beginproblem());

##############################################
#  Setup

# Create and use pop up lists 
$tf = new_select_list();
$tf->rf_print_q(~~&pop_up_list_print_q);

# Specify choices presented to students
$tf->ra_pop_up_list( 
[ 
No_answer => "?", 
"True"=>"True", 
"False"=>"False"
] );

# Questions and answers
$tf -> qa ( 
" If \(S\) is bounded, then \(S\) is Jordan measurable. $BR","False",

"If \(\partial S\) has zero Jordan measure, then \(S\) is Jordan measurable. $BR","False",

"If \(S\) is bounded and \( \partial S\) has zero Jordan measure then \(S\) is Jordan measurable. $BR","True",

"If \(S\) is Jordan measurable then \( \chi_S\) is integrable on any rectangle in \(\mathbb{R}^n\) containing \(S\). $BR","True",

);

# How many questions to use
$tf->choose(4);


##############################################
#  Main text

BEGIN_TEXT
Let \(S \subseteq  \mathbb{R}^n\) be a set. Which of these statements are true or false?.
$BR
\{ $tf->print_q() \}
END_TEXT

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;


ANS(str_cmp($tf->ra_correct_ans));

ENDDOCUMENT();
