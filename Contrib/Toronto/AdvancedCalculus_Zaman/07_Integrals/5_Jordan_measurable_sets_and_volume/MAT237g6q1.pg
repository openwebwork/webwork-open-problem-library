## KEYWORDS('Uniform continuity')

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "PGgraders.pl",
  "PGcourse.pl"
);


TEXT(beginproblem());

##############################################
#  Setup

# Create and use pop up lists 
$tf = new_select_list();
$tf->rf_print_q(~~&pop_up_list_print_q);

# Specify choices presented to students
$tf->ra_pop_up_list( 
[ 
No_answer => "?", 
"Jordan measurable"=>"Jordan measurable", 
"Not Jordan measurable"=>"Not Jordan measurable"
] );

# Questions and answers
$tf -> qa ( 
" \(S = [−3, 4] \times (−1, 2)\) $BR","Jordan measurable",

"\( S = B_r(a)\) for \(r > 0\) and \(a \in \mathbb{R}^n \)$BR","Jordan measurable",

"\( S = B_r(a)\) for \(r > 0\) and \(a \in \mathbb{R}^n\)$BR","Jordan measurable",

"\( S = \mathbb{R}^n \)$BR","Not Jordan measurable",

"A finite set \(S\) in \(\mathbb{R}^n.\)$BR","Jordan measurable",

" \(S = \{(x, y, z) \in \mathbb{R}^3 : x^2 + y^2 ≤ 1, 0 ≤ z ≤ 3 \}\) $BR","Jordan measurable",

"\( S = \{(x, y) \in \mathbb{R}^2 : x^2 − 1 ≤ y ≤ 1 − x^2\} \)$BR","Jordan measurable",

"\( S = \{(x, y, z) \in \mathbb{R}^3 : x^2 − y^2 − z^2 ≤ 1\} \)$BR","Not Jordan measurable",

"\( S = ([0, 1] \cap \mathbb{Q})^n\)$BR","Not Jordan measurable",

"\( S = ([2, 3] \cap Q) \times {7}\) in \( \mathbb{R}^2\) $BR","Jordan measurable",

);

# How many questions to use
$tf->choose(8);


##############################################
#  Main text

BEGIN_TEXT
Which of the following sets are Jordan measurable?
$BR
\{ $tf->print_q() \}
END_TEXT

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;


ANS(str_cmp($tf->ra_correct_ans));

ENDDOCUMENT();
  
