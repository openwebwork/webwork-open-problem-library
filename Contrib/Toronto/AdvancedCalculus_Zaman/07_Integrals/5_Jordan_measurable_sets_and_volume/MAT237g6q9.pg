DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
);

TEXT(beginproblem());

Context("Numeric");


$popup1 = PopUp(
  ["?","Ernie is correct because the notion of zero volume doesn't make sense without the notion of volume of a set.","other wrong answers"],
  "Ernie is correct because the notion of zero volume doesn't make sense without the notion of volume of a set.",
);

Context()->texStrings;
BEGIN_TEXT
The language about zero volume sets and volume is confusing Bert and Ernie. \(\\\)
Bert asserts: “If S has zero volume then vol(S) = 0 by definition. It’s trivial!" \(\\\)
Ernie disagrees: "No, there’s something to prove and you shouldn’t use the word ‘trivial’." \(\\\)
Who is correct?

\{ $popup1->menu() \} \(\\\)


END_TEXT
Context()->normalStrings;

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $popup1->cmp() );


Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup1->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();