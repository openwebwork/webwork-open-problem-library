##DESCRIPTION
##  True or False on identifying valid partitions. 
##ENDDESCRIPTION

##KEYWORDS('partitions', 'rectangles', 'integration')

## DBsubject('Calculus')
## DBchapter('Integration')
## DBsection('Partitions')
## Date('')
## Author('')
## Institution('')
## TitleText1('')
## EditionText1('')
## AuthorText1('')
## Section1('')
## Problem 1('')

########################################################################

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "PGgraders.pl",
  "PGcourse.pl"
);


TEXT(beginproblem());

##############################################
#  Setup

# Create and use pop up lists 
$tf = new_select_list();
$tf->rf_print_q(~~&pop_up_list_print_q);

# Specify choices presented to students
$tf->ra_pop_up_list( 
[ 
No_answer => "?", 
"True"=>"True", 
"False"=>"False"
] );

# Questions and answers
$tf -> qa ( 
" \(\displaystyle (\{0,0.4,1\}, \{2,3,5\}) \) $BR","True",

"\( \displaystyle (\{2,3,5\}, \{0, 0.4, 1\}) \)$BR","False",

"\( \displaystyle \{[0,0.4] \times [2,3], [0.4, 1] \times [3,5], [0, 0.4] \times [3,5], [0.4, 1] \times [2,3] \} \)$BR","False",

"\( \displaystyle (\{0, \sqrt2 , 1\}, \{2, \pi , 5\}) \)$BR","False",

"\( \displaystyle (\{0,1\}, \{2,5\}) \)$BR","True",
);

# How many questions to use
$tf->choose(5);


##############################################
#  Main text

BEGIN_TEXT
Which of the following are partitions of the rectangle \(R = [0,1] \times [2,3]\) ?
$BR
\{ $tf->print_q() \}
END_TEXT

ANS(str_cmp($tf->ra_correct_ans));

ENDDOCUMENT();

ENDDOCUMENT();