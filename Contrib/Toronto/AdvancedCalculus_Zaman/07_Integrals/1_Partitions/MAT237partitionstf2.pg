DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "PGgraders.pl",
  "PGcourse.pl"
);


TEXT(beginproblem());

##############################################
#  Setup

# Create and use pop up lists 
$tf = new_select_list();
$tf->rf_print_q(~~&pop_up_list_print_q);

# Specify choices presented to students
$tf->ra_pop_up_list( 
[ 
No_answer => "?", 
"True"=>"True", 
"False"=>"False"
] );

# Questions and answers
$tf -> qa ( 
"\(P'_j \subseteq P_j\) for every \(j \in \{1,...,n\}.\) $BR","False",

"If \(Q\) is the common refinement of \(P\) and \(P'\), then \(Q = P'\). $BR","True",

"\( \sum_{i \in I} vol(R_i) = \sum_{j \in J} vol(R_j')\).  $BR","True",

"\(  |I| \geq |J|\). $BR","False",

"For each \(j \in J\), there exists \(i \in I\) such that \(R_j' \subseteq R_i\). $BR","True",

"For each \(i \in I\), there exists \(j \in J\) such that \(R_i = R_j'\). $BR","False",
);

# How many questions to use
$tf->choose(6);


##############################################
#  Main text

BEGIN_TEXT
Let \(R\) be a rectangle in \(\mathbb{R}^n\). Assume: $BR
\( \cdot P \) is a partition of \(R\) with index set \(I\) and subrectangles {\(R_i\)},  \(i \in I\). $BR
\( \cdot P' \) is a partition of \(R\) with index set \(J\) and subrectangles {\(R'_j\)},  \(j \in J\). $BR
\( \cdot P' \) is a refinement of \(P\). $BR
Which of the following are True or False?

$BR
\{ $tf->print_q() \}
END_TEXT

$showPartialCorrectAnswers = 0;

ANS(str_cmp($tf->ra_correct_ans));

ENDDOCUMENT();
