DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "PGgraders.pl",
  "PGcourse.pl"
);


TEXT(beginproblem());

##############################################
#  Setup

# Create and use pop up lists 
$tf = new_select_list();
$tf->rf_print_q(~~&pop_up_list_print_q);

# Specify choices presented to students
$tf->ra_pop_up_list( 
[ 
No_answer => "?", 
"True"=>"True", 
"False"=>"False"
] );

# Questions and answers
$tf -> qa ( 
" The rectangle \(R\) is the union of \(R_i\) over \(i \in I\).$BR","True",

"The number of subrectangles of \(P\) is equal to \(|I|\), the size of the index set.$BR","False",

"The volume of each subrectangle of P is equal to \(\frac{\textit{vol}(R)}{|I|}\).$BR","False",

"If \(R_i\) and \(R_j\) are distinct subrectangles of \(P\), then \(R_i \cap R_j = \emptyset\).$BR","True",

"If \(R_i\) and \(R_j\) are distinct subrectangles of \(P\), then int\((R_i) \cap \) int\((R_j) = \emptyset\).$BR","True",

"If \(x \in R\) then there exists a unique \(i \in I\) such that \(x \in R_i\).$BR","True",
);

# How many questions to use
$tf->choose(6);


##############################################
#  Main text

BEGIN_TEXT
Let \(R\) be a rectangle in \(\mathbb{R}^n\). Let \(P\) be a partition of the rectangle \(R\). Let {\(R_i\)}\(_{i \in I}\) be the subrectangles of \(P\). Which of the following are true or false?
$BR
\{ $tf->print_q() \}
END_TEXT


$showPartialCorrectAnswers = 0;

ANS(str_cmp($tf->ra_correct_ans));

ENDDOCUMENT();