## DESCRIPTION
## Multiple choice template
## ENDDESCRIPTION


## DBsubject(Calculus)
## DBchapter(Intgration)
## DBsection(Partitions)
## Date('')
## Institution('')
## Author('')
## MO(1)
## KEYWORDS('multiple choice', 'template')


###########################
#  Initialization

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserRadioButtons.pl",
  "PGML.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup

Context("Numeric");

$radio1 = RadioButtons(
  ["\(I = \{(1,1), (1,2),(2,1),(2,2)\}\)","\(I = \{(0,0), (0,1), (1,0), (1,1)\}\)", "\(I = \{(0,0), (0,1), (1,0), (1,1), (1,2), (2,1), (2,2) \}\)"],
  "\(I = \{(1,1), (1,2),(2,1),(2,2)\}\)", # correct answer
  
);
  
$radio2 = RadioButtons(
  ["\(\{[0,0.4] \times [2,3], [0,0.4] \times [3,5], [0.4,1] \times [2,3], [0.4,1] \times [3,5] \}\)","\(\{[0,0.4] \times [2,3], [0.4,1] \times [3,5]\}\) ", "other incorrect answers"],
 "\(\{[0,0.4] \times [2,3], [0,0.4] \times [3,5], [0.4,1] \times [2,3], [0.4,1] \times [3,5] \}\)", # correct answer
 
);

###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
Consider the partition \(P\)  = ({ \(0 , 0.4 , 1\) } , { \(2 , 3 , 5\) }) of the rectangle \(R = [0,1] \times [2,5]\). What is the index set of \(P\)? $BR  $BR
\{ $radio1->buttons() \}
 $BR  $BR
What are the subrectangles 0f \(P\)? $BR $BR 
\{ $radio2->buttons() \}
END_TEXT
############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio1->cmp() );
ANS( $radio2->cmp() );


############################
#  Solution

BEGIN_PGML_SOLUTION
The correct answer is [$radio1->correct_ans()].
The correct answer is [$radio2->correct_ans()].
END_PGML_SOLUTION

COMMENT('MathObject version. Uses PGML.');

ENDDOCUMENT();