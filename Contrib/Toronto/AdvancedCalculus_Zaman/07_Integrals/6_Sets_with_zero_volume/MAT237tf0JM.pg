## KEYWORDS('Uniform continuity')

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "PGgraders.pl",
  "PGcourse.pl"
);


TEXT(beginproblem());

##############################################
#  Setup

# Create and use pop up lists 
$tf = new_select_list();
$tf->rf_print_q(~~&pop_up_list_print_q);

# Specify choices presented to students
$tf->ra_pop_up_list( 
[ 
No_answer => "?", 
"True"=>"True", 
"False"=>"False"
] );

# Questions and answers
$tf -> qa ( 
" A finite set \(S\) of \(\mathbb{R}^n\) $BR","True",

"\( S = B_r(a)\) for \(r > 0\) and \(a \in \mathbb{R}^n\) $BR","False",

"\( S = \{(x,y) \in \mathbb{R}^2: x^2 + y^2 = 1\}\) in \(\mathbb{R}^2\) $BR","True",

"\( S = \{(t,t^2) : t \in [0,1]\}\) in \(\mathbb{R}^2\)$BR","True",

"\( S = \{ (x,y,z) : z = 2x + 3y\}\) in \(\mathbb{R}^3\)$BR","False",

" \( S = \{(x, y, z) \in \mathbb{R}^3 : x^2 − y^2 − z^2 = 1\} \)  in \(\mathbb{R}^3\) $BR","False",

"\( S = [0, 1]^n \cap \mathbb{Q}^n\) in \(\mathbb{R}^n \)$BR","False",

"\(S = [2, 3] \times \{7\}\) in \(\mathbb{R}^2\)$BR","True",

"\( S = ([2, 3] \times \mathbb{Q}) \times \{7\}\) in \(\mathbb{R}^2\)$BR","True",

"\( S = \{(x, y, z) \in \mathbb{R}^3 : x^2 + y^2 = 1, 0 \leq z \leq 3\}\)$BR","True",
);

# How many questions to use
$tf->choose(10);


##############################################
#  Main text

BEGIN_TEXT
Which of the following subsets \(S\) of \(\mathbb{R}^n\) have zero Jordan measure?
$BR
\{ $tf->print_q() \}
END_TEXT

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;


ANS(str_cmp($tf->ra_correct_ans));

ENDDOCUMENT();
    
