DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "PGgraders.pl",
  "PGcourse.pl"
);


TEXT(beginproblem());

##############################################
#  Setup

# Create and use pop up lists 
$tf = new_select_list();
$tf->rf_print_q(~~&pop_up_list_print_q);

# Specify choices presented to students
$tf->ra_pop_up_list( 
[ 
No_answer => "?", 
"True"=>"True", 
"False"=>"False"
] );

# Questions and answers
$tf -> qa ( 
" If \(S\) has zero Jordan measure, then \(S\) has zero Jordan measure. $BR","True",

"If \(\overline{S}\) has zero Jordan measure, then \(S\) has zero Jordan measure. $BR","True",

"If \(S\) has zero Jordan measure, then \(\partial S\) has zero Jordan measure. $BR","True",

"If \(\partial S\) has zero Jordan measure, then \(S\) has zero Jordan measure. $BR","False",

"If \(S\) has zero Jordan measure, then \(S^o\) is empty and \(S\) is bounded. $BR","True",

"If \(S^o\) is empty and \(S\) is bounded, then \(S\) has zero Jordan measure $BR","False",

);

# How many questions to use
$tf->choose(6);


##############################################
#  Main text

BEGIN_TEXT
Let \(S \subseteq \mathbb{R}^n\) be a set in \(\mathbb{R}^n\). Which of the following are true or false?
$BR
\{ $tf->print_q() \}
END_TEXT

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;


ANS(str_cmp($tf->ra_correct_ans));

ENDDOCUMENT();
      
