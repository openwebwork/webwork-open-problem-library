## DESCRIPTION
## Determining uniform continuity of a function on an interval.  
## ENDDESCRIPTION


## DBsubject(Calculus - multivariable)
## DBchapter(Integration of multivariable functions)
## DBsection(Uniform continuity)
## Date()
## Institution()
## Author()
## MLT()
## MLTleader()
## Level()
## TitleText1('')
## AuthorText1('')
## EditionText1('')
## Section1('')
## Problem1('')
## TitleText2('')
## AuthorText2('')
## EditionText2('')
## Section2('')
## Problem2('')
## KEYWORDS('Uniform continuity')

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "PGgraders.pl",
  "PGcourse.pl"
);


TEXT(beginproblem());

##############################################
#  Setup

# Create and use pop up lists 
$tf = new_select_list();
$tf->rf_print_q(~~&pop_up_list_print_q);

# Specify choices presented to students
$tf->ra_pop_up_list( 
[ 
No_answer => "?", 
"True"=>"True", 
"False"=>"False"
] );

# Questions and answers
$tf -> qa ( 
" \(\{2, \pi, 7\}\) $BR","True",

"\(\{ 1, \frac{1}{2}, \frac{1}{3}, ...,\}\) $BR","True",

"\(\mathbb{Z}\) $BR","False",

"\(\mathbb{R}\)$BR","False",

"\((0,1)\)$BR","False",

"\([0,1]\)$BR","False",

"\([0,1] \cap \mathbb{Q}\)$BR","False",

"\(\partial[0,1]\)$BR","True",
);

# How many questions to use
$tf->choose(8);


##############################################
#  Main text

BEGIN_TEXT
Which of the following subsets of \(\mathbb{R}\) have zero Jordan measure? If the subset has zero Jordan measure, answer True, otherwise, answer False.
$BR
\{ $tf->print_q() \}
END_TEXT

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;


ANS(str_cmp($tf->ra_correct_ans));

ENDDOCUMENT();
