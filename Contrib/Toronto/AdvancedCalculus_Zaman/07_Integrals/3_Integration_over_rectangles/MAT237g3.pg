##DESCRIPTION
##  Algebra problem: true or false for inequality 
##ENDDESCRIPTION

##KEYWORDS('algebra', 'inequality', 'fraction')

## DBsubject('Algebra')
## DBchapter('Fundamentals')
## DBsection('Real Numbers')
## Date('6/3/2002')
## Author('')
## Institution('')
## TitleText1('Precalculus')
## EditionText1('3')
## AuthorText1('Stewart, Redlin, Watson')
## Section1('1.1')
## Problem1('22')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserRadioButtons.pl",
);

TEXT(beginproblem());

##############################################################
#
#  Setup
Context("Numeric");

$radio = RadioButtons(
  ["Line 1","Line 2","Line 3","Line 4", "Line 5", "The proof is correct"],
  "Line 2", # correct answer
  makeLast => ["Line 1","Line 2","Line 3","Line 4", "Line 5", "The proof is correct"], # can be a list
);

##############################################################
#
#  Text
#
#
Context()->texStrings;
BEGIN_TEXT
Proofs of integral properties have a natural setup, but there are often subtleties.
$BR
$BR
Consider the following proof of additvity over a rectanglar set \(R\).
$BR
$BR
\{ image( "g3-q7.png", width=> 700, height=> 200) \}
$BR
$BR
This argument has multiple errors. Identify the line with the first error.
$BR
$BR
\{ $radio->buttons() \}
END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#
install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $radio->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();     
