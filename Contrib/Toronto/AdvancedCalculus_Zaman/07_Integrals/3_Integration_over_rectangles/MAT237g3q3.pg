## DESCRIPTION
##  true false integration over a rectangle
## ENDDESCRIPTION


## DBsubject(Calculus - multivariable)
## DBchapter(Integration of multivariable functions)
## DBsection(Integration over a rectangle)
## Date()
## Institution()
## Author()
## MLT()
## MLTleader()
## Level()
## TitleText1('')
## AuthorText1('')
## EditionText1('')
## Section1('')
## Problem1('')
## TitleText2('')
## AuthorText2('')
## EditionText2('')
## Section2('')
## Problem2('')
## KEYWORDS('')

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "PGgraders.pl",
  "PGcourse.pl"
);


TEXT(beginproblem());

##############################################
#  Setup

# Create and use pop up lists 
$tf = new_select_list();
$tf->rf_print_q(~~&pop_up_list_print_q);

# Specify choices presented to students
$tf->ra_pop_up_list( 
[ 
No_answer => "?", 
"True"=>"True", 
"False"=>"False"
] );

# Questions and answers
$tf -> qa ( 
"For every partition \( P\) of   R, \(L_P ( f ) ≤ \underline{I_R f}\).  $BR","True",

"There exists a partition P of R such that \(\underline{I_R f} = L_P ( f )\). $BR","False",

"For \(\varepsilon > 0\), there exists a partition \(P\) of \(R\) such that \(  \underline{I_R f} − \varepsilon ≤ L_P ( f )\). $BR","True",

"If \(f\) is integrable on \(R\), then there exists a partition  P of R such that \(\underline{I_R f} = L_P ( f )\). $BR","False",
);

# How many questions to use
$tf->choose(4);


##############################################
#  Main text

BEGIN_TEXT
Let \(\displaystyle R\) be a rectangle in \(\displaystyle \mathbb{R}^n\). Let \( \displaystyle f : R \to \mathbb{R}\) be bounded. Which statements are true or false?
$BR
\{ $tf->print_q() \}
END_TEXT

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;


ANS(str_cmp($tf->ra_correct_ans));

ENDDOCUMENT();