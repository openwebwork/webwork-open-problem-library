## DESCRIPTION
## Multiple choice template
## ENDDESCRIPTION


## DBsubject(Calculus)
## DBchapter(Integration)
## DBsection(Partitions)
## Date('')
## Institution('')
## Author('')
## MO(1)
## KEYWORDS('multiple choice', 'template')


###########################
#  Initialization

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserRadioButtons.pl",
  "PGML.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup

Context("Numeric");


$radio1 = RadioButtons(
  ["\( \overline{I_R f} = 16\)","\( \overline{I_R f} \leq 16\)", "\( \overline{I_R f} \geq 16\)"],
  "\( \overline{I_R f} = 16\)", # correct answer
);


$radio2 = RadioButtons(
  ["\( \underline{I_R f} = 16\)","\( \underline{I_R f} \leq 16\)", "\( \underline{I_R f} \geq 16\)"],
  "\( \underline{I_R f} \geq 16\)", # correct answer
);


$radio3 = RadioButtons(
  ["Yes","No", "Not enough information"],
  "Yes", # correct answer
);



###########################
#  Main text
BEGIN_TEXT
Let \(R = [0,2] \times [3,7].\) Consider the discontinuous function 
\[ f(x,y) =\begin{cases} 
      -1 \ \textrm{if} \ x = 0 \\
      2 \ \textrm{otherwise}
   \end{cases}
\]



You have proven that \(U_P ( f ) = 16\) for all partitions \(P\) of \(R\).
Using only this information about the upper sums, what can you conclude about \(\overline{I_R f}\) ?
$BR
$BR
\{ $radio1->buttons() \}
$BR
$BR
For \(\varepsilon > 0\), you have constructed a partition \(P_\varepsilon\) of \(R\) such that \(L_{P_\varepsilon} ( f ) = 16 − 4 \varepsilon\).
Using only this information about the lower sums, what can you conclude about \(\underline{I_R f}\) ?
$BR
$BR
\{ $radio2->buttons() \}
$BR
$BR
Is \(f\) integrable on \(R\)?
$BR
$BR
\{ $radio3->buttons() \}
$BR
$BR
END_TEXT

############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio1->cmp() );
ANS( $radio2->cmp() );
ANS( $radio3->cmp() );


############################
#  Solution

BEGIN_PGML_SOLUTION
The correct answer is [$radio1->correct_ans()].
The correct answer is [$radio2->correct_ans()]. 
The correct answer is [$radio3->correct_ans()]. 
END_PGML_SOLUTION

COMMENT('MathObject version. Uses PGML.');

ENDDOCUMENT();
