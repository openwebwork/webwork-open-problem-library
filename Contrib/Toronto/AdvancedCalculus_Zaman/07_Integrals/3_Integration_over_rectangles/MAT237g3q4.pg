##DESCRIPTION
##  Algebra problem: true or false for inequality 
##ENDDESCRIPTION

##KEYWORDS('algebra', 'inequality', 'fraction')

## DBsubject('Algebra')
## DBchapter('Fundamentals')
## DBsection('Real Numbers')
## Date('6/3/2002')
## Author('')
## Institution('')
## TitleText1('Precalculus')
## EditionText1('3')
## AuthorText1('Stewart, Redlin, Watson')
## Section1('1.1')
## Problem1('22')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserRadioButtons.pl",
);

TEXT(beginproblem());

##############################################################
#
#  Setup
#
#
Context("Numeric");

$radio1 = RadioButtons(
  ["Line 1 is incorrect","Line 2 is incorrect", "The proof is correct but needs more details", "The proof is correct"],
  "Line 2 is incorrect", # correct answer
  makeLast => ["Line 1 is incorrect","Line2 2 is incorrect", "The proof is correct but needs more details", "The proof is correct"], # can be a list
);

$radio2 = RadioButtons(
  ["Line 1 is flawed","Line 2 is flawed", "The proof is perfect as is"],
  "Line 2 is flawed", # correct answer
  makeLast => ["Line 1 is flawed","Line 2 is flawed","The proof is perfect as is"], # can be a list
);
  
##############################################################
#
#  Text
#
#

Context()->texStrings;
BEGIN_TEXT
Remember two key lemmas on partitions. Click on the images to expand them.
$BR
$BR
\{ image( "g3-lemmas.png", width=>800, height=>150) \}
$BR
$BR
Here is a proof of the fact \(\underline{I_R} f \leq \overline{I_R} f\).
$BR
$BR
\{ image( "g3-q4.1.png", width=>800, height=>150) \}
$BR
$BR
Identify the line with the flaw.
$BR
$BR
\{ $radio1->buttons() \}
$BR
$BR
Here is a proof of the fact \(\underline{I_R} f \leq \overline{I_R} f\).
$BR
$BR
\{ image( "g3-q4.2.png", width=>800, height=>150) \}
$BR
$BR
Identify the line that is missing details.
$BR
$BR
\{ $radio2->buttons() \}
END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio1->cmp() );
ANS( $radio2->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $radio1->correct_ans() \}
The correct answer is \{ $radio2->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();

