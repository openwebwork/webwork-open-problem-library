##DESCRIPTION
##  Algebra problem: true or false for inequality 
##ENDDESCRIPTION

##KEYWORDS('algebra', 'inequality', 'fraction')

## DBsubject('Algebra')
## DBchapter('Fundamentals')
## DBsection('Real Numbers')
## Date('6/3/2002')
## Author('')
## Institution('')
## TitleText1('Precalculus')
## EditionText1('3')
## AuthorText1('Stewart, Redlin, Watson')
## Section1('1.1')
## Problem1('22')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserRadioButtons.pl",
);

TEXT(beginproblem());

##############################################################
#
#  Setup
Context("Numeric");

$radio = RadioButtons(
  ["Line 1","Line 2","Line 3","The proof is correct"],
  "Line 2", # correct answer
  makeLast => ["Line 1","Line 2","Line 3","The proof is correct"], # can be a list
);
$radio2 = RadioButtons(
  ["The claim is True","The claim is False"],
  "The claim is False", # correct answer
  makeLast => ["The claim is True","The claim is False"], # can be a list
);

##############################################################
#
#  Text
#
#

Context()->texStrings;
BEGIN_TEXT
Let \(R\) be a rectangle in \(\mathbb{R}^n\) . Let \(f: R \to \mathbb{R}\) be a bounded function. 
$BR
$BR
LLana makes the following claim:$BR
If |\(f\)| is integrable on R, then \(f\) is integrable on R.
$BR
$BR
Llana gives an attempted WRONG proof.
$BR
$BR
\{ image( "g3-q8.png", width=>600, height=>100) \}
$BR
$BR
Identify the line with the error.
$BR
$BR
\{ $radio->buttons() \}
$BR
$BR
Is Llana's claim True or False?
$BR
$BR
\{ $radio2->buttons() \}

END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#
install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio->cmp() );
ANS( $radio2->cmp() ); 

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $radio->correct_ans() \}
The correct answer is \{ $radio2->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();
