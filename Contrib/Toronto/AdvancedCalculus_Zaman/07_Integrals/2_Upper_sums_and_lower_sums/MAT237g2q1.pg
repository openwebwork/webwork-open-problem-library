## DESCRIPTION
## Multiple choice template
## ENDDESCRIPTION

## KEYWORDS('multiple choice', 'template')

## DBsubject('WeBWorK')
## DBchapter(WeBWorK tutorial)
## DBsection(Fort Lewis tutorial 2011)
## Date('01/30/2011')
## Author('Paul Pearson')
## Institution('Fort Lewis College')
## TitleText1('')
## EditionText1('')
## AuthorText1('')
## Section1('')
## Problem1('')


###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup



$mc1 = new_checkbox_multiple_choice();

$mc1 -> qa (
"Which lemma(s) explain why all the lower sums are smaller than all the upper sums? $BR", 
"3$BR",
);


$mc1->extra("1", "2");
$mc1->makeLast("none");

$mc2 = new_checkbox_multiple_choice();

$mc2 -> qa (
"Which lemma(s) explain why finer partitions improve your approximation? $BR", 
"2$BR",               
);

$mc2->extra("1","3");
$mc2->makeLast("none");

###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
Read the following key lemmas about upper sums and lower sums, then answer the questions below. Click on the image to expand it. $BR $BR

\{ image( "g2-lemmas.png", width=>700, height=>280) \}

$BR $BR $BR
\{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}

\{ $mc2 -> print_q() \}
\{ $mc2 -> print_a() \}

END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );

############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $mc1->correct_ans() \}
The correct answer is \{ $mc2->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT();  