###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup



$mc1 = new_checkbox_multiple_choice();

$mc1 -> qa (
"Which of these correspond to upper sums?", 
"B$BR", 
"F$BR",
);


$mc1->extra("A", "C", "D", "E");

$mc2 = new_checkbox_multiple_choice();

$mc2 -> qa (
"Which of these correspond to lower sums?", 
"C$BR",               
);

$mc2->extra("A", "B", "D", "E", "F");

$mc3 = new_checkbox_multiple_choice();

$mc3 -> qa (
"Choose a sample point to be the upper right corners of each subrectangle. Which of these correspond(s) to a Reimann sum, ?", 
"A$BR",               
);

$mc3->extra("B", "C", "D", "E", "F");

###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
Let \(R = [a, b] \times [c, d]\). Let \(P = (P1, P2)\) be a partition of \(R\), so \(P1 = {x_0, . . . , x_M }\) and \(P2 = { y_0, . . . , y_N }\).
are partitions of \([a, b]\) and \([c, d]\) respectively. The subrectangles {\(R_{ij}\)} of \(P\) are given by $BR
\[R_{ij} = [x_{i−1}, x_i ] × [ y_{j−1}, y_j ] \ \forall 1 \leq i \leq M , 1 \leq j \leq N \].
Suppose \(f : \mathbb{R}^2 \to \mathbb{R}\) is differentiable and satisfies \(\frac{\partial f}{\partial x} \leq 0\) and \(\frac{\partial f}{\partial y} \geq 0\) everywhere on \(R\) $BR
Consider the six double sums below. $BR

\[ (A) \sum_{i = 1}^M \sum_{j = 1}^N f(x_i,y_j) \Delta x_i \Delta y_i  \\ 
(B) \sum_{i = 1}^M \sum_{j = 1}^N f(x_{i-1},y_j) \Delta x_i \Delta y_i \\ 
(C) \sum_{i = 1}^M \sum_{j = 1}^N f(x_i,y_{j-1}) \Delta x_i \Delta y_i \\
(D) \sum_{i = 0}^{M-1} \sum_{j = 0}^{N-1} f(x_i,y_{j+1}) \Delta x_i \Delta y_i \\ (E) \sum_{i = 0}^M \sum_{j = 1}^N f(x_i,y_j) \Delta x_{i+1} \Delta y_i \\
(F) \sum_{i = 0}^{M-1} \sum_{j = 1}^N f(x_i,y_j) \Delta x_{i+1} \Delta y_i\]

$BR
\{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}

\{ $mc2 -> print_q() \}
\{ $mc2 -> print_a() \}

\{ $mc3 -> print_q() \}
\{ $mc3 -> print_a() \}
END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );
ANS( checkbox_cmp( $mc3->correct_ans() ) );

############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $mc1->correct_ans() \}
The correct answer is \{ $mc2->correct_ans() \}
The correct answer is \{ $mc3->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT();  