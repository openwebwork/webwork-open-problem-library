## DESCRIPTION
## Multiple choice template
## ENDDESCRIPTION

## KEYWORDS('multiple choice', 'template')

## DBsubject('WeBWorK')
## DBchapter(WeBWorK tutorial)
## DBsection(Fort Lewis tutorial 2011)
## Date('01/30/2011')
## Author('Paul Pearson')
## Institution('Fort Lewis College')
## TitleText1('')
## EditionText1('')
## AuthorText1('')
## Section1('')
## Problem1('')


###########################
#  Initialization

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserRadioButtons.pl",
);

TEXT(beginproblem());


###########################
#  Setup

Context("Numeric");

$radio1 = RadioButtons(
  ["Line 2 because the constant cannot be taken out of the supremum if it is negative.","other incorrect answers","The proof is correct"],
  "Line 2 because the constant cannot be taken out of the supremum if it is negative.", # correct answer
  last => ["The proof is correct"], # can be a list
);

$radio2 = RadioButtons(
  ["Line 5 because the supremum is not linear.","other incorrect answers","The proof is correct"],
  "Line 5 because the supremum is not linear.", # correct answer
  last => ["The proof is correct"], # can be a list
);

###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
Abbi and Bevers are arguing about the properties of upper sums. They each make a claim. $BR
$BR
Abbi makes a claim and scribbles down a rough proof sketch for her claim. Click on the image to make it bigger.
$BR
$BR
\{ image( "g2-claimA.png", width=>650, height=>250) \}
$BR
$BR
Bevers is skeptical of Abbi and finds an error. Identify which line has an error and what it is.
$BR
$BR
\{ $radio1->buttons() \}
$BR
$BR
Bevers makes a claim and jots down an argument. Click on the image to make it bigger.
$BR
$BR
\{ image( "g2-claimB.png", width=>650, height=>250) \}
$BR
$BR
Abbi doesn't believe anything Bevers says, and spots a flaw. Identify which line has an error and what it is.
$BR
$BR
\{ $radio2->buttons() \}
$BR
$BR

END_TEXT
Context()->normalStrings;

############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio1->cmp() );
ANS( $radio2->cmp() );

############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $radio1->correct_ans() \}
The correct answer is \{ $radio2->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();