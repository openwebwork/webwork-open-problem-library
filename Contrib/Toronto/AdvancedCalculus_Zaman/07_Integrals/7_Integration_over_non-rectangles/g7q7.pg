##DESCRIPTION
##  Algebra problem: true or false for inequality 
##ENDDESCRIPTION

##KEYWORDS('algebra', 'inequality', 'fraction')

## DBsubject('Algebra')
## DBchapter('Fundamentals')
## DBsection('Real Numbers')
## Date('6/3/2002')
## Author('')
## Institution('')
## TitleText1('Precalculus')
## EditionText1('3')
## AuthorText1('Stewart, Redlin, Watson')
## Section1('1.1')
## Problem1('22')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"PGchoicemacros.pl",
"PGcourse.pl",
);

TEXT(beginproblem());

##############################################################
#
#  Setup
#
#
$mc = new_checkbox_multiple_choice();
$mc -> qa (
"Which lines are inspired by the proof of Theorem C? Hint: there are four lines that stand out.", 
"Line 4",
"Line 5",                
"Line 7",
"Line 13",
);
$mc -> makeLast("Line 1", "Line 2", "Line 3", "Line 4", "Line 5", "Line 6", "Line 7", "Line 8", "Line 9", "Line 10", "Line 11", "Line 12", "Line 13", "Line 14");


$mc2 = new_checkbox_multiple_choice();
$mc2 -> qa (
"Which lines are inspired by the proof of Theorem D? Hint: there are four lines that stand out.", 
"Line 2",
"Line 3",
"Line 8",
"Line 12",
);
$mc2 -> makeLast("Line 1", "Line 2", "Line 3", "Line 4", "Line 5", "Line 6", "Line 7", "Line 8", "Line 9", "Line 10", "Line 11", "Line 12", "Line 13", "Line 14");

$mc3 = new_checkbox_multiple_choice();
$mc3 -> qa (
"Two lines are critial to successfully merge the ideas of Theorems C and D. Identify those two lines.", 
"Line 9",
"Line 10",
);
$mc3 -> makeLast("Line 1", "Line 2", "Line 3", "Line 4", "Line 5", "Line 6", "Line 7", "Line 8", "Line 9", "Line 10", "Line 11", "Line 12", "Line 13", "Line 14");


##############################################################
#
#  Text
#
#

BEGIN_TEXT

\{ image( "g7thmb.png" , width=>550, height=>40) \}
$BR
$BR

The main ideas behind the proof of Theorem B are inspired by breakthroughs for two prior theorems.

$BR
$BR
\{ image( "g7thmscd.png" , width=>550, height=>80) \}
$BR
$BR

Notice Theorem B actually implies both Theorem C and D, so it is not so suprising that its proof relies on the same breakthroughs. A skecth of the proof of Theorem B is below.

$BR
$BR
\{ image( "g7q7.1.png" , width=>800, height=>800) \}
$BR
$BR
Here you will analyse the proof sketch of Theorem B, and try to identify the origins of key steps. An illustration of the setup with partition \(P\) is included below.
$BR
$BR
\{ image( "g7q7.2.png" , width=>700, height=>650) \}
$BR
$BR
\{ $mc -> print_q() \}
$BR
\{ $mc -> print_a() \}
$BR
\{ $mc2 -> print_q() \}
$BR
\{ $mc2 -> print_a() \}
$BR
\{ $mc3 -> print_q() \}
$BR
\{ $mc3 -> print_a() \}
END_TEXT

##############################################################
#
#  Answers
#
#

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );
ANS( checkbox_cmp( $mc3->correct_ans() ) );

ENDDOCUMENT();    
