## KEYWORDS('Uniform continuity')

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "PGgraders.pl",
  "PGcourse.pl"
);


TEXT(beginproblem());

##############################################
#  Setup

# Create and use pop up lists 
$tf = new_select_list();
$tf->rf_print_q(~~&pop_up_list_print_q);

# Specify choices presented to students
$tf->ra_pop_up_list( 
[ 
No_answer => "?", 
"True"=>"True", 
"False"=>"False"
] );

# Questions and answers
$tf -> qa ( 
" \(S = B_1(0)\) in \(\mathbb{R}^3\) and \(f(x,y,z) = \frac{1}{(x-2)(y-3)(z-4)}\) $BR","True",

"\(S = B_1(0)\) in \(\mathbb{R}^3\) and \(f(x,y,z) = \frac{1}{1-x^2-y^2-z^2} \)$BR","False",

"\(S = [2, 3] \times {7}\) in \(\mathbb{R}^2\) and \(f(x,y) = x + 2\)$BR","True",

"\(S = [2, 3] \times {7}\) in \(\mathbb{R}^2\) and 
\(f(x,y) =
    \begin{cases} 
        -1 \ \ x \in \mathbb{Q} & \\
        1  \ \  x \notin \mathbb{Q}
    \end{cases}\)$BR","True",

"\( S = ([0, 1] \cap \mathbb{Q})^n \) and \(f(x) = 237\) for all \(x \in \mathbb{R}^n\). $BR","False",
);

# How many questions to use
$tf->choose(5);


##############################################
#  Main text

BEGIN_TEXT
Determine whether the following functions are uniformly continuous on the given intervals.
$BR
\{ $tf->print_q() \}
END_TEXT

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;


ANS(str_cmp($tf->ra_correct_ans));

ENDDOCUMENT();