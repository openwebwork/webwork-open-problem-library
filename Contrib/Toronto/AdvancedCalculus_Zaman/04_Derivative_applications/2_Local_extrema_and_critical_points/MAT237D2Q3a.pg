## DESCRIPTION
## Local extrema and critical points
## ENDDESCRIPTION

## DBsubject('Calculus - multivariable')
## DBchapter('Differentiation of multivariable functions')
## DBsection('Local extrema and critical points')

################################################################

DOCUMENT();

loadMacros("PGstandard.pl", "PGcourse.pl", "PGchoicemacros.pl");

TEXT(beginproblem());

################################################################
#
#  Setup

$mc = new_select_list();
$mc -> rf_print_q(~~&pop_up_list_print_q);
$mc -> ra_pop_up_list([No_answer=>"?", "Local max"=>"Local maximum", "Local min"=>"Local minimum", "Saddle"=>"Saddle point", "Not a critical point"=>"Not a critical point"]);
$mc -> qa("A", "Not a critical point", "B", "Local max", "C", "Saddle", "D", "Saddle", "E", "Local min", "F", "Saddle", "G", "Local min");

$mc->choose(7);

################################################################
#
#  Text

BEGIN_TEXT
$BR
Identify which of \( A \) to \( G \) appear to be critical points, local maxima, local minima, and saddle points.
$BR$BR
$BCENTER
\{ image("d2-critical-points.png", width=>400) \}
$ECENTER
$BR
\{ $mc->print_q \}
END_TEXT


################################################################
#
#  Answers

$showPartialCorrectAnswers = 0;
ANS(str_cmp($mc->ra_correct_ans()));

ENDDOCUMENT();