## DESCRIPTION
## Local extrema and critical points
## ENDDESCRIPTION

## DBsubject('Calculus - multivariable')
## DBchapter('Differentiation of multivariable functions')
## DBsection('Local extrema and critical points')

################################################################

DOCUMENT();

loadMacros(
   "PGstandard.pl",     # Standard macros for PG language
   "parserPopUp.pl"
);

TEXT(beginproblem());

################################################################
#
#  Setup

$a = PopUp(["?", "Local maximum", "Local minimum", "Saddle point", "None of these"], "Saddle point");
$b = PopUp(["?", "Local maximum", "Local minimum", "Saddle point", "None of these"], "Local minimum");
$c = PopUp(["?", "Local maximum", "Local minimum", "Saddle point", "None of these"], "Local maximum");
$d = PopUp(["?", "Local maximum", "Local minimum", "Saddle point", "None of these"], "Local minimum");
$e = PopUp(["?", "Local maximum", "Local minimum", "Saddle point", "None of these"], "Local minimum");
$f = PopUp(["?", "Local maximum", "Local minimum", "Saddle point", "None of these"], "Saddle point");

################################################################
#
#  Text

BEGIN_TEXT
$BR
Below are contour plots or graphs of a \( C^2 \) function \( \mathbb{R}^2 \to \mathbb{R} \). Identify whether at the origin the function has a local maximum, local minimum, saddle point, or none of these. Tip: Zoom in if the images are not clear.
$BR$BR
$BBOLD A. $EBOLD
\{ image("d2-basic-saddle.png", width=>300) \} \{ $a->menu() \}
$BR$BR
$BBOLD B. $EBOLD
\{ image("d2-basic-min.png", width=>300) \} \{ $b->menu() \}
$BR$BR
$BBOLD C. $EBOLD
\{ image("d2-basic-max.png", width=>300) \} \{ $c->menu() \}
$BR$BR
$BBOLD D. $EBOLD
\{ image("d2-basic-cylinder.png", width=>300) \} \{ $d->menu() \}
$BR$BR
$BBOLD E. $EBOLD
\{ image("d2-basic-min-contour.png", width=>300) \} \{ $e->menu() \}
$BR$BR
$BBOLD F. $EBOLD
\{ image("d2-basic-saddle-contour.png", width=>300) \} \{ $f->menu() \}
END_TEXT


################################################################
#
#  Answers

$showPartialCorrectAnswers = 0;
ANS( $a->cmp() );
ANS( $b->cmp() );
ANS( $c->cmp() );
ANS( $d->cmp() );
ANS( $e->cmp() );
ANS( $f->cmp() );

ENDDOCUMENT();