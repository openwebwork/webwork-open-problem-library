## DESCRIPTION
## Local extrema and critical points
## ENDDESCRIPTION

## DBsubject('Calculus - multivariable')
## DBchapter('Differentiation of multivariable functions')
## DBsection('Local extrema and critical points')

################################################################

DOCUMENT();

loadMacros("PGstandard.pl", "PGchoicemacros.pl");

TEXT(beginproblem());

################################################################
#
#  Setup

$mc = new_checkbox_multiple_choice();
$mc -> qa(
"Let \( A \subseteq \mathbb{R}^n \) be open and let \( f: A \to \mathbb{R} \) be differentiable. Fix \( a \in A \). Which statements are true?",
"If \( f \) has a local extremum at \( a \) then \( \nabla f(a) = 0 \).",
"If \( \nabla f(a) = 0 \) then \( a \) is either a local extremum of \( f \) or a saddle point of \( f \).",
"Every global extremum of \( f \) is a local extremum.",
"Every saddle point of \( f \) is a critical point.",
"Every local extremum of \( f \) is a critical point."
);

$mc -> makeLast(
"If \( f \) has a local extremum at \( a \) then \( \nabla f(a) = 0 \).",
"If \( \nabla f(a) = 0 \) then \( a \) is a local extremum of \( f \).",
"If \( \nabla f(a) = 0 \) then \( a \) is either a local extremum of \( f \) or a saddle point of \( f \).",
"Every global extremum of \( f \) is a local extremum.",
"Every saddle point of \( f \) is a critical point.",
"Every local extremum of \( f \) is a critical point."
);

################################################################
#
#  Text

BEGIN_TEXT
$BR
\{ $mc->print_q() \}
$BR
\{ $mc->print_a() \}
END_TEXT

$showHint = 1;
BEGIN_HINT
For F, the answer would be different if \( A \) were not open.
END_HINT

################################################################
#
#  Answers

$showPartialCorrectAnswers = 0;
ANS( checkbox_cmp( $mc->correct_ans() ) );

ENDDOCUMENT();