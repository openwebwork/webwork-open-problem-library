## DESCRIPTION
## Local extrema and critical points
## ENDDESCRIPTION

## DBsubject('Calculus - multivariable')
## DBchapter('Differentiation of multivariable functions')
## DBsection('Local extrema and critical points')

################################################################

DOCUMENT();

loadMacros("PGstandard.pl", "parserPopUp.pl");

TEXT(beginproblem());

################################################################
#
#  Setup

$a = PopUp(["?", "One local maximum", "One local minimum", "One saddle point", "Infinitely many local minima", "Infinitely many local maxima", "No critical points"], "One local minimum");
$b = PopUp(["?", "One local maximum", "One local minimum", "One saddle point", "Infinitely many local minima", "Infinitely many local maxima", "No critical points"], "One local maximum");
$c = PopUp(["?", "One local maximum", "One local minimum", "One saddle point", "Infinitely many local minima", "Infinitely many local maxima", "No critical points"], "No critical points");
$d = PopUp(["?", "One local maximum", "One local minimum", "One saddle point", "Infinitely many local minima", "Infinitely many local maxima", "No critical points"], "Infinitely many local minima");
$e = PopUp(["?", "One local maximum", "One local minimum", "One saddle point", "Infinitely many local minima", "Infinitely many local maxima", "No critical points"], "One saddle point");
$f = PopUp(["?", "One local maximum", "One local minimum", "One saddle point", "Infinitely many local minima", "Infinitely many local maxima", "No critical points"], "One local maximum");

################################################################
#
#  Text

BEGIN_TEXT
$BR
Below are six vector fields. Each vector field is the gradient of some \( C^1 \) function \( f: \mathbb{R} \to \mathbb{R}^2 \). For each vector field, identify all critical points and classify whether they appear to be local maxima, local minima, saddle points, or none of these.
$BR$BR
$BBOLD A. $EBOLD
\{ image("d2-grad-field-1.png", width=>300) \} \{ $a->menu() \}
$BR$BR
$BBOLD B. $EBOLD
\{ image("d2-grad-field-2.png", width=>300) \} \{ $b->menu() \}
$BR$BR
$BBOLD C. $EBOLD
\{ image("d2-grad-field-3.png", width=>300) \} \{ $c->menu() \}
$BR$BR
$BBOLD D. $EBOLD
\{ image("d2-grad-field-4.png", width=>300) \} \{ $d->menu() \}
$BR$BR
$BBOLD E. $EBOLD
\{ image("d2-grad-field-5.png", width=>300) \} \{ $e->menu() \}
$BR$BR
$BBOLD F. $EBOLD
\{ image("d2-grad-field-6.png", width=>300) \} \{ $f->menu() \}
END_TEXT

################################################################
#
#  Answers

$showPartialCorrectAnswers = 0;
ANS( $a->cmp() );
ANS( $b->cmp() );
ANS( $c->cmp() );
ANS( $d->cmp() );
ANS( $e->cmp() );
ANS( $f->cmp() );

ENDDOCUMENT();