## DESCRIPTION
## Local extrema and critical points
## ENDDESCRIPTION

## DBsubject('Calculus - multivariable')
## DBchapter('Differentiation of multivariable functions')
## DBsection('Local extrema and critical points')

################################################################

DOCUMENT();

loadMacros(
   "PGstandard.pl",     # Standard macros for PG language
   "PGchoicemacros.pl"
);

TEXT(beginproblem());

################################################################
#
#  Setup

$mc = new_checkbox_multiple_choice();
$mc -> qa(
"Let \( A \in \mathbb{R}^n \) be a set. Let \( f: A \to \mathbb{R} \) and let \( a \in A \). Which of the following statements are equivalent to ~~"\( f \) has a local maximum \( a \)~~"?",
"\( \exists \epsilon > 0 \text{ s.t. } \forall x \in B_{\epsilon}(a) \cap A, f(x) \leq f(a) \)."
);

$mc -> makeLast(
"\( \forall x \in A, f(x) \leq f(a) \).",
"\( \exists \epsilon > 0 \text{ s.t. } \forall x \in B_{\epsilon}(a), f(x) \leq f(a) \).",
"\( \exists \epsilon > 0 \text{ s.t. } \forall x \in B_{\epsilon}(a) \cap A, f(x) \leq f(a) \).",
"\( \exists \epsilon > 0 \text{ s.t. } \forall x \in B_{\epsilon}(a) \cap A, |f(x)| \leq |f(a)| \)."
);

################################################################
#
#  Text

BEGIN_TEXT
$BR
\{ $mc->print_q() \}
$BR
\{ $mc->print_a() \}
END_TEXT

################################################################
#
#  Answers

$showPartialCorrectAnswers = 0;
ANS( checkbox_cmp( $mc->correct_ans() ) );

BEGIN_SOLUTION
A. Not equivalent. This is the definition of a global maximum.
$PAR
B. Not equivalent. This is always false when \( a \) is a boundary point of \( A \). Can you see why?
$PAR
C. Equivalent.
$PAR
D. Not equivalent. This is is the definition of a local extremum, but it does not specify whether \( a \) is a local min or local max.
END_SOLUTION

ENDDOCUMENT();