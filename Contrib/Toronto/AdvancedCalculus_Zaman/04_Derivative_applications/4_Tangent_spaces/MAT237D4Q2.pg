## DESCRIPTION
## Tangent spaces
## ENDDESCRIPTION

## DBsubject('Calculus - multivariable')
## DBchapter('Differentiation of multivariable functions')
## DBsection('Tangent spaces')

########################################################################

DOCUMENT();

loadMacros(
   "PGstandard.pl",     # Standard macros for PG language
   "PGcourse.pl",       # Customization file for the course
   "PGchoicemacros.pl",
   #"source.pl",        # allows code to be displayed on certain sites.
);

TEXT(beginproblem());

$showPartialCorrectAnswers = 0;

##############################################################
#
#  Setup

$mc1 = new_checkbox_multiple_choice();
$mc1 -> qa("Which of the following are tangent vectors of \( S \) at \( p \)? Select all that apply.", "\( (2,3,0) \)", "\( (0,0,7) \)");
$mc1 -> makeLast("\( (2,0) \)", "\( (2,3,0) \)", "\( (0,0,7) \)", "\( (2,3,7) \)", "\( (0,0,0) \)");

$mc2 = new_checkbox_multiple_choice();
$mc2 -> qa("Which of the following is equal to the tangent space of \( S \) at \( p \)? Select all that apply.", "\( \{(u,v,0): u,v \in \mathbb{R}\} \)", "\( \text{span}\{(1,0,0),(0,1,0)\} \)");
$mc2 -> makeLast("\( \mathbb{R}^2 \)", "\( \mathbb{R}^3 \)", "\( \{(1,0,0),(0,1,0)\} \)", "\( \{(u,v,0): u,v \in \mathbb{R}\} \)", "\( \text{span}\{(1,0,0),(0,1,0)\} \)");

$mc3 = new_checkbox_multiple_choice();
$mc3 -> qa("What is the tangent plane of \( S \) at \( p \)? Select all that apply.", "\( \{(u,v,1): u,v \in \mathbb{R}\} \)", "\( \{(x,y,z) \in \mathbb{R}^3: z = 1\} \)");
$mc3 -> makeLast("\( \mathbb{R}^2 \)", "\( \{(u,v,0): u,v \in \mathbb{R}\} \)", "\( \{(u,v,1): u,v \in \mathbb{R}\} \)", "\( \text{span}\{(1,0,1),(0,1,1)\} \)", "\( \{(x,y,z) \in \mathbb{R}^3: z = 1\} \)");

##############################################################
#
#  Text

BEGIN_TEXT
$BR
Let \( S \subseteq \mathbb{R}^3 \) be the upper hemisphere of radius \( 1 \) centred at the origin. Fix the point \( p = (0,0,1) \in S \).
$PAR
\{ $mc1 -> print_q() \}
$BR
\{ $mc1 -> print_a() \}
$BR
\{ $mc2 -> print_q() \}
$BR
\{ $mc2 -> print_a() \}
$BR
\{ $mc3 -> print_q() \}
$BR
\{ $mc3 -> print_a() \}
END_TEXT

##############################################################
#
#  Answers

install_problem_grader(~~&std_problem_grader);
ANS( checkbox_cmp( $mc1->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );
ANS( checkbox_cmp( $mc3->correct_ans() ) );

ENDDOCUMENT();