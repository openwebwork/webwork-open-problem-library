## DESCRIPTION
## Tangent spaces
## ENDDESCRIPTION

## DBsubject('Calculus - multivariable')
## DBchapter('Differentiation of multivariable functions')
## DBsection('Tangent spaces')

########################################################################

DOCUMENT();

loadMacros("PGstandard.pl", "PGchoicemacros.pl");

TEXT(beginproblem());

$showPartialCorrectAnswers = 0;

##############################################################
#
#  Setup

$mc = new_checkbox_multiple_choice();
$mc -> qa("Let \( S \subseteq \mathbb{R}^n \). Let \( p \in S \) and \( v \in \mathbb{R}^n \). Which statements are equivalent to ~~"\( v \) is a tangent vector of \( S \) at \( p \)~~"?", "\( v \) is an element of the tangent space of \( S \) at \( p \).", "\( v \) is the velocity of a particle passing through \( p \).");
$mc -> makeLast("\( v = \gamma′(0) \) and \( p = \gamma(0) \) for some differentiable parametric curve \( \gamma: I \to S \) with \( I \subseteq \mathbb{R} \) open.", "\( p+v \) is an element of \( S \).", "\( v \) is an element of the tangent plane of \( S \) at \( p \).", "\( v \) is an element of the tangent space of \( S \) at \( p \).", "\( v \) is the velocity of a particle passing through \( p \).");

##############################################################
#
#  Text

BEGIN_TEXT
$BR
\{ $mc -> print_q() \}
$BR
\{ $mc -> print_a() \}
END_TEXT

##############################################################
#
#  Answers

ANS( checkbox_cmp( $mc->correct_ans() ) );

ENDDOCUMENT();