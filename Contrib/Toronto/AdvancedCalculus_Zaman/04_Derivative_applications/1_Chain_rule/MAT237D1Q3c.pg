## DESCRIPTION
## Chain rule
## ENDDESCRIPTION

## DBsubject('Calculus - multivariable')
## DBchapter('Differentiation of multivariable functions')
## DBsection('Chain rule')

DOCUMENT();

loadMacros(
   "PGstandard.pl",     # Standard macros for PG language
   "PGcourse.pl",       # Customization file for the course
   "MathObjects.pl",
   #"source.pl",        # Allows code to be displayed on certain sites
);

TEXT(beginproblem());

$showPartialCorrectAnswers = 0;

################################################################
#
#  Setup

$ans1 = Compute(-1/2);
$ans2 = Real(0);
$ans3 = Real(-1);
$ans4 = Compute(7/2);

################################################################
#
#  Text

BEGIN_TEXT
$BR
Let \( s \),  \( t \) be real variables so \( s,t \in \mathbb{R} \). Define the variables \( u,v,x,y,z \) as follows:
$BR
\begin{align*}
(x,y,z) = (st,2s-3t+7, t^2+2) \text{ and } (u,v) = (\frac{x}{1-z}, \frac{y}{1-z}).
\end{align*}
Compute \( \frac{\partial u}{\partial s} \) and \( \frac{\partial u}{\partial t} \) when \( (s,t) = (0,1) \).
$BR$BR
\( \frac{\partial u}{\partial s} = \) \{ ans_rule(ans1) \}
\( \frac{\partial u}{\partial t} = \) \{ ans_rule(ans2) \}
$BR$BR
Compute \( \frac{\partial v}{\partial s} \) and \( \frac{\partial v}{\partial t} \) when \( (s,t) = (0,1) \).
$BR$BR
\( \frac{\partial v}{\partial s} = \) \{ ans_rule(ans3) \}
\( \frac{\partial v}{\partial t} = \) \{ ans_rule(ans4) \}
END_TEXT

################################################################
#
#  Answers

$showPartialCorrectAnswers = 0;
ANS($ans1->cmp());
ANS($ans2->cmp());
ANS($ans3->cmp());
ANS($ans4->cmp());

ENDDOCUMENT();