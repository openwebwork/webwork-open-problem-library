## DESCRIPTION
## Smooth manifolds
## ENDDESCRIPTION

## DBsubject('Calculus - multivariable')
## DBchapter('Differentiation of multivariable functions')
## DBsection('Smooth manifolds')

########################################################################

DOCUMENT();

loadMacros("PGstandard.pl", "PGchoicemacros.pl");

TEXT(beginproblem());

$showPartialCorrectAnswers = 0;

##############################################################
#
#  Setup

$mc = new_checkbox_multiple_choice();
$mc -> qa("Select all points at which \( S \) is a 1-dimensional smooth manifold.", "B", "C", "E",);
$mc -> makeLast("A", "B", "C", "D", "E", "None of the above");

##############################################################
#
#  Text

BEGIN_TEXT
$BR
Below is a plot of a curve \( S \subseteq \mathbb{R}^2 \) with points A, B, C, D, and E shown.
$PAR
$BCENTER
\{ image("d5_curve_points.png", width=>400) \}
$ECENTER
$PAR
\{ $mc -> print_q() \}
$BR
\{ $mc -> print_a() \}
END_TEXT

##############################################################
#
#  Answers

ANS( checkbox_cmp( $mc->correct_ans() ) );

ENDDOCUMENT();