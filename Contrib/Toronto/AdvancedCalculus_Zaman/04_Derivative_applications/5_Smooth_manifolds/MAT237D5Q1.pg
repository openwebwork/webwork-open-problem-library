## DESCRIPTION
## Smooth manifolds
## ENDDESCRIPTION

## DBsubject('Calculus - multivariable')
## DBchapter('Concepts for multivariable functions')
## DBsection('Smooth manifolds')

########################################################################

DOCUMENT();

loadMacros(
   "PGstandard.pl",     # Standard macros for PG language
   "PGchoicemacros.pl"
);

TEXT(beginproblem());

$showPartialCorrectAnswers = 0;

##############################################################
#
#  Setup

$mc1 = new_checkbox_multiple_choice();
$mc1 -> qa("For which of the 3 values of \( \epsilon \) is the set \( B_{\epsilon}(p) \cap S \) the graph of a \( C^1 \) function of the form \( y = f(x) \)?", "\( 0.1 \) ", "\( 0.7 \)");
$mc1 -> makeLast("\( 0.1 \) ", "\( 0.7 \)", "\( 1.6 \)", "None of the above");

$mc2 = new_checkbox_multiple_choice();
$mc2 -> qa("For which of the 3 values of \( \epsilon \) is the set \( B_{\epsilon}(p) \cap S \) the graph of a \( C^1 \) function of the form \( x = f(y) \)?", "None of the above");
$mc2 -> makeLast("\( 0.1 \) ", "\( 0.7 \)", "\( 1.6 \)", "None of the above");

$mc3 = new_checkbox_multiple_choice();
$mc3 -> qa("For which of the 3 values of \( \epsilon \) is the set \( B_{\epsilon}(p) \cap S \) a graph of a \( C^1 \) function?", "\( 0.1 \) ", "\( 0.7 \)");
$mc3 -> makeLast("\( 0.1 \) ", "\( 0.7 \)", "\( 1.6 \)", "None of the above");

##############################################################
#
#  Text

BEGIN_TEXT
$BR
Let \( S = \lbrace (x, y) \in \mathbb{R}^2: x^2 + y^2 = 1 \rbrace \) be the unit circle. Fix the point \( p = (0,1) \in S \). The plots below illustrate the sets \( B_{\epsilon}(p) \cap S \) for three different values \( \epsilon \in \lbrace 0.1,0.7,1.6 \rbrace \). See \{ htmlLink("https://www.desmos.com/calculator/sntco9z1xk", "Desmos") \} for details.
$PAR
$BCENTER
\{ image("d5-circle-disk-small.png", width=>300) \}
\{ image("d5-circle-disk-medium.png", width=>300) \}
\{ image("d5-circle-disk-large.png", width=>300) \}
$ECENTER
$PAR
\{ $mc1 -> print_q() \}
$BR
\{ $mc1 -> print_a() \}
$BR
\{ $mc2 -> print_q() \}
$BR
\{ $mc2 -> print_a() \}
$BR
\{ $mc3 -> print_q() \}
$BR
\{ $mc3 -> print_a() \}
END_TEXT

##############################################################
#
#  Answers

install_problem_grader(~~&std_problem_grader);
ANS( checkbox_cmp( $mc1->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );
ANS( checkbox_cmp( $mc3->correct_ans() ) );

ENDDOCUMENT();