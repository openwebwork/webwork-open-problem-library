TEXT(beginproblem());

BEGIN_PGML
What is the shortest distance from the surface [` xy+2x+z^2 = 9 `] to the origin?

[________]{Compute(sqrt(23/3))}
END_PGML

$showHint = 0;
BEGIN_HINT
Minimize the square of the distance.
END_HINT

$showPartialCorrectAnswers = 0;

