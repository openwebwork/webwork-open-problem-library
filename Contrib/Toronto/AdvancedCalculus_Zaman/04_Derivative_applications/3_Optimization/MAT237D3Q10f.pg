DOCUMENT();

loadMacros("PGstandard.pl", "PGML.pl", "MathObjects.pl");

TEXT(beginproblem());

BEGIN_PGML
Maximize [` f(x,y) = x+y `] on the closed disk [` S = \{(x,y) \in \mathbb{R}^2: x^2+y^2 \leq 1\} `].

The maximum value is [________]{Compute(sqrt(2))}.
END_PGML

$showHint=0;
BEGIN_HINT
Hint: Use polar coordinates for the boundary.
END_HINT

$showPartialCorrectAnswers = 0;

ENDDOCUMENT();