## DESCRIPTION
## Optimization
## ENDDESCRIPTION

## DBsubject('Calculus - multivariable')
## DBchapter('Differentiation of multivariable functions')
## DBsection('Optimization')

################################################################

DOCUMENT();

loadMacros("PGstandard.pl", "PGcourse.pl", "PGchoicemacros.pl");

TEXT(beginproblem());

################################################################
#
#  Setup

$mc = new_checkbox_multiple_choice();
$mc -> qa(
"Let \( S \subseteq \mathbb{R}^n \) and \( f: S \to \mathbb{R} \). Let \( a \in S \). Which of the following are true or false?",
"\( f \) has a global maximum at \( a \) if and only if \( \forall x \in S \), \( f(x) \leq f(a) \).",
"If \( f \) has a global extremum at \( a \) then \( f \) has a local extremum at \( a \).",
"If \( f \) is continuous on \( S \), \( f \) is differentiable on the interior \( S^{\circ} \), and \( S \) is compact, then the global extrema of \( f \) occur either on the boundary \( \partial S \) or at a critical point \( p \) where \( \nabla f(p) = 0 \)"
);

$mc -> makeLast(
"\( f \) has a global maximum at \( a \) if and only if \( \forall x \in S \), \( f(x) \leq f(a) \).",
"If \( f \) has a global extremum at \( a \) then \( f \) has a local extremum at \( a \).",
"If \( f \) has a global extremum at \( a \) and \( f \) is differentiable on the interior \( S^{\circ} \) then \( \nabla f(a) = 0 \).",
"If \( f \) is continuous on \( S \) then the global extrema of \( f \) occur either on the boundary \( \partial S \) or the interior \( S^{\circ} \).",
"If \( f \) is continuous on \( S \), \( f \) is differentiable on the interior \( S^{\circ} \), and \( S \) is compact, then the global extrema of \( f \) occur either on the boundary \( \partial S \) or at a critical point \( p \) where \( \nabla f(p) = 0 \)"
);

################################################################
#
#  Text

BEGIN_TEXT
$BR
\{ $mc->print_q() \}
$BR
\{ $mc->print_a() \}
END_TEXT


################################################################
#
#  Answers

$showPartialCorrectAnswers = 0;
ANS( checkbox_cmp( $mc->correct_ans() ) );

ENDDOCUMENT();