## DBsubject('Calculus - multivariable')
## DBchapter('Differentiation of multivariable functions')
## DBsection('Optimization')

DOCUMENT();

loadMacros("PGstandard.pl", "PGML.pl", "MathObjects.pl");

TEXT(beginproblem());

BEGIN_PGML
Maximize [` f(x,y) = x+y+z `] on the closed ball [` S = \{(x,y,z) \in \mathbb{R}^3: x^2+y^2+z^2 \leq 1\} `].

The maximum value is [________]{Compute(sqrt(3))}.
END_PGML

$showHint=0;
BEGIN_HINT
Hint: Use spherical coordinates for the boundary.
END_HINT

$showPartialCorrectAnswers = 0;

ENDDOCUMENT();