$mc1 = RadioButtons(@lst, "There is a maximum and minimum on \(D\) but we cannot determine what they are with the given information.");

$mc2 = RadioButtons(@lst, "The maximum is \(8\) and the minimum is \(−\pi\).");

$mc3 = RadioButtons(
["Insert incorrect answer here",
"There is a maximum and minimum on \(S\) but we cannot determine what they are with the given information.",
"There is a maximum and minimum on \(S\) and they lie on the boundary of \(S\).",
