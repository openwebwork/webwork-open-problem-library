##DESCRIPTION
##  Algebra problem: true or false for inequality 
##ENDDESCRIPTION

##KEYWORDS('algebra', 'inequality', 'fraction')

## DBsubject('Algebra')
## DBchapter('Fundamentals')
## DBsection('Real Numbers')
## Date('6/3/2002')
## Author('')
## Institution('')
## TitleText1('Precalculus')
## EditionText1('3')
## AuthorText1('Stewart, Redlin, Watson')
## Section1('1.1')
## Problem1('22')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"PGchoicemacros.pl",
"PGcourse.pl",
);

TEXT(beginproblem());

##############################################################
#
#  Setup
#
#
$mc1 = new_checkbox_multiple_choice();
$mc1 -> qa (
"\(\int_a^b \varphi(x,y,z)dx\) exists provided which assumption(s) hold?", 
"G",
);
$mc1 -> makeLast("A", "B", "C", "D", "E", "F", "G");

$mc2 = new_checkbox_multiple_choice();
$mc2 -> qa (
"\(\int_c^d \int_a^b \varphi(x,y,z) dxdy\) exists provided which assumption(s) hold?", 
"D",
"G",
);
$mc2 -> makeLast("A", "B", "C", "D", "E", "F", "G");

$mc3 = new_checkbox_multiple_choice();
$mc3 -> qa (
"\(\int_e^f \int_c^d \int_a^b \varphi(x, y, z) dxdydz\) exists provided which assumption(s) hold?",
"A",
"D",
"G",
);
$mc3 -> makeLast("A", "B", "C", "D", "E", "F", "G");

$mc4 = new_checkbox_multiple_choice();
$mc4 -> qa (
"\(\int_R \varphi dV = \int_e^f \int_c^d \int_a^b \varphi(x,y,z) dxdydz\) provided which assumption(s) hold?",
"A",
"D",
"G",
);
$mc4 -> makeLast("A", "B", "C", "D", "E", "F", "G");

##############################################################
#
#  Text
#
#

BEGIN_TEXT
Let \(R = [a, b] \times [c, d] \times [e, f]\) be a rectangle in \(\mathbb{R}^3\) and let \(\varphi: R \to \mathbb{R}\) be bounded. Consider 7 different assumptions you might use to apply Fubini's theorem in \(\mathbb{R}^3\).
\[(A) \varphi \textrm{ is integral on } [a, b] \times [c, d] \times [e, f]. \\ \\
(B) \textrm{ For every } x \in [a, b], \textrm{ the x-slice } \varphi^x \textrm{ is integrable on } [c, d] \times [e, f]. \\ \\
(C) \textrm{ For every } y \in [c, d], \textrm{ the y-slice } \varphi^y \textrm{ is integrable on } [a, b] \times [e, f]. \\ \\
(D) \textrm{ For every } z \in [e, f], \textrm{ the z-slice } \varphi^z \textrm{ is integrable on } [a, b] \times [c, d]. \\ \\
(E) \textrm{ For every } x \in [a, b], y \in [c, d], \textrm{ the (x, y)-slice } \varphi^{x,y} \textrm{ is integrable on } [e, f]. \\ \\
(F) \textrm{ For every } x \in [a, b], z \in [e, f], \textrm{ the (x, z)-slice } \varphi^{x,z} \textrm{ is integrable on } [c, d]. \\ \\
(G) \textrm{ For every } y \in [c, d], z \in [e, f], \textrm{ the (y, z)-slice } \varphi^{y,z} \textrm{ is integrable on } [a, b].\]

$BR
\{ $mc1 -> print_q() \}
$BR
\{ $mc1 -> print_a() \}

$BR
\{ $mc2 -> print_q() \}
$BR
\{ $mc2 -> print_a() \}
$BR
\{ $mc3 -> print_q() \}
$BR
\{ $mc3 -> print_a() \}

$BR
\{ $mc4 -> print_q() \}
$BR
\{ $mc4 -> print_a() \}
END_TEXT

##############################################################
#
#  Answers
#
#

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );
ANS( checkbox_cmp( $mc3->correct_ans() ) );
ANS( checkbox_cmp( $mc4->correct_ans() ) );


ENDDOCUMENT();       
