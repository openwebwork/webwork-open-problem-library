##DESCRIPTION
##  Algebra problem: true or false for inequality 
##ENDDESCRIPTION

##KEYWORDS('algebra', 'inequality', 'fraction')

## DBsubject('Algebra')
## DBchapter('Fundamentals')
## DBsection('Real Numbers')
## Date('6/3/2002')
## Author('')
## Institution('')
## TitleText1('Precalculus')
## EditionText1('3')
## AuthorText1('Stewart, Redlin, Watson')
## Section1('1.1')
## Problem1('22')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"PGchoicemacros.pl",
#"PGgraders.pl",
);

TEXT(beginproblem());

##############################################################
#
#  Setup
#
# Create and use pop up lists 
$tf = new_select_list();
$tf->rf_print_q(~~&pop_up_list_print_q);

# Specify choices presented to students
$tf->ra_pop_up_list( 
[ No_answer => "?", "True"=>"True", "False"=>"False"] );

# Questions and answers
$tf -> qa ( 
"If \(f\) is integrable on \(R\), then all 6 iterated triple integrals of \(f\) over \(R\) exist.",
"False",
"If all 6 iterated triple integrals of \(f\) over \(R\) exist, then \(f\) is integrable on \(R\).",
"False",
);

# How many questions to use
$tf->choose(2);

##############################################################
#
#  Text
#
#

BEGIN_TEXT
Let \(R\) be a rectangle in \(\mathbb{R}^3\) and \(f: R \to \mathbb{R}\) be bounded.
Are the following statements True or False? 
$BR
\{ $tf-> print_q \}
END_TEXT

##############################################################
#
#  Answers
#
#

install_problem_grader(~~&std_problem_grader);
$showPartialCorrectAnswers = 0;

ANS(str_cmp($tf->ra_correct_ans));

ENDDOCUMENT();    
