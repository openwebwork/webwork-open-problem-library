##DESCRIPTION
##  Algebra problem: true or false for inequality 
##ENDDESCRIPTION

##KEYWORDS('algebra', 'inequality', 'fraction')

## DBsubject('Algebra')
## DBchapter('Fundamentals')
## DBsection('Real Numbers')
## Date('6/3/2002')
## Author('')
## Institution('')
## TitleText1('Precalculus')
## EditionText1('3')
## AuthorText1('Stewart, Redlin, Watson')
## Section1('1.1')
## Problem1('22')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
);

TEXT(beginproblem());

##############################################################
#
#  Setup
#
#
Context("Numeric");

$popup1 = PopUp(
  ["?","True","False"],
  "True",
);

$popup2 = PopUp(
  ["?","True","False"],
  "True"
);

$popup3 = PopUp(
  ["?","True","False"],
  "False",
);

##############################################################
#
#  Text
#
#

Context()->texStrings;
BEGIN_TEXT
Let \(f: [a, b] \times [c, d] \to \mathbb{R}\) be a function. Are the following statements true or false? $BR $BR
If \(f\) is bounded, then every x-slice of \(f\) is bounded. $BR $BR
\{ $popup1->menu() \}$BR $BR
If \(f\) is continous, then every x-slice of \(f\) is continous. $BR $BR
\{ $popup2->menu() \}$BR $BR
If \(f\) is integrable, then every x-slice of \(f\) is integrable.$BR $BR
\{ $popup3->menu() \}$BR $BR
END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $popup1->cmp() );  
ANS( $popup2->cmp() );    
ANS( $popup3->cmp() );   

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup1->correct_ans() \}
The correct answer is \{ $popup2->correct_ans() \}
The correct answer is \{ $popup3->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();
