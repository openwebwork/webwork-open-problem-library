########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"PGchoicemacros.pl",
);

##############################################################
#
#  Setup
$mc1 = new_multiple_choice();
$mc1->qa(
"\( 0 \leq \rho \leq R, \
0 \leq \theta \leq 2 \pi, \
0 \leq \phi \leq \frac{\pi}{2}\)", 
"B"
);
$mc1->makeLast("A", "B", "C", "D", "E", "F", "G", "H");

$mc2 = new_multiple_choice();
$mc2->qa(
"\( 0 \leq \rho \leq R, \
0 \leq \theta \leq \frac{\pi}{2}, \
0 \leq \phi \leq \frac{\pi}{2}\)", 
"F"
);
$mc2->makeLast("A", "B", "C", "D", "E", "F", "G", "H");

$mc3 = new_multiple_choice();
$mc3->qa(
"\( r \leq \rho \leq R, \
0 \leq \theta \leq 2 \pi, \
0 \leq \phi \leq \pi\)", 
"A"
);
$mc3->makeLast("A", "B", "C", "D", "E", "F", "G", "H");

$mc4 = new_multiple_choice();
$mc4->qa(
"\( 0 \leq \rho \leq R, \
0 \leq \theta \leq \pi, \
0 \leq \phi \leq \pi\)", 
"D"
);
$mc4->makeLast("A", "B", "C", "D", "E", "F", "G", "H");

$mc5 = new_multiple_choice();
$mc5->qa(
"\( 0 \leq \rho \leq R, \
0 \leq \theta \leq \pi, \
0 \leq \phi \leq \frac{\pi}{2}\)", 
"D"
);
$mc5->makeLast("A", "B", "C", "D", "E", "F", "G", "H");

$mc6 = new_multiple_choice();
$mc6->qa(
"\( 0 \leq \rho \leq R, \
0 \leq \theta \leq 2 \pi, \
0 \leq \phi \leq \frac{\pi}{6}\)", 
"E"
);
$mc6->makeLast("A", "B", "C", "D", "E", "F", "G", "H");
##############################################################
#
#  Text
#
#

BEGIN_TEXT
Each set of equations in spherical coordinates below corresponds to one of the following shapes:
\[\textrm{(A) Solid between two spheres
(B) Upper hemisphere} \\
\textrm{(C) Lower hemisphere
(D) Right half-sphere} \\
\textrm{(E) Quarter-sphere
(F)} \frac{1}{8} \textrm{sphere} \\
\textrm{(G) Cone with flat cap
(H) Cone with spherical cap}\]
$BR
$BR
\{ $mc1->print_q() \}
$BR
\{ $mc1->print_a() \}
$BR
\{ $mc2->print_q() \}
$BR
\{ $mc2->print_a() \}
$BR
\{ $mc3->print_q() \}
$BR
\{ $mc3->print_a() \}
$BR
\{ $mc4->print_q() \}
$BR
\{ $mc4->print_a() \}
$BR
\{ $mc5->print_q() \}
$BR
\{ $mc5->print_a() \}
$BR
\{ $mc6->print_q() \}
$BR
\{ $mc6->print_a() \}
END_TEXT

##############################################################
#
#  Answers
#
#

$showPartialCorrectAnswers = 0;

ANS( radio_cmp( $mc1->correct_ans() ) );
ANS( radio_cmp( $mc2->correct_ans() ) );
ANS( radio_cmp( $mc3->correct_ans() ) );
ANS( radio_cmp( $mc4->correct_ans() ) );
ANS( radio_cmp( $mc5->correct_ans() ) );
ANS( radio_cmp( $mc6->correct_ans() ) );

ENDDOCUMENT();