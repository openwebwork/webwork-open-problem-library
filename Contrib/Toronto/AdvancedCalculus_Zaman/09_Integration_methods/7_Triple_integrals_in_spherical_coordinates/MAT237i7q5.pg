##DESCRIPTION
##  Algebra problem: true or false for inequality 
##ENDDESCRIPTION

##KEYWORDS('algebra', 'inequality', 'fraction')

## DBsubject('Algebra')
## DBchapter('Fundamentals')
## DBsection('Real Numbers')
## Date('6/3/2002')
## Author('')
## Institution('')
## TitleText1('Precalculus')
## EditionText1('3')
## AuthorText1('Stewart, Redlin, Watson')
## Section1('1.1')
## Problem1('22')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"PGchoicemacros.pl",
);

##############################################################
#
#  Setup
#
#
$mc1 = new_multiple_choice();
$mc1->qa(
"", 
"cylindrical"
);
$mc1->makeLast("rectangular", "cylindrical", "spherical");

$mc2 = new_multiple_choice();
$mc2->qa(
"", 
"spherical"
);
$mc2->makeLast("rectangular", "cylindrical", "spherical");


$mc3 = new_multiple_choice();
$mc3->qa(
"", 
"rectangular"
);
$mc3->makeLast("rectangular", "cylindrical", "spherical");


$mc4 = new_multiple_choice();
$mc4->qa(
"", 
"cylindrical"
);
$mc4->makeLast("rectangular", "cylindrical", "spherical");

##############################################################
#
#  Text
#
#

BEGIN_TEXT

Would you describe the following regions in rectangular, cylindrical or spherical coordinates?  $BR$BR

\{ image( "i7-region-a.png", width=>150, height=>150) \}
$BR
\{ $mc1->print_q() \}
$BR
\{ $mc1->print_a() \}
$BR
\{ image( "i7-region-b.png", width=>150, height=>150) \}
$BR
\{ $mc2->print_q() \}
$BR
\{ $mc2->print_a() \}
$BR
\{ image( "i7-region-c.png", width=>150, height=>150) \}
$BR
\{ $mc3->print_q() \}
$BR
\{ $mc3->print_a() \}
$BR
\{ image( "i7-region-d.png", width=>150, height=>150) \}
$BR
\{ $mc4->print_q() \}
$BR
\{ $mc4->print_a() \}

END_TEXT


##############################################################
#
#  Answers
#
#

$showPartialCorrectAnswers = 0;

ANS( radio_cmp( $mc1->correct_ans() ) );
ANS( radio_cmp( $mc2->correct_ans() ) );
ANS( radio_cmp( $mc3->correct_ans() ) );
ANS( radio_cmp( $mc4->correct_ans() ) );

ENDDOCUMENT();  
