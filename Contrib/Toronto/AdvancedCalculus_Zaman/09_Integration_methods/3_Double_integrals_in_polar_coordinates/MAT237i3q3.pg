##DESCRIPTION
##  Algebra problem: true or false for inequality 
##ENDDESCRIPTION

##KEYWORDS('algebra', 'inequality', 'fraction')

## DBsubject('Algebra')
## DBchapter('Fundamentals')
## DBsection('Real Numbers')
## Date('6/3/2002')
## Author('')
## Institution('')
## TitleText1('Precalculus')
## EditionText1('3')
## AuthorText1('Stewart, Redlin, Watson')
## Section1('1.1')
## Problem1('22')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"PGchoicemacros.pl",
);

##############################################################
#
#  Setup
#
$mc1 = new_multiple_choice();
$mc1->qa(
"Match this plot to one of the equations above", 
"C"
);
$mc1->makeLast("A", "B", "C", "D", "E", "F");

$mc2 = new_multiple_choice();
$mc2->qa(
"Match this plot to one of the equations above", 
"F"
);
$mc2->makeLast("A", "B", "C", "D", "E", "F");

$mc3 = new_multiple_choice();
$mc3->qa(
"Match this plot to one of the equations above", 
"A"
);
$mc3->makeLast("A", "B", "C", "D", "E", "F");

$mc4 = new_multiple_choice();
$mc4->qa(
"Match this plot to one of the equations above", 
"E"
);
$mc4->makeLast("A", "B", "C", "D", "E", "F");

##############################################################
#
#  Text
#
#

BEGIN_TEXT
Here is a list of six equations in polar coordinates.
\[ (A) \ r = \theta, \theta > 0 \ \ \ (B) \ r = \theta, \theta < 0  \ \ \ (C) \ r = 1 + cos(2 \theta) \\
(D) \ r = cos(3 \theta) \ \ \ (E) \ r = sin(3 \theta) \ \ \ \ (F) \ r = 1 + 2 cos(\theta) \] $BR 
$BR
\{ $mc1->print_q() \}
$BR
\{ image( "i3-loop-two.png", width=>300, height=>300) \}
$BR
\{ $mc1->print_a() \}

$BR
\{ $mc2->print_q() \}
$BR
\{ image( "i3-spiral.png", width=>300, height=>300 ) \}
$BR
\{ $mc2->print_a() \}

$BR
\{ $mc3->print_q() \}
$BR
\{ image( "i3-cardiod.png", width=>300, height=>300 ) \}
$BR
\{ $mc3->print_a() \}

$BR
\{ $mc4->print_q() \}
$BR
\{ image( "i3-loop-three.png", width=>300, height=>300 ) \}
$BR
\{ $mc4->print_a() \}
END_TEXT

##############################################################
#
#  Answers

$showPartialCorrectAnswers = 0;

ANS( radio_cmp( $mc1->correct_ans() ) );
ANS( radio_cmp( $mc2->correct_ans() ) );
ANS( radio_cmp( $mc3->correct_ans() ) );
ANS( radio_cmp( $mc4->correct_ans() ) );

ENDDOCUMENT();       
