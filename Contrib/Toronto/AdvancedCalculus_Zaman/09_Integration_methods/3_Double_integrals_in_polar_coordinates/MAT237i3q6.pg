########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"PGchoicemacros.pl",
);

##############################################################
#
#  Setup
#
#
$mc1 = new_multiple_choice();
$mc1->qa(
"One of them is truly correct. Identify who.", 
"Chuck"
);
$mc1->makeLast("Archie", "Betty", "Chuck");

$mc2 = new_multiple_choice();
$mc2->qa(
"One of them is accidentally correct. Identify who.", 
"Archie"
);
$mc2->makeLast("Archie", "Betty", "Chuck");

##############################################################
#
#  Text
#
#

BEGIN_TEXT
Three friends are calculating the mass of two leaves bounded by the curve \(r = sin(2\theta)\) for \( 0 \leq \theta \leq \pi \). The mass density is given by a function \(\delta\). 
 
$BR $BR

\{ image( "i3-q6-proof.png", width=>650, height=>300, ) \}

$BR
\{ $mc1->print_q() \}
$BR
\{ $mc1->print_a() \}
$BR
\{ $mc2->print_q() \}
$BR
\{ $mc2->print_a() \}
END_TEXT

##############################################################
#
#  Answers
#
#

$showPartialCorrectAnswers = 0;

ANS( radio_cmp( $mc1->correct_ans() ) );
ANS( radio_cmp( $mc2->correct_ans() ) );

ENDDOCUMENT(); 
