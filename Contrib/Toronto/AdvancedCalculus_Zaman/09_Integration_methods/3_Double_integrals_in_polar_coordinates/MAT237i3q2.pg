########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"PGchoicemacros.pl",
);

##############################################################
#
#  Setup
#
$mc1 = new_multiple_choice();
$mc1->qa(
"Should you integrate over this area in rectangular or polar coordinates?", 
"rectangular"
);
$mc1->makeLast("rectangular", "polar", "neither", "both");

$mc2 = new_multiple_choice();
$mc2->qa(
"Should you integrate over this area in rectangular or polar coordinates?", 
"polar"
);
$mc2->makeLast("rectangular", "polar", "neither", "both");

$mc3 = new_multiple_choice();
$mc3->qa(
"Should you integrate over this area in rectangular or polar coordinates?", 
"rectangular"
);
$mc3->makeLast("rectangular", "polar", "neither", "both");

$mc4 = new_multiple_choice();
$mc4->qa(
"Should you integrate over this area in rectangular or polar coordinates?", 
"polar"
);
$mc4->makeLast("rectangular", "polar", "neither", "both");

##############################################################
#
#  Text
#
#
BEGIN_TEXT

\{ $mc1->print_q() \}
$BR
\{ image( "i3-region-a.png", width=>150, height=>150) \}
$BR
\{ $mc1->print_a() \}
$BR
\{ $mc2->print_q() \}
$BR
\{ image( "i3-region-b.png", width=>150, height=>150) \}
$BR
\{ $mc2->print_a() \}
$BR
\{ $mc3->print_q() \}
$BR
\{ image( "i3-region-c.png", width=>150, height=>150) \}
$BR
\{ $mc3->print_a() \}
$BR
\{ $mc4->print_q() \}
$BR
\{ image( "i3-region-d.png", width=>150, height=>150) \}
$BR
\{ $mc4->print_a() \}
$BR

END_TEXT

##############################################################
#
#  Answers
#
#
$showPartialCorrectAnswers = 0;

ANS( radio_cmp( $mc1->correct_ans() ) );
ANS( radio_cmp( $mc2->correct_ans() ) );
ANS( radio_cmp( $mc3->correct_ans() ) );
ANS( radio_cmp( $mc4->correct_ans() ) );

ENDDOCUMENT();       
