###########################
#  Initialization

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserRadioButtons.pl",
  "PGML.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup

Context("Numeric");
##M5 Q3.1 
$radio1 = RadioButtons(
  ["True","False","Nonsense"],
  "False", # correct answer
  last => ["True","False","Nonsense"], # can be a list
);

##M5 Q3.2
$radio2 = RadioButtons(
    ["True","False","Nonsense"],
  "True", # correct answer
  last => ["True","False","Nonsense"], # can be a list
);

##M5 Q3.3 
$radio3 = RadioButtons(
   ["True","False","Nonsense"],
  "True", # correct answer
  last => ["True","False","Nonsense"], # can be a list
);

##M5 Q3.4
$radio4 = RadioButtons(
  ["True","False","Nonsense"],
  "False", # correct answer
  last => ["True","False","Nonsense"], # can be a list
);

##M5 Q3.5
$radio5 = RadioButtons(
  ["True","False","Nonsense"],
  "False", # correct answer
  last => ["True","False","Nonsense"], # can be a list
);

##M5 Q3.6
$radio6 = RadioButtons(
  ["True","False","Nonsense"],
  "Nonsense", # correct answer
  last => ["True","False","Nonsense"], # can be a list
);

##M5 Q3.7
$radio7 = RadioButtons(
  ["True","False","Nonsense"],
  "False", # correct answer
  last => ["True","False","Nonsense"], # can be a list
);



###########################
#  Main text

BEGIN_TEXT
Which statements are true, false, or nonsense?  $BR $BR

1. Gradient vector fields are sourceless. 
END_TEXT

BEGIN_PGML
[@ $radio1->buttons() @]*
END_PGML

BEGIN_TEXT
2. Gradient vector fields are irrotational. 
END_TEXT

BEGIN_PGML
[@ $radio2->buttons() @]*
END_PGML

BEGIN_TEXT
3. Curl vector fields are sourceless. 
END_TEXT

BEGIN_PGML
[@ $radio3->buttons() @]*
END_PGML

BEGIN_TEXT
4. Curl vector fields are irrotational. 
END_TEXT

BEGIN_PGML
[@ $radio4->buttons() @]*
END_PGML

BEGIN_TEXT
5. Curl vector fields are conservative.
END_TEXT

BEGIN_PGML
[@ $radio5->buttons() @]*
END_PGML

BEGIN_TEXT
6. Divergence vector fields are irrotational.
END_TEXT

BEGIN_PGML
[@ $radio6->buttons() @]*
END_PGML

BEGIN_TEXT
7. Sourceless vector fields are curl vector fields.
END_TEXT

BEGIN_PGML
[@ $radio7->buttons() @]*
END_PGML


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio1->cmp() );
ANS( $radio2->cmp() );
ANS( $radio3->cmp() );
ANS( $radio4->cmp() );
ANS( $radio5->cmp() );
ANS( $radio6->cmp() );
ANS( $radio7->cmp() );


############################
#  Solution

BEGIN_PGML_SOLUTION
The correct answer is [$radio1->correct_ans()]. 

The correct answer is [$radio2->correct_ans()].

The correct answer is [$radio3->correct_ans()]. 

The correct answer is [$radio4->correct_ans()]. 

The correct answer is [$radio5->correct_ans()]. 

The correct answer is [$radio6->correct_ans()]. 

The correct answer is [$radio7->correct_ans()]. 


END_PGML_SOLUTION

COMMENT('MathObject version. Uses PGML.');

ENDDOCUMENT();