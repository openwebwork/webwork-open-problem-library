###########################
#  Initialization

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserRadioButtons.pl",
  "PGML.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup

Context("Numeric");

##J4 Q10.4 d)
$radio1 = RadioButtons(
  ["\( F(x,y,z) = (x^2,y^2,z^2) \)","\( G(x,y,z) = (xz,-yz,xy) \)", "Both", "Neither"],
  "\( G(x,y,z) = (xz,-yz,xy) \)", # correct answer
  last => ["\( F(x,y,z) = (x^2,y^2,z^2) \)","\( G(x,y,z) = (xz,-yz,xy) \)", "Both", "Neither"], # can be a list
);



###########################
#  Main text
BEGIN_TEXT
Which of these are curl vector fields? \( \textit{Hint:} \) Compute the divergence.

$BR
END_TEXT

BEGIN_PGML
[@ $radio1->buttons() @]*
END_PGML



############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio1->cmp() );


############################
#  Solution

BEGIN_PGML_SOLUTION
The correct answer is [$radio1->correct_ans()]. 


END_PGML_SOLUTION

COMMENT('MathObject version. Uses PGML.');

ENDDOCUMENT();