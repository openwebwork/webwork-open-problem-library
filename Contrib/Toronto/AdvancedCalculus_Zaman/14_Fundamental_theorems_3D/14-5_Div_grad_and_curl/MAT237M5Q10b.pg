Context()->texStrings;
BEGIN_TEXT
Let \( F(x,y,z) = \left(\dfrac{x}{x^2+y^2},\dfrac{y}{x^2+y^2},0\right) \) and \( C \) the pentagon with vertices \( (0,1,1), (1,1,0), (1,-2,-1), (-1,-3,1), \) and \( (-2,0,0) \) travelled in that order. Calculate the circulation of \( F \) along \( C \) by moving the curve to a circle. 
$BR
\{$q1->ans_rule\}

END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

ANS($q1->with(tolerance=>.01)->cmp);


