##DESCRIPTION
## MAT237 M5 Q2
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','fundamental theorems','Stokes’ theorem','curl','circulation','divergence','flux')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Div, grad, and curl')
## Institution('University of Toronto')
## Section1('M5')
## Problem1('2')


###########################
#  Initialization

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserRadioButtons.pl",
  "PGML.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup

Context("Numeric");
##M5 Q2.1 
$radio1 = RadioButtons(
  ["True","False","Nonsense"],
  "True", # correct answer
  last => ["True","False","Nonsense"], # can be a list
);

##M5 Q2.2
$radio2 = RadioButtons(
    ["True","False","Nonsense"],
  "False", # correct answer
  last => ["True","False","Nonsense"], # can be a list
);

##M5 Q2.3 
$radio3 = RadioButtons(
   ["True","False","Nonsense"],
  "False", # correct answer
  last => ["True","False","Nonsense"], # can be a list
);

##M5 Q2.4
$radio4 = RadioButtons(
  ["True","False","Nonsense"],
  "True", # correct answer
  last => ["True","False","Nonsense"], # can be a list
);

##M5 Q2.5
$radio5 = RadioButtons(
  ["True","False","Nonsense"],
  "Nonsense", # correct answer
  last => ["True","False","Nonsense"], # can be a list
);



###########################
#  Main text

BEGIN_TEXT
Let \( F: \mathbb{R}^3 \to  \mathbb{R}^3 \) be a \( C^2 \) vector field with \( F = (F_1,F_2,F_3). \)  Let \( f :  \mathbb{R}^3 \to \mathbb{R} \) be a \( C^2 \) scalar function. $BR
Which statements are true, false, or nonsense?  $BR $BR

1. \( \text{Curl}( \nabla f) = 0 \)
END_TEXT

BEGIN_PGML
[@ $radio1->buttons() @]*
END_PGML

BEGIN_TEXT
2. \( \text{Curl}( \text{Curl}(F)) = 0 \)
END_TEXT

BEGIN_PGML
[@ $radio2->buttons() @]*
END_PGML

BEGIN_TEXT
3. \( \text{Div}( \nabla f) = 0 \)
END_TEXT

BEGIN_PGML
[@ $radio3->buttons() @]*
END_PGML

BEGIN_TEXT
4. \( \text{Div}( \text{Curl}(F)) = 0 \)
END_TEXT

BEGIN_PGML
[@ $radio4->buttons() @]*
END_PGML

BEGIN_TEXT
5. \( \text{Curl}( \text{Div}(F) ) = 0 \) 
END_TEXT

BEGIN_PGML
[@ $radio5->buttons() @]*
END_PGML


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio1->cmp() );
ANS( $radio2->cmp() );
ANS( $radio3->cmp() );
ANS( $radio4->cmp() );
ANS( $radio5->cmp() );


############################
#  Solution

BEGIN_PGML_SOLUTION
The correct answer is [$radio1->correct_ans()]. 

The correct answer is [$radio2->correct_ans()].

The correct answer is [$radio3->correct_ans()]. 

The correct answer is [$radio4->correct_ans()]. 

The correct answer is [$radio5->correct_ans()]. 


END_PGML_SOLUTION

COMMENT('MathObject version. Uses PGML.');

ENDDOCUMENT();