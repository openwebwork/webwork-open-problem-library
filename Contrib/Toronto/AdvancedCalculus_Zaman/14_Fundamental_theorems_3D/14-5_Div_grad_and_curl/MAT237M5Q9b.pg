# Print problem number and point value (weight) for the problem
TEXT(beginproblem());

# Show which answers are correct and which ones are incorrect
$showPartialCorrectAnswers = 1;

##############################################################
#
#  Setup
#
#
Context("Numeric");

$q1 = Compute("-pi/4"); #M5 Q9.2




##############################################################
#
#  Text
#
#

Context()->texStrings;
BEGIN_TEXT
Let \( F(x,y,z) = (x^2 +\cos(z^3), yz,3xz) \) and \( S  = \lbrace (x,y,z) \in  \mathbb{R}^3 : x^2+y^2 +z^2 = 1, z \leq 0 \rbrace \) be the lower hemisphere. Calculate the downward flux of \( F \) through \( S \) by moving the surface to a disk. You may give an exact answer or round to two decimal places.
$BR
\{$q1->ans_rule\}

END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

ANS($q1->with(tolerance=>.01)->cmp);


# default tolerance is .01 or one percent.


ENDDOCUMENT();    