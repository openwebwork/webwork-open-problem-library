##DESCRIPTION
## MAT237 M2 Q1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','fundamental theorems','flux','divergence')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Divergence theorem')
## Institution('University of Toronto')
## Section1('M2')
## Problem1('1')


########################################################################

DOCUMENT();      

loadMacros(
   "PGstandard.pl",     # Standard macros for PG language
   "MathObjects.pl",
   #"source.pl",        # allows code to be displayed on certain sites.
   #"PGcourse.pl",      # Customization file for the course
);

# Print problem number and point value (weight) for the problem
TEXT(beginproblem());

# Show which answers are correct and which ones are incorrect
$showPartialCorrectAnswers = 1;

##############################################################
#
#  Setup
#
#
Context("Numeric");

$q1 = Compute("0"); #M2 Q1.1
$q2 = Compute("3"); #M2 Q1.2



##############################################################
#
#  Text
#
#

Context()->texStrings;
BEGIN_TEXT
Here's two rapid calculations with the divergence theorem. $BR
1. Compute the outward flux of \( F(x,y,z)=(y,z,0) \) through the boundary of the unit ball \( B_1(0,0,0) \). $BR
\{$q1->ans_rule\}
$BR $BR
2. Calculate the outward flux of \( F(x,y,z) = (x,y,z)\) through the boundary of the unit cube \( [0,1]^3 \). $BR
\{$q2->ans_rule\}

END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

ANS($q1->with(tolerance=>.02)->cmp);
ANS($q2->with(tolerance=>.02)->cmp);

# default tolerance is .01 or one percent.


ENDDOCUMENT();     