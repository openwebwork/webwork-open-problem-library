########################################################################

DOCUMENT();      

loadMacros(
   "PGstandard.pl",     # Standard macros for PG language
   "MathObjects.pl",
   #"source.pl",        # allows code to be displayed on certain sites.
   #"PGcourse.pl",      # Customization file for the course
);

# Print problem number and point value (weight) for the problem
TEXT(beginproblem());

# Show which answers are correct and which ones are incorrect
$showPartialCorrectAnswers = 1;

##############################################################
#
#  Setup
#
#
Context("Numeric");

$q1 = Compute("-381.7"); #M2 Q1.1
$q2 = Compute("1/2"); #M2 Q1.2
$q3 = Compute("5/2"); #M2 Q1.2



##############################################################
#
#  Text
#
#

Context()->texStrings;
BEGIN_TEXT
Here is additional practice with applying the divergence theorem. $BR

1. Let \( F(x,y,z) = (x,y,z). \) Let \( R = \lbrace (x,y,z) \in \mathbb{R}^3 : x^2+y^2 \leq z \leq 9\rbrace \) be the solid paraboloid with a disk glued on top of it. Let \( S =\partial R \) with \( \textbf{inward} \) normal. Compute the flux of \( F \) through \( S \). Round to the nearest whole number $BR
\{$q1->ans_rule\}
$BR $BR
2. Let \( F(x,y,z) = (2x,-y,xy) \) and \( S \) be the oriented boundary of a triangular prism formed by the coordinate axes, the plane \( y+z = 1 \), and the plane \( x = 1 \). Compute the outward flux of \( F \) through \( S \). \( \textit{Hint}: \) Almost no computation necessary! You may give your answer as a fraction or a decimal. $BR
\{$q2->ans_rule\}
$BR $BR
3. Let \( F(x,y) = (x+\sin(y)\cos(z), \cos(x)e^x+y,3z+e^x\sin(y)) \) and \( S \) the same as above. Compute the outward flux of \( F \) through \( S \). \( \textit{Hint}: \) Almost no computation necessary! You may give your answer as a fraction or a decimal. $BR
\{$q3->ans_rule\}

END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

ANS($q1->with(tolerance=>.02)->cmp);
ANS($q2->with(tolerance=>.02)->cmp);
ANS($q3->with(tolerance=>.02)->cmp);

# default tolerance is .01 or one percent.


ENDDOCUMENT();        