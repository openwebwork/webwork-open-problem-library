##DESCRIPTION
## MAT237 M2 Q2
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','fundamental theorems','flux','divergence')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Divergence theorem')
## Institution('University of Toronto')
## Section1('M2')
## Problem1('2')



###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup


## Question L2 Q1 
$mc1 = new_checkbox_multiple_choice();

$mc1 -> qa (
" ", 
"\[ \iint_S (F \cdot n) dS \]", #should be \oiint
"\[ \iint_{-S} (F \cdot n) dS \]", #should be \oiint
"\[ -\iint_{-S} (F \cdot n) dS \]"
);

$mc1->makeLast("\[ \iint_S (F \cdot n) dS \]", #should be \oiint
"\[ -\iint_S (F \cdot n) dS \]",
"\[ \iint_{-S} (F \cdot n) dS \]", #should be \oiint
"\[ \iiint_R \text{div}(F) dV \]",
"\[ -\iiint_R \text{div}(F) dV \]",
"\[ -\iint_{-S} (F \cdot n) dS \]"
);


###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
Let \( F : \mathbb{R}^3 \to \mathbb{R}^3 \) be a \( C^1 \) vector field  and let \( R\subseteq \mathbb{R}^3 \) be a regular region  whose boundary is a closed piecewise surface. Assume \( S = \partial R \) is positively oriented. Let \( -S \) denote the same surface \( S \) with the \( \textbf{opposite orientation} \).  Each expression either equals the \( \textbf{outward} \) flux of \( F \) through \( S \) or the \( \textbf{inward} \) flux of \( F \) through \( S \). Select the expressions that equal outward flux.

$BR
$BR
\{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}

END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );


############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answers are \{ $mc1->correct_ans() \} $BR
END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT();    