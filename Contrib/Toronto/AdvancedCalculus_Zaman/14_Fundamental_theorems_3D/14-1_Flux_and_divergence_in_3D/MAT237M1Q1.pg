ANS( $radio1->cmp() );
ANS( $radio2->cmp() );
ANS( $radio3->cmp() );
ANS( $radio4->cmp() );
ANS( $radio5->cmp() );
ANS( $radio6->cmp() );
ANS( $radio7->cmp() );
ANS( $radio8->cmp() );


