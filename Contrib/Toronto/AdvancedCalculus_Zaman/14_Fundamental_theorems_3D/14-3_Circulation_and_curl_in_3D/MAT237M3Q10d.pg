);

# Print problem number and point value (weight) for the problem
TEXT(beginproblem());

# Show which answers are correct and which ones are incorrect
$showPartialCorrectAnswers = 1;

##############################################################
#
#  Setup
#
#
Context("Numeric");

$q1 = Compute("0"); #M2 Q1.1
$q2 = Compute("0"); #M2 Q1.2



##############################################################
#
#  Text
#
#

Context()->texStrings;
BEGIN_TEXT
Let \( S \) be the first octant part of the sphere \( x^2+y^2+z^2 =a^2 \) with normal vector pointing away from the origin and \( F(x,y,z) = (zx, \; zy, \; z^2). \) $BR
a) Calculate the circulation \[ \int_C F \cdot T \; ds \] along \( C = \partial S \) which is oriented so that it goes from \( (a,0,0) \) to \( (0,a,0) \) to \( (0,0,a) \) back to \( (a,0,0) \).  $BR
\{$q1->ans_rule\}
$BR $BR
b) Find the total amount of swirl on the surface by calculating \[ \iint_S (\text{curl} F) \cdot n \; dS. \]
\{$q2->ans_rule\}

END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

ANS($q1->with(tolerance=>.02)->cmp);
ANS($q2->with(tolerance=>.02)->cmp);

# default tolerance is .01 or one percent.


ENDDOCUMENT();   