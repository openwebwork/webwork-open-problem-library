DOCUMENT();      

loadMacros(
   "PGstandard.pl",     # Standard macros for PG language
   "MathObjects.pl",
   #"source.pl",        # allows code to be displayed on certain sites.
   #"PGcourse.pl",      # Customization file for the course
);

# Print problem number and point value (weight) for the problem
TEXT(beginproblem());

# Show which answers are correct and which ones are incorrect
$showPartialCorrectAnswers = 1;

##############################################################
#
#  Setup
#
#
Context("Numeric");

$q1 = Compute("-pi"); #M2 Q1.1




##############################################################
#
#  Text
#
#

Context()->texStrings;
BEGIN_TEXT
Let \( P \) be the pringle surface: the piece of the saddle \( z=xy \) inside the cylinder \( x^2+y^2=1. \) 
Orient the boundary \( C = \partial P \)   so that it traverses the pringle counterclockwise when viewed from above.  Calculate the work done by \( F(x,y,z) = (y,z,x) \) along \( C \) using Stokes' theorem. You may give an exact value or round to two decimals. $BR
\{$q1->ans_rule\} $BR
\{ image( "m4-pringle.png", width=>326, height=>368) \}
END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

ANS($q1->with(tolerance=>.02)->cmp);


# default tolerance is .01 or one percent.


ENDDOCUMENT();        