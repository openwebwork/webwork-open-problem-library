Context("Numeric");

$q1 = Compute("0"); #M4 Q10.2




##############################################################
#
#  Text
#
#

Context()->texStrings;
BEGIN_TEXT
Let \( T \subseteq \mathbb{R}^3 \) be the closed torus surface with inner radius \( 3 \) and outer radius \( 5 \). Assume the \( z=0 \) plane cuts the torus in half like a bagel sliced into two pieces.  Let \( F(x,y,z) = (x^2y, \sin(xyz), e^{xy^2}-xyz^4) \). Find the total circulation of \( F \) on \( T \). 
$BR
\{$q1->ans_rule\}

END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

ANS($q1->with(tolerance=>.02)->cmp);


# default tolerance is .01 or one percent.


ENDDOCUMENT();        