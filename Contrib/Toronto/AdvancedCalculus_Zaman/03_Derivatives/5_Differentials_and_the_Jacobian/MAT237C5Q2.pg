DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
"parserPopUp.pl",
"unionLists.pl",
);

TEXT(beginproblem());
# 2.1
$popup1 = PopUp(
  ["?",, "True by a theorem", "True by definition", "Nonsense"],
  "Nonsense",
);
# 2.2
$popup2 = PopUp(
  ["?",, "True by a theorem", "True by definition", "Nonsense"],
  "Nonsense",
);
# 2.1
$popup3 = PopUp(
  ["?",, "True by a theorem", "True by definition", "Nonsense"],
  "Nonsense",
);
# 2.4
$popup4 = PopUp(
  ["?",, "True by a theorem", "True by definition", "Nonsense"],
  "True by a theorem",
);
# 2.5
$popup5 = PopUp(
  ["?",, "True by a theorem", "True by definition", "Nonsense"],
  "True by definition",
);
# 2.6
$popup6 = PopUp(
  ["?",, "True by a theorem", "True by definition", "Nonsense"],
  "Nonsense",
);
# 2.7
$popup7 = PopUp(
  ["?",, "True by a theorem", "True by definition", "Nonsense"],
  "Nonsense",
);

Context()->texStrings;
BEGIN_TEXT
Each relationsihp listed below is either true or nonsense. Determine which is which.
$BR
If it's true, decide whether it follows from some theorems/properties or it is simply a definition.
$BR
$BR
Let \( A\subseteq\mathbb{R}^n \) and let \(a\) be an interior point of \(A\). Assume \( F: A\to\mathbb{R}^m \) is differentiable at \(a\). Fix \( v\in\mathbb{R}^n \).
\{ BeginList('OL', type=>'A') \}

$ITEM \( dF_a = DF(a) \)
\{ $popup1->menu() \}

$ITEMSEP
$ITEM \( dF_a(v+1) = dF_a(v) + dF_a(1) \)
\{ $popup2->menu() \}

$ITEMSEP
$ITEM \( dF_a^3(v) = (dF_a(v))^3 \)
\{ $popup3->menu() \}

$ITEMSEP
$ITEM \( dF_a(v) = DF(a)v \)
\{ $popup4->menu() \}

$ITEMSEP
$ITEM \( DF(a) = \left[\partial_jF^i(a)\right]_{i,k} \)
\{ $popup5->menu() \}

$ITEMSEP
$ITEM \( DF(a) = \left[\partial_iF^j(a)\right]_{i,k} \)
\{ $popup6->menu() \}

$ITEMSEP
$ITEM \( DF_a(h) = \sum_{j=1}^n\partial_j F^i(a)v_j \)
\{ $popup7->menu() \}

\{ EndList('OL') \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4,5,6,7];
$ENV{'grader_scores'} = [0.14,0.28,0.43,0.57,0.71,0.86,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );
ANS( $popup4->cmp() );
ANS( $popup5->cmp() );
ANS( $popup6->cmp() );
ANS( $popup7->cmp() );

Context()->texStrings;
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();