DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
"parserPopUp.pl",
"unionLists.pl",
);

TEXT(beginproblem());
# (a)
$popup1 = PopUp(
  ["?",, "Theorem", "Lemma", "Definition"],
  "Theorem",
);
# (b)
$popup2 = PopUp(
  ["?",, "Theorem", "Lemma", "Definition"],
  "Theorem",
);
# (c)
$popup3 = PopUp(
  ["?",, "Theorem", "Lemma", "Definition"],
  "Definition",
);
# (d)
$popup4 = PopUp(
  ["?",, "Theorem", "Lemma", "Definition"],
  "Lemma",
);

Context()->texStrings;
BEGIN_TEXT
Let \( A\subseteq\mathbb{R}^n \). Let \(a\) be an interior point of \(A\). Let \( F: A\to\mathbb{R}^m \) be differentiable at \(a\). Fix \(v\in\mathbb{R}^n\). 
$BR
$BR
In the following identities, two qualities follow by theorems. One equality follows by a lemma. One equality follows by definition. Identify which is which.
\{ BeginList('OL', type=>'A') \}

$ITEM \( D_vF(a)=dF_a(v) \)
\{ $popup1->menu() \}

$ITEMSEP
$ITEM \( dF_a(v)=DF(a)v \)
\{ $popup2->menu() \}

$ITEMSEP
$ITEM \( DF(a)v=\sum_{j=1}^n\partial_jF(a)v_j \)
\{ $popup3->menu() \}

$ITEMSEP
$ITEM \( \sum_{j=1}^n\partial_jF(a)v_j = \sum_{j=1}^n(\partial_j F^1(a),\cdots,\partial_j F^m(a))v_j \)
\{ $popup4->menu() \}

\{ EndList('OL') \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4];
$ENV{'grader_scores'} = [0.25,0.5,0.75,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );
ANS( $popup4->cmp() );

Context()->texStrings;
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();