DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
"parserPopUp.pl",
"unionLists.pl",
);

TEXT(beginproblem());

Context("Numeric");
#6.1
$popup1 = PopUp(
  ["?","True","False"],
  "True",
);
#6.2
$popup2 = PopUp(
  ["?","True","False"],
  "True",
);
#6.3
$popup3 = PopUp(
  ["?","True","False"],
  "True",
);
#6.4
$popup4 = PopUp(
  ["?","True","False"],
  "True",
);
#6.5
$popup5 = PopUp(
  ["?","True","False"],
  "True",
);
#6.6
$popup6 = PopUp(
  ["?","True","False"],
  "False",
);
#6.7
$popup7 = PopUp(
  ["?","True","False"],
  "False",
);

Context()->texStrings;
BEGIN_TEXT
Determine which statements are true and whicha re false.
$BR
Let \( F:\mathbb{R}^n\to\mathbb{R}^m \) be a map. Let \( \gamma: \mathbb{R}\to\mathbb{R}^m \) be a parametric curve. Let \( f: \mathbb{R}^n\to\mathbb{R} \) be real-valued.
$BR
$BR
\{ BeginList('OL', type=>'A') \}

$ITEM If \(F\) is differentiable at \(a\), then \(F\) is continuous at \(a\).
\{ $popup1->menu() \}

$ITEMSEP
$ITEM If \(F\) is differentiable at \(a\), then all of the partials of \(F\) exist at \(a\).
\{ $popup2->menu() \}

$ITEMSEP
$ITEM If \(F\) is differentiable at \(a\), then all of the directional derivatives of \(F\) exist at \(a\).
\{ $popup3->menu() \}

$ITEMSEP
$ITEM If \(F\) is differentiable at \(a\), then the Jacobian of \(F\) at \(a\) exist.
\{ $popup4->menu() \}

$ITEMSEP
$ITEM If \(F\) is differentiable at \(a\), then the matrix of the differential of \(F\) at \(a\) is the Jacobian of \(F\) at \(a\).
\{ $popup5->menu() \}

$ITEMSEP
$ITEM If \(\gamma\) is differentiable at \(a\), then \( d\gamma_a=\gamma'(a) \).
\{ $popup6->menu() \}

$ITEMSEP
$ITEM If \(\gamma\) is differentiable at \(a\), then \( Df(a) = \nabla f(a) \).
\{ $popup7->menu() \}

\{ EndList('OL') \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4,5,6,7];
$ENV{'grader_scores'} = [0.14,0.28,0.42,0.56,0.71,0.86,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );
ANS( $popup4->cmp() );
ANS( $popup5->cmp() );
ANS( $popup6->cmp() );
ANS( $popup7->cmp() );

Context()->texStrings;
Context()->normalStrings;

COMMENT('MathObject version.');

