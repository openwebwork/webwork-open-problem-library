########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
"parserPopUp.pl",
"unionLists.pl",
);

TEXT(beginproblem());
Context("Matrix");

$A = Matrix([
[1,2,3],
[4,5,6],
[7,8,9],
]);

$B = Matrix([
[1],
[2],
[3],
]);

Context()->texStrings;
BEGIN_TEXT
Define \( G(x,y,z) = \left[
\begin{matrix}
1 & 2 & 3\\
4 & 5 & 6\\
7 & 8 & 9
\end{matrix} \right]\left[\begin{matrix}
x\\
y\\
z
\end{matrix} \right]\). Calculate the following:
\{ BeginList('OL', type=>'A') \}

$ITEM \( G_x \) = (\{ ans_rule(5) \}, \{ ans_rule(5) \}, \{ ans_rule(5) \})

$ITEMSEP
$ITEM \( G_y \) = (\{ ans_rule(5) \}, \{ ans_rule(5) \}, \{ ans_rule(5) \})

$ITEMSEP
$ITEM \( G_z \) = (\{ ans_rule(5) \}, \{ ans_rule(5) \}, \{ ans_rule(5) \})

\{ EndList('OL') \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [3,6,9];
$ENV{'grader_scores'} = [0.33,0.66,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( num_cmp(1) );
ANS( num_cmp(4) );
ANS( num_cmp(7) );
ANS( num_cmp(2) );
ANS( num_cmp(5) );
ANS( num_cmp(8) );
ANS( num_cmp(3) );
ANS( num_cmp(6) );
ANS( num_cmp(9) );

Context()->texStrings;
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();