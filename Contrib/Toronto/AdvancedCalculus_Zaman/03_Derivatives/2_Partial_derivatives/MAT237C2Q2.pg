##DESCRIPTION
##  Partial derivatives problem, MAT237 C2 worksheet Q2
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'partial derivatives')

## DBsubject('Multivariable Calculus')
## DBchapter('Derivatives')
## DBsection('Partial Derivatives')
## Date('19/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('C2')
## Problem1('2')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
);

TEXT(beginproblem());
#  Setup

$width  = 250;
$height = 250;
$lsize = [$width,$height];  # the size of the Live3D images
$ltsize = 220;       # tex size of the Live3D images


@slices = (
image("c2-x-slice.jpg",width=>$width,height=>$height,tex_size=>$ltsize), 
image("c2-y-slice.jpg",width=>$width,height=>$height,tex_size=>$ltsize),
);

#
#  Create a matching list and use popups
#
$ml = new_match_list();
$ml->rf_print_q(~~&pop_up_list_print_q);
$ml->ra_pop_up_list([
"No answer" => "?",
"A" => "A", "B" => "B", "C" => "C", 
"D" => "D", 
]);

#
#  Add correct questions and answers
#
$ml->qa(
"\( \frac{\partial f}{\partial x}(-1, 2) \)", "Zero",
"\( \frac{\partial f}{\partial x}(2, -1) \)", "Cannot Determine",
"\( \frac{\partial f}{\partial y}(-1, 2) \)", "Negative",
"\( \frac{\partial f}{\partial y}(2, -1) \)", "Cannot Determine",
);
$ml->choose(4);

#
#  Add extra incorrect answers
#
$ml->extra(
"Positive", 
);
$ml->choose_extra(1);

Context()->texStrings;
BEGIN_TEXT
Below are slices of the graph of a function \(f: \mathbb{R}^2\to\mathbb{R}\).
$BCENTER
\{
BeginTable().

AlignedRow([ 
 $slices[0], 
 $slices[1]
]).

EndTable();
\}
$ECENTER
If Possible, determine whether each of the following values are positive, negative, or zero.
\{ ColumnMatchTable($ml, valign=>'TOP') \}
END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4];
$ENV{'grader_scores'} = [0.25,0.5,0.75,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( str_cmp( $ml->ra_correct_ans ) );

@correct = @{$ml->ra_correct_ans()};
$answerstring = join(", ", @correct);
Context()->texStrings;
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();