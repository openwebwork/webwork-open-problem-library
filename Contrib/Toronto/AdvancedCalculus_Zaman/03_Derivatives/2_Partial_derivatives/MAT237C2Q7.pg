DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
"parserPopUp.pl",
"unionLists.pl",
);

TEXT(beginproblem());
# 7.1
$popup1 = PopUp(
  ["?","True","False"],
  "False",
);
# 7.2
$popup2 = PopUp(
  ["?","True","False"],
  "True",
);
# 7.3
$popup3 = PopUp(
  ["?","True","False"],
  "False",
);
# 7.4
$popup4 = PopUp(
  ["?","True","False"],
  "True",
);
# 7.5
$popup5 = PopUp(
  ["?","True","False"],
  "True",
);
# 7.6
$popup6 = PopUp(
  ["?","True","False"],
  "False",
);

Context()->texStrings;
BEGIN_TEXT
Let \( f: \mathbb{R}^2\to\mathbb{R} \) and \( F: \mathbb{R}^2\to\mathbb{R}^2 \). FIx \( (a,b)\in\mathbb{R}^2 \). Which statements are true or false?
\{ BeginList('OL', type=>'A') \}

$ITEM The function \( g: \mathbb{R}\to\mathbb{R} \) given by \( g(t)=f(a,t) \) is differentiable at \( t=b \) if and only if \( \partial_1 f(a,b) \) exists. 
\{ $popup1->menu() \}

$ITEMSEP
$ITEM The function \( h: \mathbb{R}\to\mathbb{R} \) given by \( h(t)=f(t,b) \) is differentiable at \( t=a \) if and only if \(\partial_1 f(a,b) \) exists.
\{ $popup2->menu() \}

$ITEMSEP
$ITEM The partial \( \partial_1 f(a,b) \) exists if and only if the partial \( \partial_2 f(a,b) \) exists.
\{ $popup3->menu() \}

$ITEMSEP
$ITEM The function \( G: \mathbb{R}\to\mathbb{R}^2 \) given by \( G(t) = F(a,t) \) is differentiable at \( t=b \) if and only if \( \partial_2 F(a,b) \) exists.
\{ $popup4->menu() \}

$ITEMSEP
$ITEM The function \( H: \mathbb{R}\to\mathbb{R}^2 \) given by \( H(t)=F(t,b) \) is differentiable at \( t=a \) if and only if \( \partial_1 F(a,b) \) exists.
\{ $popup5->menu() \}

$ITEMSEP
$ITEM The partial \( \partial_1 F(a,b) \) exists if and only if the partial \( \partial_2 F(a,b) \) exists.
\{ $popup6->menu() \}

\{ EndList('OL') \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4,5,6];
$ENV{'grader_scores'} = [0.16,0.33,0.5,0.66,0.83,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );
ANS( $popup4->cmp() );
ANS( $popup5->cmp() );
ANS( $popup6->cmp() );

Context()->texStrings;
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();