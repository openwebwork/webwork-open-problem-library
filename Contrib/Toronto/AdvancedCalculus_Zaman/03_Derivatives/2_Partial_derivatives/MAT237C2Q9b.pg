DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
"parserPopUp.pl",
"unionLists.pl",
);

TEXT(beginproblem());

Context()->texStrings;
BEGIN_TEXT
Let \( f(x,y,z) = x^2y+e^{xy} \). Calculate the following:
\{ BeginList('OL', type=>'A') \}

$ITEM \( f_x(1,0,3) \) = \{ ans_rule(20) \}

$ITEMSEP
$ITEM \( f_y(1,0,3) \) = \{ ans_rule(20) \}

$ITEMSEP
$ITEM \( f_z(1,0,3) \) = \{ ans_rule(20) \}

\{ EndList('OL') \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3];
$ENV{'grader_scores'} = [0.33,0.66,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( num_cmp(0) );
ANS( num_cmp(2) );
ANS( num_cmp(0) );

Context()->texStrings;
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();