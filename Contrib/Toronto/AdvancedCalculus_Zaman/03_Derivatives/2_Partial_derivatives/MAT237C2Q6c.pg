##DESCRIPTION
##  Partial derivatives problem, MAT237 C2 worksheet Q6.3
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'partial derivatives')

## DBsubject('Multivariable Calculus')
## DBchapter('Derivatives')
## DBsection('Partial Derivatives')
## Date('19/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('C2')
## Problem1('6.3')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
"parserPopUp.pl",
"unionLists.pl",
);

TEXT(beginproblem());

#  Setup

$width  = 500;
$height = 250;
$lsize = [$width,$height];  # the size of the Live3D images
$ltsize = 220;       # tex size of the Live3D images

# (a)
$popup1 = PopUp(
  ["?","Positive","Zero","Negative"],
  "Zero",
);
# (b)
$popup2 = PopUp(
  ["?","Positive","Zero","Negative"],
  "Positive",
);
# (c)
$popup3 = PopUp(
  ["?","Positive","Zero","Negative"],
  "Zero",
);
# (d)
$popup4 = PopUp(
  ["?","Positive","Zero","Negative"],
  "Negative",
);
# (e)
$popup5 = PopUp(
  ["?","Positive","Zero","Negative"],
  "Negative",
);
# (f)
$popup6 = PopUp(
  ["?","Positive","Zero","Negative"],
  "Negative",
);
# (g)
$popup7 = PopUp(
  ["?","Positive","Zero","Negative"],
  "Negative",
);
# (h)
$popup8 = PopUp(
  ["?","Positive","Zero","Negative"],
  "Negative",
);

Context()->texStrings;
BEGIN_TEXT
A string of length 10 metres is fixed at both ends \( (x=0\mbox{ and }x=10\). When plucked, the string forms a standing wave. The function \(u(x,t)\) (measured in metres) is the displacement of the string at point \(x\) (measured in metres) at time \(t\) (measured in seconds).
$BCENTER
\{image("c2-string.jpg",width=>$width,height=>$height,tex_size=>$ltsize)\}
$ECENTER
Fix a point \(x_0\in(0, L)\) and time \(t_0\in(0,\infty)\). For each quantity, determine whether it is positive, zero, or negative. Choose the most plausible answer.
\{ BeginList('OL', type=>'A') \}

$ITEM \( u_x(5,0) \)
\{ $popup1->menu() \}

$ITEMSEP
$ITEM \( u_x(0,1) \)
\{ $popup2->menu() \}

$ITEMSEP
$ITEM \( u_t(0,1) \)
\{ $popup3->menu() \}

$ITEMSEP
$ITEM \( u_t(5,1) \)
\{ $popup4->menu() \}

$ITEMSEP
$ITEM \( u_x(5,0.5) \)
\{ $popup5->menu() \}

$ITEMSEP
$ITEM \( u_x(2,2.5) \)
\{ $popup6->menu() \}

$ITEMSEP
$ITEM \( u_t(2,2.5) \)
\{ $popup7->menu() \}

$ITEMSEP
$ITEM \( u_t(5,1.5) \)
\{ $popup8->menu() \}

\{ EndList('OL') \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4,5,6,7,8];
$ENV{'grader_scores'} = [0.125,0.25,0.375,0.5,0.625,0.75,0.875,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );
ANS( $popup4->cmp() );
ANS( $popup5->cmp() );
ANS( $popup6->cmp() );
ANS( $popup7->cmp() );
ANS( $popup8->cmp() );

Context()->texStrings;
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();