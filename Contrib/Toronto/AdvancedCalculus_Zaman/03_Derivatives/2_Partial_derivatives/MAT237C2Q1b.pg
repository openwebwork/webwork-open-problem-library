##DESCRIPTION
##  Partial derivatives problem, MAT237 C2 worksheet Q1.2
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'partial derivatives')

## DBsubject('Multivariable Calculus')
## DBchapter('Derivatives')
## DBsection('Partial Derivatives')
## Date('19/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('C2')
## Problem1('1.2')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
);

TEXT(beginproblem());

#
#  Create a matching list and use popups
#
$ml = new_match_list();
$ml->rf_print_q(~~&pop_up_list_print_q);
$ml->ra_pop_up_list([
"No answer" => "?",
"A" => "A", "B" => "B", "C" => "C", 
"D" => "D", "E" => "E",
]);

#
#  Add correct questions and answers
#
$ml->qa(
"\( \lim_{h\to 0}\frac{F(a+he_j)-F(a)}{h} = \partial_j F(a) \)", "Definition",
"\( \partial_j F(a) = (\partial_j F_1(a),\ldots,\partial_j F_m(a)) \)", "Lemma",
);
$ml->choose(2);

Context()->texStrings;
BEGIN_TEXT
Let \(A\subseteq\mathbb{R}^n\). Assume all the partial derivatives of \( F = (F_1,\ldots, F_m): A\to\mathbb{R}^m \) exist at every interior point of \(A\). Fix \( i\in\lbrace1,\ldots,m\rbrace \) and \( j\in\lbrace1,\ldots,n\rbrace \). Let \(a\) be an interior point of \(A\).
$BR
$BR
Let \( \lbrace e_1, \cdots, e_n \rbrace \) be the standard basis of \( \mathbb{R}^n \). Consider the following identities. One equality holds by definition. One equality holds by a lemma. Identify which is which.
\{ ColumnMatchTable($ml, valign=>'TOP') \}
END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2];
$ENV{'grader_scores'} = [0.5,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( str_cmp( $ml->ra_correct_ans ) );

@correct = @{$ml->ra_correct_ans()};
$answerstring = join(", ", @correct);
Context()->texStrings;
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();