DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
"parserPopUp.pl",
"unionLists.pl",
);

TEXT(beginproblem());

Context()->texStrings;
BEGIN_TEXT
Let \( F(x,y) = (x\cos y, x\sin y) \). Calculate the following:
\{ BeginList('OL', type=>'A') \}

$ITEM \( \partial_1 F(2,\pi) \) = (\{ ans_rule(5) \}, \{ ans_rule(5) \})

$ITEMSEP
$ITEM \( \partial_2 F(2,\pi) \) = (\{ ans_rule(5) \}, \{ ans_rule(5) \})

\{ EndList('OL') \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4];
$ENV{'grader_scores'} = [0.25,0.5,0.75,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( num_cmp(-1) );
ANS( num_cmp(0) );
ANS( num_cmp(0) );
ANS( num_cmp(-2) );

Context()->texStrings;
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();