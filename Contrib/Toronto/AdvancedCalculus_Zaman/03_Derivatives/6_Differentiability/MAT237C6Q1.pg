##DESCRIPTION
## Differentiability problem, MAT237 C6 worksheet Q1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'derivateives’, 'differentiability')

## DBsubject('Multivariable Calculus')
## DBchapter('Derivatives')
## DBsection('Differentiability')
## Date('21/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('C6')
## Problem1('1')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
"unionLists.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

Context("Numeric");
# 1.1
$popup1 = PopUp(
  ["?","Equivalent","Not Equivalent"],
  "Equivalent",
);
# 1.2
$popup2 = PopUp(
  ["?","Equivalent","Not Equivalent"],
  "Not Equivalent",
);
# 1.3
$popup3 = PopUp(
  ["?","Equivalent","Not Equivalent"],
  "Not Equivalent",
);
# 1.4
$popup4 = PopUp(
  ["?","Equivalent","Not Equivalent"],
  "Equivalent",
);
# 1.5
$popup5 = PopUp(
  ["?","Equivalent","Not Equivalent"],
  "Not Equivalent",
);

Context()->texStrings;
BEGIN_TEXT
Let \( F: \mathbb{R}^n\to\mathbb{R}^m \) and let \( a\in\mathbb{R}^n \). Which of the following are equivalent to "\(F\) is differentiable at \(a\)"?
$BR
$BR
\{ BeginList('OL', type=>'A') \}

$ITEM There exists a linear map \( L: \mathbb{R}^n\to\mathbb{R}^m \) such that \( \lim_{h\to 0}\frac{F(a+h)-F(a)-L(h)}{||h||} = 0 \)
\{ $popup1->menu() \}

$ITEMSEP
$ITEM There exists a linear map \( L: \mathbb{R}^n\to\mathbb{R}^m \) such that \( \lim_{h\to 0}\frac{F(a+h)-F(a)-L(h)}{h} = 0 \)
\{ $popup2->menu() \}

$ITEMSEP
$ITEM There exists a linear map \( L: \mathbb{R}^n\to\mathbb{R}^m \) such that \( \lim_{h\to 0}\big|\big|\frac{F(a+h)-F(a)-L(h)}{h}\big|\big| = 0 \)
\{ $popup3->menu() \}

$ITEMSEP
$ITEM There exists a linear map \( L: \mathbb{R}^n\to\mathbb{R}^m \) such that \( \lim_{h\to 0}\frac{||F(a+h)-F(a)-L(h)||}{||h||} = 0 \)
\{ $popup4->menu() \}

$ITEMSEP
$ITEM The limit \( \lim_{h\to 0}\frac{F(a+h)-F(a)}{h} \) exists.
\{ $popup5->menu() \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4,5];
$ENV{'grader_scores'} = [0.2,0.4,0.6,0.8,1];
$ENV{'grader_message'} = "You can earn partial credits.";

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );
ANS( $popup4->cmp() );
ANS( $popup5->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup1->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();