##DESCRIPTION
## Differentiability problem, MAT237 C6 worksheet Q2
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'derivateives’, 'differentiability')

## DBsubject('Multivariable Calculus')
## DBchapter('Derivatives')
## DBsection('Differentiability')
## Date('21/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('C6')
## Problem1('2')

########################################################################

DOCUMENT();

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
"unionLists.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

Context("Numeric");
# 2.1
$popup1 = PopUp(
  ["?","True","False"],
  "True",
);
# 2.2
$popup2 = PopUp(
  ["?","True","False"],
  "False",
);
# 2.3
$popup3 = PopUp(
  ["?","True","False"],
  "False",
);
# 2.4
$popup4 = PopUp(
  ["?","True","False"],
  "True",
);
# 2.5
$popup5 = PopUp(
  ["?","True","False"],
  "True",
);
# 2.6
$popup6 = PopUp(
  ["?","True","False"],
  "False",
);

Context()->texStrings;
BEGIN_TEXT
Let \( F: \mathbb{R}^n\to\mathbb{R}^m \) and fix \( a\in\mathbb{R}^n \). Which of these statements are true or false?
$BR
$BR
\{ BeginList('OL', type=>'A') \}

$ITEM If \(F\) is differentiable at \(a\), then all directional derivatives of \(F\) at \(a\) exist.
\{ $popup1->menu() \}

$ITEMSEP
$ITEM If all directional derivatives of \(F\) at \(a\) exist, then \(F\) is differentiable at \(a\).
\{ $popup2->menu() \}

$ITEMSEP
$ITEM \(F\) is differentiable at \(a\) if and only if all the partial derivatives of \(F\) exist.
\{ $popup3->menu() \}

$ITEMSEP
$ITEM If \(F\) is differentiable at \(a\), then the Jacobian of \(F\) at \(a\) is a matrix of partial derivatives.
\{ $popup4->menu() \}

$ITEMSEP
$ITEM If \(F\) is continuously differentiable at \(a\), then \(F\) is differentiable at \(a\).
\{ $popup5->menu() \}

$ITEMSEP
$ITEM If \(F\) is differentiable at \(a\), then \(F\) is continuously differentiable at \(a\).
\{ $popup6->menu() \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4,5,6];
$ENV{'grader_scores'} = [0.16,0.33,0.51,0.67,0.83,1];
$ENV{'grader_message'} = "You can earn partial credits.";

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );
ANS( $popup4->cmp() );
ANS( $popup5->cmp() );
ANS( $popup6->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup1->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();