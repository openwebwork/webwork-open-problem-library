##DESCRIPTION
##  Directional derivatives problem, MAT237 C3 worksheet 1.1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'directional derivatives')

## DBsubject('Multivariable Calculus')
## DBchapter('Derivatives')
## DBsection('Directional Derivatives')
## Date('20/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('C3')
## Problem1('1.1')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
"parserPopUp.pl",
"unionLists.pl",
);

TEXT(beginproblem());
# (a)
$popup1 = PopUp(
  ["?",, "Real valued function", "Vector valued function", "Scalar", "m x 1 column vector"],
  "m x 1 column vector",
);
# (b)
$popup2 = PopUp(
  ["?",, "Real valued function", "Vector valued function", "Scalar", "m x 1 column vector"],
  "Vector valued function",
);
# (c)
$popup3 = PopUp(
  ["?",, "Real valued function", "Vector valued function", "Scalar", "m x 1  column vector"],
  "Scalar",
);
# (d)
$popup4 = PopUp(
  ["?",, "Real valued function", "Vector valued function", "Scalar", " m x 1  column vector"],
  "Real valued function",
);

Context()->texStrings;
BEGIN_TEXT
Let \( A\subseteq\mathbb{R}^n \). Assume \( F=(F_1,\ldots, F_m): A\to\mathbb{R}^m \) is differentiable at every interior point of \(A\). Fix \(v\in\mathbb{R}^n\). Let \(a\) be an interior point of \(A\). Fix \( i\in\lbrace 1,\ldots, n\rbrace \)
$BR
$BR
For each quantity, identify the type of mathematical object that it is.
\{ BeginList('OL', type=>'A') \}

$ITEM \( D_v F(a) \)
\{ $popup1->menu() \}

$ITEMSEP
$ITEM \( D_v F \)
\{ $popup2->menu() \}

$ITEMSEP
$ITEM \( D_v F_i(a) \)
\{ $popup3->menu() \}

$ITEMSEP
$ITEM \( D_v F_i \)
\{ $popup4->menu() \}

\{ EndList('OL') \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4];
$ENV{'grader_scores'} = [0.25,0.5,0.75,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );
ANS( $popup4->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup1->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();