##DESCRIPTION
##  Directional derivatives problem, MAT237 C3 worksheet 1.2
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'directional derivatives')

## DBsubject('Multivariable Calculus')
## DBchapter('Derivatives')
## DBsection('Directional Derivatives')
## Date('20/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('C3')
## Problem1('1.2')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
"parserPopUp.pl",
"unionLists.pl",
);

TEXT(beginproblem());
# (a)
$popup1 = PopUp(
  ["?", "Definition", "Lemma", "Theorem"],
  "Definition",
);
# (b)
$popup2 = PopUp(
  ["?", "Definition", "Lemma", "Theorem"],
  "Theorem",
);
# (c)
$popup3 = PopUp(
  ["?", "Definition", "Lemma", "Theorem"],
  "Lemma",
);

Context()->texStrings;
BEGIN_TEXT
Let \( A\subseteq\mathbb{R}^n \). Assume \( F=(F_1,\ldots, F_m): A\to\mathbb{R}^m \) is differentiable at every interior point of \(A\). Fix \(v\in\mathbb{R}^n\). Let \(a\) be an interior point of \(A\). Fix \( i\in\lbrace 1,\ldots, n\rbrace \)
$BR
$BR
Write \( v=(v_1,\ldots,v_n) \in\mathbb{R}^n \). One equality holds by definition. One equality holds by a lemma. One equality holds by a theorem. Identify which is which.
\{ BeginList('OL', type=>'A') \}

$ITEM \( lim_{t\to 0}\frac{F(a+tv)-F(a)}{t} = D_v F(a) \) 
\{ $popup1->menu() \}

$ITEMSEP
$ITEM \( D_v F(a) = \sum_{j=1}^n v_j\partial_j F(a) \)
\{ $popup2->menu() \}

$ITEMSEP
$ITEM \( \sum_{j=1}^n v_j\partial_j F(a)=v_1(\partial_1 F_1(a),\cdots,\partial_1 F_m(a)) + \cdots + v_n(\partial_n F_1(a),\cdots,\partial_n F_m(a))\)
\{ $popup3->menu() \}

\{ EndList('OL') \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3];
$ENV{'grader_scores'} = [0.33,0.67,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup1->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();