##DESCRIPTION
##  Directional derivatives problem, MAT237 C3 worksheet Q2
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'directional derivatives')

## DBsubject('Multivariable Calculus')
## DBchapter('Derivatives')
## DBsection('Directional Derivatives')
## Date('20/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('C3')
## Problem1('2')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
"parserPopUp.pl",
"unionLists.pl",
);

TEXT(beginproblem());
$width  = 250;
$height = 250;
$lsize = [$width,$height];  # the size of the Live3D images
$ltsize = 220;

# 2.1
$popup1 = PopUp(
  ["?", "Positive", "Negative", "Zero", "Cannot Determine"],
  "Positive",
);
# 2.2
$popup2 = PopUp(
  ["?", "Positive", "Negative", "Zero", "Cannot Determine"],
  "Cannot Determine",
);
# 2.3
$popup3 = PopUp(
  ["?", "Positive", "Negative", "Zero", "Cannot Determine"],
  "Cannot Determine",
);
# 2.4
$popup4 = PopUp(
  ["?", "Positive", "Negative", "Zero", "Cannot Determine"],
  "Negative",
);

Context()->texStrings;
BEGIN_TEXT
Let \( f:\mathbb{R}^2\to\mathbb{R} \) and assume it is "differentiable" everywhere. Fix \( a=(-2,-1) \) and let \( y=(3,4) \). Below is a graph of the function \( g: \mathbb{R}\to\mathbb{R} \) defined by \( g(h)=f(a+hv) \).
$BCENTER
\{image("c3-slice.jpg",width=>$width,height=>$height,tex_size=>$ltsize)\}
$ECENTER
If possible, determine whether each of the following values are positive, negative, or zero.
\{ BeginList('OL', type=>'A') \}

$ITEM \( f(-2,-1) \) 
\{ $popup1->menu() \}

$ITEMSEP
$ITEM \( \frac{\partial f}{\partial x}(-2,-1) \)
\{ $popup2->menu() \}

$ITEMSEP
$ITEM \( \frac{\partial f}{\partial y}(-2,-1) \)
\{ $popup3->menu() \}

$ITEMSEP
$ITEM \( D_v f(-2,-1) \)
\{ $popup4->menu() \}

\{ EndList('OL') \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4];
$ENV{'grader_scores'} = [0.25,0.5,0.75,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );
ANS( $popup4->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup1->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();