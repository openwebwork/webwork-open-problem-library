##DESCRIPTION
##  Directional derivatives problem, MAT237 C3 worksheet Q4
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'directional derivatives')

## DBsubject('Multivariable Calculus')
## DBchapter('Derivatives')
## DBsection('Directional Derivatives')
## Date('19/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('C3')
## Problem1('4')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
"unionLists.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

#  Setup

$width  = 350;
$height = 250;
$lsize = [$width,$height];  # the size of the Live3D images
$ltsize = 220;       # tex size of the Live3D images

Context("Numeric");

$popup = PopUp(
  ["?","Positive","Zero","Negative"],
  "Negative",
);

Context()->texStrings;
BEGIN_TEXT
The contour map below represents the temperature \( T=T(x,y) \) measured in degrees Celsius, within a 40 m by 30 m space. The temperature value along each contour is labelled along the right side.
$BCENTER
\{image("c3-contour.jpg",width=>$width,height=>$height,tex_size=>$ltsize)\}
$ECENTER
\{ BeginList('OL', type=>'A') \}

$ITEM Without doing any calculations, is \(D_{(-1,-1)}T(10,10)\) positive, zero, or negative?
\{ $popup->menu() \}

$ITEMSEP
$ITEM Approximate \(D_{(-1,-1)}T(10,10)\).
\{ ans_rule(20) \}

$ITEMSEP
$ITEM Approximate \(D_{(-1,-1)}T(10,10.1)\).
\{ ans_rule(20) \}

\{ EndList('OL') \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3];
$ENV{'grader_scores'} = [0.33,0.67,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( $popup->cmp() );
ANS( num_cmp(-0.25) );
ANS( num_cmp(19.875) );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();