##DESCRIPTION
##  Directional derivatives problem, MAT237 C3 worksheet Q5
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'directional derivatives')

## DBsubject('Multivariable Calculus')
## DBchapter('Derivatives')
## DBsection('Directional Derivatives')
## Date('19/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('C3')
## Problem1('5')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
"unionLists.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

#  Setup

$width  = 350;
$height = 250;
$lsize = [$width,$height];  # the size of the Live3D images
$ltsize = 220;       # tex size of the Live3D images

Context("Numeric");

$e = -5/Real("e");

$popup = PopUp(
  ["?","Positive","Zero","Negative"],
  "Negative",
);

Context()->texStrings;
BEGIN_TEXT
Let \( f)x,y)=(x^2-y^2, e^{xy}+xy) \). 
\{ BeginList('OL', type=>'A') \}

$ITEM Let \(v=(2,-3)\). Express \(D_v f\) in terms of the partial derivatives of \(f\).
$BR
\(D_vf=\)\{ ans_rule(5) \}\(\frac{\partial f}{\partial x}+\)\{ ans_rule(5) \}\(\frac{\partial f}{\partial y}\)

$ITEMSEP
$ITEM Compute \(D_vf(1,-1)\)
(\{ ans_rule(5) \}, \{ ans_rule(5) \}, \{ ans_rule(5) \})

\{ EndList('OL') \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4,5];
$ENV{'grader_scores'} = [0.2,0.4,0.6,0.8,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( num_cmp(2) );
ANS( num_cmp(-3) );
ANS( num_cmp(-2) );
ANS( $e->with(tolerance=>.0001)->cmp );
ANS( num_cmp(-5) );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();