##DESCRIPTION
##  Directional derivatives problem, MAT237 C3 worksheet 10.1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'directional derivatives')

## DBsubject('Multivariable Calculus')
## DBchapter('Derivatives')
## DBsection('Directional Derivatives')
## Date('19/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('C3')
## Problem1('10.1')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
"unionLists.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

Context("Numeric");

$width  = 350;
$height = 300;
$lsize = [$width,$height];  # the size of the Live3D images
$ltsize = 220;       # tex size of the Live3D images

$popup1 = PopUp(
  ["?","Positive","Zero","Negative","Cannot Determine"],
  "Zero",
);
$popup2 = PopUp(
  ["?","Positive","Zero","Negative","Cannot Determine"],
  "Positive",
);

Context()->texStrings;
BEGIN_TEXT
Consider the contour plot of the function \( f:\mathbb{R}^2\to\mathbb{R} \) below.
$BCENTER
\{image("c3-vw.jpg",width=>$width,height=>$height,tex_size=>$ltsize)\}
$ECENTER
At a given point \(a\), determine whether \(D_vf(a)\) and \(D_wf(a)\) are positive, zero, or negative.
\{ BeginList('OL', type=>'A') \}

$ITEM \(D_vf(a)\)
\{ $popup1-> menu \}

$ITEMSEP
$ITEM \(D_wf(a)\)
\{ $popup2-> menu \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2];
$ENV{'grader_scores'} = [0.5,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup1->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();