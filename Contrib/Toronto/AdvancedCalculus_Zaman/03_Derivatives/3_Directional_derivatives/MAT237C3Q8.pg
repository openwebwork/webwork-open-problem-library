##DESCRIPTION
##  Directional derivatives problem, MAT237 C3 worksheet Q8
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'directional derivatives')

## DBsubject('Multivariable Calculus')
## DBchapter('Derivatives')
## DBsection('Directional Derivatives')
## Date('19/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('C3')
## Problem1('8')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
"unionLists.pl",
"PGgraders.pl",
);

TEXT(beginproblem());

#  Setup
# 8.1
$popup1 = PopUp(
  ["?","True","False"],
  "True",
);
# 8.2
$popup2 = PopUp(
  ["?","True","False"],
  "True",
);
# 8.3
$popup3 = PopUp(
  ["?","True","False"],
  "False",
);
Context()->texStrings;
BEGIN_TEXT
Let \( F: \mathbb{R}^n\to\mathbb{R}^m \). Fix \( a,w\in\mathbb{R}^n\). Which statements are true or false?
\{ BeginList('OL', type=>'A') \}

$ITEM The function \( \gamma: \mathbb{R}\to\mathbb{R}^m \) given by \(\gamma(t)=F(a+tw)\) is differentiable at \(t=0\) if and only if \(D_wF(a)\) exists.
\{ $popup1->menu() \}

$ITEMSEP
$ITEM If \( D_v F(a) \) exists for every \( v\in\mathbb{R}^n \) then \( \partial_1 F(a),\ldots,\partial_n F(a) \) all exist.
\{ $popup2->menu() \}

$ITEMSEP
$ITEM If \( \partial_1 F(a),\ldots,\partial_n F(a) \) all exist, then \( D_vF(a) \) exists for every \( v\in\mathbb{R}^n \).
\{ $popup3->menu() \}

\{ EndList('OL') \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3];
$ENV{'grader_scores'} = [0.33,0.66,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $popup1->correct_ans() \}
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();