##DESCRIPTION
##  Directional derivatives problem, MAT237 C3 worksheet 10.2
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'directional derivatives')

## DBsubject('Multivariable Calculus')
## DBchapter('Derivatives')
## DBsection('Directional Derivatives')
## Date('19/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('C3')
## Problem1('10.2')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserPopUp.pl",
"unionLists.pl",
"PGgraders.pl",
"parserVectorUtils.pl",
);

TEXT(beginproblem());

Context("Numeric");
# (Real(ln(2))-8)/sqrt(5);
$avg = (Real(ln(2))-8)/sqrt(5);

Context()->texStrings;
BEGIN_TEXT
Let \( f(x,y)=x^2+\ln y \). Assume \(f\) is differentiable at \((3,1)\)
\{ BeginList('OL', type=>'A') \}

$ITEM Find the average rate of change of \(f\) when you go from \((3,1)\) to \((1,2)\). 
\{ ans_rule(20) \}

$ITEMSEP
$ITEM Find the instantaneous rate of change of \(f\) as you leave the point \((3,1)\) heading toward \((1,2)\).
\{ ans_rule(20) \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2];
$ENV{'grader_scores'} = [0.5,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( $avg->with(tolerance=>.0001)->cmp );
ANS( num_cmp(-11/sqrt(5)) );

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
END_SOLUTION
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();