## Problem1('1.1')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
"parserPopUp.pl",
"unionLists.pl",
);

TEXT(beginproblem());
# (a)
$popup1 = PopUp(
  ["?",, "Definition", "Theorem"],
  "Theorem",
);
# (b)
$popup2 = PopUp(
  ["?",, "Definition", "Theorem"],
  "Definition",
);

Context()->texStrings;
BEGIN_TEXT
Let \( A\subseteq\mathbb{R}^n \). Assume all partial derivatives of \(f: A\to\mathbb{R}\) exist at every interior point of \(A\). Let \(a\) be an interior point of \(A\). Fix \( v\in\mathbb{R}^n \)
$BR
$BR
Assume \( f: A\to\mathbb{R} \) is differentiable at \(a\). Consider the following equalities. One equality holds by definition. One equality holds by a theorem. Identify which is which.
\{ BeginList('OL', type=>'A') \}

$ITEM \( D_v f(a)=\nabla f(a)\cdot v \)
\{ $popup1->menu() \}

$ITEMSEP
$ITEM \( \nabla f(a)\cdot v = \sum_{j=1}^n\partial_j f(a) v_i \)
\{ $popup2->menu() \}

\{ EndList('OL') \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2];
$ENV{'grader_scores'} = [0.5,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );

Context()->texStrings;
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();