##DESCRIPTION
##  Gradient problem, MAT237 C4 worksheet 1.1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'gradient')

## DBsubject('Multivariable Calculus')
## DBchapter('Derivatives')
## DBsection('Gradient')
## Date('20/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('C4')
## Problem1('1.1')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
"parserPopUp.pl",
"unionLists.pl",
);

TEXT(beginproblem());
# (a)
$popup1 = PopUp(
  ["?",, "Scalar", "Vector valued function", "n x 1 column vector"],
  "n x 1 column vector",
);
# (b)
$popup2 = PopUp(
  ["?",, "Scalar", "Vector valued function", "n x 1 column vector"],
  "Vector valued function",
);
# (c)
$popup3 = PopUp(
  ["?",, "Scalar", "Vector valued function", "n x 1 column vector"],
  "Scalar",
);
# (d)
$popup4 = PopUp(
  ["?",, "Scalar", "Vector valued function", "n x 1 column vector"],
  "Scalar",
);

Context()->texStrings;
BEGIN_TEXT
Let \( A\subseteq\mathbb{R}^n \). Assume all partial derivatives of \(f: A\to\mathbb{R}\) exist at every interior point of \(A\). Let \(a\) be an interior point of \(A\). Fix \( v\in\mathbb{R}^n \)
$BR
$BR
For each quantity, identify the type of mathematical object that it is.
\{ BeginList('OL', type=>'A') \}

$ITEM \( \nabla f(a) \)
\{ $popup1->menu() \}

$ITEMSEP
$ITEM \( \nabla f \)
\{ $popup2->menu() \}

$ITEMSEP
$ITEM \( \nabla f(a)\cdot v \)
\{ $popup3->menu() \}

$ITEMSEP
$ITEM \( (\nabla f(a))^T \)
\{ $popup4->menu() \}

\{ EndList('OL') \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4];
$ENV{'grader_scores'} = [0.25,0.5,0.75,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( $popup1->cmp() );
ANS( $popup2->cmp() );
ANS( $popup3->cmp() );
ANS( $popup4->cmp() );

Context()->texStrings;
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();