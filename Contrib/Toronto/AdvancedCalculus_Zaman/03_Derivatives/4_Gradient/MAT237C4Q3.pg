########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
"parserPopUp.pl",
"unionLists.pl",
);

TEXT(beginproblem());

Context('Matrix');
# 3.3
$matrix3 = Matrix([[-1/6,0,1/18],[0,-1/6,1/12]]);
# 3.5
$matrix5 = Matrix([2/9],[1/12]);
# 3.6
$matrix6 = Matrix([2/9],[1/12]);
# 3.7
$matrix7 = Matrix([-2/3],[-3/4]);

Context()->texStrings;
BEGIN_TEXT
Let \( U=\lbrace(x,y,z)\in\mathbb{R}^3: z\neq 1\rbrace \). Define \( F: U\to\mathbb{R}^2 \) by \( F(x,y,z)=\left(\frac{x}{1-z},\frac{y}{1-z}\right) \). Assume \(F\) is differentiable everywhere.
$BR
$BR
\{ BeginList('OL', type=>'A') \}

$ITEM Write the Jacobian of \(F\) at \( (2,3,7) \).
\{ $matrix3->ans_array \}

$ITEMSEP
$ITEM Compute \( D_{(-1,0,1)}F(2,3,7) \)
\{ $matrix5->ans_array(5) \}

$ITEMSEP
$ITEM Compute \( dF_{(2,3,7)}((-1,0,1)) \)
\{ $matrix6->ans_array(5) \}

$ITEMSEP
$ITEM Use the differential of \(F\) at \((2,3,7\)) to linearly approximate the value of \( F(3,3,4) \).
\(F(3,3,4)\approx\)\{ $matrix7->ans_array(5) \}

\{ EndList('OL') \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4];
$ENV{'grader_scores'} = [0.25,0.5,0.75,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( $matrix3->cmp() );
ANS( $matrix5->cmp() );
ANS( $matrix6->cmp() );
ANS( $matrix7->cmp() );

Context()->texStrings;
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();