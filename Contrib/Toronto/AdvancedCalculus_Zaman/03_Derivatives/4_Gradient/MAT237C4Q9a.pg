## Section1('C5')
## Problem1('9.1')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
"parserPopUp.pl",
"unionLists.pl",
);

TEXT(beginproblem());

Context("Matrix");

$dif = Matrix([2, 1], [2, 4], [2, 4]);
$vec = Matrix([2], [4.4], [4]);

Context()->texStrings;
BEGIN_TEXT
Determine which statements are true and whicha re false.
$BR
Define \( g(x,y) = (xy, x^2+y^2, x^2-y^2) \). Assume \(g\) is differentiable at \((1,2)\).
$BR
$BR
\{ BeginList('OL', type=>'A') \}
$ITEM Give an explicit formula for the differential of \(g\) at \((1,2)\).
\{ $dif->ans_array(5) \}
$ITEMSEP
$ITEM Linearly approximate \( g(1.1,1.8) \) using \(dg_{(1,2)}\).
\{ $vec->ans_array(5) \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2];
$ENV{'grader_scores'} = [0.5,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( $dif->cmp() );
ANS( $vec->cmp() );

Context()->texStrings;
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();