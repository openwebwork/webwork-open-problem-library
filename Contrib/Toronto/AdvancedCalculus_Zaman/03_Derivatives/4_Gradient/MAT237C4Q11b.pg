DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
"parserPopUp.pl",
"unionLists.pl",
);

TEXT(beginproblem());

Context()->texStrings;
BEGIN_TEXT
Let \( f(x,y) = xe^{xy}+y \). Compute the conjectured linear approximation \( L: \mathbb{R}^2\to\mathbb{R} \) of \(f\) at \((0,0)\). Estimate \(f(0.1,0.2)\) with \(L\).
$BR
$BR
\( f(0.1,0.2) =\) \{ ans_rule(5) \}

END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  All or nothing grader
#  
install_problem_grader(~~&std_problem_grader);

ANS( num_cmp(0.3) );


Context()->texStrings;
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();