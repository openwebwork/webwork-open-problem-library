##DESCRIPTION
## Derivatives problem, MAT237 C1 worksheet Q4
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'derivatives', 'velocity’)

## DBsubject('Multivariable Calculus')
## DBchapter('Derivatives')
## DBsection('Derivatives of one variable')
## Date('11/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('C1')
## Problem1('4')

########################################################################

DOCUMENT(); 

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"parserVectorUtils.pl",
"unionLists.pl",
);

TEXT(beginproblem());

Context("Numeric");

$tpi = 2*Real("pi");
$unit_1 = 1/sqrt(2+4*Real("pi")**2);
$unit_2pi = 2*Real("pi")/sqrt(2+4*Real("pi")**2);

Context()->texStrings;
BEGIN_TEXT
Let \( g: \mathbb{R}\to\mathbb{R}^3 \) be given by \( g(t)=(t\cos t, t\sin t, t) \).
\{ BeginList('OL', type=>'A') \}

$ITEM Compute the derivative of \(g\) at \(2\pi\).
(\{ ans_rule(5) \}, \{ ans_rule(5) \}, \{ ans_rule(5) \})

$ITEMSEP
$ITEM Compute the velocity of \(g\) at \(2\pi\).
(\{ ans_rule(5) \}, \{ ans_rule(5) \}, \{ ans_rule(5) \})

$ITEMSEP
$ITEM Compute the unit tangent vector of \(g\) at \(2\pi\).
(\{ ans_rule(5) \}, \{ ans_rule(5) \}, \{ ans_rule(5) \})

\{ EndList('OL') \}
END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

ANS( num_cmp(1) );
ANS( $tpi->with(tolerance=>.0001)->cmp );
ANS( num_cmp(1) );
ANS( num_cmp(1) );
ANS( $tpi->with(tolerance=>.0001)->cmp );
ANS( num_cmp(1) );
ANS( $unit_1->with(tolerance=>.0001)->cmp );
ANS( $unit_2pi->with(tolerance=>.0001)->cmp );
ANS( $unit_1->with(tolerance=>.0001)->cmp );

Context()->texStrings;
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();