##DESCRIPTION
##  Derivatives problem, MAT237 C1 worksheet 1.2
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'derivatives')

## DBsubject('Multivariable Calculus')
## DBchapter('Derivatives')
## DBsection('Derivatives of one variable')
## Date('10/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('C1')
## Problem1('1.2')

########################################################################

DOCUMENT();  

loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGchoicemacros.pl",
"PGgraders.pl",
"unionTables.pl",
);

TEXT(beginproblem());

#
#  Create a matching list and use popups
#
$ml = new_match_list();
$ml->rf_print_q(~~&pop_up_list_print_q);
$ml->ra_pop_up_list([
"No answer" => "?",
"Definition" => "Definition", "Consequence of a theorem" => "Consequence of a theorem", 
]);

#
#  Add correct questions and answers
#
$ml->qa(
"\( df_a(h) = f'(a) h \)", "Definition",
"\( f'(a) h = (f_1'(a) \cdots f_m'(a)) h \)", "Consequence of a theorem",
);
$ml->choose(2);

Context()->texStrings;
BEGIN_TEXT
Let \( f: \mathbb{R}\to\mathbb{R}^m \) be differentiable at \(a\in\mathbb{R}\). You have the following relationships. One equality is a definition while the other is the consequence of a theorem. Identify which is which.
\{ ColumnMatchTable($ml, valign=>'TOP') \}
END_TEXT
Context()->normalStrings;

$showPartialCorrectAnswers = 0;

#
#  Incremental grader
#
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2];
$ENV{'grader_scores'} = [0.5,1];
$ENV{'grader_message'} = "You can earn partial credits.";

#
#  All or nothing grader
#  
# install_problem_grader(~~&std_problem_grader);

ANS( str_cmp( $ml->ra_correct_ans ) );

@correct = @{$ml->ra_correct_ans()};
$answerstring = join(", ", @correct);
Context()->texStrings;
Context()->normalStrings;

COMMENT('MathObject version.');

ENDDOCUMENT();