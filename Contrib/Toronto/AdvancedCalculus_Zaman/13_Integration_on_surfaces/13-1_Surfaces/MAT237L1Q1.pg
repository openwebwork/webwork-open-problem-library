##DESCRIPTION
## MAT237 L1 Q1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','parametrized surfaces')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Parametrized surfaces')
## Institution('University of Toronto')
## Section1('L1')
## Problem1('1')



###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup


## Question L1 Q1
$mc1 = new_checkbox_multiple_choice();
$mc1 -> qa (
"Select the true statment(s)", 
"\( G \) is regular", 
"\( G \) is simple", 
);
$mc1 -> makeLast("\( G \) is regular", "\( G \) is simple", "None of the above");
###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
The unit sphere \( S \) in \( \mathbb{R}^3 \) is parametrized by  map \( G : [0,2\pi] \times [0,\pi] \to \mathbb{R}^3 \), where
\[
G(u,v) = \begin{bmatrix} \cos u \sin v \\ \sin u \sin v \\ \cos v \end{bmatrix}, \qquad \partial_1 G(u,v) = \begin{bmatrix} -\sin u \sin v \\ \cos u \sin v \\ 0 \end{bmatrix} \qquad \partial_2 G(u,v) = \begin{bmatrix} \cos u \cos v \\ \sin u \cos v \\ -\sin v \end{bmatrix}.
\]

$BR
$BR
\{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}
END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );



############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answers are \{ $mc1->correct_ans() \} $BR

END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT(); 