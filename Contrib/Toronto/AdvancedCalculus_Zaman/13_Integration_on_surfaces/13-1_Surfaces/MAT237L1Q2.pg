###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup


## Question L1 Q2.1 
$mc1 = new_checkbox_multiple_choice();

$mc1 -> qa (
"Which of these maps are parametrizations of  
\( S \)?", 
"\( G_B(s,t) = (s,t,st)\) for \(s^2+t^2 \leq 1  \)",
"\( G_E(s,t) = (s \cos t, s \sin t, s^2 \cos t\sin t)\) for \(0 \leq s \leq 1, 0 \leq t \leq 4\pi \)"
);

$mc1->makeLast("\( G_A(s,t) = (s,t, st)\) for \(-1 \leq s \leq 1, -1 \leq t \leq 1 \)","\( G_B(s,t) = (s,t,st)\) for \(s^2+t^2 \leq 1  \)","\( G_C(s,t) = (st,st, (st)^2)\) for \(s^2 + t^2 \leq 1 \)","\( G_D(s,t) = (s^3,t^3,(st)^3)\) for \(-1 \leq s \leq 1, -1 \leq t \leq 1 \)","\( G_E(s,t) = (s \cos t, s \sin t, s^2 \cos t\sin t)\) for \(0 \leq s \leq 1, 0 \leq t \leq 4\pi \)");

## Question L1 Q2.2
$mc2 = new_checkbox_multiple_choice();

$mc2 -> qa (
"Which of these maps are regular?", 
"\( G_A(s,t) = (s,t, st)\) for \(-1 \leq s \leq 1, -1 \leq t \leq 1 \)","\( G_B(s,t) = (s,t,st)\) for \(s^2+t^2 \leq 1  \)","\( G_D(s,t) = (s^3,t^3,(st)^3)\) for \(-1 \leq s \leq 1, -1 \leq t \leq 1 \)","\( G_E(s,t) = (s \cos t, s \sin t, s^2 \cos t\sin t)\) for \(0 \leq s \leq 1, 0 \leq t \leq 4\pi \)"
);

$mc2->makeLast("\( G_A(s,t) = (s,t, st)\) for \(-1 \leq s \leq 1, -1 \leq t \leq 1 \)","\( G_B(s,t) = (s,t,st)\) for \(s^2+t^2 \leq 1  \)","\( G_C(s,t) = (st,st, (st)^2)\) for \(s^2 + t^2 \leq 1 \)","\( G_D(s,t) = (s^3,t^3,(st)^3)\) for \(-1 \leq s \leq 1, -1 \leq t \leq 1 \)","\( G_E(s,t) = (s \cos t, s \sin t, s^2 \cos t\sin t)\) for \(0 \leq s \leq 1, 0 \leq t \leq 4\pi \)");

## Question L1 Q2.3
$mc3 = new_checkbox_multiple_choice();

$mc3 -> qa (
"Which of these maps are simple?", 
"\( G_A(s,t) = (s,t, st)\) for \(-1 \leq s \leq 1, -1 \leq t \leq 1 \)","\( G_B(s,t) = (s,t,st)\) for \(s^2+t^2 \leq 1  \)","\( G_D(s,t) = (s^3,t^3,(st)^3)\) for \(-1 \leq s \leq 1, -1 \leq t \leq 1 \)"
);

$mc3->makeLast("\( G_A(s,t) = (s,t, st)\) for \(-1 \leq s \leq 1, -1 \leq t \leq 1 \)","\( G_B(s,t) = (s,t,st)\) for \(s^2+t^2 \leq 1  \)","\( G_C(s,t) = (st,st, (st)^2)\) for \(s^2 + t^2 \leq 1 \)","\( G_D(s,t) = (s^3,t^3,(st)^3)\) for \(-1 \leq s \leq 1, -1 \leq t \leq 1 \)","\( G_E(s,t) = (s \cos t, s \sin t, s^2 \cos t\sin t)\) for \(0 \leq s \leq 1, 0 \leq t \leq 4\pi \)");

## Question J1 11.1 d)
$mc4 = new_checkbox_multiple_choice();


###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
Let \( S= \lbrace  (x,y,z) \in \mathbb{R}^3 : x^2+y^2 \leq 1, z=xy \rbrace \). Define the following five maps. $BR

\(\bullet G_A(s,t) = (s,t, st)\) for \(-1 \leq s \leq 1, -1 \leq t \leq 1 \) $BR

\(\bullet G_B(s,t) = (s,t,st)\) for \(s^2+t^2 \leq 1 \) $BR

\(\bullet G_C(s,t) = (st,st, (st)^2)\) for \(s^2 + t^2 \leq 1  \) $BR

\(\bullet G_D(s,t) = (s^3,t^3,(st)^3)\) for \(-1 \leq s \leq 1, -1 \leq t \leq 1 \) $BR

\(\bullet G_E(s,t) = (s \cos t, s \sin t, s^2 \cos t\sin t)\) for \(0 \leq s \leq 1, 0 \leq t \leq 4\pi \) 

$BR
$BR
\{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}
$BR
\{ $mc2 -> print_q() \}
\{ $mc2 -> print_a() \}
$BR
\{ $mc3 -> print_q() \}
\{ $mc3 -> print_a() \}
END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );
ANS( checkbox_cmp( $mc3->correct_ans() ) );


############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answers are \{ $mc1->correct_ans() \} $BR
The correct answers are \{ $mc2->correct_ans() \} $BR
The correct answers are \{ $mc3->correct_ans() \} $BR
END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT();  