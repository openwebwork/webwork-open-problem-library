##DESCRIPTION
## MAT237 L1 Q8
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','parametrized surfaces')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Parametrized surfaces')
## Institution('University of Toronto')
## Section1('L1')
## Problem1('8')


###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup


## Question L1 Q8.1 
$mc1 = new_checkbox_multiple_choice();

$mc1 -> qa (
"\( H_1(u, v) = (2u, 3v, 4u^2 + 27v^3) \) for \( 0 \leq u \leq 1, 0 \leq v \leq 1. \)", 
"Same orientation"
);

$mc1->makeLast("Same orientation","Opposite orientation","Not a reparametrization of \( G \)");

## Question L1 Q8.2
$mc2 = new_checkbox_multiple_choice();

$mc2 -> qa (
"\( H_2(u, v) = (v, u, v^2 + u^3) \) for \( 0 \leq u \leq 3, 0 \leq v \leq 2. \)", 
"Opposite orientation"
);

$mc2->makeLast("Same orientation","Opposite orientation","Not a reparametrization of \( G \)");

## Question L1 Q8.3
$mc3 = new_checkbox_multiple_choice();

$mc3 -> qa (" \( H_3(u, v) = (u, v, u^2 + v^3) \) for \( −2 ≤ u ≤ 0, −3 \leq v \leq 0. \)",
"Not a reparametrization of \( G \)"
);

$mc3->makeLast("Same orientation","Opposite orientation","Not a reparametrization of \( G \)");

## Question L1 Q8.4
$mc4 = new_checkbox_multiple_choice();

$mc4 -> qa (" \( H_4(u, v) = (2 − u, v, (2 − u)^2 + v^3) \) for \( 0 \leq u \leq 2, 0 \leq v \leq 3. \)",
"Opposite orientation"
);

$mc4->makeLast("Same orientation","Opposite orientation","Not a reparametrization of \( G \)");

## Question L1 Q8.5
$mc5 = new_checkbox_multiple_choice();

$mc5 -> qa (" \( H_5(u, v) = (2 − u, 3 − v, (2 − u)^2 + (3 − v)^3) \) for \( 0 \leq u \leq 2, 0 \leq v \leq 3. \)",
"Same orientation"
);

$mc5->makeLast("Same orientation","Opposite orientation","Not a reparametrization of \( G \)");



###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
The map \( G(u, v) = (u, v, u^2 + v^3) \) for \( 0 \leq u \leq 2, 0 \leq v \leq 3 \) parametrizes part of a graph. For each surface, is it a reparametrization of \( G \)? If so, determine whether it has the same orientation. $BR
$BR
1. \{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}
$BR
2. \{ $mc2 -> print_q() \}
\{ $mc2 -> print_a() \}
$BR
3. \{ $mc3 -> print_q() \}
\{ $mc3 -> print_a() \}
$BR
4. \{ $mc4 -> print_q() \}
\{ $mc4 -> print_a() \}
$BR
5. \{ $mc5 -> print_q() \}
\{ $mc5 -> print_a() \}
END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );
ANS( checkbox_cmp( $mc3->correct_ans() ) );
ANS( checkbox_cmp( $mc4->correct_ans() ) );
ANS( checkbox_cmp( $mc5->correct_ans() ) );


############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
1. The correct answer is \{ $mc1->correct_ans() \} $BR
2. The correct answer is \{ $mc2->correct_ans() \} $BR
3. The correct answer is \{ $mc3->correct_ans() \} $BR
4. The correct answer is \{ $mc4->correct_ans() \} $BR
5. The correct answer is \{ $mc5->correct_ans() \} $BR
END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT();    