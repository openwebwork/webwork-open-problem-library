##DESCRIPTION
## MAT237 L1 Q10.1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','parametrized surfaces')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Parametrized surfaces')
## Institution('University of Toronto')
## Section1('L1')
## Problem1('10.1')


###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup


## Question L1 Q10.1 a)
$mc1 = new_checkbox_multiple_choice();

$mc1 -> qa (
"Which of these maps are parametrizations of  
\( S \)?", 
"\( G_A(s,t) = (t,s,st)\) for \(0 \leq s \leq 4, -1\leq t \leq \)",
"\(G_B(s,t) = (s^3,t, s^3t)\) for \(-1 \leq s \leq 1, 0 \leq t \leq 4 \)",
"\(G_E(s,t) = (\cos s, 4\sin t, 4\cos s \sin t)\) for \(0 \leq s \leq \pi, 0 \leq t \leq \pi \)"
);

$mc1->makeLast("\( G_A(s,t) = (t,s,st)\) for \(0 \leq s \leq 4, -1\leq t \leq \)",
"\(G_B(s,t) = (s^3,t, s^3t)\) for \(-1 \leq s \leq 1, 0 \leq t \leq 4 \)",
"\(G_C(s,t) = (s,4s^2,4s^3)\) for \(-1 \leq s \leq 1, 0 \leq t \leq 4  \)",
"\(G_D(s,t) = (s,t^2,st^2)\) for \(0 \leq s \leq 1, -2 \leq t\leq 2 \)", 
"\(G_E(s,t) = (\cos s, 4\sin t, 4\cos s \sin t)\) for \(0 \leq s \leq \pi, 0 \leq t \leq \pi \)");

## Question L1 Q10.1 b)
$mc2 = new_checkbox_multiple_choice();

$mc2 -> qa (
"Which of these maps are regular?", 
"\( G_A(s,t) = (t,s,st)\) for \(0 \leq s \leq 4, -1\leq t \leq \)",
"\(G_B(s,t) = (s^3,t, s^3t)\) for \(-1 \leq s \leq 1, 0 \leq t \leq 4 \)",
"\(G_D(s,t) = (s,t^2,st^2)\) for \(0 \leq s \leq 1, -2 \leq t\leq 2 \)", 
"\(G_E(s,t) = (\cos s, 4\sin t, 4\cos s \sin t)\) for \(0 \leq s \leq \pi, 0 \leq t \leq \pi \)"
);

$mc2->makeLast("\( G_A(s,t) = (t,s,st)\) for \(0 \leq s \leq 4, -1\leq t \leq \)",
"\(G_B(s,t) = (s^3,t, s^3t)\) for \(-1 \leq s \leq 1, 0 \leq t \leq 4 \)",
"\(G_C(s,t) = (s,4s^2,4s^3)\) for \(-1 \leq s \leq 1, 0 \leq t \leq 4  \)",
"\(G_D(s,t) = (s,t^2,st^2)\) for \(0 \leq s \leq 1, -2 \leq t\leq 2 \)", 
"\(G_E(s,t) = (\cos s, 4\sin t, 4\cos s \sin t)\) for \(0 \leq s \leq \pi, 0 \leq t \leq \pi \)");
## Question L1 Q10.1 c)
$mc3 = new_checkbox_multiple_choice();

$mc3 -> qa (
"Which of these maps are simple?", 
"\( G_A(s,t) = (t,s,st)\) for \(0 \leq s \leq 4, -1\leq t \leq \)",
"\(G_B(s,t) = (s^3,t, s^3t)\) for \(-1 \leq s \leq 1, 0 \leq t \leq 4 \)"
);

$mc3->makeLast("\( G_A(s,t) = (t,s,st)\) for \(0 \leq s \leq 4, -1\leq t \leq \)",
"\(G_B(s,t) = (s^3,t, s^3t)\) for \(-1 \leq s \leq 1, 0 \leq t \leq 4 \)",
"\(G_C(s,t) = (s,4s^2,4s^3)\) for \(-1 \leq s \leq 1, 0 \leq t \leq 4  \)",
"\(G_D(s,t) = (s,t^2,st^2)\) for \(0 \leq s \leq 1, -2 \leq t\leq 2 \)", 
"\(G_E(s,t) = (\cos s, 4\sin t, 4\cos s \sin t)\) for \(0 \leq s \leq \pi, 0 \leq t \leq \pi \)");

## Question J1 11.1 d)
$mc4 = new_checkbox_multiple_choice();


###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
Let \( S= \lbrace  (x,y,z) \in \mathbb{R}^3 :  -1  \leq x \leq 1, 0 \leq y \leq 4, z = xy \rbrace \). Define the following five maps. $BR

\(\bullet G_A(s,t) = (t,s,st)\) for \(0 \leq s \leq 4, -1\leq t \leq \) $BR

\(\bullet G_B(s,t) = (s^3,t, s^3t)\) for \(-1 \leq s \leq 1, 0 \leq t \leq 4 \) $BR

\(\bullet G_C(s,t) = (s,4s^2,4s^3)\) for \(-1 \leq s \leq 1, 0 \leq t \leq 4  \) $BR

\(\bullet G_D(s,t) = (s,t^2,st^2)\) for \(0 \leq s \leq 1, -2 \leq t\leq 2 \) $BR

\(\bullet G_E(s,t) = (\cos s, 4\sin t, 4\cos s \sin t)\) for \(0 \leq s \leq \pi, 0 \leq t \leq \pi \) 

$BR
Determine each of the following.
$BR
$BR
a) \{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}
$BR
b) \{ $mc2 -> print_q() \}
\{ $mc2 -> print_a() \}
$BR
c) \{ $mc3 -> print_q() \}
\{ $mc3 -> print_a() \}
END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );
ANS( checkbox_cmp( $mc3->correct_ans() ) );


############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answers are \{ $mc1->correct_ans() \} $BR
The correct answers are \{ $mc2->correct_ans() \} $BR
The correct answers are \{ $mc3->correct_ans() \} $BR
END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT();    
