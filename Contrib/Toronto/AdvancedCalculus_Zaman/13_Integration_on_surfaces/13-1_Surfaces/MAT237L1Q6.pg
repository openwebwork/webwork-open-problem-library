##DESCRIPTION
## MAT237 L1 Q6
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','parametrized surfaces')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Parametrized surfaces')
## Institution('University of Toronto')
## Section1('L1')
## Problem1('6')


###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup


## Question L1 Q6 
$mc1 = new_checkbox_multiple_choice();

$mc1 -> qa (
" ", 
"If there exists a simple regular 2-variable parametrization of \( S \), then \( S \) is a surface.",
"If \( S \) is a surface, then \( S \) is a piecewise surface.",
"If \( S \) is a piecewise surface, then \( S \) is compact."
);

$mc1->makeLast("If there exists a simple regular 2-variable parametrization of \( S \), then \( S \) is a surface.",
"If \( S \) is a surface, then \( S \) is a piecewise surface.",
"If \( S \) is a piecewise surface, then \( S \) is a surface.",
"If \( S \) is a piecewise surface, then \( S \) is compact.",
"If \( S \) is a surface, then \( S \) is a 2-dimensional smooth manifold.",
"If \( S \) is a 2-dimensional smooth manifold, then \( S \) is a surface."
);



###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
Let \( S \subseteq \mathbb{R}^3 \). Select the true statements

\{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}

END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );


############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answers are \{ $mc1->correct_ans() \} $BR
END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT();    