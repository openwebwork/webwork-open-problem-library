DOCUMENT();      

loadMacros(
   "PGstandard.pl",     # Standard macros for PG language
   "MathObjects.pl",
   #"source.pl",        # allows code to be displayed on certain sites.
   #"PGcourse.pl",      # Customization file for the course
);

# Print problem number and point value (weight) for the problem
TEXT(beginproblem());

# Show which answers are correct and which ones are incorrect
$showPartialCorrectAnswers = 1;

##############################################################
#
#  Setup
#
#
Context("Numeric");

$q1 = Compute("72pi"); #L4 Q7.3

##############################################################
#
#  Text
#
#

Context()->texStrings;
BEGIN_TEXT
Use geometric reasoning to evaluate \[ \iint_S (x,y,0)\cdot n \; dS \] where \( S \) is the surface \( x^2+y^2 =  9 \) and \( 0\le z \le 4 \), oriented with normals facing outwards. You may give an exact value or round to two decimal places

\{$q1->ans_rule\}
END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

ANS($q1->with(tolerance=>.0002)->cmp);
# default tolerance is .01 or one percent.


ENDDOCUMENT(); 