##DESCRIPTION
## MAT237 L4 Q1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','parametrized surfaces','surface integrals')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Surface integrals')
## Institution('University of Toronto')
## Section1('L4')
## Problem1('1')


###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup


## Question L4 Q1
$mc1 = new_checkbox_multiple_choice();

$mc1 -> qa (
" ", 
"\[ \iint_S F \cdot n \; dS \]",
"\[ \iint_U (F \circ G)(s,t) \cdot n(s,t) ||(\partial_1 G \times \partial_2 G)(s,t)|| dA \]",
"\[ \iint_U (F \circ G)(s,t) \cdot (\partial_1 G \times \partial_2 G)(s,t) dA\]",
);

$mc1->makeLast("\[ \iint_S F dS \]",
"\[\iint_S F \cdot dS\]",
"\[ \iint_S F \cdot n \; dS \]",
"\[ \iint_S F \cdot n \; dA \]",
"\[ \iint_U (F \circ G)(s,t) \cdot n(s,t) ||(\partial_1 G \times \partial_2 G)(s,t)|| dA \]",
"\[ \iint_U (F \circ G)(s,t) \cdot (\partial_1 G \times \partial_2 G)(s,t) dA\]"
);


###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
Let \( S \) be an oriented surface in \( \mathbb{R}^3 \) parametrized by \( G : U \to \mathbb{R}^3 \). Let \( F \) be a  vector field in \( \mathbb{R}^3 \) that is continuous on \( S \). Which of these quantities represents the flux of \( F \) across \( S \)? 

$BR
\{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}

END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );


############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answers are \{ $mc1->correct_ans() \} $BR
END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT();