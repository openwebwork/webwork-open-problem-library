##DESCRIPTION
## MAT237 L2 Q4
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','parametrized surfaces','surface area')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Surface area')
## Institution('University of Toronto')
## Section1('L2')
## Problem1('4')



###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup


## Question L2 Q1 
$mc1 = new_checkbox_multiple_choice();

$mc1 -> qa (
"Which of the following quantities are equal to the surface area of \( S \)?", 
"\[ \iint_S 1 dS \]",
"\[ \iint_U ||\partial_1 G \times \partial_2 G|| dA \]",
"\[ \iint_U ||\partial_2 G \times \partial_1 G|| dA \]",
"\[ \iint_V ||\partial_1 H \times \partial_2 H|| dA \]"
);

$mc1->makeLast("\[ \iint_S 1 dS \]",
"\[ \iint_S 1 dA \]",
"\[ \iint_U 1 du dv \]",
"\[ \iint_U ||\partial_1 G \times \partial_2 G|| dA \]",
"\[ \iint_U ||\partial_2 G \times \partial_1 G|| dA \]",
"\[ \iint_V ||\partial_1 H \times \partial_2 H|| dA \]"
);


###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
Let \( S \subseteq \mathbb{R}^3 \) be a surface. Let \( G : U \to \mathbb{R}^3 \) and \(H : V \to \mathbb{R}^3 \) be parametrizations of \( S \). 
$BR
$BR
\{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}

END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );


############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answers are \{ $mc1->correct_ans() \} $BR
END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT();   