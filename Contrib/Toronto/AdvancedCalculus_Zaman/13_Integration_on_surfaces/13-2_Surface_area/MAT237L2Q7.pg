##DESCRIPTION
## MAT237 L2 Q7
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','parametrized surfaces','surface area')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Surface area')
## Institution('University of Toronto')
## Section1('L2')
## Problem1('7')



###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup


## Question L2 Q7
$mc1 = new_checkbox_multiple_choice();

$mc1 -> qa (
" ", 
"\[\iint_S f dS\]",
"\[\iint_U f(G(s,t)) \, ||\partial_1 G \times \partial_2 G|| dA\]",
);

$mc1->makeLast("\[ \iint_S f \times dS \]",
"\[\iint_S f \cdot T ds\]",
"\[\iint_S f dS\]",
"\[\iint_S f dxdy\]",
"\[\iint_U f(G(s,t)) \, ||\partial_1 G \times \partial_2 G|| dA\]",
"\[ \iint_U f(G(s,t)) \,(\partial_1 G \times \partial_2 G) dA\]"
);



###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
Let \( f : \mathbb{R}^3 \to [0,\infty) \) be continuous and \( S \) be a   surface in \( \mathbb{R}^3 \) parametrized by \( G : U \to \mathbb{R}^3 \). Let \( V \) be the volume between the two illustrated surfaces lying above the \( z=0 \) plane.
 $BR
\{ image( "l2-scalar-surface.png", width=>350, height=>320) \}
$BR
Which  quantities represent \( V\)? \(\textit{Hint:} \) Some of these are nonsense.

\{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}

END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );



############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answers are \{ $mc1->correct_ans() \} $BR
END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT(); 