##DESCRIPTION
## MAT237 L2 Q6
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','parametrized surfaces','surface area')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Surface area')
## Institution('University of Toronto')
## Section1('L2')
## Problem1('6')


########################################################################

DOCUMENT();      

loadMacros(
   "PGstandard.pl",     # Standard macros for PG language
   "MathObjects.pl",
   #"source.pl",        # allows code to be displayed on certain sites.
   #"PGcourse.pl",      # Customization file for the course
);

# Print problem number and point value (weight) for the problem
TEXT(beginproblem());

# Show which answers are correct and which ones are incorrect
$showPartialCorrectAnswers = 1;

##############################################################
#
#  Setup
#
#
Context("Numeric");

$q1 = Compute("30sqrt(741)"); #L2 Q6.1
$q2 = Compute("12sqrt(741)+162sqrt(3)"); #L2 Q6.2

#$q1 = Real("816.63945533"); #L2 Q6.1
#$q2 = Real("607.24801296"); #L2 Q6.2

##############################################################
#
#  Text
#
#

Context()->texStrings;
BEGIN_TEXT
For both parts you may give a decimal answer rounded to two decimal places or an exact value. $BR

Let \( S \)  be a surface parametrized by \( G :U \to \mathbb{R}^3 \) where \( U = [1,3] \times [2,7] \). $BR

1. Estimate the surface area of \( S \) given that \( 	DG(1,2) = \begin{bmatrix} -1 & 9 \\ 8 & 6 \\ 2 & 3 \end{bmatrix} \). 
\{$q1->ans_rule\}
$BR
2. Improve your estimate if you also learn that  \( DG(1,4) = \begin{bmatrix} -1 & 7 \\ 6 & 3 \\ 1 & 2 \end{bmatrix} \). 
\{$q2->ans_rule\}
END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

ANS($q1->with(tolerance=>.00001)->cmp);
ANS($q2->with(tolerance=>.00001)->cmp);
# default tolerance is .01 or one percent.


ENDDOCUMENT();    