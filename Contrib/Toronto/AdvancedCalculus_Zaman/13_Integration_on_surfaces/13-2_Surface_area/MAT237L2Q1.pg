##DESCRIPTION
## MAT237 L2 Q1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','parametrized surfaces','surface area')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Surface area')
## Institution('University of Toronto')
## Section1('L2')
## Problem1('1')



###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup


## Question L2 Q1 
$mc1 = new_checkbox_multiple_choice();

$mc1 -> qa (
" ", 
"\( \frac{1}{2}||a \times b|| \) is the area of the triangle in  \( \mathbb{R}^3 \) with sides \( a \) and \( b \)",
"\(a \times a = 0 \)",
"\( a \times b = -b \times a \)",
"\( e_1 \times e_2 = e_3 \)"
);

$mc1->makeLast("\( a \times b \) is the area of the parallelogram in  \( \mathbb{R}^3 \) with sides \( a \) and \( b \)",
"\( \frac{1}{2}||a \times b|| \) is the area of the triangle in  \( \mathbb{R}^3 \) with sides \( a \) and \( b \)",
"\(a \times a = 0 \)",
"\( a \times b = -b \times a \)",
"\(\lambda (a \times b) = (\lambda a) \times (\lambda b) \)",
"\( e_1 \times e_2 = e_3 \)",
"\( e_1 \times e_3 = e_2 \)"
);


###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
Let \( a,b,c \in \mathbb{R}^3 \) and \( \lambda \in \mathbb{R} \). Let \( e_1,e_2,e_3 \) denote the standard basis vectors in \( \mathbb{R}^3 \). $BR
Select the true statements.


\{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}

END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );


############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answers are \{ $mc1->correct_ans() \} $BR
END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT();