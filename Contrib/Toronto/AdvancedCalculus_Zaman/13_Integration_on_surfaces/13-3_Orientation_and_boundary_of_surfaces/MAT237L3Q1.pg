##DESCRIPTION
## MAT237 L3 Q1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','parametrized surfaces','orientation')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Orientation and boundary of surfaces')
## Institution('University of Toronto')
## Section1('L3')
## Problem1('1')


###########################
#  Initialization

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserRadioButtons.pl",
  "PGML.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup

Context("Numeric");
#L3 Q1.1
$radio1 = RadioButtons(
 ["Same direction","Opposite direction","Not applicable"],
  "Opposite direction", # correct answer
  last =>  ["Same direction","Opposite direction","Not applicable"], # can be a list
);

##L3 Q1.2
$radio2 = RadioButtons(
 ["Same direction","Opposite direction","Not applicable"],
  "Same direction", # correct answer
  last =>  ["Same direction","Opposite direction","Not applicable"], # can be a list
);
#L3 Q1.3
$radio3 = RadioButtons(
 ["Same direction","Opposite direction","Not applicable"],
  "Opposite direction", # correct answer
  last =>  ["Same direction","Opposite direction","Not applicable"], # can be a list
);

##L3 Q1.4
$radio4 = RadioButtons(
 ["Same direction","Opposite direction","Not applicable"],
  "Not applicable", # correct answer
  last =>  ["Same direction","Opposite direction","Not applicable"], # can be a list
);



###########################
#  Main text

BEGIN_TEXT
It is time to practice the righthand rule! The red vector \( n \) is orthogonal to both the purple vector \( a \) and the green vector \( b \). 
Is \( a\times b \) is in the same direction as \( n \), or in the opposite direction?

$BR 
1. 
$BR
\{ image( "l3-righthand-1.png", width=>200, height=>200 ) \}

$BR

END_TEXT

BEGIN_PGML
[@ $radio1->buttons() @]*
END_PGML

BEGIN_TEXT
$BR 
2. $BR
\{ image( "l3-righthand-2.png", width=>200, height=>200 ) \}
$BR

END_TEXT

BEGIN_PGML
[@ $radio2->buttons() @]*
END_PGML

BEGIN_TEXT
$BR 
3.  $BR
\{ image( "l3-righthand-3.png", width=>200, height=>200 ) \}
$BR

END_TEXT

BEGIN_PGML
[@ $radio2->buttons() @]*
END_PGML

BEGIN_TEXT
$BR 
4.  $BR
\{ image( "l3-righthand-4.png", width=>200, height=>200 ) \}
$BR

END_TEXT

BEGIN_PGML
[@ $radio2->buttons() @]*
END_PGML



############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio1->cmp() );
ANS( $radio2->cmp() );
ANS( $radio3->cmp() );
ANS( $radio4->cmp() );




############################
#  Solution


COMMENT('MathObject version. Uses PGML.');

ENDDOCUMENT();