##DESCRIPTION
## MAT237 L3 Q3
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','parametrized surfaces','orientation')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Orientation and boundary of surfaces')
## Institution('University of Toronto')
## Section1('L3')
## Problem1('3')


###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup


## Question L3 Q3
$mc1 = new_checkbox_multiple_choice();

$mc1 -> qa (
" ", 
"\( H(s,t) = (\sqrt{1-s^2}\cos(t), \sqrt{1-s^2}\sin(t), s)\) for \( (s,t)\in [-1,0]\times [0,2\pi] \). $BR
	\( \textit{Hint:}  \partial_1 H(s,t) = \left(\dfrac{-s}{\sqrt{1-s^2}}\cos(t),\dfrac{-s}{\sqrt{1-s^2}}\sin(t), 1\right)\) and \(  \partial_2 H(s,t) = \big(-\sqrt{1-s^2}\sin(t), \sqrt{1-s^2}\cos(t), 0\big) \).",
    "\( J(s,t) = (s+t,s-t,-\sqrt{1-2s^2-2t^2}) \) for \( (s,t) \) with \( s^2 + t^2 \le \frac{1}{2} \).",
    "\( K(s,t) = (\cos(s)\cos(t),\sin(s)\cos(t), \sin(t)) \) for \( (s,t) \in [0,2\pi]\times[\pi,3\pi/2] \)"
);

$mc1->makeLast("\( G(s,t) = (s,t,-\sqrt{1-s^2 - t^2}) \) for \( (s,t) \) with  \( s^2+ t^2 \le 1 \). $BR
	\(\textit{Hint:}   \partial_1 G(s,t) = \left(1,0,\dfrac{s}{\sqrt{1-s^2-t^2}}\right) \) and \( \partial_2 G(s,t) = \left(0,1,\frac{t}{\sqrt{1-s^2-t^2}}\right)\).",
"\( H(s,t) = (\sqrt{1-s^2}\cos(t), \sqrt{1-s^2}\sin(t), s)\) for \( (s,t)\in [-1,0]\times [0,2\pi] \). $BR
	\( \textit{Hint:}  \partial_1 H(s,t) = \left(\dfrac{-s}{\sqrt{1-s^2}}\cos(t),\dfrac{-s}{\sqrt{1-s^2}}\sin(t), 1\right)\) and \(  \partial_2 H(s,t) = \big(-\sqrt{1-s^2}\sin(t), \sqrt{1-s^2}\cos(t), 0\big) \).",
    "\( J(s,t) = (s+t,s-t,-\sqrt{1-2s^2-2t^2}) \) for \( (s,t) \) with \( s^2 + t^2 \le \frac{1}{2} \).",
    "\( K(s,t) = (\cos(s)\cos(t),\sin(s)\cos(t), \sin(t)) \) for \( (s,t) \in [0,2\pi]\times[\pi,3\pi/2] \)"
);


###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
There is a shortcut to identifying orientations of a surface. Let \( S \) be the lower hemisphere of radius 1 centered at the origin. Orient \( S \) so that \( \textbf{its unit normal } n \textbf{ points towards the origin} \). Each map below is a parametrization of the (non-oriented) surface \( S \). Which of them are parametrizations of the \( \textbf{oriented} \) surface \( S \)? That is, which ones have the same unit normal? 

$BR
$BR
\{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}

END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );


############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answers are \{ $mc1->correct_ans() \} $BR
END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT();    