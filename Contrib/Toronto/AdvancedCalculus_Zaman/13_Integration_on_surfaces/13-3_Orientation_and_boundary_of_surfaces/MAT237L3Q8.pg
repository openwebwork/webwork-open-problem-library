##DESCRIPTION
## MAT237 L3 Q8
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','parametrized surfaces','orientation')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Orientation and boundary of surfaces')
## Institution('University of Toronto')
## Section1('L3')
## Problem1('8')



###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup


## Question L3 Q8.1 
$mc1 = new_checkbox_multiple_choice();

$mc1 -> qa (
"\( S = \lbrace (x,y,z) \in \mathbb{R}^3 : x^2+y^2=9, 0 \leq z \leq 9 \rbrace \)", 
"\( \gamma(t)=(3\cos t,3\sin t, 9) \) for \( 0 \leq t \leq 2\pi \)",
"\( \gamma(t)=(3\cos t,3\sin t, 0) \)  for \(  0 \leq t \leq 2\pi \)",
);
$mc1 -> extra(
"\(\gamma(t)=(3\cos t,3\sin t, 3\cos t+3\sin t) \) for \( \frac{\pi}{4}\leq t \leq \frac{3\pi}{4}\)",
"\(\gamma(t)=(\cos t+1,\sin t, \sqrt{7-2\cos t}) \) for \( 0 \leq t \leq 2\pi\)",
"\(\gamma(t)=(\cos t+1,\sin t, -\sqrt{7-2\cos t}) \) for \( 0 \leq t \leq 2\pi \)"
);
$mc1->makeLast("The relative boundary is empty");
## Question L3 Q8.2
$mc2 = new_checkbox_multiple_choice();

$mc2 -> qa (
"\( S = \lbrace (x,y,z) \in \mathbb{R}^3 : x^2+y^2=9, 0 \leq z \leq x+y \rbrace \)", 
"\(\gamma(t)=(3\cos t,3\sin t, 3\cos t+3\sin t) \) for \( \frac{\pi}{4}\leq t \leq \frac{3\pi}{4}\)",
"\( \gamma(t)=(3\cos t,3\sin t, 0) \)  for \(  0 \leq t \leq 2\pi \)"
);
$mc2 -> extra(
"\( \gamma(t)=(3\cos t,3\sin t, 9) \) for \( 0 \leq t \leq 2\pi \)",
"\(\gamma(t)=(\cos t+1,\sin t, \sqrt{7-2\cos t}) \) for \( 0 \leq t \leq 2\pi\)",
"\(\gamma(t)=(\cos t+1,\sin t, -\sqrt{7-2\cos t}) \) for \( 0 \leq t \leq 2\pi \)"
);
$mc2->makeLast("The relative boundary is empty");

## Question L3 Q8.3
$mc3 = new_checkbox_multiple_choice();

$mc3 -> qa (
"\( S = \lbrace (x,y,z) \in \mathbb{R}^3 : x^2+y^2+z^2=9, (x-1)^2 + y^2 \leq 1 \rbrace \)", 
"\(\gamma(t)=(\cos t+1,\sin t, \sqrt{7-2\cos t}) \) for \( 0 \leq t \leq 2\pi\)",
"\(\gamma(t)=(\cos t+1,\sin t, -\sqrt{7-2\cos t}) \) for \( 0 \leq t \leq 2\pi \)"
);
$mc3 -> extra("\( \gamma(t)=(3\cos t,3\sin t, 9) \) for \( 0 \leq t \leq 2\pi \)",
"\( \gamma(t)=(3\cos t,3\sin t, 0) \)  for \(  0 \leq t \leq 2\pi \)",
"\( \gamma(t)=(3\cos t,3\sin t, 9) \) for \( 0 \leq t \leq 2\pi \)",
"\(\gamma(t)=(3\cos t,3\sin t, 3\cos t+3\sin t) \) for \( \frac{\pi}{4}\leq t \leq \frac{3\pi}{4}\)"
);
$mc3->makeLast("The relative boundary is empty");

## Question L3 Q8.4
$mc4 = new_checkbox_multiple_choice();

$mc4 -> qa (
"\( S = \lbrace (x,y,z) \in \mathbb{R}^3 : x^2+y^2+z^2=9 \rbrace \)", 
"The relative boundary is empty"
);
$mc4->makeLast("\( \gamma(t)=(3\cos t,3\sin t, 9) \) for \( 0 \leq t \leq 2\pi \)",
"\( \gamma(t)=(3\cos t,3\sin t, 0) \)  for \(  0 \leq t \leq 2\pi \)",
"\( \gamma(t)=(3\cos t,3\sin t, 9) \) for \( 0 \leq t \leq 2\pi \)",
"\(\gamma(t)=(3\cos t,3\sin t, 3\cos t+3\sin t) \) for \( \frac{\pi}{4}\leq t \leq \frac{3\pi}{4}\)",
"\(\gamma(t)=(\cos t+1,\sin t, \sqrt{7-2\cos t}) \) for \( 0 \leq t \leq 2\pi\)",
"\(\gamma(t)=(\cos t+1,\sin t, -\sqrt{7-2\cos t}) \) for \( 0 \leq t \leq 2\pi \)",
"The relative boundary is empty");

## Question L3 Q8.5
$mc5 = new_checkbox_multiple_choice();

$mc5 -> qa (
"\( S = \partial [0,1]^3 \)", 
"The relative boundary is empty"
);
$mc5->makeLast("\( \gamma(t)=(3\cos t,3\sin t, 9) \) for \( 0 \leq t \leq 2\pi \)",
"\(\gamma(t)=(\cos t+1,\sin t, \sqrt{7-2\cos t}) \) for \( 0 \leq t \leq 2\pi\)",
"\( \gamma(t)=(3\cos t,3\sin t, 9) \) for \( 0 \leq t \leq 2\pi \)",
"\(\gamma(t)=(\cos t+1,\sin t, -\sqrt{7-2\cos t}) \) for \( 0 \leq t \leq 2\pi \)",
"\(\gamma(t)=(3\cos t,3\sin t, 3\cos t+3\sin t) \) for \( \frac{\pi}{4}\leq t \leq \frac{3\pi}{4}\)",
"\( \gamma(t)=(3\cos t,3\sin t, 0) \)  for \(  0 \leq t \leq 2\pi \)",

"The relative boundary is empty");
###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
Given the each surface \( S \subseteq \mathbb{R}^3 \),  select the parametrized curve(s) which parametrize the boundary of \( S \). Some surfaces may have multiple components making up the relative boundary, requiring multiple parametrized curves.

$BR
$BR
\{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}
$BR
\{ $mc2 -> print_q() \}
\{ $mc2 -> print_a() \}
$BR
\{ $mc3 -> print_q() \}
\{ $mc3 -> print_a() \}
$BR
\{ $mc4 -> print_q() \}
\{ $mc4 -> print_a() \}
$BR
\{ $mc5 -> print_q() \}
\{ $mc5 -> print_a() \}
END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );
ANS( checkbox_cmp( $mc3->correct_ans() ) );
ANS( checkbox_cmp( $mc4->correct_ans() ) );
ANS( checkbox_cmp( $mc5->correct_ans() ) );


############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer are \{ $mc1->correct_ans() \} $BR
The correct answers are \{ $mc2->correct_ans() \} $BR
The correct answers are \{ $mc3->correct_ans() \} $BR
The correct answers is \{ $mc4->correct_ans() \} $BR
The correct answers is \{ $mc5->correct_ans() \} $BR
END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT();  