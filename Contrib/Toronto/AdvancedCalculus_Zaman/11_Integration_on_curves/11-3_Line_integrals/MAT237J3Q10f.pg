##############################################################
#
#  Text
#
#

Context()->texStrings;
BEGIN_TEXT
An object moves in a force field \( F(x,y) = (y^2, 2xy + 2y) \) counterclockwise from the point \( (2,0) \) along the elliptical path \( x^2 + 4y^2 = 4 \) to \( (-2,0) \) and then back to the point \( (2,0) \) along the \( x\)-axis. How much work is done by the force field on the object? $BR

\{$q1->ans_rule\}




END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

ANS($q1->with(tolerance=>.01)->cmp);


# default tolerance is .01 or one percent.


ENDDOCUMENT(); 