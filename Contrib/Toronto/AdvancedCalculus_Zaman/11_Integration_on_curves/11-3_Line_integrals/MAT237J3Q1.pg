##DESCRIPTION
## MAT237 J3 Q1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','line integrals')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Line integrals')
## Institution('University of Toronto')
## Section1('J3')
## Problem1('1')



###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup


## Question J3 1.1
$mc1 = new_checkbox_multiple_choice();

$mc1 -> qa (
"The direction of motion of the particle at time 
\( t \).", 
"\( \dfrac{\gamma'(t)}{||\gamma'(t)||} \)","\(T(t)\)"      
);

$mc1->makeLast("\( \gamma(t) \)","\( \gamma'(t) \)","\( \dfrac{\gamma'(t)}{||\gamma'(t)||} \)","\(T(t)\)","\(\gamma(t) \cdot T(t)\)");

## Question J3 1.2
$mc2 = new_checkbox_multiple_choice();

$mc2 -> qa (
"The amount of tangential force experienced by the particle at time 
\( t \).", 
"\( F(\gamma(t)) \cdot T(t)\)"
);

$mc2->makeLast("\(T(t)\)","\( F(\gamma(t) \))","\( F(\gamma(t)) \cdot T(t)\)","\( F(\gamma(t)) \cdot \gamma(t)\)","\( F(\gamma(t)) \cdot \gamma'(t)\)");

## Question J3 1.3
$mc3 = new_checkbox_multiple_choice();

$mc3 -> qa (
"The infinitesimal distance travelled by the particle at time \( t \).", 
"\( ||\gamma'(t)||dt\)"
);

$mc3->makeLast("\( ||\gamma(t)||\)","\( ||\gamma'(t)||\)", "\( \gamma'(t)\)","\( ||\gamma(t)||dt\)","\( ||\gamma'(t)||dt\)","\( \gamma'(t)dt\)");

## Question J3 1.4
$mc4 = new_checkbox_multiple_choice();

$mc4 -> qa (
"The total work done by the vector field on the particle.", 
"\( \int_a^b F(\gamma(t))\cdot T(t)||\gamma'(t)|| dt\)",
"\( \int_a^b F(\gamma(t))\cdot \gamma'(t) dt\)"
);

$mc4->makeLast("\( \int_a^b F(t) dt\)","\( \int_a^b F(\gamma(t)) dt\)","\( \int_a^b F(\gamma(t))\cdot T(t) dt\)","\( \int_a^b F(\gamma(t))\cdot T(t)||\gamma'(t)|| dt\)","\( \int_a^b F(\gamma(t))\cdot \gamma'(t) dt\)");
###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
Let \( \gamma: [a,b] \to \mathbb{R}^n \) be a parametrization of an oriented curve \( C \subseteq \mathbb{R}^n \) with unit tangent vector \( T \). Consider the following algebraic expressions. View \( \gamma \) as the motion of a particle along the path \( C \subseteq \). For each physical description below, select the corresponding equivalent expression(s).

$BR
$BR
1. \{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}
$BR
2. \{ $mc2 -> print_q() \}
\{ $mc2 -> print_a() \}
$BR
3. \{ $mc3 -> print_q() \}
\{ $mc3 -> print_a() \}
$BR
4. \{ $mc4 -> print_q() \}
\{ $mc4 -> print_a() \}
END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );
ANS( checkbox_cmp( $mc3->correct_ans() ) );
ANS( checkbox_cmp( $mc4->correct_ans() ) );


############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
1. The correct answers are \{ $mc1->correct_ans() \} $BR
2. The correct answers are \{ $mc2->correct_ans() \} $BR
3. The correct answers are \{ $mc3->correct_ans() \} $BR
4. The correct answers are \{ $mc4->correct_ans() \} $BR
END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT(); 