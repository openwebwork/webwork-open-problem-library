##DESCRIPTION
## MAT237 J3 Q2
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','line integrals')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Line integrals')
## Institution('University of Toronto')
## Section1('J3')
## Problem1('2')



###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup


## Question J3 1.1
$mc1 = new_checkbox_multiple_choice();

$mc1 -> qa (
"Which of the line integrals are positive?", 
"\( \int_{C_1} F \cdot T ds\)", "\( \int_{C_2} F \cdot T ds\)","\( \int_{C_3} F \cdot T ds\)"
);

$mc1->makeLast("\( \int_{C_1} F \cdot T ds\)", "\( \int_{C_2} F \cdot T ds\)","\( \int_{C_3} F \cdot T ds\)","\( \int_{C_4} F \cdot T ds\)","None of the above" );

## Question J3 1.2
$mc2 = new_checkbox_multiple_choice();

$mc2 -> qa (
"Which of the line integrals are negative?", 
"\( \int_{C_4} F \cdot T ds\)"
);

$mc2->makeLast("\( \int_{C_1} F \cdot T ds\)", "\( \int_{C_2} F \cdot T ds\)","\( \int_{C_3} F \cdot T ds\)","\( \int_{C_4} F \cdot T ds\)","None of the above" );

## Question J3 1.3
$mc3 = new_checkbox_multiple_choice();

$mc3 -> qa (
"Arrange the line integrals in ascending order.", 
"\( \int_{C_4} F \cdot T ds,\int_{C_1} F \cdot T ds, \int_{C_3} F \cdot T ds, \int_{C_2} F \cdot T ds\)"
);

$mc3->extra("\( \int_{C_2} F \cdot T ds,\int_{C_1} F \cdot T ds, \int_{C_3} F \cdot T ds, \int_{C_4} F \cdot T ds\)", 
"\( \int_{C_3} F \cdot T ds,\int_{C_1} F \cdot T ds, \int_{C_2} F \cdot T ds, \int_{C_4} F \cdot T ds\)",
"\( \int_{C_4} F \cdot T ds,\int_{C_3} F \cdot T ds, \int_{C_1} F \cdot T ds, \int_{C_2} F \cdot T ds\)",
"\( \int_{C_3} F \cdot T ds,\int_{C_1} F \cdot T ds, \int_{C_4} F \cdot T ds, \int_{C_2} F \cdot T ds\)",
);


###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
A vector field \( F \) in \( \mathbb{R}^2 \) and oriented curves \( C_1,C_2,C_3, \) and \( C_4 \) are shown in the image. The curves \( C_1 \) and \( C_3 \) are the same length. Consider the four line integrals.

\[
	\int_{C_1} F \cdot T ds \qquad \qquad
	\int_{C_2} F \cdot T ds
	\]
	\[
	\int_{C_3} F \cdot T ds \qquad \qquad
	\int_{C_4} F \cdot T ds
	\]

\{ image( "j3-compare.png", width=>257, height=>238 ) \}

$BR
$BR
1. \{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}
$BR
2. \{ $mc2 -> print_q() \}
\{ $mc2 -> print_a() \}
$BR
3. \{ $mc3 -> print_q() \}
\{ $mc3 -> print_a() \}

END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );
ANS( checkbox_cmp( $mc3->correct_ans() ) );



############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $mc1->correct_ans() \} $BR
The correct answers are \{ $mc2->correct_ans() \} $BR
The correct answers are \{ $mc3->correct_ans() \} $BR

END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT(); 