########################################################################

DOCUMENT();      

loadMacros(
   "PGstandard.pl",     # Standard macros for PG language
   "MathObjects.pl",
   #"source.pl",        # allows code to be displayed on certain sites.
   #"PGcourse.pl",      # Customization file for the course
);

# Print problem number and point value (weight) for the problem
TEXT(beginproblem());

# Show which answers are correct and which ones are incorrect
$showPartialCorrectAnswers = 1;

##############################################################
#
#  Setup
#
#
Context("Numeric");

$q1 = Compute("-1"); #J3 Q5.1
$q2 = Compute("0"); #J3 Q5.2
$q3 = Compute("-708/40000"); #J3 Q5.3



##############################################################
#
#  Text
#
#

Context()->texStrings;
BEGIN_TEXT
Goku travels along a path subject to a force \( F \), due to gravity.  As a Super Saiyyan, Goku walks along \( C_2 \) and then flies radially away from the center of the Earth along \( C_1. \)

$BR
\{ image( "j3-earth.png", width=>180, height=>213 ) \}
$BR

1. Is the work done by \( F \) along \( C_1 \) positive, zero, or negative? If positive answer 1, if zero answer 0, and if negative answer -1. $BR
\{$q1->ans_rule\} $BR

2. Is the work done by \( F \) along \( C_2 \) positive, zero, or negative? If positive answer 1, if zero answer 0, and if negative answer -1. $BR
\{$q1->ans_rule\} $BR

3. If Goku is at position \( x \in \mathbb{R}^3 \) and the center of the Earth is the origin  then \( F(x) = \dfrac{-G Mm x}{||x||^3} \) where \( G \) is the gravitational constant, \( M \) is the mass of the Earth, and \( m \) is the mass of Goku. 	$BR
	Calculate the work done by gravity as Goku travels along \( C_1 \) if \( G=6 \), \( M= 59 \), and \( m=2 \).   $BR
\{$q3->ans_rule\} $BR





END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

ANS($q1->with(tolerance=>.001)->cmp);
ANS($q2->with(tolerance=>.001)->cmp);
ANS($q3->with(tolerance=>.05)->cmp);


# default tolerance is .01 or one percent.


ENDDOCUMENT();  