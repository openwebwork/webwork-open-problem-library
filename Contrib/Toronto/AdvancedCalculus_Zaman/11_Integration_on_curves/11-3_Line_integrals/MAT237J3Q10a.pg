);

# Print problem number and point value (weight) for the problem
TEXT(beginproblem());

# Show which answers are correct and which ones are incorrect
$showPartialCorrectAnswers = 1;

##############################################################
#
#  Setup
#
#
Context("Numeric");

$q1 = Compute("-66"); #J3 Q10.1



##############################################################
#
#  Text
#
#

Context()->texStrings;
BEGIN_TEXT
Find \[ \int_C F \cdot T ds \] where \( F(x,y) = (-x,-2y) \) and \( C \) is the curve \( y=x^3 \) from \( (0,0) \) to \( (2,8). \)


$BR
\{$q1->ans_rule\} $BR




END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

ANS($q1->with(tolerance=>.01)->cmp);


# default tolerance is .01 or one percent.


ENDDOCUMENT();