##DESCRIPTION
## MAT237 J3 Q3
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','line integrals')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Line integrals')
## Institution('University of Toronto')
## Section1('J3')
## Problem1('3')



###########################
#  Initialization

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserRadioButtons.pl",
  "PGML.pl",
  "PGcourse.pl",
);

TEXT(beginproblem());


###########################
#  Setup

Context("Numeric");
##J3 Q3.1
$radio1 = RadioButtons(
  ["Positive", "Negative","Zero"],
  "Negative", # correct answer
last => ["Positive", "Negative","Zero"], # can be a list
);

##J3 Q3.2
$radio2 = RadioButtons(
 ["Positive", "Negative","Zero"],
  "Positive", # correct answer
last => ["Positive", "Negative","Zero"], # can be a list
);

##J3 Q3.3
$radio3 = RadioButtons(
 ["Positive", "Negative","Zero"],
  "Zero", # correct answer
last => ["Positive", "Negative","Zero"], # can be a list
);

##J3 Q3.4
$radio4 = RadioButtons(
 ["Positive", "Negative","Zero"],
  "Positive", # correct answer
last => ["Positive", "Negative","Zero"], # can be a list
);

##J3 Q3.5
$radio5 = RadioButtons(
 ["Positive", "Negative","Zero"],
  "Zero", # correct answer
last => ["Positive", "Negative","Zero"], # can be a list
);

##J3 Q3.6
$radio6 = RadioButtons(
 ["Positive", "Negative","Zero"],
  "Negative", # correct answer
last => ["Positive", "Negative","Zero"], # can be a list
);



###########################
#  Main text

BEGIN_TEXT
For each vector field, determine whether you expect the line integral to be positive, negative, or zero. 

$BR $BR

1. \{ image( "j3-vector-field-1.png", width=>196, height=>105 ) \}
END_TEXT

BEGIN_PGML
[@ $radio1->buttons() @]*
END_PGML

BEGIN_TEXT
$BR
2.   \{ image( "j3-vector-field-2.png", width=>196, height=>105) \}
END_TEXT

BEGIN_PGML
[@ $radio2->buttons() @]*
END_PGML

BEGIN_TEXT
$BR
3.  \{ image( "j3-vector-field-3.png", width=>196, height=>105) \}
END_TEXT

BEGIN_PGML
[@ $radio3->buttons() @]*
END_PGML

BEGIN_TEXT
$BR
4.  \{ image( "j3-vector-field-4.png", width=>196, height=>105) \}
END_TEXT

BEGIN_PGML
[@ $radio4->buttons() @]*
END_PGML

BEGIN_TEXT
$BR
5.  \{ image( "j3-vector-field-5.png", width=>196, height=>105) \}
END_TEXT

BEGIN_PGML
[@ $radio5->buttons() @]*
END_PGML

BEGIN_TEXT
$BR
6.  \{ image( "j3-vector-field-6.png", width=>196, height=>105) \}
END_TEXT

BEGIN_PGML
[@ $radio6->buttons() @]*
END_PGML



############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio1->cmp() );
ANS( $radio2->cmp() );
ANS( $radio3->cmp() );
ANS( $radio4->cmp() );
ANS( $radio5->cmp() );
ANS( $radio6->cmp() );



############################
#  Solution

BEGIN_PGML_SOLUTION
1. The correct answer is [$radio1->correct_ans()]. 

2. The correct answer is [$radio2->correct_ans()].

3. The correct answer is [$radio3->correct_ans()]. 

4. The correct answer is [$radio4->correct_ans()]. 


END_PGML_SOLUTION

COMMENT('MathObject version. Uses PGML.');

ENDDOCUMENT();