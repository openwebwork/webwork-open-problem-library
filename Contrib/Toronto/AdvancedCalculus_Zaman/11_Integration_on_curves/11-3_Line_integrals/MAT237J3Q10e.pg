##############################################################
#
#  Text
#
#

Context()->texStrings;
BEGIN_TEXT
Find the work done by the force \( F(x,y,z) = (x, 2xy, -x-z) \) on a particle moving alone the line segment from \( (1,4,2) \) to \( (0,5,1). \)
$BR

\{$q1->ans_rule\}




END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

ANS($q1->with(tolerance=>.01)->cmp);


# default tolerance is .01 or one percent.


ENDDOCUMENT(); 