##DESCRIPTION
## MAT237 J1 Q1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','line integrals')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Parametrized curves')
## Institution('University of Toronto')
## Section1('J1')
## Problem1('1')


###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup


## Question J1 1.1
$mc1 = new_checkbox_multiple_choice();

$mc1 -> qa (
"Which of these maps are parametrizations of  
\( S \)?", 
"\( \gamma_A(t)=(t,t^2) \) for \( 0 \leq t \leq 1 \)", 
"\( \gamma_C(t)=(t^2,t^4) \) for \( 0 \leq t \leq 1 \)",
"\( \gamma_D(t)=(t^2,t^4) \) for \( -1 \leq t \leq 0 \)",
"\( \gamma_E(t)=(t^2,t^4) \) for \( -1 \leq t \leq 1 \)"
);

$mc1->makeLast("\( \gamma_A(t)=(t,t^2) \) for \( 0 \leq t \leq 1 \)","\( \gamma_B(t)=(t,t^2) \) for \( -1 \leq t \leq 1 \)","\( \gamma_C(t)=(t^2,t^4) \) for \( 0 \leq t \leq 1 \)","\( \gamma_D(t)=(t^2,t^4) \) for \( -1 \leq t \leq 0 \)","\( \gamma_E(t)=(t^2,t^4) \) for \( -1 \leq t \leq 1 \)");

## Question J2 1.2
$mc2 = new_checkbox_multiple_choice();

$mc2 -> qa (
"Which of these maps are regular?", 
"\( \gamma_A(t)=(t,t^2) \) for \( 0 \leq t \leq 1 \)", 
"\( \gamma_B(t)=(t,t^2) \) for \( -1 \leq t \leq 1 \)",
"\( \gamma_C(t)=(t^2,t^4) \) for \( 0 \leq t \leq 1 \)",
"\( \gamma_D(t)=(t^2,t^4) \) for \( -1 \leq t \leq 0 \)"
);

$mc2->makeLast("\( \gamma_A(t)=(t,t^2) \) for \( 0 \leq t \leq 1 \)","\( \gamma_B(t)=(t,t^2) \) for \( -1 \leq t \leq 1 \)","\( \gamma_C(t)=(t^2,t^4) \) for \( 0 \leq t \leq 1 \)","\( \gamma_D(t)=(t^2,t^4) \) for \( -1 \leq t \leq 0 \)","\( \gamma_E(t)=(t^2,t^4) \) for \( -1 \leq t \leq 1 \)");

## Question J1 1.3
$mc3 = new_checkbox_multiple_choice();

$mc3 -> qa (
"Which of these maps are simple?", 
"\( \gamma_A(t)=(t,t^2) \) for \( 0 \leq t \leq 1 \)", 
"\( \gamma_B(t)=(t,t^2) \) for \( -1 \leq t \leq 1 \)",
"\( \gamma_C(t)=(t^2,t^4) \) for \( 0 \leq t \leq 1 \)",
"\( \gamma_D(t)=(t^2,t^4) \) for \( -1 \leq t \leq 0 \)"
);

$mc3->makeLast("\( \gamma_A(t)=(t,t^2) \) for \( 0 \leq t \leq 1 \)","\( \gamma_B(t)=(t,t^2) \) for \( -1 \leq t \leq 1 \)","\( \gamma_C(t)=(t^2,t^4) \) for \( 0 \leq t \leq 1 \)","\( \gamma_D(t)=(t^2,t^4) \) for \( -1 \leq t \leq 0 \)","\( \gamma_E(t)=(t^2,t^4) \) for \( -1 \leq t \leq 1 \)");

## Question J1 1.4
$mc4 = new_checkbox_multiple_choice();

$mc4 -> qa (
"Which of these maps are closed?.", 
"\( \gamma_E(t)=(t^2,t^4) \) for \( -1 \leq t \leq 1 \)"
);

$mc4->makeLast("\( \gamma_A(t)=(t,t^2) \) for \( 0 \leq t \leq 1 \)","\( \gamma_B(t)=(t,t^2) \) for \( -1 \leq t \leq 1 \)","\( \gamma_C(t)=(t^2,t^4) \) for \( 0 \leq t \leq 1 \)","\( \gamma_D(t)=(t^2,t^4) \) for \( -1 \leq t \leq 0 \)","\( \gamma_E(t)=(t^2,t^4) \) for \( -1 \leq t \leq 1 \)");
###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
Let \( S= \lbrace (x,y) \in \mathbb{R}^2: y=x^2, 0 \leq x \leq 1 \rbrace  \) . Define the following five maps. $BR

\(\bullet \gamma_A(t)=(t,t^2) \) for \( 0 \leq t \leq 1 \) $BR

\(\bullet \gamma_B(t)=(t,t^2) \) for \( -1 \leq t \leq 1 \) $BR

\(\bullet \gamma_C(t)=(t^2,t^4) \) for \( 0 \leq t \leq 1 \) $BR

\(\bullet \gamma_D(t)=(t^2,t^4) \) for \( -1 \leq t \leq 0 \) $BR

\(\bullet \gamma_E(t)=(t^2,t^4) \) for \( -1 \leq t \leq 1 \) $BR

$BR
$BR
1. \{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}
$BR
2. \{ $mc2 -> print_q() \}
\{ $mc2 -> print_a() \}
$BR
3. \{ $mc3 -> print_q() \}
\{ $mc3 -> print_a() \}
$BR
4. \{ $mc4 -> print_q() \}
\{ $mc4 -> print_a() \}
END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );
ANS( checkbox_cmp( $mc3->correct_ans() ) );
ANS( checkbox_cmp( $mc4->correct_ans() ) );


############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
1. The correct answer is \{ $mc1->correct_ans() \} $BR
2. The correct answers are \{ $mc2->correct_ans() \} $BR
3. The correct answers are \{ $mc3->correct_ans() \} $BR
4. The correct answers are \{ $mc4->correct_ans() \} $BR
END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT();