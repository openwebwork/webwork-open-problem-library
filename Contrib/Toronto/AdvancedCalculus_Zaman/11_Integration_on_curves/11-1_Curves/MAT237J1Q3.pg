##DESCRIPTION
## MAT237 J1 Q3
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','line integrals')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Parametrized curves')
## Institution('University of Toronto')
## Section1('J1')
## Problem1('3')


###########################
#  Initialization

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserRadioButtons.pl",
  "PGML.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup

Context("Numeric");
##J1 Q3.1
$radio1 = RadioButtons(
  ["Yes","No"],
  "No", # correct answer
  last => ["No"], # can be a list
);

##J1 Q3.2
$radio2 = RadioButtons(
  ["Yes","No"],
  "Yes", # correct answer
  last => ["No"], # can be a list
);


###########################
#  Main text

BEGIN_TEXT
Define \( \gamma:[-1,1] \to \mathbb{R}^2 \) by \( \gamma(t)=(t^3,t^3) \). Define the set \( C=\gamma([-1,1]) \subseteq \mathbb{R}^2 \). $BR

Is \(\gamma\) a simple regular parametrization of \( C \)?
END_TEXT

BEGIN_PGML
[@ $radio1->buttons() @]*
END_PGML

BEGIN_TEXT
Is \( C \) a curve?
END_TEXT

BEGIN_PGML
[@ $radio2->buttons() @]*
END_PGML

############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio1->cmp() );
ANS( $radio2->cmp() );


############################
#  Solution

BEGIN_PGML_SOLUTION
The correct answer is [$radio1->correct_ans()]. 

The correct answer is [$radio2->correct_ans()]. 
END_PGML_SOLUTION

COMMENT('MathObject version. Uses PGML.');

ENDDOCUMENT();