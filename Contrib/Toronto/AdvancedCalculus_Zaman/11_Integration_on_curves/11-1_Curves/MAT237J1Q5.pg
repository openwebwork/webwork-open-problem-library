##DESCRIPTION
## MAT237 J1 Q5
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','line integrals')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Parametrized curves')
## Institution('University of Toronto')
## Section1('J1')
## Problem1('5')



###########################
#  Initialization

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserRadioButtons.pl",
  "PGML.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup

Context("Numeric");
##J1 Q5.1
$radio1 = RadioButtons(
  ["True","False"],
  "True", # correct answer
  last => ["False"], # can be a list
);

##J1 Q5.2
$radio2 = RadioButtons(
  ["True","False"],
  "True", # correct answer
  last => ["False"], # can be a list
);

##J1 Q5.3
$radio3 = RadioButtons(
  ["True","False"],
  "False", # correct answer
  last => ["False"], # can be a list
);

##J1 Q5.4
$radio4 = RadioButtons(
  ["True","False"],
  "True", # correct answer
  last => ["False"], # can be a list
);

##J1 Q5.5
$radio5 = RadioButtons(
  ["True","False"],
  "False", # correct answer
  last => ["False"], # can be a list
);

##J1 Q5.6
$radio6 = RadioButtons(
  ["True","False"],
  "False", # correct answer
  last => ["False"], # can be a list
);


###########################
#  Main text

BEGIN_TEXT
Let \( C \subseteq \mathbb{R}^n \). Determine which of the following are true or false. $BR

1. If there exists a simple regular parametrization of \( C \), then \( C \) is a curve.
END_TEXT

BEGIN_PGML
[@ $radio1->buttons() @]*
END_PGML

BEGIN_TEXT
2. If \( C \) is a curve, then \( C \) is a piecewise curve
END_TEXT

BEGIN_PGML
[@ $radio2->buttons() @]*
END_PGML

BEGIN_TEXT
3. If \( C \) is a piecewise curve, then \( C \) is a curve.
END_TEXT

BEGIN_PGML
[@ $radio3->buttons() @]*
END_PGML

BEGIN_TEXT
4. If \( C \) is a curve, then \( C \) is compact.
END_TEXT

BEGIN_PGML
[@ $radio4->buttons() @]*
END_PGML

BEGIN_TEXT
5. If \( C \) is a curve, then \( C \) is a 1-dimensional smooth manifold.
END_TEXT

BEGIN_PGML
[@ $radio5->buttons() @]*
END_PGML

BEGIN_TEXT
6. If \( C \) is a 1-dimensional smooth manifold, then \( C \) is a curve.
END_TEXT

BEGIN_PGML
[@ $radio6->buttons() @]*
END_PGML

############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio1->cmp() );
ANS( $radio2->cmp() );
ANS( $radio3->cmp() );
ANS( $radio4->cmp() );
ANS( $radio5->cmp() );
ANS( $radio6->cmp() );


############################
#  Solution

BEGIN_PGML_SOLUTION
1. The correct answer is [$radio1->correct_ans()]. 

2. The correct answer is [$radio2->correct_ans()].

3. The correct answer is [$radio3->correct_ans()]. 

4. The correct answer is [$radio4->correct_ans()]. 

5. The correct answer is [$radio5->correct_ans()]. 

6. The correct answer is [$radio6->correct_ans()]. 
END_PGML_SOLUTION

COMMENT('MathObject version. Uses PGML.');

ENDDOCUMENT();