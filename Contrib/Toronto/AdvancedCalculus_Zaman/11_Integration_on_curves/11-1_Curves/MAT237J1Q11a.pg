###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup


## Question J1 11.1 a)
$mc1 = new_checkbox_multiple_choice();

$mc1 -> qa (
"Which of these maps are parametrizations of  
\( S \)?", 
"\( \gamma_A(t)=(\cos t, \sin t) \) for \( 0 \leq t \leq 2\pi \)",
"\( \gamma_B(t)=(\cos (t^2),\sin (t^2)) \) for \( 0 \leq t \leq 2\pi \)",
"\( \gamma_C(t)=(\cos (2t),\sin (2t)) \) for \( 0 \leq t \leq \pi  \)",
"\( \gamma_D(t)=(\sin t,\cos t) \) for \(  0 \leq t \leq 2\pi \)",
"\( \gamma_E(t)=(\sin t,\cos t) \) for \( \frac{\pi}{2} \leq t \leq \frac{5\pi}{2} \)"
);

$mc1->makeLast("\( \gamma_A(t)=(\cos t, \sin t) \) for \( 0 \leq t \leq 2\pi \)","\( \gamma_B(t)=(\cos (t^2),\sin (t^2)) \) for \( 0 \leq t \leq 2\pi \)","\( \gamma_C(t)=(\cos (2t),\sin (2t)) \) for \( 0 \leq t \leq \pi  \)","\( \gamma_D(t)=(\sin t,\cos t) \) for \(  0 \leq t \leq 2\pi \)","\( \gamma_E(t)=(\sin t,\cos t) \) for \( \frac{\pi}{2} \leq t \leq \frac{5\pi}{2} \)");

## Question J1 11.1 b)
$mc2 = new_checkbox_multiple_choice();

$mc2 -> qa (
"Which of these maps are regular?", 
"\( \gamma_A(t)=(\cos t, \sin t) \) for \( 0 \leq t \leq 2\pi \)",
"\( \gamma_B(t)=(\cos (t^2),\sin (t^2)) \) for \( 0 \leq t \leq 2\pi \)",
"\( \gamma_C(t)=(\cos (2t),\sin (2t)) \) for \( 0 \leq t \leq \pi  \)",
"\( \gamma_D(t)=(\sin t,\cos t) \) for \(  0 \leq t \leq 2\pi \)",
"\( \gamma_E(t)=(\sin t,\cos t) \) for \( \frac{\pi}{2} \leq t \leq \frac{5\pi}{2} \)"
);

$mc2->makeLast("\( \gamma_A(t)=(\cos t, \sin t) \) for \( 0 \leq t \leq 2\pi \)","\( \gamma_B(t)=(\cos (t^2),\sin (t^2)) \) for \( 0 \leq t \leq 2\pi \)","\( \gamma_C(t)=(\cos (2t),\sin (2t)) \) for \( 0 \leq t \leq \pi  \)","\( \gamma_D(t)=(\sin t,\cos t) \) for \(  0 \leq t \leq 2\pi \)","\( \gamma_E(t)=(\sin t,\cos t) \) for \( \frac{\pi}{2} \leq t \leq \frac{5\pi}{2} \)");

## Question J1 11.1 c)
$mc3 = new_checkbox_multiple_choice();

$mc3 -> qa (
"Which of these maps are simple?", 
"\( \gamma_A(t)=(\cos t, \sin t) \) for \( 0 \leq t \leq 2\pi \)",
"\( \gamma_C(t)=(\cos (2t),\sin (2t)) \) for \( 0 \leq t \leq \pi  \)",
"\( \gamma_D(t)=(\sin t,\cos t) \) for \(  0 \leq t \leq 2\pi \)",
"\( \gamma_E(t)=(\sin t,\cos t) \) for \( \frac{\pi}{2} \leq t \leq \frac{5\pi}{2} \)"
);

$mc3->makeLast("\( \gamma_A(t)=(\cos t, \sin t) \) for \( 0 \leq t \leq 2\pi \)","\( \gamma_B(t)=(\cos (t^2),\sin (t^2)) \) for \( 0 \leq t \leq 2\pi \)","\( \gamma_C(t)=(\cos (2t),\sin (2t)) \) for \( 0 \leq t \leq \pi  \)","\( \gamma_D(t)=(\sin t,\cos t) \) for \(  0 \leq t \leq 2\pi \)","\( \gamma_E(t)=(\sin t,\cos t) \) for \( \frac{\pi}{2} \leq t \leq \frac{5\pi}{2} \)");

## Question J1 11.1 d)
$mc4 = new_checkbox_multiple_choice();

$mc4 -> qa (
"Which of these maps are closed?.", 
"\( \gamma_A(t)=(\cos t, \sin t) \) for \( 0 \leq t \leq 2\pi \)",
"\( \gamma_C(t)=(\cos (2t),\sin (2t)) \) for \( 0 \leq t \leq \pi  \)",
"\( \gamma_D(t)=(\sin t,\cos t) \) for \(  0 \leq t \leq 2\pi \)",
"\( \gamma_E(t)=(\sin t,\cos t) \) for \( \frac{\pi}{2} \leq t \leq \frac{5\pi}{2} \)"
);

$mc4->makeLast("\( \gamma_A(t)=(\cos t, \sin t) \) for \( 0 \leq t \leq 2\pi \)","\( \gamma_B(t)=(\cos (t^2),\sin (t^2)) \) for \( 0 \leq t \leq 2\pi \)","\( \gamma_C(t)=(\cos (2t),\sin (2t)) \) for \( 0 \leq t \leq \pi  \)","\( \gamma_D(t)=(\sin t,\cos t) \) for \(  0 \leq t \leq 2\pi \)","\( \gamma_E(t)=(\sin t,\cos t) \) for \( \frac{\pi}{2} \leq t \leq \frac{5\pi}{2} \)");
###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
Let \( S= \lbrace  (x,y) \in \mathbb{R}^2: x^2+y^2=1 \rbrace \). Define the following five maps. $BR

\(\bullet \gamma_A(t)=(\cos t, \sin t) \) for \( 0 \leq t \leq 2\pi \) $BR

\(\bullet \gamma_B(t)=(\cos (t^2),\sin (t^2)) \) for \( 0 \leq t \leq 2\pi \) $BR

\(\bullet \gamma_C(t)=(\cos (2t),\sin (2t)) \) for \( 0 \leq t \leq \pi  \) $BR

\(\bullet \gamma_D(t)=(\sin t,\cos t) \) for \(  0 \leq t \leq 2\pi \) $BR

\(\bullet \gamma_E(t)=(\sin t,\cos t) \) for \( \frac{\pi}{2} \leq t \leq \frac{5\pi}{2} \) 

$BR
$BR
\{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}
$BR
\{ $mc2 -> print_q() \}
\{ $mc2 -> print_a() \}
$BR
\{ $mc3 -> print_q() \}
\{ $mc3 -> print_a() \}
$BR
\{ $mc4 -> print_q() \}
\{ $mc4 -> print_a() \}
END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );
ANS( checkbox_cmp( $mc3->correct_ans() ) );
ANS( checkbox_cmp( $mc4->correct_ans() ) );


############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answers are \{ $mc1->correct_ans() \} $BR
The correct answers are \{ $mc2->correct_ans() \} $BR
The correct answers are \{ $mc3->correct_ans() \} $BR
The correct answers are \{ $mc4->correct_ans() \} $BR
END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT();