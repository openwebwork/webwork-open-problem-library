##DESCRIPTION
## MAT237 J1 Q8
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','line integrals')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Parametrized curves')
## Institution('University of Toronto')
## Section1('J1')
## Problem1('8')


###########################
#  Initialization

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserRadioButtons.pl",
  "PGML.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup

Context("Numeric");
##J1 Q5.1
$radio1 = RadioButtons(
  ["Same orientation","Opposite orientation","Not a parametrization"],
  "Same orientation", # correct answer
  last => ["Same orientation","Opposite orientation","Not a parametrization"], # can be a list
);

##J1 Q5.2
$radio2 = RadioButtons(
  ["Same orientation","Opposite orientation","Not a parametrization"],
  "Not a parametrization", # correct answer
  last => ["Same orientation","Opposite orientation","Not a parametrization"], # can be a list
);

##J1 Q5.3
$radio3 = RadioButtons(
  ["Same orientation","Opposite orientation","Not a parametrization"],
  "Same orientation", # correct answer
  last => ["Same orientation","Opposite orientation","Not a parametrization"], # can be a list
);

##J1 Q5.4
$radio4 = RadioButtons(
  ["Same orientation","Opposite orientation","Not a parametrization"],
  "Not a parametrization", # correct answer
  last => ["Same orientation","Opposite orientation","Not a parametrization"], # can be a list
);

##J1 Q5.5
$radio5 = RadioButtons(
  ["Same orientation","Opposite orientation","Not a parametrization"],
  "Opposite orientation", # correct answer
  last => ["Same orientation","Opposite orientation","Not a parametrization"], # can be a list
);


###########################
#  Main text

BEGIN_TEXT
The map \( \gamma(t)=(t,t^2) \) for \( 0 \leq t \leq 2\) parametrizes the path along the parabola from \( (0,0) \) to \( (2,4) \). For each parametrization below, determine if it is a reparametrization of \( \gamma \). If so, determine whether it has the same orientation or opposite orientation. $BR $BR

1. \( \gamma_1(t)=(2t, 4t^2) \) for \( 0 \leq t \leq 1 \)
END_TEXT

BEGIN_PGML
[@ $radio1->buttons() @]*
END_PGML

BEGIN_TEXT
$BR
2. \( \gamma_2(t)=(t, t^2) \) for \( -2 \leq t \leq 0 \)
END_TEXT

BEGIN_PGML
[@ $radio2->buttons() @]*
END_PGML

BEGIN_TEXT
$BR
3. \( \gamma_3(t)=(2-t, (2-t)^2) \) for \( 0 \leq t \leq 2 \)
END_TEXT

BEGIN_PGML
[@ $radio3->buttons() @]*
END_PGML

BEGIN_TEXT
$BR
4. \( \gamma_4(t)=(2\sin t, 4\sin^2 t) \) for \( 0 \leq t \leq \pi \)
END_TEXT

BEGIN_PGML
[@ $radio4->buttons() @]*
END_PGML

BEGIN_TEXT
$BR
5. \( \gamma_1(t)=(2\sin t, 4-4\cos^2 t) \) for \( 0 \leq t \leq \frac{\pi}{2} \)
END_TEXT

BEGIN_PGML
[@ $radio5->buttons() @]*
END_PGML


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio1->cmp() );
ANS( $radio2->cmp() );
ANS( $radio3->cmp() );
ANS( $radio4->cmp() );
ANS( $radio5->cmp() );


############################
#  Solution

BEGIN_PGML_SOLUTION
1. The correct answer is [$radio1->correct_ans()]. 

2. The correct answer is [$radio2->correct_ans()].

3. The correct answer is [$radio3->correct_ans()]. 

4. The correct answer is [$radio4->correct_ans()]. 

5. The correct answer is [$radio5->correct_ans()]. 

END_PGML_SOLUTION

COMMENT('MathObject version. Uses PGML.');

ENDDOCUMENT();