##DESCRIPTION
## MAT237 J2 Q2
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','arc length')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Parametrized curves')
## Institution('University of Toronto')
## Section1('J2')
## Problem1('2')


########################################################################

DOCUMENT();      

loadMacros(
   "PGstandard.pl",     # Standard macros for PG language
   "MathObjects.pl",
   #"source.pl",        # allows code to be displayed on certain sites.
   #"PGcourse.pl",      # Customization file for the course
);

# Print problem number and point value (weight) for the problem
TEXT(beginproblem());

# Show which answers are correct and which ones are incorrect
$showPartialCorrectAnswers = 1;

##############################################################
#
#  Setup
#
#
Context("Numeric");

$q1a = Compute("30"); #J2 Q2.1 a)
$q1b = Compute("10"); #J2 Q2.1 b)
$q1c = Compute("999"); #J2 Q2.1 c)
$q1d = Compute("999"); #J2 Q2.1 d)
$q1e = Compute("9"); #J2 Q2.1 e)
$q1f = Compute("999"); #J2 Q2.1 f)

$q2a = Compute("30"); #J2 Q2.3 a)
$q2b = Compute("2"); #J2 Q2.3 b)
$q2c = Compute("999"); #J2 Q2.3 c)
$q2d = Compute("4"); #J2 Q2.3 d)
$q2e = Compute("1"); #J2 Q2.3 e)
$q2f = Compute("999"); #J2 Q2.3 f)



##############################################################
#
#  Text
#
#

Context()->texStrings;


BEGIN_TEXT
Let \( \gamma : [1,6] : \to \mathbb{R}^3 \) be a parametrization of a curve \( C \subseteq \mathbb{R}^3 \) with arc length parameter \( s(t) = t^2-t. \) $BR

1. If possible, compute the following quantities. Answer 999 for quantities that cannot be computed with the given information $BR

a) \( \ell(\gamma) \)
$BR
\{$q1a->ans_rule\} $BR

b)  \( \int_2^4 ||\gamma'(t)|| dt \) 
$BR
\{$q1b->ans_rule\} $BR

c) \( ||\gamma(4)-\gamma(2)|| \)
$BR
\{$q1c->ans_rule\} $BR

d) \( ||\gamma(4)|| - ||\gamma(2)|| \)
$BR
\{$q1d->ans_rule\} $BR

e) \( ||\gamma'(5)|| \)
$BR
\{$q1e->ans_rule\} $BR

f) \( \gamma'(5) \)
$BR
\{$q1f->ans_rule\} $BR $BR

2. Let \( \phi : [A,B] : \to \mathbb{R}^3 \) be the \( \textbf{arc length} \) reparametrization of \( \gamma \). If possible, compute the following quantities.  Answer 999 for quantities that cannot be computed with the given information $BR

a) \( \ell(\phi) \)
$BR
\{$q2a->ans_rule\} $BR

b)  \(  \int_2^4 ||\phi'(t)|| dt \) 
$BR
\{$q2b->ans_rule\} $BR

c) \( ||\phi(4)-\phi(2)|| \)
$BR
\{$q2c->ans_rule\} $BR

d) \( \int_{10}^{14} ||\phi'(t)|| dt \)
$BR
\{$q2d->ans_rule\} $BR

e) \( ||\phi'(5)|| \)
$BR
\{$q2e->ans_rule\} $BR

f) \(\phi'(5)\)
$BR
\{$q2f->ans_rule\} $BR


END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

ANS($q1a->with(tolerance=>.01)->cmp);
ANS($q1b->with(tolerance=>.01)->cmp);
ANS($q1c->with(tolerance=>.01)->cmp);
ANS($q1d->with(tolerance=>.01)->cmp);
ANS($q1e->with(tolerance=>.01)->cmp);
ANS($q1f->with(tolerance=>.01)->cmp);

ANS($q2a->with(tolerance=>.01)->cmp);
ANS($q2b->with(tolerance=>.01)->cmp);
ANS($q2c->with(tolerance=>.01)->cmp);
ANS($q2d->with(tolerance=>.01)->cmp);
ANS($q2e->with(tolerance=>.01)->cmp);
ANS($q2f->with(tolerance=>.01)->cmp);


# default tolerance is .01 or one percent.


ENDDOCUMENT();  