##DESCRIPTION
## MAT237 J2 Q1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','arc length')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Parametrized curves')
