## Problem1('1')

###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup


## Question J2 1.1
$mc1 = new_checkbox_multiple_choice();

$mc1 -> qa (
"The position of the particle at time 
\( t \).", 
"\( \gamma(t) \)",               
);

$mc1->makeLast("\( ||\gamma(t)|| \)","\( \gamma'(t)  \)","\( ||\gamma'(t)|| \)","\( \int_a^b ||\gamma'(t)|| dt\)","\(  \int_a^t ||\gamma'(u)|| du \)","\( s(t) \)","\( s'(t) \)","\( s(b) \)");

## Question J2 1.2
$mc2 = new_checkbox_multiple_choice();

$mc2 -> qa (
"The speed of the particle at time
\( t \).", 
"\( ||\gamma'(t)|| \)", 
"\( s'(t) \)"
);

$mc2->makeLast("\(\gamma(t) \)","\( ||\gamma(t)|| \)","\( \gamma'(t)  \)","\( ||\gamma'(t)|| \)","\( \int_a^b ||\gamma'(t)|| dt\)","\(  \int_a^t ||\gamma'(u)|| du \)","\( s(t) \)","\( s'(t) \)","\( s(b) \)");

## Question J2 1.3
$mc3 = new_checkbox_multiple_choice();

$mc3 -> qa (
"The total distance travelled by the particle.", 
"\( \int_a^b ||\gamma'(t)|| dt\)", 
"\( s(b) \)"
);

$mc3->makeLast("\(\gamma(t) \)","\( ||\gamma(t)|| \)","\( \gamma'(t)  \)","\( ||\gamma'(t)|| \)","\( \int_a^b ||\gamma'(t)|| dt\)","\(  \int_a^t ||\gamma'(u)|| du \)","\( s(t) \)","\( s'(t) \)","\( s(b) \)");

## Question J2 1.4
$mc4 = new_checkbox_multiple_choice();

$mc4 -> qa (
"The distance travelled by the particle by time
\( t \).", 
"\(  \int_a^t ||\gamma'(u)|| du \)", 
"\( s(t) \)"
);

$mc4->makeLast("\(\gamma(t) \)","\( ||\gamma(t)|| \)","\( \gamma'(t)  \)","\( ||\gamma'(t)|| \)","\( \int_a^b ||\gamma'(t)|| dt\)","\(  \int_a^t ||\gamma'(u)|| du \)","\( s(t) \)","\( s'(t) \)","\( s(b) \)");
###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT
Let \( \gamma: [a,b] \to \mathbb{R}^n \) be a parametrization of a curve \( C \subseteq \mathbb{R}^n \). Let \( s: [a,b] \to [0, \infty) \) be the arc length parameter of \( \gamma \). Consider the following algebraic expressions. 
\[ \gamma(t) \qquad ||\gamma(t)|| \qquad \gamma'(t) \qquad ||\gamma'(t)|| \qquad \int_a^b ||\gamma'(t)|| dt \qquad \int_a^t ||\gamma'(u)|| du \qquad s(t) \qquad s'(t) \qquad s(b) \]
You can view \( \gamma \) as the motion of a particle along the path \( C \), so you can interpret each expression above physically. For each physical description below, match the corresponding expression(s) above.

$BR
$BR
1. \{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}
$BR
2. \{ $mc2 -> print_q() \}
\{ $mc2 -> print_a() \}
$BR
3. \{ $mc3 -> print_q() \}
\{ $mc3 -> print_a() \}
$BR
4. \{ $mc4 -> print_q() \}
\{ $mc4 -> print_a() \}
END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );
ANS( checkbox_cmp( $mc3->correct_ans() ) );
ANS( checkbox_cmp( $mc4->correct_ans() ) );


############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
1. The correct answers are \{ $mc1->correct_ans() \} $BR
2. The correct answers are \{ $mc2->correct_ans() \} $BR
3. The correct answers are \{ $mc3->correct_ans() \} $BR
4. The correct answers are \{ $mc4->correct_ans() \} $BR
END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT();