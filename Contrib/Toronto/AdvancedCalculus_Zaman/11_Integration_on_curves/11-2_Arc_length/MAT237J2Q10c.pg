$showPartialCorrectAnswers = 1;

##############################################################
#
#  Setup
#
#
Context("Numeric");

$q1 = Compute("9(pi^2)sqrt(17)/8"); #J2 Q10.3



##############################################################
#
#  Text
#
#

Context()->texStrings;
BEGIN_TEXT
Find the mass of the spiral coil \( C \) parametrized by \( \gamma(t) = (\cos t, t/4, \sin t) \) for \( 0 \leq t \leq 6\pi \) with density \( \rho(x,y,z) = x+y. \) Setup your integral and evaluate it with WolframAlpha. You may give an exact answer or round to two decimal places.
$BR
\{ image( "j2-spiral.png", width=>231, height=>174 ) \} $BR
\{$q1->ans_rule\} $BR




END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

ANS($q1->with(tolerance=>.001)->cmp);


# default tolerance is .01 or one percent.


ENDDOCUMENT(); 