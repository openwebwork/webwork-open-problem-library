##DESCRIPTION
## MAT237 J2 Q9
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','arc length')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Parametrized curves')
## Institution('University of Toronto')
## Section1('J2')
## Problem1('9')

###########################
#  Initialization

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserRadioButtons.pl",
  "PGML.pl",
  "PGcourse.pl",
);

TEXT(beginproblem());


###########################
#  Setup

Context("Numeric");
##J2 Q9.1
$radio1 = RadioButtons(
  [ "\[ \sup_{t \in [a,b]} f(\gamma(t)) \]", "\[ \frac{\int_a^b f(\gamma(t))\|\gamma'(t)\| dt}{\int_a^b \|\gamma'(t)\| dt} \]","\[ \int_a^b \|\gamma'(t)\| dt \]", "\[ \int_a^b f(\gamma(t))\|\gamma'(t)\| dt \]"],
  "\[ \int_a^b \|\gamma'(t)\| dt \]", # correct answer
);

##J2 Q9.2
$radio2 = RadioButtons(
  [ "\[ \sup_{t \in [a,b]} f(\gamma(t)) \]", "\[ \frac{\int_a^b f(\gamma(t))\|\gamma'(t)\| dt}{\int_a^b \|\gamma'(t)\| dt} \]", "\[ \int_a^b \|\gamma'(t)\| dt \]", "\[ \int_a^b f(\gamma(t))\|\gamma'(t)\| dt \]"],
  "\[ \int_a^b f(\gamma(t))\|\gamma'(t)\| dt \]", # correct answer
);

##J2 Q9.3
$radio3 = RadioButtons(
  ["\[ \sup_{t \in [a,b]} f(\gamma(t)) \]", "\[ \frac{\int_a^b f(\gamma(t))\|\gamma'(t)\| dt}{\int_a^b \|\gamma'(t)\| dt} \]", "\[ \int_a^b \|\gamma'(t)\| dt \]", "\[ \int_a^b f(\gamma(t))\|\gamma'(t)\| dt \]",],
  "\[ \sup_{t \in [a,b]} f(\gamma(t)) \]", # correct answer
);

##J2 Q9.4
$radio4 = RadioButtons(
  [ "\[ \sup_{t \in [a,b]} f(\gamma(t)) \]", "\[ \frac{\int_a^b f(\gamma(t))\|\gamma'(t)\| dt}{\int_a^b \|\gamma'(t)\| dt} \]", "\[ \int_a^b \|\gamma'(t)\| dt \]", "\[ \int_a^b f(\gamma(t))\|\gamma'(t)\| dt \]"],
  "\[ \frac{\int_a^b f(\gamma(t))\|\gamma'(t)\| dt}{\int_a^b \|\gamma'(t)\| dt} \]", # correct answer
);



###########################
#  Main text

BEGIN_TEXT
A fence is laid along a curve \( C \subseteq \mathbb{R}^2 \) parametrized by \( \gamma : [a,b] \to \mathbb{R}^2. \) The height of the fence varies along the curve, so it is described by a continuous function \( f : C \to [0,\infty). \) $BR
\{ image( "j2-fence.png", width=>224, height=>196) \}
$BR
Use these quantities to write a formal mathematical expression for each physical quantity.
$BR $BR

1. What is the length of the fence?
END_TEXT

BEGIN_PGML
[@ $radio1->buttons() @]*
END_PGML

BEGIN_TEXT
$BR
2.  What is the area of the fence?
END_TEXT

BEGIN_PGML
[@ $radio2->buttons() @]*
END_PGML

BEGIN_TEXT
$BR
3. What is the maximum height of the fence?
END_TEXT

BEGIN_PGML
[@ $radio3->buttons() @]*
END_PGML

BEGIN_TEXT
$BR
4. What is the average height of the fence?
END_TEXT

BEGIN_PGML
[@ $radio4->buttons() @]*
END_PGML



############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio1->cmp() );
ANS( $radio2->cmp() );
ANS( $radio3->cmp() );
ANS( $radio4->cmp() );



############################
#  Solution

BEGIN_PGML_SOLUTION
1. The correct answer is [$radio1->correct_ans()]. 

2. The correct answer is [$radio2->correct_ans()].

3. The correct answer is [$radio3->correct_ans()]. 

4. The correct answer is [$radio4->correct_ans()]. 


END_PGML_SOLUTION

COMMENT('MathObject version. Uses PGML.');

ENDDOCUMENT();