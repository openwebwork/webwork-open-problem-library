##DESCRIPTION
## MAT237 J2 Q4
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','arc length')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Parametrized curves')
## Institution('University of Toronto')
## Section1('J2')
## Problem1('4')


########################################################################

DOCUMENT();      

loadMacros(
   "PGstandard.pl",     # Standard macros for PG language
   "MathObjects.pl",
   #"source.pl",        # allows code to be displayed on certain sites.
   #"PGcourse.pl",      # Customization file for the course
);

# Print problem number and point value (weight) for the problem
TEXT(beginproblem());

# Show which answers are correct and which ones are incorrect
$showPartialCorrectAnswers = 1;

##############################################################
#
#  Setup
#
#
Context("Numeric");

$q1 = Compute("125.68"); #J2 Q2.1 a)
$q2 = Compute("9.69"); #J2 Q2.1 b)
$q3 = Compute("497.77"); #J2 Q2.1 c)


##############################################################
#
#  Text
#
#

Context()->texStrings;
BEGIN_TEXT
Express the arc length of the curve as an integral. Evaluate it using WolframAlpha and round your answer to two decimal places. $BR

1. The curve \( y=x^3 \) from \( x=0 \) to \( x=5 \). $BR

\{$q1->ans_rule\} $BR

2. The perimeter of the ellipse \( \frac{x^2}{4} + y^2 = 1 \).
$BR
\{$q2->ans_rule\} $BR

3. The helix \( \gamma(t) = (t \cos t, t\sin t, t) \) for \( 0 \leq t \leq 10\pi. \)
$BR
\{$q3->ans_rule\} $BR




END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

ANS($q1->with(tolerance=>.0001)->cmp);
ANS($q2->with(tolerance=>.005)->cmp);
ANS($q3->with(tolerance=>.0001)->cmp);


# default tolerance is .01 or one percent.


ENDDOCUMENT();        