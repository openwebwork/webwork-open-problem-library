##DESCRIPTION
## MAT237 J5 Q12
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','line integrals')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Conservative vector fields')
## Institution('University of Toronto')
## Section1('J5')
## Problem1('12')



###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup


## Question J5 12 a)
$mc1 = new_checkbox_multiple_choice();

$mc1 -> qa (
"Which of these vector fields are irrotational?", 
"\( F(x,y,z) = \nabla (xyz) \)",
"\( F(x,y,z) = \nabla \ln(xyz) \)",
"\( F : \mathbb{R}^3 \to \mathbb{R}^3 \) where \( \text{curl}(F) = (0,0,0) \) ",
"\( F : U \to \mathbb{R}^3 \) where \( \text{curl}(F) = (0,0,0) \) and \( U = \lbrace (x,y,z) \in \mathbb{R}^3 : x > 0, y > 0, z > 0 \rbrace \)"
);

$mc1->makeLast("\( F(x,y,z) = \nabla (xyz) \)",
"\( F(x,y,z) = \nabla \ln(xyz) \)",
"\( F : \mathbb{R}^3 \to \mathbb{R}^3 \) where \( \text{curl}(F) = (2,3,7) \)",
"\( F : \mathbb{R}^3 \to \mathbb{R}^3 \) where \( \text{curl}(F) = (0,0,0) \) ",
"\( F : U \to \mathbb{R}^3 \) where \( \text{curl}(F) = (0,0,0) \) and \( U = \lbrace (x,y,z) \in \mathbb{R}^3 : x > 0, y > 0, z > 0 \rbrace \)",
"None of the above");

## Question J5 12 a)
$mc2 = new_checkbox_multiple_choice();

$mc2 -> qa (
"Which of these vector fields are irrotational?",
"\( F : U \to \mathbb{R}^3 \) where \( \text{curl}(F) = (0,0,0) \) and \( U = \mathbb{R}^3 \setminus \text{span}\lbrace (0,0,1) \rbrace \)",
"\( F(x,y,z) = (x,y,z) \)",
"\( F(x,y,z) = \Big( \dfrac{1}{x}, \dfrac{1}{y}, \dfrac{1}{z} \Big) \)",
);

$mc2->makeLast("\( F : U \to \mathbb{R}^3 \) where \( \text{curl}(F) = (0,0,0) \) and \( U = \mathbb{R}^3 \setminus \text{span}\lbrace (0,0,1) \rbrace \)",
"\( F(x,y,z) = (x,y,z) \)",
"\( F(x,y,z) = (z,x,y) \)",
"\( F(x,y,z) = \Big( \dfrac{1}{x}, \dfrac{1}{y}, \dfrac{1}{z} \Big) \)",
"\( F(x,y,z) = \Big( \dfrac{1}{x}, \dfrac{1}{y}, \dfrac{1}{xy} \Big) \)",
"None of the above");

## Question J5 12 b)
$mc3 = new_checkbox_multiple_choice();

$mc3 -> qa (
"Which of these vector fields can you apply Poincare's lemma to conclude it is conservative?",
"\( F(x,y,z) = \nabla (xyz) \)",
"\( F : \mathbb{R}^3 \to \mathbb{R}^3 \) where \( \text{curl}(F) = (0,0,0) \) ",
"\( F : U \to \mathbb{R}^3 \) where \( \text{curl}(F) = (0,0,0) \) and \( U = \lbrace (x,y,z) \in \mathbb{R}^3 : x > 0, y > 0, z > 0 \rbrace \)"
);

$mc3->makeLast("\( F(x,y,z) = \nabla (xyz) \)",
"\( F(x,y,z) = \nabla \ln(xyz) \)",
"\( F : \mathbb{R}^3 \to \mathbb{R}^3 \) where \( \text{curl}(F) = (2,3,7) \)",
"\( F : \mathbb{R}^3 \to \mathbb{R}^3 \) where \( \text{curl}(F) = (0,0,0) \) ",
"\( F : U \to \mathbb{R}^3 \) where \( \text{curl}(F) = (0,0,0) \) and \( U = \lbrace (x,y,z) \in \mathbb{R}^3 : x > 0, y > 0, z > 0 \rbrace \)",
"None of the above");

## Question J5 12 b)
$mc4 = new_checkbox_multiple_choice();

$mc4 -> qa (
"Which of these vector fields can you apply Poincare's lemma to conclude it is conservative?",
"\( F(x,y,z) = (x,y,z) \)"
);

$mc4->makeLast("\( F : U \to \mathbb{R}^3 \) where \( \text{curl}(F) = (0,0,0) \) and \( U = \mathbb{R}^3 \setminus \text{span}\lbrace (0,0,1) \rbrace \)",
"\( F(x,y,z) = (x,y,z) \)",
"\( F(x,y,z) = (z,x,y) \)",
"\( F(x,y,z) = \Big( \dfrac{1}{x}, \dfrac{1}{y}, \dfrac{1}{z} \Big) \)",
"\( F(x,y,z) = \Big( \dfrac{1}{x}, \dfrac{1}{y}, \dfrac{1}{xy} \Big) \)",
"None of the above");
###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT

$BR
1. \{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}
$BR
2.  \{ $mc2 -> print_q() \}
\{ $mc2 -> print_a() \}
$BR
3. \{ $mc3 -> print_q() \}
\{ $mc3 -> print_a() \}
$BR
4.  \{ $mc4 -> print_q() \}
\{ $mc4 -> print_a() \}

END_TEXT




Context()->normalStrings;





############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );
ANS( checkbox_cmp( $mc3->correct_ans() ) );
ANS( checkbox_cmp( $mc4->correct_ans() ) );



############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answer is \{ $mc1->correct_ans() \} $BR
The correct answers are \{ $mc2->correct_ans() \} $BR

END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT(); 