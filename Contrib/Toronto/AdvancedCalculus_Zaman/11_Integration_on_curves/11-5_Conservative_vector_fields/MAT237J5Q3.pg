##DESCRIPTION
## MAT237 J5 Q3
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','line integrals')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Conservative vector fields')
## Institution('University of Toronto')
## Section1('J5')
## Problem1('3')


###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup


## Question J5 Q3
$mc1 = new_checkbox_multiple_choice();
$mc1 -> qa (
"Which of these physical situations illustrate examples of a conservative vector field? Hint: Think about work done on a closed curve.", 
"A steady flow of lava.", 
"The gravitational force field of the Earth."
);
$mc1->extra("A whirlpool.");

###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT

$BR
$BR
\{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}
END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );



############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answers are \{ $mc1->correct_ans() \} $BR

END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT();    