## Problem1('1')


###########################
#  Initialization

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserRadioButtons.pl",
  "PGML.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup

Context("Numeric");
##J5 Q1

$radio1 = RadioButtons(
  ["Yes","No"],
  "No", # correct answer
  last => ["Yes","No"], # can be a list
);



###########################
#  Main text

BEGIN_TEXT
The oriented curves \( C_1 \) and \( C_2 \) both start at \( P \) and end at \( Q. \) Is the vector field below conservative? $BR

\{ image( "j5-path-independence.png", width=>200, height=>200 ) \} $BR
END_TEXT

BEGIN_PGML
[@ $radio1->buttons() @]*
END_PGML




############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio1->cmp() );


############################
#  Solution

BEGIN_PGML_SOLUTION
The correct answer is [$radio1->correct_ans()]. 


END_PGML_SOLUTION

COMMENT('MathObject version. Uses PGML.');

ENDDOCUMENT();