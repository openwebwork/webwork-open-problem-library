##DESCRIPTION
## MAT237 J5 Q8
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','line integrals')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Conservative vector fields')
## Institution('University of Toronto')
## Section1('J5')
## Problem1('8')


###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup


## Question J5 Q8
$mc1 = new_checkbox_multiple_choice();
$mc1 -> qa (
"Select the sets in \( \mathbb{R}^2 \) that are simply connected domains. Sketch them to help you guess", 
"\( \lbrace (x, y) \in \mathbb{R}^2 : x^2 + y^2 < 9 \rbrace \)", 
"\( \lbrace (x, y) \in \mathbb{R}^2 : 4 < x^2 + y^2 < 9, y > 0 \rbrace \)",
"\( \lbrace (x, y) \in \mathbb{R}^2 : y > 0 \rbrace \)",
"\( \mathbb{R}^2 \)"
);
$mc1->extra("\( \lbrace (x, y) \in \mathbb{R}^2 : 4 < x^2 + y^2 < 9 \rbrace \)",
"\( \lbrace (x, y) \in \mathbb{R}^2 : 0 < x^2 + y^2 < 9 \rbrace \)",
"\( \lbrace (x, y) \in \mathbb{R}^2 : y \neq 0 \rbrace \)",
"\( \mathbb{R}^2 \setminus \lbrace (0,0) \rbrace \)"
);

###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT

$BR
$BR
\{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}
END_TEXT
Context()->normalStrings;


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );



############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answers are \{ $mc1->correct_ans() \} $BR

END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT(); 