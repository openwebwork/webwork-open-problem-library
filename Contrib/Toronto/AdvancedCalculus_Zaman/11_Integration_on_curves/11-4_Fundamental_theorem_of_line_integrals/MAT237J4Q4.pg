##DESCRIPTION
## MAT237 J4 Q4
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','line integrals')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Line integrals')
## Institution('University of Toronto')
## Section1('J4')
## Problem1('4')

########################################################################

DOCUMENT();      

loadMacros(
   "PGstandard.pl",     # Standard macros for PG language
   "MathObjects.pl",
   #"source.pl",        # allows code to be displayed on certain sites.
   #"PGcourse.pl",      # Customization file for the course
);

# Print problem number and point value (weight) for the problem
TEXT(beginproblem());

# Show which answers are correct and which ones are incorrect
$showPartialCorrectAnswers = 1;

##############################################################
#
#  Setup
#
#
Context("Numeric");

$q1 = Compute("2-e-(1/e)"); #J4 Q4.1
$q2 = Compute("2-e-(1/e)"); #J4 Q4.2
$q3 = Compute("2-e-(1/e)"); #J4 Q4.3
$q4 = Compute("0"); #J4 Q4.4
$q5 = Compute("0"); #J4 Q4.5
$q6 = Compute("0"); #J4 Q4.6



##############################################################
#
#  Text
#
#

Context()->texStrings;
BEGIN_TEXT
Let \( f(x,y) = x^3-ye^x. \) For each of the curves \( C \) below, compute \[ \int_C \nabla f\cdot d\gamma.\] 

$BR
1. \{ image("j4-different-endpoints-1.png", width=>190, height=>150 ) \} $BR
\{$q1->ans_rule\} $BR $BR

2. \{ image( "j4-different-endpoints-2.png", width=>190, height=>150 ) \} $BR
\{$q2->ans_rule\} $BR $BR

3. \{ image( "j4-different-endpoints-3.png", width=>190, height=>150 ) \} $BR
\{$q3->ans_rule\} $BR $BR

4. \{ image( "j4-same-endpoints-1.png", width=>190, height=>150 ) \} $BR
\{$q4->ans_rule\} $BR $BR

5. \{ image( "j4-same-endpoints-2.png", width=>190, height=>150 ) \} $BR
\{$q5->ans_rule\} $BR $BR

6. \{ image( "j4-same-endpoints-3.png", width=>190, height=>150 ) \} $BR
\{$q6->ans_rule\} $BR $BR


END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

ANS($q1->with(tolerance=>.01)->cmp);
ANS($q2->with(tolerance=>.01)->cmp);
ANS($q3->with(tolerance=>.01)->cmp);
ANS($q4->with(tolerance=>.01)->cmp);
ANS($q5->with(tolerance=>.01)->cmp);
ANS($q6->with(tolerance=>.01)->cmp);


# default tolerance is .01 or one percent.


ENDDOCUMENT();       