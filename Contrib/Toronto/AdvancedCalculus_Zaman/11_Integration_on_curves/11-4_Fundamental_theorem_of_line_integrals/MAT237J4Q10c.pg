##DESCRIPTION
## MAT237 J4 Q10.3
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','line integrals')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Line integrals')
## Institution('University of Toronto')
## Section1('J4')
## Problem1('10.3')


###########################
#  Initialization

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserRadioButtons.pl",
  "PGML.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup

Context("Numeric");
##J4 Q10.3 a)
$radio1 = RadioButtons(
  ["Irrotational","Not irrotational"],
  "Irrotational", # correct answer
  last => ["Not irrotational"], # can be a list
);

##J4 Q10.3 b)
$radio2 = RadioButtons(
   ["Irrotational","Not irrotational"],
  "Not irrotational", # correct answer
  last => ["Not irrotational"], # can be a list
);

##J4 Q10.3 c)
$radio3 = RadioButtons(
   ["Irrotational","Not irrotational"],
  "Irrotational", # correct answer
  last => ["Not irrotational"], # can be a list
);

##J4 Q10.3 d)
$radio4 = RadioButtons(
  ["Irrotational","Not irrotational"],
  "Irrotational", # correct answer
  last => ["Not irrotational"], # can be a list
);



###########################
#  Main text

BEGIN_TEXT
For each vector field, determine if it is irrotational.

$BR

a) \( F(x,y)=(y,x) \)
END_TEXT

BEGIN_PGML
[@ $radio1->buttons() @]*
END_PGML

BEGIN_TEXT
b) \( G(x,y)=(-y,x) \)
END_TEXT

BEGIN_PGML
[@ $radio2->buttons() @]*
END_PGML

BEGIN_TEXT
c) \( H(x,y)=(1+y,x+ \cos y) \)
END_TEXT

BEGIN_PGML
[@ $radio3->buttons() @]*
END_PGML

BEGIN_TEXT
d) \( J(x,y,z)=(yz^2,xz^2,2xy) \)
END_TEXT

BEGIN_PGML
[@ $radio4->buttons() @]*
END_PGML


############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( $radio1->cmp() );
ANS( $radio2->cmp() );
ANS( $radio3->cmp() );
ANS( $radio4->cmp() );


############################
#  Solution

BEGIN_PGML_SOLUTION
The correct answer is [$radio1->correct_ans()]. 

The correct answer is [$radio2->correct_ans()].

The correct answer is [$radio3->correct_ans()]. 

The correct answer is [$radio4->correct_ans()]. 


END_PGML_SOLUTION

COMMENT('MathObject version. Uses PGML.');

ENDDOCUMENT();