########################################################################

DOCUMENT();      

loadMacros(
   "PGstandard.pl",     # Standard macros for PG language
   "MathObjects.pl",
   #"source.pl",        # allows code to be displayed on certain sites.
   #"PGcourse.pl",      # Customization file for the course
);

# Print problem number and point value (weight) for the problem
TEXT(beginproblem());

# Show which answers are correct and which ones are incorrect
$showPartialCorrectAnswers = 1;

##############################################################
#
#  Setup
#
#
Context("Numeric");

$q1 = Compute("1.58"); #J4 Q10.5 a)
$q2 = Compute("0"); #J4 Q10.5 b)



##############################################################
#
#  Text
#
#

Context()->texStrings;
BEGIN_TEXT
Let \( F(x,y) = (e^x\cos(y), e^x\sin(y)). \) $BR

1. By direct calculation, find the work done by \( F \) along the boundary of the square \( \partial [0,1]^2 \) oriented counterclockwise. Round your answer to two decimal places.
$BR
\{$q1->ans_rule\} $BR

2. Is \( F \) conservative? Type 1 if \( F \) is conservative and type 0 if \( F \) is not conservative.
$BR
\{$q2->ans_rule\} 



END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

ANS($q1->with(tolerance=>.01)->cmp);
ANS($q2->with(tolerance=>.01)->cmp);



# default tolerance is .01 or one percent.


ENDDOCUMENT();        