##DESCRIPTION
## MAT237 J4 Q2
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','line integrals')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Line integrals')
## Institution('University of Toronto')
## Section1('J4')
## Problem1('2')


###########################
#  Initialization

DOCUMENT();  

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());


###########################
#  Setup


## Question J3 1.1
$mc1 = new_checkbox_multiple_choice();

$mc1 -> qa (
"Is Joel's argument correct and well-justified? If not, select the line(s) with errors or lacking justification.", 
"Line 2","Line 3"
);

$mc1->makeLast("Joel's argument is correct and well-justified", "Line 1","Line 2","Line 3","Line 4" );

## Question J3 1.2
$mc2 = new_checkbox_multiple_choice();

$mc2 -> qa (
"Is Ellie's argument correct and well-justified? If not, select the line(s) with errors or lacking justification.", 
"Ellie's argument is correct and well-justified"
);

$mc2->makeLast("Ellie's argument is correct and well-justified", "Line 1","Line 2","Line 3","Line 4","Line 5","Line 6" );

## Question J3 1.3
$mc3 = new_checkbox_multiple_choice();

$mc3 -> qa (
"Is 
Tess's argument correct and well-justified? If not, select the line(s) with errors or lacking justification.", 
"Line 4"
);

$mc3->makeLast("Tess's argument is correct and well-justified ", "Line 1","Line 2","Line 3","Line 4"
);


###########################
#  Main text

Context()->texStrings;
BEGIN_TEXT

Joel, Ellie, and Tess are determining whether the vector field \( F(x,y) = (2x+3y, 3x+5) \) is conservative and,  if so, solve for all potentials. Each of them has a different argument.
$BR
$BR

1. Joel gives the following argument. $BR
\{ image( "j4-q2-joel.png",width=>708, height=>164) \}

$BR
 \{ $mc1 -> print_q() \}
\{ $mc1 -> print_a() \}
$BR
2.  Ellie gives the following argument. $BR
 \{ image( "j4-q2-ellie.png", width=>708, height=>190) \}
$BR
 \{ $mc2 -> print_q() \}
\{ $mc2 -> print_a() \}
$BR
3. Tess gives the following argument. $BR
\{ image( "j4-q2-tess.png", width=>708, height=>90) \}
$BR
 \{ $mc3 -> print_q() \}
\{ $mc3 -> print_a() \}

END_TEXT




Context()->normalStrings;





############################
#  Answer evaluation

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

ANS( checkbox_cmp( $mc1->correct_ans() ) );
ANS( checkbox_cmp( $mc2->correct_ans() ) );
ANS( checkbox_cmp( $mc3->correct_ans() ) );



############################
#  Solution

Context()->texStrings;
BEGIN_SOLUTION
${PAR}SOLUTION:$PAR
The correct answers are \{ $mc1->correct_ans() \} $BR
The correct answers are \{ $mc2->correct_ans() \} $BR
The correct answers are \{ $mc3->correct_ans() \} $BR

END_SOLUTION
Context()->normalStrings;

;

ENDDOCUMENT(); 