##DESCRIPTION
## MAT237 J4 Q1
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus','line integrals')

## DBsubject('Multivariable Calculus')
## DBchapter('Vector calculus')
## DBsection('Line integrals')
## Institution('University of Toronto')
## Section1('J4')
## Problem1('1')


########################################################################

DOCUMENT();      

loadMacros(
   "PGstandard.pl",     # Standard macros for PG language
   "MathObjects.pl",
   #"source.pl",        # allows code to be displayed on certain sites.
   #"PGcourse.pl",      # Customization file for the course
);

# Print problem number and point value (weight) for the problem
TEXT(beginproblem());

# Show which answers are correct and which ones are incorrect
$showPartialCorrectAnswers = 1;

##############################################################
#
#  Setup
#
#
Context("Numeric");

$q1 = Compute("2"); #J4 Q1.1
$q2 = Compute("2"); #J4 Q1.2
$q3 = Compute("2"); #J4 Q1.3



##############################################################
#
#  Text
#
#

Context()->texStrings;
BEGIN_TEXT
Let \( f(x,y)  = x^2+y^2 \) and define \( F = \nabla f \). Consider the three paths. $BR
\{ image( "j4-three-paths.png",width=>557, height=>491 ) \}

 $BR

1. Determine the work done by \( F \) along \( A \), the straight line from \( (0,0) \) to \( (1,1) \).  $BR
\{$q1->ans_rule\}  $BR

2. Determine the work done by \( F \) along \( B \), the parabola \( (t,t^2) \) from \( (0,0) \) to \( (1,1). \)  $BR
\{$q2->ans_rule\}  $BR

3. Determine the work done by \( F \) along \( C, \) the street grid from \( (0,0) \) to \( (1,0) \) to \( (1,1). \)  $BR
\{$q3->ans_rule\}  $BR
END_TEXT
Context()->normalStrings;

##############################################################
#
#  Answers
#
#

ANS($q1->with(tolerance=>.01)->cmp);
ANS($q2->with(tolerance=>.01)->cmp);
ANS($q3->with(tolerance=>.01)->cmp);


# default tolerance is .01 or one percent.


ENDDOCUMENT();   