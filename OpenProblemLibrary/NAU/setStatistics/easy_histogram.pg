##DESCRIPTION
## Interpret a bar graph
##ENDDESCRIPTION
## DBsubject(Statistics)
## DBchapter(Exploratory data analysis/descriptive statistics)
## DBsection(Graphical representations)
## Institution(NAU)
## Author(N.Spencer Sitton)
## Level(3)
## KEYWORDS('histogram')

# File Created: 07/11/05
# Problem Author:
# Location: Northern Arizona University

# UPDATED on 2022.06.30 by Peter Staab, Fitchburg State University
# Graph updated to use PGML, StatisticsPlots.pl and add alt tags
# for accessibility.

DOCUMENT();
loadMacros(
    "PGstandard.pl",       "PGML.pl",
    'StatisticalPlots.pl', 'contextPercent.pl',
    'PGcourse.pl'
);

Context('Percent');

$n   = random(20, 50, 5);
$max = random(29, 44, 5);
push(@list, random(0, $max)) for (0 .. $n - 1);

$name = list_random(
    'Mathematics and Statistics',
    'Chemistry', 'Biology', 'English', 'Economics', 'Public Health',
    'Nursing',   'History', 'Physics'
);
$title    = "$name Faculty";
$num      = random(5, $max - 10, 5);
@dir      = ("$num or more ", " less than $num");
$ind      = random(0, 1);
$num_bins = ($max + 1) / 5;
$bins[$_] = 0 for (0 .. $num_bins - 1);

$num_faculty = 0;
for my $val (@list) {
    if ($val < $num) {
        push @newlist1, $val;
    } else {
        push @newlist2, $val;
    }
    $num_faculty++ if $val >= $num;
    $bins[ floor($val / 5) ]++;
}

$stat_plot = StatPlot(
    xmin            => 0,
    xmax            => 5 * int($max / 5) + 10,
    xtick_delta     => 5,
    xlocation       => 'below',
    xlabel          => 'number of years of service',
    ymin            => 0,
    ymax            => 10,
    ytick_delta     => 1,
    yminor          => 0,
    ylocation       => 'left',
    ylabel          => 'number of faculty',
    show_grid       => 0,
    rounded_corners => 1
);

$counts = $stat_plot->add_histogram(
    ~~@list,
    bins       => ($max + 1) / 5,
    min        => 0,
    max        => $max + 1,
    width      => 1,
    fill_color => 'lightblue'
);

$stat_plot->axes->yaxis(max => max(@$counts) + 1);

# Determine the largest bar as well as create the alternate text

$alttext =
    "A bar graph with number of years on the vertical axis and years of service on the horizontal axis. ";

for my $i (0 .. $num_bins - 1) {
    $alttext .=
        "The bar between "
        . 5 * $i . " and "
        . 5 * ($i + 1)
        . " has height "
        . $bins[$i] . ". ";
}

BEGIN_PGML

The histogram below gives the length of service of members of the
Department of [$name] at a particular
university. The horizontal axis represents years of service in intervals
0 to 4.9, 5 to 9.9, etc., and the vertical axis represents the number of
faculty.

>> [! $alttext !]{$stat_plot}{400} <<

What percent of the department faculty have [$dir[$ind]] years of service?
[_]{Percent($num_faculty/$n)}{5}

END_PGML

BEGIN_PGML_SOLUTION
The total number of faculty will be the sum of the heights of the bars that have [$dir[$ind]] years of service. The total sum is [$num_faculty] in this case. Divide this by the total number of faculty ([$n]) to get the answer of [@ Percent($num_faculty/$n) @].
END_PGML_SOLUTION

ENDDOCUMENT();
