## DESCRIPTION
## Determine the relative placement of the mean and median from a histogram.
## ENDDESCRIPTION
## DBsubject(Statistics)
## DBchapter(Exploratory data analysis/descriptive statistics)
## DBsection(Description of distributions)
## Institution(NAU)
## Author(N.Spencer Sitton)
## Level(3)
## KEYWORDS('histogram')

# File Created: 07/12/05
# Location: Northern Arizona University
# Course: Qauntitative Reasoning

DOCUMENT();
loadMacros(
    'PGstandard.pl',        'PGML.pl',
    'StatisticalPlots.pl',  'parserPopUp.pl',
    'PGnauStats.pl',        'PGcourse.pl'
);

@data = (
    'mean daily temperature in June for a particular city',
    'mean daily temperature in November for a particular city',
    'age of incoming freshmen students at a particular high school',
    'age of graduating high school seniors at a particular high school'
);

@opts = (
    'is less than the median.',
    'is equal to the median.',
    'is greater than the median.',
    'cannot be determined.'
);

$ind = random(0, 3);

if ($ind == 0) {
    @list1 = SpecialData(
        'left',
        count => 30,
        min   => random(86,  91),
        max   => random(100, 105)
    );
    $dx       = 2;
    $dd       = DropDown(~~@opts, 2);
    $xmin     = $list1[$#list1];
    $xmax     = $list1[0];
    $num_bins = int(0.5 * ($xmax - $xmin)) + 1;
    $y_ticks  = [ 5, 10, 15 ];
    $skew     = 'right';
} elsif ($ind == 1) {
    @list1 = SpecialData(
        'right',
        count => 30,
        min   => random(36, 41),
        max   => random(50, 55)
    );
    $dx       = 1;
    $dd       = DropDown(~~@opts, 0);
    $xmin     = $list1[0];
    $xmax     = $list1[$#list1];
    $num_bins = int($xmax - $xmin) + 1;
    $y_ticks  = [ 5, 10, 15 ];
    $skew     = 'left';
} elsif ($ind == 2) {
    @list1    = SpecialData('right', count => 500, min => 14.5, max => 17.5);
    $dx       = 0.5;
    $dd       = DropDown(~~@opts, 0);
    $xmin     = min(@list1);
    $xmax     = max(@list1);
    $y_ticks  = [ 100, 200, 300 ];
    $num_bins = int(2 * ($xmax - $xmin)) + 1;
    $skew     = 'left';
} elsif ($ind == 3) {
    @list1    = SpecialData('left', count => 500, min => 16, max => 19);
    $dx       = 0.5;
    $dd       = DropDown(~~@opts, 2);
    $xmin     = min(@list1);
    $xmax     = max(@list1);
    $y_ticks  = [ 100, 200, 300 ];
    $num_bins = int(2 * ($xmax - $xmin)) + 1;
    $skew     = 'right';
}

$stat_plot = StatPlot(
    xmin            => $xmin - $dx,
    xmax            => $xmax + 2 * $dx,
    xtick_delta     => $dx,
    ylocation       => 'left',
    show_grid       => 0,
    rounded_corners => 1
);

$bins = $stat_plot->add_histogram(
    ~~@list1,
    min          => $xmin,
    max          => $xmax + $dx,
    bins         => 7,
    fill_colors  => ['lightblue'],
    stroke_width => 1,
    bins         => $num_bins
);

$stat_plot->axes->yaxis(
    max            => 5.25 * (ceil(max(@$bins) / 5)),
    min            => -1 * int(max(@$bins) / 5),
    tick_positions => $y_ticks
);

BEGIN_PGML
The Histogram below gives the [$data[$ind]].

>>[!!]{$stat_plot}{400}<<

Based on the given distribution the mean [_]{$dd}.

END_PGML

BEGIN_PGML_SOLUTION
Since the data is skewed to the [$skew], the mean is [$dd].
END_PGML_SOLUTION

ENDDOCUMENT();
