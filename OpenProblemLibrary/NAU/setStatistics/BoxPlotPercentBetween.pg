##DESCRIPTION
## DBsubject(Statistics)
## DBchapter(Exploratory data analysis/descriptive statistics)
## DBsection(Graphical representations)
## Institution(NAU)
## Author(Edgar Fisher)
## Level(2)
## KEYWORDS('boxplot')
##ENDDESCRIPTION

# File Created: 6/14/05
# Location: Northern Arizona University

DOCUMENT();
loadMacros(
    'PGstandard.pl',         'PGML.pl',
    'parserRadioButtons.pl', 'StatisticalPlots.pl',
    'PGcourse.pl'
);

$low   = random(130, 180, 5);
$high  = random(330, 380, 5);
$range = $high - $low;

# @dat will have the five number summary.
push @dat, $low, int random($low + $range / 5, $low + $range / 4),
    int random($low + $range / 3, $high - $range / 3),
    int random($high - $range / 4, $high - $range / 5), $high;

@slice  = num_sort(random_subset(2, 0 .. 3));
$offset = random(0, 1);

$diff = $slice[1] - $slice[0];
$ans  = $diff * 25;

$from = $dat[ $slice[0] + $offset ];
$to   = $dat[ $slice[1] + $offset ];

# pick some other random choices not including the answer
for my $i (0 .. 4) {
    do {
        $rnd = random(5, 95, 5);
    } while ($rnd == $ans || grep {/$rnd/} @other);
    push @other, $rnd;
}

@opts = num_sort(@other[ random_subset(3, 0 .. 4) ], $ans);
my ($index) = grep { $opts[$_] eq $ans } (0 .. @opts - 1);

@opts = map {"$_%"} @opts;

$radio = RadioButtons([ ~~@opts, "None of these" ], $index, labels => 'ABC');

# helpful for the graph

$xmin = floor($low / 50) * 50 - 50;
$xmax = ceil($high / 50) * 50 + 50;

$boxplot = StatPlot(
    xmin            => $xmin,
    xmax            => $xmax,
    xtick_delta     =>  50,
    ymin            => -15,
    ymax            =>  50,
    yvisible        =>  0,
    aspect_ratio    =>  1,
    show_grid       =>  0,
    rounded_corners =>  1,
    xlabel          => ''
);
$boxplot->add_boxplot(
    {
        min    => $dat[0],
        q1     => $dat[1],
        median => $dat[2],
        q3     => $dat[3],
        max    => $dat[4]
    },
    width       => 1,
    fill_color  => 'lightblue',
    whisker_cap => 1
);

$alttext = <<~"END";
    Box and whiskers plot for salaries listed in thousands of
    dollars.  The left whisker is from $dat[0] to $dat[1].  The box is
    between $dat[1] and $dat[3]. The middle line is at $dat[2] and the
    right whisker runs from $dat[3] to $dat[4].
    END

BEGIN_PGML

The boxplot below represents annual salaries of attorneys in
thousands of dollars in Los Angeles.

>>[!!]{$boxplot}{width => 600, long_description => $alttext} <<

About what percentage of the attorneys have salaries between 
$[$from],000 and $[$to],000?

[_]{$radio}

END_PGML

BEGIN_PGML_SOLUTION
Recall that there is 25% of the data between the left whisker and the left edge of the box, 25% between the left edge of the box and the median (line inside the box), then 25% to the right side of the box and 25% to the right end of the right whisker.  

Therefore, looking at the range, the result in [$radio].
END_PGML_SOLUTION

ENDDOCUMENT();
