##DESCRIPTION
## DBsubject(Statistics)
## DBchapter(Exploratory data analysis/descriptive statistics)
## DBsection(Graphical representations)
## Institution(NAU)
## Author(Edgar Fisher)
## Level(2)
## KEYWORDS('boxplot', 'five number summary')
##ENDDESCRIPTION

# File Created: 6/6/05
# Location: Northern Arizona University

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'StatisticalPlots.pl', 'PGcourse.pl',);

@dat = (
    random(15, 30),
    random(35, 43),
    random(45, 70),
    random(72, 85),
    random(89, 100)
);

@slice = num_sort(random_subset(3, 0 .. 4));

@labels = ('Minimum', 'First quartile', 'Median', 'Third quartile', 'Maximum');
@questions = @labels[@slice];

$min    = Compute($dat[ $slice[0] ]);
$median = Compute($dat[ $slice[1] ]);
$max    = Compute($dat[ $slice[2] ]);

$stat_plot = StatPlot(
    xmin            => floor($dat[0] / 10) * 10 - 10,
    xmax            => ceil($dat[4] / 10) * 10 + 10,
    xtick_delta     => 5,
    xlabel          => '',
    ymin            => -1,
    ymax            =>  5,
    yvisible        =>  0,
    aspect_ratio    =>  4,
    show_grid       =>  0,
    rounded_corners =>  1,
);
$stat_plot->add_boxplot(
    {
        min    => $dat[0],
        q1     => $dat[1],
        median => $dat[2],
        q3     => $dat[3],
        max    => $dat[4]
    },
    fill_color  => 'lightblue',
    width       => 1,
    whisker_cap => 1
);

$alttext = <<~"END";
    Box and whiskers plot.  The left whisker is from $dat[0] to $dat[1].
    The box is between $dat[1] and $dat[3]. The middle line is at $dat[2]
    and the right whisker runs from $dat[3] to $dat[4]
END

BEGIN_PGML

Consider the following box and whisker plot.  Find the indicated values of the
represented data.

>> [!!]{$stat_plot}{width => 600, long_description => $alttext} <<

a) [$questions[0]]: [______]{$min}
b) [$questions[1]]: [______]{$median}
c) [$questions[2]]: [______]{$max}

END_PGML

BEGIN_PGML_SOLUTION
Looking at the plot,

a) Minimum is [$min]
b) Median is [$median]
c) Maximum is [$max]
END_PGML_SOLUTION
ENDDOCUMENT();
