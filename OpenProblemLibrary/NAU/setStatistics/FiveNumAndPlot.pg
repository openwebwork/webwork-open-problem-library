##DESCRIPTION
## DBsubject(Statistics)
## DBchapter(Exploratory data analysis/descriptive statistics)
## DBsection(Graphical representations)
## Institution(NAU)
## Author(Edgar Fisher)
## Level(2)
## KEYWORDS('boxplot', 'five number summary')
##ENDDESCRIPTION

# File Created: 6/6/05
# Location: Northern Arizona University

# Basedon(Library/NAU/setStatistics/FiveNumAndPlot.pg)
# edited by Peter Staab, Fitchburg State
# switched to PGML and used tikz graphics

DOCUMENT();
loadMacros(
    'PGstandard.pl',       'PGML.pl',
    'StatisticalPlots.pl', 'parserRadioButtons.pl',
    'PGcourse.pl',
);

DOCUMENT();

Context('Numeric');

$min    = random(15, 30);
$q1     = random(35, 43);
$median = random(45, 70);
$q3     = random(72, 85);
$max    = random(89, 100);

@names = (
    'Min', '\(Q_1\)', 'Median',     '\(Q_3\)',
    'Max', 'Mean',      'Left Pivot', 'Right Pivot'
);
@slice = random_subset(3, 0 .. 4);

$labels[ $slice[0] ] = 'Z';
$labels[ $slice[1] ] = 'Y';
$labels[ $slice[2] ] = 'X';

@dat = ($min, $q1, $median, $q3, $max);

@radios =
    map {
        RadioButtons(
            [@names],
            $names[ $slice[$_] ],
            separator => "$SPACE$SPACE",
            labels    => 'ABC'
        )
    } (0 .. 2);

# helpful for the graph

$xmin   = floor($min / 10) * 10 - 10;
$xmax   = ceil($max / 10) * 10 + 10;
$xmid   = 0.5 * ($xmin + $xmax);
$xmin10 = $xmin + 10;
$xmin20 = $xmin + 20;
$xmax10 = $xmax - 10;

$plot = StatPlot(
    xmin            =>  0,
    xmax            => 110,
    xtick_delta     =>  10,
    ymin            => -10,
    ymax            =>  30,
    yvisible        =>  0,
    show_grid       =>  0,
    rounded_corners =>  1,
    aspect_ratio    => 1
);

$plot->add_boxplot(
    { min => $min, q1 => $q1, median => $median, q3 => $q3, max => $max },
    box_width  => 10,
    box_center => 10,
    width      => 1,
    fill_color => 'lightblue'
);

for (0 .. 2) {
    $plot->add_dataset(
        [ $dat[ $slice[$_] ], 18 ],
        [ $dat[ $slice[$_] ], 20 ],
        width => 1
    );

    $plot->add_label(
        $dat[ $slice[$_] ],
        20,
        $labels[ $slice[$_] ],
        v_align => 'bottom'
    );
}

$alttext =
    "Box and whiskers plot.  The left whisker is from $dat[0] to $dat[1]. "
    . "The box is between $dat[1] and $dat[3]. The middle line is at $dat[2] "
    . "and the right whisker runs from $dat[3] to $dat[4]";

BEGIN_PGML

Consider the following box and whisker plot.  Match the letters with the values.

>> [![$alttext]!]{$plot}{400} <<


1. [$labels[$slice[0]]] [$SPACE]* [_]{$radios[0]}

2. [$labels[$slice[1]]] [$SPACE]* [_]{$radios[1]}

3. [$labels[$slice[2]]] [$SPACE]* [_]{$radios[2]}

END_PGML

BEGIN_PGML_SOLUTION
1. [$radios[0]]
2. [$radios[1]]
3. [$radios[2]]
END_PGML_SOLUTION

ENDDOCUMENT();
