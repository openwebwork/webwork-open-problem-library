##DESCRIPTION
## DBsubject(Statistics)
## DBchapter(Exploratory data analysis/descriptive statistics)
## DBsection(Graphical representations)
## Institution(NAU)
## Author(Ty Thompson)
## Level(4)
## KEYWORDS('boxplot')
##ENDDESCRIPTION

# File Created: 6/02/05
# Location: Northern Arizona University
# BoxPlot calls modified by Nandor
#fixed issues with skewness and changed a bit in the process 1/2013

DOCUMENT();
loadMacros(
    'PGstandard.pl',         'PGML.pl',
    'parserCheckboxList.pl', 'StatisticalPlots.pl',
    'PGcourse.pl'
);

do {
    @low    = ();
    @high   = ();
    @Q1     = ();
    @Q3     = ();
    @mean   = ();
    @mdn    = ();
    @corr   = ();
    @incorr = ();

    #randomly setup the data range
    @dataset = ("D1", "D2", "D3");
    for ($i = 0; $i < 3; $i++) {
        $val = random(12, 50, 2);
        push @low,  $val;
        push @high, random($val + 30, $val + 100, 5);

        $val = ($high[$i] - $low[$i]) / 3;
        push @mean, int random($low[$i] + $val, $high[$i] - $val, 1);
        push @Q1,   int random($low[$i] + 3,    $mean[$i] - 2,    1);
        push @Q3,   int random($mean[$i] + 2,   $high[$i] - 3,    1);

        do {
            $val = int random($Q1[$i] + 1, $Q3[$i] - 1, 0.1);
        } while ($val == $mean[$i]);
        push @mdn, $val;
    }
    $ans6 = random(1, 2, 1);
    if ($ans6 > 1) {
        $mdn[2]  = ($Q3[2] + $Q1[2]) / 2;
        $low[2]  = $Q1[2] - 5;
        $high[2] = $Q3[2] + 5;
    } else {
        $mdn[2]  = $Q1[2] + ($mdn[2] - $Q1[2]) / 2;
        $low[2]  = $Q1[2] - 5;
        $high[2] = $Q3[2] + 20;
    }

####Answers there are 6 possible answers, each might be correct or incorrect ####

    #first answer
    if ($Q1[1] > $mdn[0]) {
        push @corr, "Three quarters of the data values for $dataset[1] "
            . "are greater than the median value for $dataset[0].";
    } else {
        push @incorr, "Three quarters of the data values for $dataset[1] "
            . "are greater than the median value for $dataset[0].";
    }

    #second answer
    if ($Q1[2] < $mdn[1]) {
        push @corr, "At least a quarter of the data values for $dataset[2] "
            . "are less than the median value for $dataset[1].";
    } else {
        push @incorr,
            "At least a quarter of the data values for $dataset[2] "
            . "are less than the median value for $dataset[1].";
    }

    #third answer
    if ($mdn[0] < $mdn[2]) {
        push @corr, "The median value for $dataset[0] "
            . "is less than the median value for $dataset[2].";
    } else {
        push @incorr, "The median value for $dataset[0] "
            . "is less than the median value for $dataset[2].";
    }

    #fourth answer
    if ($Q1[1] < $low[2]) {
        push @corr, "At least a quarter of the data values in $dataset[1] "
            . "are less than all of the data values in $dataset[2].";
    } else {
        push @incorr,
            "At least a quarter of the data values in $dataset[1] "
            . "are less than all of the data values in $dataset[2].";
    }

    #fifth answer
    if ($Q3[0] < $low[1]) {
        push @corr,
            "At least three quarters of the data values in $dataset[0] "
            . "are less than all of the data values in $dataset[1].";
    } else {
        push @incorr,
            "At least three quarters of the data values in $dataset[0] "
            . "are less than all of the data values in $dataset[1].";
    }

    #sixth answer
    if ($ans6 == 1) {
        push @corr, "The data in $dataset[2] is skewed right.";
    } else {
        push @incorr, "The data in $dataset[2] is skewed right.";
    }
} until (scalar(@corr) > 1);

$datamin = $low[0];
for ($i = 1; $i < 3; $i++) {
    if ($low[$i] < $datamin) { $datamin = $low[$i]; }
}

$datamax = $high[0];
for ($i = 1; $i < 3; $i++) {
    if ($high[$i] > $datamax) { $datamax = $high[$i]; }
}

$adj_datamin = $datamin - ($datamax - $datamin) / 2 * 0.1;
$adj_datamax = $datamax + ($datamax - $datamin) / 2 * 0.1;

$graph = StatPlot(
    xmin            => $adj_datamin - 10,
    xmax            => $adj_datamax + 10,
    xtick_delta     => 20,
    xlabel          => '',
    ymin            => -2,
    ymax            => 10,
    yvisible        => 0,
    aspect_ratio    => 5,
    show_grid       => 0,
    rounded_corners => 1
);

$params = [];
for (0 .. 2) {
    push @$params,
        {
            min    => $low[$_],
            q1     => $Q1[$_],
            median => $mdn[$_],
            q3     => $Q3[$_],
            max    => $high[$_]
        };
}

$graph->add_boxplot($params, fill_color => 'lightblue', width => 1);
$graph->add_label($adj_datamin - 5, 2.5, "D1");
$graph->add_label($adj_datamin - 5, 5.5, "D2");
$graph->add_label($adj_datamin - 5, 8.5, "D3");

$checks = CheckboxList([ @corr, @incorr ], [@corr], labels => 'ABC');

# TODO: need alt text

BEGIN_PGML
Three datasets, labelled D1, D2, D3 are plotted below in the following box plots. 

 [! !]{$graph}{600}

Which of the following are true?

[_]{$checks}

END_PGML

BEGIN_PGML_SOLUTION
Recalling the features of the boxplot, the following answers are true: [$checks]
END_PGML_SOLUTION

ENDDOCUMENT();
