##DESCRIPTION
## Parametrizing curves in space
##ENDDESCRIPTION

## DBsubject(Calculus - multivariable)
## DBchapter(Calculus of vector valued functions)
## DBsection(Parameterized curves)
## Date(1/7/14)
## Institution(Alfred University)
## Author(Darwyn Cook)
## Level(3)
## MO(1)
## TitleText1('Calculus')
## AuthorText1('Anton')
## EditionText1('8')
## Section1('12.5')
## Problem1('1')
## KEYWORDS('Vector','Parametric','Geometry')

DOCUMENT();

loadMacros(
    'PGstandard.pl',        'PGML.pl',
    'parserVectorUtils.pl', 'parserParametricLine.pl',
    'PGcourse.pl'
);

Context("Vector");
Context()->variables->are(t => "Real");

#  Points on the line

$P = non_zero_point3D();
$Q = $P + non_zero_point3D();

#  Times, vectors, and lines

$t0 = random(1, 4);
$t1 = $t0 + random(1, 8);
$v  = Vector(($Q - $P) / ($t1 - $t0));
$r  = Formula("$P+(t-$t0)*$v");

BEGIN_PGML
Find the simplest vector parametric expression [`\vec{r}(t)`] for the line that passes through the points [` P = [$P] `] at time [`t = [$t0]`] and [` Q = [$Q] `] at time [`t = [$t1].`]

    [` \vec{r}(t) =\; `] [_]{$r}
END_PGML

ENDDOCUMENT();
