##DESCRIPTION
## Parametrizing curves in space
##ENDDESCRIPTION

## DBsubject(Calculus - multivariable)
## DBchapter(Calculus of vector valued functions)
## DBsection(Parameterized curves)
## Date(1/7/14)
## Institution(Alfred University)
## Author(Darwyn Cook)
## MLT(pc_lines_two_points)
## Level(2)
## MO(1)
## TitleText1('Calculus')
## AuthorText1('Anton')
## EditionText1('8')
## Section1('12.5')
## Problem1('1')
## KEYWORDS('Vector','Parametric','Geometry')

DOCUMENT();

loadMacros(
    'PGstandard.pl',        'PGML.pl',
    'parserVectorUtils.pl', 'parserParametricLine.pl',
    'PGcourse.pl'
);

Context("Vector");
Context()->variables->are(t => "Real");

#  Points on the line

$P0 = non_zero_point2D();
$Q0 = $P0 + non_zero_point2D();
$v0 = Vector($Q0 - $P0);
$r0 = Formula("$P0+t*$v0");

$P1 = non_zero_point3D();
$Q1 = $P1 + non_zero_point3D();
$v1 = Vector($Q1 - $P1);
$r1 = Formula("$P1+t*$v1");

$P2 = non_zero_point3D();
$Q2 = $P2 + non_zero_point3D();
$v2 = Vector($Q2 - $P2);
while ($v1 == $v2) {
    $Q2 = $Q2 + non_zero_point3D();
    $v2 = Vector($Q2 - $P2);
}
$r2 = Formula("$P2+t*$v2");

BEGIN_PGML
a) Find a vector parametric equation [`\vec{r}(t)`] for the line through the points [` P = [$P0] `] and [` Q = [$Q0] `].

    [` \vec{r}(t) = \; `] [_]{$r0}

b) Find a vector parametric equation [`\vec{r}(t)`] for the line through the points [` P = [$P1] `] and [` Q = [$Q1] `].

    [` \vec{r}(t) = \; `] [_]{$r1}

c) Find a vector parametric equation [`\vec{r}(t)`] for the line through the points [` P = [$P2] `] and [` Q = [$Q2] `].

    [` \vec{r}(t) = `] [_]{$r2}

END_PGML
ENDDOCUMENT();
