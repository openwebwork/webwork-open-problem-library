## level(4)
## DBsubject(Statistics)
## DBchapter(Exploratory data analysis/descriptive statistics)
## DBsection(Summary statistics)
## KEYWORDS('box plot', 'skew', 'median', 'interquartile range')
## Date(08/27/2014)
## Institution(University of BC)
## Author(Andy Leung)
## Level(3)
## Static(1)
## RESOURCES('hw02-q03_boxplot.jpg')

DOCUMENT();

loadMacros(
    'PGstandard.pl',         'PGML.pl',
    'StatisticalPlots.pl',   'PGchoicemacros.pl',
    'parserRadioButtons.pl', 'PGcourse.pl'
);

$radio1 = RadioButtons([ 4, 5, 6, 8, 11 ], 0, labels => 'ABC');
$radio2 =
    RadioButtons([ 'skewed left', 'approximately symmetric', 'skewed right' ],
        2, labels => 'ABC');
$radio3 =
    RadioButtons([ 'smaller than', 'approximately the same', 'larger than' ],
        2, labels => 'ABC');
$radio4 = RadioButtons(
    [
        'less than 4',
        'approximately equal to 4',
        'greater than 4',
        'not enough information to determine'
    ],
    1,
    labels => 'ABC'
);
$radio5 =
    RadioButtons([ 'increase', 'remain approximately the same', 'decrease' ],
        2, labels => 'ABC');
$radio6 =
    RadioButtons([ 'increase', 'remain approximately the same', 'decrease' ],
        1, labels => 'ABC');

$plot = StatPlot(
    xmin            => -1,
    xmax            => 5,
    ymin            => 0,
    ymax            => 12.5,
    ytick_delta     => 2,
    show_grid       => 0,
    xvisible        => 0,
    rounded_corners => 1
);
$plot->add_boxplot(
    {
        min      => 0.5,
        q1       => 2.2,
        median   => 4,
        q3       => 6,
        max      => 10.2,
        outliers => [ 11.2, 11.6 ]
    },
    orientation => 'vertical',
    whisker_cap => 1
);

BEGIN_PGML
The boxplot below displays the birthweights of 100 randomly selected infants 
born at Vancouver General Hospital. Use this to answer the following questions.
  
>>[!!]{$plot}{300}<<

1. The median is roughly...

    [_]{$radio1}

2. The distribution of birth-weight is ______

    [_]{$radio2}

3. Based on the box plot, we would expect the mean to be ____  the median: 

    [_]{$radio3}

4. The interquartile range of the data is ______ :

    [_]{$radio4}

5. Suppose we removed the two outliers from the dataset. How would the 
    following summaries change?  
    
    i) The standard deviation would _____ :

    [_]{$radio5}

    ii) The interquartile range would _____ :

    [_]{$radio6}
END_PGML

BEGIN_PGML_SOLUTION

1. [$radio1]
2. [$radio2]
3. [$radio3]
4. [$radio4]
5.  i)  [$radio5]    ii) [$radio6]
END_PGML_SOLUTION

ENDDOCUMENT();
