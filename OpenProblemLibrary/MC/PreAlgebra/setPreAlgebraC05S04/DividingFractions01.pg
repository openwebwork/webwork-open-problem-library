##DESCRIPTION
##  Middle School problem:
##ENDDESCRIPTION

## ProblemTester('Laura Travis')
## Publisher('Prentice Hall')
## DBsubject(Arithmetic)
## DBchapter(Fractions/rational numbers)
## DBsection(Division)
## Date(11/12/2012)
## Institution(Mississippi College)
## Author(John Travis)
## MLT(basic_division)
## MLTleader(1)
## Level(2)
## MO(1)
## TitleText1('Pre-Algebra')
## KEYWORDS('prealgebra','common core','fractions')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'PGcourse.pl');

Context("Numeric");
Context("Fraction-NoDecimals");
Context()->flags->set(reduceFractions => 0);

$atop = random(19, 25);
$abot = random(5,  7);
$btop = random(11, 18);
$bbot = $abot;

$ans = Compute("($atop*$bbot)/($abot*$btop)");

Context()->operators->undefine("-", "+");

#  Text

BEGIN_PGML

Add the following and express your answer as a single fraction.  No decimals or mixed fractions.

>>
[``\frac{[$atop]}{[$abot]} \div \frac{[$btop]}{[$bbot]} = ``] [_]{$ans}
<<

END_PGML

$showHint = 3;
BEGIN_PGML_HINT
Remember when dividing by a fraction, multiply by its reciprocal.
END_PGML_HINT

BEGIN_PGML_SOLUTION
[```
\begin{aligned}
\frac{[$atop]}{[$abot]} \div \frac{[$btop]}{[$bbot]} & = 
\frac{[$atop]}{[$abot]} \cdot \frac{[$bbot]}{[$btop]} = \frac{[$atop]}{[$btop]}
\end{aligned}
```]
END_PGML_SOLUTION

ENDDOCUMENT();        