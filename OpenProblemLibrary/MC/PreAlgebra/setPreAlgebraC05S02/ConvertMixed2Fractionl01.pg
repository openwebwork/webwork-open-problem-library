##DESCRIPTION
##  Middle School problem:
##ENDDESCRIPTION

## ProblemTester('Laura Travis')
## Publisher('Prentice Hall')
## DBsubject(Arithmetic)
## DBchapter(Fractions/rational numbers)
## DBsection(Mixed/improper fractions)
## Date(11/12/2012)
## Institution(Mississippi College)
## Author(John Travis)
## MLT(mixed_to_improper)
## MLTleader(1)
## Level(2)
## MO(1)
## TitleText1('Pre-Algebra')
## AuthorText1('')
## EditionText1('')
## Section1('.')
## Problem1('')
## KEYWORDS('prealgebra','common core','fractions','ordering','decimals','mixed fractions')

DOCUMENT();      

loadMacros('PGstandard.pl', 'PGML.pl', 'PGchoicemacros.pl', 'contextFraction.pl', 'PGcourse.pl');


Context("Fraction");

$lowint = random(1,4);
$lowtop = random(1,3);
$lowbot = random(4,8,4);

$midint = random(5,8);
$midtop = random(1,4);
$midbot = random(5,10,5);

$highint = random(9,12);
$hightop = random(1,4);
$highbot = random(8,16,8);

$exp1 = "$lowint\; \frac{$lowtop}{$lowbot}";
$exp2 = "$midint\; \frac{$midtop}{$midbot}";
$exp3 = "$highint\; \frac{$hightop}{$highbot}";

$top1 = $lowint*$lowbot+$lowtop;
$top2 = $midint*$midbot+$midtop;
$top3 = $highint*$highbot+$hightop;

$ans1 = Compute("$top1/$lowbot");
$ans2 = Compute("$top2/$midbot");
$ans3 = Compute("$top3/$highbot");

Context("Fraction-NoDecimals");
Context()->flags->set(reduceFractions=>0);

#  Text

Context()->operators->undefine("+","-");

##  This problem still accepts answers in the form n + a/b

BEGIN_PGML

Convert each mixed fraction to an improper fraction.  


a) [``[$exp1]``] = [_]{$ans1}

b) [``[$exp2]``] = [_]{$ans2}

c) [``[$exp3]``] = [_]{$ans3}


END_PGML

$showHint = 3;
BEGIN_PGML_HINT
Multiply the whole number term by the denominator of the proper fraction.  Combine with the other numerator.  
END_PGML_HINT

BEGIN_PGML_SOLUTION

For each, multiply the whole number term by the denominator of the proper fraction, then add the numerator. 

a) [`` [$exp1] = \frac{[$lowint] \cdot [$lowbot] + [$lowtop]}{[$lowbot]} = [$ans1] ``]

b) [`` [$exp2] = \frac{[$midint] \cdot [$midbot] + [$midtop]}{[$midbot]} = [$ans2] ``]

c) [`` [$exp3] = \frac{[$highint] \cdot [$highbot] + [$hightop]}{[$highbot]} = [$ans3] ``]
END_PGML_SOLUTION

ENDDOCUMENT();        