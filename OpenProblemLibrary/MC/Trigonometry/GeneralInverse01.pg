## DESCRIPTION
##   General Inverse Trig Evaluation
## ENDDESCRIPTION

## DBsubject(Trigonometry)
## DBchapter(Analytic trigonometry)
## DBsection(Solving trigonometric equations numerically)
## Date(10/23/2012)
## Institution(Mississippi College)
## Author(John Travis)
## MLT(KentMoreLike6)
## Level(4)
## Static(1)
## MO(1)
## KEYWORDS('Trig', 'Inverse')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context("Numeric");

$sine   = non_zero_random(-0.95, 0.95, 0.04);
$cosine = -$sine / 2;

$ref_sine   = Compute("asin(abs($sine))");
$ref_cosine = Compute("acos(abs($cosine))");

if ($sine < 0) {
    $sin1 = Compute("pi + $ref_sine");
    $sin2 = Compute("2pi - $ref_sine");
} else {
    $sin1 = $ref_sine;
    $sin2 = Compute("pi- $ref_sine");
}
if ($cosine < 0) {
    $cos1 = Compute("pi- $ref_cosine");
    $cos2 = Compute("pi + $ref_cosine");
} else {
    $cos1 = $ref_cosine;
    $cos2 = Compute("2 pi- $ref_cosine");
}

#  For the answers, don't allow functions other than sqrt()

Context()->functions->disable("Trig");

# Main text

BEGIN_PGML
Using a calculator, determine all solutions between 0 and 2[`\pi`] for each of the following.  

a) [`\sin(\theta) = [$sine] `] has solutions [`0 <`] [_]{$sin1} [`<`] [_]{$sin2} [` < 2\pi `]

b) [`\cos(\alpha) = [$cosine] `] has solutions [`0 <`] [_]{$cos1} [`<`] [_]{$cos2} [` < 2\pi `]

_Use radian measure to at least four decimal places and enter your answers with smallest first._

END_PGML

ENDDOCUMENT();
