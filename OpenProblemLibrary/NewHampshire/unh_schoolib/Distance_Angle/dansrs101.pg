#DESCRIPTION
##Type of
#ENDDESCRIPTION
## DBsubject(Geometry)
## DBchapter(Circle geometry)
## DBsection(Circumference and area)
## Level(2)
## MO(1)

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'plots.pl', 'PGcourse.pl');

Context("Numeric")->flags->set(tolerance => 0.005, tolType => "absolute");
$r    = random(7.1, 7.9, 0.1);
$circ = Real(2 * pi * $r);
$area = Real(pi * $r**2);

$graph = Plot(xvisible => 0, yvisible => 0, show_grid => 0);
$graph->add_circle([ 0, 0 ], 4.5, color => 'darkblue');
$graph->add_dataset(
    [ 0,                        0 ],
    [ 4.5 * cos(30 * pi / 180), 4.5 * sin(30 * pi / 180) ],
    width => 1
);
$graph->add_label(1.2, 1.8, "$r cm");

BEGIN_PGML
>> [! A circle of radius [$r] !]{$graph}{300} <<

a) The circumference of a circle with radius [$r] cm is [_]{$circ}{5} cm.

    Your answer must be accurate to two decimal places.

b) The area of a circle with radius [$r] cm is [_]{$area}{5} square cm.

    Your answer must be accurate to two decimal places.

END_PGML

BEGIN_PGML_SOLUTION
The circumference of a circle is [`2 \pi`] times the radius (where [`\pi`] is approximately 3.1416.   
[`2\times 3.1416\times [$r]= [$circ]`].

The area of a circle is [`\pi`] times the square of the radius.  
[`3.1416\times [$r]^2=[$area]`].
END_PGML_SOLUTION

ENDDOCUMENT();

