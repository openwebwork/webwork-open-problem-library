## DESCRIPTION
## Operations on fractions
## ENDDESCRIPTION
## KEYWORDS('addition','distributive law', 'fraction')
## DBsubject(Arithmetic)
## DBchapter(Fractions/rational numbers)
## DBsection(Multiple operations)
## Level(2)
## MO(1)

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'PGcourse.pl');

Context("Fraction");
$a1 = random(3, 6);
$b1 = random(5, 9, 2);
$b2 = $b1 - 2;
$c0 = random(1, 4);
$c1 = random(2, 4);
$c2 = $c1 * $c0 + 1;
$d0 = random(2, 5);
$d1 = random(2, 5);
$d2 = $d1 * $d0 + 1;

Context("LimitedFraction");
$an = Compute("1/$a1");
$a  = Compute("-1/$a1");
$b  = Compute("$b2/$b1");
$c  = Compute("-$c2/$c1");
$d  = Compute("$d2/$d1");
$e  = Compute("7/8");

$ans1       = 4 * $a;
$ans2       = $a + $c * $d;
$ans3       = 9 * $d + $e;
$ans4       = $d * ($b + 6);
$hintanswer = $a + $b + $c + $d;

BEGIN_PGML
Evaluate each expression if  [`` a=[$a],\  b=[$b],  c= -[$c0] \frac{1}{[$c1]},\ 
 d=[$d0]\frac{1}{[$d1]}``].
 

 Your answer should be a reduced fraction or a mixed number.


END_PGML

BEGIN_PGML

a) [` 4a=`] [_]{$ans1}

b) [`a+cd=  `][_]{$ans2}

c) [`9d+\frac{7}{8}= `][_]{$ans3}

d) [`d(b+6)=`] [_]{$ans4}
END_PGML

Context("LimitedFraction");

ANS($ans1->cmp);
ANS($ans2->cmp);
ANS($ans3->cmp);
ANS($ans4->cmp);

BEGIN_PGML_HINT
In a problem of this type just replace the variable by its value and 

then evaluate.  For example, with these choices of values for a,b,c,d you
would have:

[`a+b+c+d=[$a]+[$b]+[$c]+[$d]=[$hintanswer]`].  
END_PGML_HINT

BEGIN_PGML_SOLUTION

a) [`4a=4\times [$a]=[$ans1]`]

 b) [`a+cd= [$a]+[$c]\times [$d]= [$ans2]`]

 c) [`9d+\frac{7}{8}= 9\times [$d]+\frac{7}{8} = [$ans3]`]

 d)  [`d(b+6)=[$d]([$b]+6) = [$ans4]`]

END_PGML_SOLUTION

ENDDOCUMENT();

