## DESCRIPTION
## Sum of three mixed numbers.
## ENDDESCRIPTION
## DBsubject(Arithmetic)
## DBchapter(Fractions/rational numbers)
## DBsection(Addition/subtraction)
## KEYWORDS('mixed numbers', 'addition')
## Level(2)
## MO(1)
DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'PGcourse.pl');

Context("Numeric");
$a1 = random(1,  4);
$a2 = random(1,  4);
$a3 = random(1,  4);
$b1 = random(1,  14);
$b2 = random(5,  19);
$b3 = random(13, 15);

Context("Fraction")->flags->set(
    allowProperFractions => 1,
    reduceConstants      => 0,    #keep fractions ad operations between them
);
$sum = Compute("$a1 $b1/24 + $a2 $b2/24 +$a3 $b3/24");

# The answer is the result of the sum forced into the LimitedFraction
# context so students must enter the result, not
# the original sum

Context("LimitedFraction")->flags->set(
    requireProperFractions => 1,
    showProperFractions    => 1,
);
$ans = $sum->eval->inContext(Context());
BEGIN_PGML

[``[$a1]\frac{[$b1]}{24}+[$a2]\frac{[$b2]}{24}+ [$a3]\frac{[$b3]}{24}=``]
[@ ans_rule(5) @]*

END_PGML

ANS($ans->cmp);

$s1   = 24 * $a1 + $b1;
$s2   = 24 * $a2 + $b2;
$s3   = 24 * $a3 + $b3;
$s    = $s1 + $s2 + $s3;
$sm24 = $s % 24;
$d    = ($s - $sm24) / 24;

BEGIN_PGML_SOLUTION
Since the denominators of the fractions are all the same ( 24) we can start by
changing each mixed number 

 to an improper fraction with denominator 24 and then add them 

[`[$a1]\frac{[$b1]}{24}+[$a2]\frac{[$b2]}{24}+ [$a3]\frac{[$b3]}{24}= \frac{[$s1]}{24}+ \frac{[$s2]}{24}+ \frac{[$s3]}{24}=\frac{[$s]}{24}=[$d] \frac{[$sm24]}{24}`]

END_PGML_SOLUTION

ENDDOCUMENT();

