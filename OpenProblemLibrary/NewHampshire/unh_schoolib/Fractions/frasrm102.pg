## DESCRIPTION
## Use a number line to find the sum of two fractions. 
## ENDDESCRIPTION
## DBsubject(Arithmetic)
## DBchapter(Fractions/rational numbers)
## DBsection(Addition/subtraction)
## KEYWORDS('sum', 'fraction', 'number line')
## Level(2)
## MO(1)
DOCUMENT();
loadMacros(
    'PGstandard.pl',         'PGML.pl',
    'plots.pl',              'PGchoicemacros.pl',
    'PGgraphmacros.pl',      'contextFraction.pl',
    'contextLeadingZero.pl', 'PGcourse.pl'
);

Context("LimitedFraction");

$plot = Plot(
    xmin         => -0.1,
    xmax         =>  2.1,
    xtick_delta  =>  3,
    ymin         => -0.3,
    ymax         =>  0.3,
    yvisible     =>  0,
    aspect_ratio => 1,
    show_grid => 0,
    rounded_corners => 1,
);
for my $i (0 .. 16) {
    $plot->add_dataset([ $i / 8, -0.04 ], [ $i / 8, 0.04 ], width => 1);
}
for my $i (1 .. 3) {
    $plot->add_label($i / 4, -0.05, "\\(\\frac{$i}{4}\\)",
        v_align => 'top');
}
$plot->add_label(1, -0.05, "\\(1\\)", v_align => 'top');
for my $i (1 .. 3) {
    $plot->add_label((1 + $i / 4),
        -0.05, "\\(1\\frac{$i}{4}\\)", v_align => 'top');
}
$plot->add_label(2, -0.05, "\\(2\\)", v_align => 'top');

for (my $i = 1; $i <= 7; $i += 2) {
    $plot->add_label($i / 8, 0.05, "\\(\\frac{$i}{8}\\)",
        v_align => 'bottom');
}

for (my $i = 1; $i <= 7; $i += 2) {
    $plot->add_label(1 + $i / 8,
        0.05, "\\(1\\frac{$i}{8}\\)", v_align => 'bottom');
}

$num1 = list_random(1, 3, 5, 7);
$num2 = list_random(1, 3, 5, 7);

$ans = Fraction($num1 + 2 * $num2, 8);

BEGIN_PGML

>>[!!]{$plot}{400}<<

You may use the number line shown above to answer this question.
Your answer will be either a proper fraction (fraction less than 1) or 
a mixed number.

 [``\frac {[$num1]}{8} +\frac {[$num2]}{4}=``] [_]{$ans}

END_PGML

BEGIN_PGML_SOLUTION

 Solutions  If you want to do this using the ruler, start from the mark at the larger number [`\frac{[$num2]}{4}`]
and move to the right by [`\frac{[$num1]}{8}`] (since the smallest units on the ruler are eighths
that means that you should move [$num1] hops to the right to get your answer.

END_PGML_SOLUTION

ENDDOCUMENT();

