#DESCRIPTION
##Type of
#ENDDESCRIPTION
## DBsubject(Arithmetic)
## DBchapter(Fractions/rational numbers)
## DBsection(Mixed/improper fractions)
## KEYWORDS('mixed numbers', 'fractions')
## MLT(improper_to_mixed)
## MLTleader(1)
## Level(2)
## MO(1)

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'PGcourse.pl');

Context("LimitedFraction")->flags->set(
    requireProperFractions => 1,
    showProperFractions    => 1,
);

$a1   = random(5, 9, 2);
$ans1 = Fraction($a1, 4);
$a2   = random(14, 22, 4);
$ans2 = Fraction($a2, 5);
$a3   = random(39, 57, 9);
$ans3 = Fraction($a3, 9);

BEGIN_PGML
For each of the improper fractions below, change to mixed numbers. 

*Make sure that you leave a space between the whole number and the fraction.*

a)  [``\frac{[$a1]}{4}=``]  [_]{$ans1}

b)  [``\frac{[$a2]}{5}=``]  [_]{$ans2}

c)  [``\frac{[$a3]}{9}=``] [_]{$ans3}

END_PGML

$b1 = $a1 % 4;
$c1 = ($a1 - $b1) / 4;
$b2 = $a2 % 5;
$c2 = ($a2 - $b2) / 5;
$b3 = $a3 % 9;
$c3 = ($a3 - $b3) / 9;
@d3 = reduce($b3, 9);
BEGIN_PGML_SOLUTION
a) When we divide [$a1] by 4 we get quotient [$c1] and remainder [$b1], so our answer is [``[$ans1]``].

b) When we divide [$a2] by 5 we get quotient [$c2] and remainder [$b2], so our answer is [``[$ans2]``].

c)  When we divide [$a3] by 9 we get quotient [$c3] and remainder [$b3]. But, since
[``\frac{[$b3]}{9}``] is not reduced, we have to reduce it to [`\frac{[$d3[0]]}{[$d3[1]]}`] and our answer is [``[$ans3]``].

END_PGML_SOLUTION

ENDDOCUMENT();
