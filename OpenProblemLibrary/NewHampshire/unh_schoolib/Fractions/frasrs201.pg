## DBsubject(Arithmetic)
## DBchapter(Fractions/rational numbers)
## DBsection(Addition/subtraction)
## Level(2)
## MO(1)
DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'PGcourse.pl');

#  Create the fractions

Context("LimitedFraction")->flags->set(
    requireProperFractions => 1,
    showProperFractions    => 1,
);

$r1   = random(30, 35);
$rf1  = random(2,  6, 2);
$num1 = random(1,  $rf1 - 1);
$r2   = random(16, 19);
$rf2  = random(5,  9, 2);
$num2 = random(1,  $rf2 - 1);

$a   = Compute("$r1 $num1/$rf1");
$b   = Compute("$r2 $num2/$rf2");
$ans = $a - $b;

$cmp = $ans->cmp(
    reduceFractions      => 0,
    reduceConstants      => 0,
    allowProperFractions => 1
);

BEGIN_PGML
Find the result of 
[``[$a] - [$b] =``] [_]{$cmp}

Your answer should be in simplest form as either a proper fraction or  a mixed number (which  can be put into the answer box as an integer followed by a space and then a proper fraction).

END_PGML

$d     = lcm($rf1, $rf2);
$frac1 = Fraction($r1 * $rf1 + $num1, $rf1);

$numA = $r1 * $rf1 + $num1;
$numB = $r2 * $rf2 + $num2;

BEGIN_PGML_SOLUTION

We start by converting both numbers to improper fractions.

[```[$a] =  \frac{[$numA]}{[$rf1]}```]

and

[```[$b] =  \frac{[$numB]}{[$rf2]}```]

Now our common denominator is the least common multiple
of [`[$rf1]`] and [`[$rf2]`] which is [`[$d]`].

So our answer (in the form of a fraction) is

[```
\begin{aligned}
[$a]-[$b] & = \frac{[$numA]}{[$rf1]} - \frac{[$numB]}{[$rf2]} \\
& = \frac{[$numA]}{[$rf1]}\frac{[$rf2]}{[$rf2]} - \frac{[$numB]}{[$rf2]}\cdot \frac{[$rf1]}{[$rf1]} \\
& = \frac{[@ $numA*$rf2 @]}{[$d]} -\frac{[@ $numB*$rf1 @]}{[$d]} \\
& = [$ans->with(showProperFractions => 0)] \\
& = [$ans]
\end{aligned}
```]
END_PGML_SOLUTION

ENDDOCUMENT();
    
