## DESCRIPTION
## Calcuate the percent change from the absolute numbers. 
## ENDDESCRIPTION
## DBsubject(Arithmetic)
## DBchapter(Percents)
## DBsection(Applications)
## KEYWORDS('Percent', 'change');
## Level(4)
## MO(1)

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

sub decpl {
    my ($a, $b, $d) = @_;
    my $a1 = $a * 10**$d;
    my $x  = $a1 % $b;
    $y = $x < $b / 2 ? 0 : 1;
    return $n = (($a1 - $x) / $b + $y) / (10**$d);
}
$aa  = random(25, 35, 1);
$b   = random(7,  11, 1);
$a   = $aa / 10;
$bb  = ($b - $a) * 10**3;
$ans = decpl($bb, $aa, 1);
$bma = $b - $a;
$bw  = 10000 * $bma;
$bz  = $bw % $a;
$by  = (10000 * $bma - $bz) / (100 * $a);

BEGIN_PGML
The percentage change from [$a] inches  to [$b] inches (to 1 decimal place) is
[_]{$ans}%
END_PGML

BEGIN_PGML_HINT
To obtain the percentage change from [$a] to [$b], first find 
[```\frac{[$b]-[$a]}{[$a]}.```]

This is the change from [$a] to [$b] as a multiple of [$a].

Now multiply by 100 to convert to a percentage. 
END_PGML_HINT

BEGIN_PGML_SOLUTION

The change from [$a] to [$b] is [`` [$b]-[$a] = [$bma].``]The fraction change is 

[```\frac{[$bma]}{[$a]} = [$bma/$a]```].

 The percentage change is the decimal form of 100 times the fraction change.  
[`100*\frac{[$bma]}{[$a]}=[$by]`]. Rounding to 1 decimal place we obtain [$ans].
END_PGML_SOLUTION

ENDDOCUMENT();
