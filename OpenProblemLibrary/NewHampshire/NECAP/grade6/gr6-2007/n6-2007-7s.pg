## DBsubject(Geometry)
## DBchapter(Shapes)
## DBsection(Area)
## Level(3)

DOCUMENT();
loadMacros(
    'PGstandard.pl', 'PGML.pl', 'PGchoicemacros.pl', 'plots.pl',
    'PGcourse.pl'
);

# make sure we're in the context we want
Context("Numeric");
#  Graph with no labels

$gr = Plot(
    xmin           => 0,
    xmax           => 7,
    ymin           => 0,
    ymax           => 7,
    xvisible       => 0,
    yvisible       => 0,
    xminor         => 1,
    yminor         => 1,
    xtick_distance => 2,
    ytick_distance => 2
);

$gr->add_rectangle([ 0, 0 ], [ 7, 7 ], fill => 'self', fill_color => 'green');
$gr->add_dataset(
    [ 2, 3 ], [ 2, 4 ], [ 3, 5 ], [ 4, 5 ], [ 5, 4 ], [ 5, 3 ], [ 4, 2 ],
    [ 3, 2 ], [ 2, 3 ],
    fill       => 'self',
    fill_color => 'blue'
);
$gr->add_label(1.5, 1.5, "grass");
$gr->add_label(3.5, 3.5, "fountain");

$radio = new_multiple_choice();
$radio->qa("What is the area of the grass around the fountain? ",
    "42 square feet ");
#FIRST PAREN IS QUESTION, SECOND PAREN IS CORRECT ANSWER
$radio->extra("40 square feet ", "44 square feet ", "46 square feet");

$x          = random(1, 5);
$xsq        = $x**2;
$rect_area  = 49 * $xsq;
$fount_area = 7 * $xsq;
$area       = 42 * $xsq;
BEGIN_PGML
The picture below shows a fountain inside a grassy area.  The size of each box is [`[$x] \times [$x]`].

>> [!!]{$gr}{300}<<

What is the area of the grass around the fountain?  [_]{$area}

END_PGML

BEGIN_PGML_SOLUTION
Since the area of each square is [$xsq] square feet, the total area of the fountain is 7 of these squares or [$fount_area] square feet.  The area of the outside square is [`49 \times [$xsq] = [$rect_area] `].  

Therefore the area of the grass is 
[``` [$rect_area] - [$fount_area] = [$area] ```]
END_PGML_SOLUTION

ENDDOCUMENT();
