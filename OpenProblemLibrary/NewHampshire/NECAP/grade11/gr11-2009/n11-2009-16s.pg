## DBsubject(Algebra)
## DBchapter(Linear equations and functions)
## DBsection(Finding the slope)
## MLT(slope_from_graph)
## Level(2)
## MO(1)

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'PGtikz.pl', 'PGcourse.pl', 'plots.pl');

Context("Numeric");

# scale for the plot
$k = list_random(2, 4, 10, 20);
$a = random(2, 5);
$b = random(-2, 3) * $k / 2;
$slope = $k / (2 * $a);

$y1 = $b * $k / 2;
$y2 = $y1 + $k / 2;

$ymin = int($k * (-3.5 * $slope + $b)) / $k - $k;
$ymin = $ymin > -$k ? -$k : $ymin;
$ymax = int($k * (7.5 * $slope + $b)) / $k + $k;
$ymax = $ymax < $k ? $k : $ymax;

$plot = Plot(
    xmin            => -4,
    xmax            =>  8,
    xtick_delta     =>  1,
    xminor          =>  0,
    ymin            => $ymin,
    ymax            => $ymax,
    ytick_delta     => $k,
    yminor          => $k < 5 ? $k - 1 : $k == 10 ? 1 : 3,
    aspect_ratio    => 3 / $k,
    rounded_corners => 1
);
$plot->add_function(
    "$slope*x+ $b", 'x', -3, 7,
    start_mark => 'arrow',
    end_mark   => 'arrow'
);

$alt_text = "Graph of a line through (0, $y1) and ($a, $y2)";

BEGIN_PGML

>>[![$alt_text]!]{$plot}{400} <<

The slope of line above is [_]{$slope}
END_PGML

($rise, $run) = reduce($k, 2 * $a);

BEGIN_PGML_SOLUTION
The slope of a line is measured by the change in the y coordinate divided by the change in   
the x coordinate as one moves along the line (and not by the actual measurements of the graph.)

In this graph, a change of one gray line in the x direction corresponds to a change of 1 in the [`x`]-direction corresonds to a change of 1 in the x coordinate, while a change of one gray line in the [`y`]-direction corresponds to a change of [$k/2] in the [`y`]-coordinate.

Two points that fall on integer coordinates are [`(0,[$y1])`] and [`([$a],[$y2])`]. The slope is the rise over the run or

[``` m = \frac{\text{rise}}{\text{run}} = \frac{[$k/2]}{[$a]} = \frac{[$rise]}{[$run]} ```]
END_PGML_SOLUTION

ENDDOCUMENT();
