## DESCRIPTION
## A problem which asks the student to find the equation where the 
## perimeter of a square equals the perimeter of a equilateral triangle.
## ENDDESCRIPTION
## DBsubject(Geometry)
## DBchapter(Shapes)
## DBsection(Perimeter)
## KEYWORDS('triangle', 'square', 'perimeter')
## Level(2)

DOCUMENT();
loadMacros(
    'PGstandard.pl',         'PGML.pl',
    'parserRadioButtons.pl', 'plots.pl',
    'PGcourse.pl'
);

# make sure we're in the context we want
Context("Numeric");

# randomize some parameters associated with the figures.

do {
    $a0 = random(2, 4);
    $a1 = random(1, 5);
    $b0 = random(2, 4);
    $b1 = random(1, 7);
} until $a0 != $b0;
$plot = Plot(
    xmin            => -1,
    xmax            =>  9,
    ymin            => -1,
    ymax            =>  4,
    aspect_ratio    =>  1,
    xvisible        =>  0,
    yvisible        =>  0,
    show_grid       =>  0,
    rounded_corners => 1
);

$plot->add_dataset(
    [ 0, 0 ],
    [ 4, 0 ],
    [ 2, 2 * sqrt(3) ],
    [ 0, 0 ],
    color => 'red'
);
$plot->add_rectangle([ 5, 0 ], [ 7, 3 ], color => 'blue');
$plot->add_label(2, 0, "\\($a0 x+$a1\\)", v_align => 'top');
$plot->add_label(
    1, sqrt(3), "\\($a0 x+$a1\\)",
    v_align => 'bottom',
    h_align => 'right'
);
$plot->add_label(
    3, sqrt(3), "\\($a0 x+$a1\\)",
    v_align => 'bottom',
    h_align => 'left'
);

$plot->add_label(6, 0,   "\\($b0 x\\)",     v_align => 'top');
$plot->add_label(7, 1.5, "\\($b0 x+$b1\\)", h_align => 'left');

$radio = RadioButtons(
    [ [
        "\(3($a0 x + $a1 )=2($b0 x+ $b0 x+$b1)\)",
        "\( 3($a0 x+ $a1)  =2( $b0 x+ $b1) \) ",
        "\(3\cdot $a0 x+$a1  =2\cdot $b0 x+$b1 \) ",
        "\( $a0 x + $a1  = $b0 x+ $b0 x+$b1 \)"
    ] ],
    0
);
BEGIN_PGML
Look at these two shapes.

>>[!An equilateral triangle each with side [$a0] x + [$a1] and a rectangle with sides [$b0]x and [$b0] x+[$b1]!]{$plot}{500}<<

The perimeter of the triangle is equal to the perimeter of the rectangle.

Which of the following equations are true? 

[_]{$radio}

END_PGML

BEGIN_PGML_SOLUTION
The perimeter of the triangle is the sum of the lengths of the three side.

The perimeter of the rectangle is the sum of the lengths of the four sides. 

Thus the correct equation is [`3([$a0] x + [$a1] )  =2([$b0] x+ [$b0] x+[$b1])`]
END_PGML_SOLUTION

ENDDOCUMENT();