## DESCRIPTION
## From a model of paint cans, determine the amount of paint to use to make a blend.
## ENDDESCRIPTION
## DBsubject(Arithmetic)
## DBchapter(Fractions/rational numbers)
## DBsection(Ratio/proportions)
## KEYWORDS('paint','ratio', 'fraction')
## MLT(Application_DirectIntegerRatio)
## Level(3)
## MO(1)

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'plots.pl', 'PGcourse.pl');

Context("Numeric");

$color_opts = [
    [ 'red',   'blue',   'purple' ],
    [ 'red',   'yellow', 'orange' ],
    [ 'blue',  'yellow', 'green' ],
    [ 'black', 'white',  'gray' ]
];

$num_cans = list_random(4, 5, 7);
do {
    $n = random(1, $num_cans - 1);
} until ($num_cans != 4 && $n != 2);

$index   = random(0, 3);
$abbrev1 = uc(substr($color_opts->[$index][0], 0, 1));
$abbrev2 = uc(substr($color_opts->[$index][1], 0, 1));

$plot = Plot(
    xmin         => 0,
    xmax         => $num_cans * 5 + 2,
    xvisible     => 0,
    ymin         => 0,
    ymax         => 8,
    yvisible     => 0,
    aspect_ratio => 1
);
if ($index >= 1) {
    $plot->add_rectangle(
        [ 0, 0 ], [ $num_cans * 5 + 2, 8 ],
        fill_color => 'gray',
        color      => 'gray'
    );
}
for (0 .. $num_cans - 1) {
    $plot->add_function([ "2cos(t)+3+5*$_", 'sin(t)+6' ], 't', '0', '2pi',
        color => $_ < $n
        ? $color_opts->[$index][0]
        : $color_opts->[$index][1]);
    $plot->add_dataset(
        [
            [ 1 + 5 * $_, 2 ],
            [ 1 + 5 * $_, 6 ],
            color => $_ < $n ? $color_opts->[$index][0]
            : $color_opts->[$index][1]
        ],
        [
            [ 5 + 5 * $_, 2 ],
            [ 5 + 5 * $_, 6 ],
            color => $_ < $n ? $color_opts->[$index][0]
            : $color_opts->[$index][1]
        ]
    );
    $plot->add_function([ "2cos(t)+3+5*$_", 'sin(t)+2' ], 't', 'pi', '2pi',
        color => $_ < $n
        ? $color_opts->[$index][0]
        : $color_opts->[$index][1]);
    $plot->add_label(
        3 + 5 * $_,
        3.5,
        $_ < $n ? $abbrev1 : $abbrev2,
        color => $_ < $n
        ? $color_opts->[$index][0]
        : $color_opts->[$index][1]
    );
}
$k     = random(3, 6);
$total = $k * $num_cans;
$ans   = Compute($k * $n);

$alt =
    "An image with $n cans of $color_opts->[$index][0] paint and "
    . ($num_cans - $n)
    . " cans of $color_opts->[$index][1] paint.";

BEGIN_PGML

This model shows the ratio of [$color_opts->[$index][0]] paint (labeled '[$abbrev1]') to [$color_opts->[$index][1]] paint (labeled '[$abbrev2]') needed to make a shade of [$color_opts->[$index][2]] paint.

>>[![$alt]!]{$plot}{500}<<

[_]{$ans} ounces of [$color_opts->[$index][0]] paint are needed to make [$total] ounces of [$color_opts->[$index][2]] paint.

END_PGML

BEGIN_PGML_SOLUTION
The model shows that [`\frac{[$n]}{[$num_cans]} `] of the mixture needs to be [$color_opts->[$index][0]] paint.  

[`\frac{[$n]}{[$num_cans]}\times [$total]=[$ans]`] so [$ans] ounces of red paint are needed.
END_PGML_SOLUTION

ENDDOCUMENT();
