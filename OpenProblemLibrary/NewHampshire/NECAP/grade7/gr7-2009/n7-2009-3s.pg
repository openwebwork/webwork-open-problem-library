## DESCRIPTION
## Determine the amount spent on gasoline for a given percent increase over
## the week before.
## ENDDESCRIPTION
## DBsubject(Arithmetic)
## DBchapter(Percents)
## DBsection(Applications)
## KEYWORDS('gasoline', 'percent', 'rate')
## MLT(percent_ncp_multchoice)
## MLTleader(1)
## Level(3)

DOCUMENT();
loadMacros(
    'PGstandard.pl',   'PGML.pl',
    'randomPerson.pl', 'contextCurrency.pl',
    'PGcourse.pl'
);

Context("Currency");

$p   = randomPerson();
$amt = random(12, 60, 4);
$r   = random(10, 25, 5);

$ans = Currency("$amt*(1+$r/100)");

BEGIN_PGML
[$p] spent $[$amt] on gasoline last week.  [$p->They] will spend [$r]% more on gasoline this week than [$p->they] did last week.

How much will [$p] spend on gasoline this week?  [_]{$ans}

END_PGML

BEGIN_PGML_SOLUTION
[$r]% of [$amt] is [`[$amt]\cdot [$r]/100 = [$amt*$r/100] `]

So [$p->they] will spend [`$[$amt] + $[$amt*$r/100] = [$ans]`]
END_PGML_SOLUTION

ENDDOCUMENT();
