## DBsubject(Statistics)
## DBchapter(Exploratory data analysis/descriptive statistics)
## DBsection(Graphical representations)
## KEYWORDS('bar chart', 'animals')
## MLT(Statistics_Exploratory_EarlyHistograms)
## Level(1)

DOCUMENT();
loadMacros(
    'PGstandard.pl',         'PGML.pl',       'StatisticalPlots.pl',
    'parserRadioButtons.pl', 'PGcourse.pl'
);

Context("Numeric");

@animals =
    ('Polar Bear', 'Grizzly Bear', 'Blue Whale', 'Box Turtle', 'Bald Eagle');

$rb = RadioButtons(~~@animals, 1, labels => 'ABC');

@w = (20, 25, 80, 100, 40);

$stat_plot = StatPlot(
    xmin            => -30,
    xmax            => 120,
    xtick_positions => [ map { 10 * $_ } (1 .. 11) ],
    xlabel          => 'life span (yrs.)',
    ymin            => -2,
    ymax            => 12,
    ytick_positions => [ 2, 4, 6, 8, 10 ],
    ylabel          => '',
    ytick_labels    => { map { 2 + 2 * $_ => $animals[$_] } (0 .. 4) },
    show_grid       => 0,
    aspect_ratio    => 6
);
$stat_plot->add_barplot(
    ~~@w, [ 2, 4, 6, 8, 10 ],
    orientation  => 'horizontal',
    stroke_width => 1,
    bar_width    => 0.75,
    fill_colors  => [ 'blue', 'red', 'green', 'yellow', 'orange' ]
);

BEGIN_PGML
The bar graph below shows the average life span of some animals.

>>[! !]{$stat_plot}{500}<<

Which animal has an average life span that is five times the average life span of a polar bear?

[_]{$rb}

END_PGML

BEGIN_PGML_SOLUTION
The average life span of a box turtle is 100 years. 

The average life span of the polar bear is 20 years.
END_PGML_SOLUTION

ENDDOCUMENT();

