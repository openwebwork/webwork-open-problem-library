## DESCRIPTION
## Find the order of fractions using a fraction area model
## ENDDESCRIPTION
## DBsubject(Arithmetic)
## DBchapter(Fractions/rational numbers)
## DBsection(Interpreting fractions)
## KEYWORDS('fraction', 'model', 'ordering')
## Level(2)
DOCUMENT();
loadMacros(
    'PGstandard.pl', 'PGML.pl',
    'plots.pl',      'parserRadioButtons.pl',
    'PGcourse.pl'
);

# make sure we're in the context we want
Context("Numeric");

$plot = Plot(
    xmin            => -0.5,
    xmax            =>  6.5,
    ymin            => -0.5,
    ymax            =>  6.5,
    show_grid       =>  0,
    xvisible        =>  0,
    yvisible        =>  0,
    rounded_corners => 0
);

for my $n (1 .. 6) {
    for my $i (1 .. $n) {
        $plot->add_rectangle([ ($i - 1) * 6 / $n, 6 - $n ],
            [ $i * 6 / $n, 7 - $n ]);
    }
}
$plot->add_label(3, 5.5, "1 whole unit");

$radio = RadioButtons(
    [ [
        '\(\displaystyle \frac{2}{3}\)',
        '\(\displaystyle \frac{1}{3}\)',
        '\(\displaystyle \frac{2}{6}\)',
        '\(\displaystyle \frac{1}{2}\)',
        '\(\displaystyle \frac{1}{3}\)'
    ] ],
    0,
    separator => "$SPACE$SPACE$SPACE"
);

BEGIN_PGML
Look at this fraction model. 

>>[!!]{$plot}{300}<<


Which fraction is greater than [`\frac{3}{5}`]:

[_]{$radio}
END_PGML

BEGIN_PGML_SOLUTION
The fifths are on the second row from the bottom.  
  The thirds are on the third row from the top.  If you look carefully  
you can see that [`\frac{2}{3}`] is to the right of [`\frac{3}{5}`].

  
Now look at the others and you can see that none of the other choices is to
the right of  [`\frac{3}{5}`].  
END_PGML_SOLUTION

ENDDOCUMENT();

