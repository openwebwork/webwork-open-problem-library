## DBsubject(Statistics)
## DBchapter(Exploratory data analysis/descriptive statistics)
## DBsection(Graphical representations)
## KEYWORDS('bar chart','polar bear')
## MLT(Statistics_Exploratory_EarlyHistograms)
## MLTleader(1)
## Level(1)

DOCUMENT();
loadMacros(
    'PGstandard.pl',       'PGML.pl',
    'StatisticalPlots.pl', 'parserRadioButtons.pl',
    'PGtikz.pl',           'PGcourse.pl'
);

Context("Numeric");

do {
    @w = (
        random(175, 350, 25),
        random(175, 350, 25),
        random(175, 350, 25),
        random(175, 350, 25)
    );
} until (
    (
        ($w[0] - $w[1]) *
            ($w[0] - $w[2]) *
            ($w[0] - $w[3]) *
            ($w[1] - $w[2]) *
            ($w[2] - $w[3]) != 0
    )
        && ($w[0] == 225 || $w[1] == 225 || $w[2] == 225 || $w[3] == 225)
);

$xmax = 0;
for (0 .. 3) {
    $pol  = $_     if $w[$_] == 225;
    $xmax = $w[$_] if $w[$_] > $xmax;
}

$names = [ 'Stella', 'Yuri', 'Libby', 'Nigel', 'None of them' ];
$rad   = RadioButtons($names, $pol);

$stat_plot = StatPlot(
    xmin         => -50,
    xmax         => $xmax + 50,
    xtick_delta  => 100,
    xminor       => 3,
    xlabel       => 'Weight (lbs)',
    ymin         => -1,
    ymax         => 4.75,
    ytick_delta  => 1,
    yminor       => 0,
    ylabel       => '',
    ytick_labels =>
        { 1 => 'Stella', 2 => 'Yuri', 3 => 'Libby', 4 => 'Nigel' },
    rounded_corners => 1,
    show_grid       => 0
);

$stat_plot->add_barplot(
    ~~@w, [ 1 .. 4 ],
    orientation  => 'horizontal',
    stroke_width => 1,
    bar_width    => 0.75
);

BEGIN_PGML
This bar graph shows the weights of four baby polar bears at a zoo.

>>[! !]{$stat_plot}{400}<<

Which polar bear weighs about 225 pounds?

[_]{$rad}

END_PGML

BEGIN_PGML_SOLUTION
The vertical line between 200 and 300 represents 250 pounds.
[$names->[$pol]]'s weight is about half way between the 200 pound line
and the 250 pound line, so  [$names->[$pol]]'s weight is about 225 pounds.
END_PGML_SOLUTION

ENDDOCUMENT();
