## DBsubject(Arithmetic)
## DBchapter(Fractions/rational numbers)
## DBsection(Interpreting fractions)
## KEYWORDS('fraction', 'shapes')
## MLT(Fraction_pictures)
## MLTleader(1)
## Level(2)

DOCUMENT();
loadMacros(
    'PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'plots.pl',
    'PGcourse.pl'
);

Context("Fraction");

$num_filled    = random(1, 10);
@filled_shapes = random_subset($num_filled, 0 .. 11);

my $pi = atan2(0.5) * 2;
$plot = Plot(
    xmin            => 0,
    xmax            => 20,
    ymin            => -1,
    ymax            => 11,
    aspect_ratio    => 1,
    rounded_corners => 1,
    show_grid       => 0,
    xvisible        => 0,
    yvisible        => 0
);

for my $k (0 .. 11) {
    $i      = 5 * $k % 20 + 2.5;
    $j      = 3.5 * int(0.25 * $k) + 1.5;
    $n      = list_random(3, 3, 3, 4, 4, 4, 5, 6, 8);
    $filled = (grep { $_ == $k } @filled_shapes) ? 1 : 0;
    $plot->add_dataset(
        (
            map { [
                $i + 1.5 * cos(2 * $pi * $_ / $n),
                $j + 1.5 * sin(2 * $pi * $_ / $n)
            ] } (0 .. $n)
        ),
        color      => 'blue',
        fill_color => $filled ? 'blue' : 'none',
        fill       => $filled ? 'self' : 'none'
    );
}

$fract = Compute("$num_filled/12");

BEGIN_PGML
Look at this set of shapes.

>>[!!]{$plot}{600}<<

What fraction of the set of shapes is colored blue? [_]{$fract}

END_PGML

BEGIN_PGML_SOLUTION
The denominator is the total number of shapes which is 12.  
The numerator is the number of blue shapes which is [$num_filled].

So the fraction is [``[$fract]``].
END_PGML_SOLUTION

ENDDOCUMENT();
