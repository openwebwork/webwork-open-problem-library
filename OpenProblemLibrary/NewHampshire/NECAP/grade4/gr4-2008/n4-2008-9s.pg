## DBsubject(Statistics)
## DBchapter(Exploratory data analysis/descriptive statistics)
## DBsection(Graphical representations)
## KEYWORDS('bar chart')
## MLT(Statistics_Exploratory_EarlyHistograms)
## Level(2)

## Updated 2025.02 by Peter Staab, switch to PGML and the graph to tikz.

DOCUMENT();
loadMacros(
    'PGstandard.pl',       'PGML.pl',
    'StatisticalPlots.pl', 'randomPerson.pl',
    'PGcourse.pl'
);

Context("Numeric");

do {
    @w     = map { random(4, 10) } (0 .. 3);
    $total = $w[0] + $w[1] + $w[2] + $w[3];
} until (22 <= $total && $total <= 28);

$stat_plot = StatPlot(
    xmin            => -2,
    xmax            => 11.5,
    xtick_positions => [ 1 .. 11 ],
    xlabel          => 'num. students',
    ymin            => -1,
    ymax            => 10,
    ytick_positions => [ 2, 4, 6, 8 ],
    ylabel          => '',
    ytick_labels    =>
        { 2 => 'Blue', 4 => 'Red', 6 => 'Green', 8 => 'Yellow' },
    show_grid    => 0,
    aspect_ratio => 0.75
);
$stat_plot->add_barplot(
    ~~@w, [ 2, 4, 6, 8 ],
    orientation  => 'horizontal',
    stroke_width => 1,
    bar_width    => 0.75,
    fill_colors  => [ 'blue', 'red', 'green', 'yellow' ]
);

$last_name = randomLastName();

$title = random(0, 1) ? 'Ms.' : 'Mr.';

BEGIN_PGML
This bar graph shows the favorite colors of students in [$title] [$last_name]'s class. Each student voted for only one color.

>>[! !]{$stat_plot}{500}<<

How many students voted in [$title] [$last_name]'s class?  [_]{$total}

END_PGML

BEGIN_PGML_SOLUTION
In this case, the total number of students is what we are looking for. Add up all of the lengths of the bars or [`[$w[0]] + [$w[1]] + [$w[2]] + [$w[3]] = [$total]`].
END_PGML_SOLUTION

ENDDOCUMENT();
