## DESCRIPTION
## Ask students to find two figures with the same area.
## ENDDESCRIPTION

## DBsubject(Geometry)
## DBchapter(Shapes)
## DBsection(Area)
## KEYWORDS('area')
## Level(2)

DOCUMENT();
loadMacros(
    'PGstandard.pl', 'PGML.pl',
    'plots.pl',      'parserCheckboxList.pl',
    'PGcourse.pl'
);

# make sure we're in the context we want
Context("Numeric");

$plot = Plot(
    xmin            => 0,
    xmax            => 23,
    ymin            => -1,
    ymax            => 5,
    aspect_ratio    => 1,
    xvisible        => 0,
    yvisible        => 0,
    show_grid       => 0,
    rounded_corners => 1
);
for my $i (1 .. 3) {
    for my $j (1 .. 3) {
        $plot->add_rectangle([ $i, $j ], [ $i + 1, $j + 1 ], color => 'red');
    }
}

for my $i (6 .. 7) {
    for my $j (1 .. 2) {
        $plot->add_rectangle([ $i, $j ], [ $i + 1, $j + 1 ], color => 'blue');
    }
}

for my $i (11 .. 13) {
    $plot->add_rectangle([ $i, 2 ], [ $i + 1, 3 ], color => 'green');
}

for my $j (1 .. 3) {
    $plot->add_rectangle([ 10, $j ], [ 11, $j + 1 ], color => 'green');
    $plot->add_rectangle([ 14, $j ], [ 15, $j + 1 ], color => 'green');
}

for my $i (17 .. 21) {
    $plot->add_rectangle([ $i, 2 ], [ $i + 1, 3 ], color => 'orange');
}
for my $i (18 .. 20) {
    $plot->add_rectangle([ $i, 1 ], [ $i + 1, 2 ], color => 'orange');
}

$plot->add_label(2.5,  0, 'Figure J', color => 'red');
$plot->add_label(7,    0, 'Figure K', color => 'blue');
$plot->add_label(12.5, 0, 'Figure L', color => 'green');
$plot->add_label(19.5, 0, 'Figure M', color => 'red');

$checks =
    CheckboxList([ 'Figure J', 'Figure K', 'Figure L', 'Figure M' ], [ 0, 2 ]);

BEGIN_PGML
Look at these figures.

>>[!!]{$plot}{600}<<

Which two figures have the same area? [_]{$checks}

END_PGML

BEGIN_PGML_SOLUTION
Both Figure J and Figure M contain 9 small boxes so they have the same area.
END_PGML_SOLUTION

ENDDOCUMENT();