## DESCRIPTION
##  Find the perimeter of a rectangular bookmark.
## ENDDESCRIPTION

## DBsubject(Geometry)
## DBchapter(Shapes)
## DBsection(Perimeter)
## KEYWORDS('rectangle', 'perimeter', 'bookmark')
## Level(1)

DOCUMENT();
loadMacros(
    'PGstandard.pl', 'PGML.pl', 'PGchoicemacros.pl', 'plots.pl',
    'PGcourse.pl'
);

$x = random(5, 15);
$y = random(2, 5);

$a    = random(-4, 2);
$b    = random( 1, 4);
$g    = Compute("$b + sqrt(x - $a)")->reduce;
$area = Compute("3*$b + 14/3");

$plot = Plot(
    xmin            => 0,
    xmax            => 8,
    ymin            => 0,
    ymax            => 4,
    aspect_ratio    => 0.5,
    show_grid       => 0,
    xvisible        => 0,
    yvisible        => 0,
    rounded_corners => 1
);

$plot->add_rectangle(
    [ 2, 1 ], [ 6, 3 ],
    color        => 'blue',
    width        => 1.5,
    fill         => 'self',
    fill_color   => 'yellow',
    fill_opacity => 0.1,
);
$plot->add_label(4, 2, "I love mathematics.", fontsize => "Large");
$plot->add_label(6, 2, "$y cm.",              h_align  => "left");
$plot->add_label(2, 2, "$y cm.",              h_align  => "right");
$plot->add_label(4, 3, "$x cm.",              v_align  => "bottom");
$plot->add_label(4, 1, "$x cm.",              v_align  => "top");

$altText =
    "The graph of f(x) is shown starting at the point ($a, $b) and increasing "
    . "to the right, sharply at first, and less sharply as it continues to the "
    . "right. The region from x = "
    . ($a + 1)
    . " to x = "
    . ($a + 4)
    . " that is above the x-axis and below the function is shaded.";

BEGIN_PGML
Look at this bookmark. (Notice that cm. is an abbreviation for centimeters)

>>[! !]{$plot}{500} <<
  
What is the distance around the edge of the bookmark?  [_]{Real(2*$x+2*$y)} cm.
 
END_PGML

BEGIN_PGML_SOLUTION
The length around the bookmark (which is called the perimeter   
is the sum of the lengths of the four sides, [`[$x]+[$x]+[$y]+[$y]= [@ 2*$x+2*$y @]`] centimeters.
END_PGML_SOLUTION

ENDDOCUMENT();
