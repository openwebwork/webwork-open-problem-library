## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Newton's method)
## Institution(UCSB)
## MLT(NMEstimateRootToAccuracy)
## Level(3)
## Static(1)
## TitleText1('Calculus: Early Transcendentals')
## AuthorText1('Stewart')
## EditionText1('5')
## Section1('4.9')
## Problem1('11')
## KEYWORDS('Newton's Method','Differentiation')

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "PGcourse.pl"
);

Context("LimitedNumeric");
$x[0] = 3;
for my $i (1,2) {
	$x[$i] = $x[$i-1] - ($x[$i-1]**3 - 30)/(3*$x[$i-1]**2);
}

BEGIN_PGML
Use Newton's method with the given initial approximation to find the third approximation for the following number.

[`\sqrt[3]{30} , x_1 = 3`]

[`x_3 ={}`][_]{$x[2]}

END_PGML

ENDDOCUMENT();
