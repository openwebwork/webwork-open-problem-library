## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Linear approximation and differentials)
## Institution(UCSB)
## MLT(LinearApprox_EstimateFunction_Root)
## Level(3)
## TitleText1('Calculus: Early Transcendentals')
## AuthorText1('Stewart')
## EditionText1('5')
## Section1('3.11')
## Problem1('10')
## KEYWORDS('Differentiation','Product','Quotient')

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "PGcourse.pl"
);

$a = random(5, 9);
do { $b = random(1, 9);} until ($b +$a != 10);
$c = (90+$a)/100;
$d = 1+$b/100;

$ans = Compute('1+x/3');
Context("LimitedNumeric")->operators->redefine('/');
Context()->parens->redefine('(');

BEGIN_PGML
Find a linear approximation of the function [`f(x)=\sqrt[3]{1+x}`] at [`a=0`], 
and use it to approximate the numbers [`\sqrt[3]{[$c]}`] and [`\sqrt[3]{[$d]}`].

[`\sqrt[3]{1+x}\thickapprox{}`][_]{$ans}{30}  
[`\sqrt[3]{[$c]}\thickapprox{}`][_]{Real(1+($c-1)/3)}{20}  
[`\sqrt[3]{[$d]}\thickapprox{}`][_]{Real(1+($d-1)/3)}{20}

END_PGML

ENDDOCUMENT();
