# WeBWorK problem written by Carl Yao
# Portland Community College
#
# Given a graph, find a line's slope-intercept equation.
# Slope is a negative fraction.
#
# Last updated Jordan 8/30/13;
# ENDDESCRIPTION

## DBsubject('Algebra')
## DBchapter('Basic Algebra')
## DBsection('Lines')
## KEYWORDS('coordinate','line','linear','equation','graph','slope','fraction')
## DBCCSS('8.EE','F-IF.7.a')
## TitleText1('')
## EditionText1('')
## AuthorText1('')
## Section1('')
## Problem1('')
## Author('Alex Jordan, Carl Yao, Chris Hughes')
## Institution('PCC')

# Updated by Peter Staab (2022.06) to include alt_text for graph and
# switch to PGML, tikz.

DOCUMENT();

loadMacros(
  "PGtikz.pl",
  "ORCCA.pl",
  "PGstandard.pl",
  "PGML.pl",
  "contextFraction.pl",
  "parserAssignment.pl",
  "PCCgraphMacros.pl",
  "PGcourse.pl",
);

Context('Numeric');

Context("Fraction");
TEXT(beginproblem());



$num=random(1,9,1);
do {$den=random(2,9,1);} until (gcd($den,$num)==1);

$m = -Fraction($num,$den);
$mperl = -$num/$den;

Context("Numeric");
$b = random(-4,4,1);

$x1 = 0;
$y1 = $b;
$x2 = $den;
$y2 = -$num+$b;
$rise = $y2-$y1;
$run = $x2-$x1;

Context("Point");
Context()->parens->set("[" => {type => "Interval", close => "]"});
Context()->parens->set("{" => {type => "Set", close => "}"});
Context()->parens->set("<" => {type => "Vector", close => ">"});
$pt1=Compute("($x1,$y1)");
$pt2=Compute("($x2,$y2)");

Context("Numeric");
Context("Numeric")->variables->add(y=>'Real');
Context()->noreduce('(-x)-y','(-x)+y');
parser::Assignment->Allow;
$ansSI=Formula("y=$m*x+$b")->reduce;

$xmin = -10;
$xmax = -$xmin;
$ymin = -5*(int(abs($y2) /5)+1);
$ymax = -$ymin;
$sizex = 240;
$sizey = 240;

($start,$stop) = (num_sort($xmin,$xmax,($ymin-$b)/$mperl+$h,($ymax-$b)/$mperl+$h))[1,2];

$gr = createTikZImage();
$gr->addToPreamble(latexImagePreamble());
$gr->BEGIN_TIKZ
\begin{axis}[
    xmin = $xmin,
    xmax = $xmax,
    ymin = $ymin,
    ymax = $ymax,
    xtick =,
    ytick =,
    minor xtick = {$xmin,...,$xmax},
    minor ytick = {$ymin,...,$ymax},
    grid = minor,
  ]
  \addplot+[domain=$start:$stop] {$m*x+$b};
  \addplot[soliddot] coordinates {($x1,$y1) ($x2,$y2)};
\end{axis}
END_TIKZ


$ALTtext = "Graph of a coordinate system with a linear function that goes through ($x1,$y1) and ($x2,$y2).";

#The variable ansSIRight is for displaying correct answer.
$ansSIRight=Formula("x+$b")->reduce;

$evaluator = Compute($ansSI)->cmp(
     correct_ans=>"y=-($num/$den)"."$ansSIRight",
     correct_ans_latex_string=>"y=-\frac{$num}{$den}"."$ansSIRight"
);

##############################################

BEGIN_PGML

A line's graph is given. What is this line's slope-intercept equation? 

[@EnlargeImageStatementPGML()@]*

>>[@image($gr, width=>300, extra_html_tags=>'title="$ALTtext" alt="$ALTtext"'  )@]*<<

[__]{$evaluator}{width => 15}

END_PGML

##############################################

Context("Numeric");

$grCorrect = createTikZImage();
$grCorrect->addToPreamble(latexImagePreamble());
$grCorrect->BEGIN_TIKZ
\begin{axis}[
    xmin = $xmin,
    xmax = $xmax,
    ymin = $ymin,
    ymax = $ymax,
    xtick =,
    ytick =,
    minor xtick = {$xmin,...,$xmax},
    minor ytick = {$ymin,...,$ymax},
    grid = minor,
  ]
  \addplot+[domain=$start:$stop] {$m*x+$b};
  \addplot[soliddot] coordinates {($x1,$y1)} node[left] {\(($x1,$y1)\)};
  \addplot[soliddot] coordinates {($x2,$y2)} node[left] {\(($x2,$y2)\)};
  \addplot[guideline] coordinates {($x1,$y1) ($x2,$y1) ($x2,$y2)};
\end{axis}
END_TIKZ

$graph = createTikZImage();
$graph->tikzLibraries("arrows.meta");
$graph->tikzOptions('font = \Large');
$graph->BEGIN_TIKZ
\filldraw[
    draw=LightBlue,
    fill=white,
    rounded corners=10pt,
    thick,use as bounding box
] (-11,-11) rectangle (11,11);
 \draw[thick, ->] (-10.5,0) -- (10.5,0) node [above right] {\(x\)};
 \foreach \x in {-10,-9,...,-1,1,2,...,10} \draw (\x,0.05)--(\x,-0.05) node [below] {\x};
 \draw[thick, ->] (0,-10.5) -- (0,10.5) node [above right] {\(y\)};
 \foreach \y in {-10,-9,...,-1,1,2,...,10} \draw (0.05,\y)--(-0.05,\y) node [left] {\y};
 \draw[thick,<->] ($x1a,$y1a) -- ($x2a,$y2a);
 \draw[thin, lightgray] (-9,-9) grid (9,9);
END_TIKZ

$line = Compute("$m*x+$b");
$alt_text =
    "A line with a y-intercept of $b. Another point on the line is ($XX,$YY).";

BEGIN_PGML
The following is a graph of a line:

>> [! [$alt_text] !]{$graph}{400} <<

$PAR
$BCENTER
\{ image($grCorrect, width=>300, tex_size=>400,
   extra_html_tags=>'title="$ALTtext" alt="$ALTtext"'  ) \}
$ECENTER
$PAR

$solution_graph = createTikZImage();
$solution_graph->tikzLibraries("arrows.meta");

$solution_graph->BEGIN_TIKZ
 \draw[thick] (-10.5,0) -- (10.5,0) node [above right] {\(x\)};
 \foreach \x in {-10,-9,...,-1,1,2,...,10} \draw (\x,0.05)--(\x,-0.05) node [below] {\x};
 \draw[thick] (0,-10.5) -- (0,10.5) node [above right] {\(y\)};
 \foreach \y in {-10,-9,...,-1,1,2,...,10} \draw (0.05,\y)--(-0.05,\y) node [left] {\y};
 \draw[thick,<->] ($x1a,$y1a) -- ($x2a,$y2a);
 \draw[thin] (-9,-9) grid (9,9);
 \draw[red, thick] ($XX,$YY) -- ($XX,$b) node[midway, right] {rise};
 \draw[red, thick] ($XX,$b) -- (0, $b) node[midway, above] {run};
END_TIKZ

$rise = $YY - $b;
$run  = $XX;
Context('Fraction');
$mfrac = Fraction($rise, $run);

$sol_graph_alt_text =
    "alt='A line with a y-intercept of $b. Another point on the line is ($XX,$YY). In addition, a horizontal line is drawn "
    . "from ($XX,$YY) to ($XX,$b) and then a vertical line is drawn from ($XX,$b) to (0,$b)'";

BEGIN_PGML_SOLUTION

A line's slope-intercept equation has the form [` y=mx+b`], where [`m`] is the slope and [`b`] is the [`y`]-intercept. We first find the slope.

>>[@ image($solution_graph, width => 500, tex_size => 1000, extra_html_tags=>"$sol_graph_alt_text") @]*<<

To find the slope of a line from its graph, we identify two points, and then draw a slope triangle. It's wise to choose points with integer coordinates. For this problem, we choose [` (0,[$b])`] and [`([$XX],[$YY])`].

Next, we draw a slope triangle and find the "rise" and "run". In this problem, the rise is [` [$rise]`] and the run is [`[$run]`].

[``\text{slope}=\frac{\text{rise}}{\text{run}}=\frac{[$rise]}{[$run]}=[$mfrac]``]

This line's slope is [`[$mfrac]`].

It's clear in the graph that this line's [`y`]-intercept is [`(0,[$b])`].


So this line's slope-intercept equation is [`y= [$mfrac] x+ [$b]`].

END_PGML_SOLUTION
ENDDOCUMENT();
