# WeBWorK problem written by Chris Hughes, 2013
# Portland Community College
#
# Template:
# Factor the given polynomial
#
#     a x^2 + (b+ac) x + bc
#
# The answer is
#
#     (a x + b)( x + c)
#
# We make sure that gcd(a,b)=1
#
#
# b, c are non-zero, integer on the interval [1,10],
# one of them is positive, one is negative.
#
# We choose a integer on {4,6,8}, which
# makes the problem interesting because
# one starting point for finding the solution
# is
#       (2x- )(2x+ )
#       (3x- )(2x+ )
#       (4x- )(2x+ )
#       (2x+ )(2x- )
#       (3x+ )(2x- )
#       (4x+ )(2x- )
#
# Last updated: Yao 11/15/2016
# ENDDESCRIPTION

## DBCC('A-APR.1','A-SSE.2')
## DBsubject('Algebra')
## DBchapter('Basic Algebra')
## DBsection('Exponents', 'Factoring')
## KEYWORDS('polynomial','trinomial','exponents','factoring')
## Author('Alex Jordan, Carl Yao, Chris Hughes')
## Institution('PCC')

##############################################
DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGML.pl",
  "PCCmacros.pl",
  "contextLimitedFactor.pl",
  "PGgraphmacros.pl",
  "PGchoicemacros.pl",
  "PCCfactor.pl",
  "PGcourse.pl",
);
##############################################

Context("LimitedFactor");
Context()->noreduce('(-x)-y','(-x)+y');
$var = RandomVariableName(type=>'variable');
Context()->variables->are($var=>'Real');

