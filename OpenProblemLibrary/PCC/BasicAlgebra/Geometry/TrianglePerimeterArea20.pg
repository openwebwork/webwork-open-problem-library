# WeBWorK problem written by Carl Yao
# Portland Community College
#
# Find the perimeter and area of a triangle.
#
# Last edited by Jordan 8/29/13;  Carl Yao on 7/17/13
#
# ENDDESCRIPTION

## DBsubject('Algebra')
## DBchapter('Basic Algebra')
## DBsection('Problem Solving with Equations')
## KEYWORDS('area','perimeter','triangle')
## DBCCSS('6.G.1')
## TitleText1('')
## EditionText1('')
## AuthorText1('')
## Section1('')
## Problem1('')
## Author('Alex Jordan, Carl Yao, Chris Hughes')
## Institution('PCC')

##############################################

DOCUMENT();

loadMacros(
    "PGstandard.pl", "PGML.pl",
    'plots.pl',      "parserNumberWithUnits.pl",
    "PGcourse.pl"
);

##############################################

Context("Numeric");

@ar_triples =
    ([ 3, 4, 5 ], [ 5, 12, 13 ], [ 8, 15, 17 ], [ 7, 24, 25 ], [ 20, 21, 29 ]);

$a          = random(0, 4, 1);
$factor     = random(1, 3, 0.5);
$base       = $factor * $ar_triples[$a][0];
$height     = $factor * $ar_triples[$a][1];
$hypotenuse = $factor * $ar_triples[$a][2];

$pict = Plot(
    xmin            => -0.2 * $base,
    xmax            => $base + 0.3 * $base,
    ymin            => -0.1 * $height,
    ymax            => $height + 0.1 * $height,
    xvisible        => 0,
    yvisible        => 0,
    show_grid       => 0,
    rounded_corners => 1,
    aspect_ratio    => 1
);
# width of the plot.
$width = max(250, 100 * $height / $base);
$pict->add_dataset(
    [ 0,     0 ],
    [ $base, 0 ],
    [ $base, $height ],
    [ 0,     0 ],
    color => 'blue'
);
$pict->add_rectangle(
    [ $base - 0.05 * $base, 0 ],
    [ $base,                0.05 * $base ],
    color => 'blue'
);
$pict->add_label($base / 2, 0,           "$base cm",   v_align => 'top');
$pict->add_label($base,     $height / 2, "$height cm", h_align => 'left');
$pict->add_label(
    $base / 2, $height / 2, "$hypotenuse cm",
    v_align => 'bottom',
    h_align => 'right'
);

$perimeter = $base + $height + $hypotenuse;
$area      = $base * $height / 2;
$ansP      = NumberWithUnits("$perimeter cm");
$ansA      = NumberWithUnits("$area cm^2");

$text =
    "a right triangle with legs of lengths $base cm and $height cm, and hypotenuse of length $hypotenuse cm";

BEGIN_PGML

Find the perimeter and area of the right triangle.

>>[![$text]!]{$pict}{$width}<<

    Its perimeter is [_____________]{$ansP} and its area is [_____________]{$ansA}. 

[@KeyboardInstructions(q!(Use [|cm|]* for centimeters and [|cm^2|]* for square centimeters.)!)@]**

END_PGML

##############################################

BEGIN_PGML_SOLUTION

To find the perimeter of a triangle, we simply add up the length of its 3 sides:

[``\begin{aligned}[t]
      \text{triangle perimeter} &= [$base] + [$height] + [$hypotenuse]\\
       & =[$ansP]
     \end{aligned}``]

Don't forget the length unit [`\textrm{cm}`].  
----
A triangle's area formula is:

    [`` \text{triangle area} = \frac{1}{2} \cdot \text{base} \cdot \text{height} ``]

Using this formula, we have:

[``\begin{aligned}[t]
       \text{triangle area} &= \frac{1}{2} \cdot \text{base} \cdot \text{height}\\
       & =\frac{1}{2} \cdot [$base] \cdot [$height] \\
       & =[$ansA]
     \end{aligned}``]

Don't forget the area unit [`\textrm{cm}^{2}`].

END_PGML_SOLUTION

ENDDOCUMENT();
