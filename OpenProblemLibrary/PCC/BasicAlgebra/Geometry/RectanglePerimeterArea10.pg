# WeBWorK problem written by Carl Yao
# Portland Community College

# Find the perimeter and area of a rectangle.

# Last edited by Jordan 8/29/13; Carl Yao on 7/17/13

# ENDDESCRIPTION

## DBsubject('Algebra')
## DBchapter('Basic Algebra')
## DBsection('Problem Solving with Equations')
## KEYWORDS('area','perimeter','rectangle')
## DBCCSS('4.MD.3')
## TitleText1('')
## EditionText1('')
## AuthorText1('')
## Section1('')
## Problem1('')
## Author('Alex Jordan, Carl Yao, Chris Hughes')
## Institution('PCC')

DOCUMENT();

loadMacros(
    'PGstandard.pl',            'PGML.pl',
    'PGgraphmacros.pl',         'plots.pl',
    'parserNumberWithUnits.pl', 'PGcourse.pl'
);

Context("Numeric");

$xmin = 0;    #The viewing window
$xmax = 20;
$ymin = 0;
$ymax = $xmax*$height/$base;

$base   = random(13, 18, 1);
$height = random(8,  12, 1);

@x = (($xmax - $base) / 2, ($xmax + $base) / 2);
@y = (($ymax - $height) / 2, ($ymax + $height) / 2);

$plot = Plot(
    xmin            => -1,
    xmax            => $base + 1.5,
    ymin            => -1,
    ymax            => $height + 1,
    aspect_ratio    => 1,
    xvisible        => 0,
    yvisible        => 0,
    show_grid       => 0,
    rounded_corners => 1
);
$plot->add_rectangle([ 0,   0 ],   [ $base,  $height ],   color => 'blue');
$plot->add_rectangle([ 0,   0 ],   [ 0.5, 0.5 ], color => 'blue');
$plot->add_rectangle([ $base,  0 ],   [ $base-0.5, 0.5 ], color => 'blue');
$plot->add_rectangle([ 0,   $height-0.5 ], [ 0.5, $height ],   color => 'blue');
$plot->add_rectangle([ $base-0.5, $height-0.5 ], [$base,  $height ],   color => 'blue');
$plot->add_label($base/2,  0,   "$base m",   v_align => 'bottom');
$plot->add_label($base, $height/2, "$height m", h_align => 'left');

$perimeter = 2 * ($base + $height);
$area      = $base * $height;
$ansP      = NumberWithUnits("$perimeter m");
$ansA      = NumberWithUnits("$area m^2");

BEGIN_PGML

Find the perimeter and area of the rectangle.

>>[!a rectangle with a base of [$base] m and a height of [$height] m!]{$plot}{400}<<

Its perimeter is [_____________]{$ansP} and its area is [_____________]{$ansA}. 

(Use *m* for meters and *m[$CARET]2* for square meters.)

END_PGML

$refreshCachedImages = 1;
BEGIN_PGML_SOLUTION

We usually use the following formulas for rectangles:

    [` \text{rectangle perimeter} = 2(\text{base}+\text{height}) `]

    [` \text{rectangle area} = \text{base} \cdot \text{height} `]

----
For the given rectangle, we have:

[``\begin{aligned}
       \text{rectangle perimeter}
       & = 2(\text{base}+\text{height})\\
       & = 2([$base]+[$height]) \\
       & = [$ansP]
     \end{aligned}``]

Don't forget the length unit [`\textrm{m}`].  

----

Also,  
[``\begin{aligned}
       \text{rectangle area}
       & = \text{base} \cdot \text{height}\\
       & = [$base] \cdot [$height] \\
       & = [$ansA]
     \end{aligned}``]

    Don't forget the area unit [`\textrm{m}^{2}`].

END_PGML_SOLUTION

ENDDOCUMENT();
