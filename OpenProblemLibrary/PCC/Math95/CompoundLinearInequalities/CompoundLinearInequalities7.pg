## DESCRIPTION
## Algebra, Inequalities
## ENDDESCRIPTION

## KEYWORDS('algebra', 'linear inequality')
## Tagged by jjh2b

## DBsubject('Algebra')
## DBchapter('Equations and Inequalities')
## DBsection('Linear Inequalities')
## Date('')
## Author('')
## Institution('ASU')
## TitleText1('')
## EditionText1('')
## AuthorText1('')
## Section1('')
## Problem1('')


DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGML.pl",
  "PCCmacros.pl",
  "PGcourse.pl",
);

TEXT(beginproblem());

$showPartialCorrectAnswers = 1;

$a =  random(1,30,1);
$b =  random(31,50,1);
$ans1 = 9*$a/5+32;
$ans2 = 9*$b/5+32;
Context("Interval");
$answer = Union("[$ans1,$ans2]");


BEGIN_PGML

Solve the compound inequality algebraically.

[@KeyboardInstructions('Write the solution set in interval notation. If you need to use the [`\infty`] symbol, type [|INF|]*. If you need to use the union symbol [`\cup`], type [|U|]*.')@]**

>>[`` [$a] \le \frac{5}{9}(F-32) \le [$b] ``]<<

[`F`] is in [__]{$answer}{width=>20}

END_PGML

######################################

$c = $a*9/5;
$d = $b*9/5;

BEGIN_PGML_SOLUTION

    [``
\begin{aligned}
  [$a] &\le \frac{5}{9}(F-32) \le [$b] \\
  \mathbf{\frac{9}{5}}([$a]) &\le \mathbf{\frac{9}{5}}\left(\frac{5}{9}(F-32)\right) \le \mathbf{\frac{9}{5}}([$b]) \\
  [$c] &\le F-32 \le [$d] \\
  [$c]\mathbf{+32} &\le F-32\mathbf{+32} \le [$d]\mathbf{+32} \\
  [$ans1] &\le F \le [$ans2] \\
\end{aligned}
    ``]

The solution in interval notation is [`[$answer]`].

END_PGML_SOLUTION

ENDDOCUMENT();        # This should be the last executable line in the problem.
