# WeBWorK problem written by Alex Jordan 
# Portland Community College
# ENDDESCRIPTION




##############################################

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGML.pl",
  "PCCmacros.pl",
  "contextRestrictedDomains.pl",
);

##############################################
TEXT(beginproblem());


Context("RestrictedDomains");
$index = random(0,4,1);
$var[0] = ('x','a','s','p','m')[$index];
$var[1] = ('y','b','t','q','n')[$index];
$var[2] = ('z','c','u','r','k')[$index];
Context()->variables->are($var[0]=>'Real',$var[1]=>'Real',$var[2]=>'Real');

$a = random(2,10,1);
$b = random(1,10,1);
$c = random(1,10,1);

Context()->flags->set(reduceConstants=>0);
$num = Formula("$a+1/($var[1]-$b)");
$den = ($c == 1) ? Formula("1/($var[1]-$b)-1") : Formula("1/($var[1]-$b)-1/$c");
$com = Formula("$c*($var[1]-$b)")->reduce;
$num1 = Formula("$a*$com+1/($var[1]-$b)*$com");
$den1 = ($c == 1) ? Formula("1/($var[1]-$b)*$com-$com") : Formula("1/($var[1]-$b)*$com-1/$c*$com");
$ac = $a*$c;
$num2 = Formula("$ac*($var[1]-$b)+$c");
$den2 = Formula("$c-($var[1]-$b)");
$acb = $ac*$b;
$num3 = Formula("$ac*$var[1]-$acb+$c");
$den3 = Formula("$c-$var[1]+$b");
$e = -$acb+$c;
$num4 = Formula("$ac*$var[1]+$e")->reduce;
$f = $c+$b;
$den4 = Formula("$f-$var[1]");

Context()->variables->are($var[0]=>'Real',$var[1]=>'Real',$var[2]=>'Real');
$ans = Formula("$c ($a $var[1]+(1-$a*$b))/(-$var[1]+($b+$c)), $var[1] != $b")->reduce->reduce;
$ans->{trueDomain} = Compute("$var[1] != $b and $var[1] != $b+$c");

##############################################

BEGIN_PGML

Simplify this expression, and if applicable, write the restricted domain.  [@KeyboardInstructions("The problem accepts many ways to format the answers here, but one way is like typing [|$var[1]^2 for $var[1]!=1 and $var[1]!=2|]* where [|!=|]* is how to type the [`\\neq`] symbol.")@]**

[``\frac{[$num]}{[$den]}=``] [__]{$ans}{width=>40}

END_PGML

##############################################

BEGIN_PGML_SOLUTION

To simply the complex fraction [`\frac{[$num]}{[$den]}`], we multiple the numerator and denominator with the common denominator of [`[$num]`] and [`[$den]`], which is [`[$com]`].

    [``
\begin{aligned}
  \frac{[$num]}{[$den]} &= \frac{([$num])\cdot[$com]}{([$den])\cdot[$com]} \\
    &= \frac{[$num1]}{[$den1]} \\
    &= \frac{[$num2]}{[$den2]} , [$var[1]]\ne[$b] \\
    &= \frac{[$num3]}{[$den3]}, [$var[1]]\ne[$b]  \\
    &= \frac{[$num4]}{[$den4]}, [$var[1]]\ne[$b] \\
    &= [$ans]
\end{aligned}
    ``]

Since the factors [`[$var[1]]-[$b]`] was canceled, the domain condition lost during the simplification is [`[$var[1]] \ne [$b]`].

END_PGML_SOLUTION

ENDDOCUMENT();
