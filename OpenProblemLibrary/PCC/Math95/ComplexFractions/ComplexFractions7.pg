# WeBWorK problem written by Alex Jordan 
# Portland Community College
# ENDDESCRIPTION




##############################################

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGML.pl",
  "PCCmacros.pl",
  "contextRestrictedDomains.pl",
);

##############################################
TEXT(beginproblem());


Context("RestrictedDomains");
$index = random(0,4,1);
$var[0] = ('x','a','s','p','m')[$index];
$var[1] = ('y','b','t','q','n')[$index];
$var[2] = ('z','c','u','r','k')[$index];
Context()->variables->are($var[0]=>'Real',$var[1]=>'Real',$var[2]=>'Real');

$a = non_zero_random(-5,5,1);
$aN = -$a;
$b = non_zero_random(-5,5,1);
$c = random(1,5,1);

Context()->flags->set(reduceConstants=>0);
$num = Formula("1/($var[2]+$a)+$b/($var[2]-$a)")->reduce;
$den = Formula("$c-1/($var[2]-$a)")->reduce;

$com = Formula("($var[2]+$a)($var[2]-$a)")->reduce;
$num1 = Formula("1/($var[2]+$a)*$com+$b/($var[2]-$a)*$com")->reduce;
$den1 = Formula("$c*$com-1/($var[2]-$a)*$com")->reduce;
$num2 = Formula("$var[2]-$a+$b*($var[2]+$a)")->reduce;
$den2 = Formula("$c*($var[2]^2-($a)**2)-($var[2]+$a)")->reduce;
$num3 = Formula("$var[2]-$a+$b*$var[2]+$a*$b")->reduce;
$den3 = Formula("$c*$var[2]^2-($c*($a)**2)-$var[2]-$a")->reduce;
$num4 = Formula("($b+1)*$var[2]+($a*$b-$a)")->reduce->reduce;
$den4 = Formula("$c*$var[2]^2-$var[2]-($a+$c*($a)**2)")->reduce->reduce;
$denAns = Formula("($c*$var[2]-($a*$c+1))*($var[2]+$a)")->reduce;

$g = gcd($b+1,($b-1)*$a);
if (($b+1)<0) {$g = -$g;}
$A = ($b+1)/$g;
$B = ($b-1)*$a/$g;

Context()->variables->are($var[0]=>'Real',$var[1]=>'Real',$var[2]=>'Real');
$ans = Formula("$g($A*$var[2]+$B)/($denAns), $var[2] != $a")->reduce->reduce;
$ans->{trueDomain} = Compute("$var[2] != $a and $var[2] != -$a and $var[2] != $a+1/$c");

##############################################

BEGIN_PGML

Simplify this expression, and if applicable, write the restricted domain.  [@KeyboardInstructions("The problem accepts many ways to format the answers here, but one way is like typing [|$var[2]^2 for $var[2]!=1 and $var[2]!=2|]* where [|!=|]* is how to type the [`\\neq`] symbol.")@]**

[``\frac{[$num]}{[$den]}=``] [__]{$ans}{width=>40}

END_PGML

##############################################

BEGIN_PGML_SOLUTION

To simply the complex fraction [`\frac{[$num]}{[$den]}`], we multiple the numerator and denominator with the common denominator of [`[$num]`] and [`[$den]`], which is [`[$com]`].

    [``
\begin{aligned}
  \frac{[$num]}{[$den]} &= \frac{([$num])\cdot[$com]}{([$den])\cdot[$com]} \\
    &= \frac{[$num1]}{[$den1]} \\
    &= \frac{[$num2]}{[$den2]}, [$var[2]] \ne [$a] \text{ and }  [$var[2]] \ne [$aN] \\
    &= \frac{[$num3]}{[$den3]}, [$var[2]] \ne [$a] \text{ and }  [$var[2]] \ne [$aN] \\
    &= \frac{[$num4]}{[$den4]}, [$var[2]] \ne [$a] \text{ and }  [$var[2]] \ne [$aN] \\
    &= [$ans]
\end{aligned}
    ``]

Since [`[$var[2]]-[$a]`] was canceled, [`[$var[2]] \ne [$a]`] is a lost domain condition.

Although [`[$var[2]]+[$a]`] was also canceled, [`[$var[2]] \ne [$aN]`] is not a lost domain condition because it is implied in the solution.

END_PGML_SOLUTION

ENDDOCUMENT();
