# WeBWorK problem written by Alex Jordan 
# Portland Community College
# ENDDESCRIPTION




##############################################

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGML.pl",
  "PCCmacros.pl",
  "contextRestrictedDomains.pl",
);

##############################################
TEXT(beginproblem());


Context("RestrictedDomains");
$index = random(0,4,1);
$var[0] = ('x','a','s','p','m')[$index];
$var[1] = ('y','b','t','q','n')[$index];
$var[2] = ('z','c','u','r','k')[$index];
Context()->variables->are($var[0]=>'Real',$var[1]=>'Real',$var[2]=>'Real');

$a = random(2,10,1);
$b = non_zero_random(2,10,1);


$num = Formula("$a+1/$var[0]")->reduce;
$den = Formula("$var[0]+$b")->reduce;

$com = Formula("$var[0]")->reduce;

$numAns = Formula("$a $var[0]+1")->reduce;
$denAns = Formula("$var[0]*($var[0]+$b)")->reduce;

Context()->variables->are($var[0]=>'Real',$var[1]=>'Real',$var[2]=>'Real');
$ans = Formula("($a $var[0]+1)/($var[0]*($var[0]+$b)), (-inf, inf)")->reduce;
$ans->{trueDomain} = Compute("$var[0] != 0 and $var[0] != -$b");

##############################################

BEGIN_PGML

Simplify this expression, and if applicable, write the restricted domain.  [@KeyboardInstructions("The problem accepts many ways to format the answers here, but one way is like typing [|$var[0]^2 for $var[0]!=1 and $var[0]!=2|]* where [|!=|]* is how to type the [`\\neq`] symbol.")@]**

[``\frac{[$num]}{[$den]}=``] [__]{$ans}{width=>40}

END_PGML

##############################################

BEGIN_PGML_SOLUTION

To simply the complex fraction [`\frac{[$num]}{[$den]}`], we multiple the numerator and denominator with the common denominator of [`[$num]`] and [`[$den]`], which is [`[$com]`].

    [``
\begin{aligned}
  \frac{[$num]}{[$den]} &= \frac{([$num])\cdot[$com]}{([$den])\cdot[$com]} \\
    &= \frac{[$numAns]}{[$denAns]}
\end{aligned}
    ``]

Although [`[$com]`] was canceled, [`[$var[0]] \ne 0`] is implied in the solution. There is no need to treat [`[$var[0]] \ne 0`] as a lost condition.

END_PGML_SOLUTION


ENDDOCUMENT();
