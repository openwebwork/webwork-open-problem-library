## DBsubject(Geometry)
## DBchapter(Circle geometry)
## DBsection(Circumference and area)
## Institution(GRPS)
## Author(Louise Wilson)
## Level(3)
## KEYWORDS('area', 'circle')
## RESOURCES('area7.gif')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'plots.pl', 'PGcourse.pl');

$r1 = random(1, 4,  .1);
$r2 = random(6, 10, .1);

$plot = Plot(
    xmin            => -1.1,
    xmax            =>  1.1,
    ymin            => -1.1,
    ymax            =>  1.1,
    show_grid       =>  0,
    xvisible        =>  0,
    yvisible        =>  0,
    rounded_corners => 1
);

$plot->add_circle(
    [ [ 0, 0 ], 1, fill => 'self', fill_color => 'yellow' ],
    [
        [ 0, 0 ], 0.6,
        fill         => 'self',
        fill_color   => 'white',
        fill_opacity => 1
    ]
);

$plot->add_dataset(
    [ cos(pi / 3),       sin(pi / 3), 1 ],
    [ 0,                 0 ],
    [ 0.6 * cos(pi / 8), 0.6 * sin(pi / 8) ],
    layer => 'axis foreground'
);
$plot->add_label(0.4, 0.05, "r = $r1 cm");
$plot->add_label(0,   0.35, "r = $r2 cm");

$area = Real("pi*($r2^2 - $r1^2)");

$img_description = <<"END";
An image of two circles with the same center.  The radius of 
the outer circle is $r2 cm and the radius of the inner circle is
$r1 cm.  The shaded area is that between the two circles.
END

BEGIN_PGML

>>[!!]{$plot}{350}{long_description => $img_description}<<

The radius of the small circle is [` = [$r1] `] cm.  
The radius of the large circle is [` = [$r2] `] cm.

Find the area of the shaded annulus: [_]{$area}{10} [` cm ^2 `]

END_PGML
BEGIN_PGML_SOLUTION
The area of the shaded annulus is the area of the outer circle minus the area of the inner circle:

[``` A = \pi r_1^2 - \pi r_2^2 = \pi ([$r2])^2 - \pi ([$r1])^2 = [$area] ```]
END_PGML_SOLUTION

ENDDOCUMENT();
 