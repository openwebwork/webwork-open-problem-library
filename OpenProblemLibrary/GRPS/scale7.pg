## DBsubject(Geometry)
## DBchapter(Circle geometry)
## DBsection(Circumference and area)
## Institution(GRPS)
## Author(Louise Wilson)
## Level(3)
## KEYWORDS('scale', 'area')
## RESOURCES('ratio7.gif')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'plots.pl', 'PGcourse.pl');

$showPartialCorrectAnswers = 1;

#define the variables
$a = random(3, 9, .5);

$s = random(2, 7, 1);

$d = $a / $s;

$a1 = pi * $a * $a;
$a2 = $a1 / ($s**2);

$graph = Plot(xmin => 0, xmax => 10, ymin =>0, ymax => 6, aspect_ratio => 1, xvisible => 0, yvisible => 0);
$graph->add_circle([3,3], 2.5, color => 'darkgreen');
$graph->add_dataset([3,3],[3+2.5*cos(140*pi/180),3+2.5*sin(140*pi/180)], marks => 'circle');
$graph->add_label(2,2,'circle 1');
$graph->add_label(2.25,4.25,'\\(r_1\\)');
$graph->add_circle([8,3], 1.5, color => 'darkgreen');
$graph->add_dataset([8,3],[8+1.5*cos(20*pi/180),3+1.5*sin(20*pi/180)], marks => 'circle');
$graph->add_label(8,5,'circle 2');
$graph->add_label(8.5,3.6,'\\(r_2\\)');

BEGIN_PGML
>>[!!]{$graph}{400} <<
The radii of circle 1 and circle 2 are [` r _1 = [$a] , r _2 = [$d] `]   

a) What is the area of Circle 1? [_]{$a1}{5} [` cm ^2  `]

b) What is the area of Circle 2?  [_]{$a2}{5} [` cm ^2 `]

END_PGML


ENDDOCUMENT();