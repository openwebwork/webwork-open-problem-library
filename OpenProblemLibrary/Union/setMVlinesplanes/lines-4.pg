## DESCRIPTION
##   Parametric Equation for a Line
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Lines)
## Date(8/23/07)
## Institution(Union College)
## MLT(lin_recover_point_vector_from_eqn)
## MLTleader(1)
## Level(3)
## MO(1)
## KEYWORDS('Parametric', 'Line', 'Vector')

DOCUMENT();    # This should be the first executable line in the problem.

loadMacros('PGstandard.pl', 'PGML.pl', 'parserVectorUtils.pl', 'PGcourse.pl');

Context("Vector")->variables->are(t => 'Real');
Context()->reduction->set('(-x)-y' => 0);

#  The line p + tv
$P = non_zero_point3D();
$V = non_zero_vector3D();

$L = Line($P, $V);

BEGIN_PGML
Suppose a line is given parametrically by the equation


>>
[`L(t) = [$L]`]
<<

Then the vector and point that were used to define this line were

a) [`\vec{v} = \;`] [_]{$V}

b) [`P = \;`] [_]{$P}

END_PGML

ENDDOCUMENT();
