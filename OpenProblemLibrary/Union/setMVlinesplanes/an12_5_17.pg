## DESCRIPTION
##   Parametric Equation for a Line
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Lines)
## Date(8/23/07)
## Institution(Union College)
## Level(3)
## MO(1)
## TitleText1('Calculus')
## AuthorText1('Anton')
## EditionText1('7')
## Section1('12.5')
## Problem1('17')
## KEYWORDS('Line', 'Parametric', 'Parallel')

DOCUMENT();
loadMacros(
    'PGstandard.pl',        'PGML.pl',
    'parserVectorUtils.pl', 'parserParametricLine.pl',
    'PGcourse.pl'
);

Context("ParametricLine");

#  The points line p + tv
$p = non_zero_point3D();
$v = non_zero_vector3D();
$L = ParametricLine($p, $v);

#  The other point and line
do { $Q = non_zero_point3D() } until $Q != $p;

$L2 = ParametricLine($Q, $v);

BEGIN_PGML
Give a vector parametric equation for the line
through the point [`[$Q]`] that is parallel
to the line [`[$L]`]:

    [`L(t)= \;`] [_]{$L2}.

END_PGML
ENDDOCUMENT();
