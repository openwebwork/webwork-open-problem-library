## DESCRIPTION
##   Intersection of Lines and Curves
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Lines)
## Date(8/23/07)
## Institution(Union College)
## Level(3)
## MO(1)
## TitleText1('Calculus')
## AuthorText1('Anton')
## EditionText1('7')
## Section1('12.5')
## Problem1('19')
## KEYWORDS('Intersection', 'Line', 'Parametric', 'Parabola')

DOCUMENT();
loadMacros(
    'PGstandard.pl',      'PGML.pl', 
    'parserParametricLine.pl', 'parserVectorUtils.pl',
    'PGcourse.pl'
);

Context("Vector")->variables->are(t => 'Real');
Context()->reduction->set('(-x)-y' => 0);

#  The points line p + tv
($v0, $v1) = (non_zero_random(-5, 5), non_zero_random(-5, 5));
$x0 = non_zero_random(-5, 5);
$y0 = $x0 * $x0 + random(1, 3);    # make sure the line crosses y = x^2

$v = Vector($v0, $v1);
$p = Point($x0, $y0);
$L = ParametricLine($p, $v);

#  The intersection with the axes:
$tx = Real(-$y0 / $v1);
$X  = Point($L->eval(t => $tx));
$ty = Real(-$x0 / $v0);
$Y  = Point($L->eval(t => $ty));

#  The intersection with y = x^2
$a  = $v0 * $v0;
$b  = 2 * $x0 * $v0 - $v1;
$c  = $x0 * $x0 - $y0;
$t1 = (-$b + sqrt($b * $b - 4 * $a * $c)) / (2 * $a);
$t2 = (-$b - sqrt($b * $b - 4 * $a * $c)) / (2 * $a);

$P1 = Point($L->eval(t => $t1));
$P2 = Point($L->eval(t => $t2));

BEGIN_PGML
Consider the line [`L(t) = [$L]`]. Then [`L`] intersects:

a) The [`x`]-axis at the point [_]{$X} when
[`t`] = [_]{$tx}.

b) The [`y`]-axis at the point [_]{$Y} when
[`t`] = [_]{$ty}.

c) The parabola [`y = x^2`] at the points [_]{List($P1,$P2)} when 
[`t`] = [_]{List($t1,$t2)}

*Note:* If there are more than one point that intersects, separate by commas. 
END_PGML

ENDDOCUMENT();
