## DESCRIPTION
##   Parametric Equation for a Line
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Lines)
## Date(8/23/07)
## Institution(Union College)
## MLT(lin_find_vec_eqn_point_vector)
## Level(3)
## MO(1)
## KEYWORDS('Parametric', 'Line', 'Vector')

DOCUMENT();    # This should be the first executable line in the problem.

loadMacros(
    'PGstandard.pl',           'PGML.pl',     'parserVectorUtils.pl',
    'parserParametricLine.pl', 'PGcourse.pl'
);

#  Setup

Context("ParametricLine");

#  The line p+tv

$P = non_zero_point3D();
$V = non_zero_vector3D();

$L = ParametricLine($P, $V);

BEGIN_PGML

Write the line through [`p = [$P]`]in the direction of [`\vec{v} = [$V]`]
in vector parametric form:

    [`L(t)=\;`] [_]{$L}
END_PGML

ENDDOCUMENT();
