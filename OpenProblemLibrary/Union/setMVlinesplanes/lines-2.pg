## DESCRIPTION
##   Parametric Equation for a Line
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Lines)
## Date(8/23/07)
## Institution(Union College)
## MLT(lin_find_vec_eqn_two_points)
## Level(3)
## MO(1)
## KEYWORDS('Parametric', 'Line', 'Vector')

DOCUMENT();        # This should be the first executable line in the problem.

loadMacros('PGstandard.pl', 'PGML.pl', 'parserParametricLine.pl', 'parserVectorUtils.pl', 'PGcourse.pl');

Context("ParametricLine");

do {
$A = non_zero_point3D();
$B = non_zero_point3D(); 
    } until $A != $B;

$L = ParametricLine($A,Vector($B-$A));

BEGIN_PGML

The vector parametric equation for the line through
the points [`[$A]`] and [`[$B]`] is

    [`L(t)=\;`] [_]{$L}.
END_PGML

ENDDOCUMENT();