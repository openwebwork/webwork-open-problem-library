## DESCRIPTION
##   Parametric Equation for a Tangent Line
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Calculus - single variable)
## DBchapter(Parametric)
## DBsection(Tangents, velocity, and speed)
## Date(8/23/07)
## Institution(Union College)
## Level(3)
## MO(1)
## KEYWORDS('Parametric', 'Line', 'Tangent')

DOCUMENT();    # This should be the first executable line in the problem.

loadMacros(
    'PGstandard.pl',        'PGML.pl',
    'parserVectorUtils.pl', 'parserParametricLine.pl',
    'PGcourse.pl'
);

#  Setup

Context("Numeric")->variables->are(x => 'Real');
$x = Formula('x');

#  Function

$a  = random(2, 6);
$b  = non_zero_random(-5, 5);
$c  = random(-5, 5);
$f  = Compute("$a x^2 + $b x + $c")->reduce;
$df = $f->D->reduce;

#  Tangent Line

Context("ParametricLine");

$x0 = non_zero_random(-3, 3, 1);
$L  = ParametricLine(Point($x0, $f->eval(x => $x0)),
    Vector(1, $df->eval(x => $x0)));

BEGIN_PGML
The parametric form for the tangent line to the graph of [`y = [$f]`]
at [`x = [$x0]`] is [_]{$L}.
END_PGML

ENDDOCUMENT();
