## DESCRIPTION
##   Intersection of a Line and Plane
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Lines with planes)
## Date(8/23/07)
## Institution(Union College)
## Level(2)
## MO(1)
## TitleText1('Calculus')
## AuthorText1('Anton')
## EditionText1('7')
## Section1('12.6')
## Problem1('31')
## TitleText2('Calculus: Early Transcendentals')
## AuthorText2('Rogawski')
## EditionText2('1')
## Section2('12.5')
## Problem2('31')
## KEYWORDS('Line', 'Plane', 'Parametric', 'Intersection')

DOCUMENT();    # This should be the first executable line in the problem.

loadMacros(
    'PGstandard.pl',           'PGML.pl',
    'parserVectorUtils.pl',    'parserImplicitPlane.pl',
    'parserParametricLine.pl', 'PGcourse.pl'
);

#  Setup

Context("ImplicitPlane");

#  The plane

$N = non_zero_vector3D();
$P = non_zero_point3D();

$PLANE = ImplicitPlane($P, $N);

#  The line (making sure it is not parallel to N)

$v = non_zero_vector3D();
while ((areParallel $v $N) || $v . $N == 0) { $v = non_zero_vector3D() }

$t = Real(non_zero_random(-3, 3, 1));
$p = Point($P - $t * $v);

Context()->variables->add(t => 'Real');

$LINE = ParametricLine($p, $v);

BEGIN_PGML

The line [`L(t) = [$LINE]`] intersects the plane
[`[$PLANE]`] at the point [_]{$P}
when [`t`] = [_]{$t}.

END_PGML
ENDDOCUMENT();
