## DESCRIPTION
##   Relating Equations of Lines and Planes
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Lines with planes)
## Date(8/23/07)
## Institution(Union College)
## Level(3)
## TitleText1('Calculus')
## AuthorText1('Anton')
## EditionText1('7')
## Section1('12.6')
## Problem1('15')
## KEYWORDS('Line', 'Plane', 'Perpendicular', 'Normal', 'Parallel')

DOCUMENT();
loadMacros(
    'PGstandard.pl',          'PGML.pl', 'parserParametricLine.pl',
    'parserImplicitPlane.pl', 'parserVectorUtils.pl',
    'parserPopUp.pl',         'PGcourse.pl'
);

Context("Vector")->variables->are(t => 'Real');
Context()->reduction->set('(-x)-y' => 0);

#  The line p + tv
$v = non_zero_vector3D();
$p = non_zero_point3D();
$L = ParametricLine($p, $v);

#  Some parallel planes
do {
    $N[0] = $v x non_zero_vector3D();
    $p[0] = non_zero_point3D();
} while norm($N[0] x $v) == 0;

do {
    $N[1] = $v x non_zero_vector3D();
    $p[1] = non_zero_point3D();
} while norm($N[1] x $v) == 0;

#  Some perpendicular planes
$N[2] = (3 / 2) * $v;
$p[2] = non_zero_point3D();
$N[3] = -2 * $v;
$p[3] = non_zero_point3D();

#  Some other planes
$N[4] = non_zero_vector3D();
$p[4] = non_zero_point3D();
$N[5] = non_zero_vector3D();
$p[5] = non_zero_point3D();

Context("ImplicitPlane");

@shuffle = random_subset(4, 0 .. 5);

@plane = map { ImplicitPlane($p[$_], $N[$_]) } @shuffle;

@dd = map { DropDown([ 'parallel', 'perpendicular', 'neither' ], $_) }
    (0, 0, 1, 1, 2, 2);

BEGIN_PGML

Consider the line [`L(t) = [$L]`].  Then:

a) [`L`] is [_]{$dd[$shuffle[0]]} to the plane [` [$plane[0]] `]

b) [`L`] is [_]{$dd[$shuffle[1]]} to the plane [` [$plane[1]] `]

c) [`L`] is [_]{$dd[$shuffle[2]]} to the plane [` [$plane[2]] `]

d) [`L`] is [_]{$dd[$shuffle[3]]} to the plane [` [$plane[3]] `]


END_PGML

ENDDOCUMENT();
