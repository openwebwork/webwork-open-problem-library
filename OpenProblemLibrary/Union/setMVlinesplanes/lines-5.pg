## DESCRIPTION
##   Parallel and Perpendicular Lines
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Lines)
## Date(8/23/07)
## Institution(Union College)
## MLT(lin_classify_two_lines)
## Level(2)
## KEYWORDS('Line', 'Parametric', 'Parallel', 'Perpendicular')

DOCUMENT();
loadMacros(
    'PGstandard.pl',           'PGML.pl',
    'parserParametricLine.pl', 'parserPopUp.pl',
    'parserVectorUtils.pl',    'PGchoicemacros.pl',
    'PGcourse.pl'
);

Context("Vector")->variables->are(t => 'Real');
Context()->reduction->set('(-x)-y' => 0);

#  The line p + tv

$v = non_zero_vector2D();
($a, $b) = $v->value;
$p = non_zero_point2D();

$L = Compute("$v t") + Vector($p);

#  Some perpendicular lines

$w[0] = Vector(-2 * $b, 2 * $a);
$p[0] = non_zero_point2D();
$w[1] = Vector(3 * $b, -3 * $a);
$p[1] = non_zero_point2D();

#  Some parallel lines

$w[2] = (3 / 2) * $v;
$p[2] = non_zero_point2D();
$w[3] = -2 * $v;
$p[3] = non_zero_point2D();

#  Some other lines
do {
    $w[4] = non_zero_vector2D();
    $p[4] = non_zero_point2D();
    $w[5] = non_zero_vector2D();
    $p[5] = non_zero_point2D();
} until !$w[4]->isParallel($v)
    && !$w[5]->isParallel($v)
    && $v . $w[4] != 0
    && $v . $w[5] != 0;

@shuffle = random_subset(4, 0 .. 5);

# create the lines from the vectors w and point p and
# make a Vector that is formatted nicely.
sub makeLine {
    ($v,  $p)  = @_;
    ($vx, $vy) = $v->value;
    ($px, $py) = $p->value;
    return "<$vx t + $px, $vy t + $py>";
}

@line = map { ParametricLine(makeLine($w[$_], $p[$_]))->reduce } @shuffle;

@dd = map { DropDown([ 'parallel', 'perpendicular', 'neither' ], $_) }
    (1, 1, 0, 0, 2, 2);

BEGIN_PGML

Consider the line [`L(t) = [$L]`].  Then:

a) [`L`] is [_]{$dd[$shuffle[0]]} to the line [` [$line[0]] `]

b) [`L`] is [_]{$dd[$shuffle[1]]} to the line [` [$line[1]] `]

c) [`L`] is [_]{$dd[$shuffle[2]]} to the line [` [$line[2]] `]

d) [`L`] is [_]{$dd[$shuffle[3]]} to the line [` [$line[3]] `]

END_PGML

ENDDOCUMENT();
