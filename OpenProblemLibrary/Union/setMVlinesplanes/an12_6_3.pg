## DESCRIPTION
##   Implicit Equation for a Plane
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Planes)
## Date(8/23/07)
## Institution(Union College)
## MLT(planes_eqn_given_point_and_n)
## Level(3)
## MO(1)
## TitleText1('Calculus')
## AuthorText1('Anton')
## EditionText1('7')
## Section1('12.6')
## Problem1('2')
## TitleText2('Calculus: Early Transcendentals')
## AuthorText2('Rogawski')
## EditionText2('1')
## Section2('12.5')
## Problem2('2')
## KEYWORDS('Implicit', 'Plane', 'Normal')

DOCUMENT(); 
loadMacros('PGstandard.pl', 'PGML.pl', 'parserImplicitPlane.pl', 'parserVectorUtils.pl', 'PGcourse.pl');

Context("ImplicitPlane");

#  The plane N.(x,y,z) = N.p
$N = non_zero_vector3D();
$p = non_zero_point3D();

BEGIN_PGML
An implicit equation for the plane through [`[$p]`] normal to
the vector [`[$N]`] is [_]{ImplicitPlane($p, $N)}

END_PGML

ENDDOCUMENT();