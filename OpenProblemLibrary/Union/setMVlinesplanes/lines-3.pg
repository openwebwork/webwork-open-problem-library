## DESCRIPTION
##   Parametric Equation for a Line
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Lines)
## Date(8/23/07)
## Institution(Union College)
## MLT(lin_recover_point_vector_from_eqn)
## Level(3)
## MO(1)
## KEYWORDS('Parametric', 'Line', 'Vector')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'parserVectorUtils.pl', 'PGcourse.pl');

Context("Vector")->variables->are(t => 'Real');
Context()->reduction->set('(-x)-y' => 0);
$t = Formula('t');

#  The line p + tv
$P = non_zero_point3D();
($x0, $y0, $z0) = $P->value;
$V = non_zero_vector3D();
($a, $b, $c) = $V->value;

$x = ($x0 + $a * $t)->reduce;
$y = ($y0 + $b * $t)->reduce;
$z = ($z0 + $c * $t)->reduce;

BEGIN_PGML

Suppose a line is given by the system of equations
[```
\begin{aligned}
x & = [$x], \\
y & = [$y], \\
z & = [$z].
\end{aligned}
```]

Then the vector and point that were used to define this line
were

a) [``\vec{v} = \;``] [_]{$V}

b) [``P = \;``] [_]{$P}

END_PGML

ENDDOCUMENT();
