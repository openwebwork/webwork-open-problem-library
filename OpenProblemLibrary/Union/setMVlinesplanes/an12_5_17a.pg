## DESCRIPTION
##   Parametric Equation for a Line
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Lines)
## Date(8/23/07)
## Institution(Union College)
## Level(3)
## MO(1)
## TitleText1('Calculus')
## AuthorText1('Anton')
## EditionText1('7')
## Section1('12.5')
## Problem1('17')
## KEYWORDS('Line', 'Parametric', 'Perpendicular')

DOCUMENT();
loadMacros(
    'PGstandard.pl',        'PGML.pl',
    'parserVectorUtils.pl', 'parserParametricLine.pl',
    'PGcourse.pl'
);

Context("ParametricLine");

#  The points line p + tv
$p = non_zero_point2D();
$v = non_zero_vector2D();
$L = ParametricLine($p, $v);

#  The other point
do { $Q = non_zero_point2D(); } until $Q != $p;

#  The perpendicular line through Q
($a, $b) = $v->value;
$L2 = ParametricLine($Q, Vector(-$b, $a));

BEGIN_PGML
Give a vector parametric equation for the line, [`L(t)`]
through the point [`[$Q]`] that is perpendicular
to the line [`S(t) = [$L]`]:

    [`L(t)= \;`] [_]{$L2}.

END_PGML
ENDDOCUMENT();
