## DESCRIPTION
##   Distance from a Point to a Line
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Calculus - multivariable)
## DBchapter(Calculus of vector valued functions)
## DBsection(Parameterized curves)
## Date(8/23/07)
## Institution(Union College)
## Level(4)
## MO(1)
## TitleText1('Calculus')
## AuthorText1('Anton')
## EditionText1('7')
## Section1('12.3')
## Problem1('25')
## KEYWORDS('Vector', 'Distance', 'Point', 'Line', 'Dot Product', 'Projection')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'parserVectorUtils.pl', 'PGcourse.pl');

Context("Vector")->variables->are(t => 'Real');

#  The point P and the line p+tv

do {
    $P  = non_zero_point3D();
    $p  = non_zero_point3D();
    $v  = non_zero_vector3D();
    $pP = Vector($P - $p);
} until ($pP . $v != 0);

$L = Line($p, $v);

#  The projection and distance

$perp = $pP - (($pP . $v) / ($v . $v)) * $v;
$D    = norm($perp);

#  Main text

BEGIN_PGML

Consider the line [`L(t) = [$L]`] and the point [`P = [$P]`].

How far is [`P`] from the line [`L`]? [_]{$D}

END_PGML

BEGIN_PGML_HINT
Find the vector parallel to the line [`L(t)`] and use the projection. 
END_PGML_HINT

ENDDOCUMENT();
