## DESCRIPTION
##   Make two Vectors Equal
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Vectors and vector arithmetic)
## Date(8/23/07)
## Institution(Union College)
## MLT(va_lc_param)
## Level(2)
## MO(1)
## KEYWORDS('Vector', 'Equal')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'parserVectorUtils.pl', 'PGcourse.pl');

Context("Vector")->variables->are(s => 'Real', t => 'Real');

do {
    $p = non_zero_random(-4, 4);
    $q = non_zero_random(-4, 4);
    $r = non_zero_random(-4, 4);
} while (abs($r) == abs($p) || abs($r) == abs($q));

$a = $p + $r;
$f = $p - $r;
$d = $q + $r;
$h = $q - $r;

$b = non_zero_random(-4, 4);
$g = non_zero_random(-4, 4);
$c = random(1, 4);
$e = random(1, 4);

$V = Formula("<$a t + $b,$c s + $d t>")->reduce;
$W = Formula("<$e s + $f t,$g + $h t>")->reduce;

#  The point of crossing

$t = Real(($e * $g - $c * $b) / (2 * $r * ($c + $e)));
$s = Real(($b + $g) / ($c + $e));

$P = Vector($a * $t + $b, $c * $s + $d * $t);

BEGIN_PGML
For what values of [`t`] and [`s`] does the equality
[```[$V] = [$W]```]
hold true?

[`t`] = [_]{$t} and [`s`] = [_]{$s}

At these values, the resulting vector is [_]{$P}

END_PGML

ENDDOCUMENT();
