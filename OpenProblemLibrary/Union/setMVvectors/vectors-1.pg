## DESCRIPTION
##   Working with Vectors
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Dot product, length, and unit vectors)
## Date(8/23/07)
## Institution(Union College)
## MLT(VectorLotsOfParts)
## Level(2)
## MO(1)
## TitleText1('Calculus: Early Transcendentals')
## AuthorText1('Rogawski')
## EditionText1('1')
## Section1('12.1')
## Problem1('5 33')
## KEYWORDS('Vector', 'Tip', 'Tail', 'Length')

DOCUMENT();    # This should be the first executable line in the problem.

loadMacros(
    'PGstandard.pl',           'PGML.pl',
    'contextLimitedVector.pl', 'parserVectorUtils.pl',
    'PGcourse.pl'
);

#  Setup

Context("Vector");

# the points P and Q
$P = non_zero_point2D(-5, 5, .1);
$Q = non_zero_point2D(-5, 5, .1);
while ($P == $Q) { $Q = non_zero_point2D(-5, 5, .1) }

$PQ = Vector($Q - $P);

# another 2 points
do {
    $X = non_zero_point2D(-5, 5, .1);
    $Y = non_zero_point2D(-5, 5, .1);
} until $X != $P && $Y != $Q;

BEGIN_PGML

Consider the vector [`\vec{v}`] between [`[$P]`] and [`[$Q]`].

a) The vector [`\vec{v}`] is [_]{$PQ}.

b) The length of [`\vec{v}`] is [_]{norm($PQ)}.

c) If the tail of [`\vec{v}`] is at [`[$X]`], then the tip is at [_]{Point($X+$PQ)}.

d) If the tip of [`\vec{v}`] is at [`[$Y]`] then its tail is at [_]{Point($Y-$PQ)}.

e) What vector has the same length as [`\vec{v}`], but points in the opposite
direction? [_]{-$PQ}.

f) What vector has the same direction as [`\vec{v}`], but is twice as long?
[_]{2*$PQ}.

END_PGML

ENDDOCUMENT();
