## DESCRIPTION
##   Find a Perpendicular Vector
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Dot product, length, and unit vectors)
## Date(8/23/07)
## Institution(Union College)
## MLT(planes_vector_parallel_to_smth)
## Level(3)
## MO(1)
## KEYWORDS('Vector', 'Parallel', 'Perpendicular', 'Plane')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'parserVectorUtils.pl', 'PGcourse.pl');

Context("Vector");

$V = non_zero_vector3D();
$V->data->[2] = non_zero_random(-5, 5) if $V->isParallel([ 1, 0, 0 ]);

#  A vector parallel to the yz-plane but perpendicular to v
$U = $V x [ 1, 0, 0 ];

BEGIN_PGML

Find a vector [`\vec{u}`] that is parallel to the [`yz`]-plane and
perpendicular to the vector [`\vec{v} = [$V]`].

    [``\vec{u}=\;``] [_]{$U->cmp(parallel=>1)}

END_PGML

BEGIN_PGML_HINT
Can you find a second vector that must be perpendicular to [`\vec{u}`]?
END_PGML_HINT
ENDDOCUMENT();
