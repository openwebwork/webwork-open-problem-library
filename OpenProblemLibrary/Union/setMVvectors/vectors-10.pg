## DESCRIPTION
##   Compute Cross Products
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Cross product)
## Date(8/23/07)
## Institution(Union College)
## MLT(Cross_Product_Compute)
## Level(2)
## MO(1)
## TitleText1('Calculus: Early Transcendentals')
## AuthorText1('Rogawski')
## EditionText1('1')
## Section1('12.4')
## Problem1('11 12 13 14 15 16')
## KEYWORDS('Vector', 'Cross Product')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'parserVectorUtils.pl', 'PGcourse.pl');

Context("Vector");

#  The vectors u and v
$U = non_zero_vector3D();
$V = non_zero_vector3D();

$ans1 = $U x $V;
$ans2 = $V x $U; 
# This prevents students from using the cross product.

Context()->operators->undefine('><');

BEGIN_PGML

Suppose [`\vec{u} = [$U]`] and [`\vec{v} = [$V]`].  Then

a) [``\vec{u} \times \vec{v}``] is [_]{$ans1}

b) [``\vec{v} \times \vec{u} ``] is [_]{$ans2}


END_PGML
ENDDOCUMENT();