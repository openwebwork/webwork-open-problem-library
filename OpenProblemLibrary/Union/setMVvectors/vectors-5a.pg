## DESCRIPTION
##   Make two Vectors Equal
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Vectors and vector arithmetic)
## Date(8/23/07)
## Institution(Union College)
## Level(2)
## MO(1)
## KEYWORDS('Vector', 'Equal')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context("Vector");
Context()->variables->are(t => 'Real');
Context()->flags->set(reduceConstants => 0);

$b = random(1, 5);
$c = random(1, 5);
$a = random(1, 5) + $c;

$d = $b * ($a - $c);

#  The vectors to make equal

$V = Formula("<t^3 - $d t, $b1 t^2 + $c>")->reduce;
$W = Vector(0, $a);

#  the times when they are equal

$t1 = sqrt($d);
$t2 = -sqrt($d);

BEGIN_PGML
For what value(s) of [`t`] does the equality
[``` [$V] = [$W]```]
hold true?

[``t=\;``] = [_]{List($t1, $t2)}

(If there are more than one value, separate them by commas.)

END_PGML

ENDDOCUMENT();
