## DESCRIPTION
##   Working with Vectors
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Dot product, length, and unit vectors)
## Date(8/23/07)
## Institution(Union College)
## MLT(FindMultipleLengths)
## Level(2)
## MO(1)
## TitleText1('Calculus: Early Transcendentals')
## AuthorText1('Rogawski')
## EditionText1('1')
## Section1('12.2')
## Problem1('21 19')
## KEYWORDS('Vector', 'Norm')

DOCUMENT();    # This should be the first executable line in the problem.

loadMacros(
    'PGstandard.pl',        'contextLimitedVector.pl',
    'parserVectorUtils.pl', 'PGML.pl',
    'PGcourse.pl'
);

#  Setup

Context("Vector");

# the vectors
$U = non_zero_vector3D();
$V = non_zero_vector3D();

# some coefficients
do {
    ($a, $b, $c, $d) =
        (random(2, 8), random(2, 8), random(2, 8), random(2, 8));
} until $a != $b && $c != $d;

# Answers:

$ans1 = norm($U + $V);
$ans2 = norm($U - $V);
$ans3 = norm($V - $U);
$ans4 = norm($V / (-6));
$ans5 = norm($c * $U - $d * $V);

#  Don't allow norm or |v| in student answers

Context()->functions->undefine('norm');
Context()
    ->lists->set(
        AbsoluteValue => { class => 'LimitedVector::List::AbsoluteValue' });

BEGIN_PGML

Suppose [`\vec{u} = [$U]`] and [`\vec{u} = [$V]`].  
Compute the following vector norms:

a) [` |\vec{u}+\vec{v}| = \; `] [_]{$ans1}

b) [` |\vec{u}-\vec{v}| = \; `] [_]{$ans2}

c) [` |\vec{v}-\vec{u}| = \; `] [_]{$ans3}

d) [`` |-\frac{1}{[$b]}\vec{v}| = \; ``] [_]{$ans4}

e) [` |[$c]\vec{u}-[$c]\vec{v}| = \; `] [_]{$ans5}


END_PGML

ENDDOCUMENT();
