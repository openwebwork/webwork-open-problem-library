## DESCRIPTION
##   Working with Vectors
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Vectors and vector arithmetic)
## Date(8/23/07)
## Institution(Union College)
## Level(3)
## MO(1)
## TitleText1('Calculus')
## AuthorText1('Anton')
## EditionText1('7')
## Section1('12.2')
## Problem1('55')
## TitleText2('Calculus: Early Transcendentals')
## AuthorText2('Rogawski')
## EditionText2('1')
## Section2('12.1')
## Problem2('55')
## KEYWORDS('Vector')

DOCUMENT();        # This should be the first executable line in the problem.

loadMacros('PGstandard.pl', 'PGML.pl', 'parserVectorUtils.pl', 'contextFraction.pl', 'PGcourse.pl');

Context("Vector");

# the vectors u, v, w
$U = non_zero_vector2D();
$V = non_zero_vector2D();
$W = non_zero_vector2D();

$a = random(2,10);
$b = random(2,10);

$X = ($a*$U-$V-$W)/($b-1);


BEGIN_PGML

Let [`\vec{u} = [$U]`], [`\vec{v} = [$V]`], and [`\vec{w} = [$W]`].
Find the vector [`\vec{x}`] that satisfies
[```[$a] \vec{u} - \vec{v} + \vec{x} = [$b] \vec{x} + \vec{w}.```]

In this case, [`[$x] =`] [_]{$X}

END_PGML

$A=$a*$U-$V-$W;
$a1=$A->extract(1);
$a2=$A->extract(2);
$b1=$b-1;
Context("Fraction");
$x1=Compute("$a1/$b1");
$x2=Compute("$a2/$b1");

if ($b1==1){
BEGIN_PGML_SOLUTION
Solving the given equation for [`[$x]`] yields
[``` [$x]= [$a] \vec{u} - \vec{v} - \vec{w} = [$a] [$U] - [$V] - [$W] = [$X] ```]
END_PGML_SOLUTION
}
else
{
BEGIN_PGML_SOLUTION
Solving the given equation for [`[$x]`] yields
[``` \begin{aligned} \vec{x} & = \frac{1}{[$b1]}( [$a] \vec{u} - \vec{v} - \vec{w})
\\& = \frac{1}{[$b1]} ([$a] [$U] - [$V] - [$W] )
\\& = \frac{1}{[$b1]} [$A]
\\& = \left \langle [$x1] ,[$x2] \right\rangle 
\end{aligned}```]
END_PGML_SOLUTION
};

ENDDOCUMENT();