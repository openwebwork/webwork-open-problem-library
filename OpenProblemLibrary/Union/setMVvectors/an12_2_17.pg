## DESCRIPTION
##   Working with Vectors
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Dot product, length, and unit vectors)
## Date(8/23/07)
## Institution(Union College)
## MLT(MixedUnitVectorProblems)
## MLTleader(1)
## Level(3)
## MO(1)
## TitleText1('Calculus')
## AuthorText1('Anton')
## EditionText1('7')
## Section1('12.2')
## Problem1('37')
## TitleText2('Calculus: Early Transcendentals')
## AuthorText2('Rogawski')
## EditionText2('1')
## Section2('12.1')
## Problem2('37')
## KEYWORDS('Vector', 'Length', 'Unit')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'parserVectorUtils.pl', 'PGcourse.pl');

Context("Vector");

# the vectors
$U = non_zero_vector2D();
$k = Vector(k);
do { $V = non_zero_vector3D(); } until ($V->dot($k) != 0);

# the points A and B
$A = non_zero_point2D();
$B = $A + non_zero_point2D();

$ans1 = $U->unit;
$ans2 = (-$V)->unit;
$ans3 = Vector($B - $A)->unit;

# Remove the use of "unit" for student answers:
Context()->functions->undefine("unit");

BEGIN_PGML
Find *unit* vectors that satisfy the given conditions:

a) The unit vector in the same direction as [`[$U]`] is [_]{$ans1}


b) The unit vector oppositely directed to [`[@ $V->ijk @]*`] is [_]{$ans2}

c) The unit vector that has the same direction as the
vector from the point [`A=[$A]`] to the point [`B=[$B]`] is [_]{$ans3}

[@  helpLink('vectors')  @]*
END_PGML

ENDDOCUMENT();
