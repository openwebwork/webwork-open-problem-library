## DESCRIPTION
##   Working with Vectors
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Vectors and vector arithmetic)
## Date(8/23/07)
## Institution(Union College)
## MLT(va_lc_compute)
## MLTleader(1)
## Level(2)
## MO(1)
## TitleText1('Calculus: Early Transcendentals')
## AuthorText1('Rogawski')
## EditionText1('1')
## Section1('12.2')
## Problem1('19')
## KEYWORDS('Vector')

DOCUMENT();
loadMacros(
    'PGstandard.pl',           'PGML.pl',
    'contextLimitedVector.pl', 'parserVectorUtils.pl', 'PGcourse.pl'
);

Context("Vector");

$U = non_zero_vector3D();
$V = non_zero_vector3D();

# some coefficients
do {
    ($a, $b, $c, $d) =
        (random(2, 8), random(2, 8), random(2, 8), random(2, 8));
} until $a != $b && $c != $d;

# Answers:

$ans1 = $U + $V;
$ans2 = $U - $V;
$ans3 = $V - $U;
$ans4 = $a * $U;
$ans5 = $V / (-$b);
$ans5 = $c * $U - $d * $V;

BEGIN_PGML

Suppose [`\vec{u} = [$U]`] and [`\vec{v} = [$V]`]. 
Compute the following vector operations:

a) [` |\vec{u}+\vec{v}| = \; `] [_]{$ans1}

b) [` |\vec{u}-\vec{v}| = \; `] [_]{$ans2}

c) [` |\vec{v}-\vec{u}| = \; `] [_]{$ans3}

d) [`` |[$a]\vec{u}| = \; ``] [_]{$ans4}

e) [`` \left|-\frac{1}{[$b]}\vec{v}\right| = \; ``] [_]{$ans5}

f) [` |[$c]\vec{u}-[$c]\vec{v} = \; `] [_]{$ans6}


END_PGML

ENDDOCUMENT();
