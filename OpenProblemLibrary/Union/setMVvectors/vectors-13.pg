## DESCRIPTION
##   Identifying Parallel and Perpendicular Vectors
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Cross product)
## Date(8/23/07)
## Institution(Union College)
## Level(3)
## TitleText1('Calculus: Early Transcendentals')
## AuthorText1('Rogawski')
## EditionText1('1')
## Section1('12.3')
## Problem1('13')
## KEYWORDS('Vector', 'Parallel', 'Perpendicular', 'Cross Product', 'Dot Product')

DOCUMENT();
loadMacros(
    'PGstandard.pl',        'PGML.pl',
    'parserVectorUtils.pl', 'parserPopUp.pl',
    'PGcourse.pl'
);

Context("Vector");

$V = non_zero_vector3D();

#  Some perpendicular vectors, paralle vectors and random ones.
@W = (
    $V x non_zero_vector3D(),
    $V x non_zero_vector3D(),
    (3 / 2) * $V,
    -2 * $V, non_zero_vector3D(), non_zero_vector3D()
);

@shuffle = random_subset(4, 0 .. $#W);

@dd = map {
    DropDown([ 'parallel', 'perpendicular', 'neither' ],
        $W[$_] . $V == 0 ? 1 : $W[$_] x $V == Vector(0, 0, 0) ? 0 : 2)
} @shuffle;

$showPartialCorrectAnswers = 0;

BEGIN_PGML

Suppose [`\vec{v} = [$V]`].  Then

a) [``[$W[$shuffle[0]]]``] is [_]{$dd[0]} to [`\vec{v}`].

b) [``[$W[$shuffle[1]]]``] is [_]{$dd[1]} to [`\vec{v}`].

c) [``[$W[$shuffle[2]]]``] is [_]{$dd[2]} to [`\vec{v}`].

d) [``[$W[$shuffle[3]]]``] is [_]{$dd[3]} to [`\vec{v}`].

END_PGML

ENDDOCUMENT();
