## DESCRIPTION
##   Find a Perpendicular Vector
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Cross product)
## Date(8/23/07)
## Institution(Union College)
## Level(3)
## MO(1)
## KEYWORDS('Vector', 'Perpendicular', 'Cross Product')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'parserVectorUtils.pl', 'PGcourse.pl');

Context("Vector");

do {
    $A  = non_zero_point3D();
    $B  = non_zero_point3D();
    $AB = Vector($B - $A);
} until $AB . Vector(1, 1, 1) != 0;

#  The answer
$k = Real(($A . $AB) / ($AB . Vector(1, 1, 1)));

BEGIN_PGML

Let [`A = [$A]`], [`B = [$B]`], and [`P = (k,k,k)`].
The vector from [`A`] to [`B`] is perpendicular to the vector from
[`A`] to [`P`] when [`k`] = [_]{$k}

END_PGML
ENDDOCUMENT();
