## DESCRIPTION
##   Calculate Dot Products
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Dot product, length, and unit vectors)
## Date(8/23/07)
## Institution(Union College)
## MLT(CalcExpressionsWithDotProd)
## Level(2)
## MO(1)
## TitleText1('Calculus: Early Transcendentals')
## AuthorText1('Rogawski')
## EditionText1('1')
## Section1('12.3')
## Problem1('37')
## KEYWORDS('Vector', 'Dot Product')

DOCUMENT();
loadMacros('PGstandard.pl', 'parserVectorUtils.pl', 'PGML.pl', 'PGcourse.pl');

#  Setup

Context("Vector");

$U = non_zero_vector3D();
$V = non_zero_vector3D();
$W = non_zero_vector3D();

# answers
$ans1 = $U . $V;
$ans2 = $U . $W;
$ans3 = $V . $W;
$ans4 = $V . $V;
$ans5 = $U . ($V + $W);

#  Don't allow dot-product in student answers

Context()->flags->set(reduceConstants => 0);
Context()->operators->undefine('.');

BEGIN_PGML

Suppose [`\vec{u} = [$U]`], [`\vec{v} = [$V]`] and [`\vec{w} = [$W]`]. Then:

a) [`\vec{u} \cdot \vec{v} =\;`] [_]{$ans1}

b) [`\vec{u} \cdot \vec{w} =\;`] [_]{$ans2}

c) [`\vec{v} \cdot \vec{w} =\;`] [_]{$ans3}

d) [`\vec{v} \cdot \vec{v} =\;`] [_]{$ans4}

e) [`\vec{u} \cdot (\vec{v} + \vec{w}) =\;`] [_]{$ans5}

END_PGML

ENDDOCUMENT();
