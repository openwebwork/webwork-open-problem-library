## DESCRIPTION
##   Working with Vectors
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Dot product, length, and unit vectors)
## Date(8/23/07)
## Institution(Union College)
## MLT(FindParallelAndOrthogVecs)
## Level(3)
## MO(1)
## TitleText1('Calculus')
## AuthorText1('Anton')
## EditionText1('7')
## Section1('12.3')
## Problem1('23')
## KEYWORDS('Vector', 'Parallel', 'Perpendicular')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'parserVectorUtils.pl', 'PGcourse.pl');

Context("Vector");

$U = non_zero_vector3D();
$V = non_zero_vector3D();

#  The projections
$V1 = (($U . $V) / ($V . $V)) * $V;
$V2 = $U - $V1;

BEGIN_PGML

Find two vectors [`\vec{v}_1`] and [`\vec{v}_2`] whose sum is [`[$U]`], where
[`\vec{v}_1`] is parallel to [`[$V]`] while [`\vec{v}_2`] is perpendicular to
[`[$V]`].

a) [`\vec{v}_1=\;`] [_]{$V1}

b) [`\vec{v}_2=\;`] [_]{$V2}

END_PGML

ENDDOCUMENT();
