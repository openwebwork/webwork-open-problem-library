## DESCRIPTION
##   Working with Vectors
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Dot product, length, and unit vectors)
## Date(8/23/07)
## Institution(Union College)
## Level(3)
## MO(1)
## TitleText1('Calculus')
## AuthorText1('Anton')
## EditionText1('7')
## Section1('12.2')
## Problem1('65')
## TitleText2('Calculus: Early Transcendentals')
## AuthorText2('Rogawski')
## EditionText2('1')
## Section2('12.1')
## Problem2('65')
## KEYWORDS('Vector', 'Parallelogram')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'parserVectorUtils.pl', 'PGcourse.pl');

Context("Vector");

# the vectors u, v
$U = non_zero_vector2D(-3, 3);
($u1, $u2) = $U->value;

$a = non_zero_random(-3, 3);
$b = non_zero_random(-3, 3);

$V = Vector($a * $u1 + $b * $u2, $a * $u2 - $b * $u1);

$d1 = norm($U - $V);
$d2 = norm($U + $V);

BEGIN_PGML

Suppose [`\vec{u} = [$U]`] and [`\vec{v} = [$V]`] are two
vectors that form the sides of a parallelogram.  Then the lengths of
the two diagonals of the parallelogram are [_]{List($d1,$d2)}

_Separate answers with a comma._

END_PGML

$D  = $U + $V;
$D1 = $D->extract(1);
$D2 = $D->extract(2);
$s1 = $D1 * $D1 + $D2 * $D2;
$d  = $U - $V;
$d1 = $d->extract(1);
$d2 = $d->extract(2);
$s2 = $d1 * $d1 + $d2 * $d2;

BEGIN_PGML_SOLUTION
The diagonals are given by 

[` \vec{u}+\vec{v} = [$U] + [$V] = [$D] `] and 
[` \vec{u}-\vec{v} = [$U] - [$V] = [$d] `]. 

Their lengths are 
[` \sqrt{([$D1])^2+([$D2])^2} = \sqrt{[$s1]}`] and 
 [`\sqrt{([$d1])^2+([$d2])^2}=\sqrt{[$s2]} `], respectively.

END_PGML_SOLUTION
ENDDOCUMENT();
