## DESCRIPTION
##   Distance from a Point to a Line
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Dot product, length, and unit vectors)
## Date(9/18/07)
## Institution(Union College)
## MLT(DistanceAsProjection)
## MLTleader(1)
## Level(3)
## MO(1)
## TitleText1('Calculus')
## AuthorText1('Anton')
## EditionText1('7')
## Section1('12.3')
## Problem1('54')
## TitleText2('Calculus: Early Transcendentals')
## AuthorText2('Rogawski')
## EditionText2('1')
## Section2('12.3')
## Problem2('54')
## KEYWORDS('Vector', 'Distance', 'Point', 'Line', 'Projection', 'Orthogonal')

DOCUMENT();    # This should be the first executable line in the problem.

loadMacros(
    'PGstandard.pl', 'PGML.pl',
    'plots.pl',      'parserVectorUtils.pl',
    'PGcourse.pl'
);

#  Setup

Context("Vector");

#  The points A, B and P

$A = non_zero_point3D();
$B = non_zero_point3D();
$P = non_zero_point3D();

while (norm($B - $A) == 0) { $B = non_zero_point3D() }
while (norm($P - $A) == 0) { $P = non_zero_point3D() }

$AB = Vector($B - $A);
$AP = Vector($P - $A);

#  The projection and distance

$V = $AP - (($AP . $AB) / ($AB . $AB)) * $AB;
$D = norm($V);

#  The projection image
$plot = Plot(
    rounded_corners => 1,
    xvisible        => 0,
    yvisible        => 0,
    ymax            => 7,
    show_grid       => 0
);
$plot->add_dataset(
    [ [ -4, -4 ], [ 4, 4 ], width => 1 ],
    [
        [ -2, -2 ], [ 3, 3 ],
        color      => 'blue',
        start_mark => 'circle',
        end_mark   => 'arrow'
    ],
    [
        [ 1, 1 ], [ -2, 5 ],
        color      => 'blue',
        start_mark => 'circle',
        end_mark   => 'arrow'
    ],
    [
        [ -2, -2 ], [ -2, 5 ],
        color      => 'blue',
        start_mark => 'circle',
        end_mark   => 'arrow'
    ]
);
$plot->add_dataset([ 0.65, 0.65 ], [ 0.4, 1 ], [ 0.7, 1.3 ], width => 1);
$plot->add_label(
    [ -2, -2.2, '\\(A\\)', v_align => 'top' ],
    [  3,  2.8, '\\(B\\)', v_align => 'top' ],
    [ -2,  5,   '\\(P\\)', v_align => 'bottom', h_align => 'right' ],
    [  0,  3.2, '\\(d\\)' ],
);

BEGIN_PGML

The distance [`d`] of a point [`P`] to the line through points [`A`] and [`B`] is the length of the component of [`\overline{AP}`] that is orthogonal to
   [`\overline{AB}`], as indicated in the diagram.

>> [!!]{$plot}{200}<<


So the distance from [`P = [$P]`] to the line through the
points [`A = [$A]`] and [`B = [$B]`] is [_]{$D}

END_PGML

ENDDOCUMENT();
