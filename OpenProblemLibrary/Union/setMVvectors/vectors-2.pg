## DESCRIPTION
##   Working with Vectors
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Dot product, length, and unit vectors)
## Date(8/23/07)
## Institution(Union College)
## MLT(VectorLotsOfParts)
## MLTleader(1)
## Level(2)
## MO(1)
## TitleText1('Calculus: Early Transcendentals')
## AuthorText1('Rogawski')
## EditionText1('1')
## Section1('12.2')
## Problem1('5')
## KEYWORDS('Vector', 'Length', 'Tip', 'Tail')

DOCUMENT();    # This should be the first executable line in the problem.

loadMacros(
    'PGstandard.pl',        'PGML.pl',
    'parserVectorUtils.pl', 'contextLimitedVector.pl',
    'PGcourse.pl'
);

#  Setup

Context("Vector");

# the points P and Q
do {
    $P = non_zero_point3D();
    $Q = non_zero_point3D(0, 10);
} until $P != $Q;

$PQ = Vector($Q - $P);

# another 2 points
do {
    $X = non_zero_point3D();
    $Y = non_zero_point3D();
} until $X != $P && $Y != $Q;

$ans1 = $PQ;
$ans2 = norm($PQ);
$ans3 = Point($X + $PQ);
$ans4 = Point($Y - $PQ);
$ans5 = (-$PQ);
$ans6 = (2 * $PQ);

Context("LimitedVector-coordinate");

BEGIN_PGML

Consider the vector [`\vec{v}`] between [`[$P]`] and [`[$Q]`].

a) The vector [`\vec{v}`] is [_]{$ans1}.

b) The length of [`\vec{v}`] is [_]{$ans2}.

c) If the tail of [`\vec{v}`] is at [`[$X]`], then the tip is at
[_]{$ans3}.

d) If the tip of [`\vec{v}`] is at [`[$Y]`] then its tail is at
[_]{$ans4}.

e) What vector has the same length as [`\vec{v}`], but points in the opposite
direction? [_]{$ans5}.

f) What vector has the same direction as [`\vec{v}`], but is twice as long?
[_]{$ans6}.
END_PGML

ENDDOCUMENT();
