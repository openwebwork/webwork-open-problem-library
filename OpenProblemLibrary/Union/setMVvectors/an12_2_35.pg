## DESCRIPTION
##   Working with Vectors
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Dot product, length, and unit vectors)
## Date(8/23/07)
## Institution(Union College)
## MLT(MixedUnitVectorProblems)
## Level(3)
## MO(1)
## TitleText1('Calculus')
## AuthorText1('Anton')
## EditionText1('7')
## Section1('12.2')
## Problem1('35')
## KEYWORDS('Vector', 'Unit', 'Parallel', 'Perpendicular')

DOCUMENT();

loadMacros(
    'PGstandard.pl',        'PGML.pl',
    'parserMultiAnswer.pl', 'parserVectorUtils.pl',
    'unorderedAnswer.pl',   'PGcourse.pl'
);

Context("Vector");

# the first line
($m1, $b1) = non_zero_point2D()->value;
$f1 = Formula("$m1 x + $b1")->reduce;
$u1 = unit(Vector(1, $m1));

# the second line
($m2, $b2) = non_zero_point2D()->value;
$f2 = Formula("$m2 x + $b2")->reduce;
$u2 = unit(Vector(-$m2, 1));

# the third line
($a, $b) = (non_zero_random(-5, 5, 1), non_zero_random(2, 6, 1));
$f3 = Formula("$a x + $b y")->reduce;
$u3 = unit(Vector(-$b, $a));

$ans1 = MultiAnswer($u1, -$u1)->with(
    singleResult => 0,
    checker      => sub {
        my ($correct, $student, $self) = @_;
        my ($cor1, $cor2) = @$correct;
        my ($stu1, $stu2) = @$student;
        return ($stu1 == $cor1 && $stu2 == $cor2)
            || ($stu1 == $cor2 && $stu2 == $cor1) ? 1 : 0;
    }
);

$ans2 = MultiAnswer($u2, -$u2)->with(
    singleResult => 0,
    checker      => sub {
        my ($correct, $student, $self) = @_;
        my ($cor1, $cor2) = @$correct;
        my ($stu1, $stu2) = @$student;
        return ($stu1 == $cor1 && $stu2 == $cor2)
            || ($stu1 == $cor2 && $stu2 == $cor1) ? 1 : 0;
    }
);

$ans3 = MultiAnswer($u3, -$u3)->with(
    singleResult => 0,
    checker      => sub {
        my ($correct, $student, $self) = @_;
        my ($cor1, $cor2) = @$correct;
        my ($stu1, $stu2) = @$student;
        return ($stu1 == $cor1 && $stu2 == $cor2)
            || ($stu1 == $cor2 && $stu2 == $cor1) ? 1 : 0;
    }
);

BEGIN_PGML
In each part, find the two unit vectors in [`\mathbb{R}^2`] that satisfy the
given conditions.

a) The two unit vectors parallel to the line [`y = [$f1]`] are 
[_]{$ans1} and [_]{$ans1}.

b) The two unit vectors perpendicular to the line [`y = [$f2]`] are [_]{$ans2} and [_]{$ans2}. 

c) The two unit vectors parallel to the line [`[$f3] = 1`] are [_]{$ans3} and [_]{$ans3}.
END_PGML

BEGIN_PGML_SOLUTION
a) The vector in the direction of the line is [`\langle 1, [$m1] \rangle`].  Dividing by its length results in [`[$u1]`] and the other vector is the negative of this or [`[$u1*-1]`]. 

b) The vector perpendicular to the line is [`\langle [$m2],-1\rangle`].  Dividing by its length results in [`[$u2]`] and the other vector is the negative of this or [`[$u2*-1]`]. 

c) The vector in the direction of the line is [`\langle [$b*-1], [$a] \rangle`].  Dividing by its length results in [`[$u3]`] and the other vector is the negative of this or [`[$u3*-1]`]. 
END_PGML_SOLUTION

ENDDOCUMENT();
