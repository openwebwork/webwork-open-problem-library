## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Global extrema)
## KEYWORDS('graph', 'maximum', 'minimum', 'relative', 'absolute')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## MLT(calculus_singlevariable_absolut_extrema_graphs)
## Level(2)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('3.1')
## Problem1('7')

#Problem APEX 3.1.7

DOCUMENT();

loadMacros(
    'PGstandard.pl', 'PGML.pl',
    'plots.pl',      'parserCheckboxList.pl',
    'PGcourse.pl'
);

$f1 = "(x - 2)^2 - 3";
$f2 = "x-3";
$f3 = "3 - sqrt(4 - (x - 8)^2)";
$f4 = "1 - 3(x-8)";

$plot = Plot(
    xmin            => -2,
    xmax            => 15,
    xtick_delta     =>  5,
    xminor          =>  4,
    ymin            => -5,
    ymax            =>  5,
    ytick_delta     =>  1,
    yminor          =>  0,
    rounded_corners => 1
);
$plot->add_function(
    [
        "$f1", 'x', 2, 4,
        color      => 'blue',
        start_mark => 'circle',
        end_mark   => 'circle'
    ],
    [
        "$f2", 'x', 4, 6,
        color      => 'blue',
        start_mark => 'circle',
        end_mark   => 'circle'
    ],
    [
        "$f3", 'x', 6, 8,
        color      => 'blue',
        start_mark => 'circle',
        end_mark   => 'circle'
    ],
    [
        "$f4", 'x', 8, 9,
        color      => 'blue',
        start_mark => 'circle',
        end_mark   => 'circle'
    ]
);

$plot->add_label(
    [ 2, -3.1, 'A', color => 'red', v_align => 'top' ],
    [ 4,  1,   'B', color => 'red', v_align => 'bottom', h_align => 'right' ],
    [ 6, 3.05, 'C', color => 'red', v_align => 'bottom' ],
    [ 8,  1,   'D', color => 'red', v_align => 'bottom', h_align => 'left' ],
    [ 9, -2,   'E', color => 'red', v_align => 'top' ]
);

$alttext =
    'A graph with an open circle at point A, rising to point B, falling to '
    . 'point C with a cusp, rising to an open circle at point D, then falling through '
    . 'point E to point F, then up to a solid circle at point G.';

$cb_options = [
    [
        'Absolute maximum',
        'Relative maximum',
        'Absolute minimum',
        'Relative minimum'
    ],
    'None of the above'
];
$mc1 = CheckboxList($cb_options, [ 2, 3 ]);
$mc2 = CheckboxList($cb_options, [4]);
$mc3 = CheckboxList($cb_options, [ 0, 1 ]);
$mc4 = CheckboxList($cb_options, [4]);
$mc5 = CheckboxList($cb_options, [3]);

BEGIN_PGML

>> [! [$alttext] !]{$plot}{400} <<

Identify the marked points as being an absolute maximum or
minimum, a relative maximum or minimum, or none of the above.  (Select
all that apply.)

Point A:

[_]{$mc1}

Point B:

[_]{$mc2}

Point C:

[_]{$mc3}

Point D:

[_]{$mc4}

Point E:

[_]{$mc5}

END_PGML

BEGIN_PGML_SOLUTION
Points labeled [`A`] and [`E`] are relative minima, and
[`A`] is also the absolute minimum.

Point [`C`] is a relative and absolute maximum.

Points [`B`] and [`D`] are neither a maxima nor minima.

END_PGML_SOLUTION

ENDDOCUMENT();

