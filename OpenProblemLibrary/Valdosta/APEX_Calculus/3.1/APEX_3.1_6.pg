#Problem APEX 3.1.6

## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Global extrema)
## KEYWORDS('maximum', 'minimum', 'relative', 'absolute', 'graph')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## MLT(calculus_singlevariable_absolut_extrema_graphs)
## MLTleader(1)
## Level(2)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('3.1')
## Problem1('6')

DOCUMENT();

loadMacros(
    'PGstandard.pl', 'PGML.pl',
    'plots.pl',      'parserCheckboxList.pl',
    'PGcourse.pl'
);

$f1 = ".9375(5x -  x^2/2) - 7.21875";
$f2 = "2.625 + sqrt((x - 7)/2)";
$f3 = "1.625 - 2*sin(pi/2*(x - 10))";

$plot = Plot(
    xmin            => -2,
    xmax            => 15,
    xtick_delta     =>  5,
    xminor          =>  4,
    ymin            => -5,
    ymax            =>  5,
    ytick_delta     =>  1,
    yminor          =>  0,
    rounded_corners => 1
);
$plot->add_function(
    [
        "$f1", 'x', 1, 5,
        color      => 'blue',
        start_mark => 'open_circle',
        end_mark   => 'circle'
    ],
    [
        "$f1", 'x', 5, 7,
        color      => 'blue',
        start_mark => 'circle',
        end_mark   => 'circle'
    ],
    [
        "$f2", 'x', 7, 9,
        color      => 'blue',
        start_mark => 'circle',
        end_mark   => 'open_circle'
    ],
    [
        "$f3", 'x', 9, 10,
        color      => 'blue',
        start_mark => 'open_circle',
        end_mark   => 'circle'
    ],
    [
        "$f3", 'x', 10, 11,
        color      => 'blue',
        start_mark => 'circle',
        end_mark   => 'circle'
    ],
    [
        "$f3", 'x', 11, 13,
        color      => 'blue',
        start_mark => 'circle',
        end_mark   => 'circle'
    ]
);

$plot->add_label(
    [ 1,    -3.1, 'A', color => 'red', v_align => 'top' ],
    [ 5,     4.5, 'B', color => 'red', v_align => 'bottom' ],
    [ 7,     2.5, 'C', color => 'red', v_align => 'top' ],
    [ 9,     3.7, 'D', color => 'red', v_align => 'bottom' ],
    [ 10.1,  1.7, 'E', color => 'red', h_align => 'left' ],
    [ 11,   -0.5, 'F', color => 'red', v_align => 'top' ],
    [ 13,    3.8, 'G', color => 'red', v_align => 'bottom' ]
);

$alttext =
    'A graph with an open circle at point A, rising to point B, falling to '
    . 'point C with a cusp, rising to an open circle at point D, then falling through '
    . 'point E to point F, then up to a solid circle at point G.';

$cb_options = [
    [
        'Absolute maximum',
        'Relative maximum',
        'Absolute minimum',
        'Relative minimum'
    ],
    'None of the above'
];
$mc1 = CheckboxList($cb_options, [4]);
$mc2 = CheckboxList($cb_options, [ 0, 1 ]);
$mc3 = CheckboxList($cb_options, [3]);
$mc4 = CheckboxList($cb_options, [4]);
$mc5 = CheckboxList($cb_options, [4]);
$mc6 = CheckboxList($cb_options, [3]);
$mc7 = CheckboxList($cb_options, [1]);

BEGIN_PGML

>> [! [$alttext] !]{$plot}{400} <<

Identify the marked points as being an absolute maximum or
minimum, a relative maximum or minimum, or none of the above.  (Select
all that apply.)

Point A:

[_]{$mc1}

Point B:

[_]{$mc2}

Point C:

[_]{$mc3}

Point D:

[_]{$mc4}

Point E:

[_]{$mc5}

Point F:

[_]{$mc6}

Point G:

[_]{$mc7}

END_PGML

BEGIN_PGML_SOLUTION
Since the points labeled [`A`] and [`D`] are not actually 
part of the graph, they cannot
be classified as absolute or relative extrema.

Point [`B`] is both a relative and absolute maximum.

Points [`C`] and [`F`] are relative (but not absolute) minima.

Point [`E`] is neither a maximum nor minimum.

Point [`G`] is a relative (but not absolute) maximum.

END_PGML_SOLUTION

ENDDOCUMENT();

