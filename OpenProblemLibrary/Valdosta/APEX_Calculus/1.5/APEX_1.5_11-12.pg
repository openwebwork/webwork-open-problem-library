## DBsubject(Calculus - single variable)
## DBchapter(Limits and continuity)
## DBsection(Continuity - concept of)
## KEYWORDS('continuity','graphical')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## MO(1)
## Level(2)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('1.5')
## Problem1('11 12')

#Problem APEX 1.5.11-12

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'plots.pl', 'parserPopUp.pl',
    'PGcourse.pl');

Context("Numeric");

$ans1 = DropDown([ "is", "is not" ], "is");
$ans2 = DropDown([ "is", "is not" ], "is not");
$ans3 = DropDown([ "is", "is not" ], "is");
$ans4 = DropDown([ "is", "is not" ], "is not");
$ans5 = DropDown([ "is", "is not" ], "is not");
$ans6 = DropDown([ "is", "is not" ], "is");

$a  = random(-3, 3);
$b  = random(-2, 3);
$c  = random(-3, 2);
$m1 = random(-1, 1, 0.5);
$m2 = ($b - $a) / 2;
$m3 = ($c - $b - 1) / 2;
$m4 = random(-1, 1, 0.5);

$plot = Plot(
    xmin        => -3,
    xmax        =>  6,
    xtick_delta =>  3,
    xminor      =>  2,
    ymin        => -6,
    ymax        =>  6,
    ytick_delta =>  2,
    yminor      => 1
);

$plot->add_function(
    [
        "$m1*(x+1)+$a", 'x', -2, -1,
        color      => 'blue',
        start_mark => 'circle',
        end_mark   => 'open_circle'
    ],
    [
        "$m2*(x-1)+$b", 'x', -1, 1,
        color      => 'blue',
        start_mark => 'open_circle',
        end_mark   => 'open_circle'
    ],
    [
        "$m3*(x-3)+$c", 'x', 1, 3,
        color      => 'blue',
        start_mark => 'circle',
        end_mark   => 'open_circle'
    ],
    [
        "$m4*(x-3)+$c", 'x', 3, 4,
        color      => 'blue',
        start_mark => 'open_circle',
        end_mark   => 'circle'
    ]
);
$plot->add_point(-1, $a + 1, color => 'blue');

$y1 = $a - $m1;
$y2 = $a;
$y3 = $a + 1;
$y4 = $b;
$y5 = -2 * $m3 + $c;
$y6 = $c;
$y7 = $m4 + $c;

$alt_text =
    "A graph of a piecewise linear function.  The leftmost part runs"
    . "from (-2,$y1) to (-1, $y2) with a solid circle at x=-2 and an open "
    . "circle at x=-1."
    . "There is a solid point at (-1,$y3)."
    . "The next linear piece runs from (-1,$y2) to (1, $y4) with open circles "
    . "at both ends."
    . "The next linear piece runs from (1, $y5) to (3, $y6). The left end "
    . "is a solid circle and the right end is open."
    . "The last linear piece runs from (3, $y6) to (4, $y7) and is open on "
    . "the left end and solid on the right.";

BEGIN_PGML
Answer the questions based on the graph of [`y = f(x)`] shown below.

>>[![$alt_text]!]{$plot}{400}<<

-----

If you are having a hard time seeing the picture clearly, click
on the picture.  It will expand to a larger picture on its own page so
that you can inspect it more clearly.

a)  [`f`] [__]{$ans1} continuous at [`-2`].

b)  [`f`] [__]{$ans2} continuous at [`-1`].

c)  [`f`] [__]{$ans3} continuous at [`0`].

d)  [`f`] [__]{$ans4} continuous at [`1`].

e)  [`f`] [__]{$ans5} continuous at [`3`].

f)  [`f`] [__]{$ans6} continuous at [`4`].

END_PGML

BEGIN_PGML_SOLUTION
There are discontinuities at [`x = -1, 1, 3`].
END_PGML_SOLUTION

ENDDOCUMENT();
