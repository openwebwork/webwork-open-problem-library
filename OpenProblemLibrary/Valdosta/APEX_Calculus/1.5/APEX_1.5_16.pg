## DBsubject(Calculus - single variable)
## DBchapter(Limits and continuity)
## DBsection(Continuity - concept of)
## KEYWORDS('piecewise-function','continuous')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## Level(2)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('1.5')
## Problem1('16')

#Problem APEX 1.5.16

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'plots.pl', 'parserPopUp.pl',
    'PGcourse.pl');

Context("Numeric");

$a = random( 1, 3,);
$b = random( 0, $a - 1);
$c = random(-2, $b);

$plot = Plot(
    xmin            => -3,
    xmax            =>  7,
    xminor          =>  1,
    ymin            => -3,
    ymax            =>  7,
    yminor          =>  1,
    rounded_corners => 1
);
$plot->add_function(
    [ "(x-1)^2 + $a", 'x', -3, 0, end_mark => 'circle', color => 'blue' ],
    [
        "-2*cos(pi*x/2)+$b", 'x', 0, 2,
        start_mark => 'open_circle',
        end_mark   => 'open_circle',
        color      => 'blue'
    ],
    [
        "(x-2)^2/8 + $c", 'x', 2, 7.5,
        start_mark => 'open_circle',
        end_mark   => 'circle',
        color      => 'blue'
    ],
);
$plot->add_point(2, $b + 1, color => 'blue');
$y1 = $a + 1;
$y2 = $b - 2;
$y3 = $b + 1;
$y4 = $b + 2;

$ans1 = DropDown([ "is", "is not" ], "is not");
$ans2 = DropDown([ "is", "is not" ], "is");
$ans3 = DropDown([ "is", "is not" ], "is not");

$alt_text =
    "A piecewise function.  The leftmost part descends from the top of "
    . "the plot to the solid point (0,$y1).  "
    . "the next part starts with an open circle at (0,$y2) and increases to the "
    . "point (2,$y4)."
    . "There is a solid point at (2,$y3). "
    . "The last part of the function starts at the open point (2, $c) "
    . "and increases until it leaves the right edge of the plot.";

BEGIN_PGML
Answer the questions based on the graph of [`y = f(x)`] shown below.

>>[![$alt_text]!]{$plot}{400}<<
-----
If you are having a hard time seeing the picture clearly, click
on the picture.  It will expand to a larger picture on its own page so
that you can inspect it more clearly.

a)  [`f`] [__]{$ans1}   continuous at [`0`].

b)  [`f`] [__]{$ans2}   continuous at [`1`].

c)  [`f`] [__]{$ans3}   continuous at [`2`].

END_PGML

#####################################################################

BEGIN_PGML_SOLUTION

There are discontinuities at [`x = 0, 2`].
END_PGML_SOLUTION

ENDDOCUMENT();
