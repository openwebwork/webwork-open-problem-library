#Problem APEX 2.4.16
## DBsubject(Calculus - single variable)
## DBchapter(Differentiation)
## DBsection(Product rule (with trigonometric functions))
## KEYWORDS('derivative','rules')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## Level(2)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('2.4')
## Problem1('16')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl',  'PGcourse.pl');

Context("Numeric");
Context()->variables->are(t => "Real");

$a  = random(2, 5);
$a1 = $a + 1;
$b  = random(1, 10) * random(-1, 1, 2);

$f  = Formula("t^(-$a)");
$fp = $f->D('t')->reduce;

# randomly pick one of the factors:
$g  = list_random(
    Formula("sec(t) + $b"), Formula("csc(t) + $b"),
    Formula("tan(t) + $b"), Formula("cot(t) + $b")
);
$gp = $g->D('t')->reduce;

$ans = Compute("($f)($gp) + ($fp)($g)");

BEGIN_PGML
Compute the derivative of the given function.

[``
  f(t) = \frac{1}{t^{[$a]}} \left( [$g] \right)
``]

[`f'(t) = `][_]{$ans}.
END_PGML

BEGIN_PGML_SOLUTION
Rewrite [`f(t)`]:
[```
  f(t) = \left([$f]\right)\left([$g]\right)
```]

Use the Product Rule.

[``
  f'(t) = ([$f])([$gp]) + ([$fp])([$g]).
``]
END_PGML_SOLUTION

ENDDOCUMENT();

