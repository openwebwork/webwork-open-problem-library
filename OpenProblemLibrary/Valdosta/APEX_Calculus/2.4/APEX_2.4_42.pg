#Problem APEX 2.4.42
## DBsubject(Calculus - single variable)
## DBchapter(Differentiation)
## DBsection(Conceptual understanding of derivatives)
## KEYWORDS('graphs', 'derivative')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## Level(2)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('2.4')
## Problem1('42')

DOCUMENT();

loadMacros(
    'PGstandard.pl', 'PGML.pl', 'plots.pl', 'parserPopUp.pl',
    'PGcourse.pl'
);

$m = random( 1, 4, 0.5) * random(-1, 1, 2);
$b = random(-3, 3);

$main_plot = Plot(rounded_corners => 1);
$main_plot->add_function("$m x + $b", 'x', -10.5, 10.5, color => 'blue');

$plot[$_] = Plot(rounded_corners => 1) for (0 .. 3);
$plot[0]->add_function("$m",       'x', -10.5, 10.5, color => blue);
$plot[1]->add_function("-$m",      'x', -10.5, 10.5, color => blue);
$plot[2]->add_function("-$m*x+$b", 'x', -10.5, 10.5, color => blue);
$plot[3]->add_function("$m*x-$b",  'x', -10.5, 10.5, color => blue);

$altTextMain = "The plot of a line that passes through (0,$b) and (2, "
    . (2 * $m + $b) . ").";

@altText = (
    "The plot of a horizontal line with y-intercept $m.",
    "The plot of a horizontal line with y-intercept " . -$m . ".",
    "The plot of a line that passes through (0,$b) and (-2, "
        . (2 * $m + $b) . ").",
    "The plot of a line that passes through (0, "
        . (-$b)
        . ") and (-2, "
        . (-2 * $m - $b) . ")."
);

@order = random_subset(4, 0 .. 3);
@inv[@order] = 0 .. 3;

$dd = DropDown([ "A", "B", "C", "D" ], $inv[0]);

$dir = ($m > 0) ? "positive" : "negative";

BEGIN_PGML
The graph of [` f(x)`] is shown below.

>> [![$altTextMain]!]{$main_plot}{300} <<

Which of the following is the graph [` f'(x) `]? [__]{$dd}

[# [. *A* .][.[![$altText[$order[0]]]!]{$plot[$order[0]]}{250} .]
   [. *B* .][.[![$altText[$order[1]]]!]{$plot[$order[1]]}{250} .]*
   [. *C* .][.[![$altText[$order[2]]]!]{$plot[$order[2]]}{250} .]
   [. *D* .][.[![$altText[$order[3]]]!]{$plot[$order[3]]}{250} .]*
#]{padding => 0.25}

END_PGML

BEGIN_PGML_SOLUTION
The function [`f`] is linear with constant [$dir] slope. The only graph with these characteristics is graph [$dd].
END_PGML_SOLUTION

ENDDOCUMENT();

