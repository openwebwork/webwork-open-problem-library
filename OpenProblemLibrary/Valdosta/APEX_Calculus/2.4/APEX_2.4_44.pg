#Problem APEX 2.4.44
## DBsubject(Calculus - single variable)
## DBchapter(Differentiation)
## DBsection(Conceptual understanding of derivatives)
## KEYWORDS('graphs', 'derivative')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## MLT(graphs derivatives)
## Level(2)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('2.4')
## Problem1('43')

DOCUMENT();
loadMacros(
    'PGstandard.pl',     'PGML.pl', 'plots.pl',
    'PGchoicemacros.pl',
    'parserPopUp.pl',    'PGcourse.pl'
);

$x1 = random(-4,  -1,  .5);
$x2 = random( 1,   4,  .5);
$yv = random(0.5, 2.5, .5) * random(-1, 1, 2);

$a = -4 * $yv / ($x2 - $x1)**2;
$b = $a * (-$x1 - $x2);
$c = $a * $x1 * $x2;

$f = "$a x^2 + $b x + $c";

$d = random(-20, 20) / 10;
$F = "$a x^3 / 3 + $b x^2 / 2 + $c x + $d";

$y1 = $a * ($x1**3) / 3 + $b * ($x1**2) / 2 + $c * ($x1) + $d;
$y2 = $a * ($x2**3) / 3 + $b * ($x2**2) / 2 + $c * ($x2) + $d;

$ymax   = int(max($y1, $y2)) + 3;
$ymin   = int(min($y1, $y2)) - 3;
$yrange = $ymax - $ymin;

$main_plot = Plot(rounded_corners => 1);
$main_plot->add_function($F, 'x', -5.5, 5.5, color => 'blue');

$plot[$_] = Plot(rounded_corners => 1) for (0 .. 3);
$plot[0]->add_function("$f",       'x', -5.5, 5.5, color => blue);
$plot[1]->add_function("$f+2",      'x', -5.5, 5.5, color => blue);
$plot[2]->add_function("-$f", 'x', -5.5, 5.5, color => blue);
$plot[3]->add_function("-$f+2",  'x', -5.5, 5.5, color => blue);

$altTextMain =
    "A plot of a smooth continuous function that "
    . ($a > 0 ? "rises" : 'falls')
    . " to a "
    . ($a > 0 ? 'maximum' : 'minimum')
    . " at x = $x1 then "
    . ($a > 0 ? "falls" : 'rises')
    . " to a "
    . ($a > 0 ? 'minimum' : 'maximum')
    . " at x = $x2 finally "
    . ($a > 0 ? "rising" : 'falling')
    . " the remainder of the plot.";

# Some info for the alt text of the choices

$corConcav   = $a > 0 ? 'up'   : 'down';
$incorConcav = $a > 0 ? 'down' : 'up';

$d_b = $b**2 - 4 * $a * ($c + 2);
if ($d_b > 0) {
    $x1_b = Round((-$b + sqrt($d_b)) / 2, 1);
    $x2_b = Round((-$b - sqrt($d_b)) / 2, 1);
}

# -a x^2 -b x -c+2
$d_d = (-$b)**2 - 4 * (-$a) * (-$c + 2);
if ($d_d > 0) {
    $x1_d = Round(-1 * ($b + sqrt($d_d)) / (2 * $a), 1);
    $x2_d = Round(-1 * ($b - sqrt($d_d)) / (2 * $a), 1);
}

@altText = (
    "The graph of a parabola opening $corConcav with x-intercepts of $x1 and $x2",
    $d_b > 0
    ? "The graph of a parabola opening $corConcav with intercepts of "
        . "about $x1_b and $x2_b"
    : "The graph of a parabola opening $corConcav with no intercepts on [-5, 5]",
    "The graph of a parabola opening $incorConcav with x-intercepts of $x1 and $x2",
    $d_d > 0
    ? "The graph of a parabola opening $corConcav with intercepts of "
        . "about $x1_d and $x2_d"
    : "The graph of a parabola opening up with no intercepts on [-5, 5]",
);

@order = random_subset(4, 0 .. 3);
@inv[@order] = 0 .. 3;

$dd = DropDown([ "A", "B", "C", "D" ], $inv[0]);


BEGIN_PGML
The graph of [` f(x)`] is shown below.

>> [![$altTextMain]!]{$main_plot}{300} <<

Which of the following is the graph [` f'(x) `]? [__]{$dd}

[# [. *A* .][.[![$altText[$order[0]]]!]{$plot[$order[0]]}{250} .]
   [. *B* .][.[![$altText[$order[1]]]!]{$plot[$order[1]]}{250} .]*
   [. *C* .][.[![$altText[$order[2]]]!]{$plot[$order[2]]}{250} .]
   [. *D* .][.[![$altText[$order[3]]]!]{$plot[$order[3]]}{250} .]*
#]{padding => 0.25}

END_PGML

BEGIN_PGML_SOLUTION
Estimate the slope of the curve.

* For [`x`]-values where [`f`] is horizontal, [`f'`] will be zero.
* For [`x`]-values where [`f`] is increasing (has positive slope), [`f'`] will have positive value.
* For [`x`]-values where [`f`] is decreasing (has negative slope), [`f'`] will have negative value.
END_PGML_SOLUTION
ENDDOCUMENT();

