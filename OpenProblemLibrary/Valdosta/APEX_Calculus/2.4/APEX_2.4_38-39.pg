#Problem APEX 2.4.38-39
## DBsubject(Calculus - single variable)
## DBchapter(Differentiation)
## DBsection(Higher-order derivatives)
## KEYWORDS('higher-order derivatives')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## Level(3)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('2.4')
## Problem1('38 39')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context("Numeric");
Context()->noreduce('(-x)-y', '(-x)+y');

$a = random(2, 9) * random(-1, 1, 2);
$u = Formula("$a x");
$v         = list_random(Formula("sin(x)"), Formula("cos(x)"));
$dv        = $v->D('x');
$d2v       = $dv->D('x');
$d3v       = $d2v->D('x');
$d4v       = $d3v->D('x');

# separate objects are required for combining like terms
$f             = $u * $v;
$f1_raw        = $f->D('x');
$f2_raw        = $f1_raw->D('x');
$f2_simplified = Compute("2*$a*$dv + $u*$d2v")->reduce;
$f3_raw        = $f2_simplified->D('x');
$f3_simplified = Compute("3*$a*$d2v + $u*$d3v")->reduce;
$f4_raw        = $f3_simplified->D('x');
$f4_simplified = Compute("4*$a*$d3v + $u*$d4v")->reduce;

BEGIN_PGML
Let [`  f(x) = [$f]  `].  Find the requested
derivatives.

a) [` f'(x) = `][_]{$f1_raw}

b) [` f''(x) = `][_]{$f2_simplified}

c) [` f'''(x) = `][_]{$f3_simplified}

d) [` f^{(4)}(x) = `][_]{$f4_simplified}
END_PGML

BEGIN_PGML_SOLUTION

Use the Product Rule and combine like terms for each derivative.

[```
  \begin{aligned}
   f'(x) &= [$f1_raw] \\
   f''(x) &= [$f2_raw] \\
   &= [$f2_simplified] \\
   f'''(x) &= [$f3_raw] \\
   &= [$f3_simplified] \\
   f^{(4)}(x) &= [$f4_raw] \\
   &= [$f4_simplified] \\
    \end{aligned}
```]
END_PGML_SOLUTION

ENDDOCUMENT();

