#Problem APEX 2.4.43
## DBsubject(Calculus - single variable)
## DBchapter(Differentiation)
## DBsection(Conceptual understanding of derivatives)
## KEYWORDS('graphs', 'derivative')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## Level(2)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('2.4')
## Problem1('43')

DOCUMENT();

loadMacros(
    'PGstandard.pl', 'PGML.pl', 'plots.pl', 'parserPopUp.pl',
    'PGcourse.pl'
);

$x1 = random(-3, -1, .5);
$x2 = random( 1,  3, .5);

$y0 = random(-4, 4);
$y1 = random(-4, 4);

$m1 = ($y1 - $y0) / ($x1 + 5);

do {
    $y2 = random(-4, 4);
    $m2 = ($y2 - $y1) / ($x2 - $x1);
} while ($m2 == $m1);

do {
    $y3 = random(-4, 4);
    $m3 = ($y3 - $y2) / (5 - $x2);
} while ($m3 == $m2 || $m3 == $m1);

$b1 = $y0 + 5 * $m1;
$b2 = $y1 - $m2 * $x1;
$b3 = $y3 - 5 * $m3;

$main_plot = Plot(rounded_corners => 1);
$main_plot->add_dataset(
    [ -5,  $y0 ],
    [ $x1, $y1 ],
    [ $x2, $y2 ],
    [ 5,   $y3 ],
    color => 'blue',
    width => 1.5
);

%plot_opts = (
    color      => 'blue',
    start_mark => 'open_circle',
    end_mark   => 'open_circle',
    width      => 1.5
);
$plot[$_] = Plot(rounded_corners => 1) for (0 .. 3);
$plot[0]->add_function(
    [ "$m1", 'x', -5,  $x1, %plot_opts ],
    [ "$m2", 'x', $x1, $x2, %plot_opts ],
    [ "$m3", 'x', $x2, 5,   %plot_opts ],
);
$plot[1]->add_function(
    [ "-$m1*x-$b1", 'x', -5,  $x1, %plot_opts ],
    [ "-$m2*x-$b2", 'x', $x1, $x2, %plot_opts ],
    [ "-$m3*x-$b3", 'x', $x2, 5,   %plot_opts ],
);
$plot[2]->add_function(
    [ "-$m1", 'x', -5,  $x1, %plot_opts ],
    [ "-$m2", 'x', $x1, $x2, %plot_opts ],
    [ "-$m3", 'x', $x2, 5,   %plot_opts ],
);
$plot[3]->add_function(
    [ "$m3", 'x', -5,  $x1, %plot_opts ],
    [ "$m2", 'x', $x1, $x2, %plot_opts ],
    [ "$m1", 'x', $x2, 5,   %plot_opts ],
);

$altTextMain =
    "A plot of a function consisting of line segments that connects (-5, "
    . (-5 * $m1 + $b1)
    . "), ($x1,"
    . ($m1 * $x1 + $b1)
    . "), ($x2, "
    . ($m2 * $x2 + $b2) . ") "
    . "and (5, "
    . (5 * $m3 + $b3) . ").";

@altText = (
    "A plot of a function consisting of horizontal line segments. Between x=-5 "
        . "and x=$x1 the y-value is $m1.  Between x=$x1 and x=$x2, the y-value is $m2."
        . "Between x=$x2 and x=5, the y-value is $m3.",
    "A plot of a function consisting of line segments that connects (-5, "
        . (-$m1 * -5 - $b1)
        . "), ($x1,"
        . (-$m1 * $x1 - $b1)
        . "), ($x2, "
        . (-$m2 * $x2 - $b2) . ") "
        . "and (5, "
        . (-5 * $m3 - $b3) . ").",
    "A plot of a function consisting of horizontal line segments. Between x=-5 "
        . "and x=$x1 the y-value is "
        . (-$m1)
        . ". Between x=$x1 and x=$x2, the "
        . "y-value is "
        . (-$m2)
        . ". Between x=$x2 and x=5, the y-value is "
        . (-$m3) . ".",
    "A plot of a function consisting of horizontal line segments. Between x=-5 "
        . "and x=$x1 the y-value is $m3.  Between x=$x1 and x=$x2, the y-value is $m2."
        . "Between x=$x2 and x=5, the y-value is $m1.",
);

@order = random_subset(4, 0 .. 3);
@inv[@order] = 0 .. 3;

$dd = DropDown([ "A", "B", "C", "D" ], $inv[0]);

BEGIN_PGML
The graph of [` f(x)`] is shown below.


>> [! [$altTextMain] !]{$main_plot}{300} <<

Which of the following is the graph of [` f'(x) `]? [__]{$dd}

[# [. *A* .][.[![$altText[$order[0]]]!]{$plot[$order[0]]}{250} .]
   [. *B* .][.[![$altText[$order[1]]]!]{$plot[$order[1]]}{250} .]*
   [. *C* .][.[![$altText[$order[2]]]!]{$plot[$order[2]]}{250} .]
   [. *D* .][.[![$altText[$order[3]]]!]{$plot[$order[3]]}{250} .]*
#]{padding => 0.25}

END_PGML

BEGIN_PGML_SOLUTION
[`f`] is made up of line segments, each with constant slope. Therefore, [`f'`] will have a constant value on the [`x`]-interval corresponding to each line segment.

Estimate the slope of each line segment. 

* For [`x`]-values where [`f`] is horizontal, [`f'`] will be zero.
* For [`x`]-values where [`f`] is increasing (has positive slope), [`f'`] will have positive value.
* For [`x`]-values where [`f`] is decreasing (has negative slope), [`f'`] will have negative value.

The correct answer is [$dd].
END_PGML_SOLUTION

ENDDOCUMENT();

