
## DBsubject(Calculus - single variable)
## DBchapter(Integrals)
## DBsection(Riemann sums)
## KEYWORDS('Riemann sum', 'midpoint rule')
## Institution(Valdosta State University)
## KEYWORDS(definite integral, fundamental theorem of calculus)
## Author(S. V. Ault)
## Level(3)
## MO(1)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('5.3')
## Problem1('29')

#Problem APEX 5.3.29
# Adapted from: Rochester/setIntegrals0Theory/S05.01.AreaDistance.PTP01.pg

DOCUMENT();
loadMacros(
    'PGstandard.pl', 'PGML.pl', 'plots.pl', 'parserPopUp.pl',
    'PGcourse.pl'
);

Context("Numeric");

$f = Compute('2^x');
# left and right endpoints of the interval
$a  = random(0, 1);
$b  = $a + random(2, 3);
$n  = 5;                   # number of rectangles
$dx = ($b - $a) / $n;

$sumType =
    DropDown([ 'left endpoint', 'right endpoint', 'midpoint' ], 'midpoint');

$RiemannSum = 0;
$RiemannSum += $f->eval(x => $a + ($_ + 0.5) * $dx) for (0 .. $n - 1);
$RiemannSum = Real("$dx * $RiemannSum");

$plot = Plot(
    xmin            => -1,
    xmax            =>  5,
    xtick_delta     =>  1,
    xminor          =>  1,
    ymin            => -1,
    ymax            => 20,
    ytick_delta     =>  5,
    yminor          =>  4,
    rounded_corners => 1
);

$plot->add_function('2^x', 'x', -1, 5, color => 'blue');

@x = map { $a + $_ * $dx } (0 .. $n);
@y = map { $f->eval(x => $a + ($_ + 0.5) * $dx) } (0 .. $n - 1);

for my $k (0 .. $n - 1) {
    $plot->add_rectangle(
        [ $x[$k], 0 ], [ $x[ $k + 1 ], $y[$k] ],
        fill_color => 'lightblue',
        width      => 1
    );
}

BEGIN_PGML
 The five rectangles in the graph below illustrate a

    [_]{$sumType}{ cmp_options => { weight => 10 } } (select a description)

Riemann sum for
[`` f(x) = [$f] ``] on the interval [` [[$a], [$b]] `].

The value of this Riemann sum
is [_]{$RiemannSum}{30}{ cmp_options => { weight => 90 } }.

>>[!!]{$plot}{400}<<

END_PGML

BEGIN_PGML_SOLUTION
This is a midpoint Riemann sum.  Its value is:
[```
\begin{aligned}
  &f([$x[0]]) \cdot [$dx] +
  f([$x[1]]) \cdot [$dx] +
  f([$x[2]]) \cdot [$dx] +
  f([$x[3]]) \cdot [$dx] +
  f([$x[4]]) \cdot [$dx] \\
  &\quad\approx \left( [$y[0]] + [$y[1]] + [$y[2]] + [$y[3]] + [$y[4]] \right)
  \cdot [$dx] \\
  &\quad\approx [$RiemannSum].
\end{aligned}
```]

END_PGML_SOLUTION

ENDDOCUMENT();

