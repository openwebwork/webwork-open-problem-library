## Problem1('13')

#Problem APEX 5.3.13

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Numeric')->variables->are(i => 'Real');

$x  = random(1, 4);
$a1 = $x * ($x + 1);

$n      = random(5, 7);
@series = ($a1);
push(@series, ($x + $_) * ($x + $_ + 1)) for (1 .. $n - 1);

$upper = Real("$n + $x - 1");
$term  = Formula("i(i+1)");

BEGIN_PGML

Write the sum in summation notation, using the given
lower bound.

[```
  [@ join('+', @series) @] = \sum_{i=[$x]}^{b} a_i
```]

[`b = `][_]{$upper}{5}, [`a_i = `][_]{$term}{10}
END_PGML

$x1 = $x + 1;

BEGIN_PGML_SOLUTION
[```
\begin{aligned}
  [@ join('+', @series) @] & = [$x] ([$x] + 1) + [$x1] ([$x1] + 1) + \cdots + [$upper] ([$upper] + 1) \\
  & = \sum_{i=[$x]}^{[$upper]} i(i+1)
\end{aligned}
```]
END_PGML_SOLUTION
ENDDOCUMENT();    
