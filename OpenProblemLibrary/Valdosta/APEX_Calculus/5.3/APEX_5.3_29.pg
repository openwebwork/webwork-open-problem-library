## DBsubject(Calculus - single variable)
## DBchapter(Integrals)
## DBsection(Riemann sums)
## KEYWORDS('Riemann sum', 'right-hand rule', 'left-hand rule')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## KEYWORDS(definite integral, fundamental theorem of calculus)
## Level(3)
## MO(1)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('5.3')
## Problem1('29')

#Problem APEX 5.3.29
## Adapted from: Rochester/setIntegrals0Theory/S05.01.AreaDistance.PTP01.pg

DOCUMENT();
loadMacros(
    'PGstandard.pl',  'PGML.pl',
    'parserPopUp.pl',
    'plots.pl',       'weightedGrader.pl',
    'PGcourse.pl'
);

# Define the interval ($a,$b):
$a  = 0;
$b  = pi;
$n  = 4;
$dx = ($b - $a) / $n;
$c  = random(2, 5);
$f  = Compute("$c*sin(x)");

for my $k (0 .. 1) {
    $plot[$k] = Plot(
        xmin            => -3.5,
        xmax            =>  7,
        xtick_positions => [ -3.14, -1.57, 1.57, 3.14, 4.71, 6.28 ],
        xtick_labels    => {
            1.57  => '\(\frac{\pi}{2}\)',
            -1.57 => '\(-\frac{\pi}{2}\)',
            3.14  => '\(\pi\)',
            -3.14 => '\(-\pi\)',
            4.71  => '\(\frac{3\pi}{2}\)',
            6.28  => '\(2\pi\)',
        },
        xtick_delta     => pi / 2,
        ymin            => -($c + 1),
        ymax            => $c + 1,
        ytick_delta     => 1,
        yminor          => 1,
        rounded_corners => 1
    );
    $plot[$k]->add_function($f, 'x', -pi, 2 * pi, color => 'blue');
}

@x = map { $a + $_ * $dx } (0 .. $n);
@y = map { $f->eval(x => $a + $_ * $dx) } (0 .. $n);

@sum = (0, 0);    # store the Riemann sum.

for my $j (0 .. 1) {
    for my $k (0 .. $n - 1) {
        $plot[$j]->add_rectangle(
            [ $x[$k], 0 ], [ $x[ $k + 1 ], $y[ $k + $j ] ],
            fill_color => 'lightblue',
            width      => 1
        );
    }
    $sumType[$j] =
        DropDown([ 'left endpoint', 'right endpoint', 'midpoint' ], $j);
    $sum[$j] += @y[ $_ + $j ] * $dx for (0 .. $n - 1);
    $sum[$j] = Compute($sum[$j]);
}

$altText[0] =
    "A plot of f(x)=$f that starts at (-pi,0), down to (-pi/2,$c), back to (0,0) and oscillates similarly. There are three rectangles. The first starts at (pi/4,0) with width pi/4 and height at the function on the left side. Similarly, each of the next two rectangles are width pi/2 with heights on the left side of each subinterval.";

$altText[1] =
    "A plot of f(x)=$f that starts at (-pi,0), down to (-pi/2,$c), back to (0,0) and oscillates similarly. There are three rectangles. The first starts at (0,0) with width pi/4 and height at the function on the right side. Similarly, each of the next two rectangles are width pi/2 with heights on the right side of each subinterval.";
BEGIN_PGML
The following demonstrate Riemann sums of the function 
[``` f(x) = [$f]```]
on the interval [` [0,\pi]`] with [`n = [$n]`] subintervals.

a) The rectangles in the graph below illustrate a [_]{$sumType[0]}{ cmp_options => { weight => 5 } }

    >>[![$altText[0]]!]{$plot[0]}{400}<<

    The value of this Riemann sum
    is [_]{$sum[0]}{30}{ cmp_options => { weight => 45 } }.

b) The rectangles in the graph below illustrate a [_]{$sumType[1]}{ cmp_options => { weight => 5 } }

    >>[![$altText[1]]!]{$plot[1]}{400}<<

    The value of this Riemann sum
    is [_]{$sum[1]}{30}{ cmp_options => { weight => 45 } }.
END_PGML

BEGIN_PGML_SOLUTION
a) This is a left endpoint Riemann sum.  Its value is:
    [```
    \begin{aligned}
   & f(0) \cdot \frac{\pi}{4} +
     f\left(\frac{\pi}{4}\right) \cdot \frac{\pi}{4} +
     f\left(\frac{\pi}{2}\right) \cdot \frac{\pi}{4} +
     f\left(\frac{3\pi}{4}\right) \cdot \frac{\pi}{4} \\
   &\quad = \left(0 + \frac{[$c] \sqrt{2}}{2} + [$c] + \frac{[$c] \sqrt{2}}{2}\right) \cdot \frac{\pi}{4} \\
   &\quad = [$sum[0]].
    \end{aligned}
    ```]

    ---

b) This is a right endpoint Riemann sum.  Its value is:
    [```
    \begin{aligned}
  & f\left(\frac{\pi}{4}\right) \cdot \frac{\pi}{4} +
  f\left(\frac{\pi}{2}\right) \cdot \frac{\pi}{4} +
  f\left(\frac{3\pi}{4}\right) \cdot \frac{\pi}{4} +
  f(\pi) \cdot \frac{\pi}{4} \\
  &\quad = \left(\frac{[$c] \sqrt{2}}{2} + [$c] + \frac{[$c] \sqrt{2}}{2} + 0\right) \cdot \frac{\pi}{4} \\
  &\quad = [$sum[0]].
    \end{aligned}
    ```]

END_PGML_SOLUTION
ENDDOCUMENT();

