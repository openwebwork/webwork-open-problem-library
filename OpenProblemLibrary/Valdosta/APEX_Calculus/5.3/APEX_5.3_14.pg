#Problem APEX 5.3.14

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'PGcourse.pl');

Context('Fraction')->variables->are(i => 'Real');

$x  = 1;
$n  = random(4, 9);
$a1 = Fraction(1, 2);

@series = ($a1);
push(@series, Fraction($_, $_ + 1)) for (2 .. $n);

$upper = Real($n + $x - 1);
$term  = Formula("i/(i+1)");

$str_sum = join('+', map { $_->TeX } @series);

BEGIN_PGML

Write the sum in summation notation, using the given
lower bound.

[```  [$str_sum] = \sum_{i=[$x]}^{b} a_i```]

[`b = `][_]{$upper}{5}, [`a_i = `][_]{$term}{10}
END_PGML

$x1 = $x + 1;

BEGIN_PGML_SOLUTION
[```
\begin{aligned}
  [$str_sum] & = \frac{1}{1+1} + \frac{2}{2 + 1} + \cdots + 
  \frac{[$upper]}{[$upper] + 1} \\
  & = \sum_{i=[$x]}^{[$upper]} \frac{i}{i+1}
\end{aligned}
```]
END_PGML_SOLUTION
ENDDOCUMENT();    
