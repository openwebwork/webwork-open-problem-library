## Section1('5.3')
## Problem1('15')

#Problem APEX 5.3.15

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context("Numeric")->variables->are(i => 'Real');

$x  = 0;
$n  = random(2, 5);
$a1 = "1 - e";

@sum = ($a1);
for my $i (1 .. $n) {
    $e1   = 2 * $i;
    $e2   = 2 * $i + 1;
    $next = "e^{$e1} - e^{$e2}";
    push(@sum, $next);
}
$b  = 2 * $n + 2;
$an = "e^{$b}";
push(@sum, $an);

$str_sum = join('+', @sum);

$upper = Real("2*$n + 2");

$term = Formula("(-1)^i * e^i");
$term->{test_points} = [ map { [$_] } (0 .. 10) ];

BEGIN_PGML

Write the sum in summation notation, using the given
lower bound.

[```
  [$str_sum] = \sum_{i=[$x]}^{b} a_i
```]

[`b = `][_]{$upper}{5}, [`a_i = `][_]{$term}{10}
END_PGML

BEGIN_PGML_SOLUTION
[```
\begin{aligned}
  &[$str_sum] \\
  &\quad = (-1)^0 e^0 + (-1)^1 e^1 + (-1)^2 e^2 + \cdots
  (-1)^{[$upper]} e^{[$upper]} \\
  &\quad = \sum_{i=[$x]}^{[$upper]} (-1)^i e^i
\end{aligned}
```]
END_PGML_SOLUTION
ENDDOCUMENT();    
