#Problem APEX 1.6.14

## DBsubject(Calculus - single variable)
## DBchapter(Limits and continuity)
## DBsection(Limits at infinity, horizontal and oblique asymptotes)
## KEYWORDS('limit','infinite')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## Level(2)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('1.6')
## Problem1('14')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'plots.pl', 'PGcourse.pl');
Context("Numeric");

$a  = random(2, 5);
$b  = random(1, 9);
$b1 = $b + 1;
$f  = Formula("$a^x + $b");

$plot = Plot(
    xmin            => -5,
    xmax            =>  5,
    xtick_delta     =>  2,
    xminor          =>  1,
    ymin            => -10,
    ymax            => 10 * $b,
    ytick_delta     => 10,
    yminor          => 0,
    rounded_corners => 1
);
$plot->add_function($f, 'x', -6, 6, color => 'blue');

$ans_a = Real($b);
$ans_b = Compute("INF");
$ans_c = Real($b1);

BEGIN_PGML
>> [!A graph of the function f = f = [$a] to the power x, plus [$b]!]{$plot}{400} <<
---
Evaluate the given limits using the graph of 
the function [` f(x) = \displaystyle 
[$a]^x + [$b] `] shown above.

a) [`` \lim_{x \to -\infty} f(x)``] = [__]{$ans_a} 

b) [`` \lim_{x \to \infty} f(x)``] = [__]{$ans_b}

c) [`` \lim_{x \to 0} f(x)``] = [__]{$ans_c}

See [@ helpLink("limit") @]*
END_PGML

#####################################################################

BEGIN_PGML_SOLUTION
a. [``
  \lim_{x \to -\infty} ([$a]^x + [$b]) = 0 + [$b] = [$b].
``]
  
b. [``
  \lim_{x \to \infty} ([$a]^x + [$b]) = \infty.
``]
  
c. [``
  \lim_{x \to 0} ([$a]^x + [$b]) = [$a]^0 + [$b] = 1 + [$b] = [$b1].
``]
END_PGML_SOLUTION

ENDDOCUMENT();
