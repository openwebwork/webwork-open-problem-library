#Problem APEX 1.6.11
## DBsubject(Calculus - single variable)
## DBchapter(Limits and continuity)
## DBsection(Limits at infinity, horizontal and oblique asymptotes)
## KEYWORDS('limit','infinite')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## Level(2)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('1.6')
## Problem1('11')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'plots.pl', 'PGcourse.pl');

Context("Numeric");

$a    = random(1, 3);
$xmin = -8;
$ymin = -1;
$xmax = 8;
$ymax = 4;

$f = Formula("$a/(e^x+1)");

$ans_a   = Real($a);
$ans_b   = Real(0);
$ans_cde = Real($a / 2);

$plot = Plot(
    xmin            => -8,
    xmax            =>  8,
    xtick_delta     =>  2,
    xminor          =>  1,
    ymin            => -1,
    ymax            => $a + 2,
    ytick_delta     => 1,
    yminor          => 0,
    rounded_corners => 1
);
$plot->add_function($f, 'x', -8, 8, color => 'blue');

BEGIN_PGML

>> [!Graph of function f(x) defined below!]{$plot}{400} <<

---
Evaluate the given limits using the graph of 
the function [`` f(x) = \frac{[$a]}{e^x + 1}``] shown above.

a) [``\lim_{x \to -\infty} f(x)``] = [__]{$ans_a} 

b) [``\lim_{x \to \infty} f(x)``] = [__]{$ans_b}

c) [``\lim_{x \to 0^-} f(x)``] = [__]{$ans_cde}

d) [``\lim_{x \to 0^+} f(x)``] = [__]{$ans_cde}

e) [``\lim_{x \to 0} f(x)``] = [__]{$ans_cde}

See [@ helpLink("limit") @]*
END_PGML

BEGIN_PGML_SOLUTION
a) Looking at the graph, [`` \lim_{x \to -\infty} f(x) = [$ans_a]``]

b) Looking at the graph, [`` \lim_{x \to \infty} f(x) = [$ans_b]``]

c) Looking at the graph, [`` \lim_{x \to 0^-} f(x) = [$ans_cde]``]

d) Looking at the graph, [`` \lim_{x \to 0^+} f(x) = [$ans_cde]``]

e) Looking at the graph, [`` \lim_{x \to 0} f(x) = [$ans_cde]``]

END_PGML_SOLUTION

ENDDOCUMENT();
