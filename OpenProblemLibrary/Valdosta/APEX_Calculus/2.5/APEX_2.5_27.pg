## DBsubject(Calculus - single variable)
## DBchapter(Differentiation)
## DBsection(Derivatives involving multiple rules (no product, quotient, or chain rule))
## KEYWORDS('derivative', 'chain rule')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## Level(3)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('2.5')
## Problem1('27')

#Problem APEX 2.5.27

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context("Numeric")->variables->are(t => "Real");

$a = random(2, 9);
$b = random(2, 9) * random(-1, 1, 2);
$c = random(2, 9);
$d = random(2, 9) * random(-1, 1, 2);

$c2 = 2 * $c;

$f   = "\sin($a t + $b)";
$f_a = "sin($a t + $b)";

$g   = "\cos($c t^2 + $d t)";
$g_a = "cos($c t^2 + $d t)";

$fp   = "$a\cos($a t + $b)";
$fp_a = "$a cos($a t + $b)";

$gp   = "-($c2 t + $d)\sin($c t^2 + $d t)";
$gp_a = "-($c2 t + $d)sin($c t^2 + $d t)";

$ans = Formula("$fp_a * $g_a + $f_a * $gp_a");

##############################################
# Main text

BEGIN_PGML
Compute the derivative of the given function.

[```g(t) = [$f] [$g]```]

    [`g'(t) = `] [_]{$ans}{25}
END_PGML

##############################################
# Solution

BEGIN_PGML_SOLUTION
Use the Product Rule and Chain Rule.
[```
  \begin{aligned}
    g'(t) &=
    [$f] \frac{d}{dt}[ [$g] ] + \frac{d}{dt}[[$f]] [$g]\\
    &= [$f]( [$gp] ) + [$fp] [$g] \\
    &= [$gp] [$f] + [$fp] [$g]
  \end{aligned}
```]
END_PGML_SOLUTION

ENDDOCUMENT();    

