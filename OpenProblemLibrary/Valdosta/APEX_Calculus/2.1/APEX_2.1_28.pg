#Problem APEX 2.1.28
## DBsubject(Calculus - single variable)
## DBchapter(Differentiation)
## DBsection(Conceptual understanding of derivatives)
## KEYWORDS('graph of derivative')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## MLT(pickgraphderivative)
## Level(4)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('2.1')
## Problem1('28')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'plots.pl',
    'parserPopUp.pl', 'PGcourse.pl');

Context("Numeric");

$a = non_zero_random(-2, 2);

$main_plot = Plot(
    xmin            => -3,
    xmax            =>  3,
    xtick_delta     =>  1,
    xminor          =>  0,
    ymin            => -10,
    ymax            =>  10,
    rounded_corners => 1
);
$main_plot->add_function("$a*(x^3 - 4*x)", 'x', -10.5, 10.5, color => 'blue');
$altTextf =
    $a > 0
    ? "A continuous smooth graph from the 3rd quadrant, passing through "
    . " (-2,0) to a maximum near x=-1, passing through the origin, then to a "
    . " minimum about x=1, and rising the rest of the plot."
    : "A continuous smooth graph from the 2nd quadrant, falling through "
    . " (-2,0) to a minimum near x=-1, passing through the origin, then to a "
    . " maximum about x=1, and falling the rest of the plot.";

$altText[0] =
    $a > 0
    ? "A graph of a parabola opening up with vertex below the y-axis."
    : "A graph of a parabola opening down with vertex above the y-axis.";

$altText[1] =
    $a > 0
    ? "A graph of a parabola opening down with vertex above the y-axis."
    : "A graph of a parabola opening up with vertex below the y-axis.";

$altText[2] =
    $a > 0
    ? "The graph of a line with negative slope and passing through the origin."
    : "The graph of a line with positive slope and passing through the origin.";

$altText[3] =
    $a > 0
    ? "The graph of a line with positive slope and passing through the origin."
    : "The graph of a line with negative slope and passing through the origin.";

$plot[$_] = Plot(
    xmin            => -3,
    xmax            =>  3,
    xtick_delta     =>  1,
    xminor          =>  0,
    ymin            => -10,
    ymax            =>  10,
    rounded_corners => 1
) for (0 .. 3);
$plot[0]->add_function("$a*(3x^2 - 4)",  'x', -3.5, 3.5, color => blue);
$plot[1]->add_function("-$a*(3x^2 - 4)", 'x', -3.5, 3.5, color => blue);
$plot[2]->add_function("-$a*6x",         'x', -3.5, 3.5, color => blue);
$plot[3]->add_function("$a*6x",          'x', -3.5, 3.5, color => blue);

@order = random_subset(4, 0 .. 3);
@inv[@order] = 0 .. 3;

# The correct answer above is the 2nd one, so find where that has been ordered to.
$ans = DropDown([ "A", "B", "C", "D" ], $inv[0]);

BEGIN_PGML
The graph of [`f`] is shown below.

>>[![$altTextMain]!]{$main_plot}{300}<<

Choose the graph that best represents [` f'`]. [_]{$ans}

[# [. *A* .][.[![$altText[$order[0]]]!]{$plot[$order[0]]}{250} .]
   [. *B* .][.[![$altText[$order[1]]]!]{$plot[$order[1]]}{250} .]*
   [. *C* .][.[![$altText[$order[2]]]!]{$plot[$order[2]]}{250} .]
   [. *D* .][.[![$altText[$order[3]]]!]{$plot[$order[3]]}{250} .]*
#]{padding => 0.25}
END_PGML

BEGIN_PGML_SOLUTION
When [`f`] has negative slope, [`f'`] will have negative value.

When [`f`] has positive slope, [`f'`] will have positive value.

What is the slope of [`f`] at [`x=0`]? Which of the graphs has an appropriate value for [`f'(0)`]?
END_PGML_SOLUTION

ENDDOCUMENT();
