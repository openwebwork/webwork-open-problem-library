#Problem APEX 2.1.26

## DBsubject(Calculus - single variable)
## DBchapter(Differentiation)
## DBsection(Conceptual understanding of derivatives)
## KEYWORDS('Graph of derivative')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## MLT(pickgraphderivative)
## Level(4)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('2.1')
## Problem1('26')

DOCUMENT();
loadMacros(
    'PGstandard.pl',  'PGML.pl',
    'plots.pl',
    'parserPopUp.pl', 'PGcourse.pl'
);

# Set-up

Context("Numeric");

$m = (random(1, 5) * random(-1, 1, 2)) / 2;
$b = random(-3, 3);

$main_plot = Plot(rounded_corners => 1);
$main_plot->add_function("$m x + $b", 'x', -10.5, 10.5, color => 'blue');

$y1          = -2 * $m + $b;
$altTextMain = "A plot of a line through (0,$b) and (-2,$y1).";

$y2         = 2 * $m + $b;
$altText[0] = "A plot of a line through (0,$b) and (2,$y2).";
$altText[1] = "A plot of a horizontal line with y-intercept $m.";
$altText[2] = "A plot of a horizontal line with y-intercept " . -$m . ".";

$y3         = 2 * $m - $b;
$b3         = -$b;
$altText[3] = "A plot of a line through (0, $b3) and (4,$y3).";

$plot[$_] = Plot(rounded_corners => 1) for (0 .. 3);
$plot[0]->add_function("-$m*x+$b",      'x', -10.5, 10.5, color => blue);
$plot[1]->add_function("$m",            'x', -10.5, 10.5, color => blue);
$plot[2]->add_function("-$m",           'x', -10.5, 10.5, color => blue);
$plot[3]->add_function("($m*x)/2 - $b", 'x', -10.5, 10.5, color => blue);

@order = random_subset(4, 0 .. 3);
@inv[@order] = 0 .. 3;

# The correct answer above is the 2nd one, so find where that has been ordered to.
$ans = DropDown([ "A", "B", "C", "D" ], $inv[1]);

BEGIN_PGML
The graph of [`f`] is shown below.

>>[![$altTextMain]!]{$main_plot}{300}<<

Choose the graph that best represents [`f'`]. [_]{$ans}

[# [. *A* .][.[![$altText[$order[0]]]!]{$plot[$order[0]]}{250} .]
   [. *B* .][.[![$altText[$order[1]]]!]{$plot[$order[1]]}{250} .]*
   [. *C* .][.[![$altText[$order[2]]]!]{$plot[$order[2]]}{250} .]
   [. *D* .][.[![$altText[$order[3]]]!]{$plot[$order[3]]}{250} .]*
#]
END_PGML

BEGIN_PGML_SOLUTION
Since [`f`] is a linear function, its slope is constant.

In this case, the slope is [@ $m > 0 ? "positive" : "negative" @].

[$correct] is the graph that represents [`f'`] since it is both constant and [@ $m > 0 ? "positive" : "negative" @].
END_PGML_SOLUTION

ENDDOCUMENT();
