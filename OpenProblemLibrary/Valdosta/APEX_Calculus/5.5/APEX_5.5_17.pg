## DBsubject(Calculus - single variable)
## DBchapter(Techniques of integration)
## DBsection(Approximation)
## KEYWORDS('numerical integration', 'quadrature', "Simpson's Rule", 'Trapezoid Rule')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## Level(3)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('5.5')
## Problem1('17')

#Problem APEX 5.5.17

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'PGnumericalmacros.pl', 'PGcourse.pl');

Context('Numeric');

$a  = 1;
$b  = random(4, 15);
$n  = 6;
$dx = ($b - $a) / $n;

$c = random(2, 9, 1);
$f = Formula("$c * ln(x)");

$ans1 = trapezoid($f->perlFunction, $a, $b, steps => $n);
$ans2 = simpson($f->perlFunction, $a, $b, steps => $n);

BEGIN_PGML

[``` I =   \int_{[$a]}^{[$b]} [$f] \, dx```]
a) Approximate [`I`] with the Trapezoid Rule and [`n = [$n]`].

    [`I=\;`][_]{$ans1}{20}


b) Approximate [`I`] with Simpson's Rule and [`n = [$n]`].

    [`I=\;`][_]{$ans2}{20}
    
END_PGML

@x = map { $a + $_ * $dx } (0 .. $n);
@y = map { $f->eval(x => $_) } @x;

BEGIN_PGML_SOLUTION

[`\Delta x = \dfrac{b-a}{n} = \dfrac{[$b] - ([$a])}{[$n]} = [$dx]`].
Find the values of [`x_i`] and [`f(x_i)`].

[```
  \begin{array}{l|l|l}
  i & x_i & y_i = f(x_i) = [$f] \\ \hline
  1 & [$x[0]] & [$y[0]] \\
  2 & [$x[1]] & [$y[1]] \\
  3 & [$x[2]] & [$y[2]] \\
  4 & [$x[3]] & [$y[3]] \\
  5 & [$x[4]] & [$y[4]] \\
  6 & [$x[5]] & [$y[5]] \\
  7 & [$x[6]] & [$y[6]] \\
  \end{array}
```]

a) Trapezoid Rule:

    [```
    \begin{aligned}
      T & = \dfrac{\Delta x}{2}\left[ y_1 + 2(y_2 + y_3 + y_4 + y_5 + y_6) + y_7\right] \\
      & = \dfrac{[$dx]}{2}\left[ [$y[0]] + 2([$y[1]] + [$y[2]] + [$y[3]]+ [$y[4]]+ [$y[5]]) + [$y[6]]\right] \\
      & = [$ans1]
      \end{aligned}
    ```]

b) Simpson's Rule:

    [```
    \begin{aligned}
      S & = \dfrac{\Delta x}{3}\left[ y_1 + 4y_2 + 2y_3 + 4y_4 + y_5\right]\\
      & = \dfrac{[$dx]}{3}\left[ [$y[0]] + 4([$y[1]]) + 2([$y[2]]) + 4([$y[3]]) + 2([$y[4]])+4([$y[5]]) + [$y[6]]\right] \\
      & = [$ans2]
      \end{aligned}
    ```]
END_PGML_SOLUTION

ENDDOCUMENT();
