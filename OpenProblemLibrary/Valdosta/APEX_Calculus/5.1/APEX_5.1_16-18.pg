#Problem APEX 5.1.16-18

## DBsubject(Calculus - single variable)
## DBchapter(Integrals)
## DBsection(Indefinite integrals (with trigonometric functions))
## Institution(Valdosta State University)
## KEYWORDS(indefinite integral)
## Author(S. V. Ault)
## MLT(several)
## Level(3)
## MO(1)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('5.1')
## Problem1('11 12')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Numeric')->variables->add(t => 'Real', s => 'Real');
Context()->flags->set(reduceConstants => 0);

$a = random(2, 20) * random(-1, 1, 2);
$b = random(2, 20) * random(-1, 1, 2);
$c = random(2, 20);
$d = random(2, 20);

$integranda = "$a\sin x";
$integrandb = "$b\sec^2 s";
$integrandc = "\left($c \sec t \tan t + $d \csc t \cot t\right)";

### Answers

$antideriva = Formula("-$a cos(x)");
$antiderivb = Formula("$b tan(s)");
$antiderivc = Formula("$c sec(t) - $d csc(t)");

### Main text

BEGIN_PGML
Evaluate the given indefinite integrals.

a) [` \int [$integranda]  \, dx `] = [_______]{$antideriva->cmp(upToConstant=>1)}{30} [` + C`].

b) [` \int [$integrandb]  \, ds `] = [_______]{$antiderivb->cmp(upToConstant=>1)}{30} [` + C`].

c) [` \int [$integrandc]  \,dt `] = [_______]{$antiderivc->cmp(upToConstant=>1)}{30} [` + C`].
END_PGML

BEGIN_PGML_SOLUTION

a) [``
  \int [$integranda] \, dx = [$a] \int \sin x \, dx = -[$a] \cos x + C.
``]


b) [``
  \int [$integrandb] \, ds = [$b] \int \sec^2 s \, ds = [$b] \tan s + C.
``]


c) [`\;`]
    
    [```
      \begin{aligned}
        &\int [$integrandc] \, dt \\
        =& [$c] \int \sec t \tan t \, dt+ [$d] \int \csc t \cot t \, dt\\
         =&[$c] \sec t - [$d] \csc t + C.
      \end{aligned}
    ```]

END_PGML_SOLUTION

ENDDOCUMENT();    