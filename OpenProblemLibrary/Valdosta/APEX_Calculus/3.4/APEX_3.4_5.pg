#Problem APEX 3.4.5

## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Concavity and points of inflection)
## KEYWORDS('first derivative', 'second derivative', 'graph')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## Level(4)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('3.4')
## Problem1('5')
# Updated July, 2023

DOCUMENT();
loadMacros(
    'PGstandard.pl',  'PGML.pl', 'plots.pl', 'PGtikz.pl',
    'parserPopUp.pl', 'PGcourse.pl'
);

Context("Numeric")->noreduce('(-x)-y');

$m      = random(2, 5) * random(-1, 1, 2);
$b      = random(1, 5) * random(-1, 1, 2);
$minusm = -$m;

$f   = Compute("$m*x + $b")->reduce();
$df  = Formula("$m");
$ddf = Formula("0");

@dfopts  = ("$m", "$m*x+$b", "$m*x+$b",     "$m*x+$b");
@d2fopts = ("0",  "-1*$m",   "-1*$m*x +$b", "$m");

for my $k (0 .. 3) {
    $plot[$k] = Plot(
        xmin            => -10,
        xmax            =>  10,
        xtick_delta     =>  5,
        xminor          =>  4,
        ymin            => -10,
        ymax            =>  10,
        ytick_delta     =>  5,
        yminor          =>  4,
        rounded_corners => 1
    );
    $plot[$k]->add_function(
        [ $dfopts[$k],  'x', -10, 10, color => 'blue', linestyle => 'dashed' ],
        [ $d2fopts[$k], 'x', -10, 10, color => 'red' ]);
}

$altText = (
    "A plot with two horizontal lines.  The blue line has intercept of y=$b"
        . "The red line is horizontal with y-intercept of 0",
    "A plot with two lines.  The blue line has "
        . (($m > 0) ? 'positive' : 'negative')
        . " slope and "
        . "y-intercept of $b. The red line is horizontal with y-intercept of 0",
    "A plot with two lines.  The blue line has "
        . (($m > 0) ? 'positive' : 'negative')
        . " slope and "
        . "y-intercept of $b. The red line is horizontal with y-intercept of $minusm",
    "A plot with two lines.  The blue line has "
        . (($m > 0) ? 'positive' : 'negative')
        . " slope and "
        . "y-intercept of $b. The red line has "
        . (($m > 0) ? 'negative' : 'positive')
        . " slope and y-intercept of $b"
);

@shuffle = random_subset(4, 0 .. 3);
@inv[@shuffle] = 0 .. 3;

$dd = DropDown([ 'A' .. 'D' ], $inv[0]);

Context("Interval");
$CU = List("None");
$CD = List("None");

BEGIN_PGML
Let [`` f(x) = [$f] ``].

a) Find the first and second derivatives.

    [`f'(x) = `] [_]{$df}{10}

    [`f''(x) = `] [_]{$ddf}{10}

b) Identify the graph that displays [`f'`] in blue and dashed and [`f''`] in red. [_]{$dd}

    [#
        [.*A*.][. [![$altText[$shuffle[0]]]!]{$plot[$shuffle[0]]}{250} .]
        [.*B*.][. [![$altText[$shuffle[1]]]!]{$plot[$shuffle[1]]}{250} .]*
        [.*C*.][. [![$altText[$shuffle[2]]]!]{$plot[$shuffle[2]]}{250} .]
        [.*D*.][. [![$altText[$shuffle[3]]]!]{$plot[$shuffle[3]]}{250} .]*
    #]{padding => 0.25}

    

c) Using the graphs of [`f`] and [`f''`], indicate where [`f`] is
concave up and concave down.  Give your answer in the form of an interval.  If there is more than one interval separate them with commas.  If there are no intervals enter "None".

    [`f`] is concave up on [_]{$CU}{20}

    [`f`] is concave down on [_]{$CD}{20}
END_PGML

BEGIN_PGML_SOLUTION
[` f'(x) = [$df] `] and [`f''(x) = [$ddf]`].  Since the second
derivative is 0 everywhere,
the graph is never concave up nor concave down.
END_PGML_SOLUTION

ENDDOCUMENT();

