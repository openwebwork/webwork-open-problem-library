#Problem APEX 3.4.13

## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Concavity and points of inflection)
## KEYWORDS('first derivative', 'second derivative', 'graph')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## Level(4)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('3.4')
## Problem1('13')

DOCUMENT();
loadMacros(
    'PGstandard.pl',  'PGML.pl',
    'plots.pl',
    'parserPopUp.pl', 'PGcourse.pl'
);

Context("Numeric");
Context()->noreduce('(-x)-y');

$a    = random(2, 4) * random(-1, 1, 2);
$b    = random(1, 4);
$f    = Compute("$a/(x^2 + $b)");
$f_gr = "$a/(x^2 + $b)";

$a2    = 2 * $a;
$df    = Compute("(-$a2*x)/((x^2 + $b)^2)")->reduce();
$df_gr = "(-$a2 x)/(x^2 + $b)^2";

$coeff2 = 3 * $a2;
$coeff0 = -$a2 * $b;

$ddf    = Compute("($coeff2*x^2 + $coeff0)/((x^2 + $b)^3)")->reduce();
$ddf_gr = "($coeff2 x^2 + $coeff0)/(x^2 + $b)^3";

if ($b == 3) {
    $crit     = 1;
    $critdisp = 1;
} else {
    $crit     = ("sqrt($b/3)");
    $critdisp = "\sqrt{\frac{$b}{3}}";
}

Context('Interval');
if ($a > 0) {
    $CU = Compute("(-INF, -$crit) , ($crit, INF)")
        ->cmp(entry_type => "an interval");
    $CD = List("(-$crit, $crit)")->cmp(
        entry_type               => "an interval",
        correct_ans_latex_string => "\left(-$critdisp, $critdisp\right)"
    );
    $sol_str1 =
        "[`\left(-\infty, -$critdisp\right) , \left($critdisp, \infty\right)`]";
    $sol_str2 = "[`\left(-$critdisp, $critdisp\right)`]";
} else {
    $CU = List("(-$crit, $crit)")->cmp(
        entry_type               => "an interval",
        correct_ans_latex_string => "\left(-$critdisp, $critdisp\right)"
    );
    $CD = Compute("(-INF, -$crit) , ($crit, INF)")
        ->cmp(entry_type => "an interval");
    $sol_str1 = "[`\left(-$critdisp, $critdisp\right)`]";
    $sol_str2 =
        "[`\left(-\infty, -$critdisp\right) , \left($critdisp, \infty\right)`]";
}

@dfopts  = ("$df",  "$f",  "$df", "$f");
@d2fopts = ("$ddf", "$df", "$f",  "$ddf");

for my $k (0 .. 3) {
    $plot[$k] = Plot(
        xmin            => -5,
        xmax            =>  5,
        xtick_delta     =>  1,
        xminor          =>  0,
        ymin            => -2 * abs($a / $b),
        ymax            => 2 * abs($a / $b),
        ytick_delta     => 1,
        yminor          => 0,
        rounded_corners => 1
    );
    $plot[$k]->add_function(
        [
            $dfopts[$k], 'x', -10, 10,
            color     => 'blue',
            linestyle => 'dashed'
        ],
        [ $d2fopts[$k], 'x', -10, 10, color => 'red' ]
    );
}

@shuffle = random_subset(4, 0 .. 3);
@inv[@shuffle] = 0 .. 3;

$dd = DropDown([ 'A' .. 'D' ], $inv[0]);

$negA = -$a;

$fdescript =
    "symmetic about the y-axis, "
    . "starts near the x-axis, "
    . ($a > 0 ? 'increases' : 'decreases')
    . " to the y-intercept of "
    . Round($f->eval(x => 0), 1) . ' ' . 'then '
    . ($a > 0 ? 'decreases' : 'increases')
    . ' to the x-axis. ';

$dfdescript =
    "symmetric about the origin, starts near the "
    . 'x-axis, then '
    . ($a > 0 ? 'increases' : 'decreases')
    . ' to a local '
    . ($a > 0 ? 'max' : 'min')
    . ' near x=-1 then '
    . ($a < 0 ? 'increases' : 'decreases')
    . ' to a local '
    . ($a > 0 ? 'min' : 'max')
    . ' near x=1 and '
    . ($a > 0 ? 'increases' : 'decreases')
    . ' to the x-axis.';
$d2fdescript =
    "symmetic about the y-axis, "
    . "starts near the x-axis, "
    . ($a > 0 ? 'increases' : 'decreases')
    . " to a local "
    . ($a > 0 ? 'max' : 'min')
    . ' near x=-1.5, then '
    . ($a > 0 ? 'decreases' : 'increases')
    . " to a local "
    . ($a > 0 ? 'min' : 'max')
    . ' at x=0, then '
    . ($a > 0 ? 'increases' : 'decreases')
    . " to a local "
    . ($a > 0 ? 'max' : 'min')
    . ' near x=1.5, then ' . 'then '
    . ($a > 0 ? 'decreases' : 'increases')
    . ' to the x-axis. ';

@altText = (
    "A plot of two curves.  The dashed blue curve is $dfdescript "
        . "The red curve is $d2fdescript",
    "A plot of two curves.  The blue dashed curve is $fdescript "
        . "The red curve is $dfdescript",
    "A plot of two curves.  The blue dashed curve is $dfdescript "
        . "The red curve is $fdescript",
    "A plot of two curves.  The blue dashed curve is $fdescript "
        . "The red curve is $d2fdescript",
);

BEGIN_PGML
Let [`` f(x) = [$f] ``].

a) Find the first and second derivatives.
    - [`f'(x) = `] [_]{$df}{20}
    - [`f''(x) = `] [_]{$ddf}{20}

b) Identify the graph that displays [`f`] in blue and [`f''`] in red.  [_]{$dd}

   [#
        [.*A*.][. [![$altText[$shuffle[0]]]!]{$plot[$shuffle[0]]}{250} .]
        [.*B*.][. [![$altText[$shuffle[1]]]!]{$plot[$shuffle[1]]}{250} .]*
        [.*C*.][. [![$altText[$shuffle[2]]]!]{$plot[$shuffle[2]]}{250} .]
        [.*D*.][. [![$altText[$shuffle[3]]]!]{$plot[$shuffle[3]]}{250} .]*
    #]{padding => 0.25}

c) Using the graphs of [`f`] and [`f''`], indicate where [`f`] is
concave up and concave down.

    Give your answer as a list of intervals separated by commas.  If there are no such intervals, enter "None".
    - [`f`] is concave up on [_]{$CU}{20}
    - [`f`] is concave down on [_]{$CD}{20}
END_PGML

BEGIN_PGML_SOLUTION
Write [`f(x)=[$a](x^2+[$b])^{-1}`], and differentiate using the chain rule to get

[``f'(x)=[$df]``].

To find [`f'`] use the quotient rule and then simplify:

[``
  \begin{array}{rcl}
    f''(x) &=& \dfrac{(x^2 + [$b])^2(-[$a2]) + [$a2] x \cdot 2(x^2 + [$b])(2x)}
    {(x^2 + [$b])^4} \\
    \\
    &=& \dfrac{[$coeff2] x^2 + [$coeff0]}{(x^2 + [$b])^3}
  \end{array}
``]

Set [`f''(x) = 0`] and solve.

[``
  \begin{array}{rcl}
    \dfrac{[$coeff2] x^2 + [$coeff0]}{(x^2 + [$b])^3} &=& 0 \\
    \\
    [$coeff2] x^2 + [$coeff0] &=& 0 \\
    x^2 &=& \frac{-[$coeff0]}{[$coeff2]} \\
    x &=& \pm [$critdisp]
  \end{array}
``]

Use the graph of [`f''`] to help find where [`f`] is concave up and concave down.
- When [`f''(x) > 0`], [`f`] is concave up.  This happens on [$sol_str1]**.
- When [`f''(x) < 0`], [`f`] is concave down.  This happens on [$sol_str2]**.
END_PGML_SOLUTION
ENDDOCUMENT();

