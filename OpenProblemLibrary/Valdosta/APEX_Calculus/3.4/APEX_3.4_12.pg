#Problem APEX 3.4.12

## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Concavity and points of inflection)
## KEYWORDS('first derivative', 'second derivative', 'graph')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## Level(4)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('3.4')
## Problem1('12')

DOCUMENT();
loadMacros(
    'PGstandard.pl',  'PGML.pl',
    'plots.pl',
    'parserPopUp.pl', 'PGcourse.pl'
);

Context("Numeric");

$a = random(2, 3) * random(-1, 1, 2);

$f = Compute("$a*tan x");

$df  = Compute("$a*sec^2(x)")->reduce();
$ddf = Compute("2*$a*sec^2(x) * tan(x)")->reduce();

Context('Interval');

if ($a > 0) {
    $ConcaveUp =
        Compute("(-(pi), -pi/2) , (0, pi/2)")->cmp(entry_type => "an interval");
    $ConcaveDown =
        Compute("(-pi/2, 0) , (pi/2, pi)")->cmp(entry_type => "an interval");
    $sol_str1 = "[`\left(-\pi, -\dfrac{\pi}{2}\right)
    , \left(0, \dfrac{\pi}{2}\right)`]";
    $sol_str2 = "[`\left(-\dfrac{\pi}{2}, 0\right)
    , \left(\dfrac{\pi}{2}, \pi\right)`]";
} else {
    $ConcaveUp =
        Compute("(-pi/2, 0) , (pi/2, pi)")->cmp(entry_type => "an interval");
    $ConcaveDown =
        Compute("(-(pi), -pi/2) , (0, pi/2)")->cmp(entry_type => "an interval");
    $sol_str1 = "[`\left(-\dfrac{\pi}{2}, 0\right)
    , \left(\dfrac{\pi}{2}, \pi\right)`]";
    $sol_str2 = "[`\left(-\pi, -\dfrac{\pi}{2}\right)
    , \left(0, \dfrac{\pi}{2}\right)`]";
}

# plots.pl doesn't support sec(x), so redfine these functions. 
$ddf2   = "2*$a*tan(x)/cos^2(x)";
$df2 = "$a/cos^2(x)";
@dfopts  = ("$df2",   "$ddf2", "-1*($df2)", "$f");
@d2fopts = ("$ddf2", "$df2",   "$ddf2",    "-1*($ddf2)");


for my $k (0 .. 3) {
    $plot[$k] = Plot(
        xmin            => -3.5,
        xmax            =>  3.5,
        xtick_positions =>
            [ -3.14, -1.57, 1.57, 3.14],
        xtick_labels => {
            1.57  => '\(\frac{\pi}{2}\)',
            3.14  => '\(\pi\)',
            -1.57 => '\(-\frac{\pi}{2}\)',
            -3.14 => '\(-\pi\)',
        },
        ymin            => -2.5 * abs($a),
        ymax            => 2.5 * abs($a),
        ytick_delta     => 1,
        yminor          => 0,
        rounded_corners => 1
    );
    $plot[$k]->add_function(
        [ $dfopts[$k],  'x', -7.1,  7.1, color => 'blue', linestyle => 'dashed'],
        [ $d2fopts[$k], 'x', -7.1,  7.1, color => 'red' ],
    );
}

$negA = -$a;

$dfDescript =
    "is symmetric about the y-axis, periodic with period 2pi and for "
    . "every interval (-3pi/2,-pi/2), (-pi/2,pi/2), (pi/2,3pi/2) "
    . "looks like parabolic curves that opens "
    . ($a > 0 ? 'up' : 'down')
    . " with local "
    . ($a > 0 ? 'min' : 'max')
    . " along the line y=$a.";

$dfDescript2 =
    "is symmetric about the y-axis, periodic with period 2pi and for "
    . "every interval (-3pi/2,-pi/2), (-pi/2,pi/2), (pi/2,3pi/2) "
    . "looks like parabolic curves that opens "
    . ($a > 0 ? 'down' : 'up')
    . " with local "
    . ($a > 0 ? 'max' : 'min')
    . " along the line y=$negA.";

$df2Descript =
    "is symmetric about the origin, is periodic with period pi and "
    . ($a > 0 ? 'increases' : 'decreases')
    . " on intervals (-5/pi/2,-3pi/2), "
    . "(-3pi/2,-pi/2), (-pi/2,pi/2), (pi/2,3pi/2), (3pi/2,5pi/2).";

$df2Descript2 =
    "is symmetric about the origin, is periodic with period pi and "
    . ($a > 0 ? 'decreases' : 'increases')
    . " on intervals (-5/pi/2,-3pi/2), "
    . "(-3pi/2,-pi/2), (-pi/2,pi/2), (pi/2,3pi/2), (3pi/2,5pi/2).";

@altText = (
    "A plot with two graphs. The dashed blue curve is $dfDescript "
        . "The red curve is $df2Descript.",
    "A plot with two graphs. The dashed blue curve is $df2Descript "
        . "The red curve is $dfDescript.",
    "A plot with two graphs. The dashed blue curve is $dfDescript2 "
        . "The red curve is $d2fDescript.",
    "A plot with two graphs. The red curve is $df2Descript2 "
        . "The dashed blue curve is $df2Descript.",
);

@shuffle = random_subset(4, 0 .. 3);
@inv[@shuffle] = 0 .. 3;

$dd = DropDown([ 'A' .. 'D' ], $inv[0]);

$negA = -$a;

BEGIN_PGML
Consider the function [`` f(x) = [$f]``] on the interval [`` (-\pi, \pi) ``].

a) Find the first and second derivatives.
    - [`f'(x) = `] [_]{$df}{20}
    - [`f''(x) = `] [_]{$ddf}{20}

b) Identify the graph that displays [`f`] in dashed blue and [`f''`] in red. [_]{$dd}

    [#
        [.*A*.][. [![$altText[$shuffle[0]]]!]{$plot[$shuffle[0]]}{250} .]
        [.*B*.][. [![$altText[$shuffle[1]]]!]{$plot[$shuffle[1]]}{250} .]*
        [.*C*.][. [![$altText[$shuffle[2]]]!]{$plot[$shuffle[2]]}{250} .]
        [.*D*.][. [![$altText[$shuffle[3]]]!]{$plot[$shuffle[3]]}{250} .]*
    #]{padding => 0.25}

c) Using the graphs of [`f`] and [`f''`], indicate where [`f`] is concave up and concave down.
Give your answer as a list of intervals separated by commas.  If there are no such intervals, type "None". [@helpLink("interval")@]*

    - [`f`] is concave up on [_]{$ConcaveUp}{20}
    - [`f`] is concave down on [_]{$ConcaveDown}{20}
END_PGML

$a2 = 2 * $a;

BEGIN_PGML_SOLUTION
[` f'(x) = [$a] \sec^2 x `] and [`f''(x) = [$a2] \sec^2 x \tan x`].

Set [`f''(x) = 0`] and solve.

[```
  \begin{aligned}
    [$a2] \sec^2 x \tan x =& 0 \\
    \tan x =& 0 \quad \textrm{since}\; \sec x \neq 0 \; \textrm{for all}
    \; x \\
    x =&  0 \quad \textrm{is the only solution in the interval }(-\pi,\pi).
  \end{aligned}
```]

Note, [`f`] is undefined when [` x= \pm \dfrac{\pi}{2} `].

Use the graph of [`f''`] to help find where [`f`] is concave up and concave down.

- When [`f''(x) > 0`], [`f`] is concave up.  This happens on [$sol_str1]**.
- When [`f''(x) < 0`], [`f`] is concave down.  This happens on [$sol_str2]**.
END_PGML_SOLUTION
ENDDOCUMENT();
