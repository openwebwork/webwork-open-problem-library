#Problem APEX 3.4.8-9

## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Concavity and points of inflection)
## KEYWORDS('first derivative', 'second derivative', 'graph')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## Level(4)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('3.4')
## Problem1('8 9')

DOCUMENT();
loadMacros(
    'PGstandard.pl',      'PGML.pl',
    'plots.pl',           'parserPopUp.pl',
    "contextFraction.pl", 'PGcourse.pl'
);

Context("Fraction");

$c1 = random(-4, -1, 3);
$c2 = $c1 + 5;

$d = random(1, 3, 1) * random(-1, 1, 2);

$b2  = 3 * (-$c1 - $c2) / 2;
$b2F = Fraction(3 * (-$c1 - $c2) / 2)->reduce();
$b1  = 3 * ($c1 * $c2);

$f   = "x^3 + $b2 x^2 + $b1 x + $d";
$fMO = Compute("x^3 + $b2F*x^2 + $b1*x + $d")->reduce();
$b22 = 3 * (-$c1 - $c2);
$df  = Compute("3*x^2 + $b22*x + $b1")->reduce();

$ddf  = Compute("6*x + $b22")->reduce();
$crit = Fraction(($c1 + $c2) / 2);

$y1 = $c1**3 + $b2 * $c1**2 + $b1 * $c1 + $d;
$y2 = $c2**3 + $b2 * $c2**2 + $b1 * $c2 + $d;

$ymax   = max(abs($y1), abs($y2)) + 5;
$ymin   = -$ymax;
$yrange = $ymax - $ymin;

$cu = List(Interval("($crit, INF)"))->cmp(entry_type => "an interval");
$cd = List(Interval("(-INF, $crit)"))->cmp(entry_type => "an interval");

@dfopts  = ("$df",  "$f",  "$df", "$f");
@d2fopts = ("$ddf", "$df", "$f",  "$ddf");

for my $k (0 .. 3) {
    $plot[$k] = Plot(
        xmin            => -10,
        xmax            =>  10,
        xtick_delta     =>  5,
        xminor          =>  4,
        ymin            => -40,
        ymax            =>  40,
        ytick_delta     =>  10,
        yminor          =>  1,
        rounded_corners => 1
    );
    $plot[$k]->add_function(
        [
            $dfopts[$k], 'x', -10, 10,
            color     => 'blue',
            linestyle => 'dashed'
        ],
        [ $d2fopts[$k], 'x', -10, 10, color => 'red' ]
    );
}

@shuffle = random_subset(4, 0 .. 3);
@inv[@shuffle] = 0 .. 3;

$dd = DropDown([ 'A' .. 'D' ], $inv[0]);

@altText = (
    "A plot with two curves. The first in dashed blue is a parabola that opens up."
        . "  The second in red is a line with positive slope and y-intercept of $b22.",
    "A plot with two curves. The first in dashed blue rises from the left to a "
        . "local max near the origin, then descreases to a local min around x=4, then "
        . "increases for the rest of the plot.  The second graph in red is "
        . "a parabola that opens up.",
    "A plot with two curves.  The first in dashed blue is a parabola that opens up.  "
        . " The second in red rises from the left to a local max near the origin, "
        . "then decreases to a local min around x=4, then increases for the rest of the "
        . " plot.",
    "A plot with two curves. The first in dashed blue rises from the left to a "
        . "local max near the origin, then descreases to a local min around x=4, then "
        . "increases for the rest of the plot.  "
        . "The second in red is a line with positive slope and y-intercept of $b22. "
);

BEGIN_PGML
Let [`` f(x) = [$fMO] ``].

a) Find the first and second derivatives.
    - [`f'(x) = `] [_]{$df}{20}
    - [`f''(x) = `] [_]{$ddf}{20}
b) Identify the graph that displays [`f`] in dashed blue and [`f''`] in red. [_]{$dd}

   [#
        [.*A*.][. [![$altText[$shuffle[0]]]!]{$plot[$shuffle[0]]}{250} .]
        [.*B*.][. [![$altText[$shuffle[1]]]!]{$plot[$shuffle[1]]}{250} .]*
        [.*C*.][. [![$altText[$shuffle[2]]]!]{$plot[$shuffle[2]]}{250} .]
        [.*D*.][. [![$altText[$shuffle[3]]]!]{$plot[$shuffle[3]]}{250} .]*
    #]{padding => 0.25}

c) Using the graphs of [`f`] and [`f''`], indicate where [`f`] is
concave up and concave down.  Give your answer as a list of intervals separated by commas.  If there are no such intervals, enter "None". [@helpLink('interval')@]*
    - [`f`] is concave up on [_]{$cu}{20}
    - [`f`] is concave down on [_]{$cd}{20}
END_PGML

BEGIN_PGML_SOLUTION
[` f'(x) = [$df] `] and [`f''(x) = [$ddf]`].

Set [`f''(x) = 0`] and solve.

[``
  [$ddf] = 0 \;\Rightarrow \; x = [$crit].
``]

When [`x > [$crit]`], [`f''(x) > 0`] and so [`f`] is concave up
on [` ([$crit], \infty) `].

When [`x < [$crit]`], [`f''(x) < 0`] and so [`f`] is concave down
on [` (-\infty, [$crit]) `].
END_PGML_SOLUTION
ENDDOCUMENT();

