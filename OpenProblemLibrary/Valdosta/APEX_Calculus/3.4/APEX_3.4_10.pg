#Problem APEX 3.4.10

## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Concavity and points of inflection)
## KEYWORDS('first derivative', 'graph')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## Level(4)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('3.4')
## Problem1('10')

DOCUMENT();
loadMacros(    'PGstandard.pl',    'PGML.pl', 'plots.pl', 'parserPopUp.pl',
    'PGcourse.pl'
);

Context("Numeric");

$a = random(2, 5) * random(-1, 1, 2);
$b = random(2, 12) * random(-1, 1, 2);
$c = random(1, 25) * random(-1, 1, 2);

$f = Compute("$a*cos x");

$df  = Compute("-$a*sin(x)")->reduce();
$ddf = Compute("-$a*cos(x)")->reduce();

Context("Interval");
if ($a > 0) {
    $cu = Compute("(-3*pi/2, -pi/2) , (pi/2, 3*pi/2)")
        ->cmp(entry_type => "an interval");
    $cd = Compute("(-2*pi, -3*pi/2) , (-pi/2, pi/2) , (3*pi/2, 2*pi)")
        ->cmp(entry_type => "an interval");
    $sol_str1 = "[`\left(-\dfrac{3\pi}{2}, -\dfrac{\pi}{2}\right)
    , \left(\dfrac{\pi}{2}, \dfrac{3\pi}{2}\right)`]";
    $sol_str2 = "[`\left(-2\pi, -\dfrac{3\pi}{2}\right)
    , \left(-\dfrac{\pi}{2}, \dfrac{\pi}{2}\right)
    , \left(\dfrac{3\pi}{2}, 2\pi\right)`]";
} else {
    $cu = Compute("(-2*pi, -3*pi/2) , (-pi/2, pi/2) , (3*pi/2, 2*pi)")
        ->cmp(entry_type => "an interval");
    $cd = Compute("(-3*pi/2, -pi/2) , (pi/2, 3*pi/2)")
        ->cmp(entry_type => "an interval");
    $sol_str1 = "[`\left(-2\pi, -\dfrac{3\pi}{2}\right)
    , \left(-\dfrac{\pi}{2}, \dfrac{\pi}{2}\right)
    , \left(\dfrac{3\pi}{2}, 2\pi\right)`]";
    $sol_str2 = "[`\left(-\dfrac{3\pi}{2}, -\dfrac{\pi}{2}\right)
    , \left(\dfrac{\pi}{2}, \dfrac{3\pi}{2}\right)`]";
}

@dfopts  = ("$df",  "$f",  "$df", "$f");
@d2fopts = ("$ddf", "$df", "$f",  "$ddf");

for my $k (0 .. 3) {
    $plot[$k] = Plot(
        xmin            => -7,
        xmax            =>  7,
        xtick_positions     =>  [-6.28,-4.71, -3.14, -1.57, 1.57,3.14,4.71, 6.28],
        xtick_labels => {
            1.57 => '\(\frac{\pi}{2}\)',
            3.14 => '\(\pi\)',
            4.71 => '\(\frac{3\pi}{2}\)',
            6.28 => '\(2\pi\)',
           -1.57 => '\(-\frac{\pi}{2}\)',
            -3.14 => '\(-\pi\)',
            -4.71 => '\(-\frac{3\pi}{2}\)',
            -6.28 => '\(-2\pi\)',
        },
        ymin            => -abs($a)-1,
        ymax            => abs($a)+1,
        ytick_delta     =>  1,
        yminor          =>  0,
        rounded_corners => 1
    );
    $plot[$k]->add_function(
        [ $dfopts[$k],  'x', -10, 10, color => 'blue', linestyle => 'dashed' ],
        [ $d2fopts[$k], 'x', -10, 10, color => 'red' ]);
}

@shuffle = random_subset(4, 0 .. 3);
@inv[@shuffle] = 0 .. 3;

$dd = DropDown([ 'A' .. 'D' ], $inv[0]);

$negA = -$a; 

@altText = (
    # 'A',
      "A plot with two graphs. "
    . "There is a red curve that is periodic, symmetric about the y-axis and "
    . "has a y-intercept of y=$negA. "
    . "The dashed blue curve is periodic, symmetric about the origin and "
    . ( $a > 0 ? 'decreases' : 'increases'). ' ' 
    . "from the origin.",
          "A plot with two graphs. "
    . "There is a dashed blue curve that is periodic, symmetric about the y-axis and "
    . "has a y-intercept of y=$a. "
    . "The red cruve is periodic, symmetric about the origin and "
    . ( $a > 0 ? 'decreases' : 'increases'). ' ' 
    . "from the origin.",
    "A plot with two graphs. "
    . "There is a red curve that is periodic, symmetric about the y-axis and "
    . "has a y-intercept of y=$a. "
    . "The dashed blue curve is periodic, symmetric about the origin and "
    . ( $a > 0 ? 'decreases' : 'increases'). ' ' 
    . "from the origin.",
    "A plot with two graphs. "
    . "There is a red curve that is periodic, symmetric about the y-axis and "
    . "has a y-intercept of y=$negA. "
    . "The dashed blue curve is periodic, symmetric about the y-axis and "
    . "has a y-intercept of y=$a. "
);


BEGIN_PGML
Consider the function[`` f(x) = [$f]``] on the interval [`` (-2\pi, 2\pi) ``].

a) Find the first and second derivatives.
    - [`f'(x) = `] [_]{$df}{20}
    - [`f''(x) = `] [_]{$ddf}{20}
b) Identify the graph that displays [`f`] in dashed blue and [`f''`] in red. [_]{$dd}

   [#
        [.*A*.][. [![$altText[$shuffle[0]]]!]{$plot[$shuffle[0]]}{250} .]
        [.*B*.][. [![$altText[$shuffle[1]]]!]{$plot[$shuffle[1]]}{250} .]*
        [.*C*.][. [![$altText[$shuffle[2]]]!]{$plot[$shuffle[2]]}{250} .]
        [.*D*.][. [![$altText[$shuffle[3]]]!]{$plot[$shuffle[3]]}{250} .]*
    #]{padding => 0.25}

c) Using the graphs of [`f`] and [`f''`], indicate where [`f`] is
concave up and concave down.  Give your answer as a list of intervals separated by commas.  If there are no such intervals, enter "None".
[@ helpLink('interval') @]*
    - [`f`] is concave up on [_]{$cu}{20}
    - [`f`] is concave down on [_]{$cd}{20}
END_PGML

BEGIN_PGML_SOLUTION
[` f'(x) = -[$a] \sin x `] and [`f''(x) = -[$a] \cos x`].

Set [`f''(x) = 0`] and solve.

[`` -[$a] \cos x = 0 \;\Rightarrow \; x = -\dfrac{3\pi}{2}, -\dfrac{\pi}{2},
  \dfrac{\pi}{2}, \dfrac{3\pi}{2}. ``]

Use the graph of [`f''`] to help find where [`f`] is concave
up and concave down.

- When [`f''(x) > 0`], [`f`] is concave up.  This happens on [$sol_str1]**.
- When [`f''(x) < 0`], [`f`] is concave down.  This happens on [$sol_str2]**.
END_PGML_SOLUTION
ENDDOCUMENT();
