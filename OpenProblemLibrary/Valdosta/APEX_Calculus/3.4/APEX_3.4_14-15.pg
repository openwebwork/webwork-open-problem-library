#Problem APEX 3.4.14-15

## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Concavity and points of inflection)
## KEYWORDS('first derivative', 'second derivative', 'graph')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## Level(4)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('3.4')
## Problem1('14 15')

DOCUMENT();
loadMacros(
    'PGstandard.pl', 'PGML.pl', 'plots.pl', 'parserPopUp.pl',
    'PGcourse.pl'
);

Context('Numeric');
$n = random(1, 5);

$f_gr = "1/x^($n)";

$f = Compute("1/x^($n)")->reduce();

$n1 = $n + 1;

$df    = "\dfrac{-$n}{x^{$n1}}";
$df    = Compute("(-$n)/x^($n1)");
$df_gr = "(-$n)/(x^($n1))";

$n2  = $n + 2;
$num = $n * $n1;

$ddf    = Compute("$num/x^($n2)");
$ddf_gr = "$num/(x^($n2))";

$crit = 0;

Context('Interval');
if ($n % 2 == 0) {    # even $n
    $CU = List("(-INF, 0) , (0, INF)")->cmp(entry_type => "an interval");
    $CD = List("None")->cmp(entry_type => "an interval");
} else {    # Odd $n
    $CU = List("(0, INF)")->cmp(entry_type => "an interval");
    $CD = List("(-INF, 0)")->cmp(entry_type => "an interval");
}

@dfopts  = ("$df",  "$f",  "$df", "$f");
@d2fopts = ("$ddf", "$df", "$f",  "$ddf");

for my $k (0 .. 3) {
    $plot[$k] = Plot(
        xmin            => -4,
        xmax            =>  4,
        xtick_delta     =>  1,
        xminor          =>  0,
        ymin            => -16,
        ymax            =>  16,
        ytick_delta     =>  5,
        yminor          =>  4,
        rounded_corners => 1
    );
    $plot[$k]->add_function(
        [ $dfopts[$k],  'x', -5, 5, color => 'blue', linestyle => 'dashed' ],
        [ $d2fopts[$k], 'x', -5, 5, color => 'red' ]
    );
}

@shuffle = random_subset(4, 0 .. 3);
@inv[@shuffle] = 0 .. 3;

$dd = DropDown([ 'A' .. 'D' ], $inv[0]);

@altText = (
    "A: A plot of two curves. The red curve is symmetric about the y-axis, "
        . "starts near the x-axis, "
        . "and increases without bound with an vertical asymptote of x=0."
        . "The dashed blue curve is symmetric about the origin, "
        . "starts near the x-axis, "
        . "and increases without bound with an vertical asymptote of x=0."
        . "The red curve increases to the asymptote faster than the "
        . 'dashed blue curve.',
    "B: A plot of two curves. The red curve is symmetric about the origin, "
        . "starts near the x-axis, "
        . "and increases without bound with an vertical asymptote of x=0."
        . "The blue curve is symmetric about the y-axis, "
        . "starts near the x-axis, "
        . "and increases without bound with an vertical asymptote of x=0.",
    "C: A plot of two curves. The red curve is symmetric about the y-axis, "
        . "starts near the x-axis, "
        . "and increases without bound with an vertical asymptote of x=0."
        . "The blue curve is symmetric about the origin, "
        . "starts near the x-axis, "
        . "and increases without bound with an vertical asymptote of x=0."
        . "The dashed blue curve increases to the asymptote faster than the "
        . 'red curve.',
    "D: A plot of two curves. The red curve is symmetric about the y-axis, "
        . "starts near the x-axis, "
        . "and increases without bound with an vertical asymptote of x=0."
        . "The blue curve is symmetric about the y-axis, "
        . "starts near the x-axis, "
        . "and increases without bound with an vertical asymptote of x=0."
        . "The red curve increases to the asymptote faster than the "
        . 'blue curve.'
);

BEGIN_PGML
- [$altText[$shuffle[0]]]
- [$altText[$shuffle[1]]]
- [$altText[$shuffle[2]]]
- [$altText[$shuffle[3]]]

Let [`` f(x) = [$f]``]

a) Find the first and second derivatives.
    - [`f'(x) = `] [_]{$df}{20}
    - [`f''(x) = `] [_]{$ddf}{20}

b) Identify the graph that displays [`f`] in blue and [`f''`] in red. [_]{$dd}


   [#
        [.*A*.][. [![$altText[$shuffle[0]]]!]{$plot[$shuffle[0]]}{250} .]
        [.*B*.][. [![$altText[$shuffle[1]]]!]{$plot[$shuffle[1]]}{250} .]*
        [.*C*.][. [![$altText[$shuffle[2]]]!]{$plot[$shuffle[2]]}{250} .]
        [.*D*.][. [![$altText[$shuffle[3]]]!]{$plot[$shuffle[3]]}{250} .]*
    #]{padding => 0.25}

c) Using the graphs of [`f`] and [`f''`], indicate where [`f`] is concave up and concave down.
Give your answer as a list of intervals separated by commas.  If there are no such intervals, enter "None". [@helpLink('interval')@]*

    - [`f`] is concave up on [_]{$CU}{20}
    - [`f`] is concave down on [_]{$CD}{20}
END_PGML

BEGIN_PGML_SOLUTION
[` f'(x) = [$df] `] and [`f''(x) = [$ddf] `].

Use the graph of [`f''`] to help find where [`f`] is concave up and concave down.
Note, [`f`] is undefined at [`x = 0`].
- When [`f''(x) > 0`], [`f`] is concave up.
- When [`f''(x) < 0`], [`f`] is concave down.
END_PGML_SOLUTION
ENDDOCUMENT();

