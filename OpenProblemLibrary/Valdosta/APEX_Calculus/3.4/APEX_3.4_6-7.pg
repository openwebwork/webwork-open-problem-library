#Problem APEX 3.4.6-7

## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Concavity and points of inflection)
## KEYWORDS('first derivative', 'second derivative', 'graph')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## Level(4)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('3.4')
## Problem1('6 7')

DOCUMENT();
loadMacros(
    'PGstandard.pl',  'PGML.pl', 'plots.pl', 'PGtikz.pl',
    'parserPopUp.pl', 'PGcourse.pl'
);

Context("Numeric");
Context()->noreduce('(-x)-y', '(-x)+y');

$a2 = random(3, 6) * random(-1, 1, 2);
$b  = random(2, 5) * random(-1, 1, 2);
$c  = random(1, 5) * random(-1, 1, 2);

$a = $a2 / 2;

$f = Compute("$a*x^2 + $b*x + $c")->reduce();

$df  = Compute("$a2*x + $b");
$ddf = Formula("$a2");

Context("Interval");

if ($a > 0) {
    $CU = List(Interval("(-INF, INF)"))->cmp(entry_type => "an interval");
    $CD = List("None")->cmp(entry_type => "an interval");
} else {
    $CU = List("None")->cmp(entry_type => "an interval");
    $CD = List(Interval("(-INF, INF)"))->cmp(entry_type => "an interval");
}

@dfopts  = ("$df",  "$f",  "$df", "$f");
@d2fopts = ("$ddf", "$df", "$f",  "$ddf");

for my $k (0 .. 3) {
    $plot[$k] = Plot(
        xmin            => -10,
        xmax            =>  10,
        xtick_delta     =>  5,
        xminor          =>  4,
        ymin            => -10,
        ymax            =>  10,
        ytick_delta     =>  5,
        yminor          =>  4,
        rounded_corners => 1
    );
    $plot[$k]->add_function(
        [ $dfopts[$k],  'x', -10, 10, color => 'blue', linestyle => 'dashed' ],
        [ $d2fopts[$k], 'x', -10, 10, color => 'red' ]);
}

@altText = (
    "A plot with two graphs. The blue dashed one is a line with "
        . ($a > 0 ? 'positive' : 'negative')
        . " slope and y-intercept of $b. "
        . "The second is a horizontal line with y-intercept of $a2.",
    "A plot with two graphs.  The first is dashed blue and is a parabola that "
        . "opens "
        . ($a > 0 ? 'up.' : 'down.')
        . " The second in red is a line with "
        . ($a > 0 ? 'positive' : 'negative')
        . " slope and y-intercept $b.",
    "A plot with two graphs.  The first, in dashed blue is a line with "
        . ($a > 0 ? 'positive' : 'negative')
        . " slope and y-intercept of $a2. "
        . "The curve in red is a parabola that "
        . "opens "
        . ($a > 0 ? 'up.' : 'down.'),
    "A plot with two graphs.  The first, in dashed blue is a parabola that "
        . "opens "
        . ($a > 0 ? 'up.' : 'down.')
        . " The second in red is a horizontal line with y-intercept of $a2."
);

@shuffle = random_subset(4, 0 .. 3);
@inv[@shuffle] = 0 .. 3;

$dd = DropDown([ 'A' .. 'D' ], $inv[0]);

BEGIN_PGML
Let [`` f(x) = [$f] ``].

a) Find the first and second derivatives.
    - [`f'(x) = `] [_]{$df}{20}
    - [`f''(x) = `] [_]{$ddf}{20}
b) Identify the graph that displays [`f`] in dashed blue and [`f''`] in red. [_]{$dd}

   [#
        [.*A*.][. [![$altText[$shuffle[0]]]!]{$plot[$shuffle[0]]}{250} .]
        [.*B*.][. [![$altText[$shuffle[1]]]!]{$plot[$shuffle[1]]}{250} .]*
        [.*C*.][. [![$altText[$shuffle[2]]]!]{$plot[$shuffle[2]]}{250} .]
        [.*D*.][. [![$altText[$shuffle[3]]]!]{$plot[$shuffle[3]]}{250} .]*
    #]{padding => 0.25}

    
c) Using the graphs of [`f`] and [`f''`], indicate where [`f`] is
concave up and concave down.  Give your answer as a list of intervals separated by commas.  If there are no such intervals, enter "None". [@ helpLink("interval") @]*
    - [`f`] is concave up on [_]{$CU}{20}
    - [`f`] is concave down on [_]{$CD}{20}
END_PGML

$ineq = ($a > 0) ? ">"  : "<";
$ud   = ($a > 0) ? "up" : "down";

BEGIN_PGML_SOLUTION
[` f'(x) = [$df] `] and [`f''(x) = [$ddf]`].

Since [` f''(x) [$ineq] 0 `] for all [`x`], [`f`] is concave [$ud] on [` (-\infty, \infty) `].
END_PGML_SOLUTION
ENDDOCUMENT();
