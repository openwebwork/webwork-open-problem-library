#Problem APEX 4.1.8

## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Newton's method)
## KEYWORDS("Newton's method", 'rootfinding')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## MLT(Newton-f-value-graph)
## MLTleader(1)
## Level(2)
## MO(1)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('4.1')
## Problem1('8')

DOCUMENT();
loadMacros(qw(
    PGstandard.pl
    PGML.pl
    plots.pl
    PGcourse.pl
));

Context('Numeric')->flags->set(tolType => 'absolute', tolerance => 10**-9);

do {
$a1 = random(1, 8);
$b1 = random(3, 6);
# $b1 = 4;

$f  = Formula("x^3 + $b1 x^2 - x - $a1");
$df = $f->D('x');

# max and min useful for plotting

$ymax = $f->eval(x => (-2 * $b1 - sqrt(4 * $b1**2 + 12)) / 6);
$ymin = $f->eval(x => (-2 * $b1 + sqrt(4 * $b1**2 + 12)) / 6);
    } until $ymax >0 && $ymin < 0; 

### Root Finding ###
$a[0] = Real(-5);
$a[1] = Real($a[0] - $f->eval(x => $a[0]) / $df->eval(x => $a[0]));
while ($a[-2] != $a[-1] || $#a < 5) {
    push @a, Real($a[-1] - $f->eval(x => $a[-1]) / $df->eval(x => $a[-1]));
}

$b[0] = Real(-1);
$b[1] = Real($b[0] - $f->eval(x => $b[0]) / $df->eval(x => $b[0]));
while ($b[-2] != $b[-1] || $#b < 5) {
    push @b, Real($b[-1] - $f->eval(x => $b[-1]) / $df->eval(x => $b[-1]));
}

$c[0] = Real(1);
$c[1] = Real($c[0] - $f->eval(x => $c[0]) / $df->eval(x => $c[0]));
while ($c[-2] != $c[-1] || $#c < 5) {
    push @c, Real($c[-1] - $f->eval(x => $c[-1]) / $df->eval(x => $c[-1]));
}

Context()->flags->set(
    tolerance => 0.0001,
    tolType   => "absolute",
);

$ans = List("$a[-1], $b[-1], $c[-1]");

# find the tick levels for nicer plots. 
$ytick_delta = $ymin < -15 || $ymax > 15 ? 5 : $ymin < -10 || $ymax > 10 ? 2 : 1; 

$plot =
    Plot(ymin => floor($ymin) - 1, ymax => ceil($ymax) + 1, ytick_delta => $ytick_delta, yminor => $ytick_delta-1);
$plot->add_function($f, 'x', -10, 10, color => 'blue');

$altText =
    "A function that rises through an intercept near x=-5, hits "
    . "a maximum, then falls through an intercept near x=-1, hits a minimum near "
    . "x=0, then rises through an intercept near x=1.";

BEGIN_PGML
Use Newton's Method to approximate all roots of the given
function, accurate to 4 places after the decimal.  Use
the graph below to obtain good initial approximations.
[```
   f(x) = [$f]
```]

>> [![$altText]!]{$plot}{350} <<

Root(s): [_]{$ans}{30}

(Separate multiple answers by commas.)
END_PGML

###################################

BEGIN_PGML_SOLUTION
Set up the iterative formula for Newton's Method:
[```
  x_{n+1} = x_n - \dfrac{f(x_n)}{f'(x_n)}
  = x_n - \frac{x_n^3 + 5x_n^2 - x_n - [$a1]}{3x_n^2 + 10x_n - 1}
```]

There are three roots.  The smallest is near [`x = [$a[0]]`].
Using Newton's Method,
[```
  \begin{aligned}
    x_0 &= [$a[0]] \\
    x_1 &\approx [$a[1]] \\
    x_2 &\approx [$a[2]] \\
    x_3 &\approx [$a[3]] \\
    x_4 &\approx [$a[4]] \\
    & \vdots
  \end{aligned}
```]

The next root is near [`x = [$b[0]]`].
Using Newton's Method,
[```
  \begin{aligned}
    x_0 &= [$b[0]] \\
    x_1 &\approx [$b[1]] \\
    x_2 &\approx [$b[2]] \\
    x_3 &\approx [$b[3]] \\
    x_4 &\approx [$b[4]] \\
    & \vdots
  \end{aligned}
```]

The largest root is near [`x = [$c[0]]`].
Using Newton's Method,
[```
  \begin{aligned}
    x_0 &= [$c[0]] \\
    x_1 &\approx [$c[1]] \\
    x_2 &\approx [$c[2]] \\
    x_3 &\approx [$c[3]] \\
    x_4 &\approx [$c[4]] \\
    & \vdots
  \end{aligned}
```]
END_PGML_SOLUTION
ENDDOCUMENT();

