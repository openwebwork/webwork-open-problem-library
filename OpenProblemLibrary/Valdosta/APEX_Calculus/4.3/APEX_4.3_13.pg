#Problem APEX 4.3.13

## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Optimization - general)
## KEYWORDS('applied problem', 'minimum')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## MLT(Optimization_ChoosePath)
## Level(5)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('4.3')
## Problem1('13')
## RESOURCES('APEX_4dot3_13_fig1.jpg')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'plots.pl', 'PGcourse.pl');

$D  = random(1, 3, 1);
$L  = random(4, 8, 1);
$Ds = $D**2;

$u1 = random(40, 60, 5);
$u2 = $u1 + random(25, 45, 5);

$uq   = $u2 / $u1;
$uqs  = $uq**2;
$uqs1 = $uqs - 1;

$x1 = sqrt($Ds / $uqs1);

$ans1 = Compute($L - $x1);
$ans2 = Compute(sqrt($Ds + $x1**2));
$ans3 = Compute(1000 * ($u1 * $ans1 + $u2 * $ans2))
    ->with(tolerance => 0.5, tolType => 'absolute');

# convenience method for making distance labels.
sub dist_label {
    my ($plot, $start, $end, $label, $orient) = @_;
    $orient = $orient // 'hor';
    if ($orient eq 'hor') {
        $mid = 0.5*($start->[0]+$end->[0]);
        $plot->add_dataset(
            [ $start->[0], $start->[1] - 0.15 ],
            [ $start->[0], $start->[1] + 0.15 ],
            [ $start->[0], $start->[1]],
            [$mid - 0.05*($end->[0]-$start->[0]), $start->[1]],
            color => 'blue',
            width => 1
        );

        $plot->add_dataset(
            [ $end->[0], $end->[1] - 0.15 ],
            [ $end->[0], $end->[1] + 0.15 ],
            [ $end->[0], $end->[1]],
            [$mid + 0.05*($end->[0]-$start->[0]), $end->[1]],
            color => 'blue',
            width => 1
        );
        $plot->add_label($mid,$start->[1],$label);
    } else {
        $mid = 0.5*($start->[1]+$end->[1]);
        $plot->add_dataset(
            [$start->[0]-0.15, $start->[1]],
            [$start->[0]+0.15, $start->[1]],
            [$start->[0],$start->[1]],
            [$start->[0], $mid-0.1*abs($end->[1]-$start->[1])],
            color => 'blue',
            width => 1
        );
        $plot->add_dataset(
            [$end->[0]-0.15, $end->[1]],
            [$end->[0]+0.15, $end->[1]],
            [$end->[0],$end->[1]],
            [$end->[0], $mid+0.1*abs($end->[1]-$start->[1])],
            color => 'blue',
            width => 1
        );
        $plot->add_label($start->[0],$mid, $label);
    }
    return;
}

$plot = Plot(
    xmin            => -3.5,
    xmax            =>  3.5,
    ymin            => -2.5,
    ymax            =>  2.5,
    xvisible        =>  0,
    yvisible        =>  0,
    show_grid       =>  0,
    rounded_corners =>  1,
    aspect_ratio    => 1
);
$plot->add_dataset([ -3, 0 ], [ 3, 0 ], width => 3);
# draw the facility
$plot->add_dataset([ 0, 0 ], [ 2, 2 ], width => 1);
$plot->add_circle(
    [ 2, 2 ], 0.25,
    fill_color   => 'salmon',
    fill_opacity => 1,
    fill         => 'self'
);
$plot->add_label(
    [ 1,   1,    '\\(z\\)', h_align => 'right', v_align => 'bottom' ],
    [ 1.7, 1.95, 'facility',    h_align => 'right' ],
    [ 1.7, 2.2,  'offshore',    h_align => 'right' ]
);

# draw power plant
$plot->add_rectangle([ -2.6, -0.25 ], [ -2.35, 0 ], fill_color => 'lightgreen');
$plot->add_label(
    [ -2.65, -0.35, 'power', h_align => 'right' ],
    [ -2.65, -0.55, 'plant', h_align => 'right' ]
);

# draw distance labels
dist_label($plot, [ -2.35, -1 ], [ 2, -1 ], '\\(L\\)');
dist_label($plot, [0,-0.4],[2,-0.4],'\\(x\\)');
dist_label($plot, [2.5,0],[2.5,2], '\\(D\\)', 'vert');

$alttext = qq/Diagram of the power plant and the offshore facility.  Call point
A the point on shore closest to the offshore facility and point B the point where
the power line enters the water.  The distance from the facility to point A is
D units.  The distance between points A and B is x units.  The distance between
the power plant and point A is L units.
The hypotenuse of the triangle has distance z units/;

BEGIN_PGML
>> [! [$alttext] !]{$plot}{400} <<

A power line is to be run to an offshore facility as shown
in the figure above.  The offshore facility is
[`D = [$D]`] miles at sea and [`L = [$L]`] miles
along the shoreline from the power
plant.  It costs $[$u1],000 per mile to lay a power
line underground and $[$u2],000 per mile to
run the line underwater.

How much of the power line should be run underground, and
how much underwater to minimize the overall costs?

- Length underground (in miles): [_]{$ans1}{10}
- Length underwater (in miles): [_]{$ans2}{10}
- Minimal cost (in dollars): [_]{$ans3}{20}
END_PGML

$uq   = int($uq * 10**3) / 10**3;
$uqs  = int($uqs * 10**3) / 10**3;
$uqs1 = int($uqs1 * 10**3) / 10**3;
$x1   = int($x1 * 10**3) / 10**3;

$ans1 = int($ans1 * 10**3) / 10**3;
$ans2 = int($ans2 * 10**3) / 10**3;
$ans3 = int($ans3 * 10**2) / 10**2;

BEGIN_PGML_SOLUTION
Observe, the offshore facility is a vertex of a right
triangle with legs equal to [$D] and [`x`] and
hypotenuse [`z`].  Therefore, [`[$D]^2 + x^2 = z^2`], or
[```
  z = \sqrt{[$Ds] + x^2}
```]

The cost for laying the power line underground is:

[```
  \textrm{(Cost per mile)} \cdot  \textrm{(miles underground)}
      = [$u1],000([$L] - x).
```]

The cost for laying the power line underwater is:

[```
  \textrm{(Cost per mile)} \cdot  \textrm{(miles underwater)}
  = [$u2],000(z) = [$u2],000\sqrt{[$Ds] + x^2}.
```]

Thus, the total cost function (which is the
fundamental equation) is:

[```
  C = [$u1],000([$L] - x) + [$u2],000\sqrt{[$Ds] + x^2}.
```]

Find the critical number(s).

[```
  \begin{aligned}
    C' & = -[$u1],000 + \dfrac{[$u2],000 x}{\sqrt{[$Ds] + x^2}} \\
    && \\
    -[$u1],000 + \dfrac{[$u2],000 x}{\sqrt{[$Ds] + x^2}}  & = 0\\
    \dfrac{[$u2],000 x}{\sqrt{[$Ds] + x^2}}  & = [$u1],000 \\
    [$uq] x & = \sqrt{[$Ds] + x^2} \\
    [$uqs] x^2 & = [$Ds] + x^2 \\
    [$uqs1] x^2 & = [$Ds] \\
    x & = \sqrt{[$Ds]/[$uqs1]} = [$x1].
  \end{aligned}
```]

Note, we used the positive square root because we are measuring
positive distances.

Since [`x = [$x1]`], we find the length of line to be run
underground is:
[```
  L - x = L - [$x1] = [$ans1].
```]

The length [`z`] to be run underwater is:
[```
  z = \sqrt{ [$Ds] + x^2 } = \sqrt{[$Ds] + ([$x1])^2} = [$ans2].
```]

Finally, the minimal cost is:
[```
  C = [$u1],000([$ans1]) + [$u2],000([$ans2]) = [$ans3].
```]
END_PGML_SOLUTION
ENDDOCUMENT();
