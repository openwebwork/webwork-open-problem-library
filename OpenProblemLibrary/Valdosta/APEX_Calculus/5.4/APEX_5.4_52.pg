#Problem APEX 5.4.52

## DBsubject(Calculus - single variable)
## DBchapter(Applications of integration)
## DBsection(Areas between curves)
## Institution(Valdosta State University)
## KEYWORDS(definite integral, fundamental theorem of calculus)
## Author(S. V. Ault)
## Level(3)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('5.4')
## Problem1('52')

## Adapted from "Utah/Quantitative_Analysis/set10_Definite_Integrals_Techniques_of_Integration/pr_6.pg"

DOCUMENT();
loadMacros(
    'PGstandard.pl', 'PGML.pl', 'plots.pl',
    'PGcourse.pl'
);

Context("Numeric");    #->flags->set(reduceConstants => 0);
Context()->noreduce('(-x)-y', '(-x)+y');

# x-values for the intersection of f and g
$a = random(-4, -1);
$b = random( 2,  6);

# coefficients for f (2) and g (1)
$c1 = random(-3, 3);
$c2 = $c1 - $a * $b;
$b1 = random(-3, 3);
$b2 = $b1 + ($a + $b);

$f       = Formula("x^2 + $b2 x + $c2")->reduce;
$g       = Formula("2x^2 + $b1 x + $c1")->reduce;
$b_diff  = $b1 - $b2;
$c_diff  = $c1 - $c2;
$fg_diff = ($f - $g)->reduce;
$anti    = Compute("-1/3 x^3 - $b_diff/2 x^2 - $c_diff x")->reduce;

$ya = $f->eval(x => $a);
$yb = $f->eval(x => $b);

$fmin = $f->eval(x => (-$b2 / 2));
$gmin = $g->eval(x => (-$b1 / 4));

$F1     = $anti->eval(x => ($b));
$F2     = $anti->eval(x => ($a));
$answer = $F1 - $F2;

$plot = Plot(
    xmin            => $a - 3,
    xmax            => $b + 3,
    xshow_ticks     => 0,
    ymin            => min($fmin, $gmin) - 2,
    ymax            => max($ya, $yb) + 2,
    yshow_ticks     => 0,
    show_grid       => 0,
    rounded_corners => 1
);
$plot->add_function(
    [ $f, 'x', $a - 3, $b + 3, color => 'blue' ],
    [ $g, 'x', $a - 3, $b + 3, color => 'red' ]
);

BEGIN_PGML
Find the area of the region enclosed between 
 [` f(x) = [$f] `] and
 [` g(x) = [$g] `].

>>[!A graph of two parabolas opening upwards. The two parabolas intersect once in the lower left of the image, and once in the upper right. Between the intersection points, the blue parabola is positioned above the red parabola.!]{$plot}{300}<<

    Area = [_]{$answer}{20}

    *Note:* The graph above represents both functions [`f`] and [`g`] but is intentionally left unlabeled.

END_PGML

BEGIN_PGML_SOLUTION
The top (blue) parabola is [`f(x)`], which can be determine either from the 
[`y`]-intercept which is greater for [`f(x)`].  Therefore, the area between curves is found using the 
definite integral 
[``` 
    \int_{a}^b \left( f(x) - g(x) \right) \, dx.
```]
First determine the points of intersection by
solving
[```
  \begin{aligned}
  [$g] & = [$f] \\
  [$fg_diff] & = 0 \\
  (x-[$a])(x-[$b]) & = 0
  \end{aligned}
```]
These points correspond to [`x = [$a]`] and [`x=[$b]`].
Then 
[```
  \begin{aligned}
    \textrm{Area} 
    & = \int_{[$a]}^{[$b]} \left( ([$f]) - ([$g]) \right) \, dx\\
    & = \int_{[$a]}^{[$b]} \left( [$fg_diff] \right) \, dx  \\
    & = \left( [$anti] \right)\bigg|_{[$a]}^{[$b]}\\
    & = [$F1] - \left( [$F2] \right) \\
    & = [$answer].
  \end{aligned}
```]
END_PGML_SOLUTION
ENDDOCUMENT();

