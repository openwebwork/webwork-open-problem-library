#Problem APEX 5.4.50
## DBsubject(Calculus - single variable)
## DBchapter(Applications of integration)
## DBsection(Areas between curves)
## Institution(Valdosta State University)
## Author(S. V. Ault)
## Level(2)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('5.4')
## Problem1('50')
## TitleText2('Mathematical Applications')
## AuthorText2('Ronal J. Harshbarger and James J. Reynolds')
## EditionText2('8')
## KEYWORDS('Graph', 'Integration', 'Area' )

## Adapted from "Utah/Quantitative_Analysis/set10_Definite_Integrals_Techniques_of_Integration/pr_6.pg"
DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'plots.pl', 'PGcourse.pl');

Context("Numeric");
#Here are the parameters that will be varied.
#Must ensure the curves don't intersect between $c and $b
do {
    $a = random( 2,  10);
    $b = random( 2,   8);
    $c = random(-8,  -2);
    $d = random(0.1, 0.9, 0.1);
} until (($d * $b**2 - $b + $a >= 0)
        && ((1 < 2 * $d * $c) || (1 > 2 * $d * $b) || (4 * $a * $d > 1)));

$f    = Compute("$d x^2 + $a");
$plot = Plot(
    xmin            => $c - 3,
    xmax            => $b + 2,
    xtick_delta     => 5,
    xminor          => 4,
    ymin            => $c - 8,
    ymax            => $f->eval(x => 8.2),
    ytick_delta     => 5,
    yminor          => 4,
    rounded_corners => 1
);
$plot->add_function(
    [ $f,  'x', $c - 3, $b + 2, color => 'blue' ],
    [ 'x', 'x', $c - 3, $b + 2, color => 'red' ]
);
$plot->add_dataset(
    [ [ $c, $c ], [ $c, $f->eval(x => $c) ] ],
    [ [ $b, $b ], [ $b, $f->eval(x => $b) ] ]
);
$plot->add_label(
    [
        $c + 1, $f->eval(x => $c + 1), '\\(f(x)\\)',
        v_align => 'bottom',
        h_align => 'left',
        color   => 'blue'
    ],
    [ $c - 1, $c - 1, '\\(g(x)\\)', v_align => 'top', color => 'red' ]
);

$answer =
    Compute("($d /3)*($b**3 -$c**3) + .5*(($c)^2 - ($b)^2) + $a*($b -$c)");
$answer1 = Compute("($d /3)*($b)^3 - (1/2)*($b)^2 + $a*$b");
$answer2 = Compute("($d /3)*($c)^3 - (1/2)*($c)^2 + $a*$c");

BEGIN_PGML

Find the area  of the region enclosed between 
[`f(x) = [$d] x^2 + [$a]`], [`g(x) = x`], [`x= [$c]`], and [`x= [$b]`].

>>[!A graph of the two functions described above. f is shown as a blue parabola, positioned above g, which is shown as a red line. Vertical black lines connect f and g at the x-values [$c] and [$b]. !]{$plot}{300}<<

Area = [_]{$answer}{20}
END_PGML

BEGIN_PGML_SOLUTION
The area between curves is found using the definite integral 
[``` 
    \int_{a}^b \left( f(x) - g(x) \right) \, dx.
 ```]
In this case,
[```
  \begin{aligned}
    \int_{[$c]}^{[$b]} \left( ([$d] x^2 + [$a]) - (x) \right) \, dx
    & = \left( \frac{[$d] x^3}{3} + [$a] x - \frac{x^2}{2} \right)
        \Bigg|_{[$c]}^{[$b]}  \\
    & = \left( [$answer1] \right) - \left( [$answer2] \right) \\
    & = [$answer].
  \end{aligned}
```]
END_PGML_SOLUTION
ENDDOCUMENT();
