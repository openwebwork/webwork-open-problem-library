#Problem APEX 2.3.21

## DBsubject(Calculus - single variable)
## DBchapter(Differentiation)
## DBsection(Derivatives involving multiple rules (no product, quotient, or chain rule))
## KEYWORDS('derivative','rules')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## Level(3)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('2.3')
## Problem1('21')
# Updated July, 2023

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'PGchoicemacros.pl', 'PGcourse.pl');

Context()->variables->are('t' => "Real");

$a = random(2, 30);
$b = random(3, 8);
$c = random(2, 6);

$ans = Formula("0");

BEGIN_PGML
Compute the derivative of the given function.

If [`` f(t) = \ln ([$a]) + e^[$b] + \sin (\pi/[$c]) ``]

then [` f'(t) = `][_]{$ans}{15}
END_PGML

BEGIN_PGML_SOLUTION
Each term is a constant, so the derivative is 0.
END_PGML_SOLUTION

ENDDOCUMENT();    
