## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Linear approximation and differentials)
## KEYWORDS('differential')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## MLT(Find_differential)
## Level(2)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('4.4')
## Problem1('26')
#Problem APEX 4.4.26

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context("Numeric")->variables->add(dx => 'Real');

$a    = random(2, 8) * random(-1, 1, 2);
$func = Formula("$a cos(sin(x))")->reduce;
$df   = $func->D('x');
$ans  = "($df)dx";

BEGIN_PGML
Compute the differential [`dy`] for
[`` y = [$func] ``].

    [` dy = `] [_]{$ans}{20}
END_PGML

BEGIN_PGML_SOLUTION
The differential is
[```
  \begin{aligned}
    dy & = f'(x) \; dx\\
       & = -[$a] \sin(\sin x) \cdot \cos x \; dx.
  \end{aligned}
```]
END_PGML_SOLUTION
ENDDOCUMENT();

