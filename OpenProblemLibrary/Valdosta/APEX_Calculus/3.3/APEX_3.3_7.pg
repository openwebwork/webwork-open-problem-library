#Problem APEX 3.3.7

## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Increasing/decreasing functions and local extrema)
## KEYWORDS('first derivative', 'second derivative', 'graph')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## MLT(graphs_incr_decr)
## Level(3)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('3.3')
## Problem1('7')

DOCUMENT();
loadMacros(
    'PGstandard.pl',      'PGML.pl',
    'plots.pl',           'parserPopUp.pl',
    'contextFraction.pl', 'PGcourse.pl'
);

Context("Fraction");

$a = random(1.5, 3, 0.5) * random(-1, 1, 2);
$b = random(2,   5) * random(-1, 1, 2);
$c = random(1,   5) * random(-1, 1, 2);

$f  = Compute("$a x^2 + $b x + $c");
$df = $f->D('x');

$crit = Fraction(-$b, 2 * $a);

Context("Interval");

if ($a > 0) {
    $answers1 = Compute("($crit, INF)");
    $answers2 = Compute("(-INF, $crit)");
    $solutionText =
        q![`f'(x) > 0`] when [`x > [$crit]`] and [`f'(x) < 0`] when [`x < [$crit]`]. Therefore the function is increasing on [`([$crit], \infty)`] and
decreasing on [`(-\infty, [$crit])`].!
} else {
    $answers1 = Compute("(-INF, $crit)");
    $answers2 = Compute("($crit, INF)");
    $solutionText =
        q![`f'(x) > 0`] when [`x < [$crit]`] and [`f'(x) < 0`] when [`x > [$crit]`]. Therefore the function is increasing on [`(-\infty, [$crit])`] and
decreasing on [`([$crit], \infty)`].!
}

$plot[$_] = Plot(rounded_corners => 1) for (0 .. 3);
$plot[0]->add_function("$f",    'x', -5.5, 5.5, color => 'blue');
$plot[0]->add_function("$df-3", 'x', -5.5, 5.5, color => 'red');

$plot[1]->add_function("$f",  'x', -5.5, 5.5, color => 'blue');
$plot[1]->add_function("$df", 'x', -5.5, 5.5, color => 'red');

$plot[2]->add_function("$df", 'x', -5.5, 5.5, color => 'blue');
$plot[2]->add_function("$f",  'x', -5.5, 5.5, color => 'red');

$plot[3]->add_function("$f",   'x', -5.5, 5.5, color => 'blue');
$plot[3]->add_function("-$df", 'x', -5.5, 5.5, color => 'red');

@order = random_subset(4, 0 .. 3);
@inv[@order] = 0 .. 3;

$dd = DropDown([ "A", "B", "C", "D" ], $inv[1]);

($x1, $y1) = (2, $f->eval(x => 2));

# point through the line
($x2, $y2) = (1, $df->eval(x => 1));
# point through incorrect line
($x3, $y3) = (0, $df->eval(x => 0) - 3);
($x4, $y4) = (1, $df->eval(x => 1) - 3);
($x5, $y5) = (1, -1 * $df->eval(x => 1));
$neg_b = -$b;
$dir   = $a > 0 ? 'up' : 'down';

@altText = (
    "The blue curve is a parabola that opens $dir and passes through the points (0,$c) and (1,$y1). The red curve is a line that passes through ($x3,$y3) and ($x4,$y4). ",
    "The blue curve is a parabola that opens $dir and passes through the points (0,$c) and (1,$y1).  The red curve is a line that passes through (0, $b) and ($x2,$y2).",
    "The blue curve is a line that passes through (0, $b) and ($x2,$y2). The red curve is a parabola that opens $dir and passes through the points (0,$c) and (1,$y1). ",
    "The blue curve is a parabola that opens $dir and passes through the points (0,$c) and (1,$y1). The red curve is a line that passes through (0, $neg_b) and ($x5,$y5). ",
);

BEGIN_PGML

Let [``f(x) = [$f]``].

a) Find the derivative:

    [`f'(x) = `] [_]{$df}{20}

b) Identify the graph that displays [`f`] in blue and [`f'`] in red: [_]{$dd}

    [# [. *A* .][.[![$altText[$order[0]]]!]{$plot[$order[0]]}{200} .]
    [. *B* .][.[![$altText[$order[1]]]!]{$plot[$order[1]]}{200} .]*
    [. *C* .][.[![$altText[$order[2]]]!]{$plot[$order[2]]}{200} .]
    [. *D* .][.[![$altText[$order[3]]]!]{$plot[$order[3]]}{200} .]*
    #]{padding => 0.25}

    c) Using the graphs of [`f`] and [`f'`], indicate where [`f`] is
increasing and decreasing. Give your answer in the interval form.  [@ helpLink('interval') @]*

        [`f`] is increasing on [_]{$answers1}{20}

        [`f`] is decreasing on [_]{$answers2}{20}
END_PGML

BEGIN_PGML_SOLUTION
    a) [` f'(x) = [$df] `].

    b) The correct graph is: [$dd]

    c) Solve [` f'(x) = 0`] to locate critical numbers.
    [```
      [$df] = 0 \;\Rightarrow\; x = [$crit].
    ```]
    [$solutionText]**

END_PGML_SOLUTION

ENDDOCUMENT();

