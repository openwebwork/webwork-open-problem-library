#Problem APEX 3.3.6

## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Increasing/decreasing functions and local extrema)
## KEYWORDS('increasing', 'decreasing', 'functions')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## MLT(graphs_incr_decr)
## Level(3)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('3.3')
## Problem1('6')

DOCUMENT();
loadMacros(
    'PGstandard.pl',  'PGML.pl',
    'plots.pl',
    'parserPopUp.pl', 'PGcourse.pl'
);

$m = random(2, 5) * random(-1, 1, 2);
$b = random(1, 5) * random(-1, 1, 2);

$f  = Compute("$m x + $b");
$df = $f->D('x');

Context("Interval");

if ($df > 0) {
    $answers1 = Interval("(-Inf, Inf)");
    $answers2 = Interval("{}");
    $solution =
        "Since [`f'(x) > 0`] on [`(-\infty, \infty)`], the function is increasing at all [`x`] values.";
} else {
    $answers1 = Interval("{}");
    $answers2 = Interval("(-Inf, Inf)");
    $solution =
        "Since [`f'(x) < 0`] on [`(-\infty, \infty)`], the function is decreasing at all [`x`] values.";
}

$plot[$_] = Plot(rounded_corners => 1) for (0 .. 3);
$plot[0]->add_function("$m",      'x', -5.5, 5.5, color => 'blue');
$plot[0]->add_function("$m*x+$b", 'x', -5.5, 5.5, color => 'red');

$plot[1]->add_function("$m*x+$b", 'x', -5.5, 5.5, color => 'blue');
$plot[1]->add_function("$m",      'x', -5.5, 5.5, color => 'red');

$plot[2]->add_function("$m*x+$b", 'x', -5.5, 5.5, color => 'blue');
$plot[2]->add_function("-$m",     'x', -5.5, 5.5, color => 'red');

$plot[3]->add_function("$m*x+$b",  'x', -5.5, 5.5, color => 'blue');
$plot[3]->add_function("-$m*x-$b", 'x', -5.5, 5.5, color => 'red');

@order = random_subset(4, 0 .. 3);
@inv[@order] = 0 .. 3;

$dd = DropDown([ "A", "B", "C", "D" ], $inv[1]);

($x1, $y1) = (1, $f->eval(x => 1));
($x2, $y2) = (1, -$y1);
$neg_m = -$m;

@altText = (
    "The blue curve is a horizontal line through (0,$m).  The red curve is a horizontal line through (0,$m).",
    "The blue curve is a line between (0,$b) and (1,$y1). The red curve is a horizontal line through (0,$m). ",
    "The blue curve is a line between (0,$b) and (1,$y1). The red curve is a horizontal line through (0,$neg_m).",
    "The blue curve is a line between (0,$b) and (1,$y1). The red curve is a line between (0,$b) and (1,$y2)."
);

BEGIN_PGML
Let [``f(x) = [$f]``].

a) Find the derivative:

    [`f'(x) = `] [_]{$df}{20}

b) Identify the graph that displays [`f`] in blue and [`f'`] in red: [_]{$dd}

    [# [. *A* .][.[![$altText[$order[0]]]!]{$plot[$order[0]]}{200} .]
    [. *B* .][.[![$altText[$order[1]]]!]{$plot[$order[1]]}{200} .]*
    [. *C* .][.[![$altText[$order[2]]]!]{$plot[$order[2]]}{200} .]
    [. *D* .][.[![$altText[$order[3]]]!]{$plot[$order[3]]}{200} .]*
    #]{padding => 0.25}


c) Using the graphs of [`f`] and [`f'`], indicate where [`f`] is increasing and decreasing. Give your answer in interval form. [@ helpLink('interval') @]*

        [`f`] is increasing on [_]{$answers1}{20}
        
        [`f`] is decreasing on [_]{$answers2}{20}
END_PGML

BEGIN_PGML_SOLUTION
    a) [` f'(x) = [$df] `].  

    b) The correct graph is: [$dd]
    
    c) [$solution]**
END_PGML_SOLUTION

ENDDOCUMENT();

