#Problem APEX 3.3.10

## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Increasing/decreasing functions and local extrema)
## KEYWORDS('graphs', 'derivative')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## MLT(graphs_incr_decr)
## Level(3)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('3.3')
## Problem1('10')

DOCUMENT();
loadMacros(
    'PGstandard.pl',  'PGML.pl',
    'plots.pl',
    'parserPopUp.pl', 'PGcourse.pl'
);

do {
    $c1 = random(-4, -1, 3);
    $c2 = random( 1,  4, 3);
} while $c1 + $c2 == 0;

$d = random(1, 3) * random(-1, 1, 2);

$b2 = 3 * (-$c1 - $c2) / 2;
$b1 = 3 * ($c1 * $c2);

$y1 = ($c1)**3 + $b2 * ($c1)**2 + $b1 * ($c1) + $d;
$y2 = ($c2)**3 + $b2 * ($c2)**2 + $b1 * ($c2) + $d;

$ymax   = max(abs($y1), abs($y2)) + 5;
$ymin   = -$ymax;
$yrange = $ymax - $ymin;

$f  = Compute("x^3 + $b2 x^2 + $b1 x + $d")->reduce;
$df = $f->D('x');

Context("Interval");

$answers1      = Interval("(-INF, $c1) U ($c2, INF)");
$answers2      = Interval("($c1, $c2)");
$solutionText1 = "[`(-\infty, $c1) \cup ($c2, \infty)`]";
$solutionText2 = "[`($c1, $c2)`]";

$plot[$_] = Plot(
    ymin            => $ymin,
    ymax            => $ymax,
    ytick_delta     => 25,
    yminor          => 4,
    rounded_corners => 1
) for (0 .. 3);
$plot[0]->add_function("$f",  'x', -5.5, 5.5, color => 'blue');
$plot[0]->add_function("$df", 'x', -5.5, 5.5, color => 'red');

$plot[1]->add_function("$f",   'x', -5.5, 5.5, color => 'blue');
$plot[1]->add_function("-$df", 'x', -5.5, 5.5, color => 'red');

$plot[2]->add_function("-$f", 'x', -5.5, 5.5, color => 'blue');
$plot[2]->add_function("$df", 'x', -5.5, 5.5, color => 'red');

$plot[3]->add_function("-$f",  'x', -5.5, 5.5, color => 'blue');
$plot[3]->add_function("-$df", 'x', -5.5, 5.5, color => 'red');

@order = random_subset(4, 0 .. 3);
@inv[@order] = 0 .. 3;

$dd = DropDown([ "A", "B", "C", "D" ], $inv[0]);

# critical points on f are $c1, $c2. $y1, $y2 are the function values
$y1     = $f->eval(x => $c1);
$y2     = $f->eval(x => $c2);
$y1_neg = -$y1;
$y2_neg = -$y2;

# critical points of df is $b2/3
$x3     = -$b2 / 3;
$y3     = $f->eval(x => $x3);
$y3_neg = -$y3;

$max = $b2 < 0 ? 'maximum' : 'minimum';
$min = $b2 < 0 ? 'minimum' : 'maximum';

@altText = (
    "The blue curve rises to a maximum at ($c1, $y1), falls to a minimum at ($c2, $y2) and then rises to the right.  The red curve is parabolic that opens up and has a local minimum at ($x3, $y3).",
    "The blue curve rises to a maximum at ($c1, $y1), falls to a minimum at ($c2, $y2) and then rises to the right. The red curve is parabolic that opens down and has a local maximum at ($x3, $y3_neg).",
    "The blue curve falls to a minimum at ($c1, $y1_neg), rises to a maximum at ($c2, $y2_neg) and then falls to the right.  The red curve is parabolic that opens up and has a local minimum at ($x3, $y3).",
    "The blue curve falls to a minimum at ($c1, $y1_neg), rises to a maximum at ($c2, $y2_neg) and then falls to the right.  The red curve is parabolic that opens down and has a local maximum at ($x3, $y3_neg).",
);

BEGIN_PGML

Let [``f(x) = [$f]``].

a) Find [`f'(x) = `] [_]{$df}{20}

b) Identify the graph that displays [`f`] in blue and [`f'`] in red: [_]{$dd}

   [# [. *A* .][.[![$altText[$order[0]]]!]{$plot[$order[0]]}{200} .]
    [. *B* .][.[![$altText[$order[1]]]!]{$plot[$order[1]]}{200} .]*
    [. *C* .][.[![$altText[$order[2]]]!]{$plot[$order[2]]}{200} .]
    [. *D* .][.[![$altText[$order[3]]]!]{$plot[$order[3]]}{200} .]*
    #]{padding => 0.25}


c) Using the graphs of [`f`] and [`f'`], indicate where [`f`] is
increasing and decreasing. Give your answer in interval form. [@ helpLink('interval') @]*

        [`f`] is increasing on [_]{$answers1}{20}

        [`f`] is decreasing on [_]{$answers2}{20}
END_PGML

BEGIN_PGML_SOLUTION
a) [` f'(x) = [$df] `].  

b) The correct graph is: [$dd]

c) Solve the equation, [``[$df] = 0``], to find two critical numbers, [`x = [$c1], [$c2]`].

    [`f`] increases when [`f'(x) > 0`], which is in the interval
[$solutionText1]**.

    [`f`] decreases when [`f'(x) < 0`], which is in the interval
[$solutionText2]**.
END_PGML_SOLUTION

ENDDOCUMENT();

