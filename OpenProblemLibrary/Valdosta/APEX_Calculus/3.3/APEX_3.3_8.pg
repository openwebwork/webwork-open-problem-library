#Problem APEX 3.3.8

## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Increasing/decreasing functions and local extrema)
## KEYWORDS('graphs', 'derivative')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## MLT(graphs_incr_decr)
## Level(3)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('3.3')
## Problem1('8')

DOCUMENT();
loadMacros(
    'PGstandard.pl',  'PGML.pl',
    'plots.pl',
    'parserPopUp.pl', 'PGcourse.pl'
);

$a = random(2, 5) * random(-1, 1, 2);
$b = random(2, 12) * random(-1, 1, 2);
$c = random(1, 25) * random(-1, 1, 2);

$f  = Compute("$a cos(x)");
$df = $f->D('x');
Context("Interval");

if ($a > 0) {
    $answers1      = Compute("(-pi, 0) U (pi, 2*pi)");
    $answers2      = Compute("(-2*pi, -pi) U (0, pi)");
    $solutionText1 = "[`(-\pi, 0) \cup (\pi, 2\pi)`]";
    $solutionText2 = "[`(-2\pi, -\pi) \cup (0, \pi)`]";
} else {
    $answers1      = Compute("(-2*pi, -pi) U (0, pi)");
    $answers2      = Compute("(-pi, 0) U (pi, 2*pi)");
    $solutionText1 = "[`(-2\pi, -\pi) \cup (0, \pi)`]";
    $solutionText2 = "[`(-\pi, 0) \cup (\pi, 2\pi)`]";
}

# scaled versions of the function to make the plot cleaner.
$g  = Compute("$a cos(pi x/2)");
$dg = 2 / pi * $g->D('x');

$plot[$_] = Plot(
    xmin         => -4.5,
    xmax         =>  4.5,
    xtick_delta  =>  1,
    xminor       =>  1,
    xtick_labels => {
        1  => '\(\frac{\pi}{2}\)',
        2  => '\(\pi\)',
        3  => '\( \frac{3\pi}{2}\)',
        4  => '\(2\pi\)',
        -1 => '\(-\frac{\pi}{2}\)',
        -2 => '\(-\pi\)',
        -3 => '\(- \frac{3\pi}{2}\)',
        -4 => '\(-2\pi\)'
    },
    ymin            => -(abs($a) + 1),
    ymax            => abs($a) + 1,
    ytick_delta     => 2,
    yminor          => 1,
    rounded_corners => 1
) for (0 .. 3);
$plot[0]->add_function("$g",  'x', -4.2, 4.2, color => 'blue');
$plot[0]->add_function("$dg", 'x', -4.2, 4.2, color => 'red');

$plot[1]->add_function("$g",   'x', -4.2, 4.2, color => 'blue');
$plot[1]->add_function("-$dg", 'x', -4.2, 4.2, color => 'red');

$plot[2]->add_function("$dg", 'x', -4.2, 4.2, color => 'blue');
$plot[2]->add_function("$g",  'x', -4.2, 4.2, color => 'red');

$plot[3]->add_function("-$g", 'x', -4.2, 4.2, color => 'blue');
$plot[3]->add_function("$dg", 'x', -4.2, 4.2, color => 'red');

@order = random_subset(4, 0 .. 3);
@inv[@order] = 0 .. 3;

$dd = DropDown([ "A", "B", "C", "D" ], $inv[0]);

my $rises = $a > 0 ? 'rises'   : 'falls';
my $falls = $a > 0 ? 'falls'   : 'rises';
my $max   = $a > 0 ? 'maximum' : 'minimum';
my $min   = $a > 0 ? 'minimum' : 'maximum';
my $neg_a = -$a;

@altText = (
    "The blue curve passes through (0,$a) $falls to a $min of (pi,$neg_a) and has a period of 2pi. The red curve passes through (0,0) $falls to a $min of (pi/2,$neg_a) and has a period of 2pi.",
    "The blue curve passes through (0,$a) $falls to a $min of (pi,$neg_a) and has a period of 2pi. The red curve passes through (0,0) $rises to a $max of (pi/2,$a) and has a period of 2pi.",
    "The blue curve starts at (0,0) $falls to a $min of (pi/,$a) and has a period of 2pi. The red passes through (0,$a) $falls to a $min of (pi,$neg_a) and has a period of 2pi.",
    "The red curve passes through (0,0), $falls to (pi/2,$neg_a) and has a period of 2pi.  The blue curve passes through (0,$neg_a), $rises to (pi,$a) and has a period of 2pi"
);

BEGIN_PGML
Let [``f(x) = [$f], \quad \textrm{on} \; (-2\pi, 2\pi)``].

    a) Find [`f'(x) = `] [_]{$df}{20}

    b) Identify the graph that displays [`f`] in blue and [`f'`] in red: [_]{$dd}

       [# [. *A* .][.[![$altText[$order[0]]]!]{$plot[$order[0]]}{200} .]
        [. *B* .][.[![$altText[$order[1]]]!]{$plot[$order[1]]}{200} .]*
        [. *C* .][.[![$altText[$order[2]]]!]{$plot[$order[2]]}{200} .]
        [. *D* .][.[![$altText[$order[3]]]!]{$plot[$order[3]]}{200} .]*
        #]{padding => 0.25}

    c) Using the graphs of [`f`] and [`f'`], indicate where [`f`] is
increasing and decreasing. Give your answer in interval form. [@ helpLink('interval') @]*

        [`f`] is increasing on [_]{$answers1}{20}

        [`f`] is decreasing on [_]{$answers2}{20}

END_PGML


BEGIN_PGML_SOLUTION
a) [` f'(x) =[$df] `].  

b) The correct graph is: [$dd]

c) There are three critical numbers within the interval, [`x = -\pi, 0, \pi`].

    [`f`] increases when [`f'(x) > 0`], which is in the interval
[$solutionText1]**.

    [`f`] decreases when [`f'(x) < 0`], which is in the interval
[$solutionText2]**.
END_PGML_SOLUTION

ENDDOCUMENT();

