#Problem APEX 3.3.13

## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Increasing/decreasing functions and local extrema)
## KEYWORDS('first derivative', 'graph')
## Institution(Valdosta State University)
## Author(S. V. Ault)
## MLT(graphs_incr_decr)
## Level(3)
## TitleText1('APEX Calculus')
## AuthorText1('Hartman')
## EditionText1('3.0')
## Section1('3.3')
## Problem1('13')

DOCUMENT();
loadMacros(
    'PGstandard.pl',    'PGML.pl', 'plots.pl', 'parserPopUp.pl',
    'PGcourse.pl'
);

Context("Numeric");

$a = random(2, 4, 1) * random(-1, 1, 2);
$b = random(1, 4, 1);

$f    = Compute("$a/(x^2+$b)")->reduce;
$f_gr = "$a/(x^2 + $b)";

$a2    = 2 * $a;
$df    = Formula("(-$a2 x)/(x^2 + $b)^2");
$df_gr = "(-$a2 x)/(x^2 + $b)^2";

Context("Interval");

if ($a > 0) {
    $answers1      = Interval("(-INF, 0)");
    $answers2      = Interval("(0, INF)");
    $solutionText1 = "[`(-\infty, 0)`]";
    $solutionText2 = "[`(0, \infty)`]";
} else {
    $answers1      = Interval("(0, INF)");
    $answers2      = Interval("(-INF, 0)");
    $solutionText1 = "[`(0, \infty)`]";
    $solutionText2 = "[`(-\infty, 0)`]";
}

@fopts = ($f, $df, -$f, $f);
@dfopts = ($df, $f, $df, -$df);

for my $k (0..3) {
    $plot[$k] = Plot(xmin => -3, xmax => 3, xtick_delta => 1, xminor => 0,
                    ymin => -4, ymax => 4, ytick_delta => 1, yminor => 0, 
                     rounded_corners => 1);
    $plot[$k]->add_function([$fopts[$k], 'x', -10, 10, color => 'blue', linestyle =>'dashed'],[$dfopts[$k], 'x', -10, 10, color => 'red']);
}

$prop1  = $a > 0 ? 'increases' : 'decreases';
$prop2 = $a > 0 ? 'decreases' : 'increases';
$extr1 = $a > 0 ? 'max' : 'min';
$extr2 = $a > 0 ? 'min' : 'max'; 

@altText = (
    "A plot of two curves.  The first curve (in dashed blue) is symmetric with "
    . "respect to the y-axis, $prop1 to the y-intercept of $a/$b and then "
    . "$prop2 to the x-axis."
    . "The second curve (in red) $prop1 to a local $extr1 about x=-1, $prop2 "
    . "to a local $prop2 about x=1, then $prop1 to the x-axis.",
    "A plot of two curves.  The first curve (in dashed blue) is symmetric with "
    . "respect to the origin, $prop1 to a local $extr1 about x=-1, $prop2 "
    . "to a local $extr2 about x=1, then $prop1 to the x-axis. "
    . "The second curve (in red) is symmetric with respect to the y-axis,"
    . "$prop1 to the y-intercept of $a/$b, then $prop2 back toward the x-axis",
     "A plot of two curves.  The first curve (in red) is symmetric with "
    . "respect to the origin, $prop1 to a local $extr1 about x=-1, $prop2 "
    . "to a local $extr2 about x=1, then $prop1 to the x-axis. "
    . "The second curve (in dashed blue) is symmetric with respect to the y-axis,"
    . "$prop2 to the y-intercept of $a/$b, then $prop1 back toward the x-axis",
    "A plot of two curves.  The first curve (in red) is symmetric with "
    . "respect to the origin, $prop1 to a local $extr1 about x=-1, $prop2 "
    . "to a local $extr2 about x=1, then $prop1 to the x-axis. "
    . "The second curve (in dashed blue) is symmetric with respect to the y-axis,"
    . "$prop1 to the y-intercept of $a/$b, then $prop2 back toward the x-axis",
);

@shuffle = random_subset(4,0..3);
@inv[@shuffle] = 0..3; 

$dd = DropDown(['A'..'D'],$inv[0]);

BEGIN_PGML
Let [``f(x) = [$f]``].

a) Find [`f'(x) = `] [_]{$df}{20}

b) Identify the graph that displays [`f`] in dashed blue and [`f'`] in red: [_]{$dd}

[#
    [.*A*.][. [![$altText[$shuffle[0]]]!]{$plot[$shuffle[0]]}{250} .]
    [.*B*.][. [![$altText[$shuffle[1]]]!]{$plot[$shuffle[1]]}{250} .]*
    [.*C*.][. [![$altText[$shuffle[2]]]!]{$plot[$shuffle[2]]}{250} .]
    [.*D*.][. [![$altText[$shuffle[3]]]!]{$plot[$shuffle[3]]}{250} .]*
#]{padding => 0.25}

c) Using the graphs of [`f`] and [`f'`], indicate where [`f`] is
increasing and decreasing. Give your answer in interval form. 

    [`f`] is increasing on [_]{$answers1}{20}

    [`f`] is decreasing on [_]{$answers2}{20}

[@ helpLink('interval') @]*
END_PGML

BEGIN_PGML_SOLUTION
    a) [`` f'(x) = [$df] ``].
    
    b) The correct graph is: [$dd]
    
    c)  Solve the equation, [``[$df] = 0 ``], to find the critical number: [`x = 0`].

        [`f`] increases when [`f'(x) > 0`], which is in the interval
[$solutionText1]**.

        [`f`] decreases when [`f'(x) < 0`], which is in the interval
[$solutionText2]**.
END_PGML_SOLUTION

ENDDOCUMENT();
