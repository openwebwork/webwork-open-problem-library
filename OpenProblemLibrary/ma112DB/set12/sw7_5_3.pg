#DESCRIPTION
##  Algebra problem:  Inverses of Matrices and Matrix Equations
##ENDDESCRIPTION

## hcao tagged and PAID on 12-12-2003

## DBsubject(Linear algebra)
## DBchapter(Matrices)
## DBsection(Inverses)
## Date(6/3/2002)
## MLT(2x2YesNoCoeffs)
## MLTleader(1)
## Level(3)
## TitleText1('College Algebra')
## AuthorText1('Stewart, Redlin, Watson')
## EditionText1('3')
## Section1('7.5')
## Problem1('3')
## KEYWORDS('algebra', 'inverse', 'matrix')
DOCUMENT();    # This should be the first executable line in the problem.

loadMacros(
    'PGstandard.pl',             'PGML.pl',
    'parserRadioMultiAnswer.pl', 'PGcourse.pl'
);

COMMENT('The determinant of the matrix is always 1.');

$a11 = 2;
$a12 = random(1, 9, 2);
$a21 = random(1, 9, 2);
$a22 = (1 + $a12 * $a21) / $a11;

Context('Matrix');

$A = Matrix([ [ $a11, $a12 ], [ $a21, $a22 ] ]);

$ans = $A->inverse;

$rma = RadioMultiAnswer(
    [
        [ 'The matrix is invertible and the inverse is %s*.', $ans ],
        ['The matrix is not invertible.']
    ],
    0
);

BEGIN_PGML
Determine if the matrix [` [$A] `] is invertible.  If it is, then find the inverse.
[_]{$rma}
END_PGML
Context()->normalStrings;

COMMENT('The matrix always has determinant -1.');

ENDDOCUMENT();        # This should be the last executable line in the problem.
