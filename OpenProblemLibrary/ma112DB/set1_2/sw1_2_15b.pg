#DESCRIPTION
##  Algebra problem: simplifying fraction
##ENDDESCRIPTION

## hcao tagged and PAID on 12-12-2003

## DBsubject(Arithmetic)
## DBchapter(Fractions/rational numbers)
## DBsection(Multiple operations)
## MLT(DivFollowedBySubtract)
## MLTleader(1)
## Date(6/3/2002)
## Level(2)
## TitleText1('College Algebra')
## AuthorText1('Stewart, Redlin, Watson')
## EditionText1('3')
## Section1('1.2')
## Problem1('15')
## KEYWORDS('algebra', 'fraction')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'PGcourse.pl');

Context('Fraction');

$n1 = random(2, 10);
$n2 = random(1, 10);
do { $d2 = random(2, 10) } until ($d2 != $n2);

$ans = Compute("$n1/($n2/$d2) - ($n2/$d2)")->reduce;

# Create another answer that will require only a reduced fraction answer.
Context('LimitedFraction')->flags->set(showProperFractions => 0);
$ans2 = Compute($ans);

BEGIN_PGML
Combine the fractions, reduce your answer and write as an improper fraction. 

[`` \left([$n1]\div\frac{[$n2]}{[$d2]}\right)-\frac{[$n2]}{[$d2]} = ``] [_]{$ans2}

END_PGML

$lcm = lcm($d2, $n2);
$a   = $lcm / $d2;
$b   = $lcm / $n2;

BEGIN_PGML_SOLUTION
Recall that dividing by a fraction means multiplying by the reciprocal.

[``` 
\begin{aligned}
\left([$n1]\div\frac{[$n2]}{[$d2]}\right)-\frac{[$n2]}{[$d2]} & =
2 \cdot \frac{[$d2]}{[$n2]} - \frac{[$n2]}{[$d2]} \\
& = \frac{[$n1*$d2]}{[$n2]}- \frac{[$n2]}{[$d2]} \\
\end{aligned}
```]
Next, find a common denominator which in this case is [$lcm]. 
[```
\begin{aligned}
& = \frac{[$n1*$d2]}{[$n2]} \cdot \frac{[$b]}{[$b]} 
    - \frac{[$n2]}{[$d2]}\cdot \frac{[$a]}{[$a]} \\
& = \frac{[$n1*$d2*$b]}{[$lcm]} - \frac{[$n2*$a]}{[$lcm]}\\
& = \frac{[$n1*$d2*$b - $n2*$a]}{[$lcm]} = [$ans2]
\end{aligned}
```]
END_PGML_SOLUTION

ENDDOCUMENT();        # This should be the last executable line in the problem.