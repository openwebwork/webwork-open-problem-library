# DESCRIPTION
# 
## ENDDESCRIPTION
## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Linear approximation and differentials)
## Institution(John Wiley & Sons)
## Author(Brian Burns)
## Level(2)
## MO(1)
## MLT(jh1)
## MLTleader(1)
## TitleText1('Calculus')
## AuthorText1('Anton')
## EditionText1('9')
## Section1('3.5')
## Problem1('32')
## KEYWORDS('derivative','derivatives','linear approximation','differentials')
#***************************************************************

DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "littleneck.pl",
  "PGcourse.pl"
);
# allow the student to change the seed for this problem.

rand_button();

###################################
# Setup
$x=random(0.96,1.04,0.01);
if($x==1){$x=$x+random(-.04,-.01,.01)}
$x0=1;
$dx=$x-$x0;
$f=Formula("ln(x)");
$df=Formula("1/x")->reduce;
$fx=$f->eval(x=>$x);
$fx0=$f->eval(x=>$x0);
$dfx0=$df->eval(x=>$x0);
$ans=Compute("$fx0+($dfx0*$dx)");
Context("LimitedNumeric")->operators->redefine('/');
Context()->parens->redefine('(');
$ans=Compute("$ans");


###################################
# Main text
BEGIN_PGML
Use an appropriate local linear approximation to estimate the value of the given quantity.

[`\ln([$x]) \approx{}`][_]{$ans}{20}
END_PGML

###################################
BEGIN_PGML_SOLUTION
Let [`f(x)=[$f]`], [`f'(x)=[$df]`].
[```f(x)=\ln(x)\approx f(x_0)+f'(x_0)(x-x_0)= \ln x_0+\frac{1}{x_0}(x-x_0)```]
Picking the square [`x_0=[$x0]`] close to [`[$x]`] we get
[```\ln([$x]) \approx [$fx0]+[$dfx0]([$x]-[$x0])```]
So that [```\ln([$x]) \approx [$ans]```]

END_PGML_SOLUTION

###################################
ENDDOCUMENT();
