#      Anton, Calculus, 3.5.26
# ************************************
# DESCRIPTION
# 
## ENDDESCRIPTION
## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Linear approximation and differentials)
## Institution(John Wiley & Sons)
## Author(Brian Burns)
## Level(2)
## MO(1)
## MLT(jh1)
## TitleText1('Calculus')
## AuthorText1('Anton')
## EditionText1('9')
## Section1('3.5')
## Problem1('26')
## KEYWORDS('derivative','derivatives','linear approximation','differentials')
#***************************************************************


DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "contextFraction.pl",
  "littleneck.pl",
  "PGcourse.pl"
);
# allow the student to change the seed for this problem.

rand_button();

###################################
# Setup
$pm1=random(-1,1,2);
$r=random(1,10,1);
$x0=$r**2;
$pm1=random(-1,1,2);
$a=$x0+$pm1;
if($a==0){$r=1;$x0=1;$pm1=1;$a=$x0+$pm1}
$denom=2*$r;
$f=Formula("$r+(x-$x0)/(2*$r)")->reduce;

Context("LimitedNumeric")->operators->redefine('/');
Context()->parens->redefine('(');
if($pm1==-1){
  $num=$r*$denom-1;
  $ans=Compute("$num/$denom");
  $ansd1="$r-\frac{1}{$denom}";
}
else{
  $num=$r*$denom+1;
  $ans=Compute("$num/$denom");
  $ansd1="$r+\frac{1}{$denom}";
}

$ansd2="\frac{$num}{$denom}";

###################################
# Main text
BEGIN_PGML
Use an appropriate local linear approximation to estimate the value of the given quantity.

[`\sqrt{[$a]} \approx{}`][_]{$ans}{20}
END_PGML

###################################
BEGIN_PGML_SOLUTION
[```\sqrt{x}\approx \sqrt{x_0}+\frac{1}{2\sqrt{x_0}}(x-x_0)```]
Picking the square [`x_0=[$x0]`] close to [`[$a]`] we get
[```\sqrt{x}\approx [$f]```]
So that [```\sqrt{[$a]}\approx [$ansd1]=[$ansd2]```]

END_PGML_SOLUTION

###################################
ENDDOCUMENT();
