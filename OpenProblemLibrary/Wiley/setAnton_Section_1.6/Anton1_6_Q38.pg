# ************************************
#   Comments + Keyword Clarification

#      Anton, Calculus, 1.6.38
# ************************************
# DESCRIPTION

## ENDDESCRIPTION
## DBsubject(Calculus - single variable)
## DBchapter(Limits and continuity)
## DBsection(Evaluating limits - trigonometric)
## Institution(John Wiley & Sons)
## Author(Brian Burns)
## MO(1)
## TitleText1('Calculus')
## AuthorText1('Anton')
## EditionText1('9')
## Section1('1.6')
## Problem1('38')
## KEYWORDS('limit','limits','continuity')
#***************************************************************

DOCUMENT();    # This should be the first executable line in the problem.

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

# Setup
$a = random(1, 12, 1) * random(-1, 1, 2);

$f1  = Formula("x**2-$a*sin(x)")->reduce;
$f2  = Formula("x")->reduce;
$f   = $f1 / $f2;
$g1  = Formula("-$a*sin(x)")->reduce;
$F   = Formula("x+$g1/$f2")->reduce;
$ans = Compute(-$a);

# Main text
BEGIN_PGML
Find the limit.

[`` \lim_{x\to 0} [$f]``][_]{$ans}{5}[@ helpLink('limits') @]*
END_PGML

BEGIN_PGML_SOLUTION
[`\displaystyle \lim_{x\to 0}  [$f]=\lim_{x\to  0} \left[ [$F]\right]=0 - [$a]=[$ans]`]
END_PGML_SOLUTION

ENDDOCUMENT();
