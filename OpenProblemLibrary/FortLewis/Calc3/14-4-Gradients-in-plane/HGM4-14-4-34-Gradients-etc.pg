## DESCRIPTION
##   Estimating directional derivatives
## ENDDESCRIPTION

## DBsubject(Calculus - multivariable)
## DBchapter(Differentiation of multivariable functions)
## DBsection(Directional derivatives and the gradient)
## Date(10/15/09)
## Institution(Fort Lewis College)
## Author(Paul Pearson)
## MLT(Grad-GradAtPt-DirDeriv)
## MLTleader(1)
## Level(3)
## MO(1)
## TitleText1('Calculus')
## AuthorText1('Hughes-Hallett')
## EditionText1('4')
## Section1('14.4')
## Problem1('21')
## TitleText2('Calculus')
## AuthorText2('Hughes-Hallett')
## EditionText2('5')
## Section2('14.4')
## Problem2('21')
## KEYWORDS('Gradient', 'Directional Derivative')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'parserVectorUtils.pl', 'PGcourse.pl');

Context("Vector");

#  The function
$f = Formula("sqrt(tan(x)+y)")->reduce;

#  The point
$x = non_zero_random(-14, 14, 1) / 10;
$y = random(6, 10, 1);

#  The direction vector
$U = non_zero_vector2D(-3, 3);

#  The gradient
$fx = $f->D('x');
$fy = $f->D('y');

$gradf =
    Formula("<$fx, $fy>")->with(limits => [ [ 0, 1.5 ], [ .1, 2 ] ])->reduce;
$gradfab = $gradf->eval(x => $x, y => $y)->reduce;

#  Directional derivative
$Duf = $gradfab . unit($U);

BEGIN_PGML
Suppose [`` f(x,y) = [$f] ``] and [` \boldsymbol{u} `] is the unit vector in the direction of [` [$U] `]. Then,

a) [` \nabla f (x,y) = `] [_]{$gradf}

b) [` \nabla f ([$x],[$y]) = `] [_]{$gradfab}

c) [`f_{\boldsymbol{u}} \, ([$x],[$y]) = D_{\boldsymbol{u}} \, f([$x],[$y]) = `] [_]{$Duf}
END_PGML

ENDDOCUMENT();
