## DESCRIPTION
##   Estimating directional derivatives
## ENDDESCRIPTION

## DBsubject(Calculus - multivariable)
## DBchapter(Differentiation of multivariable functions)
## DBsection(Directional derivatives and the gradient)
## Date(10/15/09)
## Institution(Fort Lewis College)
## Author(Paul Pearson)
## Level(3)
## MO(1)
## TitleText1('Calculus')
## AuthorText1('Hughes-Hallett')
## EditionText1('4')
## Section1('14.4')
## Problem1('62')
## TitleText2('Calculus')
## AuthorText2('Hughes-Hallett')
## EditionText2('5')
## Section2('14.4')
## Problem2('62')
## KEYWORDS('Gradient', 'Directional Derivative')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'parserVectorUtils.pl', 'parserImplicitEquation.pl', 'PGcourse.pl');

Context("Vector");

#  function
$f = Formula("(y - x)**2 - x * y");

#  point
@xcoord = (-3,-2,2,3);
@ycoord = (-2,-3,3,2);
$sel = random(0,3);
($x,$y) = (@xcoord[$sel],@ycoord[$sel]);

#  gradient
$fx = $f->D('x');
$fy = $f->D('y');
$gradf = Formula("< $fx, $fy >") -> reduce;
$gradfab = $gradf -> eval(x=>$x,y=>$y) -> reduce;

Context("ImplicitEquation")->variables->set( x=>{limits=>[-4,4]}, y=>{limits=>[-4,4]} );

if ( $x == -3 ) {
  $line = ImplicitEquation("y = -2");
} elsif ( $x == -2 ) {
  $line = ImplicitEquation("x = -2");
} elsif ( $x == 2 ) {
  $line = ImplicitEquation("x = 2");
} else { # $x == 3
  $line = ImplicitEquation("y = 2");
}


BEGIN_PGML
View the curve [` (y-x)^2 + 2 = xy - 3 `] as a contour of [`f(x,y)`].

a) Use [` \nabla f ([$x],[$y]) `] to find a vector normal to the curve 
at [` ([$x],[$y]) `]. 

    [_]{$gradfab->cmp(parallel => 1, showCoordinateHints => 0)}

b) Use your answer to part (a) to find an implicit
equation for the tangent line to the curve at [` ([$x],[$y]) `]. 

    [_]{$line}
END_PGML
ENDDOCUMENT();