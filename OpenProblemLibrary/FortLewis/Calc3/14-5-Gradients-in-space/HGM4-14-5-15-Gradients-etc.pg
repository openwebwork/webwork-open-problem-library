## DESCRIPTION
##   Estimating directional derivatives
## ENDDESCRIPTION

## DBsubject(Calculus - multivariable)
## DBchapter(Differentiation of multivariable functions)
## DBsection(Directional derivatives and the gradient)
## Date(10/15/09)
## Institution(Fort Lewis College)
## Author(Paul Pearson)
## MLT(DirectionalDerivAtAngle)
## Level(3)
## MO(1)
## TitleText1('Calculus')
## AuthorText1('Hughes-Hallett')
## EditionText1('4')
## Section1('14.5')
## Problem1('23')
## TitleText2('Calculus')
## AuthorText2('Hughes-Hallett')
## EditionText2('5')
## Section2('14.5')
## Problem2('23')
## KEYWORDS('Gradient', 'Directional Derivative')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'parserVectorUtils.pl', 'PGcourse.pl');

Context("Vector")->flags->set(reduceConstants => 0);

#  The function
$a = random(2, 4, 1);
$f = Formula("$a * x * y + z**2")->reduce;

#  The point
($x, $y, $z) = (
    non_zero_random(-5, 5, 1),
    non_zero_random(-5, 5, 1),
    non_zero_random(-5, 5, 1)
);

#  The gradient
$fx       = $f->D('x');
$fy       = $f->D('y');
$fz       = $f->D('z');
$gradf    = Formula("<$fx, $fy, $fz>")->reduce;
$gradfabc = $gradf->eval(x => $x, y => $y, z => $z)->reduce;

#  Angle
$b     = list_random(2, 3, 6);
$theta = Real("pi/$b");

#  Directional derivative
$Duf = norm($gradfabc) * cos($theta);

BEGIN_PGML
Find the directional derivative of [``f(x,y,z) = [$f] ``] at the point 
[` ([$x],[$y],[$z]) `] in the direction of a vector making an angle of
[` \pi/[$b] `] with [` \nabla f([$x],[$y],[$z]) `].

    [` f_{[$u]} \, ([$x],[$y],[$z]) = D_{[$u]} \, f([$x],[$y],[$z]) = `]
    [_]{$Duf}

END_PGML
ENDDOCUMENT();
