## DESCRIPTION
## exponents
## ENDDESCRIPTION

## BookTitle('Algebra: Form and Function')
## BookChapter('Rules for Exponents and the Reasons for Them')
## DBsubject(Algebra)
## DBchapter(Properties of exponents, rational exponents and radicals)
## DBsection(Properties of exponents)
## Date(01/01/10)
## Institution(Fort Lewis College)
## Author(Paul Pearson)
## Level(2)
## MO(1)
## TitleText1('Algebra: Form and Function')
## AuthorText1('McCallum, Connally, and Hughes-Hallett')
## EditionText1('1')
## Section1('6.1')
## Problem1('14 16 18')
## KEYWORDS('exponents')

#  Initialization

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'PGcourse.pl');

Context("LimitedFraction")->flags->set(showProperFractions => 0);

$x = 2;    #random(2,3,1);
$y = random(-4, -2);
$z = random(-5, -3);
if ($y == $z) { $z = -5; }

$ansa = Real(($y)**($x));
$ansb = Fraction(($y)**($x), ($z)**($x));
$ansc = Real(($x)**(abs($z)));

BEGIN_PGML
Evaluate the following expressions for [` x = [$x] `],
[` y = [$y] `], and [` z = [$z] `] without using
a calculator.  Simplify your answers as much
as possible, and if relevant enter your answers as fractions.

a) [`` y^x = ``] [_]{$ansa}

b) [`` \left(\frac{y}{z}\right)^x = ``] [_]{$ansb}

c) [`` x^{-z} = ``] [_]{$ansc}


[@  helpLink('fractions')  @]*
END_PGML

$pz = -$z;

BEGIN_PGML_SOLUTION
a)  [`` y^x = ([$y])^{[$x]} = [$ansa] ``]

b) [``  \left(\frac{y}{z}\right)^x = \left( \frac{[$y]}{[$z]}\right)^2 
= \frac{([$y]^{[$x]})}{([$z]^{[$x]})} = [$ansb] ``]

c) [`` x^{-z} = ([$x])^{-([$z])} = [$x]^{[$pz]} = [$ansc]``]

END_PGML_SOLUTION

ENDDOCUMENT();
