## DBsubject(Algebra)
## DBchapter(Properties of exponents, rational exponents and radicals)
## DBsection(Properties of exponents)
## KEYWORDS('exponents')
## Level(3)
## Static(1)
## MO(1)
DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context("LimitedNumeric");

$a    = random(2, 4);
$twoa = 2 * $a;
($b, $c) = random_subset(2, 2 .. 3);

$ans = Real(2**($b * $c));

BEGIN_PGML

Evaluate: [`` \left( \frac{ -[$twoa]^{[$b]} }{ -[$a]^{[$b]} } \right)^[$c] = ``]
[_]{$ans}

---

Note: Your answer should be completely simplified.
Unsimplified answers will not be accepted.

END_PGML

BEGIN_PGML_SOLUTION
[``` \left( \frac{ -[$twoa]^{[$b]} }{ -[$a]^{[$b]} } \right)^[$c] =
\left(\frac{[$twoa]}{[$a]}\right)^{[$b]\cdot [$c]} 
= 2^{[$b*$c]} = [$ans]
```]
END_PGML_SOLUTION

ENDDOCUMENT();
