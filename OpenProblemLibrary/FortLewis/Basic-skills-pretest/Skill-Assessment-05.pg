## DBsubject(Algebra)
## DBchapter(Properties of exponents, rational exponents and radicals)
## DBsection(Properties of exponents)
## KEYWORDS('exponential sum rule');
## Level(3)
## MO(1)
DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

#  Setup

Context("LimitedNumeric");

$a      = random(5, 6);
$b      = random(2, 4);
$ans = Real(2**($a - $b));

BEGIN_PGML

Evaluate: [`` \frac{ 2^{[$a]} }{ 2^{[$b]} } = ``]
[_]{$ans}


---

Note: Your answer should be completely simplified.
Unsimplified answers will not be accepted.

END_PGML

BEGIN_PGML_SOLUTION
Recall the exponential rule
[``` \frac{a^x}{a^y} = a^{x-y} ```]
Applying this rule:

[```\frac{ 2^{[$a]} }{ 2^{[$b]} } = 2^{[$a]-[$b]} = 2^{[$a-$b]} = [$ans]```]
END_PGML_SOLUTION

ENDDOCUMENT();
