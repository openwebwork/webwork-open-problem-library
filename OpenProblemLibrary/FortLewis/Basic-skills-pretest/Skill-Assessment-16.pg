## DESCRIPTION
## Solve a linear equation
## ENDDESCRIPTION
## DBsubject(Algebra)
## DBchapter(Linear equations and functions)
## DBsection(Linear equations)
## KEYWORDS('linear equation','solution')
## Level(3)
## MO(1)
DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context("LimitedNumeric");

$a   = random(2, 4, 2);
$b   = random(7, 9, 2);
$bma = $b - $a;

BEGIN_PGML

Solve [```
x - \frac{[$a]}{[$b]} x = [$bma]
```]

[` x = `]  [_]{Real("$b")}

*Note:* Your answer should be completely simplified.
END_PGML

BEGIN_PGML_SOLUTION
[```
\begin{aligned}
x - \frac{[$a]}{[$b]} x & = [$bma] \qquad \qquad \text{Multiply by [$b]} \\
[$b] x - [$a] x & = [@ $b*$bma @] \\
[$bma] x & = [@ $b*$bma @] \\
x & = [$b]
\end{aligned}
```]
END_PGML_SOLUTION

ENDDOCUMENT();
