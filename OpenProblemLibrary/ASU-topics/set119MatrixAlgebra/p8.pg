## DESCRIPTION
## Matrix Algebra
## ENDDESCRIPTION

## Tagged by tda2d

## DBsubject(Linear algebra)
## DBchapter(Matrices)
## DBsection(Matrix algebra)
## Institution(ASU)
## Level(2)
## KEYWORDS('Algebra' 'Matrix' 'Matrices')

DOCUMENT();    # This should be the first executable line in the problem.

loadMacros(
    "PGstandard.pl",    'PGML.pl',
    "PGasu.pl",         "PGchoicemacros.pl",
    "PGgraphmacros.pl", "PGmatrixmacros.pl",
    "PGcourse.pl"
);

$a11 = non_zero_random(-10, 10, 1);
$a12 = non_zero_random(-10, 10, 1);
$a21 = non_zero_random(-10, 10, 1);
$a22 = random(-10, 10, 1);

$A = Matrix([ [ $a11, $a12 ], [ $a21, $a22 ] ]);

$b11 = random(-10, 10, 1);
$b12 = non_zero_random(-10, 10, 1);
$b21 = non_zero_random(-10, 10, 1);
$b22 = non_zero_random(-10, 10, 1);

$B = Matrix([ [ $b11, $b12 ], [ $b21, $b22 ] ]);

$mult = random(2, 5, 1);

$ans11 = $mult * ($a11 * $b11 + $a12 * $b21);
$ans12 = $mult * ($a11 * $b12 + $a12 * $b22);
$ans21 = $mult * ($a21 * $b11 + $a22 * $b21);
$ans22 = $mult * ($a21 * $b12 + $a22 * $b22);

BEGIN_PGML
If [` A = [$A] `] and [` B = [$B] `], then

[@ mbox("\\(A($mult B)=\\)", display_matrix([[ans_rule(5),ans_rule(5)]
,[ans_rule(5),ans_rule(5)]],
'align'=>"cc")) @]* 
END_PGML

ANS(num_cmp($ans11));
ANS(num_cmp($ans12));
ANS(num_cmp($ans21));
ANS(num_cmp($ans22));

ENDDOCUMENT();       # This should be the last executable line in the problem.
