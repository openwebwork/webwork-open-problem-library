## DESCRIPTION
## Applied Mathematics
## ENDDESCRIPTION

## Tagged by XW

## DBsubject(Arithmetic)
## DBchapter(Percents)
## DBsection(Calculations)
## Institution(ASU)
## Level(3)
## KEYWORDS('percent', 'mathematics for business', 'algebraic expression')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

$b  = random(1,  9);
$aa = random(10, 30, 10);
$a  = $aa * $b;
$c  = random(1, 18);
$c++ if ($c == 10);
$d = random(10, 50, 10);

BEGIN_PGML
a) What percent of [$a] is [$b]?  [_]{Real(100/$aa)}

b) [$c]% of what number is [$d]? [_]{100*$d/$c}
END_PGML

BEGIN_PGML_SOLUTION
a) This is found with writing the fraction [` \frac{[$b]}{[$a]}`] and then multiplying by 100 or [@100/$aa@].

b) This is found by writing [$c]% as the fraction [`\frac{[$c]}{100}`] and then finding 
[`` \frac{[$d]}{[$c]/100} = [@100*$d/$c@]``].
END_PGML_SOLUTION

ENDDOCUMENT();
