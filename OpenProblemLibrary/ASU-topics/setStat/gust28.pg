DOCUMENT();    # This should be the first executable line in the problem.

loadMacros('PGstandard.pl', 'PGML.pl', 'parserRadioButtons.pl', 'PGcourse.pl');

@opts = (
    'A frequency histogram displays class frequencies on the '
        . 'vertical axis while a relative-frequency historgram displays '
        . 'class relative frequencies on the vertical axis.',
    'A frequency histogram displays class frequencies on the '
        . 'horizontal axis while a relative-frequency histogram displays '
        . 'class relative frequencies on the horizontal axis.',
    'There is no difference between the two.'
);
$radio = RadioButtons([ [@opts], 'None of the above.' ], 0, labels => 'ABC');

BEGIN_PGML

What is the difference between a frequency histogram and a relative frequency histogram?

[_]{$radio}

END_PGML

BEGIN_PGML_SOLUTION
[$radio]
END_PGML_SOLUTION

ENDDOCUMENT();
