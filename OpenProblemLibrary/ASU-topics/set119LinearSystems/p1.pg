## DESCRIPTION
## Systems of Linear Equations
## ENDDESCRIPTION

## Tagged by tda2d

## DBsubject(Linear algebra)
## DBchapter(Systems of linear equations)
## DBsection(Systems with 2 variables)
## Institution(ASU)
## MLT(uniquesoljj)
## MLTleader(1)
## Level(2)
## KEYWORDS('Algebra' 'Linear Equations')

#
# First comes some stuff that appears at the beginning of every problem
#

DOCUMENT();    # This should be the first executable line in the problem.

loadMacros(
    'PGstandard.pl',             'PGML.pl',
    'parserRadioMultiAnswer.pl', 'PGcourse.pl'
);

$x = non_zero_random(-3, 3, 1);
$y = random(-3, 3, 1);
@a = (5, 5, 3, 3, 5, 2, 3, 3, 7, 7);
@b = (2, 7, 7, 2, 3, 3, 5, 4, 5, 4);
@c = (7, 2, 2, 7, 3, 3, 4, 5, 4, 5);
@d = (3, 3, 5, 5, 2, 5, 7, 7, 3, 3);
$i = random(0, 9, 1);

$b1 = $a[$i] * $x + $b[$i] * $y;
$b2 = $c[$i] * $x + $d[$i] * $y;

# Dummy formula for y in terms of x so that type checking will work for
# the infinitely many solutions answer (which is never correct)
$f = Formula('x');

$rma = RadioMultiAnswer(
    [
        ['The system has no solutions.'],
        [
            'The system has the unique solution \(x=\)%s and \(y=\)%s',
            $x,
            $y
        ],
        [
            'The system has infinitely many solutions where \(y=\)%s (expressed in terms of \(x\))',
            $f
        ]
    ],
    1
);

BEGIN_PGML
Solve the system using the substitution or elimination method
[``` \left\lbrace
\begin{array}{rcl}
        [$a[$i]]x+[$b[$i]]y &=& [$b1] \\
        [$c[$i]]x+[$d[$i]]y &=& [$b2]
\end{array}\right.
```]
[_]{$rma}
END_PGML

COMMENT('The coefficient matrix always has determinant 1.');
ENDDOCUMENT();        # This should be the last executable line in the problem.
