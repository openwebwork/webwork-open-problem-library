##DESCRIPTION
##  Algebra problem: linear inequality
##ENDDESCRIPTION

## tcao , PAID on 11-24-2003

## DBsubject(Algebra)
## DBchapter(Linear equations and functions)
## DBsection(Linear inequalities)
## Date(6/3/2002)
## MLT(SolutionHasIntervalStructure)
## MLTleader(1)
## Level(3)
## TitleText1('Precalculus')
## AuthorText1('Stewart, Redlin, Watson')
## EditionText1('3')
## Section1('1.7')
## Problem1('15')
## KEYWORDS('algebra', 'linear inequality')
DOCUMENT();    # This should be the first executable line in the problem.

loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'PGcourse.pl');

Context('Fraction');

$a    = random(1, 20);
$b    = random(1, 20);
$left = Fraction($a - $b, 3);

Context('Interval');
$int = Compute("[$left,inf)");

BEGIN_PGML
The solution of the linear inequality
[``` 3x + [$a] \le 6x + [$b] ```]
is [_]{$int}

*Write the answer in interval notation.*

[@ helpLink('intervals'); @]*
END_PGML

BEGIN_PGML_SOLUTION
[```
\begin{aligned}
3x + [$a] & \leq 6x + [$b] \\
[$a]-[$b] & \leq 3x \\
\frac{[$a-$b]}{3} & \leq x 
\end{aligned}```]

So the interval is [``[$int]``].
END_PGML_SOLUTION

ENDDOCUMENT();
