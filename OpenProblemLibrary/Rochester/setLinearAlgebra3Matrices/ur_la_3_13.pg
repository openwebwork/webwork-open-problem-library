## DBsection(Matrix algebra)
## Date(6/3/2002)
## Level(3)
## TitleText1('Elementary Linear Algebra')
## AuthorText1('Larson, Edwards, Falvo')
## EditionText1('5')
## Section1('2.1')
## Problem1('')
## TitleText2('Linear Algebra with Applications')
## AuthorText2('Jeffrey Holt')
## EditionText2('1')
## Section2('3.2')
## Problem2('')
## KEYWORDS(matrix, product, size)
##
##ENDDESCRIPTION

DOCUMENT();    # This should be the first executable line in the problem.

loadMacros(
    "PGstandard.pl",             'PGML.pl',
    'parserRadioMultiAnswer.pl', "PGcourse.pl"
);

$a = random(2, 5, 1);
$b = random(2, 8, 1);
if ($b == $a) { $b = $b + 1; }
$c = random(6, 9, 1);
if ($c == $b) { $c = $c + 1 }

@quest = ('AB', 'BC', 'A^2', 'BA', 'CB', 'AC', 'B^2');

$AB = RadioMultiAnswer(
    [
        [
            "\(AB\) is defined and the product is %s\(\times\)%s",
            $a, $b
        ],
        ["\(AB\) is undefined"]
    ],
    0
);

$BC = RadioMultiAnswer(
    [
        [
            "\(BC\) is defined and the product is %s\(\times\)%s",
            $a, $c
        ],
        ["\(BC\) is undefined"]
    ],
    0
);

$A2 = RadioMultiAnswer(
    [
        [
            "\(A^2\) is defined and the product is %s\(\times\)%s",
            $a, $a
        ],
        ["\(A^2\) is undefined"]
    ],
    0
);

$BA = RadioMultiAnswer(
    [
        [
            "\(BA\) is defined and the product is %s\(\times\)%s",
            $b, $a
        ],
        ["\(BA\) is undefined"]
    ],
    1
);

$CB = RadioMultiAnswer(
    [
        [
            "\(CB\) is defined and the product is %s\(\times\)%s",
            $c, $a
        ],
        ["\(CB\) is undefined"]
    ],
    1
);

$AC = RadioMultiAnswer(
    [
        [
            "\(AC\) is defined and the product is %s\(\times\)%s",
            $a, $c
        ],
        ["\(AC\) is undefined"]
    ],
    1
);

$B2 = RadioMultiAnswer(
    [
        [
            "\(B^2\) is defined and the product is %s\(\times\)%s",
            $b, $b
        ],
        ["\(B^2\) is undefined"]
    ],
    1
);

@ans = ($AB, $BC, $A2, $BA, $CB, $AC, $B2);

@slice = random_subset(4, (0 .. 6));

@squest = @quest[@slice];
@sans   = @ans[@slice];

BEGIN_PGML
If [`A`], [`B`], and [`C`] are [` [$a] \times [$a]`], [`[$a] \times [$b]`], and [`[$b] \times [$c]`] matrices respectively,
determine which of the following products are defined. For those defined, enter the size of the resulting matrix.
1. [`[$squest[0]]`]
[_]{$sans[0]}
2. [`[$squest[1]]`]
[_]{$sans[1]}
3. [`[$squest[2]]`]
[_]{$sans[2]}
4. [`[$squest[3]]`]
[_]{$sans[3]}
END_PGML

ENDDOCUMENT();       # This should be the last executable line in the problem.
