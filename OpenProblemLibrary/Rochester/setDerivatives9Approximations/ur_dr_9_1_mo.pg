DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "PGcourse.pl"
);

##############################################################
#
#  Setup
#
#
Context("Numeric");
$a = Real( random(1.01, 1.49, 0.01) );
$l = Compute("x-1"); 

Context("LimitedNumeric")->operators->redefine('/');
Context()->parens->redefine('(');
$ans = $a-1;
##############################################################
#
#  Text
#
#

BEGIN_PGML
Find the linear approximation of [`f(x)=\ln x`] at [`x=1`] and use it to estimate [`\ln([$a])`]. 

[`L(x)={}`][_]{$l}{10}

[`\ln [$a] \approx{}`][_]{$ans}{10}
END_PGML

ENDDOCUMENT();

