## DESCRIPTION
## Calculus
## ENDDESCRIPTION

## Tagged by cmd6a 4/20/06

## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Linear approximation and differentials)
## Date(6/3/2002)
## Level(3)
## TitleText1('Calculus: Early Transcendentals')
## AuthorText1('Rogawski')
## EditionText1('1')
## Section1('4.1')
## Problem1('47')
## TitleText2('Calculus: Early Transcendentals')
## AuthorText2('Stewart')
## EditionText2('6')
## Section2('3.10')
## Problem2('47')
## KEYWORDS('linear', 'approximation' 'graphs','Calculus','Derivatives')
DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "PGlateximage.pl",
  "parserPopUp.pl",
  "PGcourse.pl"
);

$sgn = random(-1,1,2);
$r1 = random(.5,1.5,.1);
while ($r1 == 1) {$r1 = random(.5,1.5,.1);}
$z0 = random(1,4,1);
$z1 = $z0-1;
$z2 = $z0+1;
$y0 = random(1,4,1);
$y1 = random(2,40,1);
$dx = random(.1,.3,.1);
$z3 = $z0+$dx;

$graph = createLaTeXImage();
$graph->texPackages(['pgfplots']);
$graph->BEGIN_LATEX_IMAGE
\begin{tikzpicture}
        \begin{axis}[xmin=-1, ymin=-5, xmax=5, ymax=5, axis lines=middle, grid=both]
                \addplot[color=red, domain=$z1:$z2, thick]{$sgn*((x-$z1)^$r1 - 1) + $y0};
        \end{axis}
\end{tikzpicture}
END_LATEX_IMAGE

$ans = $y1 + $y0*$dx;

$bigsmall = DropDown(['too big', 'too small'], ($sgn > 0 ? 1 : 0));

BEGIN_PGML
Suppose you have a function [`f(x)`] and all you know is that [`f([$z0]) = [$y1]`] and the graph of
its derivative is:

[! !]{$graph}{300}

Use linear approximation to estimate [`f([$z3])`]:  [_]{$ans}{10}

Is your answer a little too big or a little too small? [_]{$bigsmall}
END_PGML

ENDDOCUMENT();        # This should be the last executable line in the problem.

