## DESCRIPTION
##   Equations of Planes
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Planes)
## Date(6/3/2002)
## Level(2)
## TitleText1('Calculus: Early Transcendentals')
## AuthorText1('Rogawski')
## EditionText1('1')
## Section1('12.5')
## Problem1('23 24 32 34')
## TitleText2('Calculus: Early Transcendentals')
## AuthorText2('Stewart')
## EditionText2('6')
## Section2('12.1')
## Problem2('23 24 32 34')
## KEYWORDS('Plane')

DOCUMENT('plane');

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "parserPopUp.pl",
  "PGcourse.pl"
);

$showPartialCorrectProblems = 0;

$a = random(-10, 10);
$b = random(1, 10);
$c = random(-10, 10);
$d = random(-10, 10);
$e = random(-10, 10);
$f = random(-10, 10);

$choices = ['a vertical plane', 'a horizontal plane', 'a plane which is neither vertical nor horizontal'];
$v = DropDown($choices, 0); 
$h = DropDown($choices, 1); 
$n = DropDown($choices, 2); 

BEGIN_PGML
What do the following equations represent in [`\mathbb{R}^3`]?

a. [`[$a]x + [$b]y = [$c]`] represents [_]{$n}.
a. [`x = [$d]`] represents [_]{$v}.
a. [`y = [$e]`] represents [_]{$v}.
a. [`z = [$f]`] represents [_]{$h}.

END_PGML

ENDDOCUMENT();
