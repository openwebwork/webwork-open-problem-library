## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Newton's method)
## Institution(W.H.Freeman)
## Author(justask)
## Level(3)
## TitleText1('Calculus: Early Transcendentals')
## AuthorText1('Rogawski')
## EditionText1('2')
## Section1('4.8')
## Problem1('9')
## KEYWORDS('calculus', 'derivatives', 'newtons method')
DOCUMENT();

# Load whatever macros you need for the problem
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "PGlateximage.pl",
  "freemanMacros.pl",
  "PGcourse.pl"
);
 
## Do NOT show partial correct answers
$showPartialCorrectAnswers = 0;

$a=random(4,6,0.5);
$x1_0=Real($a-1-($a*$a-$a)**0.5);
$x2_0=Real($a-1+($a*$a-$a)**0.5);

$par = Formula("$a*x");
$par1 = Formula("e^x");

$ymax = 3*$a;
$graph = createLaTeXImage();
$graph->texPackages(['pgfplots']);
$graph->BEGIN_LATEX_IMAGE
\begin{tikzpicture}
        \begin{axis}[
                        xmin=-1,
                        xmax=3,
                        ymin=-1,
                        ymax=$ymax,
                        axis lines=middle,
                        minor xtick={-1,...,3},
                        minor ytick={1,...,$ymax},
                        grid=both
                ]
                \addplot[color=red, domain=-1:3, thick]{$par};
                \addplot[color=blue, domain=-1:3, thick]{$par1};
        \end{axis}
\end{tikzpicture}
END_LATEX_IMAGE

$newton=Formula("x-(e^x-$a x)/(e^x-$a)");

$a[0] = 0.25;
$a[1] = $newton->eval(x => $a[0]);
while ($a[-2] != $a[-1] || $#a < 5) {
	push @a, $newton->eval(x => $a[-1]);
}

$b[0] = 2.5;
$b[1] = $newton->eval(x => $b[0]);
while ($b[-2] != $b[-1] || $#b < 5) {
	push @b, $newton->eval(x => $b[-1]);
}

BEGIN_PGML
[@textbook_ref_exact("Rogawski ET 2e", "4.8","9")@]

Use Newton's Method to find the two solutions of [`e^x = [$a] x`] to six significant figures.

[! !]{$graph}{400}{400}

[`x_{\text{left}}={}`][_]{$a[-1]}

[`x_{\text{right}}={}`][_]{$b[-1]}
END_PGML

###################################################################

BEGIN_PGML_SOLUTION
A solution of [`e^x = [$a] x`] is a zero of the function [`f(x)= e^x - [$a] x`].  
We have [`f(x)= e^x - [$a] x`]  and  [`f'(x)=e^x - [$a]`].  
We can estimate the value of the two zeros by looking at the graph. Possible such initial guesses are: [`x=[$a[0]]`] and [`x=[$b[0]]`].

Let us calculate the first zero iterations beginning with [`x_0=[$a[0]]`]:

[`x_1 = x_0 - \frac{f(x_0)}{f'(x_0)}= x_0 - \frac{e^{x_0} - [$a] x_0}{e^{x_0} - [$a]}`]  
[`\qquad = [$a[0]] - \frac{e^{[$a[0]]} - [$a] \times [$a[0]]}{e^{[$a[0]]} - [$a]} \approx [$a[1]]`]

[`x_2 = x_1 - \frac{f(x_0)}{f'(x_0)}= x_0 - \frac{e^{x_0} - [$a] x_0}{e^{x_0} - [$a]}`]  
[`\qquad = [$a[1]] - \frac{e^{[$a[1]]} - [$a] \times [$a[1]]}{e^{[$a[1]]} - [$a]} \approx [$a[2]]`]

[`x_3 = x_2 - \frac{f(x_0)}{f'(x_0)}= x_0 - \frac{e^{x_0} - [$a] x_0}{e^{x_0} - [$a]}`]  
[`\qquad = [$a[2]] - \frac{e^{[$a[2]]} - [$a] \times [$a[2]]}{e^{[$a[2]]} - [$a]} \approx [$a[3]]`]

[`x_4 = x_3 - \frac{f(x_0)}{f'(x_0)}= x_0 - \frac{e^{x_0} - [$a] x_0}{e^{x_0} - [$a]}`]  
[`\qquad = [$a[3]] - \frac{e^{[$a[3]]} - [$a] \times [$a[3]]}{e^{[$a[3]]} - [$a]} \approx [$a[4]]`]

Stopping here we can be fairly confident that [`[$a[4]]`] approximates the first zero of the equation [`e^x=[$a]x`].


Let us calculate the second zero iterations beginning with [`x_0=[$b[0]]`]:

[`x_1 = x_0 - \frac{f(x_0)}{f'(x_0)}= x_0 - \frac{e^{x_0} - [$a] x_0}{e^{x_0} - [$a]}`]  
[`\qquad = [$b[0]] - \frac{e^{[$b[0]]} - [$a] \times [$b[0]]}{e^{[$b[0]]} - [$a]} \approx [$b[1]]`]

[`x_2 = x_1 - \frac{f(x_0)}{f'(x_0)}= x_0 - \frac{e^{x_0} - [$a] x_0}{e^{x_0} - [$a]}`]  
[`\qquad = [$b[1]] - \frac{e^{[$b[1]]} - [$a] \times [$b[1]]}{e^{[$b[1]]} - [$a]} \approx [$b[2]]`]

[`x_3 = x_2 - \frac{f(x_0)}{f'(x_0)}= x_0 - \frac{e^{x_0} - [$a] x_0}{e^{x_0} - [$a]}`]  
[`\qquad = [$b[2]] - \frac{e^{[$b[2]]} - [$a] \times [$b[2]]}{e^{[$b[2]]} - [$a]} \approx [$b[3]]`]

[`x_4 = x_3 - \frac{f(x_0)}{f'(x_0)}= x_0 - \frac{e^{x_0} - [$a] x_0}{e^{x_0} - [$a]}`]  
[`\qquad = [$b[3]] - \frac{e^{[$b[3]]} - [$a] \times [$b[3]]}{e^{[$b[3]]} - [$a]} \approx [$b[4]]`]

Stopping here we can be fairly confident that [`[$b[4]]`] approximates the second zero of the equation [`e^x=[$a]x`].

END_PGML_SOLUTION

ENDDOCUMENT();
