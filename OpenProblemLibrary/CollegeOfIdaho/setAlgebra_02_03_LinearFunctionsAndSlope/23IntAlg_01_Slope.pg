##DESCRIPTION
## Slope

##ENDDESCRIPTION
## DBsubject(Algebra)
## DBchapter(Linear equations and functions)
## DBsection(Finding the slope)
## Institution(The College of Idaho)
## Author(RA Cruz)
## MLT(Slope_from_two_points)
## Level(2)
## MO(1)
## TitleText1('Essentials of Intermediate Algebra')
## AuthorText1('Blitzer')
## EditionText1('1')
## Section1('2.3')
## Problem1('')
## KEYWORDS('slope')
## Date: 2007/10 updated 2013/11 --rac

DOCUMENT(); # This should be the first executable line in the problem.

loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'parserPopUp.pl', 'PGcourse.pl');

Context('Fraction');

#  Setup

$n = random(1,3);

$x1 = random(-3,3);
$y1 = random(2,4);

# produce a point with non-zero slope
$x2 = $x1 + non_zero_random(-3,3);
$y2 = $y2 + non_zero_random(-3,3); 

$m = Fraction($y2-$y1,$x2-$x1); 

$dd = DropDown(['falls', 'rises', 'is horizontal', 'is vertical'], $m > 0 ? 1 : 0); 
#  Main text
 
BEGIN_PGML
Find the slope, if possible, of the line passing through the points, [` ([$x1], [$y1]) `] and [` ([$x2], [$y2]) `] and describe the line.  If the slope does not exist, enter _DNE_ for _Does not exist_.

a)  [`m = `] [_]{$m}

b) The line  [_]{$dd}
END_PGML

#  Answer

$showPartialCorrectAnswers = 1;

Context("Fraction"); 
Context()->strings->add("Does not exist"=>{},
                        "Not defined"=>{alias=>'Does not exist'},
                        "rises"=>{},
                        "falls"=>{},
                        "is horizontal"=>{},
                        "is vertical"=>{}
                        );

$ans_b = String("rises");
if ($x2-$x1 != 0){
   $ans_a = Compute("($y2 - $y1)/($x2 - $x1)");
   if ($ans_a<=0) {
      $ans_b = String("falls");
      if ($ans_a==0) {$ans_b = String("is horizontal");}
      } 
   }
else {
   $ans_a = String("Does not exist");
   $ans_b = String("is vertical");
   }

# ANS($ans_a->cmp);
# ANS($ans_b->cmp);

#  Solution

$a_sol = $ans_a;
if ($x2-$x1 != 0){$a_sol="\(m = \frac{$y2-$y1}{$x2-$x1} = $ans_a\)";}

BEGIN_PGML_SOLUTION

a) The slope is

    [``` m = \frac{y_2-y_1}{x_2-x_1} = \frac{[$y2]-[$y1]}{[$x2]-[$x1]} = [$m] ```]
  
b) [@ $m >0 ? 'Because the slope is positive, the line rises' : 'Because the slope is negative, the line falls.' @]

END_PGML_SOLUTION

;
ENDDOCUMENT();