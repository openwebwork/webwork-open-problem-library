## DESCRIPTION
## DBsubject(Statistics)
## DBchapter(Exploratory data analysis/descriptive statistics)
## DBsection(Graphical representations)
## Institution(The College of Idaho)
## Author(R Cruz, L Danielson, J Guild)
## Level(2)
## MO(1)
## TitleText1('The Basic Practice of Statistics')
## AuthorText1('David Moore')
## EditionText1('5e')
## Section1('2')
## Problem1('')
## KEYWORDS('statistics', 'boxplot')

DOCUMENT();    # This should be the first executable line in the problem.

loadMacros(
    'PGstandard.pl',         'PGML.pl',
    'parserRadioButtons.pl', 'StatisticalPlots.pl',
    'answerHints.pl',        'PGcourse.pl',
);

#  Setup

$n      = random(6, 24);
$number = 4 * $n;

$median = random(20, 40);
$Q1     = $median - random(4, 8);
$Q3     = $median + random(4, 8);
$min    = $Q1 - random(3, 6);
$max    = $Q3 + random(3, 6);

($xmin, $xmax) = (5 * int($min / 5), 5 * int($max / 5 + 1));

$boxplot = StatPlot(
    xmin            => $xmin - 3,
    xmax            => $xmax + 3,
    xtick_delta     => 5,
    xlabel          => '',
    show_grid       =>  0,
    ymin            => -4,
    ymax            =>  16,
    yvisible        =>  0,
    aspect_ratio    =>  0.5,
    rounded_corners => 1
);

$boxplot->add_boxplot(
    {
        min    => $min,
        q1     => $Q1,
        median => $median,
        q3     => $Q3,
        max    => $max
    },
    width => 1
);

$alt_text = <<~"END";
    Box and whiskers plot is shown.  The left whisker is from $min to $Q1.  
    The box is between $Q1 and $Q3. The middle line is at $median and the
    right whisker runs from $Q3 to $max.
    END

# randomly determine the shading.
$opt    = random(1, 7);
$scores = $n;

$scores *= 2 if $opt >= 5;
if ($opt == 1) {
    $boxplot->add_dataset([ $min, 8 ], [ $Q1, 8 ], color => 'blue', width => 3);
    $alt_text .= ' The left whisker is shaded blue.';
} elsif ($opt == 2) {
    $boxplot->add_rectangle(
        [ $Q1, 4 ], [ $median, 12 ],
        fill_color => 'blue',
        color      => 'blue'
    );
    $alt_text .=
        'The part of the box left of the vertical line in the middle is shaded blue.';
} elsif ($opt == 3) {
    $boxplot->add_rectangle(
        [ $median, 4 ], [ $Q3, 12 ],
        fill_color => 'blue',
        color      => 'blue'
    );
    $alt_text .=
        'The part of the box right of the vertical line in the middle is shaded blue.';
} elsif ($opt == 4) {
    $boxplot->add_dataset([ $Q3, 8 ], [ $max, 8 ], color => 'blue', width => 3);
    $alt_text .= 'The right whisker is shaded blue.';
} elsif ($opt == 5) {
    $boxplot->add_dataset([ $min, 8 ], [ $Q1, 8 ], color => 'blue', width => 3);
    $boxplot->add_rectangle(
        [ $Q1, 4 ], [ $median, 12 ],
        fill_color => 'blue',
        color      => 'blue'
    );
    $alt_text .=
        'Both the left whisker and the part of the box left of the vertical line in the middle is shaded.';
} elsif ($opt == 6) {
    $boxplot->add_rectangle(
        [ $Q1, 4 ], [ $Q3, 12 ],
        fill_color => 'blue',
        color      => 'blue'
    );
    $alt_text .= 'The entire box is shaded blue.';
} elsif ($opt == 7) {
    $boxplot->add_rectangle(
        [ $median, 4 ], [ $Q3, 12 ],
        fill_color => 'blue',
        color      => 'blue'
    );
    $boxplot->add_dataset([ $Q3, 8 ], [ $max, 8 ], color => 'blue', width => 3);
    $alt_text .=
        'Both the right whisker and the part of the box right of the vertical line in the middle is shaded.';
}

$ans = Real($scores)->cmp->withPostFilter(AnswerHints(
    Real(25)  => ["Give the number of scores not the percent."],
    Real(.25) => ["Give the number of scores not the fraction of scores."],
    Real(50)  => ["Give the number of scores not the percent."],
    Real(.50) => ["Give the number of scores not the fraction of scores."]
));

BEGIN_PGML
A boxplot for a set of [$number] scores is given below.

>>[!!]{$boxplot}{long_description => $alt_text, width => 600}<<

How many scores are represented in the blue section of the boxplot? [_]{$ans}{15}

*Note: the shaded whiskers are blue and thicker.*
END_PGML

BEGIN_PGML_SOLUTION
Recall that the each of the whiskers is 25% of the total data, and each part of the box (to the left and right) of the vertical line represents 25% of the data. 

In this case [@ $opt >=5  ? "50%" : "25%" @] of the data is in the shaded part of the boxplot.  The total number then is [` [$number] \cdot [@ $opt >=5  ? "0.5" : "0.25" @]= [$scores] `]
END_PGML_SOLUTION

ENDDOCUMENT(); 