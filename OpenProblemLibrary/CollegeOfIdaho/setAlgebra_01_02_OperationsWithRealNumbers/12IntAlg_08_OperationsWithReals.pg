##DESCRIPTION
##  Add signed numbers

##ENDDESCRIPTION
## DBsubject(Arithmetic)
## DBchapter(Fractions/rational numbers)
## DBsection(Addition/subtraction)
## Institution(The College of Idaho)
## Author(RA Cruz)
## MLT(AddSignedFracs)
## MLTleader(1)
## Level(2)
## MO(1)
## TitleText1('Essentials of Intermediate Algebra')
## AuthorText1('Blitzer')
## EditionText1('1')
## Section1('1.2')
## Problem1('')
## KEYWORDS('real numbers','operations with signed numbers')
## Date: 2007/09

DOCUMENT();    # This should be the first executable line in the problem.

loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'PGcourse.pl');

Context('Fraction');

$ad1 =
    list_random(2, 3, 5);   # Part a: One denominator is a multiple of the other
$an1 = $ad1 - random(1, $ad1 - 1);
$num = random(2, 6);
$d   = $ad1 * $num;
do {
    $n = $d - random(1, $d - 1, 1);
    ($an2, $ad2) = reduce($n, $d);
} while ($ad1 == $ad2);

@d1 = (3, 5, 6, 9);         # Part b: LCD is not one of the denominators
@d2 = (4, 7, 8, 11);
do { $d = $d1[ random(0, 3, 1) ]; } while ($ad1 == $d);
$n = $d - random(1, $d - 1, 1);
($bn1, $bd1) = reduce($n, $d);
$d = $d2[ random(0, 3, 1) ];
do {
    $n = $d - random(1, $d - 1, 1);
    ($bn2, $bd2) = reduce($n, $d);
} while ($bd1 == $bd2);

$frac1 = Compute("$an1/$ad1 - $an2/$ad2")->reduce;
$frac2 = Compute("$bn1/$bd1 - $bn2/$bd2")->reduce;

# Redefine these using LimitedFraction to ensure that students can use
# operations to produce the answers.

Context("LimitedFraction")->flags->set(showProperFractions => 0);
$ans1 = Compute($frac1);
$ans2 = Compute($frac2);

BEGIN_PGML
Subtract as indicated:  (Note: Your answer must be a fraction.)

a) [`` -\frac{[$an1]}{[$ad1]} - \left(-\frac{[$an2]}{[$ad2]}\right) = ``] [_]{$ans1}

b) [`` \frac{[$bn1]}{[$bd1]} - \frac{[$bn2]}{[$bd2]} = ``] [_]{$ans2}
END_PGML

BEGIN_PGML_SOLUTION
For each, find a common denominator and note that subtracting a negative results in addition. 
a)  [``  -\frac{[$an1]}{[$ad1]} - \left(-\frac{[$an2]}{[$ad2]}\right) = 
- \frac{[@$an1 * $num@]}{[$ad2]} + \frac{[$an2]}{[$ad2]} = [$ans1] ``]

b) [``\frac{[$bn1]}{[$bd1]} - \frac{[$bn2]}{[$bd2]} =  \frac{[$bn1]\cdot [$bd2]}{[$bd1]\cdot [$bd2]}-\frac{[$bn2]\cdot [$bd1]}{[$bd1]\cdot [$bd2]}
= \frac{[@ $bn1 * $bd2@] - [@ $bn2*$bd1 @]}{[@ $bd1*$bd2 @]} = [$ans2]``]
END_PGML_SOLUTION

ENDDOCUMENT();
