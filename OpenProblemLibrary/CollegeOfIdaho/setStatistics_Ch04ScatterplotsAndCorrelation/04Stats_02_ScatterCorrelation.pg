##DESCRIPTION
## Determine a correlation coefficient from a plot.
## DBsubject(Statistics)
## DBchapter(Simple linear regression)
## DBsection(Correlation)
## Institution(The College of Idaho)
## Author(R Cruz)
## MLT(EstimateRFromPlot)
## MLTleader(1)
## Level(1)
## TitleText1('The Basic Practice of Statistics')
## AuthorText1('David Moore')
## EditionText1('5e')
## Section1('4')
## Problem1('')
## KEYWORDS('statistic', 'correlation', 'scatterplots', 'DEI')
# Adapted by Rachael Norton for DEI/Accessibility

DOCUMENT();    # This should be the first executable line in the problem.

loadMacros(
    "PGstandard.pl",       'PGML.pl',
    'StatisticalPlots.pl', 'PGstatisticsmacros.pl',
    "parserPopUp.pl",      "PGcourse.pl"
);

sub gen_rand_pts {
    my ($n, $m, $a) = @_;
    my @pts;
    for (0 .. $n - 1) {
        $x = random(0, 1, 0.01);
        $y = $m * $x + $a * random(0, 1, 0.1);
        push(@pts, [ $x, $y ]);
    }
    return @pts;
}

# These are the parameters for each of 6 possible plots.
@coeffs = (
    {
        m   => -0.5,
        a   =>  1.5,
        alt => 'The scatterplot shows a moderate linear trend starting in '
            . 'the upper lefthand corner and moving downward to the right.'
    },
    {
        m   => -1.5,
        a   =>  0.2,
        alt => 'The scatterplot shows a very strong linear trend starting '
            . 'in the upper lefthand corner and moving downward to the right.'
    },
    {
        m   => -0.2,
        a   =>  0.3,
        alt => 'The scatterplot shows a weak linear trend starting in '
            . 'the upper lefthand corner and moving downward to the right.'
    },
    {
        m   => 0.5,
        a   => 0.5,
        alt => 'The scatterplot shows a moderate linear trend starting '
            . 'in the lower lefthand corner and moving upward to the right.'
    },
    {
        m   => 1.5,
        a   => 0.2,
        alt => 'The scatterplot shows a strong linear trend starting '
            . 'in the lower lefthand corner and moving upward to the right.'
    },
    {
        m   => 0.2,
        a   => 1.5,
        alt => 'The scatterplot shows a weak linear trend starting '
            . 'in the lower lefthand corner and moving upward to the right.'
    },
);

for my $coeff (random_subset(4, @coeffs)) {
    @rand_pts = gen_rand_pts(30, $coeff->{m}, $coeff->{a});
    $ymax     = ceil(4 * max(map { $_->[1] } @rand_pts)) / 4;
    $ymin     = floor(4 * min(map { $_->[1] } @rand_pts)) / 4;
    $plot     = StatPlot(
        xmin        => -0.25,
        xmax        =>  1.25,
        xtick_delta =>  0.25,
        xlocation   => 'bottom',
        xlabel      => '',
        ymin        => $ymin,
        ymax        => $ymax,
        ytick_delta => 0.25,
        ylocation   => 'left',
        ylabel      => '',
        show_grid   => 0
    );
    $plot->add_scatterplot(~~@rand_pts, mark_size => 0.5);
    push(
        @plots,
        {
            r => sample_correlation(
                [ map { $_->[0] } @rand_pts ],
                [ map { $_->[1] } @rand_pts ]
            ),
            im  => $plot,
            alt => $coeff->{alt}
        }
    );
}

# sorted list of possible answers
$list = [ lex_sort(map { 'r = ' . Round($_->{r}, 3) } @plots) ];
@dropdowns =
    map { DropDown($list, 'r = ' . Round($plots[$_]->{r}, 3)) } (0 .. $#plots);

$showPartialCorrectAnswers = 0;

BEGIN_PGML

Match the correlation coefficients with their scatterplots.
Select the letter of the scatterplot below which corresponds to the correlation
coefficient.  (Click on image for a larger view.)

[#
    [.*A*.][.*B*.]*
    [.[!!]{$plots[0]->{im}}{200}.][.[!!]{$plots[1]->{im}}{200}.]*
    [. [_]{$dropdowns[0]} .][. [_]{$dropdowns[1]} .]*
    [.*C*.][.*D*.]*
    [.[!!]{$plots[2]->{im}}{200}.][.[!!]{$plots[3]->{im}}{200}.]*
    [. [_]{$dropdowns[2]} .][. [_]{$dropdowns[3]} .]*
#]{padding => 0.3}
END_PGML

BEGIN_PGML_SOLUTION
There are two general rules about correlation coefficients. 

1. The closer a set of points is to a line, the closer [`r`] is to 1 or -1. 
2. The sign of [`r`] is the sign of the slope of the line . 


a. Becuase plot a) shows that [$plots[0]->{alt}] then the result is [$dropdowns[0]].
b. Becuase plot a) shows that [$plots[1]->{alt}] then the result is [$dropdowns[1]].
c. Becuase plot a) shows that [$plots[2]->{alt}] then the result is [$dropdowns[2]].
d. Becuase plot a) shows that [$plots[3]->{alt}] then the result is [$dropdowns[3]].

END_PGML_SOLUTION

ENDDOCUMENT();
