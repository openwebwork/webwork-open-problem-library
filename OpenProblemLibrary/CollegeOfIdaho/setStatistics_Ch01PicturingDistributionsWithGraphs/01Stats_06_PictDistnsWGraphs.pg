## DESCRIPTION
## DBsubject(Statistics)
## DBchapter(Exploratory data analysis/descriptive statistics)
## DBsection(Graphical representations)
## Institution(The College of Idaho)
## Author(R Cruz, L Danielson, J Guild)
## Level(1)
## TitleText1('The Basic Practice of Statistics')
## AuthorText1('David Moore')
## EditionText1('5e')
## Section1('1')
## KEYWORDS('statistics', 'quantitative data', 'histogram')

DOCUMENT();    # This should be the first executable line in the problem.

loadMacros('PGstandard.pl', 'PGML.pl', 'parserRadioButtons.pl', 'PGcourse.pl');

$radio1 = RadioButtons(
    [
        [
            q/label the vertical axis so the reader can determine the counts
            or percent in each class interval./,
            q/have a separate class interval for each observation to get the
            most informative plot./,
            q/make sure the heights of the bars exceed the widths of the class
            intervals so that the bars are true rectangles./,
            q/make certain the mean and median are contained in the same class
            interval, so that the correct type of skewness can be identified./
        ],
        'None of the above.'
    ],
    0,
    labels => 'ABC'
);

$radio2 = RadioButtons(
    [
        [
            'The heights of bars should equal the class frequency.',
            'Leave large gaps between bars.  This allows room for comments.',
            q/Generally, bars should be square so that both the height and width equal the class count./,
            q/The scale of the vertical axis should be that of the variable whose distribution you are displaying./
        ],
        'None of the above.'
    ],
    0,
    labels => 'ABC'
);

$showPartialCorrectAnswers = 0;

BEGIN_PGML
Select the best response for each

a) When drawing a histogram it is important to

    [_]{$radio1}

b) In drawing a histogram, which of the following suggestions should be followed?

    [_]{$radio2}
END_PGML

BEGIN_PGML_SOLUTION
a) [$radio1]

b) [$radio2]
END_PGML_SOLUTION

ENDDOCUMENT();       # This should be the last executable line in the problem.