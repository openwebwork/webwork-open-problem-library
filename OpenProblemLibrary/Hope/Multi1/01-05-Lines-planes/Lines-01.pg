## DESCRIPTION
##   Parametric Equation for a Line
## ENDDESCRIPTION

## Tagged by nhamblet

## DBsubject(Geometry)
## DBchapter(Vector geometry)
## DBsection(Lines)
## Date(8/23/07)
## Institution(Hope College)
## Author(Paul Pearson)
## Level(3)
## KEYWORDS('Parametric', 'Line', 'Vector')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'parserVectorUtils.pl', 'PGcourse.pl');

Context("Vector");

#  The line p+tv
do {
    $P = non_zero_point3D();
    $Q = non_zero_point3D();
} until ($Q != $P);

do {
    $V = non_zero_vector3D();
    $W = non_zero_vector3D();
} until (!($V->isParallel($W)));

$N  = $V->cross($W);
$PQ = Vector($Q - $P);

$answer = abs($N . $PQ) / norm($N);

BEGIN_PGML

Find the distance between the skew lines
[` P(t) = [$P] + t [$V] `] and 
[` Q(t) = [$Q] + t [$W] `].  Hint: Take the cross product of
the slope vectors of [` P `] and [` Q `] to find a vector
normal to both of these lines.

    distance = [_]{$answer}

END_PGML
ENDDOCUMENT();
