#DESCRIPTION
##  Calculus: Linear approximation
##ENDDESCRIPTION


## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Linear approximation and differentials)
## Date(11/17/2010)
## Institution(UCSB)
## Author(Justin Sukiennik)
## MLT(LinearApprox_EstimateNumber)
## MLTleader(1)
## Level(4)
## MO(1)
## TitleText1('Calculus: Concepts and Contexts')
## AuthorText1('Stewart')
## EditionText1('4 Custom UMTYMP Ed.')
## Section1('3.9')
## Problem1('33')
## TitleText2('Calculus: Early Transcendentals')
## AuthorText2('Stewart')
## EditionText2('5')
## Section2('3.11')
## Problem2('33')
## KEYWORDS('calculus', 'derivative', 'linear approximations','Differentiation','Product','Quotient')

#####################################################################
DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "PGcourse.pl"
);
#####################################################################

Context("Numeric");

$a = random(2,5,1);
$b = Compute("$a^3+0.07");

Context("LimitedNumeric")->operators->redefine('/');
Context()->parens->redefine('(');
Context()->{format}{number} = "%.11g";
Context()->flags->set(tolType => 'absolute', tolerance => 0.000000001);

$ans = Compute(2/(3*$a)*0.07+$a**2);

#####################################################################
BEGIN_PGML
Use a linear approximation to estimate the number [`[$b]^{2/3}`].

Make sure that your answer is correct to at least 9 decimal places.

[_]{$ans}{20}
END_PGML

ENDDOCUMENT();        # This should be the last executable line in the problem.
