## Problem1('1')
## TitleText2('')
## AuthorText2('Kohn')
## EditionText2('')
## Section2('.')
## Problem2('')
## KEYWORDS('calculus', 'function', 'average rate', 'derivative', 'rate of change')

DOCUMENT(); 

loadMacros('PGstandard.pl', 'PGML.pl', 'parserPopUp.pl', 'PGcourse.pl');


$a = random(100,900,100);
$b = random(3,8);
$c = Compute("$b*0.01+1");

$ans1 = Compute("($a*($c)-$a)");
$ans2 = Compute("($a*($c)^5-$a)/5");
$ans3 = Compute("($a*($c)^(10)-$a)/(10)");

$popup4 = PopUp(['choose one','increases', 'decreases', 'stays the same'],'increases');

BEGIN_PGML
Suppose you deposit [`[$a]`] dollars into a bank with [`[$b] [$PERCENT] `] compounded annully.  The amount in the account after [` t `] years is given by [` A(t) = [$a] ([$c])^t`] (in dollars).

---

1. What is the average rate of change for the first year?

    Rate (in dollars per year): [_]{$ans1}{20}

2. What is the average rate of change for the first five years?

    Rate (in dollars per year): [_]{$ans2}{20}

3. What is the average rate of change for the first ten years?

    Rate (in dollars per year): [_]{$ans3}{20}

4.  Does the average rate of change increase or decrease as time from the initial deposit gets longer?

 [@ $popup4->menu @]* 

END_PGML


ENDDOCUMENT();